रत्नकन्दल पुं<BR>+ अण् = रात्नकन्दल<BR>+ अञ् = रात्नकन्दल<BR>+ अस्तातिँ = रत्नकन्दलस्तात्<BR>+ इञ् = रात्नकन्दलि<BR>+ इनिँ = रत्नकन्दलिन्<BR>+ इष्ठन् = रत्नकन्दलिष्ठ<BR>+ ईयसुँन् = रत्नकन्दलीयस्<BR>+ क = रत्नकन्दलक<BR>+ कन् = रत्नकन्दलक, रत्नकन्दलक, रत्नकन्दलक<BR>+ कल्पप् = रत्नकन्दलकल्प<BR>+ कुणप् = रत्नकन्दलकुण<BR>+ खञ् = रात्नकन्दलीन<BR>+ चणप् = रत्नकन्दलचण<BR>+ चरट् = रत्नकन्दलचर<BR>+ चुञ्चुप् = रत्नकन्दलचुञ्चु<BR>+ च्विँ = रत्नकन्दली<BR>+ छ = रत्नकन्दलीय<BR>+ जातीयर् = रत्नकन्दलजातीय<BR>+ जाहच् = रत्नकन्दलजाह<BR>+ ञ्यट् = रात्नकन्दल्य<BR>+ ठक् = रात्नकन्दलिक, रात्नकन्दलिक<BR>+ ठन् = रत्नकन्दलिक<BR>+ तमप् = रत्नकन्दलतम<BR>+ तरप् = रत्नकन्दलतर<BR>+ तल् = रत्नकन्दलता<BR>+ तसिँ = रत्नकन्दलतस्<BR>+ त्रा = रत्नकन्दलत्रा<BR>+ त्व = रत्नकन्दलत्व<BR>+ थमुँ = रत्नकन्दलथम्<BR>+ थाल् = रत्नकन्दलथा<BR>+ दघ्नच् = रत्नकन्दलदघ्न<BR>+ देश्य = रत्नकन्दलदेश्य<BR>+ देशीयर् = रत्नकन्दलदेशीय<BR>+ द्वयसच् = रत्नकन्दलद्वयस<BR>+ बहुच् = बहुरत्नकन्दल<BR>+ मतुँप् = रत्नकन्दलवत्<BR>+ मयट् = रत्नकन्दलमय<BR>+ मात्रच् = रत्नकन्दलमात्र<BR>+ पाशप् = रत्नकन्दलपाश<BR>+ यत् = रत्नकन्दल्य<BR>+ रूपप् = रत्नकन्दलरूप<BR>+ रूप्य = रत्नकन्दलरूप्य<BR>+ वलच् = रत्नकन्दलावल<BR>+ शस् = रत्नकन्दलश<BR>+ सातिँ = रत्नकन्दलसात्

