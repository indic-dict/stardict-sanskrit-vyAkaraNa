रक्त पुं<BR>+ अण् = राक्त<BR>+ अञ् = राक्त<BR>+ अस्तातिँ = रक्तस्तात्<BR>+ इञ् = राक्ति<BR>+ इनिँ = रक्तिन्<BR>+ इष्ठन् = रक्तिष्ठ<BR>+ ईयसुँन् = रक्तीयस्<BR>+ क = रक्तक<BR>+ कन् = रक्तक, रक्तक, रक्तक<BR>+ कल्पप् = रक्तकल्प<BR>+ कुणप् = रक्तकुण<BR>+ खञ् = राक्तीन<BR>+ चणप् = रक्तचण<BR>+ चरट् = रक्तचर<BR>+ चुञ्चुप् = रक्तचुञ्चु<BR>+ च्विँ = रक्ती<BR>+ छ = रक्तीय<BR>+ जातीयर् = रक्तजातीय<BR>+ जाहच् = रक्तजाह<BR>+ ञ्यट् = राक्त्य<BR>+ ठक् = राक्तिक, राक्तिक<BR>+ ठन् = रक्तिक<BR>+ तमप् = रक्ततम<BR>+ तरप् = रक्ततर<BR>+ तल् = रक्तता<BR>+ तसिँ = रक्ततस्<BR>+ त्रा = रक्तत्रा<BR>+ त्व = रक्तत्व<BR>+ थमुँ = रक्तथम्<BR>+ थाल् = रक्तथा<BR>+ दघ्नच् = रक्तदघ्न<BR>+ देश्य = रक्तदेश्य<BR>+ देशीयर् = रक्तदेशीय<BR>+ द्वयसच् = रक्तद्वयस<BR>+ बहुच् = बहुरक्त<BR>+ मतुँप् = रक्तवत्<BR>+ मयट् = रक्तमय<BR>+ मात्रच् = रक्तमात्र<BR>+ पाशप् = रक्तपाश<BR>+ यत् = रक्त्य<BR>+ रूपप् = रक्तरूप<BR>+ रूप्य = रक्तरूप्य<BR>+ वलच् = रक्तावल<BR>+ शस् = रक्तश<BR>+ सातिँ = रक्तसात्

