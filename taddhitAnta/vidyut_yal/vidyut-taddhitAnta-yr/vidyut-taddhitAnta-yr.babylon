रुद्रव्रतिन् पुं<BR>+ अण् = रौद्रव्रतिन<BR>+ अञ् = रौद्रव्रत<BR>+ अस्तातिँ = रुद्रव्रतस्तात्<BR>+ इष्ठन् = रुद्रव्रतिष्ठ<BR>+ ईयसुँन् = रुद्रव्रतीयस्<BR>+ क = रुद्रव्रतिक<BR>+ कन् = रुद्रव्रतिक, रुद्रव्रतिक, रुद्रव्रतिक<BR>+ कल्पप् = रुद्रव्रतिकल्प<BR>+ कुणप् = रुद्रव्रतिकुण<BR>+ खञ् = रौद्रव्रतीन<BR>+ चणप् = रुद्रव्रतिचण<BR>+ चरट् = रुद्रव्रतिचर<BR>+ चुञ्चुप् = रुद्रव्रतिचुञ्चु<BR>+ च्विँ = रुद्रव्रति<BR>+ छ = रुद्रव्रतीय<BR>+ जातीयर् = रुद्रव्रतिजातीय<BR>+ जाहच् = रुद्रव्रतिजाह<BR>+ ञ्यट् = रौद्रव्रत्य<BR>+ ठक् = रौद्रव्रतिक, रौद्रव्रतिक<BR>+ तमप् = रुद्रव्रतितम<BR>+ तरप् = रुद्रव्रतितर<BR>+ तल् = रुद्रव्रतिता<BR>+ तसिँ = रुद्रव्रतितस्<BR>+ त्रा = रुद्रव्रतित्रा<BR>+ त्व = रुद्रव्रतित्व<BR>+ थमुँ = रुद्रव्रतिथम्<BR>+ थाल् = रुद्रव्रतिथा<BR>+ दघ्नच् = रुद्रव्रतिदघ्न<BR>+ देश्य = रुद्रव्रतिदेश्य<BR>+ देशीयर् = रुद्रव्रतिदेशीय<BR>+ द्वयसच् = रुद्रव्रतिद्वयस<BR>+ बहुच् = बहुरुद्रव्रतिन्<BR>+ मतुँप् = रुद्रव्रतिमत्<BR>+ मयट् = रुद्रव्रतिमय<BR>+ मात्रच् = रुद्रव्रतिमात्र<BR>+ पाशप् = रुद्रव्रतिपाश<BR>+ यत् = रुद्रव्रत्य<BR>+ रूपप् = रुद्रव्रतिरूप<BR>+ रूप्य = रुद्रव्रतिरूप्य<BR>+ वलच् = रुद्रव्रतिवल<BR>+ शस् = रुद्रव्रतिश<BR>+ सातिँ = रुद्रव्रतिसात्

