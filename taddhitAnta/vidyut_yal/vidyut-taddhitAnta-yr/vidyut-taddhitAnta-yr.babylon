रुङ्मती स्त्री<BR>+ अण् = रौङ्मत<BR>+ अञ् = रौङ्मत<BR>+ अस्तातिँ = रुङ्मतस्तात्<BR>+ इष्ठन् = रुङ्मतीष्ठ<BR>+ ईयसुँन् = रुङ्मतीयस्<BR>+ क = रुङ्मतीक<BR>+ कन् = रुङ्मतीक, रुङ्मतीक, रुङ्मतीक<BR>+ कल्पप् = रुङ्मतीकल्प<BR>+ कुणप् = रुङ्मतीकुण<BR>+ खञ् = रौङ्मतीन<BR>+ चणप् = रुङ्मतीचण<BR>+ चरट् = रुङ्मतीचर<BR>+ चुञ्चुप् = रुङ्मतीचुञ्चु<BR>+ च्विँ = रुङ्मती<BR>+ छ = रुङ्मतीय<BR>+ जातीयर् = रुङ्मतीजातीय<BR>+ जाहच् = रुङ्मतीजाह<BR>+ ञ्यट् = रौङ्मत्य<BR>+ ठक् = रौङ्मतिक, रौङ्मतिक<BR>+ ढक् = रौङ्मतेय<BR>+ तमप् = रुङ्मतीतम<BR>+ तरप् = रुङ्मतीतर<BR>+ तल् = रुङ्मतीता<BR>+ तसिँ = रुङ्मतीतस्<BR>+ त्रा = रुङ्मतीत्रा<BR>+ त्व = रुङ्मतीत्व<BR>+ थमुँ = रुङ्मतीथम्<BR>+ थाल् = रुङ्मतीथा<BR>+ दघ्नच् = रुङ्मतीदघ्न<BR>+ देश्य = रुङ्मतीदेश्य<BR>+ देशीयर् = रुङ्मतीदेशीय<BR>+ द्वयसच् = रुङ्मतीद्वयस<BR>+ बहुच् = बहुरुङ्मती<BR>+ मतुँप् = रुङ्मतीमत्<BR>+ मयट् = रुङ्मतीमय<BR>+ मात्रच् = रुङ्मतीमात्र<BR>+ पाशप् = रुङ्मतीपाश<BR>+ यत् = रुङ्मत्य<BR>+ रूपप् = रुङ्मतीरूप<BR>+ रूप्य = रुङ्मतीरूप्य<BR>+ वलच् = रुङ्मतीवल<BR>+ शस् = रुङ्मतीश<BR>+ सातिँ = रुङ्मतीसात्

