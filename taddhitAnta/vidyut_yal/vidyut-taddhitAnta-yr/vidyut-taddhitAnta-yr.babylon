रुद्रशर्मन् पुं<BR>+ अण् = रौद्रशर्मण<BR>+ अञ् = रौद्रशर्म<BR>+ अस्तातिँ = रुद्रशर्मस्तात्<BR>+ इष्ठन् = रुद्रशर्मिष्ठ<BR>+ ईयसुँन् = रुद्रशर्मीयस्<BR>+ क = रुद्रशर्मक<BR>+ कन् = रुद्रशर्मक, रुद्रशर्मक, रुद्रशर्मक<BR>+ कल्पप् = रुद्रशर्मकल्प<BR>+ कुणप् = रुद्रशर्मकुण<BR>+ खञ् = रौद्रशर्मीण<BR>+ चणप् = रुद्रशर्मचण<BR>+ चरट् = रुद्रशर्मचर<BR>+ चुञ्चुप् = रुद्रशर्मचुञ्चु<BR>+ च्विँ = रुद्रशर्म<BR>+ छ = रुद्रशर्मीय<BR>+ जातीयर् = रुद्रशर्मजातीय<BR>+ जाहच् = रुद्रशर्मजाह<BR>+ ञ्यट् = रौद्रशर्मण्य<BR>+ ठक् = रौद्रशर्मिक, रौद्रशर्मिक<BR>+ तमप् = रुद्रशर्मतम<BR>+ तरप् = रुद्रशर्मतर<BR>+ तल् = रुद्रशर्मता<BR>+ तसिँ = रुद्रशर्मतस्<BR>+ त्रा = रुद्रशर्मत्रा<BR>+ त्व = रुद्रशर्मत्व<BR>+ थमुँ = रुद्रशर्मथम्<BR>+ थाल् = रुद्रशर्मथा<BR>+ दघ्नच् = रुद्रशर्मदघ्न<BR>+ देश्य = रुद्रशर्मदेश्य<BR>+ देशीयर् = रुद्रशर्मदेशीय<BR>+ द्वयसच् = रुद्रशर्मद्वयस<BR>+ बहुच् = बहुरुद्रशर्मन्<BR>+ मतुँप् = रुद्रशर्मवत्<BR>+ मयट् = रुद्रशर्ममय<BR>+ मात्रच् = रुद्रशर्ममात्र<BR>+ पाशप् = रुद्रशर्मपाश<BR>+ यत् = रुद्रशर्मण्य<BR>+ रूपप् = रुद्रशर्मरूप<BR>+ रूप्य = रुद्रशर्मरूप्य<BR>+ वलच् = रुद्रशर्मवल<BR>+ शस् = रुद्रशर्मश<BR>+ सातिँ = रुद्रशर्मसात्

