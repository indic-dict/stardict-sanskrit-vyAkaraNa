रक्तदत् पुं,स्त्री,नपुंसक<BR>+ अण् = राक्तदत<BR>+ अञ् = राक्तदत<BR>+ अस्तातिँ = रक्तदतस्तात्<BR>+ इष्ठन् = रक्तदिष्ठ<BR>+ ईयसुँन् = रक्तदीयस्<BR>+ क = रक्तदत्क<BR>+ कन् = रक्तदत्क, रक्तदत्क, रक्तदत्क<BR>+ कल्पप् = रक्तदत्कल्प<BR>+ कुणप् = रक्तदत्कुण<BR>+ खञ् = राक्तदतीन<BR>+ चणप् = रक्तदच्चण<BR>+ चरट् = रक्तदच्चर<BR>+ चुञ्चुप् = रक्तदच्चुञ्चु<BR>+ च्विँ = रक्तदद्<BR>+ छ = रक्तदतीय<BR>+ जातीयर् = रक्तदज्जातीय<BR>+ जाहच् = रक्तदज्जाह<BR>+ ञ्यट् = राक्तदत्य<BR>+ ठक् = राक्तदत्क, राक्तदत्क<BR>+ तमप् = रक्तदत्तम<BR>+ तरप् = रक्तदत्तर<BR>+ तल् = रक्तदत्ता<BR>+ तसिँ = रक्तदत्तस्<BR>+ त्रा = रक्तदत्त्रा<BR>+ त्व = रक्तदत्त्व<BR>+ थमुँ = रक्तदत्थम्<BR>+ थाल् = रक्तदत्था<BR>+ दघ्नच् = रक्तदद्दघ्न<BR>+ देश्य = रक्तदद्देश्य<BR>+ देशीयर् = रक्तदद्देशीय<BR>+ द्वयसच् = रक्तदद्द्वयस<BR>+ बहुच् = बहुरक्तदत्<BR>+ मतुँप् = रक्तदत्वत्<BR>+ मयट् = रक्तदन्मय<BR>+ मात्रच् = रक्तदन्मात्र<BR>+ पाशप् = रक्तदत्पाश<BR>+ यत् = रक्तदत्य<BR>+ रूपप् = रक्तदद्रूप<BR>+ रूप्य = रक्तदद्रूप्य<BR>+ वलच् = रक्तदत्वल<BR>+ शस् = रक्तदच्छ, रक्तदच्श<BR>+ सातिँ = रक्तदत्सात्

