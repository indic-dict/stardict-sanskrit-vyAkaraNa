रक्तपत्त्रिका स्त्री<BR>+ अण् = राक्तपत्त्रिक<BR>+ अञ् = राक्तपत्त्रिक<BR>+ अस्तातिँ = रक्तपत्त्रिकस्तात्<BR>+ इष्ठन् = रक्तपत्त्रिकेष्ठ<BR>+ ईयसुँन् = रक्तपत्त्रिकेयस्<BR>+ क = रक्तपत्त्रिकाक<BR>+ कन् = रक्तपत्त्रिकाक, रक्तपत्त्रिकाक, रक्तपत्त्रिकाक<BR>+ कल्पप् = रक्तपत्त्रिकाकल्प<BR>+ कुणप् = रक्तपत्त्रिकाकुण<BR>+ खञ् = राक्तपत्त्रिकीण<BR>+ चणप् = रक्तपत्त्रिकाचण<BR>+ चरट् = रक्तपत्त्रिकाचर<BR>+ चुञ्चुप् = रक्तपत्त्रिकाचुञ्चु<BR>+ च्विँ = रक्तपत्त्रिका<BR>+ छ = रक्तपत्त्रिकीय<BR>+ जातीयर् = रक्तपत्त्रिकाजातीय<BR>+ जाहच् = रक्तपत्त्रिकाजाह<BR>+ ञ्यट् = राक्तपत्त्रिक्य<BR>+ ठक् = राक्तपत्त्रिकिक, राक्तपत्त्रिकिक<BR>+ ढक् = राक्तपत्त्रिकेय<BR>+ तमप् = रक्तपत्त्रिकातम<BR>+ तरप् = रक्तपत्त्रिकातर<BR>+ तल् = रक्तपत्त्रिकाता<BR>+ तसिँ = रक्तपत्त्रिकातस्<BR>+ त्रा = रक्तपत्त्रिकात्रा<BR>+ त्व = रक्तपत्त्रिकात्व<BR>+ थमुँ = रक्तपत्त्रिकाथम्<BR>+ थाल् = रक्तपत्त्रिकाथा<BR>+ दघ्नच् = रक्तपत्त्रिकादघ्न<BR>+ देश्य = रक्तपत्त्रिकादेश्य<BR>+ देशीयर् = रक्तपत्त्रिकादेशीय<BR>+ द्वयसच् = रक्तपत्त्रिकाद्वयस<BR>+ बहुच् = बहुरक्तपत्त्रिका<BR>+ मतुँप् = रक्तपत्त्रिकामत्<BR>+ मयट् = रक्तपत्त्रिकामय<BR>+ मात्रच् = रक्तपत्त्रिकामात्र<BR>+ पाशप् = रक्तपत्त्रिकापाश<BR>+ यत् = रक्तपत्त्रिक्य<BR>+ रूपप् = रक्तपत्त्रिकारूप<BR>+ रूप्य = रक्तपत्त्रिकारूप्य<BR>+ वलच् = रक्तपत्त्रिकावल<BR>+ शस् = रक्तपत्त्रिकाश<BR>+ सातिँ = रक्तपत्त्रिकासात्

