रस पुं<BR>+ अण् = रास<BR>+ अञ् = रास<BR>+ अस्तातिँ = रसस्तात्<BR>+ इञ् = रासि<BR>+ इष्ठन् = रसिष्ठ<BR>+ ईयसुँन् = रसीयस्<BR>+ क = रसक<BR>+ कन् = रसक, रसक, रसक<BR>+ कल्पप् = रसकल्प<BR>+ कुणप् = रसकुण<BR>+ खञ् = रासीन<BR>+ चणप् = रसचण<BR>+ चरट् = रसचर<BR>+ चुञ्चुप् = रसचुञ्चु<BR>+ च्विँ = रसी<BR>+ छ = रसीय<BR>+ जातीयर् = रसजातीय<BR>+ जाहच् = रसजाह<BR>+ ञ्यट् = रास्य<BR>+ ठक् = रासिक, रासिक<BR>+ ठन् = रसिक<BR>+ तमप् = रसतम<BR>+ तरप् = रसतर<BR>+ तल् = रसता<BR>+ तसिँ = रसतस्<BR>+ त्रा = रसत्रा<BR>+ त्व = रसत्व<BR>+ थमुँ = रसथम्<BR>+ थाल् = रसथा<BR>+ दघ्नच् = रसदघ्न<BR>+ देश्य = रसदेश्य<BR>+ देशीयर् = रसदेशीय<BR>+ द्वयसच् = रसद्वयस<BR>+ बहुच् = बहुरस<BR>+ मतुँप् = रसवत्<BR>+ मयट् = रसमय<BR>+ मात्रच् = रसमात्र<BR>+ पाशप् = रसपाश<BR>+ यत् = रस्य<BR>+ रूपप् = रसरूप<BR>+ रूप्य = रसरूप्य<BR>+ वलच् = रसावल<BR>+ शस् = रसश<BR>+ सातिँ = रससात्

