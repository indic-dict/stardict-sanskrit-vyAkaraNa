रन्तव्य नपुंसक<BR>+ अण् = रान्तव्य<BR>+ अञ् = रान्तव्य<BR>+ अस्तातिँ = रन्तव्यस्तात्<BR>+ इञ् = रान्तव्यि<BR>+ इनिँ = रन्तव्यिन्<BR>+ इष्ठन् = रन्तव्यिष्ठ<BR>+ ईयसुँन् = रन्तव्यीयस्<BR>+ क = रन्तव्यक<BR>+ कन् = रन्तव्यक, रन्तव्यक, रन्तव्यक<BR>+ कल्पप् = रन्तव्यकल्प<BR>+ कुणप् = रन्तव्यकुण<BR>+ खञ् = रान्तव्यीन<BR>+ चणप् = रन्तव्यचण<BR>+ चरट् = रन्तव्यचर<BR>+ चुञ्चुप् = रन्तव्यचुञ्चु<BR>+ च्विँ = रन्तव्यी<BR>+ छ = रन्तव्यीय<BR>+ जातीयर् = रन्तव्यजातीय<BR>+ जाहच् = रन्तव्यजाह<BR>+ ञ्यट् = रान्तव्य, रान्तव्य्य<BR>+ ठक् = रान्तव्यिक, रान्तव्यिक<BR>+ ठन् = रन्तव्यिक<BR>+ तमप् = रन्तव्यतम<BR>+ तरप् = रन्तव्यतर<BR>+ तल् = रन्तव्यता<BR>+ तसिँ = रन्तव्यतस्<BR>+ त्रा = रन्तव्यत्रा<BR>+ त्व = रन्तव्यत्व<BR>+ थमुँ = रन्तव्यथम्<BR>+ थाल् = रन्तव्यथा<BR>+ दघ्नच् = रन्तव्यदघ्न<BR>+ देश्य = रन्तव्यदेश्य<BR>+ देशीयर् = रन्तव्यदेशीय<BR>+ द्वयसच् = रन्तव्यद्वयस<BR>+ बहुच् = बहुरन्तव्य<BR>+ मतुँप् = रन्तव्यवत्<BR>+ मयट् = रन्तव्यमय<BR>+ मात्रच् = रन्तव्यमात्र<BR>+ पाशप् = रन्तव्यपाश<BR>+ यत् = रन्तव्य, रन्तव्य्य<BR>+ रूपप् = रन्तव्यरूप<BR>+ रूप्य = रन्तव्यरूप्य<BR>+ वलच् = रन्तव्यावल<BR>+ शस् = रन्तव्यश<BR>+ सातिँ = रन्तव्यसात्

