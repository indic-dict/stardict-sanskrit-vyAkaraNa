रुद्रव्रत नपुंसक<BR>+ अण् = रौद्रव्रत<BR>+ अञ् = रौद्रव्रत<BR>+ अस्तातिँ = रुद्रव्रतस्तात्<BR>+ इञ् = रौद्रव्रति<BR>+ इनिँ = रुद्रव्रतिन्<BR>+ इष्ठन् = रुद्रव्रतिष्ठ<BR>+ ईयसुँन् = रुद्रव्रतीयस्<BR>+ क = रुद्रव्रतक<BR>+ कन् = रुद्रव्रतक, रुद्रव्रतक, रुद्रव्रतक<BR>+ कल्पप् = रुद्रव्रतकल्प<BR>+ कुणप् = रुद्रव्रतकुण<BR>+ खञ् = रौद्रव्रतीन<BR>+ चणप् = रुद्रव्रतचण<BR>+ चरट् = रुद्रव्रतचर<BR>+ चुञ्चुप् = रुद्रव्रतचुञ्चु<BR>+ च्विँ = रुद्रव्रती<BR>+ छ = रुद्रव्रतीय<BR>+ जातीयर् = रुद्रव्रतजातीय<BR>+ जाहच् = रुद्रव्रतजाह<BR>+ ञ्यट् = रौद्रव्रत्य<BR>+ ठक् = रौद्रव्रतिक, रौद्रव्रतिक<BR>+ ठन् = रुद्रव्रतिक<BR>+ तमप् = रुद्रव्रततम<BR>+ तरप् = रुद्रव्रततर<BR>+ तल् = रुद्रव्रतता<BR>+ तसिँ = रुद्रव्रततस्<BR>+ त्रा = रुद्रव्रतत्रा<BR>+ त्व = रुद्रव्रतत्व<BR>+ थमुँ = रुद्रव्रतथम्<BR>+ थाल् = रुद्रव्रतथा<BR>+ दघ्नच् = रुद्रव्रतदघ्न<BR>+ देश्य = रुद्रव्रतदेश्य<BR>+ देशीयर् = रुद्रव्रतदेशीय<BR>+ द्वयसच् = रुद्रव्रतद्वयस<BR>+ बहुच् = बहुरुद्रव्रत<BR>+ मतुँप् = रुद्रव्रतवत्<BR>+ मयट् = रुद्रव्रतमय<BR>+ मात्रच् = रुद्रव्रतमात्र<BR>+ पाशप् = रुद्रव्रतपाश<BR>+ यत् = रुद्रव्रत्य<BR>+ रूपप् = रुद्रव्रतरूप<BR>+ रूप्य = रुद्रव्रतरूप्य<BR>+ वलच् = रुद्रव्रतावल<BR>+ शस् = रुद्रव्रतश<BR>+ सातिँ = रुद्रव्रतसात्

