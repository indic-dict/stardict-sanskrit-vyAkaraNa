रत नपुंसक<BR>+ अण् = रात<BR>+ अञ् = रात<BR>+ अस्तातिँ = रतस्तात्<BR>+ इञ् = राति<BR>+ इनिँ = रतिन्<BR>+ इष्ठन् = रतिष्ठ<BR>+ ईयसुँन् = रतीयस्<BR>+ क = रतक<BR>+ कन् = रतक, रतक, रतक<BR>+ कल्पप् = रतकल्प<BR>+ कुणप् = रतकुण<BR>+ खञ् = रातीन<BR>+ चणप् = रतचण<BR>+ चरट् = रतचर<BR>+ चुञ्चुप् = रतचुञ्चु<BR>+ च्विँ = रती<BR>+ छ = रतीय<BR>+ जातीयर् = रतजातीय<BR>+ जाहच् = रतजाह<BR>+ ञ्यट् = रात्य<BR>+ ठक् = रातिक, रातिक<BR>+ ठन् = रतिक<BR>+ तमप् = रततम<BR>+ तरप् = रततर<BR>+ तल् = रतता<BR>+ तसिँ = रततस्<BR>+ त्रा = रतत्रा<BR>+ त्व = रतत्व<BR>+ थमुँ = रतथम्<BR>+ थाल् = रतथा<BR>+ दघ्नच् = रतदघ्न<BR>+ देश्य = रतदेश्य<BR>+ देशीयर् = रतदेशीय<BR>+ द्वयसच् = रतद्वयस<BR>+ बहुच् = बहुरत<BR>+ मतुँप् = रतवत्<BR>+ मयट् = रतमय<BR>+ मात्रच् = रतमात्र<BR>+ पाशप् = रतपाश<BR>+ यत् = रत्य<BR>+ रूपप् = रतरूप<BR>+ रूप्य = रतरूप्य<BR>+ वलच् = रतावल<BR>+ शस् = रतश<BR>+ सातिँ = रतसात्

