रुङ्मत् पुं,स्त्री,नपुंसक<BR>+ अण् = रौङ्मत<BR>+ अञ् = रौङ्मत<BR>+ अस्तातिँ = रुङ्मतस्तात्<BR>+ इष्ठन् = रुङ्मिष्ठ<BR>+ ईयसुँन् = रुङ्मीयस्<BR>+ क = रुङ्मत्क<BR>+ कन् = रुङ्मत्क, रुङ्मत्क, रुङ्मत्क<BR>+ कल्पप् = रुङ्मत्कल्प<BR>+ कुणप् = रुङ्मत्कुण<BR>+ खञ् = रौङ्मतीन<BR>+ चणप् = रुङ्मच्चण<BR>+ चरट् = रुङ्मच्चर<BR>+ चुञ्चुप् = रुङ्मच्चुञ्चु<BR>+ च्विँ = रुङ्मद्<BR>+ छ = रुङ्मतीय<BR>+ जातीयर् = रुङ्मज्जातीय<BR>+ जाहच् = रुङ्मज्जाह<BR>+ ञ्यट् = रौङ्मत्य<BR>+ ठक् = रौङ्मत्क, रौङ्मत्क<BR>+ ठन् = रुङ्मत्क<BR>+ तमप् = रुङ्मत्तम<BR>+ तरप् = रुङ्मत्तर<BR>+ तल् = रुङ्मत्ता<BR>+ तसिँ = रुङ्मत्तस्<BR>+ त्रा = रुङ्मत्त्रा<BR>+ त्व = रुङ्मत्त्व<BR>+ थमुँ = रुङ्मत्थम्<BR>+ थाल् = रुङ्मत्था<BR>+ दघ्नच् = रुङ्मद्दघ्न<BR>+ देश्य = रुङ्मद्देश्य<BR>+ देशीयर् = रुङ्मद्देशीय<BR>+ द्वयसच् = रुङ्मद्द्वयस<BR>+ बहुच् = बहुरुङ्मत्<BR>+ मतुँप् = रुङ्मत्वत्<BR>+ मयट् = रुङ्मन्मय<BR>+ मात्रच् = रुङ्मन्मात्र<BR>+ पाशप् = रुङ्मत्पाश<BR>+ यत् = रुङ्मत्य<BR>+ रूपप् = रुङ्मद्रूप<BR>+ रूप्य = रुङ्मद्रूप्य<BR>+ वलच् = रुङ्मत्वल<BR>+ शस् = रुङ्मच्छ, रुङ्मच्श<BR>+ सातिँ = रुङ्मत्सात्

