रक्तपैत्त पुं,स्त्री,नपुंसक<BR>+ अण् = राक्तपैत्त<BR>+ अञ् = राक्तपैत्त<BR>+ अस्तातिँ = रक्तपैत्तस्तात्<BR>+ इञ् = राक्तपैत्ति<BR>+ इनिँ = रक्तपैत्तिन्<BR>+ इष्ठन् = रक्तपैत्तिष्ठ<BR>+ ईयसुँन् = रक्तपैत्तीयस्<BR>+ क = रक्तपैत्तक<BR>+ कन् = रक्तपैत्तक, रक्तपैत्तक, रक्तपैत्तक<BR>+ कल्पप् = रक्तपैत्तकल्प<BR>+ कुणप् = रक्तपैत्तकुण<BR>+ खञ् = राक्तपैत्तीन<BR>+ चणप् = रक्तपैत्तचण<BR>+ चरट् = रक्तपैत्तचर<BR>+ चुञ्चुप् = रक्तपैत्तचुञ्चु<BR>+ च्विँ = रक्तपैत्ती<BR>+ छ = रक्तपैत्तीय<BR>+ जातीयर् = रक्तपैत्तजातीय<BR>+ जाहच् = रक्तपैत्तजाह<BR>+ ञ्यट् = राक्तपैत्त्य<BR>+ ठक् = राक्तपैत्तिक, राक्तपैत्तिक<BR>+ ठन् = रक्तपैत्तिक<BR>+ तमप् = रक्तपैत्ततम<BR>+ तरप् = रक्तपैत्ततर<BR>+ तल् = रक्तपैत्तता<BR>+ तसिँ = रक्तपैत्ततस्<BR>+ त्रा = रक्तपैत्तत्रा<BR>+ त्व = रक्तपैत्तत्व<BR>+ थमुँ = रक्तपैत्तथम्<BR>+ थाल् = रक्तपैत्तथा<BR>+ दघ्नच् = रक्तपैत्तदघ्न<BR>+ देश्य = रक्तपैत्तदेश्य<BR>+ देशीयर् = रक्तपैत्तदेशीय<BR>+ द्वयसच् = रक्तपैत्तद्वयस<BR>+ बहुच् = बहुरक्तपैत्त<BR>+ मतुँप् = रक्तपैत्तवत्<BR>+ मयट् = रक्तपैत्तमय<BR>+ मात्रच् = रक्तपैत्तमात्र<BR>+ पाशप् = रक्तपैत्तपाश<BR>+ यत् = रक्तपैत्त्य<BR>+ रूपप् = रक्तपैत्तरूप<BR>+ रूप्य = रक्तपैत्तरूप्य<BR>+ वलच् = रक्तपैत्तावल<BR>+ शस् = रक्तपैत्तश<BR>+ सातिँ = रक्तपैत्तसात्

