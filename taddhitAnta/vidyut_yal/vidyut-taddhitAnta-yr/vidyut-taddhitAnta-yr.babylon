रुद्रपत्नी स्त्री<BR>+ अण् = रौद्रपत्न<BR>+ अञ् = रौद्रपत्न<BR>+ अस्तातिँ = रुद्रपत्नस्तात्<BR>+ इष्ठन् = रुद्रपत्नीष्ठ<BR>+ ईयसुँन् = रुद्रपत्नीयस्<BR>+ क = रुद्रपत्नीक<BR>+ कन् = रुद्रपत्नीक, रुद्रपत्नीक, रुद्रपत्नीक<BR>+ कल्पप् = रुद्रपत्नीकल्प<BR>+ कुणप् = रुद्रपत्नीकुण<BR>+ खञ् = रौद्रपत्नीन<BR>+ चणप् = रुद्रपत्नीचण<BR>+ चरट् = रुद्रपत्नीचर<BR>+ चुञ्चुप् = रुद्रपत्नीचुञ्चु<BR>+ च्विँ = रुद्रपत्नी<BR>+ छ = रुद्रपत्नीय<BR>+ जातीयर् = रुद्रपत्नीजातीय<BR>+ जाहच् = रुद्रपत्नीजाह<BR>+ ञ्यट् = रौद्रपत्न्य<BR>+ ठक् = रौद्रपत्निक, रौद्रपत्निक<BR>+ ढक् = रौद्रपत्नेय<BR>+ तमप् = रुद्रपत्नीतम<BR>+ तरप् = रुद्रपत्नीतर<BR>+ तल् = रुद्रपत्नीता<BR>+ तसिँ = रुद्रपत्नीतस्<BR>+ त्रा = रुद्रपत्नीत्रा<BR>+ त्व = रुद्रपत्नीत्व<BR>+ थमुँ = रुद्रपत्नीथम्<BR>+ थाल् = रुद्रपत्नीथा<BR>+ दघ्नच् = रुद्रपत्नीदघ्न<BR>+ देश्य = रुद्रपत्नीदेश्य<BR>+ देशीयर् = रुद्रपत्नीदेशीय<BR>+ द्वयसच् = रुद्रपत्नीद्वयस<BR>+ बहुच् = बहुरुद्रपत्नी<BR>+ मतुँप् = रुद्रपत्नीमत्<BR>+ मयट् = रुद्रपत्नीमय<BR>+ मात्रच् = रुद्रपत्नीमात्र<BR>+ पाशप् = रुद्रपत्नीपाश<BR>+ यत् = रुद्रपत्न्य<BR>+ रूपप् = रुद्रपत्नीरूप<BR>+ रूप्य = रुद्रपत्नीरूप्य<BR>+ वलच् = रुद्रपत्नीवल<BR>+ शस् = रुद्रपत्नीश<BR>+ सातिँ = रुद्रपत्नीसात्

