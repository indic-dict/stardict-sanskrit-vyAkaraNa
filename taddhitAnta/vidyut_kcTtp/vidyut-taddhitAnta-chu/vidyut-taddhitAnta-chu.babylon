झम्पिन् पुं<BR>+ अण् = झाम्पिन<BR>+ अञ् = झाम्प<BR>+ अस्तातिँ = झम्पस्तात्<BR>+ इष्ठन् = झम्पिष्ठ<BR>+ ईयसुँन् = झम्पीयस्<BR>+ क = झम्पिक<BR>+ कन् = झम्पिक, झम्पिक, झम्पिक<BR>+ कल्पप् = झम्पिकल्प<BR>+ कुणप् = झम्पिकुण<BR>+ खञ् = झाम्पीन<BR>+ चणप् = झम्पिचण<BR>+ चरट् = झम्पिचर<BR>+ चुञ्चुप् = झम्पिचुञ्चु<BR>+ च्विँ = झम्पि<BR>+ छ = झम्पीय<BR>+ जातीयर् = झम्पिजातीय<BR>+ जाहच् = झम्पिजाह<BR>+ ञ्यट् = झाम्प्य<BR>+ ठक् = झाम्पिक, झाम्पिक<BR>+ ठन् = झम्पिक<BR>+ तमप् = झम्पितम<BR>+ तरप् = झम्पितर<BR>+ तल् = झम्पिता<BR>+ तसिँ = झम्पितस्<BR>+ त्रा = झम्पित्रा<BR>+ त्व = झम्पित्व<BR>+ थमुँ = झम्पिथम्<BR>+ थाल् = झम्पिथा<BR>+ दघ्नच् = झम्पिदघ्न<BR>+ देश्य = झम्पिदेश्य<BR>+ देशीयर् = झम्पिदेशीय<BR>+ द्वयसच् = झम्पिद्वयस<BR>+ बहुच् = बहुझम्पिन्<BR>+ मतुँप् = झम्पिमत्<BR>+ मयट् = झम्पिमय<BR>+ मात्रच् = झम्पिमात्र<BR>+ पाशप् = झम्पिपाश<BR>+ यत् = झम्प्य<BR>+ रूपप् = झम्पिरूप<BR>+ रूप्य = झम्पिरूप्य<BR>+ वलच् = झम्पिवल<BR>+ शस् = झम्पिश<BR>+ सातिँ = झम्पिसात्

