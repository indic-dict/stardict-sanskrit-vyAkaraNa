चर्मपत्त्रा स्त्री<BR>+ अण् = चार्मपत्त्र<BR>+ अञ् = चार्मपत्त्र<BR>+ अस्तातिँ = चर्मपत्त्रस्तात्<BR>+ इष्ठन् = चर्मपत्त्रेष्ठ<BR>+ ईयसुँन् = चर्मपत्त्रेयस्<BR>+ क = चर्मपत्त्राक<BR>+ कन् = चर्मपत्त्राक, चर्मपत्त्राक, चर्मपत्त्राक<BR>+ कल्पप् = चर्मपत्त्राकल्प<BR>+ कुणप् = चर्मपत्त्राकुण<BR>+ खञ् = चार्मपत्त्रीण<BR>+ चणप् = चर्मपत्त्राचण<BR>+ चरट् = चर्मपत्त्राचर<BR>+ चुञ्चुप् = चर्मपत्त्राचुञ्चु<BR>+ च्विँ = चर्मपत्त्रा<BR>+ छ = चर्मपत्त्रीय<BR>+ जातीयर् = चर्मपत्त्राजातीय<BR>+ जाहच् = चर्मपत्त्राजाह<BR>+ ञ्यट् = चार्मपत्त्र्य<BR>+ ठक् = चार्मपत्त्रिक, चार्मपत्त्रिक<BR>+ ढक् = चार्मपत्त्रेय<BR>+ तमप् = चर्मपत्त्रातम<BR>+ तरप् = चर्मपत्त्रातर<BR>+ तल् = चर्मपत्त्राता<BR>+ तसिँ = चर्मपत्त्रातस्<BR>+ त्रा = चर्मपत्त्रात्रा<BR>+ त्व = चर्मपत्त्रात्व<BR>+ थमुँ = चर्मपत्त्राथम्<BR>+ थाल् = चर्मपत्त्राथा<BR>+ दघ्नच् = चर्मपत्त्रादघ्न<BR>+ देश्य = चर्मपत्त्रादेश्य<BR>+ देशीयर् = चर्मपत्त्रादेशीय<BR>+ द्वयसच् = चर्मपत्त्राद्वयस<BR>+ बहुच् = बहुचर्मपत्त्रा<BR>+ मतुँप् = चर्मपत्त्रामत्<BR>+ मयट् = चर्मपत्त्रामय<BR>+ मात्रच् = चर्मपत्त्रामात्र<BR>+ पाशप् = चर्मपत्त्रापाश<BR>+ यत् = चर्मपत्त्र्य<BR>+ रूपप् = चर्मपत्त्रारूप<BR>+ रूप्य = चर्मपत्त्रारूप्य<BR>+ वलच् = चर्मपत्त्रावल<BR>+ शस् = चर्मपत्त्राश<BR>+ सातिँ = चर्मपत्त्रासात्

