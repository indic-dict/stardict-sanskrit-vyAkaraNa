जयतीर्थ पुं<BR>+ अण् = जायतीर्थ<BR>+ अञ् = जायतीर्थ<BR>+ अस्तातिँ = जयतीर्थस्तात्<BR>+ इञ् = जायतीर्थि<BR>+ इनिँ = जयतीर्थिन्<BR>+ इष्ठन् = जयतीर्थिष्ठ<BR>+ ईयसुँन् = जयतीर्थीयस्<BR>+ क = जयतीर्थक<BR>+ कन् = जयतीर्थक, जयतीर्थक, जयतीर्थक<BR>+ कल्पप् = जयतीर्थकल्प<BR>+ कुणप् = जयतीर्थकुण<BR>+ खञ् = जायतीर्थीन<BR>+ चणप् = जयतीर्थचण<BR>+ चरट् = जयतीर्थचर<BR>+ चुञ्चुप् = जयतीर्थचुञ्चु<BR>+ च्विँ = जयतीर्थी<BR>+ छ = जयतीर्थीय<BR>+ जातीयर् = जयतीर्थजातीय<BR>+ जाहच् = जयतीर्थजाह<BR>+ ञ्यट् = जायतीर्थ्य<BR>+ ठक् = जायतीर्थिक, जायतीर्थिक<BR>+ ठन् = जयतीर्थिक<BR>+ तमप् = जयतीर्थतम<BR>+ तरप् = जयतीर्थतर<BR>+ तल् = जयतीर्थता<BR>+ तसिँ = जयतीर्थतस्<BR>+ त्रा = जयतीर्थत्रा<BR>+ त्व = जयतीर्थत्व<BR>+ थमुँ = जयतीर्थथम्<BR>+ थाल् = जयतीर्थथा<BR>+ दघ्नच् = जयतीर्थदघ्न<BR>+ देश्य = जयतीर्थदेश्य<BR>+ देशीयर् = जयतीर्थदेशीय<BR>+ द्वयसच् = जयतीर्थद्वयस<BR>+ बहुच् = बहुजयतीर्थ<BR>+ मतुँप् = जयतीर्थवत्<BR>+ मयट् = जयतीर्थमय<BR>+ मात्रच् = जयतीर्थमात्र<BR>+ पाशप् = जयतीर्थपाश<BR>+ यत् = जयतीर्थ्य<BR>+ रूपप् = जयतीर्थरूप<BR>+ रूप्य = जयतीर्थरूप्य<BR>+ वलच् = जयतीर्थावल<BR>+ शस् = जयतीर्थश<BR>+ सातिँ = जयतीर्थसात्

