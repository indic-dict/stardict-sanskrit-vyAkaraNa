चटत् <BR>+ अण् = चाटत<BR>+ अञ् = चाटत<BR>+ अस्तातिँ = चटतस्तात्<BR>+ इष्ठन् = चटिष्ठ<BR>+ ईयसुँन् = चटीयस्<BR>+ क = चटत्क<BR>+ कन् = चटत्क, चटत्क, चटत्क<BR>+ कल्पप् = चटत्कल्प<BR>+ कुणप् = चटत्कुण<BR>+ खञ् = चाटतीन<BR>+ चणप् = चटच्चण<BR>+ चरट् = चटच्चर<BR>+ चुञ्चुप् = चटच्चुञ्चु<BR>+ च्विँ = चटद्<BR>+ छ = चटतीय<BR>+ जातीयर् = चटज्जातीय<BR>+ जाहच् = चटज्जाह<BR>+ ञ्यट् = चाटत्य<BR>+ ठक् = चाटत्क, चाटत्क<BR>+ ठन् = चटत्क<BR>+ तमप् = चटत्तम<BR>+ तरप् = चटत्तर<BR>+ तल् = चटत्ता<BR>+ तसिँ = चटत्तस्<BR>+ त्रा = चटत्त्रा<BR>+ त्व = चटत्त्व<BR>+ थमुँ = चटत्थम्<BR>+ थाल् = चटत्था<BR>+ दघ्नच् = चटद्दघ्न<BR>+ देश्य = चटद्देश्य<BR>+ देशीयर् = चटद्देशीय<BR>+ द्वयसच् = चटद्द्वयस<BR>+ बहुच् = बहुचटत्<BR>+ मतुँप् = चटत्वत्<BR>+ मयट् = चटन्मय<BR>+ मात्रच् = चटन्मात्र<BR>+ पाशप् = चटत्पाश<BR>+ यत् = चटत्य<BR>+ रूपप् = चटद्रूप<BR>+ रूप्य = चटद्रूप्य<BR>+ वलच् = चटत्वल<BR>+ शस् = चटच्छ, चटच्श<BR>+ सातिँ = चटत्सात्

