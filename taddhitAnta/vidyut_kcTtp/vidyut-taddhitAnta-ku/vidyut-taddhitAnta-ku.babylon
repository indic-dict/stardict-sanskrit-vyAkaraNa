खत्तखुत्त पुं<BR>+ अण् = खात्तखुत्त<BR>+ अञ् = खात्तखुत्त<BR>+ अस्तातिँ = खत्तखुत्तस्तात्<BR>+ इञ् = खात्तखुत्ति<BR>+ इनिँ = खत्तखुत्तिन्<BR>+ इष्ठन् = खत्तखुत्तिष्ठ<BR>+ ईयसुँन् = खत्तखुत्तीयस्<BR>+ क = खत्तखुत्तक<BR>+ कन् = खत्तखुत्तक, खत्तखुत्तक, खत्तखुत्तक<BR>+ कल्पप् = खत्तखुत्तकल्प<BR>+ कुणप् = खत्तखुत्तकुण<BR>+ खञ् = खात्तखुत्तीन<BR>+ चणप् = खत्तखुत्तचण<BR>+ चरट् = खत्तखुत्तचर<BR>+ चुञ्चुप् = खत्तखुत्तचुञ्चु<BR>+ च्विँ = खत्तखुत्ती<BR>+ छ = खत्तखुत्तीय<BR>+ जातीयर् = खत्तखुत्तजातीय<BR>+ जाहच् = खत्तखुत्तजाह<BR>+ ञ्यट् = खात्तखुत्त्य<BR>+ ठक् = खात्तखुत्तिक, खात्तखुत्तिक<BR>+ ठन् = खत्तखुत्तिक<BR>+ तमप् = खत्तखुत्ततम<BR>+ तरप् = खत्तखुत्ततर<BR>+ तल् = खत्तखुत्तता<BR>+ तसिँ = खत्तखुत्ततस्<BR>+ त्रा = खत्तखुत्तत्रा<BR>+ त्व = खत्तखुत्तत्व<BR>+ थमुँ = खत्तखुत्तथम्<BR>+ थाल् = खत्तखुत्तथा<BR>+ दघ्नच् = खत्तखुत्तदघ्न<BR>+ देश्य = खत्तखुत्तदेश्य<BR>+ देशीयर् = खत्तखुत्तदेशीय<BR>+ द्वयसच् = खत्तखुत्तद्वयस<BR>+ बहुच् = बहुखत्तखुत्त<BR>+ मतुँप् = खत्तखुत्तवत्<BR>+ मयट् = खत्तखुत्तमय<BR>+ मात्रच् = खत्तखुत्तमात्र<BR>+ पाशप् = खत्तखुत्तपाश<BR>+ यत् = खत्तखुत्त्य<BR>+ रूपप् = खत्तखुत्तरूप<BR>+ रूप्य = खत्तखुत्तरूप्य<BR>+ वलच् = खत्तखुत्तावल<BR>+ शस् = खत्तखुत्तश<BR>+ सातिँ = खत्तखुत्तसात्

