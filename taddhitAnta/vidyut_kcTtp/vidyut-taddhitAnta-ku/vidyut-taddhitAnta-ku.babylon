खरत्व नपुंसक<BR>+ अण् = खारत्व<BR>+ अञ् = खारत्व<BR>+ अस्तातिँ = खरत्वस्तात्<BR>+ इञ् = खारत्वि<BR>+ इनिँ = खरत्विन्<BR>+ इष्ठन् = खरत्विष्ठ<BR>+ ईयसुँन् = खरत्वीयस्<BR>+ क = खरत्वक<BR>+ कन् = खरत्वक, खरत्वक, खरत्वक<BR>+ कल्पप् = खरत्वकल्प<BR>+ कुणप् = खरत्वकुण<BR>+ खञ् = खारत्वीन<BR>+ चणप् = खरत्वचण<BR>+ चरट् = खरत्वचर<BR>+ चुञ्चुप् = खरत्वचुञ्चु<BR>+ च्विँ = खरत्वी<BR>+ छ = खरत्वीय<BR>+ जातीयर् = खरत्वजातीय<BR>+ जाहच् = खरत्वजाह<BR>+ ञ्यट् = खारत्व्य<BR>+ ठक् = खारत्विक, खारत्विक<BR>+ ठन् = खरत्विक<BR>+ तमप् = खरत्वतम<BR>+ तरप् = खरत्वतर<BR>+ तल् = खरत्वता<BR>+ तसिँ = खरत्वतस्<BR>+ त्रा = खरत्वत्रा<BR>+ त्व = खरत्वत्व<BR>+ थमुँ = खरत्वथम्<BR>+ थाल् = खरत्वथा<BR>+ दघ्नच् = खरत्वदघ्न<BR>+ देश्य = खरत्वदेश्य<BR>+ देशीयर् = खरत्वदेशीय<BR>+ द्वयसच् = खरत्वद्वयस<BR>+ बहुच् = बहुखरत्व<BR>+ मतुँप् = खरत्ववत्<BR>+ मयट् = खरत्वमय<BR>+ मात्रच् = खरत्वमात्र<BR>+ पाशप् = खरत्वपाश<BR>+ यत् = खरत्व्य<BR>+ रूपप् = खरत्वरूप<BR>+ रूप्य = खरत्वरूप्य<BR>+ वलच् = खरत्वावल<BR>+ शस् = खरत्वश<BR>+ सातिँ = खरत्वसात्

