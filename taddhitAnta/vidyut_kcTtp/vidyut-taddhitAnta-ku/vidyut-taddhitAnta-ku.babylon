गर्मुत् स्त्री<BR>+ अण् = गार्मुत<BR>+ अञ् = गार्मुत<BR>+ अस्तातिँ = गर्मुतस्तात्<BR>+ इष्ठन् = गर्मिष्ठ<BR>+ ईयसुँन् = गर्मीयस्<BR>+ क = गर्मुत्क<BR>+ कन् = गर्मुत्क, गर्मुत्क, गर्मुत्क<BR>+ कल्पप् = गर्मुत्कल्प<BR>+ कुणप् = गर्मुत्कुण<BR>+ खञ् = गार्मुतीन<BR>+ चणप् = गर्मुच्चण<BR>+ चरट् = गर्मुच्चर<BR>+ चुञ्चुप् = गर्मुच्चुञ्चु<BR>+ च्विँ = गर्मुद्<BR>+ छ = गर्मुतीय<BR>+ जातीयर् = गर्मुज्जातीय<BR>+ जाहच् = गर्मुज्जाह<BR>+ ञ्यट् = गार्मुत्य<BR>+ ठक् = गार्मुत्क, गार्मुत्क<BR>+ ठन् = गर्मुत्क<BR>+ तमप् = गर्मुत्तम<BR>+ तरप् = गर्मुत्तर<BR>+ तल् = गर्मुत्ता<BR>+ तसिँ = गर्मुत्तस्<BR>+ त्रा = गर्मुत्त्रा<BR>+ त्व = गर्मुत्त्व<BR>+ थमुँ = गर्मुत्थम्<BR>+ थाल् = गर्मुत्था<BR>+ दघ्नच् = गर्मुद्दघ्न<BR>+ देश्य = गर्मुद्देश्य<BR>+ देशीयर् = गर्मुद्देशीय<BR>+ द्वयसच् = गर्मुद्द्वयस<BR>+ बहुच् = बहुगर्मुत्<BR>+ मतुँप् = गर्मुत्वत्<BR>+ मयट् = गर्मुन्मय<BR>+ मात्रच् = गर्मुन्मात्र<BR>+ पाशप् = गर्मुत्पाश<BR>+ यत् = गर्मुत्य<BR>+ रूपप् = गर्मुद्रूप<BR>+ रूप्य = गर्मुद्रूप्य<BR>+ वलच् = गर्मुत्वल<BR>+ शस् = गर्मुच्छ, गर्मुच्श<BR>+ सातिँ = गर्मुत्सात्

