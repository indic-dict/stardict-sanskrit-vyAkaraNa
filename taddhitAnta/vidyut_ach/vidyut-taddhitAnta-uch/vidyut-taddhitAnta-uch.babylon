उत्पथ पुं<BR>+ अण् = औत्पथ<BR>+ अञ् = औत्पथ<BR>+ अस्तातिँ = उत्पथस्तात्<BR>+ इञ् = औत्पथि<BR>+ इनिँ = उत्पथिन्<BR>+ इष्ठन् = उत्पथिष्ठ<BR>+ ईयसुँन् = उत्पथीयस्<BR>+ क = उत्पथक<BR>+ कन् = उत्पथक, उत्पथक, उत्पथक<BR>+ कल्पप् = उत्पथकल्प<BR>+ कुणप् = उत्पथकुण<BR>+ खञ् = औत्पथीन<BR>+ चणप् = उत्पथचण<BR>+ चरट् = उत्पथचर<BR>+ चुञ्चुप् = उत्पथचुञ्चु<BR>+ च्विँ = उत्पथी<BR>+ छ = उत्पथीय<BR>+ जातीयर् = उत्पथजातीय<BR>+ जाहच् = उत्पथजाह<BR>+ ञ्यट् = औत्पथ्य<BR>+ ठक् = औत्पथिक, औत्पथिक<BR>+ ठन् = उत्पथिक<BR>+ तमप् = उत्पथतम<BR>+ तरप् = उत्पथतर<BR>+ तल् = उत्पथता<BR>+ तसिँ = उत्पथतस्<BR>+ त्रा = उत्पथत्रा<BR>+ त्व = उत्पथत्व<BR>+ थमुँ = उत्पथथम्<BR>+ थाल् = उत्पथथा<BR>+ दघ्नच् = उत्पथदघ्न<BR>+ देश्य = उत्पथदेश्य<BR>+ देशीयर् = उत्पथदेशीय<BR>+ द्वयसच् = उत्पथद्वयस<BR>+ बहुच् = बहूत्पथ<BR>+ मतुँप् = उत्पथवत्<BR>+ मयट् = उत्पथमय<BR>+ मात्रच् = उत्पथमात्र<BR>+ पाशप् = उत्पथपाश<BR>+ यत् = उत्पथ्य<BR>+ रूपप् = उत्पथरूप<BR>+ रूप्य = उत्पथरूप्य<BR>+ वलच् = उत्पथावल<BR>+ शस् = उत्पथश<BR>+ सातिँ = उत्पथसात्

