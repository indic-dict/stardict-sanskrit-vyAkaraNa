उपरिप्रुत् पुं,स्त्री,नपुंसक<BR>+ अण् = औपरिप्रुत<BR>+ अञ् = औपरिप्रुत<BR>+ अस्तातिँ = उपरिप्रुतस्तात्<BR>+ इष्ठन् = उपरिप्रिष्ठ<BR>+ ईयसुँन् = उपरिप्रीयस्<BR>+ क = उपरिप्रुत्क<BR>+ कन् = उपरिप्रुत्क, उपरिप्रुत्क, उपरिप्रुत्क<BR>+ कल्पप् = उपरिप्रुत्कल्प<BR>+ कुणप् = उपरिप्रुत्कुण<BR>+ खञ् = औपरिप्रुतीन<BR>+ चणप् = उपरिप्रुच्चण<BR>+ चरट् = उपरिप्रुच्चर<BR>+ चुञ्चुप् = उपरिप्रुच्चुञ्चु<BR>+ च्विँ = उपरिप्रुद्<BR>+ छ = उपरिप्रुतीय<BR>+ जातीयर् = उपरिप्रुज्जातीय<BR>+ जाहच् = उपरिप्रुज्जाह<BR>+ ञ्यट् = औपरिप्रुत्य<BR>+ ठक् = औपरिप्रुत्क, औपरिप्रुत्क<BR>+ तमप् = उपरिप्रुत्तम<BR>+ तरप् = उपरिप्रुत्तर<BR>+ तल् = उपरिप्रुत्ता<BR>+ तसिँ = उपरिप्रुत्तस्<BR>+ त्रा = उपरिप्रुत्त्रा<BR>+ त्व = उपरिप्रुत्त्व<BR>+ थमुँ = उपरिप्रुत्थम्<BR>+ थाल् = उपरिप्रुत्था<BR>+ दघ्नच् = उपरिप्रुद्दघ्न<BR>+ देश्य = उपरिप्रुद्देश्य<BR>+ देशीयर् = उपरिप्रुद्देशीय<BR>+ द्वयसच् = उपरिप्रुद्द्वयस<BR>+ बहुच् = बहूपरिप्रुत्<BR>+ मतुँप् = उपरिप्रुत्वत्<BR>+ मयट् = उपरिप्रुन्मय<BR>+ मात्रच् = उपरिप्रुन्मात्र<BR>+ पाशप् = उपरिप्रुत्पाश<BR>+ यत् = उपरिप्रुत्य<BR>+ रूपप् = उपरिप्रुद्रूप<BR>+ रूप्य = उपरिप्रुद्रूप्य<BR>+ वलच् = उपरिप्रुत्वल<BR>+ शस् = उपरिप्रुच्छ, उपरिप्रुच्श<BR>+ सातिँ = उपरिप्रुत्सात्

