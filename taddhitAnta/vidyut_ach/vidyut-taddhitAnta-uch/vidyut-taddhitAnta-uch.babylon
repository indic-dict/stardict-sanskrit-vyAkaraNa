उद्भ्रान्त नपुंसक<BR>+ अण् = औद्भ्रान्त<BR>+ अञ् = औद्भ्रान्त<BR>+ अस्तातिँ = उद्भ्रान्तस्तात्<BR>+ इञ् = औद्भ्रान्ति<BR>+ इनिँ = उद्भ्रान्तिन्<BR>+ इष्ठन् = उद्भ्रान्तिष्ठ<BR>+ ईयसुँन् = उद्भ्रान्तीयस्<BR>+ क = उद्भ्रान्तक<BR>+ कन् = उद्भ्रान्तक, उद्भ्रान्तक, उद्भ्रान्तक<BR>+ कल्पप् = उद्भ्रान्तकल्प<BR>+ कुणप् = उद्भ्रान्तकुण<BR>+ खञ् = औद्भ्रान्तीन<BR>+ चणप् = उद्भ्रान्तचण<BR>+ चरट् = उद्भ्रान्तचर<BR>+ चुञ्चुप् = उद्भ्रान्तचुञ्चु<BR>+ च्विँ = उद्भ्रान्ती<BR>+ छ = उद्भ्रान्तीय<BR>+ जातीयर् = उद्भ्रान्तजातीय<BR>+ जाहच् = उद्भ्रान्तजाह<BR>+ ञ्यट् = औद्भ्रान्त्य<BR>+ ठक् = औद्भ्रान्तिक, औद्भ्रान्तिक<BR>+ ठन् = उद्भ्रान्तिक<BR>+ तमप् = उद्भ्रान्ततम<BR>+ तरप् = उद्भ्रान्ततर<BR>+ तल् = उद्भ्रान्तता<BR>+ तसिँ = उद्भ्रान्ततस्<BR>+ त्रा = उद्भ्रान्तत्रा<BR>+ त्व = उद्भ्रान्तत्व<BR>+ थमुँ = उद्भ्रान्तथम्<BR>+ थाल् = उद्भ्रान्तथा<BR>+ दघ्नच् = उद्भ्रान्तदघ्न<BR>+ देश्य = उद्भ्रान्तदेश्य<BR>+ देशीयर् = उद्भ्रान्तदेशीय<BR>+ द्वयसच् = उद्भ्रान्तद्वयस<BR>+ बहुच् = बहूद्भ्रान्त<BR>+ मतुँप् = उद्भ्रान्तवत्<BR>+ मयट् = उद्भ्रान्तमय<BR>+ मात्रच् = उद्भ्रान्तमात्र<BR>+ पाशप् = उद्भ्रान्तपाश<BR>+ यत् = उद्भ्रान्त्य<BR>+ रूपप् = उद्भ्रान्तरूप<BR>+ रूप्य = उद्भ्रान्तरूप्य<BR>+ वलच् = उद्भ्रान्तावल<BR>+ शस् = उद्भ्रान्तश<BR>+ सातिँ = उद्भ्रान्तसात्

