उपतपत् नपुंसक<BR>+ अण् = औपतपत<BR>+ अञ् = औपतपत<BR>+ अस्तातिँ = उपतपतस्तात्<BR>+ इष्ठन् = उपतपिष्ठ<BR>+ ईयसुँन् = उपतपीयस्<BR>+ क = उपतपत्क<BR>+ कन् = उपतपत्क, उपतपत्क, उपतपत्क<BR>+ कल्पप् = उपतपत्कल्प<BR>+ कुणप् = उपतपत्कुण<BR>+ खञ् = औपतपतीन<BR>+ चणप् = उपतपच्चण<BR>+ चरट् = उपतपच्चर<BR>+ चुञ्चुप् = उपतपच्चुञ्चु<BR>+ च्विँ = उपतपद्<BR>+ छ = उपतपतीय<BR>+ जातीयर् = उपतपज्जातीय<BR>+ जाहच् = उपतपज्जाह<BR>+ ञ्यट् = औपतपत्य<BR>+ ठक् = औपतपत्क, औपतपत्क<BR>+ तमप् = उपतपत्तम<BR>+ तरप् = उपतपत्तर<BR>+ तल् = उपतपत्ता<BR>+ तसिँ = उपतपत्तस्<BR>+ त्रा = उपतपत्त्रा<BR>+ त्व = उपतपत्त्व<BR>+ थमुँ = उपतपत्थम्<BR>+ थाल् = उपतपत्था<BR>+ दघ्नच् = उपतपद्दघ्न<BR>+ देश्य = उपतपद्देश्य<BR>+ देशीयर् = उपतपद्देशीय<BR>+ द्वयसच् = उपतपद्द्वयस<BR>+ बहुच् = बहूपतपत्<BR>+ मतुँप् = उपतपत्वत्<BR>+ मयट् = उपतपन्मय<BR>+ मात्रच् = उपतपन्मात्र<BR>+ पाशप् = उपतपत्पाश<BR>+ यत् = उपतपत्य<BR>+ रूपप् = उपतपद्रूप<BR>+ रूप्य = उपतपद्रूप्य<BR>+ वलच् = उपतपत्वल<BR>+ शस् = उपतपच्छ, उपतपच्श<BR>+ सातिँ = उपतपत्सात्

