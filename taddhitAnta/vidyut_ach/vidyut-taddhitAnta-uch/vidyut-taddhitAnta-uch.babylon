उत् <BR>+ अण् = औत<BR>+ अञ् = औत<BR>+ अस्तातिँ = उतस्तात्<BR>+ इष्ठन् = उतिष्ठ<BR>+ ईयसुँन् = उतीयस्<BR>+ क = उत्क<BR>+ कन् = उत्क, उत्क, उत्क<BR>+ कल्पप् = उत्कल्प<BR>+ कुणप् = उत्कुण<BR>+ खञ् = औतीन<BR>+ चणप् = उच्चण<BR>+ चरट् = उच्चर<BR>+ चुञ्चुप् = उच्चुञ्चु<BR>+ च्विँ = उद्<BR>+ छ = उतीय<BR>+ जातीयर् = उज्जातीय<BR>+ जाहच् = उज्जाह<BR>+ ञ्यट् = औत्य<BR>+ ठक् = औत्क, औत्क<BR>+ तमप् = उत्तम<BR>+ तरप् = उत्तर<BR>+ तल् = उत्ता<BR>+ तसिँ = उत्तस्<BR>+ त्रा = उत्त्रा<BR>+ त्व = उत्त्व<BR>+ थमुँ = उत्थम्<BR>+ थाल् = उत्था<BR>+ दघ्नच् = उद्दघ्न<BR>+ देश्य = उद्देश्य<BR>+ देशीयर् = उद्देशीय<BR>+ द्वयसच् = उद्द्वयस<BR>+ बहुच् = बहूत्<BR>+ मतुँप् = उत्वत्<BR>+ मयट् = उन्मय<BR>+ मात्रच् = उन्मात्र<BR>+ पाशप् = उत्पाश<BR>+ यत् = उत्य<BR>+ रूपप् = उद्रूप<BR>+ रूप्य = उद्रूप्य<BR>+ वलच् = उत्वल<BR>+ शस् = उच्छ, उच्श<BR>+ सातिँ = उत्सात्

