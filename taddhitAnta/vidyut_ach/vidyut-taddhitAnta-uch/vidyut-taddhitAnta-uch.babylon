उत्तरदिक्स्थ पुं,स्त्री,नपुंसक<BR>+ अण् = औत्तरदिक्स्थ<BR>+ अञ् = औत्तरदिक्स्थ<BR>+ अस्तातिँ = उत्तरदिक्स्थस्तात्<BR>+ इञ् = औत्तरदिक्स्थि<BR>+ इनिँ = उत्तरदिक्स्थिन्<BR>+ इष्ठन् = उत्तरदिक्स्थिष्ठ<BR>+ ईयसुँन् = उत्तरदिक्स्थीयस्<BR>+ क = उत्तरदिक्स्थक<BR>+ कन् = उत्तरदिक्स्थक, उत्तरदिक्स्थक, उत्तरदिक्स्थक<BR>+ कल्पप् = उत्तरदिक्स्थकल्प<BR>+ कुणप् = उत्तरदिक्स्थकुण<BR>+ खञ् = औत्तरदिक्स्थीन<BR>+ चणप् = उत्तरदिक्स्थचण<BR>+ चरट् = उत्तरदिक्स्थचर<BR>+ चुञ्चुप् = उत्तरदिक्स्थचुञ्चु<BR>+ च्विँ = उत्तरदिक्स्थी<BR>+ छ = उत्तरदिक्स्थीय<BR>+ जातीयर् = उत्तरदिक्स्थजातीय<BR>+ जाहच् = उत्तरदिक्स्थजाह<BR>+ ञ्यट् = औत्तरदिक्स्थ्य<BR>+ ठक् = औत्तरदिक्स्थिक, औत्तरदिक्स्थिक<BR>+ ठन् = उत्तरदिक्स्थिक<BR>+ तमप् = उत्तरदिक्स्थतम<BR>+ तरप् = उत्तरदिक्स्थतर<BR>+ तल् = उत्तरदिक्स्थता<BR>+ तसिँ = उत्तरदिक्स्थतस्<BR>+ त्रा = उत्तरदिक्स्थत्रा<BR>+ त्व = उत्तरदिक्स्थत्व<BR>+ थमुँ = उत्तरदिक्स्थथम्<BR>+ थाल् = उत्तरदिक्स्थथा<BR>+ दघ्नच् = उत्तरदिक्स्थदघ्न<BR>+ देश्य = उत्तरदिक्स्थदेश्य<BR>+ देशीयर् = उत्तरदिक्स्थदेशीय<BR>+ द्वयसच् = उत्तरदिक्स्थद्वयस<BR>+ बहुच् = बहूत्तरदिक्स्थ<BR>+ मतुँप् = उत्तरदिक्स्थवत्<BR>+ मयट् = उत्तरदिक्स्थमय<BR>+ मात्रच् = उत्तरदिक्स्थमात्र<BR>+ पाशप् = उत्तरदिक्स्थपाश<BR>+ यत् = उत्तरदिक्स्थ्य<BR>+ रूपप् = उत्तरदिक्स्थरूप<BR>+ रूप्य = उत्तरदिक्स्थरूप्य<BR>+ वलच् = उत्तरदिक्स्थावल<BR>+ शस् = उत्तरदिक्स्थश<BR>+ सातिँ = उत्तरदिक्स्थसात्

