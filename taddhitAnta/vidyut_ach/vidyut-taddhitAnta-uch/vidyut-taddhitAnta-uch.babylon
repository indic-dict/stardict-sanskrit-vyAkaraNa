उत्थितता स्त्री<BR>+ अण् = औत्थितत<BR>+ अञ् = औत्थितत<BR>+ अस्तातिँ = उत्थिततस्तात्<BR>+ इष्ठन् = उत्थिततेष्ठ<BR>+ ईयसुँन् = उत्थिततेयस्<BR>+ क = उत्थितताक<BR>+ कन् = उत्थितताक, उत्थितताक, उत्थितताक<BR>+ कल्पप् = उत्थितताकल्प<BR>+ कुणप् = उत्थितताकुण<BR>+ खञ् = औत्थिततीन<BR>+ चणप् = उत्थितताचण<BR>+ चरट् = उत्थितताचर<BR>+ चुञ्चुप् = उत्थितताचुञ्चु<BR>+ च्विँ = उत्थितता<BR>+ छ = उत्थिततीय<BR>+ जातीयर् = उत्थितताजातीय<BR>+ जाहच् = उत्थितताजाह<BR>+ ञ्यट् = औत्थितत्य<BR>+ ठक् = औत्थिततिक, औत्थिततिक<BR>+ ढक् = औत्थिततेय<BR>+ तमप् = उत्थिततातम<BR>+ तरप् = उत्थिततातर<BR>+ तल् = उत्थितताता<BR>+ तसिँ = उत्थिततातस्<BR>+ त्रा = उत्थिततात्रा<BR>+ त्व = उत्थिततात्व<BR>+ थमुँ = उत्थितताथम्<BR>+ थाल् = उत्थितताथा<BR>+ दघ्नच् = उत्थिततादघ्न<BR>+ देश्य = उत्थिततादेश्य<BR>+ देशीयर् = उत्थिततादेशीय<BR>+ द्वयसच् = उत्थितताद्वयस<BR>+ बहुच् = बहूत्थितता<BR>+ मतुँप् = उत्थिततामत्<BR>+ मयट् = उत्थिततामय<BR>+ मात्रच् = उत्थिततामात्र<BR>+ पाशप् = उत्थिततापाश<BR>+ यत् = उत्थितत्य<BR>+ रूपप् = उत्थिततारूप<BR>+ रूप्य = उत्थिततारूप्य<BR>+ वलच् = उत्थिततावल<BR>+ शस् = उत्थितताश<BR>+ सातिँ = उत्थिततासात्

