उपाप्ति स्त्री<BR>+ अण् = औपाप्त<BR>+ अञ् = औपाप्त<BR>+ अस्तातिँ = उपाप्तस्तात्<BR>+ इष्ठन् = उपाप्तिष्ठ<BR>+ ईयसुँन् = उपाप्तीयस्<BR>+ क = उपाप्तिक<BR>+ कन् = उपाप्तिक, उपाप्तिक, उपाप्तिक<BR>+ कल्पप् = उपाप्तिकल्प<BR>+ कुणप् = उपाप्तिकुण<BR>+ खञ् = औपाप्तीन<BR>+ चणप् = उपाप्तिचण<BR>+ चरट् = उपाप्तिचर<BR>+ चुञ्चुप् = उपाप्तिचुञ्चु<BR>+ च्विँ = उपाप्ती<BR>+ छ = उपाप्तीय<BR>+ जातीयर् = उपाप्तिजातीय<BR>+ जाहच् = उपाप्तिजाह<BR>+ ञ्यङ् = औपाप्त्य<BR>+ ञ्यट् = औपाप्त्य<BR>+ ठक् = औपाप्तिक, औपाप्तिक<BR>+ तमप् = उपाप्तितम<BR>+ तरप् = उपाप्तितर<BR>+ तल् = उपाप्तिता<BR>+ तसिँ = उपाप्तितस्<BR>+ त्रा = उपाप्तित्रा<BR>+ त्व = उपाप्तित्व<BR>+ थमुँ = उपाप्तिथम्<BR>+ थाल् = उपाप्तिथा<BR>+ दघ्नच् = उपाप्तिदघ्न<BR>+ देश्य = उपाप्तिदेश्य<BR>+ देशीयर् = उपाप्तिदेशीय<BR>+ द्वयसच् = उपाप्तिद्वयस<BR>+ बहुच् = बहूपाप्ति<BR>+ मतुँप् = उपाप्तिमत्<BR>+ मयट् = उपाप्तिमय<BR>+ मात्रच् = उपाप्तिमात्र<BR>+ पाशप् = उपाप्तिपाश<BR>+ यत् = उपाप्त्य<BR>+ रूपप् = उपाप्तिरूप<BR>+ रूप्य = उपाप्तिरूप्य<BR>+ वलच् = उपाप्तीवल<BR>+ शस् = उपाप्तिश<BR>+ सातिँ = उपाप्तिसात्

