उत्तरा स्त्री<BR>+ अण् = औत्तर<BR>+ अञ् = औत्तर<BR>+ अस्तातिँ = उत्तरस्तात्<BR>+ इष्ठन् = उत्तरेष्ठ<BR>+ ईयसुँन् = उत्तरेयस्<BR>+ क = उत्तराक<BR>+ कन् = उत्तराक, उत्तराक, उत्तराक<BR>+ कल्पप् = उत्तराकल्प<BR>+ कुणप् = उत्तराकुण<BR>+ खञ् = औत्तरीण<BR>+ चणप् = उत्तराचण<BR>+ चरट् = उत्तराचर<BR>+ चुञ्चुप् = उत्तराचुञ्चु<BR>+ च्विँ = उत्तरा<BR>+ छ = उत्तरीय<BR>+ जातीयर् = उत्तराजातीय<BR>+ जाहच् = उत्तराजाह<BR>+ ञ्यट् = औत्तर्य<BR>+ ठक् = औत्तरिक, औत्तरिक<BR>+ ढक् = औत्तरेय<BR>+ तमप् = उत्तरातम<BR>+ तरप् = उत्तरातर<BR>+ तल् = उत्तराता<BR>+ तसिँ = उत्तरातस्<BR>+ त्रा = उत्तरात्रा<BR>+ त्व = उत्तरात्व<BR>+ थमुँ = उत्तराथम्<BR>+ थाल् = उत्तराथा<BR>+ दघ्नच् = उत्तरादघ्न<BR>+ देश्य = उत्तरादेश्य<BR>+ देशीयर् = उत्तरादेशीय<BR>+ द्वयसच् = उत्तराद्वयस<BR>+ बहुच् = बहूत्तरा<BR>+ मतुँप् = उत्तरामत्<BR>+ मयट् = उत्तरामय<BR>+ मात्रच् = उत्तरामात्र<BR>+ पाशप् = उत्तरापाश<BR>+ यत् = उत्तर्य<BR>+ रूपप् = उत्तरारूप<BR>+ रूप्य = उत्तरारूप्य<BR>+ वलच् = उत्तरावल<BR>+ शस् = उत्तराश<BR>+ सातिँ = उत्तरासात्

