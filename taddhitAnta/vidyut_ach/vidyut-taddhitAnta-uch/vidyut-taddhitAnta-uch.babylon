उत्तानक पुं<BR>+ अण् = औत्तानक<BR>+ अञ् = औत्तानक<BR>+ अस्तातिँ = उत्तानकस्तात्<BR>+ इञ् = औत्तानकि<BR>+ इनिँ = उत्तानकिन्<BR>+ इष्ठन् = उत्तानकिष्ठ<BR>+ ईयसुँन् = उत्तानकीयस्<BR>+ क = उत्तानकक<BR>+ कन् = उत्तानकक, उत्तानकक, उत्तानकक<BR>+ कल्पप् = उत्तानककल्प<BR>+ कुणप् = उत्तानककुण<BR>+ खञ् = औत्तानकीन<BR>+ चणप् = उत्तानकचण<BR>+ चरट् = उत्तानकचर<BR>+ चुञ्चुप् = उत्तानकचुञ्चु<BR>+ च्विँ = उत्तानकी<BR>+ छ = उत्तानकीय<BR>+ जातीयर् = उत्तानकजातीय<BR>+ जाहच् = उत्तानकजाह<BR>+ ञ्यट् = औत्तानक्य<BR>+ ठक् = औत्तानकिक, औत्तानकिक<BR>+ ठन् = उत्तानकिक<BR>+ तमप् = उत्तानकतम<BR>+ तरप् = उत्तानकतर<BR>+ तल् = उत्तानकता<BR>+ तसिँ = उत्तानकतस्<BR>+ त्रा = उत्तानकत्रा<BR>+ त्व = उत्तानकत्व<BR>+ थमुँ = उत्तानकथम्<BR>+ थाल् = उत्तानकथा<BR>+ दघ्नच् = उत्तानकदघ्न<BR>+ देश्य = उत्तानकदेश्य<BR>+ देशीयर् = उत्तानकदेशीय<BR>+ द्वयसच् = उत्तानकद्वयस<BR>+ बहुच् = बहूत्तानक<BR>+ मतुँप् = उत्तानकवत्<BR>+ मयट् = उत्तानकमय<BR>+ मात्रच् = उत्तानकमात्र<BR>+ पाशप् = उत्तानकपाश<BR>+ यत् = उत्तानक्य<BR>+ रूपप् = उत्तानकरूप<BR>+ रूप्य = उत्तानकरूप्य<BR>+ वलच् = उत्तानकावल<BR>+ शस् = उत्तानकश<BR>+ सातिँ = उत्तानकसात्

