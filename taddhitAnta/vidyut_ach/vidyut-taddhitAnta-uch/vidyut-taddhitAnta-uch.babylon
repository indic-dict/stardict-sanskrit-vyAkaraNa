उपस्थान नपुंसक<BR>+ अण् = औपस्थान<BR>+ अञ् = औपस्थान<BR>+ अस्तातिँ = उपस्थानस्तात्<BR>+ इञ् = औपस्थानि<BR>+ इनिँ = उपस्थानिन्<BR>+ इष्ठन् = उपस्थानिष्ठ<BR>+ ईयसुँन् = उपस्थानीयस्<BR>+ क = उपस्थानक<BR>+ कन् = उपस्थानक, उपस्थानक, उपस्थानक<BR>+ कल्पप् = उपस्थानकल्प<BR>+ कुणप् = उपस्थानकुण<BR>+ खञ् = औपस्थानीन<BR>+ चणप् = उपस्थानचण<BR>+ चरट् = उपस्थानचर<BR>+ चुञ्चुप् = उपस्थानचुञ्चु<BR>+ च्विँ = उपस्थानी<BR>+ छ = उपस्थानीय<BR>+ जातीयर् = उपस्थानजातीय<BR>+ जाहच् = उपस्थानजाह<BR>+ ञ्यट् = औपस्थान्य<BR>+ ठक् = औपस्थानिक, औपस्थानिक<BR>+ ठन् = उपस्थानिक<BR>+ ण = औपस्थान<BR>+ तमप् = उपस्थानतम<BR>+ तरप् = उपस्थानतर<BR>+ तल् = उपस्थानता<BR>+ तसिँ = उपस्थानतस्<BR>+ त्रा = उपस्थानत्रा<BR>+ त्व = उपस्थानत्व<BR>+ थमुँ = उपस्थानथम्<BR>+ थाल् = उपस्थानथा<BR>+ दघ्नच् = उपस्थानदघ्न<BR>+ देश्य = उपस्थानदेश्य<BR>+ देशीयर् = उपस्थानदेशीय<BR>+ द्वयसच् = उपस्थानद्वयस<BR>+ बहुच् = बहूपस्थान<BR>+ मतुँप् = उपस्थानवत्<BR>+ मयट् = उपस्थानमय<BR>+ मात्रच् = उपस्थानमात्र<BR>+ पाशप् = उपस्थानपाश<BR>+ यत् = उपस्थान्य<BR>+ रूपप् = उपस्थानरूप<BR>+ रूप्य = उपस्थानरूप्य<BR>+ वलच् = उपस्थानावल<BR>+ शस् = उपस्थानश<BR>+ सातिँ = उपस्थानसात्

