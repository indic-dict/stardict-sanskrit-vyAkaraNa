उद्धत पुं<BR>+ अण् = औद्धत<BR>+ अञ् = औद्धत<BR>+ अस्तातिँ = उद्धतस्तात्<BR>+ इञ् = औद्धति<BR>+ इनिँ = उद्धतिन्<BR>+ इष्ठन् = उद्धतिष्ठ<BR>+ ईयसुँन् = उद्धतीयस्<BR>+ क = उद्धतक<BR>+ कन् = उद्धतक, उद्धतक, उद्धतक<BR>+ कल्पप् = उद्धतकल्प<BR>+ कुणप् = उद्धतकुण<BR>+ खञ् = औद्धतीन<BR>+ चणप् = उद्धतचण<BR>+ चरट् = उद्धतचर<BR>+ चुञ्चुप् = उद्धतचुञ्चु<BR>+ च्विँ = उद्धती<BR>+ छ = उद्धतीय<BR>+ जातीयर् = उद्धतजातीय<BR>+ जाहच् = उद्धतजाह<BR>+ ञ्यट् = औद्धत्य<BR>+ ठक् = औद्धतिक, औद्धतिक<BR>+ ठन् = उद्धतिक<BR>+ तमप् = उद्धततम<BR>+ तरप् = उद्धततर<BR>+ तल् = उद्धतता<BR>+ तसिँ = उद्धततस्<BR>+ त्रा = उद्धतत्रा<BR>+ त्व = उद्धतत्व<BR>+ थमुँ = उद्धतथम्<BR>+ थाल् = उद्धतथा<BR>+ दघ्नच् = उद्धतदघ्न<BR>+ देश्य = उद्धतदेश्य<BR>+ देशीयर् = उद्धतदेशीय<BR>+ द्वयसच् = उद्धतद्वयस<BR>+ बहुच् = बहूद्धत<BR>+ मतुँप् = उद्धतवत्<BR>+ मयट् = उद्धतमय<BR>+ मात्रच् = उद्धतमात्र<BR>+ पाशप् = उद्धतपाश<BR>+ यत् = उद्धत्य<BR>+ रूपप् = उद्धतरूप<BR>+ रूप्य = उद्धतरूप्य<BR>+ वलच् = उद्धतावल<BR>+ शस् = उद्धतश<BR>+ सातिँ = उद्धतसात्

