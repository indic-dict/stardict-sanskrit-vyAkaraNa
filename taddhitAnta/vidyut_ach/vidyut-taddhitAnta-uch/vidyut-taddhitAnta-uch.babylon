उत्सर्गतस् <BR>+ अण् = औत्सर्गतस<BR>+ अञ् = औत्सर्गतस<BR>+ अस्तातिँ = उत्सर्गतसस्तात्<BR>+ इष्ठन् = उत्सर्गतिष्ठ<BR>+ ईयसुँन् = उत्सर्गतीयस्<BR>+ क = उत्सर्गतस्क<BR>+ कन् = उत्सर्गतस्क, उत्सर्गतस्क, उत्सर्गतस्क<BR>+ कल्पप् = उत्सर्गतस्कल्प<BR>+ कुणप् = उत्सर्गतस्कुण<BR>+ खञ् = औत्सर्गतसीन<BR>+ चणप् = उत्सर्गतश्चण<BR>+ चरट् = उत्सर्गतश्चर<BR>+ चुञ्चुप् = उत्सर्गतश्चुञ्चु<BR>+ च्विँ = उत्सर्गतः<BR>+ छ = उत्सर्गतसीय<BR>+ जातीयर् = उत्सर्गतोजातीय<BR>+ जाहच् = उत्सर्गतोजाह<BR>+ ञ्यट् = औत्सर्गतस्य<BR>+ ठक् = औत्सर्गतसिक, औत्सर्गतसिक<BR>+ तमप् = उत्सर्गतस्तम<BR>+ तरप् = उत्सर्गतस्तर<BR>+ तल् = उत्सर्गतस्ता<BR>+ तसिँ = उत्सर्गतस्तस्<BR>+ त्रा = उत्सर्गतस्त्रा<BR>+ त्व = उत्सर्गतस्त्व<BR>+ थमुँ = उत्सर्गतस्थम्<BR>+ थाल् = उत्सर्गतस्था<BR>+ दघ्नच् = उत्सर्गतोदघ्न<BR>+ देश्य = उत्सर्गतोदेश्य<BR>+ देशीयर् = उत्सर्गतोदेशीय<BR>+ द्वयसच् = उत्सर्गतोद्वयस<BR>+ बहुच् = बहूत्सर्गतस्<BR>+ मतुँप् = उत्सर्गतस्वत्<BR>+ मयट् = उत्सर्गतोमय<BR>+ मात्रच् = उत्सर्गतोमात्र<BR>+ पाशप् = उत्सर्गतस्पाश<BR>+ यत् = उत्सर्गतस्य<BR>+ रूपप् = उत्सर्गतोरूप<BR>+ रूप्य = उत्सर्गतोरूप्य<BR>+ वलच् = उत्सर्गतस्वल<BR>+ विनिँ = उत्सर्गतस्विन्<BR>+ शस् = उत्सर्गतश्श, उत्सर्गतःश<BR>+ सातिँ = उत्सर्गतस्सात्, उत्सर्गतःसात्

