उप्य पुं,स्त्री,नपुंसक<BR>+ अण् = औप्य<BR>+ अञ् = औप्य<BR>+ अस्तातिँ = उप्यस्तात्<BR>+ इञ् = औप्यि<BR>+ इनिँ = उप्यिन्<BR>+ इष्ठन् = उप्यिष्ठ<BR>+ ईयसुँन् = उप्यीयस्<BR>+ क = उप्यक<BR>+ कन् = उप्यक, उप्यक, उप्यक<BR>+ कल्पप् = उप्यकल्प<BR>+ कुणप् = उप्यकुण<BR>+ खञ् = औप्यीन<BR>+ चणप् = उप्यचण<BR>+ चरट् = उप्यचर<BR>+ चुञ्चुप् = उप्यचुञ्चु<BR>+ च्विँ = उप्यी<BR>+ छ = उप्यीय<BR>+ जातीयर् = उप्यजातीय<BR>+ जाहच् = उप्यजाह<BR>+ ञ्यट् = औप्य, औप्य्य<BR>+ ठक् = औप्यिक, औप्यिक<BR>+ ठन् = उप्यिक<BR>+ तमप् = उप्यतम<BR>+ तरप् = उप्यतर<BR>+ तल् = उप्यता<BR>+ तसिँ = उप्यतस्<BR>+ त्रा = उप्यत्रा<BR>+ त्व = उप्यत्व<BR>+ थमुँ = उप्यथम्<BR>+ थाल् = उप्यथा<BR>+ दघ्नच् = उप्यदघ्न<BR>+ देश्य = उप्यदेश्य<BR>+ देशीयर् = उप्यदेशीय<BR>+ द्वयसच् = उप्यद्वयस<BR>+ बहुच् = बहूप्य<BR>+ मतुँप् = उप्यवत्<BR>+ मयट् = उप्यमय<BR>+ मात्रच् = उप्यमात्र<BR>+ पाशप् = उप्यपाश<BR>+ यत् = उप्य, उप्य्य<BR>+ रूपप् = उप्यरूप<BR>+ रूप्य = उप्यरूप्य<BR>+ वलच् = उप्यावल<BR>+ शस् = उप्यश<BR>+ सातिँ = उप्यसात्

