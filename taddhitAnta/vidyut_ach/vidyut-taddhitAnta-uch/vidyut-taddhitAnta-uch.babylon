उन्मत्तवत् <BR>+ अण् = औन्मत्तवत<BR>+ अञ् = औन्मत्तवत<BR>+ अस्तातिँ = उन्मत्तवतस्तात्<BR>+ इष्ठन् = उन्मत्तविष्ठ<BR>+ ईयसुँन् = उन्मत्तवीयस्<BR>+ क = उन्मत्तवत्क<BR>+ कन् = उन्मत्तवत्क, उन्मत्तवत्क, उन्मत्तवत्क<BR>+ कल्पप् = उन्मत्तवत्कल्प<BR>+ कुणप् = उन्मत्तवत्कुण<BR>+ खञ् = औन्मत्तवतीन<BR>+ चणप् = उन्मत्तवच्चण<BR>+ चरट् = उन्मत्तवच्चर<BR>+ चुञ्चुप् = उन्मत्तवच्चुञ्चु<BR>+ च्विँ = उन्मत्तवद्<BR>+ छ = उन्मत्तवतीय<BR>+ जातीयर् = उन्मत्तवज्जातीय<BR>+ जाहच् = उन्मत्तवज्जाह<BR>+ ञ्यट् = औन्मत्तवत्य<BR>+ ठक् = औन्मत्तवत्क, औन्मत्तवत्क<BR>+ तमप् = उन्मत्तवत्तम<BR>+ तरप् = उन्मत्तवत्तर<BR>+ तल् = उन्मत्तवत्ता<BR>+ तसिँ = उन्मत्तवत्तस्<BR>+ त्रा = उन्मत्तवत्त्रा<BR>+ त्व = उन्मत्तवत्त्व<BR>+ थमुँ = उन्मत्तवत्थम्<BR>+ थाल् = उन्मत्तवत्था<BR>+ दघ्नच् = उन्मत्तवद्दघ्न<BR>+ देश्य = उन्मत्तवद्देश्य<BR>+ देशीयर् = उन्मत्तवद्देशीय<BR>+ द्वयसच् = उन्मत्तवद्द्वयस<BR>+ बहुच् = बहून्मत्तवत्<BR>+ मतुँप् = उन्मत्तवत्वत्<BR>+ मयट् = उन्मत्तवन्मय<BR>+ मात्रच् = उन्मत्तवन्मात्र<BR>+ पाशप् = उन्मत्तवत्पाश<BR>+ यत् = उन्मत्तवत्य<BR>+ रूपप् = उन्मत्तवद्रूप<BR>+ रूप्य = उन्मत्तवद्रूप्य<BR>+ वलच् = उन्मत्तवत्वल<BR>+ शस् = उन्मत्तवच्छ, उन्मत्तवच्श<BR>+ सातिँ = उन्मत्तवत्सात्

