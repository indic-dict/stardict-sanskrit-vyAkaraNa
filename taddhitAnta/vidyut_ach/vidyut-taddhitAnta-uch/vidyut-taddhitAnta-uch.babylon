उत्तरम् <BR>+ अण् = औत्तरम<BR>+ अञ् = औत्तरम<BR>+ अस्तातिँ = उत्तरमस्तात्<BR>+ इष्ठन् = उत्तरिष्ठ<BR>+ ईयसुँन् = उत्तरीयस्<BR>+ क = उत्तरंक, उत्तरङ्क<BR>+ कन् = उत्तरंक, उत्तरङ्क, उत्तरंक, उत्तरङ्क, उत्तरंक, उत्तरङ्क<BR>+ कल्पप् = उत्तरंकल्प, उत्तरङ्कल्प<BR>+ कुणप् = उत्तरंकुण, उत्तरङ्कुण<BR>+ खञ् = औत्तरमीण<BR>+ चणप् = उत्तरंचण, उत्तरञ्चण<BR>+ चरट् = उत्तरंचर, उत्तरञ्चर<BR>+ चुञ्चुप् = उत्तरंचुञ्चु, उत्तरञ्चुञ्चु<BR>+ च्विँ = उत्तरम्<BR>+ छ = उत्तरमीय<BR>+ जातीयर् = उत्तरंजातीय, उत्तरञ्जातीय<BR>+ जाहच् = उत्तरंजाह, उत्तरञ्जाह<BR>+ ञ्यट् = औत्तरम्य<BR>+ ठक् = औत्तरमिक, औत्तरमिक<BR>+ तमप् = उत्तरंतम, उत्तरन्तम<BR>+ तरप् = उत्तरंतर, उत्तरन्तर<BR>+ तल् = उत्तरंता, उत्तरन्ता<BR>+ तसिँ = उत्तरंतस्, उत्तरन्तस्<BR>+ त्रा = उत्तरंत्रा, उत्तरन्त्रा<BR>+ त्व = उत्तरंत्व, उत्तरन्त्व<BR>+ थमुँ = उत्तरंथम्, उत्तरन्थम्<BR>+ थाल् = उत्तरंथा, उत्तरन्था<BR>+ दघ्नच् = उत्तरंदघ्न, उत्तरन्दघ्न<BR>+ देश्य = उत्तरंदेश्य, उत्तरन्देश्य<BR>+ देशीयर् = उत्तरंदेशीय, उत्तरन्देशीय<BR>+ द्वयसच् = उत्तरंद्वयस, उत्तरन्द्वयस<BR>+ बहुच् = बहूत्तरम्<BR>+ मतुँप् = उत्तरंवत्, उत्तरंवत्<BR>+ मयट् = उत्तरंमय, उत्तरम्मय<BR>+ मात्रच् = उत्तरंमात्र, उत्तरम्मात्र<BR>+ पाशप् = उत्तरंपाश, उत्तरम्पाश<BR>+ यत् = उत्तरम्य<BR>+ रूपप् = उत्तरंरूप, उत्तरंरूप<BR>+ रूप्य = उत्तरंरूप्य, उत्तरंरूप्य<BR>+ वलच् = उत्तरंवल, उत्तरंवल<BR>+ शस् = उत्तरंश<BR>+ सातिँ = उत्तरंसात्

