उत्तानपद् स्त्री<BR>+ अण् = औत्तानपद<BR>+ अञ् = औत्तानपद<BR>+ अस्तातिँ = उत्तानपदस्तात्<BR>+ इष्ठन् = उत्तानपिष्ठ<BR>+ ईयसुँन् = उत्तानपीयस्<BR>+ क = उत्तानपत्क<BR>+ कन् = उत्तानपत्क, उत्तानपत्क, उत्तानपत्क<BR>+ कल्पप् = उत्तानपत्कल्प<BR>+ कुणप् = उत्तानपत्कुण<BR>+ खञ् = औत्तानपदीन<BR>+ चणप् = उत्तानपच्चण<BR>+ चरट् = उत्तानपच्चर<BR>+ चुञ्चुप् = उत्तानपच्चुञ्चु<BR>+ च्विँ = उत्तानपद्<BR>+ छ = उत्तानपदीय<BR>+ जातीयर् = उत्तानपज्जातीय<BR>+ जाहच् = उत्तानपज्जाह<BR>+ ञ्यट् = औत्तानपद्य<BR>+ ठक् = औत्तानपदिक, औत्तानपदिक<BR>+ तमप् = उत्तानपत्तम<BR>+ तरप् = उत्तानपत्तर<BR>+ तल् = उत्तानपत्ता<BR>+ तसिँ = उत्तानपत्तस्<BR>+ त्रा = उत्तानपत्त्रा<BR>+ त्व = उत्तानपत्त्व<BR>+ थमुँ = उत्तानपत्थम्<BR>+ थाल् = उत्तानपत्था<BR>+ दघ्नच् = उत्तानपद्दघ्न<BR>+ देश्य = उत्तानपद्देश्य<BR>+ देशीयर् = उत्तानपद्देशीय<BR>+ द्वयसच् = उत्तानपद्द्वयस<BR>+ बहुच् = बहूत्तानपद्<BR>+ मतुँप् = उत्तानपद्वत्<BR>+ मयट् = उत्तानपन्मय<BR>+ मात्रच् = उत्तानपन्मात्र<BR>+ पाशप् = उत्तानपत्पाश<BR>+ यत् = उत्तानपद्य<BR>+ रूपप् = उत्तानपद्रूप<BR>+ रूप्य = उत्तानपद्रूप्य<BR>+ वलच् = उत्तानपद्वल<BR>+ शस् = उत्तानपच्छ, उत्तानपच्श<BR>+ सातिँ = उत्तानपत्सात्

