<ul><li><sup id="ref_krm_1503_01"><a href="#foot_krm_1503_01">1</a></sup> {@“ली श्लेषणे”@} <sup id="ref_krm_1503_02"><a href="#foot_krm_1503_02">2</a></sup> प्वादिः, ल्वादिश्च। </li> <li>‘यौ द्रवीकरणेऽनात्वे लीनयेत् लाययेत् लयेत्।। </li> <li>लापयेल्लालयेदात्वे श्लेषणे लीयतेऽलिनात्।’ <sup id="ref_krm_1503_03"><a href="#foot_krm_1503_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_1503_04"><a href="#foot_krm_1503_04">4</a></sup> <sup id="ref_krm_1503_05"><a href="#foot_krm_1503_05">5</a></sup> लायकः-यिका, <sup id="ref_krm_1503_06"><a href="#foot_krm_1503_06">6</a></sup> लालकः-लिका, <sup id="ref_krm_1503_07"><a href="#foot_krm_1503_07">7</a></sup> लीनकः-निका, निलापकः-पिका, <sup id="ref_krm_1503_08"><a href="#foot_krm_1503_08">8</a></sup> लिलीषकः- षिका, <sup id="ref_krm_1503_09"><a href="#foot_krm_1503_09">9</a></sup> लेलीयकः-यिका;</li> <li>  <sup id="ref_krm_1503_10"><a href="#foot_krm_1503_10">10</a></sup> लेता-लेत्री, लाता-त्री, लापयिता-लालयिता-त्री, लीनयिता-त्री, लिलीषिता-त्री, लेलीयिता-त्री;</li> <li>  <sup id="ref_krm_1503_11"><a href="#foot_krm_1503_11">11</a></sup> लिनन्-ती, लापयन्, लालयन्, लीनयन्-न्ती, लिलीषन्-न्ती;</li> <li>  -- लास्यन्-लेस्यन्-न्ती-ती, लापयिष्यन्-लालयन्-लीनयन्-न्ती-ती, लिलीषिष्यन्-न्ती-न्ती;</li> <li>  -- -- लापयमानः-लालयमानः-लीनयमानः, -- लेलीयमानः;</li> <li>  -- <sup id="ref_krm_1503_12"><a href="#foot_krm_1503_12">12</a></sup> जटाभिर्लापयमानः, वर्त्तिकामुल्लापयमानः, बालमुल्लापयमानः;</li> <li>  -- लापयिष्यमाणः-लालयिष्यमाणः-लीनयिष्यमाणः, --लेलीयिष्यमाणः;</li> <li>  लीः-लियौ-लियः;</li> <li>  -- -- -- <sup id="ref_krm_1503_13"><a href="#foot_krm_1503_13">13</a></sup> लीनम्-नः-नवान्, लापितः-लालितः-लीनितः, लिलीषितः, लेलीतः-तवान्;</li> <li>  <sup id="ref_krm_1503_14"><a href="#foot_krm_1503_14">14</a></sup> <sup id="ref_krm_1503_15"><a href="#foot_krm_1503_15">15</a></sup> लयः, लापः-लालः-लीनः, लिलीषुः, लिलापयिषुः, लेल्यः-लेलियः;</li> <li>  लेतव्यम्-लातव्यम्, लापयितव्यम्-लालयितव्यम्-लीनयितव्यम्, लिलीषितव्यम्, लेलीयितव्यम्;</li> <li>  लयनीयम्-लानीयम्, लापनीयम्-लालनीयम्-लीननीयम्, लिलीषणीयम्, लेलीयनीयम्;</li> <li>  <sup id="ref_krm_1503_16"><a href="#foot_krm_1503_16">16</a></sup> ईषल्लयः-दुर्लयः-सुलयः;</li> <li>  -- -- -- लीयमानः, लाप्यमानः-लाल्यमानः-लीन्यमानः, लिलीष्यमाणः, लेलीय्यमानः;</li> <li>  लयः, लापः-लालः-लीनः, लिलीषः, लेलीयः;</li> <li>  लातुम्-लेतुम्, लापयितुम्-लालयितुम्-लीनयितुम्, लेलीयितुम्;</li> <li>  <sup id="ref_krm_1503_17"><a href="#foot_krm_1503_17">17</a></sup> लीनिः, लापना-लालना-लीनना, लिलीषा, लेलीया;</li> <li>  लयनम्, लानम्, लापनम्-लालनम्-लीननम्, लिलीषणम्, लेलीयनम्;</li> <li>  लीत्वा, लालयित्वा-लापयित्वा-लीनयित्वा, लिलीषित्वा, लेलीयित्वा;</li> <li>  <sup id="ref_krm_1503_18"><a href="#foot_krm_1503_18">18</a></sup> विलाय-विलीय, विलाप्य-विलाल्य-विलीन्य, विलिलीष्य, विलेलीय;</li> <li>  लायम् २ लीत्वा २, लापम् २ -लालम् २ -लीनम् २, <sup id="ref_krm_1503_19"><a href="#foot_krm_1503_19">19</a></sup> जतुविलायं विलिल्ये, लापयित्वा २ -लालयित्वा २ -लीनयित्वा २, लिलीषम् २, लिलीषित्वा २, लेलीयम् २;</li> <li>  लेलीयित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1503_01"><a href="#ref_krm_1503_01">↑</a> (१४९२)</li> <li id="foot_krm_1503_02"><a href="#ref_krm_1503_02">↑</a> (९-क्र्यादिः-१५०१। अक। अनि। पर।)</li> <li id="foot_krm_1503_03"><a href="#ref_krm_1503_03">↑</a> (श्लो। १७-१८)</li> <li id="foot_krm_1503_04"><a href="#ref_krm_1503_04">↑</a> [पृष्ठम्११६५+ २६]</li> <li id="foot_krm_1503_05"><a href="#ref_krm_1503_05">↑</a> [[१। ण्वुलि, ‘विभाषा लीयतेः’ (६-१-५१) इत्याकारविकल्पः--एज्विषये। आत्वपक्षे ‘आतो युक्--’ (७-३-३३) इति युगागमे रूपमेवम्। आत्वाभावपक्षे वृद्धौ आया- देशे च लायकः इत्येव रूपमिति ज्ञेयम्। एवमुत्तरत्रापि।]]</li> <li id="foot_krm_1503_06"><a href="#ref_krm_1503_06">↑</a> [[२। ‘लीलोर्लुग्नुकावन्यतरस्यां स्नेहविपातने’ (७-३-३९) इति ण्यन्ते लुगागम- विकल्पः--स्नेहविपातने। स्नेहविपातनं नाम कठिनद्रव्यस्याग्नौ निष्टपनेन द्रबी- करणम्। एतद्भिन्नार्थे तु ‘विभाषा लीयतेः’ (६-१-५१) इत्यात्वे ‘अर्तिह्री--’ (७-३-३६) इति पुगागमे लापकः इत्यादीनि रूपाणि।]]</li> <li id="foot_krm_1503_07"><a href="#ref_krm_1503_07">↑</a> [[३। अनेनैव सूत्रेण (७-३-३९) पाक्षिके नुगागमे लीनकः इत्यादीनि रूपाणि।]]</li> <li id="foot_krm_1503_08"><a href="#ref_krm_1503_08">↑</a> [[४। सन्नन्ते ‘इको झल्’ (१-२-९) इति सनः कित्त्वं सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_1503_09"><a href="#ref_krm_1503_09">↑</a> [[५। यङन्ते ‘गुणो यङ्लुकोः’ (७-४-८२) इति गुणोऽभ्यासस्य।]]</li> <li id="foot_krm_1503_10"><a href="#ref_krm_1503_10">↑</a> [[६। धातोरनिट्त्वात् इडागमो न। गुणः। एवं तव्यदादिष्वपि ज्ञेयम्।]]</li> <li id="foot_krm_1503_11"><a href="#ref_krm_1503_11">↑</a> [[७। शतरि ‘क्र्यादिभ्यः--’ (३-१-८१) इति श्ना विकरणप्रत्ययः। ‘प्वादीनां ह्रस्वः’ (७-३-८०) इति धातोरीकारस्य ह्रस्वः। ‘श्नाऽऽभ्यस्तयोः--’ (६-४-११२) इत्याकारलोपः।]]</li> <li id="foot_krm_1503_12"><a href="#ref_krm_1503_12">↑</a> [[८। ‘लियः सम्माननशालीनीकरणयोश्च’ (१-३-७०) इति ण्यन्तात् अकर्त्रभिप्रायेऽपि आत्मनेपदमेव। सम्माननम् = पूजा। शालीनीकरणम् = न्यग्भावनम्। जटाभिः आलापयमानः = जटया हेतुना पूजां समधिगच्छन् इत्यर्थः। वर्तिकामुल्ला- पयमानः = पक्षिविशेषं न्यक्कृत्येत्यर्थः। एतयोरुभयोरेवार्थयोस्तङ्। बालकमुल्ला- पयमानः, वञ्चयन्नित्यर्थः प्रलम्भनार्थेऽपीति वार्त्तिकात् (३४८३)।]]</li> <li id="foot_krm_1503_13"><a href="#ref_krm_1503_13">↑</a> [[९। ‘ल्वादिभ्यः--’ (८-२-४४) इति निष्ठातकारस्य नकारः।]]</li> <li id="foot_krm_1503_14"><a href="#ref_krm_1503_14">↑</a> [पृष्ठम्११६६+ १९]</li> <li id="foot_krm_1503_15"><a href="#ref_krm_1503_15">↑</a> [[१। पचाद्यचि रूपमेवम्। ‘निमिमीलियां खलचोरात्वं न’ (वा। ६-१-५१) इत्यत्र ‘अच्’ इत्यनेन पचाद्यचोऽपि ग्रहणमिति पदमञ्जरी।]]</li> <li id="foot_krm_1503_16"><a href="#ref_krm_1503_16">↑</a> [[२। अत्रापि खल्प्रत्यये आत्वं न।]]</li> <li id="foot_krm_1503_17"><a href="#ref_krm_1503_17">↑</a> [[३। ‘ऋल्वादिभ्यः --’ (वा। ३-३-९४) इति क्तिनस्तकारस्य नकारः।]]</li> <li id="foot_krm_1503_18"><a href="#ref_krm_1503_18">↑</a> [[४। ‘विभाषा लीयतेः’ (६-१-५१) इति ल्यपि आत्वविकल्पः। आत्वपक्षे विलाय इति, आत्वाभावपक्षे विलीय इति च रूपद्वयम्।]]</li> <li id="foot_krm_1503_19"><a href="#ref_krm_1503_19">↑</a> [[५। ‘उपमाने कर्मणि च’ (३-४-४५) इति णमुल्। ‘कषादिषु--’ (३-४-४६) इति यथाविध्यनुप्रयोगः।]]</li></ul></p>

ली|लायकः-यिका|लिलाययिषकः-षिका|लिलीषकः-षिका|लेलीयकः-यिका|लाययिता-त्री|लिलाययिषिता-त्री|लेता-त्री|लिलीषिता-त्री|लेलीयिता-त्री|ण्यन्ते-तत्प्रकृतिकसन्नन्ते|च|इमानि|रूपाणि-लाययन्-न्ती|लिलाययिषन्-न्ती|लाययिष्यन्-न्ती-ती-लिलाययिषिष्यन्-|न्ती-ती|लायमानः|लिलाययिषमाणः|लाययिष्यमाणः|लिलाययिषिष्यमाणः|लाः-लायौ-लायः|-|लायितम्-तः|लिलाययिषितम्-तः-तवान्|लायः|लिलाययिषुः|लाययितव्यम्|लिलाययिषितव्यम्|लायनीयम्|लिलाययिषणीयम्|लाय्यम्|लिलाययिष्यम्|ईषल्लायः-दुर्लायः-सुलायः|लाय्यमानः|लिलाययिष्यमाणः|लिलाययिषः|लाययितुम्|लिलाययिषितुम्|लायना|लिलाययिषा|लायनम्|लिलाययिषणम्|लाययित्वा|लिलाययिषित्वा|प्रलाय्य|प्रलिलाययिष्य|लायम्-लाययित्वा
<ul><li><sup id="ref_krm_1504_01"><a href="#foot_krm_1504_01">1</a></sup> {@“ली द्रवीकरणे”@} <sup id="ref_krm_1504_02"><a href="#foot_krm_1504_02">2</a></sup> आधृषीयः। </li> <li>तेन णिज्विकल्पः। </li> <li>‘यौ द्रवीकरणेऽनात्वे लीनयेल्लाययेल्लयेत्।। </li> <li><sup id="ref_krm_1504_03"><a href="#foot_krm_1504_03">3</a></sup> लापयेत् लालयेदात्वे श्लेषणे लीयतेऽलिनात्।’ <sup id="ref_krm_1504_04"><a href="#foot_krm_1504_04">4</a></sup> इति देवः। </li> <li>लायकः-यिका, लिलाययिषकः-षिका, लायकः-यिका, लिलीषकः-षिका, लेलीयकः-यिका;</li> <li>  लाययिता-त्री, लिलाययिषिता-त्री, लेता-त्री, लिलीषिता-त्री, लेलीयिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाणि ण्यन्तरूपाणि, ण्यन्तप्रकृतिकसन्नन्तरूपाणि च विना क्रैयादिकप्लिनातिवत् <sup id="ref_krm_1504_05"><a href="#foot_krm_1504_05">5</a></sup> ऊह्यानि। </li> <li>ण्यन्ते-तत्प्रकृतिकसन्नन्ते च इमानि रूपाणि--लाययन्-न्ती, लिलाययिषन्-न्ती;</li> <li>  लाययिष्यन्-न्ती-ती-लिलाययिषिष्यन्- न्ती-ती;</li> <li>  लायमानः, लिलाययिषमाणः, लाययिष्यमाणः, लिलाययिषिष्यमाणः;</li> <li>  लाः-लायौ-लायः;</li> <li>  -- -- -- लायितम्-तः, लिलाययिषितम्-तः-तवान्;</li> <li>  लायः, लिलाययिषुः;</li> <li>  लाययितव्यम्, लिलाययिषितव्यम्;</li> <li>  लायनीयम्, लिलाययिषणीयम्;</li> <li>  लाय्यम्, लिलाययिष्यम्;</li> <li>  ईषल्लायः-दुर्लायः-सुलायः;</li> <li>  लाय्यमानः, लिलाययिष्यमाणः;</li> <li>  लायः, लिलाययिषः;</li> <li>  लाययितुम्, लिलाययिषितुम्;</li> <li>  लायना, लिलाययिषा;</li> <li>  लायनम्, लिलाययिषणम्;</li> <li>  लाययित्वा, लिलाययिषित्वा;</li> <li>  प्रलाय्य, प्रलिलाययिष्य;</li> <li>  लायम् २ -लाययित्वा २;</li> <li>  लिलाययिषम् २-लिलाययिषित्वा २। इति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1504_01"><a href="#ref_krm_1504_01">↑</a> (१४९३)</li> <li id="foot_krm_1504_02"><a href="#ref_krm_1504_02">↑</a> (१०-चुरादिः-१८१२। सक। अनि। उभ।)</li> <li id="foot_krm_1504_03"><a href="#ref_krm_1504_03">↑</a> [पृष्ठम्११६७+ २६]</li> <li id="foot_krm_1504_04"><a href="#ref_krm_1504_04">↑</a> (श्लो १७-१८)</li> <li id="foot_krm_1504_05"><a href="#ref_krm_1504_05">↑</a> (१०८१)</li></ul></p>

लीङ्|लायकः-यिका|लालकः-लीनकः-निका|लापकः-पिका|लिलीषकः-षिका|लेलीयकः-यिका|लेता-त्री|लालयिता-लीनयिता-लापयिता-त्री|लिलीषिता-त्री|लेलीयिता-त्री
<ul><li><sup id="ref_krm_1505_01"><a href="#foot_krm_1505_01">1</a></sup> {@“लीङ् श्लेषणे”@} <sup id="ref_krm_1505_02"><a href="#foot_krm_1505_02">2</a></sup> ‘लापयेल्लालयेदात्वे श्लेषणे लीयतेऽलिनात्।’ <sup id="ref_krm_1505_03"><a href="#foot_krm_1505_03">3</a></sup> इति देवः। </li> <li>लायकः-यिका, लालकः-लीनकः-निका, लापकः-पिका, लिलीषकः-षिका, लेलीयकः-यिका;</li> <li>  लेता-त्री, लालयिता-लीनयिता-लापयिता-त्री, लिलीषिता-त्री, लेलीयिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाणि क्रैयादिकलिनातिवत् <sup id="ref_krm_1505_04"><a href="#foot_krm_1505_04">4</a></sup> ज्ञेयानि। </li> <li>खल्प्रत्यये-ईषद्विलयः-दुर्विलयः-सुविलयः इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1505_01"><a href="#ref_krm_1505_01">↑</a> (१४९४)</li> <li id="foot_krm_1505_02"><a href="#ref_krm_1505_02">↑</a> (४-दिवादिः-११३९। अक। अनि। आत्म।)</li> <li id="foot_krm_1505_03"><a href="#ref_krm_1505_03">↑</a> (श्लो। १८)</li> <li id="foot_krm_1505_04"><a href="#ref_krm_1505_04">↑</a> (१४९२)</li></ul></p>

लुजि|लुञ्जकः-ञ्जिका|लुलुञ्जयिषकः-षिका|लुलुञ्जिषक|षिका|लोलुञ्जकः-ञ्जिका|लुञ्जयिता-त्री|लुलुञ्जयिषिता-त्री|लुञ्जिता-त्री|लुलुञ्जिषिता-त्री|लोलुञ्जिता-त्री
<ul><li><sup id="ref_krm_1506_01"><a href="#foot_krm_1506_01">1</a></sup> {@“लुजि हिंसाबलादाननिकेतनेषु”@} <sup id="ref_krm_1506_02"><a href="#foot_krm_1506_02">2</a></sup> क्षीरस्वामिनैव ‘लुजि’ इति पठ्यते। </li> <li>अन्ये सर्वेऽपि मतान्तरत्वेनैव पठन्ति अयं पाठः मा। </li> <li>धा। </li> <li>वृत्तौ नाऽदृतः। </li> <li>मैत्रेयादिभिरपि न पठ्यते। </li> <li>लुञ्जकः-ञ्जिका, लुलुञ्जयिषकः-षिका, लुञ्जकः-ञ्जिका, लुलुञ्जिषक;</li> <li>  षिका, <sup id="ref_krm_1506_03"><a href="#foot_krm_1506_03">3</a></sup> लोलुञ्जकः-ञ्जिका;</li> <li>  लुञ्जयिता-त्री, लुलुञ्जयिषिता-त्री, लुञ्जिता-त्री, लुलुञ्जिषिता-त्री, लोलुञ्जिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि चौरादिकचिन्तयतिवत् <sup id="ref_krm_1506_04"><a href="#foot_krm_1506_04">4</a></sup> बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1506_01"><a href="#ref_krm_1506_01">↑</a> (१४९५)</li> <li id="foot_krm_1506_02"><a href="#ref_krm_1506_02">↑</a> (१०-चुरादिः-१५६७। सक। सेट्। उभ।)</li> <li id="foot_krm_1506_03"><a href="#ref_krm_1506_03">↑</a> [पृष्ठम्११६८+ २६]</li> <li id="foot_krm_1506_04"><a href="#ref_krm_1506_04">↑</a> (५२३)</li></ul></p>

लुजि|लुञ्जकः-ञ्जिका|लुलुञ्जयिषकः-षिका|लुलुञ्जिषकः-षिका|लोलुञ्जकः-ञ्जिका|लुञ्जयिता-त्री|लुलुञ्जयिषिता-त्री|लुञ्जिता-त्री|लुलुञ्जिषिता-त्री|लोलुञ्जिता-त्री
<ul><li><sup id="ref_krm_1507_01"><a href="#foot_krm_1507_01">1</a></sup> {@“लुजि भाषार्थः”@} <sup id="ref_krm_1507_02"><a href="#foot_krm_1507_02">2</a></sup> आस्वदीयः। </li> <li>अर्थभेदार्थं पुनः पाठः। </li> <li>अन्यत् प्रयोजनं नेति ज्ञायते। </li> <li>धातुकाव्ये अयं न दृश्यते। </li> <li>लुञ्जकः-ञ्जिका, लुलुञ्जयिषकः-षिका, लुञ्जकः-ञ्जिका, लुलुञ्जिषकः-षिका, लोलुञ्जकः-ञ्जिका;</li> <li>  लुञ्जयिता-त्री, लुलुञ्जयिषिता-त्री, लुञ्जिता-त्री, लुलुञ्जिषिता-त्री, लोलुञ्जिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि चौरादिकचिन्तयतिवत् <sup id="ref_krm_1507_03"><a href="#foot_krm_1507_03">3</a></sup> ऊह्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1507_01"><a href="#ref_krm_1507_01">↑</a> (१४९६)</li> <li id="foot_krm_1507_02"><a href="#ref_krm_1507_02">↑</a> (१०-चुरादिः-१५७९। अक। सेट्। उभ।)</li> <li id="foot_krm_1507_03"><a href="#ref_krm_1507_03">↑</a> (५२३)</li></ul></p>

लुट|लोटकः-टिका|लुलुटिषकः-लुलोटिषकः-षिका|लोलुटकः-टिका|लुटिता-त्री|लोटयिता-त्री|लुलुटिषिता-लुलोटिषिता-त्री|लोलुटिता-त्री
<ul><li><sup id="ref_krm_1508_01"><a href="#foot_krm_1508_01">1</a></sup> {@“लुट विलोटने”@} <sup id="ref_krm_1508_02"><a href="#foot_krm_1508_02">2</a></sup> ‘णौ लोटयति भाषार्थे लुट्येल्लोटति लोटने।।’ लोटते प्रतिघातेऽर्थे स्तेये लुण्टति लुण्टयेत्।’ <sup id="ref_krm_1508_03"><a href="#foot_krm_1508_03">3</a></sup> इति देवः। </li> <li>लोटकः-टिका, लोटकः-टिका, लुलुटिषकः-लुलोटिषकः-षिका, लोलुटकः-टिका;</li> <li>  लुटिता-त्री, लोटयिता-त्री, लुलुटिषिता-लुलोटिषिता-त्री, लोलुटिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककुकतिवत् <sup id="ref_krm_1508_04"><a href="#foot_krm_1508_04">4</a></sup> ऊह्यानि। </li> <li>“लुड-- इति टवर्गतृतीयान्तः इति कौशिककाश्यपनन्दिद्रमिडाः” इति मा। </li> <li>धा। </li> <li>वृत्तौ। </li> <li>‘-- विलोडने’ इति दुर्गः। </li> <li>‘लुट--’ इत्यत्र ‘लुल-- इति अन्ये’ इति धा। </li> <li>का। </li> <li>व्याख्याने <sup id="ref_krm_1508_05"><a href="#foot_krm_1508_05">5</a></sup>। </li> <li>“भूवादिसूत्रे <sup id="ref_krm_1508_06"><a href="#foot_krm_1508_06">6</a></sup> सुधाकरः- ‘लुल--’ इति लान्तोऽपि दृश्यते, ‘आश्लिष्टभूमिं रसितारमुच्चैर्लोलद्- भुजाकारबृहत्तरङ्गम्’ शि। </li> <li>व। </li> <li><sup id="ref_krm_1508_07"><a href="#foot_krm_1508_07">7</a></sup> इति। </li> <li>डलयोरेकत्वस्मरणमिति वा प्रतिविधेयम्” इति मा। </li> <li>धा। </li> <li>वृत्तौ। </li> <li>इत्युक्तमत्र स्मरणीयम्। </li> <li><sup id="ref_krm_1508_08"><a href="#foot_krm_1508_08">8</a></sup> लोलमानः <sup id="ref_krm_1508_09"><a href="#foot_krm_1508_09">9</a></sup>। </li> <li><sup id="ref_krm_1508_10"><a href="#foot_krm_1508_10">10</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1508_01"><a href="#ref_krm_1508_01">↑</a> (१४९७)</li> <li id="foot_krm_1508_02"><a href="#ref_krm_1508_02">↑</a> (१-भ्वादिः। ३१४। सक। सेट्। पर।)</li> <li id="foot_krm_1508_03"><a href="#ref_krm_1508_03">↑</a> (श्लो। ७३-७४)</li> <li id="foot_krm_1508_04"><a href="#ref_krm_1508_04">↑</a> (१९७)</li> <li id="foot_krm_1508_05"><a href="#ref_krm_1508_05">↑</a> (२-१)</li> <li id="foot_krm_1508_06"><a href="#ref_krm_1508_06">↑</a> (१-३-१)</li> <li id="foot_krm_1508_07"><a href="#ref_krm_1508_07">↑</a> (३-७२)</li> <li id="foot_krm_1508_08"><a href="#ref_krm_1508_08">↑</a> [[१। ‘ताच्छील्यवयोवचनशक्तिषु चानश्’ (३-२-२९) इति ताच्छील्ये चानश्प्रत्यये रूपमेवम्।]]</li> <li id="foot_krm_1508_09"><a href="#ref_krm_1508_09">↑</a> [[आ। ‘आमृशद्भिरभितो वलिवीचीर्लोलमानवितताङ्गुलिहस्तैः।’ शि। व। १०-५९।]]</li> <li id="foot_krm_1508_10"><a href="#ref_krm_1508_10">↑</a> [पृष्ठम्११६९+ २५]</li></ul></p>

लुट|लोटकः-टिका|लुलुटिषकः-लुलोटिषकः-षिका|लोलुटकः-टिका|लुटिता-त्री|लोटयिता-त्री|लुलुटिषिता-लुलोटिषिता-त्री|लोलुटिता-त्री
<ul><li><sup id="ref_krm_1509_01"><a href="#foot_krm_1509_01">1</a></sup> {@“लुट प्रतीघाते”@} <sup id="ref_krm_1509_02"><a href="#foot_krm_1509_02">2</a></sup> ‘लोटते प्रतिघातेऽर्थे स्तेये लुण्टति लुण्टयेत्।’ <sup id="ref_krm_1509_03"><a href="#foot_krm_1509_03">3</a></sup> इति देवः। </li> <li>अयं पाठो देवमैत्रेयादीनाम्। </li> <li>क्षीरस्वामी तु द्वितीयान्तं पठित्वा ‘लुट’ इत्येके, इति वदति। </li> <li>लोटकः-टिका, लोटकः-टिका, लुलुटिषकः-लुलोटिषकः-षिका, लोलुटकः-टिका;</li> <li>  लुटिता-त्री, लोटयिता-त्री, लुलुटिषिता-लुलोटिषिता-त्री, लोलुटिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि भौवादिककुकतिवत् <sup id="ref_krm_1509_04"><a href="#foot_krm_1509_04">4</a></sup> ऊह्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1509_01"><a href="#ref_krm_1509_01">↑</a> (१४९८)</li> <li id="foot_krm_1509_02"><a href="#ref_krm_1509_02">↑</a> (१-भ्वादिः-७४९। सक। सेट्। आत्म।)</li> <li id="foot_krm_1509_03"><a href="#ref_krm_1509_03">↑</a> (श्लो। ७४)</li> <li id="foot_krm_1509_04"><a href="#ref_krm_1509_04">↑</a> (१९७)</li></ul></p>

लुट|लोटकः-टिका|लुलुटिषकः-लुलोटिषकः-षिका|लोलुटकः-टिका|लोटिता-त्री|लोटयिता-त्री|लुलुटिषिता-लुलोटिषिता-त्री|लोलुटिता-त्री
<ul><li><sup id="ref_krm_1510_01"><a href="#foot_krm_1510_01">1</a></sup> {@“लुट विलोडने”@} <sup id="ref_krm_1510_02"><a href="#foot_krm_1510_02">2</a></sup> ‘-- विलोटने’ इति क्षीरस्वामी। </li> <li>‘लुठ--’ इति द्वितीयान्तः पठितः सि। </li> <li>कौमुद्याम्। </li> <li>धातुकाव्येऽपि <sup id="ref_krm_1510_03"><a href="#foot_krm_1510_03">3</a></sup> एवमेव। </li> <li>शतरि-लुठ्यन् इति अस्य प्रयोगोऽपि दृश्यते। </li> <li>‘णौ लोटयति भाषार्थे, लुट्येल्लोटति लोटने।।’ <sup id="ref_krm_1510_04"><a href="#foot_krm_1510_04">4</a></sup> इति देवः। </li> <li>लोटकः-टिका, लोटकः-टिका, लुलुटिषकः-लुलोटिषकः-षिका, लोलुटकः-टिका;</li> <li>  लोटिता-त्री, लोटयिता-त्री, लुलुटिषिता-लुलोटिषिता-त्री, लोलुटिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि दैवादिकगुध्यतिवत् <sup id="ref_krm_1510_05"><a href="#foot_krm_1510_05">5</a></sup> ऊह्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1510_01"><a href="#ref_krm_1510_01">↑</a> (१४९९)</li> <li id="foot_krm_1510_02"><a href="#ref_krm_1510_02">↑</a> (४-दिवादिः-१२२२। सक। सेट्। पर।)</li> <li id="foot_krm_1510_03"><a href="#ref_krm_1510_03">↑</a> (२-६६)</li> <li id="foot_krm_1510_04"><a href="#ref_krm_1510_04">↑</a> (श्लो। ७३)</li> <li id="foot_krm_1510_05"><a href="#ref_krm_1510_05">↑</a> (४०५)</li></ul></p>

लुट|लोटकः-टिका|लुलुटिषकः-षिका|लोलुटकः-टिका|लुटिता-त्री|लोटयिता-त्री|लुलुटिषिता-त्री|लोलुटिता-त्री
<ul><li><sup id="ref_krm_1511_01"><a href="#foot_krm_1511_01">1</a></sup> {@“लुट संश्लेषणे”@} <sup id="ref_krm_1511_02"><a href="#foot_krm_1511_02">2</a></sup> कुटादिः। </li> <li>‘लुठ--’ इति धा। </li> <li>का। </li> <li>व्याख्याने <sup id="ref_krm_1511_03"><a href="#foot_krm_1511_03">3</a></sup>, ‘लुड इत्येके’ इति च तत्रोपात्तम्। </li> <li>क्षीरतरङ्गिण्यां धातुरयं न पठितः। </li> <li>अपि तु ‘पुट संश्लेषणे’ इत्यत्र ‘लुट विलोडने इति दुर्गः’ इत्युपात्तम्। </li> <li>तत्र टिप्पन्यां “कातन्त्र- धातुपाठे ‘लुट संश्लेषणे’ इति पाठः, काशकृत्स्ने लुठ--” इत्येवं दृश्यते। </li> <li>‘णौ लोटयति भाषार्थे लुट्येत् लोटति लोटने।।’ <sup id="ref_krm_1511_04"><a href="#foot_krm_1511_04">4</a></sup> इति देवः। </li> <li>लोटकः-टिका, लोटकः-टिका, लुलुटिषकः-षिका, लोलुटकः-टिका;</li> <li>  लुटिता-त्री, लोटयिता-त्री, लुलुटिषिता-त्री, लोलुटिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि तौदादिककुटतिवत् <sup id="ref_krm_1511_05"><a href="#foot_krm_1511_05">5</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_1511_06"><a href="#foot_krm_1511_06">6</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1511_01"><a href="#ref_krm_1511_01">↑</a> (१५००)</li> <li id="foot_krm_1511_02"><a href="#ref_krm_1511_02">↑</a> (६-तुदादिः-१३८१। सक। सेट्। पर।)</li> <li id="foot_krm_1511_03"><a href="#ref_krm_1511_03">↑</a> (२-८१)</li> <li id="foot_krm_1511_04"><a href="#ref_krm_1511_04">↑</a> (श्लो। ७३)</li> <li id="foot_krm_1511_05"><a href="#ref_krm_1511_05">↑</a> (२०४)</li> <li id="foot_krm_1511_06"><a href="#ref_krm_1511_06">↑</a> [पृष्ठम्११७०+ २६]</li></ul></p>

लुट|लोटकः-टिका|लुलोटयिषकः-षिका|लोटयिता-त्री|लुलोटयिषिता-त्री
<ul><li><sup id="ref_krm_1512_01"><a href="#foot_krm_1512_01">1</a></sup> {@“लुट भाषार्थः”@} <sup id="ref_krm_1512_02"><a href="#foot_krm_1512_02">2</a></sup> आस्वदीयः। </li> <li>‘णौ लोटयति भाषार्थे लुट्येल्लोटति लोटने।।’ <sup id="ref_krm_1512_03"><a href="#foot_krm_1512_03">3</a></sup> इति देवः। </li> <li>लोटकः-टिका, लुलोटयिषकः-षिका;</li> <li>  लोटयिता-त्री, लुलोटयिषिता-त्री;</li> <li>  इत्यादिकानि रूपाणि सर्वाण्यपि चौरादिककोटयतिवत् <sup id="ref_krm_1512_04"><a href="#foot_krm_1512_04">4</a></sup> बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1512_01"><a href="#ref_krm_1512_01">↑</a> (१५०१)</li> <li id="foot_krm_1512_02"><a href="#ref_krm_1512_02">↑</a> (१०-चुरादिः-१७५५। सक। सेट्। उभ।)</li> <li id="foot_krm_1512_03"><a href="#ref_krm_1512_03">↑</a> (श्लो। ७३)</li> <li id="foot_krm_1512_04"><a href="#ref_krm_1512_04">↑</a> (२०५)</li></ul></p>

लुटि|लुण्टकः-ण्टिका|लुलुण्टिषकः-षिका|लोलुण्टकः-ण्टिका|लुण्टिता-त्री|लुण्टयिता-त्री|लुलुण्टिषिता-त्री|लोलुण्टिता-त्री
<ul><li><sup id="ref_krm_1513_01"><a href="#foot_krm_1513_01">1</a></sup> {@“लुटि स्तेये”@} <sup id="ref_krm_1513_02"><a href="#foot_krm_1513_02">2</a></sup> ‘लोटते प्रतिघातेऽर्थे स्तेये लुण्टति लुण्टयेत्।’ <sup id="ref_krm_1513_03"><a href="#foot_krm_1513_03">3</a></sup> इति देवः। </li> <li>‘लुठि--’ इत्येके इति तरङ्गिण्याम्। </li> <li>किन्तु पुरुषकारे, ‘लुण्ठेति क्षीरस्वामी’ इति उद्धृतम्। </li> <li>शाकटायनस्तु तृतीयान्तं <sup id="ref_krm_1513_04"><a href="#foot_krm_1513_04">4</a></sup> पपाठ। </li> <li>इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>धातुकाव्येऽपि <sup id="ref_krm_1513_05"><a href="#foot_krm_1513_05">5</a></sup> एवमेव। </li> <li>लुण्टकः-ण्टिका, लुण्टकः-ण्टिका, लुलुण्टिषकः-षिका, लोलुण्टकः-ण्टिका;</li> <li>  लुण्टिता-त्री, लुण्टयिता-त्री, लुलुण्टिषिता-त्री, लोलुण्टिता-त्री;</li> <li>  इत्यादिकानि रूपाणि सर्वाण्यपि भौवादिककुण्टतिवत् <sup id="ref_krm_1513_06"><a href="#foot_krm_1513_06">6</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1513_07"><a href="#foot_krm_1513_07">7</a></sup> लुण्टाकः <sup id="ref_krm_1513_08"><a href="#foot_krm_1513_08">8</a></sup> -लुण्टाकी।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1513_01"><a href="#ref_krm_1513_01">↑</a> (१५०२)</li> <li id="foot_krm_1513_02"><a href="#ref_krm_1513_02">↑</a> (१-भ्वादिः-३२८। सक। सेट्। पर।)</li> <li id="foot_krm_1513_03"><a href="#ref_krm_1513_03">↑</a> (श्लो। ७४)</li> <li id="foot_krm_1513_04"><a href="#ref_krm_1513_04">↑</a> (लुडि)</li> <li id="foot_krm_1513_05"><a href="#ref_krm_1513_05">↑</a> (२-६६)</li> <li id="foot_krm_1513_06"><a href="#ref_krm_1513_06">↑</a> (२०९)</li> <li id="foot_krm_1513_07"><a href="#ref_krm_1513_07">↑</a> [[१। तच्छीलादिषु कर्तृषु ‘जल्पभिक्षकुट्टलुण्ट--’ (३-२-१५५) इति षाकन्प्रत्यये रूपमेवम्। षित्त्वात् स्त्रियां ङीष्प्रत्यये लुण्टाकी इति।]]</li> <li id="foot_krm_1513_08"><a href="#ref_krm_1513_08">↑</a> [[आ। क्षीरतरङ्गिण्याम् (भ्वादौ) उद्धृतत्वात् अत्र उपात्तम्। ‘जल्पभिक्षकुट्टलुण्ट--’ (३-२-१५५) इत्यत्र न्यासपदमञ्जर्योः ‘लुण्ट स्तेये चौरादिकः’ इत्युक्तत्वात् अत्र पाठः न समीचीनः इति ज्ञायते।]]</li></ul></p>

लुठ|लोठकः-ठिका|लुलुठिषकः-लुलोठिषकः-षिका|लोलुठकः-ठिका|लोठिता-त्री|लोठयिता-त्री|लुलुठिषिता-लुलोठिषिता-त्री|लोलुठिता-त्री
<ul><li><sup id="ref_krm_1514_01"><a href="#foot_krm_1514_01">1</a></sup> {@“लुठ उपघाते”@} <sup id="ref_krm_1514_02"><a href="#foot_krm_1514_02">2</a></sup> ‘श्लेषालस्योपघातेषु प्रतिघाते क्रमाल्लुठेत्। </li> <li>लुण्ठेत्, लोठति लोठेत किन्तु गत्यां च लुण्ठति।।’ <sup id="ref_krm_1514_03"><a href="#foot_krm_1514_03">3</a></sup> इति देवः। </li> <li>“अत्र मैत्रेयः ‘उठेत्यप्येके’ इति। </li> <li><sup id="ref_krm_1514_04"><a href="#foot_krm_1514_04">4</a></sup> धनपाल- शाकटायनौ रुठ लुठेत्येव पेठतुः। </li> <li>क्षीरस्वामी तु उठिं पठित्वा ‘रुठ लुठ इत्यपि दौर्गाः’ इत्याह” इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>लोठकः-ठिका, लोठकः-ठिका, लुलुठिषकः-लुलोठिषकः-षिका, लोलुठकः-ठिका;</li> <li>  लोठिता-त्री, लोठयिता-त्री, लुलुठिषिता-लुलोठिषिता-त्री, लोलुठिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि भौवादिककुकतिवत् <sup id="ref_krm_1514_05"><a href="#foot_krm_1514_05">5</a></sup> ऊह्यानि। </li> <li><sup id="ref_krm_1514_06"><a href="#foot_krm_1514_06">6</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1514_01"><a href="#ref_krm_1514_01">↑</a> (१५०३)</li> <li id="foot_krm_1514_02"><a href="#ref_krm_1514_02">↑</a> (१-भ्वादिः-३३७। सक। सेट्। पर।)</li> <li id="foot_krm_1514_03"><a href="#ref_krm_1514_03">↑</a> (श्लो। ७८)</li> <li id="foot_krm_1514_04"><a href="#ref_krm_1514_04">↑</a> [लुंड इत्येके इति च।]</li> <li id="foot_krm_1514_05"><a href="#ref_krm_1514_05">↑</a> (१९७)</li> <li id="foot_krm_1514_06"><a href="#ref_krm_1514_06">↑</a> [पृष्ठम्११७१+ २४]</li></ul></p>

लुठ|लोठकः-ठिका|लुलुठिषकः-लुलोठिषकः-षिका|लोलुठकः-ठिका|लोठिता-त्री|लोठयिता-त्री|लुलुठिषिता-लुलोठिषिता-त्री|लोलुठिता-त्री
<ul><li><sup id="ref_krm_1515_01"><a href="#foot_krm_1515_01">1</a></sup> {@“लुठ प्रतीघाते”@} <sup id="ref_krm_1515_02"><a href="#foot_krm_1515_02">2</a></sup> क्षीरस्वामी त्वेवं पठित्वा ‘लुट इत्येके’ इत्याह। </li> <li>‘श्लेषालस्योपघातेषु प्रतिघाते क्रमाल्लुठेत्। </li> <li>लुण्ठेत्, लोठति लोठेत किन्तु गत्यां च लुण्ठति।।’ <sup id="ref_krm_1515_03"><a href="#foot_krm_1515_03">3</a></sup> इति देवः। </li> <li>लोठकः-ठिका, लोठकः-ठिका, लुलुठिषकः-लुलोठिषकः-षिका, लोलुठकः-ठिका;</li> <li>  लोठिता-त्री, लोठयिता-त्री, लुलुठिषिता-लुलोठिषिता-त्री, लोलुठिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि भौवादिककुकतिवत् <sup id="ref_krm_1515_04"><a href="#foot_krm_1515_04">4</a></sup> बोध्यानि। </li> <li>कर्तरि क्तप्रत्यये <sup id="ref_krm_1515_05"><a href="#foot_krm_1515_05">5</a></sup> लुठितम्-लोठितम् <sup id="ref_krm_1515_06"><a href="#foot_krm_1515_06">6</a></sup> इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1515_01"><a href="#ref_krm_1515_01">↑</a> (१५०४)</li> <li id="foot_krm_1515_02"><a href="#ref_krm_1515_02">↑</a> (१-भ्वादिः-७४९। सक। सेट्। आत्म।)</li> <li id="foot_krm_1515_03"><a href="#ref_krm_1515_03">↑</a> (श्लो। ७८)</li> <li id="foot_krm_1515_04"><a href="#ref_krm_1515_04">↑</a> (१९७)</li> <li id="foot_krm_1515_05"><a href="#ref_krm_1515_05">↑</a> [[१। ‘उदुपधात्--’ (१-२-२१) इति निष्ठायाः कित्त्वविकल्पेन रूपद्वयं भवति।]]</li> <li id="foot_krm_1515_06"><a href="#ref_krm_1515_06">↑</a> [[आ। ‘श्रिया समग्रं द्युति तं मदेनेव प्रलोठितम्।।’ भ। का। ७-१०४।]]</li></ul></p>

लुठि|लुण्ठकः-ण्ठिका|लुलुण्ठिषकः-षिका|लोलुण्ठकः-ण्ठिका|लुण्ठिता-त्री|लुण्ठयिता-त्री|लुलुण्ठिषिता-त्री|लोलुण्ठिता-त्री
<ul><li><sup id="ref_krm_1516_01"><a href="#foot_krm_1516_01">1</a></sup> {@“लुठि आलस्ये प्रतिघाते च”@} <sup id="ref_krm_1516_02"><a href="#foot_krm_1516_02">2</a></sup> ‘श्लेषालस्योपघातेषु प्रतिघाते क्रमाल्लुठेत्। </li> <li>लुण्ठेत्, लोठति लोठेत किन्तु गत्यां च लुण्ठति।।’ <sup id="ref_krm_1516_03"><a href="#foot_krm_1516_03">3</a></sup> इति देवः। </li> <li>अत्र क्षीरतरङ्गिण्यां ‘रुठि आलस्ये गतिप्रतिघाते च’ इत्येव दृश्यते। </li> <li>अन्यत्र सर्वेषु कोशेषु ‘लुठि--’ इत्येव दृश्यते। </li> <li>लुण्ठकः-ण्ठिका, लुण्ठकः-ण्ठिका, लुलुण्ठिषकः-षिका, लोलुण्ठकः-ण्ठिका;</li> <li>  लुण्ठिता-त्री, लुण्ठयिता-त्री, लुलुण्ठिषिता-त्री, लोलुण्ठिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाणि भौवादिककुण्ठतिवत् <sup id="ref_krm_1516_04"><a href="#foot_krm_1516_04">4</a></sup> ऊह्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1516_01"><a href="#ref_krm_1516_01">↑</a> (१५०५)</li> <li id="foot_krm_1516_02"><a href="#ref_krm_1516_02">↑</a> (१-भ्वादिः-३४३। सक। सेट्। पर।)</li> <li id="foot_krm_1516_03"><a href="#ref_krm_1516_03">↑</a> (श्लो। ७८)</li> <li id="foot_krm_1516_04"><a href="#ref_krm_1516_04">↑</a> (२०९)</li></ul></p>

लुठि|लुण्ठकः-ण्ठिका|लुलुण्ठिषकः-षिका|लोलुण्ठकः-ण्ठिका|लुण्ठिता-त्री|लुण्ठयिता-त्री|लुलुण्ठिषिता-त्री|लोलुण्ठिता-त्री
<ul><li><sup id="ref_krm_1517_01"><a href="#foot_krm_1517_01">1</a></sup> {@“लुठि गतौ”@} <sup id="ref_krm_1517_02"><a href="#foot_krm_1517_02">2</a></sup> ‘… गत्यां च लुण्ठति।।’ <sup id="ref_krm_1517_03"><a href="#foot_krm_1517_03">3</a></sup> इति देवः। </li> <li>लुण्ठकः-ण्ठिका, लुण्ठकः-ण्ठिका, लुलुण्ठिषकः-षिका, लोलुण्ठकः-ण्ठिका;</li> <li>  लुण्ठिता-त्री, लुण्ठयिता-त्री, लुलुण्ठिषिता-त्री, लोलुण्ठिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि भौवादिककुण्ठतिवत् <sup id="ref_krm_1517_04"><a href="#foot_krm_1517_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1517_05"><a href="#foot_krm_1517_05">5</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1517_01"><a href="#ref_krm_1517_01">↑</a> (१५०६)</li> <li id="foot_krm_1517_02"><a href="#ref_krm_1517_02">↑</a> (१-भ्वादिः-३४६। सक। सेट्। पर।)</li> <li id="foot_krm_1517_03"><a href="#ref_krm_1517_03">↑</a> (श्लो। ७८)</li> <li id="foot_krm_1517_04"><a href="#ref_krm_1517_04">↑</a> (२०९)</li> <li id="foot_krm_1517_05"><a href="#ref_krm_1517_05">↑</a> [पृष्ठम्११७२+ २७]</li></ul></p>

लुण्ठ|लुण्ठकः-ण्ठिका|लुलुण्ठयिषकः-षिका|लोलुण्ठकः-ण्ठिका|लुण्ठयिता-त्री|लुलुण्ठयिषिता-त्री|लोलुण्ठिता-त्री
<ul><li><sup id="ref_krm_1518_01"><a href="#foot_krm_1518_01">1</a></sup> {@“लुण्ठ स्तेये”@} <sup id="ref_krm_1518_02"><a href="#foot_krm_1518_02">2</a></sup> ‘… स्तेये लुण्टति लुण्टयेत्।’ <sup id="ref_krm_1518_03"><a href="#foot_krm_1518_03">3</a></sup> इति देवः। </li> <li>धातुकाव्ये <sup id="ref_krm_1518_04"><a href="#foot_krm_1518_04">4</a></sup> ‘--अनादरे च द्रुमे’ इत्युपात्तम्। </li> <li>‘लुण्ठ लुण्ट’ इति टवर्गप्रथमान्तः, द्वितीयान्त इति चात्र मतद्वयम्। </li> <li>‘लुण्ड’ इत्यपि शाकटायनः। </li> <li>पुरुषकारे टान्तपाठ एव साधुः, ठान्तो- ऽप्रामाणिक इति साग्रहं क्षीरस्वामिमतनिरासपूर्वकं प्रतिपादितम्। </li> <li>माधव- प्रभृतयः ठान्तपाठमेव न्यासादिग्रन्थसंवादपुरस्सरं स्थापयामासुः। </li> <li>‘जल्पभिक्ष- कुट्टलुण्ट--’ <sup id="ref_krm_1518_05"><a href="#foot_krm_1518_05">5</a></sup> इत्यत्र सूत्रकारैः टान्तोऽथ वा ठान्तः पठितोऽयं धातुरित्यत्र नियामकं किमपि न दृश्यते। </li> <li>उभयेऽपि स्वस्वमतानुसारेण टान्तं ठान्तं च सूत्रेऽपि पठन्ति। </li> <li>ईदृशस्थलेषु ‘प्रयोग एव भगवान् तान् व्यवस्थापयेत् पथि’ इत्युक्तदिशा शिष्टप्रयोगस्योभयधाऽप्युपलम्भाद् वयं तूष्णीकाः। </li> <li>लुण्ठकः-ण्ठिका, लुलुण्ठयिषकः-षिका, लोलुण्ठकः-ण्ठिका;</li> <li>  लुण्ठयिता-त्री, लुलुण्ठयिषिता-त्री, लोलुण्ठिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि चौरादिक- कुस्मयतिवत् <sup id="ref_krm_1518_06"><a href="#foot_krm_1518_06">6</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_1518_07"><a href="#foot_krm_1518_07">7</a></sup>--’ <sup id="ref_krm_1518_08"><a href="#foot_krm_1518_08">8</a></sup> इति षाकन्प्रत्यये रूपमेवम्। </li> <li>षित्त्वात् स्त्रियां ङीषि लुण्ठाकी इति रूपम्।]] लुण्ठाकः-ठाकी, लुण्टाकः- <sup id="ref_krm_1518_09"><a href="#foot_krm_1518_09">9</a></sup> टाकी।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1518_01"><a href="#ref_krm_1518_01">↑</a> (१५०७)</li> <li id="foot_krm_1518_02"><a href="#ref_krm_1518_02">↑</a> (१०-चुरादिः-१५६३। सक। सेट्। उभ।)</li> <li id="foot_krm_1518_03"><a href="#ref_krm_1518_03">↑</a> (श्लो। ७४)</li> <li id="foot_krm_1518_04"><a href="#ref_krm_1518_04">↑</a> (३-१६)</li> <li id="foot_krm_1518_05"><a href="#ref_krm_1518_05">↑</a> (३-२-१५५)</li> <li id="foot_krm_1518_06"><a href="#ref_krm_1518_06">↑</a> (२३६)</li> <li id="foot_krm_1518_07"><a href="#ref_krm_1518_07">↑</a> [[१। तच्छीलादिषु कर्तृषु ‘जल्पभिक्षकुट्टलुण्ठ[ट]</li> <li id="foot_krm_1518_08"><a href="#ref_krm_1518_08">↑</a> (३-२-१५५)</li> <li id="foot_krm_1518_09"><a href="#ref_krm_1518_09">↑</a> [[आ। ‘त्रिभुवनतमोलुण्टाकीनामहो मिहिरत्विषा…।’ अनर्घराघवे २-७७।]]</li></ul></p>

लुथि|लुन्थकः-न्थिका|लुलुन्थिषकः-षिका|लोलुन्थकः-न्थिका|लुन्थिता-त्री|लुन्थयिता-त्री|लुलुन्थिषिता-त्री|लोलुन्थिता-त्री
<ul><li><sup id="ref_krm_1519_01"><a href="#foot_krm_1519_01">1</a></sup> {@“लुथि हिंसासंक्लेश<sup id="ref_krm_1519_02"><a href="#foot_krm_1519_02">2</a></sup>योः”@} <sup id="ref_krm_1519_03"><a href="#foot_krm_1519_03">3</a></sup> लुन्थकः-न्थिका, लुन्थकः-न्थिका, लुलुन्थिषकः-षिका, लोलुन्थकः-न्थिका;</li> <li>  लुन्थिता-त्री, लुन्थयिता-त्री, लुलुन्थिषिता-त्री, लोलुन्थिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि भौवादिककुन्थतिवत् <sup id="ref_krm_1519_04"><a href="#foot_krm_1519_04">4</a></sup> बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1519_01"><a href="#ref_krm_1519_01">↑</a> (१५०८)</li> <li id="foot_krm_1519_02"><a href="#ref_krm_1519_02">↑</a> [न]</li> <li id="foot_krm_1519_03"><a href="#ref_krm_1519_03">↑</a> (१-भ्वादिः-४५। सक। सेट्। पर।)</li> <li id="foot_krm_1519_04"><a href="#ref_krm_1519_04">↑</a> (२२०)</li></ul></p>

लु[ञ्च]न्च|“केचिदमुमुदितं|पठन्ति|तदनार्षम्|अयं|भावः-उदित्त्वेन|क्त्वायामिड्विक-|ल्पनात्]]लुञ्चकः-ञ्चिका|लुञ्चकः-ञ्चिका|लुलुञ्चिषकः-षिका|लोलुचकः-चिका|लुञ्चिता-त्री|लुञ्चयिता-त्री|लुलुञ्चिषिता-त्री|लोलुचिता-त्री|लुञ्चन्-न्ती|लुञ्चयन्-न्ती|लुलुञ्चिषन्-न्ती|क्विपि-लुक्-लुञ्चौ-लुञ्चः|ण्यन्तात्|तु|लुन्-लुञ्चौ-लुञ्चः
<ul><li><sup id="ref_krm_1520_01"><a href="#foot_krm_1520_01">1</a></sup> {@“लु<sup id="ref_krm_1520_02"><a href="#foot_krm_1520_02">2</a></sup>न्च अपनयने”@} <sup id="ref_krm_1520_03"><a href="#foot_krm_1520_03">3</a></sup> <sup id="ref_krm_1520_04"><a href="#foot_krm_1520_04">4</a></sup> “केचिदमुमुदितं पठन्ति, तदनार्षम्;</li> <li>  राजदन्तादिषु <sup id="ref_krm_1520_05"><a href="#foot_krm_1520_05">5</a></sup> ‘मृष्टलुचितम्’ इति पाठात्” इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>अयं भावः--उदित्त्वेन क्त्वायामिड्विक- ल्पनात् ‘यस्य विभाषा’ <sup id="ref_krm_1520_06"><a href="#foot_krm_1520_06">6</a></sup> इति निष्ठायामिण्निषेधः स्यात् इति।]] <sup id="ref_krm_1520_07"><a href="#foot_krm_1520_07">7</a></sup> लुञ्चकः-ञ्चिका, लुञ्चकः-ञ्चिका, लुलुञ्चिषकः-षिका, लोलुचकः-चिका;</li> <li>  लुञ्चिता-त्री, लुञ्चयिता-त्री, लुलुञ्चिषिता-त्री, लोलुचिता-त्री;</li> <li>  <sup id="ref_krm_1520_08"><a href="#foot_krm_1520_08">8</a></sup> लुञ्चन्-न्ती, लुञ्चयन्-न्ती, लुलुञ्चिषन्-न्ती;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि भौवादिक- कुञ्चतिवत् <sup id="ref_krm_1520_09"><a href="#foot_krm_1520_09">9</a></sup> ज्ञेयानि। </li> <li>लुञ्चितम्, <sup id="ref_krm_1520_10"><a href="#foot_krm_1520_10">10</a></sup> लुञ्चित्वा-लुचित्वा, इमानि रूपाण्यधि- कानीति विशेषः। </li> <li>क्विपि-लुक्-लुञ्चौ-लुञ्चः;</li> <li>  ण्यन्तात् तु लुन्-लुञ्चौ-लुञ्चः;</li> <li>  इति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1520_01"><a href="#ref_krm_1520_01">↑</a> (१५०९)</li> <li id="foot_krm_1520_02"><a href="#ref_krm_1520_02">↑</a> [ञ्च]</li> <li id="foot_krm_1520_03"><a href="#ref_krm_1520_03">↑</a> (१-भ्वादिः-१८७। सक। सेट्। पर।)</li> <li id="foot_krm_1520_04"><a href="#ref_krm_1520_04">↑</a> [[[अ]</li> <li id="foot_krm_1520_05"><a href="#ref_krm_1520_05">↑</a> (२-२-३१)</li> <li id="foot_krm_1520_06"><a href="#ref_krm_1520_06">↑</a> (७-२-१५)</li> <li id="foot_krm_1520_07"><a href="#ref_krm_1520_07">↑</a> [पृष्ठम्११७३+ २५]</li> <li id="foot_krm_1520_08"><a href="#ref_krm_1520_08">↑</a> [[आ। ‘चुकोच यत्रोत्कुचिताङ्गमुन्मुदः क्रौञ्चोऽपि लुञ्चन् हृदि सम्यगार्तताम्।।’ धा। का। १-२५।]]</li> <li id="foot_krm_1520_09"><a href="#ref_krm_1520_09">↑</a> (२२२)</li> <li id="foot_krm_1520_10"><a href="#ref_krm_1520_10">↑</a> [[१। क्त्वायाम् ‘वञ्चिलुञ्च्युतश्च’ (१-२-२४) इति कित्त्वविकल्पनात् पक्षे नलोपे च रूपद्वयम् इति ज्ञेयम्।]]</li></ul></p>

लुप|लोपकः-पिका|लुलुपिषकः-लुलोपिषकः-षिका|लोलुपकः-पिका|लुपिता-त्री|लोपयिता-त्री|लुलुपिषिता-लुलोपिषिता-त्री|लोलुपिता-त्री
<ul><li><sup id="ref_krm_1521_01"><a href="#foot_krm_1521_01">1</a></sup> {@“लुप विमोहने”@} <sup id="ref_krm_1521_02"><a href="#foot_krm_1521_02">2</a></sup> लोपकः-पिका, लोपकः-पिका, लुलुपिषकः-लुलोपिषकः-षिका, लोलुपकः-पिका;</li> <li>  लुपिता-त्री, लोपयिता-त्री, लुलुपिषिता-लुलोपिषिता-त्री, लोलुपिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि दैवादिककुप्यतिवत् <sup id="ref_krm_1521_03"><a href="#foot_krm_1521_03">3</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1521_01"><a href="#ref_krm_1521_01">↑</a> (१५१०)</li> <li id="foot_krm_1521_02"><a href="#ref_krm_1521_02">↑</a> (४-दिवादिः-१२३७। सक। सेट्। पर।)</li> <li id="foot_krm_1521_03"><a href="#ref_krm_1521_03">↑</a> (२२४)</li></ul></p>

लुपॢ|लोपकः-पिका|लुलुप्सकः-प्सिका|लोलुपकः-पिका|लोप्ता-त्री|लोपयिता-त्री|लुलुप्सिता-त्री|लोलुपिता-त्री
<ul><li><sup id="ref_krm_1522_01"><a href="#foot_krm_1522_01">1</a></sup> {@“लुपॢ छेदने”@} <sup id="ref_krm_1522_02"><a href="#foot_krm_1522_02">2</a></sup> मुचादिः। </li> <li>लोपकः-पिका, लोपकः-पिका, लुलुप्सकः-प्सिका, लोलुपकः-पिका;</li> <li>  लोप्ता-त्री, लोपयिता-त्री, लुलुप्सिता-त्री, लोलुपिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि तौदादिकमुञ्चतिवत् <sup id="ref_krm_1522_03"><a href="#foot_krm_1522_03">3</a></sup> ज्ञेयानि। </li> <li>शतरि- <sup id="ref_krm_1522_04"><a href="#foot_krm_1522_04">4</a></sup> लुम्पन्-न्ती, यङन्तात् शानचि-लोलुप्यमानः, <sup id="ref_krm_1522_05"><a href="#foot_krm_1522_05">5</a></sup> णिनिप्रत्यये <sup id="ref_krm_1522_06"><a href="#foot_krm_1522_06">6</a></sup> भयलोपी इति च अस्य धातोः विशेषः। </li> <li><sup id="ref_krm_1522_07"><a href="#foot_krm_1522_07">7</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1522_01"><a href="#ref_krm_1522_01">↑</a> (१५११)</li> <li id="foot_krm_1522_02"><a href="#ref_krm_1522_02">↑</a> (६-तुदादिः-१४३१। सक। अनि। उभ।)</li> <li id="foot_krm_1522_03"><a href="#ref_krm_1522_03">↑</a> (१२७५)</li> <li id="foot_krm_1522_04"><a href="#ref_krm_1522_04">↑</a> [[२। ‘तुदादिभ्यः शः’ (३-१-७७) इति विकरणप्रत्यये शे ‘शे मुचादीनाम्’ (७-१-५९) इति नुमि च लुम्पन् इति रूपम्। एवं शानजन्तेऽपि प्राक्रेया ज्ञेया।]]</li> <li id="foot_krm_1522_05"><a href="#ref_krm_1522_05">↑</a> [[३। ‘लुपसदचर--’ (३-१-२४) इति भावगर्हायां यङि रूपमेवम्। भावगर्हा धात्वर्थगर्हा। न तु क्रियासमभिहारे यङ् इति ज्ञेयम्।]]</li> <li id="foot_krm_1522_06"><a href="#ref_krm_1522_06">↑</a> [[B। ‘… गोपानां भयलोपिवाग्भिरबलाविन्नानुलेपं वहन्।’ धा। का। २-८५।]]</li> <li id="foot_krm_1522_07"><a href="#ref_krm_1522_07">↑</a> [पृष्ठम्११७४+ २४]</li></ul></p>

लुबि|लुम्बकः-म्बिका|लुम्बकः-लुम्बिका|लुलुम्बिषकः-षिका|लोलुम्बकः-म्बिका|लुम्बिता-त्री|लुम्बयिता-त्री|लुलुम्बिषिता-त्री|लोलुम्बिता-त्री
<ul><li><sup id="ref_krm_1523_01"><a href="#foot_krm_1523_01">1</a></sup> {@“लुबि अर्दने”@} <sup id="ref_krm_1523_02"><a href="#foot_krm_1523_02">2</a></sup> ‘लुम्बयेत् तुम्बयेदर्दे शपि लुम्बति तुम्बति।।’ <sup id="ref_krm_1523_03"><a href="#foot_krm_1523_03">3</a></sup> इति देवः। </li> <li>क्षीरतरङ्गिण्यामयं धातुः न दृश्यते। </li> <li>लुम्बकः-म्बिका, लुम्बकः-लुम्बिका, लुलुम्बिषकः-षिका, लोलुम्बकः-म्बिका;</li> <li>  लुम्बिता-त्री, लुम्बयिता-त्री, लुलुम्बिषिता-त्री, लोलुम्बिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि भौवादिककुण्ठतिवत् <sup id="ref_krm_1523_04"><a href="#foot_krm_1523_04">4</a></sup> ऊह्यानि। </li> <li>कर्मणि क्तप्रत्यये <sup id="ref_krm_1523_05"><a href="#foot_krm_1523_05">5</a></sup> परिलुम्बितः इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1523_01"><a href="#ref_krm_1523_01">↑</a> (१५१२)</li> <li id="foot_krm_1523_02"><a href="#ref_krm_1523_02">↑</a> (१-भ्वादिः-४२७। सक। सेट्। पर।)</li> <li id="foot_krm_1523_03"><a href="#ref_krm_1523_03">↑</a> (श्लो। १३९)</li> <li id="foot_krm_1523_04"><a href="#ref_krm_1523_04">↑</a> (२०९)</li> <li id="foot_krm_1523_05"><a href="#ref_krm_1523_05">↑</a> [[आ। ‘… दिक्कुम्बितेऽर्के परिलुम्बिताम्बुजे।।’ धा। का। १-५५।]]</li></ul></p>

लुबि|लुम्बकः-म्बिका|लुलुम्बयिषकः-षिका|लुलुम्बिषकः-षिका|लोलुम्बकः-म्बिका|लुम्बयिता-त्री|लुलुम्बयिषिता-त्री|लुम्बिता-त्री|लुलुम्बिषिता-त्री|लोलुम्बिता-त्री
<ul><li><sup id="ref_krm_1524_01"><a href="#foot_krm_1524_01">1</a></sup> {@“लुबि अदर्शने”@} <sup id="ref_krm_1524_02"><a href="#foot_krm_1524_02">2</a></sup> ‘लुम्बयेद् तुम्बयेदर्दे शपि लुम्बति तुम्बति।।’ <sup id="ref_krm_1524_03"><a href="#foot_krm_1524_03">3</a></sup> इति देवः। </li> <li>क्षीरतरङ्गिण्यां ‘--अर्दने’ इत्युक्तम्। </li> <li>देवमैत्रेयौ ‘अर्दने’ इत्येव पठतः। </li> <li>चुरादिपाठादेव इदित्करणात् लुम्बयति-लुम्बति इति सिद्धेः अर्दनेऽर्थे भ्वादौ पाठोऽस्य व्यर्थः स्यात्। </li> <li>इह <sup id="ref_krm_1524_04"><a href="#foot_krm_1524_04">4</a></sup> अदर्शनेऽर्थे तु अर्थभेदात् सोऽपि <sup id="ref_krm_1524_05"><a href="#foot_krm_1524_05">5</a></sup> सार्थकः स्यात्। </li> <li>अत एव ‘अदर्शने’ इत्येव समञ्जसमिति भाति। </li> <li>लुम्बकः-म्बिका, लुलुम्बयिषकः-षिका, लुम्बकः-म्बिका, लुलुम्बिषकः-षिका, लोलुम्बकः-म्बिका;</li> <li>  लुम्बयिता-त्री, लुलुम्बयिषिता-त्री, लुम्बिता-त्री, लुलुम्बिषिता-त्री, लोलुम्बिता-त्री;</li> <li>  इत्यादीनि रूपाणि भाषार्थकचौरादिककुंशयतिवत् <sup id="ref_krm_1524_06"><a href="#foot_krm_1524_06">6</a></sup> ऊह्यानि। </li> <li>कर्मणि क्तप्रत्यये <sup id="ref_krm_1524_07"><a href="#foot_krm_1524_07">7</a></sup> लुम्बितम्-तः इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1524_01"><a href="#ref_krm_1524_01">↑</a> (१५१३)</li> <li id="foot_krm_1524_02"><a href="#ref_krm_1524_02">↑</a> (१०-चुरादिः-१६५७। अक। सेट्। उभ।)</li> <li id="foot_krm_1524_03"><a href="#ref_krm_1524_03">↑</a> (श्लो। १३९)</li> <li id="foot_krm_1524_04"><a href="#ref_krm_1524_04">↑</a> [चुरादौ]</li> <li id="foot_krm_1524_05"><a href="#ref_krm_1524_05">↑</a> [भ्वादौ पाठः]</li> <li id="foot_krm_1524_06"><a href="#ref_krm_1524_06">↑</a> (२३२)</li> <li id="foot_krm_1524_07"><a href="#ref_krm_1524_07">↑</a> [[B। ‘किं कुम्ब्यते सदसि लुम्बितवैभवोऽहम्…।’ धा। का। ३-२९।]]</li></ul></p>

लुभ|लोभकः-भिका|लुलुभिषकः-लुलोभिषकः-षिका|लोलुभकः-भिका|लोभिता-लोब्धा-ब्ध्री|लोभयिता-त्री|लुलुभिषिता-लुलोभिषिता-त्री|लोलुभिता-त्री|लुभ्यन्-न्ती|लोभयन्-न्ती|लुलुभिषन्-लुलोभिषन्-न्ती|निष्ठायाम्-लुब्धम्-लुब्धः-लुब्धवान्
<ul><li><sup id="ref_krm_1525_01"><a href="#foot_krm_1525_01">1</a></sup> {@“लुभ गार्ध्ये”@} <sup id="ref_krm_1525_02"><a href="#foot_krm_1525_02">2</a></sup> ‘भूवादेरवृत्कृतत्वात् लोभते इति भवति इति आत्रेयः’ इति मा। </li> <li>धा। </li> <li>वृत्ति- रिहानुसन्धेया। </li> <li>‘गार्ध्यम् = आकाङ्क्षा’ इति च तत्र वृत्तिः। </li> <li>‘गार्ध्ये लुभ्यति मोहार्थे तुदादेर्लुभतीति शे।’ <sup id="ref_krm_1525_03"><a href="#foot_krm_1525_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_1525_04"><a href="#foot_krm_1525_04">4</a></sup> लोभकः-भिका, लोभकः-भिका, <sup id="ref_krm_1525_05"><a href="#foot_krm_1525_05">5</a></sup> लुलुभिषकः-लुलोभिषकः-षिका, लोलुभकः-भिका;</li> <li>  <sup id="ref_krm_1525_06"><a href="#foot_krm_1525_06">6</a></sup> लोभिता-लोब्धा-ब्ध्री, लोभयिता-त्री, लुलुभिषिता-लुलोभिषिता-त्री, लोलुभिता-त्री;</li> <li>  लुभ्यन्-न्ती, लोभयन्-न्ती, लुलुभिषन्-लुलोभिषन्-न्ती;</li> <li>  इत्यादिकानि रूपाणि सर्वाण्यपि दैवादिककुप्यतिवत् <sup id="ref_krm_1525_07"><a href="#foot_krm_1525_07">7</a></sup> ज्ञेयानि। </li> <li>निष्ठायाम्- <sup id="ref_krm_1525_08"><a href="#foot_krm_1525_08">8</a></sup> लुब्धम्-लुब्धः-लुब्धवान्;</li> <li>  क्त्वायां- <sup id="ref_krm_1525_09"><a href="#foot_krm_1525_09">9</a></sup> लुभित्वा-लोभित्वा-लुब्ध्वा, इति च अस्य धातोः विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1525_01"><a href="#ref_krm_1525_01">↑</a> (१५१४)</li> <li id="foot_krm_1525_02"><a href="#ref_krm_1525_02">↑</a> (४-दिवादिः-१२३८। सक। सेट्। पर।)</li> <li id="foot_krm_1525_03"><a href="#ref_krm_1525_03">↑</a> (श्लो। १४१)</li> <li id="foot_krm_1525_04"><a href="#ref_krm_1525_04">↑</a> [पृष्ठम्११७५+ २५]</li> <li id="foot_krm_1525_05"><a href="#ref_krm_1525_05">↑</a> [[१। ‘रलो व्युपधात्--’ (१-२-२६) इति सेटः क्त्वासनोः कित्त्वविकल्पः। तेन सन्नन्ते सर्वत्र क्त्वाप्रत्ययेऽपि रूपद्वयं बोध्यम्।]]</li> <li id="foot_krm_1525_06"><a href="#ref_krm_1525_06">↑</a> [[२। तृचि ‘तीषसहलुभ--’ (७-२-४८) इति तादेरार्धधातुकस्य इड्विकल्पनात् रूपद्वय- मिति ज्ञेयम्।]]</li> <li id="foot_krm_1525_07"><a href="#ref_krm_1525_07">↑</a> (२२४)</li> <li id="foot_krm_1525_08"><a href="#ref_krm_1525_08">↑</a> [[३। ‘यस्य विभाषा’ (७-२-१५) इति निष्ठायामिण्निषेधः। तेन एकमेव रूपम्।]]</li> <li id="foot_krm_1525_09"><a href="#ref_krm_1525_09">↑</a> [[४। क्त्वायाम् ‘रलो व्युपधात् --’ (१-२-२६) इति कित्त्वविकल्पः। ‘तीषसहलुभ--’ (७-२-४८) इत्यादिना इड्विकल्पः। तेन रूपत्रयमिति ज्ञेयम्।]]</li></ul></p>

लुभ|लोभकः-भिका|लुलुभिषकः-लुलोभिषकः-षिका|लोलुभकः-भिका|लोभिता-त्री|लोब्धा-ध्री|लोभयिता-त्री|लुलुभिषिता-लुलोभिषिता-त्री|लोलुभिता-त्री
<ul><li><sup id="ref_krm_1526_01"><a href="#foot_krm_1526_01">1</a></sup> {@“लुभ विमोहने”@} <sup id="ref_krm_1526_02"><a href="#foot_krm_1526_02">2</a></sup> ‘विमोहनम् = व्याकुलीकरणम्’ इति क्षीरस्वामी। </li> <li>‘गार्ध्ये लुभ्यति मोहार्थे तुदादेर्लुभतीति शे।’ <sup id="ref_krm_1526_03"><a href="#foot_krm_1526_03">3</a></sup> इति देवः। </li> <li>लोभकः-भिका, लोभकः-भिका, लुलुभिषकः-लुलोभिषकः-षिका, लोलुभकः-भिका;</li> <li>  लोभिता-त्री, लोब्धा-ध्री, लोभयिता-त्री, लुलुभिषिता-लुलोभिषिता-त्री, लोलुभिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि दैवादिककुप्यतिवत् <sup id="ref_krm_1526_04"><a href="#foot_krm_1526_04">4</a></sup> ऊह्यानि। </li> <li>निष्ठायाम्- <sup id="ref_krm_1526_05"><a href="#foot_krm_1526_05">5</a></sup> विलुभितः <sup id="ref_krm_1526_06"><a href="#foot_krm_1526_06">6</a></sup> विलुभिताः केशाः], शतरि-लुभन्, क्त्वायां <sup id="ref_krm_1526_07"><a href="#foot_krm_1526_07">7</a></sup> लुभित्वा-लोभित्वा, इमानि रूपाणि अस्य धातोः विशेषः। </li> <li><sup id="ref_krm_1526_08"><a href="#foot_krm_1526_08">8</a></sup> लोभनीयम्। </li> <li><sup id="ref_krm_1526_09"><a href="#foot_krm_1526_09">9</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1526_01"><a href="#ref_krm_1526_01">↑</a> (१५१५)</li> <li id="foot_krm_1526_02"><a href="#ref_krm_1526_02">↑</a> (६-तुदादिः-१३०५। सक। सेट्। पर।)</li> <li id="foot_krm_1526_03"><a href="#ref_krm_1526_03">↑</a> (श्लो। १४१)</li> <li id="foot_krm_1526_04"><a href="#ref_krm_1526_04">↑</a> (२२४)</li> <li id="foot_krm_1526_05"><a href="#ref_krm_1526_05">↑</a> [[आ। ‘दधत् विलुभितं वातैः केसरं वह्निपिङ्गलम्।।’ भ। का। ९-४०।]]</li> <li id="foot_krm_1526_06"><a href="#ref_krm_1526_06">↑</a> [ [[५। ‘लुभो विमोहने’ (७-२-५४) इति निष्ठायामिडागमो भवति। विलुभिताः = केशाः। विलुभितः = सीमन्तः। अन्यत्र लुब्धो वृषलः, शीतेन पीडित इत्यर्थः।]]</li> <li id="foot_krm_1526_07"><a href="#ref_krm_1526_07">↑</a> [[B। ‘लुभो विमोहने’ त्विट् स्यात् वा कित्त्वं रल इत्यपि। लोभित्वा वा लुभित्वा वा केशान्नृत्यति (?) बालिका।।’ इति प्र। सर्वस्वम्।]]</li> <li id="foot_krm_1526_08"><a href="#ref_krm_1526_08">↑</a> [[C। ‘दिग्व्यापिनीर्लोचनलोभनीयाः मृजान्वयाः स्नेहमिव स्रवन्तीः।’ भ। का। २-१३।]]</li> <li id="foot_krm_1526_09"><a href="#ref_krm_1526_09">↑</a> [पृष्ठम्११७६+ २९]</li></ul></p>

