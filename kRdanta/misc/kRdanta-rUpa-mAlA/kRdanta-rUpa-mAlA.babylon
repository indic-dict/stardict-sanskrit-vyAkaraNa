<ul><li><sup id="ref_krm_1532_01"><a href="#foot_krm_1532_01">1</a></sup> {@“लोकृ भाषार्थः”@} <sup id="ref_krm_1532_02"><a href="#foot_krm_1532_02">2</a></sup> आस्वदीयः। </li> <li>‘दर्शने लोकते लोकेर्भाषार्थे णौ तु लोकयेत्।।’ <sup id="ref_krm_1532_03"><a href="#foot_krm_1532_03">3</a></sup> इति देवः। </li> <li>‘-- भामार्थः’ इति क्षीरस्वामी। </li> <li>आस्वदीयत्वात् णिज्विकल्पः। </li> <li>शुद्ध-ण्यन्त-सन्नन्त-यङन्तरूपाणि सर्वाणि पूर्वोक्तभौवादिकलोकतिवत् <sup id="ref_krm_1532_04"><a href="#foot_krm_1532_04">4</a></sup> ऊह्यानि। </li> <li>लोककः-किका, लुलोकयिषकः-षिका;</li> <li>  लोकयिता-त्री, लुलोकयिषिता-त्री;</li> <li>  <sup id="ref_krm_1532_05"><a href="#foot_krm_1532_05">5</a></sup> लोकन्-न्ती, लुलोकयिषन्-न्ती;</li> <li>  लोकयिष्यन्-न्ती-ती, लुलोकयिषिष्यन्-न्ती-ती;</li> <li>  लोकयमानः, लुलोकयिषमाणः, लोकयिष्यमाणः, लुलोकयिषिष्यमाणः;</li> <li>  लोक्- लोकौ-लोकः;</li> <li>  लोकितः, लुलोकयिषितः-तम्-तवान्;</li> <li>  लोकः, लुलोकयिषुः;</li> <li>  लोकयितव्यम्, लुलोकयिषितव्यम्;</li> <li>  लोकनीयम्, लुलोकयिषणीयम्;</li> <li>  लोक्यम्, लुलोकयिष्यम्;</li> <li>  लोक्यमानः, लुलोकयिष्यमाणः;</li> <li>  ईषल्लुलोकयिषः-दुर्लुलोकयिषः-सुलुलोकयिषः;</li> <li>  -- -- लोकः, लुलोकयिषः;</li> <li>  लोकितुम्, लुलोकयिषितुम्;</li> <li>  लोकना, लुलोकयिषा;</li> <li>  लोकनम्, लुलोकयिषणम्;</li> <li>  लोकयित्वा, लुलोकयिषित्वा;</li> <li>  विलोक्य, विलुलोकयिष्य;</li> <li>  लोकम् २ -लोकयित्वा २;</li> <li>  लुलोकयिषम् २ -लुलोकयिषित्वा २;</li> <li>  इति ण्यन्ते तत्प्रकृतिकसन्नन्ते च रूपाणीति विशेषः। </li> <li><sup id="ref_krm_1532_06"><a href="#foot_krm_1532_06">6</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1532_01"><a href="#ref_krm_1532_01">↑</a> (१५२१)</li> <li id="foot_krm_1532_02"><a href="#ref_krm_1532_02">↑</a> (१०-चुरादिः-१७७७। अक। सेट्। उभ।)</li> <li id="foot_krm_1532_03"><a href="#ref_krm_1532_03">↑</a> (श्लो। ४०)</li> <li id="foot_krm_1532_04"><a href="#ref_krm_1532_04">↑</a> (१५२०)</li> <li id="foot_krm_1532_05"><a href="#ref_krm_1532_05">↑</a> [[१। आस्वदीयत्वात् णिजभावपक्षे शतरि परस्मैपदमेव।]]</li> <li id="foot_krm_1532_06"><a href="#ref_krm_1532_06">↑</a> [पृष्ठम्११८०+ २७]</li></ul></p>

लोचृ|लोचकः-चिका|लुलोचिषकः-षिका|लोलोचकः-चिका|लोचिता-त्री|लोचयिता-त्री|लुलोचिषिता-त्री|लोलोचिता-त्री|आलोचितः|लोचनम्|आलोचनम्
<ul><li><sup id="ref_krm_1533_01"><a href="#foot_krm_1533_01">1</a></sup> {@“लोचृ दर्शने”@} <sup id="ref_krm_1533_02"><a href="#foot_krm_1533_02">2</a></sup> ‘णौ लोचयति भाषार्थे दर्शने शपि लोचते।।’ <sup id="ref_krm_1533_03"><a href="#foot_krm_1533_03">3</a></sup> इति देवः। </li> <li>लोचकः-चिका, लोचकः-चिका, लुलोचिषकः-षिका, लोलोचकः-चिका;</li> <li>  लोचिता-त्री, लोचयिता-त्री, लुलोचिषिता-त्री, लोलोचिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि भौवादिकलोकतिवत् <sup id="ref_krm_1533_04"><a href="#foot_krm_1533_04">4</a></sup> बोध्यानि। </li> <li>‘लोचकः-स्त्रीशिरोवस्त्रम् शिरस्त्रञ्च’ इति क्षीरतरङ्गिण्याम्। </li> <li>आलोचितः, लोचनम्, आलोचनम्;</li> <li>  ल्युटि- <sup id="ref_krm_1533_05"><a href="#foot_krm_1533_05">5</a></sup> लोचनम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1533_01"><a href="#ref_krm_1533_01">↑</a> (१५२२)</li> <li id="foot_krm_1533_02"><a href="#ref_krm_1533_02">↑</a> (१-भ्वादिः-१६४। सक। सेट्। आत्म।)</li> <li id="foot_krm_1533_03"><a href="#ref_krm_1533_03">↑</a> (श्लो। ४६)</li> <li id="foot_krm_1533_04"><a href="#ref_krm_1533_04">↑</a> (१५२०)</li> <li id="foot_krm_1533_05"><a href="#ref_krm_1533_05">↑</a> [[आ। ‘सुलोचना यत्र शचीसमप्रभा…।।’ धा। का। १। २४।]]</li></ul></p>

लोचृ|लोचकः-चिका|लुलोचयिषकः-षिकः|लुलोचिषकः-षिका|लोलोचकः-चिका
<ul><li><sup id="ref_krm_1534_01"><a href="#foot_krm_1534_01">1</a></sup> {@“लोचृ भाषार्थः”@} <sup id="ref_krm_1534_02"><a href="#foot_krm_1534_02">2</a></sup> आस्वदीयः। </li> <li>तेन णिज्विकल्पः। </li> <li>‘णौ लोचयति भाषार्थे दर्शने शपि लोचते।।’ <sup id="ref_krm_1534_03"><a href="#foot_krm_1534_03">3</a></sup> इति देवः। </li> <li>लोचकः-चिका, लुलोचयिषकः-षिकः, लोचकः-चिका, लुलोचिषकः-षिका, लोलोचकः-चिका;</li> <li>  इत्यादीनि रूपाणि सर्वाणि <sup id="ref_krm_1534_04"><a href="#foot_krm_1534_04">4</a></sup> भौवादिकदर्शनार्थकलोकतिवत् <sup id="ref_krm_1534_05"><a href="#foot_krm_1534_05">5</a></sup> ऊह्यानि। </li> <li>ण्यन्तप्रकृतिकसन्नन्ते तु भाषार्थकलोकयतिवत् <sup id="ref_krm_1534_06"><a href="#foot_krm_1534_06">6</a></sup> ऊह्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1534_01"><a href="#ref_krm_1534_01">↑</a> (१५२३)</li> <li id="foot_krm_1534_02"><a href="#ref_krm_1534_02">↑</a> (१०-चुरादिः-१७७८। सक। सेट्। उभ।)</li> <li id="foot_krm_1534_03"><a href="#ref_krm_1534_03">↑</a> (श्लो। ४६)</li> <li id="foot_krm_1534_04"><a href="#ref_krm_1534_04">↑</a> [ण्यन्तप्रकृतिकसन्नन्तं विना]</li> <li id="foot_krm_1534_05"><a href="#ref_krm_1534_05">↑</a> (१५२०)</li> <li id="foot_krm_1534_06"><a href="#ref_krm_1534_06">↑</a> (१५२१)</li></ul></p>

लोडृ|लोडकः-डिका|लुलोडिषकः-षिका|लोलोडकः-डिका|लोडिता-त्री|लोडयिता-त्री|लुलोडिषिता-त्री|लोलोडिता-त्री
<ul><li><sup id="ref_krm_1535_01"><a href="#foot_krm_1535_01">1</a></sup> {@“लोडृ उन्मादे”@} <sup id="ref_krm_1535_02"><a href="#foot_krm_1535_02">2</a></sup> ‘लौडृ--’ इति क्षीरस्वामी। </li> <li>लोडकः-डिका, लोडकः-डिका, लुलोडिषकः-षिका, लोलोडकः-डिका, लोडिता-त्री, लोडयिता-त्री, लुलोडिषिता-त्री, लोलोडिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि भौवादिकखोरतिवत् <sup id="ref_krm_1535_03"><a href="#foot_krm_1535_03">3</a></sup> ज्ञेयानि। </li> <li>निष्ठायाम्- <sup id="ref_krm_1535_04"><a href="#foot_krm_1535_04">4</a></sup> आलोडितम्-तः- तवान् इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1535_01"><a href="#ref_krm_1535_01">↑</a> (१५२४)</li> <li id="foot_krm_1535_02"><a href="#ref_krm_1535_02">↑</a> (१-भ्वादिः-३५७। अक। सेट्। पर।)</li> <li id="foot_krm_1535_03"><a href="#ref_krm_1535_03">↑</a> (३६३)</li> <li id="foot_krm_1535_04"><a href="#ref_krm_1535_04">↑</a> [[B। ‘श्यामारुणैर्वारणदानतोयैरालोडिताः काञ्चनभूपरागाः।’ शि। व। ३-२७।]]</li></ul></p>

