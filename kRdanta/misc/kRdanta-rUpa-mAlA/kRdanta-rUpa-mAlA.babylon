<ul><li><sup id="ref_krm_0932_01"><a href="#foot_krm_0932_01">1</a></sup> {@“धेट् पाने”@} <sup id="ref_krm_0932_02"><a href="#foot_krm_0932_02">2</a></sup> ‘धेटो धयति पानार्थे, धाञो धत्ते दधात्यपि।’ <sup id="ref_krm_0932_03"><a href="#foot_krm_0932_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_0932_04"><a href="#foot_krm_0932_04">4</a></sup> <sup id="ref_krm_0932_05"><a href="#foot_krm_0932_05">5</a></sup> धायकः-यिका, <sup id="ref_krm_0932_06"><a href="#foot_krm_0932_06">6</a></sup> धापकः-पिका, <sup id="ref_krm_0932_07"><a href="#foot_krm_0932_07">7</a></sup> धित्सकः-त्सिका, <sup id="ref_krm_0932_08"><a href="#foot_krm_0932_08">8</a></sup> देधीयकः-यिका;</li> <li>  <sup id="ref_krm_0932_09"><a href="#foot_krm_0932_09">9</a></sup> प्रणिधाता-त्री, धापयिता-त्री, धित्सिता-त्री, देधीयिता-त्री;</li> <li>  <sup id="ref_krm_0932_10"><a href="#foot_krm_0932_10">10</a></sup> प्रणिधयन्-न्ती, <sup id="ref_krm_0932_11"><a href="#foot_krm_0932_11">11</a></sup> धापयन्-न्ती, धित्सन्-न्ती;</li> <li>  -- प्रणिधास्यन्-न्ती-ती, धापयिष्यन्-न्ती-ती, धित्सिष्यन्-न्ती-ती;</li> <li>  -- -- धापयमानः, धापयिष्यमाणः, -- देधीयमानः, देधीयिष्यमाणः;</li> <li>  <sup id="ref_krm_0932_12"><a href="#foot_krm_0932_12">12</a></sup> धाः-धौ-धाः;</li> <li>  -- -- -- <sup id="ref_krm_0932_13"><a href="#foot_krm_0932_13">13</a></sup> धीतम्-धीतः-धीतवान्, धापितः, धित्सितः, देधीयितः-तवान्;</li> <li>  <sup id="ref_krm_0932_14"><a href="#foot_krm_0932_14">14</a></sup> उद्धयः <sup id="ref_krm_0932_15"><a href="#foot_krm_0932_15">15</a></sup> -धयः, <sup id="ref_krm_0932_16"><a href="#foot_krm_0932_16">16</a></sup> नासिकन्धयः- <sup id="ref_krm_0932_17"><a href="#foot_krm_0932_17">17</a></sup> स्तनन्धयः, स्तनन्धयी, <sup id="ref_krm_0932_18"><a href="#foot_krm_0932_18">18</a></sup> नाडिन्धयः- <sup id="ref_krm_0932_19"><a href="#foot_krm_0932_19">19</a></sup> <sup id="ref_krm_0932_20"><a href="#foot_krm_0932_20">20</a></sup> मुष्टिन्धयः, <sup id="ref_krm_0932_21"><a href="#foot_krm_0932_21">21</a></sup> शुनिन्धयः, <sup id="ref_krm_0932_22"><a href="#foot_krm_0932_22">22</a></sup> घटिन्धयः-खारिन्धयः-खरिन्धयः- <sup id="ref_krm_0932_23"><a href="#foot_krm_0932_23">23</a></sup> वातन्धयः, <sup id="ref_krm_0932_24"><a href="#foot_krm_0932_24">24</a></sup> धारुः, <sup id="ref_krm_0932_25"><a href="#foot_krm_0932_25">25</a></sup> <sup id="ref_krm_0932_26"><a href="#foot_krm_0932_26">26</a></sup> धात्री, <sup id="ref_krm_0932_27"><a href="#foot_krm_0932_27">27</a></sup> पुष्पन्धयः, <sup id="ref_krm_0932_28"><a href="#foot_krm_0932_28">28</a></sup> मुञ्जन्धयः-कूलन्धयः-आस्यन्धयः, <sup id="ref_krm_0932_29"><a href="#foot_krm_0932_29">29</a></sup> क्षीरधाः, धापः, धित्सुः, देध्यः;</li> <li>  धातव्यम्, धापयितव्यम्, धित्सितव्यम्, देधीयितव्यम्;</li> <li>  प्रणिधानीयम्, धापनीयम्, धित्सनीयम्, देधीयनीयम्;</li> <li>  प्रणिघेयम्, धाप्यम्, धित्स्यम्, देधीय्यम्;</li> <li>  <sup id="ref_krm_0932_30"><a href="#foot_krm_0932_30">30</a></sup> ईषद्धानः-दुर्धानः-सुधानः;</li> <li>  -- -- धायः, <sup id="ref_krm_0932_31"><a href="#foot_krm_0932_31">31</a></sup> सन्धिः, धापः, धित्सः, देधीयः;</li> <li>  धातुम्, धापयितुम्, धित्सितुम्, देधीयितुम्;</li> <li>  <sup id="ref_krm_0932_32"><a href="#foot_krm_0932_32">32</a></sup> धीतिः, <sup id="ref_krm_0932_33"><a href="#foot_krm_0932_33">33</a></sup> सुधा, धापना, धित्सा, देधीया;</li> <li>  धयनम्, धापनम्, धित्सनम्, देधीयनम्;</li> <li>  धीत्वा, धापयित्वा, धित्सित्वा, देधीयित्वा;</li> <li>  प्रधाय, प्रधाप्य, प्रधित्स्य, प्रदेधीय्य;</li> <li>  धायम् २ धीत्वा २ धापम् २ धापयित्वा २ धित्सम् २ धित्सित्वा २ देधीयम् २;</li> <li>  देधीयित्वा २;</li> <li>  <sup id="ref_krm_0932_34"><a href="#foot_krm_0932_34">34</a></sup> धेनुः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0932_01"><a href="#ref_krm_0932_01">↑</a> (९२२)</li> <li id="foot_krm_0932_02"><a href="#ref_krm_0932_02">↑</a> (१-भ्वादिः-९०२। सक। अनि। पर।)</li> <li id="foot_krm_0932_03"><a href="#ref_krm_0932_03">↑</a> (श्लो। ६)</li> <li id="foot_krm_0932_04"><a href="#ref_krm_0932_04">↑</a> [पृष्ठम्०८१२+ २५]</li> <li id="foot_krm_0932_05"><a href="#ref_krm_0932_05">↑</a> [[१। ‘आदेच उपदेशेऽशिति’ (६-१-४५) इत्यात्त्वे, ‘आतो युक् चिण्कृतोः’ (७-३-३३) इति युगागमः। एवं घञि णमुल्यपि ज्ञेयम्।]]</li> <li id="foot_krm_0932_06"><a href="#ref_krm_0932_06">↑</a> [[२। ण्यन्ते सर्वत्र आत्त्वे, आदन्तलक्षणः पुगागमो ज्ञेयः।]]</li> <li id="foot_krm_0932_07"><a href="#ref_krm_0932_07">↑</a> [[३। धारूपत्वेनास्य धुसंज्ञकत्वात्, ‘सनि मीमाघु--’ (७-४-५४) इत्यादिना इस्। ‘अत्र लोपोऽभ्यासस्य’ (७-४-५८) इत्यभ्यासलोपः। ‘सः स्यार्धधातुके’ (७-४-४९) इति तकारः। एवं सन्नन्ते सर्वत्र प्रक्रिया।]]</li> <li id="foot_krm_0932_08"><a href="#ref_krm_0932_08">↑</a> [[४। यङन्ते सर्वत्र, ‘घुमास्था--’ (६-४-६६) इत्यादिना ईत्वे, अभ्यासे गुणः।]]</li> <li id="foot_krm_0932_09"><a href="#ref_krm_0932_09">↑</a> [[५। ‘नेर्गदनदपतपदघु--’ (८-४-१७) इत्यादिना नेर्णत्वम्।]]</li> <li id="foot_krm_0932_10"><a href="#ref_krm_0932_10">↑</a> [[६। शतरि, ‘एचोऽयवायावः’ (६-१-७८) इत्ययादेशः।]]</li> <li id="foot_krm_0932_11"><a href="#ref_krm_0932_11">↑</a> [[७। ‘न पादम्याङ्--’ (१-३-८९) इत्यत्र, ‘धेट उपसंख्यानम्’ (वा। १-३-८९) इति वचनात् उभयपदित्वमस्य;\n\n  तेन ण्यन्तात् शतृशानचौ।]]</li> <li id="foot_krm_0932_12"><a href="#ref_krm_0932_12">↑</a> [[८। क्विपि, आत्त्वे रूपमेवम्।]]</li> <li id="foot_krm_0932_13"><a href="#ref_krm_0932_13">↑</a> [[९। निष्ठायाम्, ‘घुमास्था--’ (६-४-६६) इति ईत्त्वे, रूपम्। एवम्, क्त्वाप्रमृति- ष्वपि ज्ञेयम्।]]</li> <li id="foot_krm_0932_14"><a href="#ref_krm_0932_14">↑</a> [[१०। सोपसृष्टात्, निरुपसृष्टादपि, ‘पाघ्राध्माधेद्दृशः शः’ (३-१-१३७) इति शप्रत्यये, शित्त्वेन सार्वधातुकत्वात् शप्प्रत्यये, पररूपे, अयादेशे च रूपमेवम्। केचित्तु निरुपसृष्टादेवायं प्रत्यय इति साधयन्ति।]]</li> <li id="foot_krm_0932_15"><a href="#ref_krm_0932_15">↑</a> [[आ। ‘ध्वनीनामुद्धमैरेभिर्मधूनामुद्धयैर्मृशम्।’ भ। का। ६। ७८।]]</li> <li id="foot_krm_0932_16"><a href="#ref_krm_0932_16">↑</a> [[११। ‘नासिकास्तनयोर्घ्माघेटोः’ (३-२-२९) इति खश्प्रत्ययः। ‘खित्यनव्ययस्य’ (६-३-६६) इति ह्रस्वः, ‘अरुर्द्विषदजन्तस्य--’ (६-३-६७) इति मुम्। घेटष्टि- त्त्वात् अवयवेऽचरितार्थस्य टित्करणस्य समुदाय उपयोगात् स्त्रियां ङीप्।]]</li> <li id="foot_krm_0932_17"><a href="#ref_krm_0932_17">↑</a> [[B। ‘सत्त्वमेजयसिंहाढ्यान् स्तनन्धयसमत्विषौ।’ भ। का। ६। ९५।]]</li> <li id="foot_krm_0932_18"><a href="#ref_krm_0932_18">↑</a> [[१२। ‘नाडीमुष्ट्योश्च’ (३-२-३०) इति खशू। पूर्ववत् मुम्।]]</li> <li id="foot_krm_0932_19"><a href="#ref_krm_0932_19">↑</a> [पृष्ठम्०८१३+ २८]</li> <li id="foot_krm_0932_20"><a href="#ref_krm_0932_20">↑</a> [[आ। ‘किमत्र बहुना भजद्भवपयोधिमुष्टिन्धयः त्रिविक्रम भवत्क्रमः क्षिपतु मङ्क्षु रङ्गद्विषः।।’ अभीतिस्तवे २७।]]</li> <li id="foot_krm_0932_21"><a href="#ref_krm_0932_21">↑</a> [[१। ‘खश्प्रकरणे--वातशुनीतिलशर्धेषु अजघेट्तुदजहातीनां खश उपसंख्यानम्’ (वा। ३-२-२८) इति वार्तिकात् खश्। ‘खित्यनव्ययस्य’ (६-३-६६) इति ह्रस्वः।]]</li> <li id="foot_krm_0932_22"><a href="#ref_krm_0932_22">↑</a> [[२। ‘घटीखारीखरीषु--’ (वा। ३-२-३०) इति खश्। वार्तिकमिदं भाष्ये न दृश्यते। ‘नाडीमुष्ट्योश्च’ (३-२-३०) इत्यत्र विद्यमानश्चकारोऽनुक्तसमुच्चयार्थकः इति मत्वा सिद्धान्तकौमुद्यादिषूक्तः स्यात्।]]</li> <li id="foot_krm_0932_23"><a href="#ref_krm_0932_23">↑</a> [[३। अत्रापि, बाहुलकात् खश्। वातन्धयः = सर्पः।]]</li> <li id="foot_krm_0932_24"><a href="#ref_krm_0932_24">↑</a> [[४। ‘दाधेट्सिशदसदो रुः’ (३-२-१५९) इति ताच्छीलिको रुप्रत्ययः।]]</li> <li id="foot_krm_0932_25"><a href="#ref_krm_0932_25">↑</a> [[B। ‘श्रद्धालुं भ्रामरं धारुं सद्रुमद्रौ वद द्रुतम्।।’ भ। का। ७। २१।]]</li> <li id="foot_krm_0932_26"><a href="#ref_krm_0932_26">↑</a> [[५। ‘धः कर्मणि ष्ट्रन्’ (३-२-१८१) इति कर्मण्यर्थे ष्ट्रन्। षित्त्वात् स्त्रियां ङीष्। ‘तत्र बाला धयन्त्येनामिति धात्र्युपमातरि। भैषज्यार्थं दधत्येनामिति स्यादामलक्यपि।।’ इति प्र। सर्वस्वे।]]</li> <li id="foot_krm_0932_27"><a href="#ref_krm_0932_27">↑</a> [[६। पुष्पशब्द उपपदे धातोरस्य खश्प्रत्ययविधानाभावात् पृषोदरादित्वेन वा, ‘नाडी- मुष्ट्योश्च’ (३-२-३०) इत्यत्र अनुक्तसमुच्चयार्थकचकारेण वा साधुत्वमिति ज्ञेयम्। एवमेव मुञ्जन्धय इत्यादिष्वपि। पुष्पन्धयः = भ्रमरः। कूलन्धयः = नदी- वेगः। मुञ्जन्धयः = क्रिमिविशेषः। आस्यन्धयः = कामुकः।]]</li> <li id="foot_krm_0932_28"><a href="#ref_krm_0932_28">↑</a> [[C। ‘चक्राङ्गीमदपश्यतोहरचलच्छम्पासमुन्मेषणः पुष्पत्केतकगन्धसिन्धुविलुठत्पुष्पन्धयान्धीकृतैः।’ च। भारते ३। ५३।]]</li> <li id="foot_krm_0932_29"><a href="#ref_krm_0932_29">↑</a> [[७। क्षीरं धयतीति क्षीरधाः। ‘आतो मनिन्--’ (३-२-७४) इति विट्।]]</li> <li id="foot_krm_0932_30"><a href="#ref_krm_0932_30">↑</a> [[८। ‘आतो युच्’ (३-३-१२८) इति ईषदाद्युपपदेषु खलपवादो युच्।]]</li> <li id="foot_krm_0932_31"><a href="#ref_krm_0932_31">↑</a> [[९। ‘उपसर्गे घोः किः’ (३-३-९२) इति किप्रत्यये, ‘आतो लोप इटि च’ (६-४-६४) इत्याकारलोपे रूपमेवम्।]]</li> <li id="foot_krm_0932_32"><a href="#ref_krm_0932_32">↑</a> [पृष्ठम्०८१४+ २५]</li> <li id="foot_krm_0932_33"><a href="#ref_krm_0932_33">↑</a> [[१। ‘आतश्चोपसर्गे’ (३-३-१०६) इति स्त्रियामङ्।]]</li> <li id="foot_krm_0932_34"><a href="#ref_krm_0932_34">↑</a> [[२। ‘धेट इच्च’ (द। उ। १-१४५) इति नुप्रत्यये इकारश्चान्तादेशः। धेनुः = नवप्रसू- ता गौः।]]</li></ul></p>

धोरृ|धोरकः-रिका|दुधोरिषकः-षिका|दोधोरकः-रिका
<ul><li><sup id="ref_krm_0933_01"><a href="#foot_krm_0933_01">1</a></sup> {@“धोरृ गतिचातुर्ये”@} <sup id="ref_krm_0933_02"><a href="#foot_krm_0933_02">2</a></sup> धोरकः-रिका, धोरकः-रिका, दुधोरिषकः-षिका, दोधोरकः-रिका;</li> <li>  <sup id="ref_krm_0933_03"><a href="#foot_krm_0933_03">3</a></sup> धोरन्-न्ती, <sup id="ref_krm_0933_04"><a href="#foot_krm_0933_04">4</a></sup> आधोरणः, <sup id="ref_krm_0933_05"><a href="#foot_krm_0933_05">5</a></sup> धौरितकम्, इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकखोरतिवत् <sup id="ref_krm_0933_06"><a href="#foot_krm_0933_06">6</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0933_01"><a href="#ref_krm_0933_01">↑</a> (९२३)</li> <li id="foot_krm_0933_02"><a href="#ref_krm_0933_02">↑</a> (१-भ्वादिः-५५३। अक। सेट्। पर।)</li> <li id="foot_krm_0933_03"><a href="#ref_krm_0933_03">↑</a> [[आ। ‘अखोरधोरत्पतगेन्द्रवाहनं स्वसेविनां तित्सरिषां निराडिनम्।’ धा। का। १। ७१।]]</li> <li id="foot_krm_0933_04"><a href="#ref_krm_0933_04">↑</a> [[३। ण्यन्तात् नन्द्यादित्वात् (३-१-१३४) कर्तरि ल्युप्रत्ययः। आधोरणः = हस्तिपकः।]]</li> <li id="foot_krm_0933_05"><a href="#ref_krm_0933_05">↑</a> [[४। निष्ठान्तात् संज्ञायां कन्प्रत्ययः। धोरितकमेव धौरितकम् = अश्वानां गति- विशेषः। कनन्तात् प्रज्ञाद्यण्।]]</li> <li id="foot_krm_0933_06"><a href="#ref_krm_0933_06">↑</a> (३६३)</li></ul></p>

