<ul><li><sup id="ref_krm_0829_01"><a href="#foot_krm_0829_01">1</a></sup> {@“दमु उपशमे”@} <sup id="ref_krm_0829_02"><a href="#foot_krm_0829_02">2</a></sup> शमादिः। </li> <li>घटादिः। </li> <li><sup id="ref_krm_0829_03"><a href="#foot_krm_0829_03">3</a></sup> दमकः-मिका, <sup id="ref_krm_0829_04"><a href="#foot_krm_0829_04">4</a></sup> दमकः-मिका, दिदमिषकः-षिका, <sup id="ref_krm_0829_05"><a href="#foot_krm_0829_05">5</a></sup> दन्दमकः-दंदमकः-मिका;</li> <li>  दमिता-त्री, दमयिता-त्री, दिदमिषिता-त्री, दन्दमिता-त्री;</li> <li>  <sup id="ref_krm_0829_06"><a href="#foot_krm_0829_06">6</a></sup> दाम्यन्-न्ती, <sup id="ref_krm_0829_07"><a href="#foot_krm_0829_07">7</a></sup> दमयन्-दमयन्ती, दिदमिषन्-न्ती;</li> <li>  -- दमिष्यन्-न्ती-ती, दमयिष्यन्-न्ती-ती, दिदमिषिष्यन्-न्ती-ती;</li> <li>  -- -- <sup id="ref_krm_0829_08"><a href="#foot_krm_0829_08">8</a></sup> दमयमानः, दमयिष्यमाणः, -- दन्दम्यमानः, दन्दमिष्यमाणः;</li> <li>  <sup id="ref_krm_0829_09"><a href="#foot_krm_0829_09">9</a></sup> प्रदान्-प्रदामौ-प्रदामः;</li> <li>  -- -- -- <sup id="ref_krm_0829_10"><a href="#foot_krm_0829_10">10</a></sup> दान्तम्-तः, <sup id="ref_krm_0829_11"><a href="#foot_krm_0829_11">11</a></sup> दान्तः- <sup id="ref_krm_0829_12"><a href="#foot_krm_0829_12">12</a></sup> दमितः, दिदमिषितः, दन्दमितः-तवान्;</li> <li>  <sup id="ref_krm_0829_13"><a href="#foot_krm_0829_13">13</a></sup> दमः, <sup id="ref_krm_0829_14"><a href="#foot_krm_0829_14">14</a></sup> दमी, <sup id="ref_krm_0829_15"><a href="#foot_krm_0829_15">15</a></sup> बलिन्दमः <sup id="ref_krm_0829_16"><a href="#foot_krm_0829_16">16</a></sup>, अरिन्दमः <sup id="ref_krm_0829_17"><a href="#foot_krm_0829_17">17</a></sup>, दमः, <sup id="ref_krm_0829_18"><a href="#foot_krm_0829_18">18</a></sup> कुलदमनः, <sup id="ref_krm_0829_19"><a href="#foot_krm_0829_19">19</a></sup> सर्वदमनः, दिदमिषुः, दन्दमः;</li> <li>  दमितव्यम्, दमयितव्यम्, दिदमिषितव्यम्, दन्दमितव्यम्;</li> <li>  दमनीयम्- <sup id="ref_krm_0829_20"><a href="#foot_krm_0829_20">20</a></sup> दमनीया, दमनीयम्, दिदमिषणीयम्, दन्दमनीयम्;</li> <li>  <sup id="ref_krm_0829_21"><a href="#foot_krm_0829_21">21</a></sup> दम्यम्, दम्यम्, दिदमिष्यम्, दन्दम्यम्;</li> <li>  ईषद्दमः- <sup id="ref_krm_0829_22"><a href="#foot_krm_0829_22">22</a></sup> दुर्दमः-सुदमः;</li> <li>  -- -- दम्यमानः, दम्यमानः, दिदमिष्यमाणः, दन्दम्यमानः;</li> <li>  दमः, दमः, दिदमिषः, दन्दमः;</li> <li>  दमितुम्, दमयितुम्, दिदमिषितुम्, दन्दमितुम्;</li> <li>  दान्तिः, दमना, दिदमिषा, दन्दमा;</li> <li>  दमनम्, दमनम्, दिदमिषणम्, दन्दमनम्;</li> <li>  <sup id="ref_krm_0829_23"><a href="#foot_krm_0829_23">23</a></sup> दमित्वा <sup id="ref_krm_0829_24"><a href="#foot_krm_0829_24">24</a></sup> -दान्त्वा, दमयित्वा, दिदमिषित्वा, दन्दमित्वा;</li> <li>  प्रदम्य, <sup id="ref_krm_0829_25"><a href="#foot_krm_0829_25">25</a></sup> प्रदमय्य, प्रदिदमिष्य, प्रदन्दम्य;</li> <li>  <sup id="ref_krm_0829_26"><a href="#foot_krm_0829_26">26</a></sup> दमम् २, दमित्वा २, दान्त्वा २, <sup id="ref_krm_0829_27"><a href="#foot_krm_0829_27">27</a></sup> दमम् २-दामम् २, दमयित्वा २, दिदमिषम् २, दिदमिषित्वा २, दन्दमम् २;</li> <li>  दन्दमित्वा २;</li> <li>  <sup id="ref_krm_0829_28"><a href="#foot_krm_0829_28">28</a></sup> दण्डः, <sup id="ref_krm_0829_29"><a href="#foot_krm_0829_29">29</a></sup> इति तन्प्रत्ययः। </li> <li>‘तितुत्रतथ--’ <sup id="ref_krm_0829_30"><a href="#foot_krm_0829_30">30</a></sup> इतीण्णिषेधः।]] दन्तः, <sup id="ref_krm_0829_31"><a href="#foot_krm_0829_31">31</a></sup> इत्युनसिप्रत्ययः। </li> <li>दमुनाः = देवः, उपदेशः, अग्निश्च।]] दमूनाः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0829_01"><a href="#ref_krm_0829_01">↑</a> (८१९)</li> <li id="foot_krm_0829_02"><a href="#ref_krm_0829_02">↑</a> (४-दिवादिः-१२०३। सक। सेट्। पर।)</li> <li id="foot_krm_0829_03"><a href="#ref_krm_0829_03">↑</a> [[१। ण्वुलि ‘अत उपधायाः (७-२-११६) इति प्राप्ताया वृद्धेः, ‘नोदात्तोपदेशस्य मान्त- स्यानाचमेः’ (७-३-३४) इति निषेधः। एवं घञि, णमुल्यपि ज्ञेयम्।]]</li> <li id="foot_krm_0829_04"><a href="#ref_krm_0829_04">↑</a> [[२। ‘जनीजॄष्क्रसुरञ्जोऽमन्ताश्च’ (ग। सू। भ्वादौ) इति भ्वादिषु पाठात् घटादित्वम्। तेन ‘घटादयो मितः’ (ग। सू। भ्वादौ) इति मित्त्वात् णौ परतः ‘मितां ह्रस्वः’ (६-४-९२) इति ह्रस्वः सर्वत्र ज्ञेयः।]]</li> <li id="foot_krm_0829_05"><a href="#ref_krm_0829_05">↑</a> [[३। यङन्ते, ‘नुगतोऽनुनासिकान्तस्य’ (७-४-८५) इत्यभ्यासस्य नुगागमः। ‘स च पदान्तवद् वाच्यः (वा। ७-४-८५) इति पदान्तवद्भावेन ‘वा पदान्तस्य’ (८-४-५९) इति परसवर्णविकल्पः। एवं यङन्ते सर्वत्र रूपद्वयं ज्ञेयम्।]]</li> <li id="foot_krm_0829_06"><a href="#ref_krm_0829_06">↑</a> [[४। ‘दिवादिभ्यः--’ (३-१-६९) इति श्यनि, ‘शमामष्टानां दीर्घः श्यनि’ (७-३-७४) इति दीर्घः।]]</li> <li id="foot_krm_0829_07"><a href="#ref_krm_0829_07">↑</a> [[५। ‘न पादमि--’ (१-३-८९) इत्यादिना ण्यन्तात् परस्मैपदनिषेधस्तुः ‘अनन्तरस्य विधिर्वा भवति प्रतिषेधो वा’ (परिभाषा ६२) इति न्यायात् ‘णिचश्च’ (१-३-७४) इति प्राप्तस्यैव परस्मैपदस्य निषेधकः। तेन, दमयन्ती इत्यादिप्रयोगानुसाराच्च, परगामिनि क्रियाफले ‘स्वरितञितः कर्त्रभिप्राये क्रियाफले’ (१-३-७२) इति परस्मैपदं भवत्येव। तेनात्र ण्यन्तात् शता भवति।]]</li> <li id="foot_krm_0829_08"><a href="#ref_krm_0829_08">↑</a> [[६। ‘न पादमि--’ (१-३-८९) इत्यनेन ‘णिचश्च’ (१-३-७४) इति प्राप्तस्य परस्मैपदस्य निषेधादात्मनेपदमेव।]]</li> <li id="foot_krm_0829_09"><a href="#ref_krm_0829_09">↑</a> [[७। क्विपि, ‘अनुनासिकस्य क्विझलोः क्ङिति’ (६-४-१५) इति दीर्घे, पदान्ते ‘मो नो धातोः’ (८-२-६४) इति मकारस्य नकारः।]]</li> <li id="foot_krm_0829_10"><a href="#ref_krm_0829_10">↑</a> [[८। उदित्त्वेन क्त्वायामिड्विकल्पनात् निष्ठायाम्, ‘यस्य विभाषा’ (७-२-१५) इति इण्णिषेधः। दीर्घानुस्वारपरसवर्णाः भवन्ति।]]</li> <li id="foot_krm_0829_11"><a href="#ref_krm_0829_11">↑</a> [[९। ण्यन्ते, ‘वा दान्तशान्त--’ (७-२-२७) इत्यनेन इडभावो णिलुक् च निपात्यते। अत्र व्यवस्थितविभाषामाश्रित्य, ‘ब्रह्मचारिणि विषये दान्तः, अन्यत्र दमितः’ इत्युक्तं क्षीरतरङ्गिण्याम्।]]</li> <li id="foot_krm_0829_12"><a href="#ref_krm_0829_12">↑</a> [[आ। ‘वृत्तशस्त्रान् महारम्भानदान्तांस्त्रिदशेरपि।।’ भ। का। ९। १९।]]</li> <li id="foot_krm_0829_13"><a href="#ref_krm_0829_13">↑</a> [पृष्ठम्०७२२+ २७]</li> <li id="foot_krm_0829_14"><a href="#ref_krm_0829_14">↑</a> [[१। ‘शमित्यष्टाभ्यो घिनुण्’ (३-२-१४१) इति तच्छीलादिषु कर्तृषु घिनुण्।]]</li> <li id="foot_krm_0829_15"><a href="#ref_krm_0829_15">↑</a> [[२। ‘संज्ञायां भृतॄवृजिधरिसहितपिदमः’ (३-२-४६) इति कर्तरि संज्ञायां खच्। खित्त्वात् मुम्। बलिं दाम्यतीति बलिन्दमः = विष्णुः। ‘मतान्तरे तु अन्तर्भा- वितण्यर्थोऽत्र दमिः’ इति सि। कौमुदी। तदानीं बलिं दमयतीति बलिन्दमः इति सकर्मकः।]]</li> <li id="foot_krm_0829_16"><a href="#ref_krm_0829_16">↑</a> [[आ। ‘ततो बलिन्दमप्रख्यं कपिर्विश्वम्भराधिपम्।’ भ। का। ६। १०८।]]</li> <li id="foot_krm_0829_17"><a href="#ref_krm_0829_17">↑</a> [[B। ‘शत्रुंसहः कोऽपि वसुन्धरा च शत्रुन्तपोऽरिन्दम एवमूह्यम्।।’ प्र। स।]]</li> <li id="foot_krm_0829_18"><a href="#ref_krm_0829_18">↑</a> [[३। नन्द्यादिषु (३-१-१३४) पाठात् ण्यन्तादस्मात् कर्तरि ल्युः। कुलं दमयतीति कुलदमनः। शत्रुदमनः इत्यादिष्वप्येवमेव ज्ञेयम्।]]</li> <li id="foot_krm_0829_19"><a href="#ref_krm_0829_19">↑</a> [[C। ‘इहायं सत्त्वानां प्रसभदमनात् सर्वदमनः…।।’ शाकुन्तले ७। ३३।]]</li> <li id="foot_krm_0829_20"><a href="#ref_krm_0829_20">↑</a> [[४। ‘कृत्यल्युटो बहुलम्’ (३-३-११३) इति बाहुलकात् कर्तरि अनीयर्। दमनीया = योषित्। दमनकर्त्री इत्यर्थः। इति प्र। सर्वस्वे।]]</li> <li id="foot_krm_0829_21"><a href="#ref_krm_0829_21">↑</a> [[५। ‘पोरदुपधात्’ (३-१-९८) इति भावे यत्प्रत्ययः। ण्यदपवादः।]]</li> <li id="foot_krm_0829_22"><a href="#ref_krm_0829_22">↑</a> [[ड्। ‘अवाक्शिरसमुत्पादं कृतान्तेनापि दुर्दमम्।’ भ। का। ४। ३।]]</li> <li id="foot_krm_0829_23"><a href="#ref_krm_0829_23">↑</a> [[६। ‘उदितो वा’ (७-२-५६) इति क्त्वायामिड्विकल्पः। तेन रूपद्वयम्।]]</li> <li id="foot_krm_0829_24"><a href="#ref_krm_0829_24">↑</a> [[E। ‘दमित्वाऽप्यरिसंघातानश्रान्त्वा कपिकेपरी।’ भ। का। ९। ४२।]]</li> <li id="foot_krm_0829_25"><a href="#ref_krm_0829_25">↑</a> [[७। ‘ल्यपि लघुपूर्वात्’ (६-४-५६) इति णेरयादेशः।]]</li> <li id="foot_krm_0829_26"><a href="#ref_krm_0829_26">↑</a> [पृष्ठम्०७२३+ २७]</li> <li id="foot_krm_0829_27"><a href="#ref_krm_0829_27">↑</a> [[१। ‘चिण्णमुलोः--’ (६-४-९३) इति णमुल्परे णौ उपधाया दीर्घविकल्पः।]]</li> <li id="foot_krm_0829_28"><a href="#ref_krm_0829_28">↑</a> [[२। ‘ञमन्ताड्डः’ (द। उ। ५। ७) इति डप्रत्ययः। दम्यन्तेऽनेनोद्धता जनाः इति दण्डः। ‘नेड् वशि कृति’ (७-२-८) इतीण्णिषेधः।]]</li> <li id="foot_krm_0829_29"><a href="#ref_krm_0829_29">↑</a> [[३। ‘हसिमृग्रिण्वामिदमि--’ [द। उ। ६-७]</li> <li id="foot_krm_0829_30"><a href="#ref_krm_0829_30">↑</a> (७-२-९)</li> <li id="foot_krm_0829_31"><a href="#ref_krm_0829_31">↑</a> [[४। ‘दमेरुनसिः’ [द। उ। ९-९५]</li></ul></p>

