<ul><li><sup id="ref_krm_1091_01"><a href="#foot_krm_1091_01">1</a></sup> {@“प्ली गतौ”@} <sup id="ref_krm_1091_02"><a href="#foot_krm_1091_02">2</a></sup> प्वादिः, ल्वादिश्च। </li> <li>‘ल्वी--’ इति क्षीरस्वामी पपाठ। </li> <li>‘-- वरणे’ इति इति केचित्। </li> <li>मैत्रेयादयस्त्वमुं न पठन्ति। </li> <li>इति मा। </li> <li>धा। </li> <li>वृत्तावुक्तम्। </li> <li>प्लायकः-यिका, प्लायकः-यिका, पिप्लीषकः-षिका, पेप्लीयकः-यिका;</li> <li>  प्लेता-त्री, प्लाययिता-त्री, पिप्लीषिता-त्री, पेप्लीयिता-त्री;</li> <li>  <sup id="ref_krm_1091_03"><a href="#foot_krm_1091_03">3</a></sup> प्लिनन्- <sup id="ref_krm_1091_04"><a href="#foot_krm_1091_04">4</a></sup> न्ती, प्लाययन्-न्ती, पिप्लीषन्-न्ती;</li> <li>  -- प्लेष्यन्-न्ती-ती, प्लाययिष्यन्-न्ती-ती, पिप्लीषिष्यन्-न्ती-ती;</li> <li>  -- -- प्लाययमानः, प्लाययिष्यमाणः, -- पेप्लीयमानः, पेप्लीयिष्यमाणः;</li> <li>  सुप्लीः-सुप्लियौ-सुप्लियः;</li> <li>  -- -- <sup id="ref_krm_1091_05"><a href="#foot_krm_1091_05">5</a></sup> प्लीनम्-प्लीनः-प्लीनवान्, प्लायितः, पिप्लीषितः, पेप्लीयितः-तवान्;</li> <li>  प्लयः, प्लायः, पिप्लीषुः, पेप्लियः;</li> <li>  प्लेतव्यम्, प्लाययितव्यम्, पिप्लीषितव्यम्, पेप्लीयितव्यम्;</li> <li>  प्लयनीयम्, प्लायनीयम्, पिप्लीषणीयम्, पेप्लीयनीयम्;</li> <li>  प्लेयम्, प्लाय्यम्, पिप्लीष्यम्, पेप्लीय्यम्;</li> <li>  ईषत्प्लयः-दुष्प्लयः-सुप्लयः;</li> <li>  -- -- प्लीयमानः, प्लाय्यमानः, पिप्लीष्यमाणः, पेप्लीय्यमानः;</li> <li>  प्लयः, प्लायः, पिप्लीषः, पेप्लीयः;</li> <li>  प्लेतुम्, प्लाययितुम्, पिप्लीषितुम्, पेप्लीयितुम्;</li> <li>  <sup id="ref_krm_1091_06"><a href="#foot_krm_1091_06">6</a></sup> प्लीनिः, प्लायना, पिप्लीषा, पेप्लीया;</li> <li>  प्लयनम्, प्लायनम्, पिप्लीषणम्, पेप्लीयनम्;</li> <li>  <sup id="ref_krm_1091_07"><a href="#foot_krm_1091_07">7</a></sup> प्लीत्वा, प्लाययित्वा, पिप्लीषित्वा, पेप्लीयित्वा;</li> <li>  संप्लीय, संप्लाय्य, प्रपिप्लीष्य, प्रपेप्लीय्य;</li> <li>  प्लायम् २, प्लीत्वा २, प्लायम् २, प्लाययित्वा २, पिप्लीषम् २, पिप्लीषित्वा २, पेप्लीयम् २;</li> <li>  पेप्लीयित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1091_01"><a href="#ref_krm_1091_01">↑</a> (१०८१)</li> <li id="foot_krm_1091_02"><a href="#ref_krm_1091_02">↑</a> (९-क्र्यादिः-१५०३। सक। अनि। पर।)</li> <li id="foot_krm_1091_03"><a href="#ref_krm_1091_03">↑</a> [[१। ‘क्र्यादिभ्यः’ (३-१-८१) इति श्ना विकरणप्रत्ययः। ‘श्नाऽभ्यस्तयोरातः’ (६-४-११२) इत्याकारलोपे ‘प्वादीनां ह्रस्वः’ (७-३-८०) इति ह्रस्वे च रूपमेवम्।]]</li> <li id="foot_krm_1091_04"><a href="#ref_krm_1091_04">↑</a> [[आ। ‘पार्श्बे लिनन् गजमचोदयदुन्मदान्धमञ्लीनशक्तिमतिघोरजवं प्लिनन्तम्।।’ धा। का। ३। ८।]]</li> <li id="foot_krm_1091_05"><a href="#ref_krm_1091_05">↑</a> [[२। ‘ल्वादिभ्यः’ (८-२-४४) इति निष्ठानत्वम्।]]</li> <li id="foot_krm_1091_06"><a href="#ref_krm_1091_06">↑</a> [[३। ‘ॠल्वादिभ्यः क्तिन् निष्ठावद्वाच्यः’ (वा। ८-२-४४) इति क्तिनस्तकारस्य नकारे रूपमेवम्।]]</li> <li id="foot_krm_1091_07"><a href="#ref_krm_1091_07">↑</a> [पृष्ठम्०९०९+ २७]</li></ul></p>

प्लुङ्|प्लावकः-विका|पुप्लूषकः-षिका|पोप्लूयकः-यिका|पुप्लावयिषकः-पिप्लावयिषकः-षिका
<ul><li><sup id="ref_krm_1092_01"><a href="#foot_krm_1092_01">1</a></sup> {@“प्लुङ् गतौ”@} <sup id="ref_krm_1092_02"><a href="#foot_krm_1092_02">2</a></sup> प्लावकः-विका, प्लावकः-विका, पुप्लूषकः-षिका, <sup id="ref_krm_1092_03"><a href="#foot_krm_1092_03">3</a></sup> पोप्लूयकः-यिका, <sup id="ref_krm_1092_04"><a href="#foot_krm_1092_04">4</a></sup> पुप्लावयिषकः-पिप्लावयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकच्यवतिवत् <sup id="ref_krm_1092_05"><a href="#foot_krm_1092_05">5</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_1092_06"><a href="#foot_krm_1092_06">6</a></sup> प्लवः-प्लवी, <sup id="ref_krm_1092_07"><a href="#foot_krm_1092_07">7</a></sup> आप्लावः- <sup id="ref_krm_1092_08"><a href="#foot_krm_1092_08">8</a></sup> आप्लवः, ण्यति- <sup id="ref_krm_1092_09"><a href="#foot_krm_1092_09">9</a></sup> आप्लाव्यः, <sup id="ref_krm_1092_10"><a href="#foot_krm_1092_10">10</a></sup> परिप्लूय इत्यादीनि रूपाणि अस्य धातोर्भवन्तीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1092_01"><a href="#ref_krm_1092_01">↑</a> (१०८२)</li> <li id="foot_krm_1092_02"><a href="#ref_krm_1092_02">↑</a> (१-भ्वादिः-९५८। सक। अनि। आत्म।)</li> <li id="foot_krm_1092_03"><a href="#ref_krm_1092_03">↑</a> [[१। यङन्तात् द्वित्वे ‘गुणो यङ्लुकोः’ (७-४-८२) इत्यभ्यासस्य गुणे ‘अकृत्सार्व- धातुकयोः--’ (७-४-२५) इति दीर्घे च रूपमेवम्।]]</li> <li id="foot_krm_1092_04"><a href="#ref_krm_1092_04">↑</a> [[२। ण्यन्तात् सनि ‘सन्यङोः’ (६-१-९) इति द्वित्वे वृद्ध्यावादेशयोः अवर्णपरयण्परकत्वा- दभ्यासघटितोकारस्य, ‘स्रवति शृणोतिद्रवतिप्रवतिप्लवतिच्यवतीनां वा’ (७-४-८१) इति पाक्षिके इकारे रूपद्वयम्। एवं सर्वत्र ण्यन्तात् सनि प्रक्रिया ज्ञेया।]]</li> <li id="foot_krm_1092_05"><a href="#ref_krm_1092_05">↑</a> (५५८)</li> <li id="foot_krm_1092_06"><a href="#ref_krm_1092_06">↑</a> [[३। पचादिषु (३-१-१३४) प्लवट् इति पाठात् टित्त्वान्ङीपि स्त्रियां प्लवी इति ज्ञेयम्।]]</li> <li id="foot_krm_1092_07"><a href="#ref_krm_1092_07">↑</a> [[४। ‘विभाषाऽऽङि रुप्लुवोः’ (३-३-५०) इति विभाषया घञ् भवति। घञभावे अप्प्रत्ययः। एवं रूपद्वयं बोध्यम्।]]</li> <li id="foot_krm_1092_08"><a href="#ref_krm_1092_08">↑</a> [[आ। ‘दूराप्लावं हनूमन्तं रामः प्रोचे गजाप्लवः।।’ भ। का। ७। ४७।]]</li> <li id="foot_krm_1092_09"><a href="#ref_krm_1092_09">↑</a> [[५। ‘भव्यगेयप्रवचनीयोपस्थानीयजन्याप्प्लाव्यापात्या वा’ (३-४-६८) इति निपातनात् कर्तरि ण्यत्प्रत्ययः।]]</li> <li id="foot_krm_1092_10"><a href="#ref_krm_1092_10">↑</a> [[६। ल्यपि ‘युप्लुवोर्दीर्घश्छन्दसि’ (६-४-५८) इति छन्दसि विषये दीर्घः। लोके तु आप्लुत्य इत्येव।]]</li></ul></p>

प्लुष|प्लोषकः-षिका|पुप्लुषिषकः-पुप्लोषिषकः-पिका|पोप्लुषकः-षिका|प्लोषिता-त्री|प्लोषयिता-त्री|पुप्लुषिषिता-पुप्लोषिषिता-|त्री|पोप्लुषिता-त्री
<ul><li><sup id="ref_krm_1093_01"><a href="#foot_krm_1093_01">1</a></sup> {@“प्लुष दाहे”@} <sup id="ref_krm_1093_02"><a href="#foot_krm_1093_02">2</a></sup>। </li> <li><sup id="ref_krm_1093_03"><a href="#foot_krm_1093_03">3</a></sup> दिवादिष्वेव प्लुषधातुर्द्विवारं पठ्यते--पुषादावन्यत्र च। </li> <li>तत्र पुषादिपाठाद् अप्लुषत् इति अङ्सिद्धिः फलम्। </li> <li>अन्यत्र तु, अप्लोषीत् इति सिचस्सिद्धिः फलमिति विशेषः। </li> <li>कृदन्तेषु तु द्वयोस्तुल्यतेत्यतोऽस्माभिरेकदैवोभयोरुपादानमादृतम्।]] ‘… दाहकर्मणि।। </li> <li>प्लोषति प्लुष्यतीति स्तां, प्लुष्णाति स्नेहनादिषु।’ <sup id="ref_krm_1093_04"><a href="#foot_krm_1093_04">4</a></sup> इति देवः। </li> <li>प्लोषकः-षिका, प्लोषकः-षिका, पुप्लुषिषकः-पुप्लोषिषकः-पिका, <sup id="ref_krm_1093_05"><a href="#foot_krm_1093_05">5</a></sup> पोप्लुषकः-षिका;</li> <li>  प्लोषिता-त्री, प्लोषयिता-त्री, पुप्लुषिषिता-पुप्लोषिषिता- त्री, पोप्लुषिता-त्री;</li> <li>  इत्यादीनि सर्वाणि रूपाणि दैवादिककुप्यतिवत् <sup id="ref_krm_1093_06"><a href="#foot_krm_1093_06">6</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_1093_07"><a href="#foot_krm_1093_07">7</a></sup> प्लुष्यन् इति शतरि रूपम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1093_01"><a href="#ref_krm_1093_01">↑</a> (१०८३)</li> <li id="foot_krm_1093_02"><a href="#ref_krm_1093_02">↑</a> (४-दिवादिः-१११५। १२१६। सक। सेट्। पर)</li> <li id="foot_krm_1093_03"><a href="#ref_krm_1093_03">↑</a> [[[अ]</li> <li id="foot_krm_1093_04"><a href="#ref_krm_1093_04">↑</a> (श्लो। १७१-१७२)</li> <li id="foot_krm_1093_05"><a href="#ref_krm_1093_05">↑</a> [पृष्ठम्०९१०+ २६]</li> <li id="foot_krm_1093_06"><a href="#ref_krm_1093_06">↑</a> (२२४)</li> <li id="foot_krm_1093_07"><a href="#ref_krm_1093_07">↑</a> [[आ। ‘तं प्लुष्यद् दृष्टिनृत्यद्रुषमपि च गतत्रासमुत्कुथ्यदङ्गं…।।’ धा। का। २। ५६।]]</li></ul></p>

प्लुष|प्लोषकः-षिका|पुप्लोषिषकः-पुप्लुषिषकः|पोप्लुषकः-|षिका
<ul><li><sup id="ref_krm_1094_01"><a href="#foot_krm_1094_01">1</a></sup> {@“प्लुष स्नेहनसेवनपूरणेषु”@} <sup id="ref_krm_1094_02"><a href="#foot_krm_1094_02">2</a></sup> ‘--मोहनदाहनयोरप्याह शङ्करः।’ इति धा। </li> <li>का। </li> <li><sup id="ref_krm_1094_03"><a href="#foot_krm_1094_03">3</a></sup>। </li> <li>‘सेचन--’ इत्यपि कुत्रचिद् दृष्टः पाठः। </li> <li>‘प्लोषति प्लुष्यतीति स्तां, प्लुष्णाति स्नेहनादिषु।’ <sup id="ref_krm_1094_04"><a href="#foot_krm_1094_04">4</a></sup> इति देवः। </li> <li>प्लोषकः-षिका, प्लोषकः-षिका, पुप्लोषिषकः-पुप्लुषिषकः, पोप्लुषकः- षिका;</li> <li>  प्लुष्णन्-ती इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकपोषतिवत् <sup id="ref_krm_1094_05"><a href="#foot_krm_1094_05">5</a></sup> ज्ञेयानि। </li> <li>निष्ठायाम्- <sup id="ref_krm_1094_06"><a href="#foot_krm_1094_06">6</a></sup> प्लुषितम्-तः, इति एकमेव रूपमिति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1094_01"><a href="#ref_krm_1094_01">↑</a> (१०८४)</li> <li id="foot_krm_1094_02"><a href="#ref_krm_1094_02">↑</a> (९-क्र्यादिः-१५२८। सक। सेट्। पर।)</li> <li id="foot_krm_1094_03"><a href="#ref_krm_1094_03">↑</a> (३-१२।)</li> <li id="foot_krm_1094_04"><a href="#ref_krm_1094_04">↑</a> (श्लो। १७२)</li> <li id="foot_krm_1094_05"><a href="#ref_krm_1094_05">↑</a> (१०२६)</li> <li id="foot_krm_1094_06"><a href="#ref_krm_1094_06">↑</a> [[B। ‘प्रुष्णन् सतां प्रियमयं प्लुषिताङ्गरागः पुष्णन् मुदं मृगदृशां रिपुधाम मुष्णन्।’ धा। का। ३। १२।]]</li></ul></p>

प्लुषु|प्लोषकः-षिका|पुप्लोषिषकः-पुप्लुषिषकः-षिका|पोप्लुषकः-|षिका
<ul><li><sup id="ref_krm_1095_01"><a href="#foot_krm_1095_01">1</a></sup> {@“प्लुषु दाहे”@} <sup id="ref_krm_1095_02"><a href="#foot_krm_1095_02">2</a></sup> ‘… दाहकर्मणि।। </li> <li>प्लोषति, प्लुष्यतीति स्तां, प्लुष्णाति स्नेहनादिषु।’ <sup id="ref_krm_1095_03"><a href="#foot_krm_1095_03">3</a></sup> इति देवः। </li> <li>प्लोषकः-षिका, प्लोषकः-षिका, पुप्लोषिषकः-पुप्लुषिषकः-षिका, पोप्लुषकः- षिका;</li> <li>  <sup id="ref_krm_1095_04"><a href="#foot_krm_1095_04">4</a></sup> प्लुष्टः <sup id="ref_krm_1095_05"><a href="#foot_krm_1095_05">5</a></sup>, इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकपोषतिवत् <sup id="ref_krm_1095_06"><a href="#foot_krm_1095_06">6</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1095_01"><a href="#ref_krm_1095_01">↑</a> (१०८५)</li> <li id="foot_krm_1095_02"><a href="#ref_krm_1095_02">↑</a> (१-भ्वादिः-७०४। सक। सेट्। पर।)</li> <li id="foot_krm_1095_03"><a href="#ref_krm_1095_03">↑</a> (श्लो। १७१-१७२)</li> <li id="foot_krm_1095_04"><a href="#ref_krm_1095_04">↑</a> [[१। उदित्त्वेन क्त्वायामि ड्विकल्पनात् निष्ठायाम्, ‘यस्य विभाषा’ (७-२-१५) इतीण्निषेधः। ष्टुत्वम्।]]</li> <li id="foot_krm_1095_05"><a href="#ref_krm_1095_05">↑</a> [[C। ‘… प्रोष्यान् प्लुष्टजनान् कृपामृतपृषद्वर्षी भवान् दानवान्।’ धा। का। १। ८८।]]</li> <li id="foot_krm_1095_06"><a href="#ref_krm_1095_06">↑</a> (१०२६)</li></ul></p>

प्सा|प्सायकः-यिका|प्सापकः-पिका|पिप्सासकः-सिका|पाप्सायकः-|यिका
<ul><li><sup id="ref_krm_1096_01"><a href="#foot_krm_1096_01">1</a></sup> {@“प्सा भक्षणे”@} <sup id="ref_krm_1096_02"><a href="#foot_krm_1096_02">2</a></sup> प्सायकः-यिका, प्सापकः-पिका, पिप्सासकः-सिका, पाप्सायकः- यिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि आदादिकदाप्-धातुवत् <sup id="ref_krm_1096_03"><a href="#foot_krm_1096_03">3</a></sup> <sup id="ref_krm_1096_04"><a href="#foot_krm_1096_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1096_05"><a href="#foot_krm_1096_05">5</a></sup> प्सापयन्-न्ती-ती, <sup id="ref_krm_1096_06"><a href="#foot_krm_1096_06">6</a></sup> <sup id="ref_krm_1096_07"><a href="#foot_krm_1096_07">7</a></sup> प्सातम्, इत्यस्माद् धातोः भवन्तीति विशेषः। </li> <li><sup id="ref_krm_1096_08"><a href="#foot_krm_1096_08">8</a></sup> प्सातिः, <sup id="ref_krm_1096_09"><a href="#foot_krm_1096_09">9</a></sup> प्रणिप्साता, <sup id="ref_krm_1096_10"><a href="#foot_krm_1096_10">10</a></sup> द्रप्सः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1096_01"><a href="#ref_krm_1096_01">↑</a> (१०८६)</li> <li id="foot_krm_1096_02"><a href="#ref_krm_1096_02">↑</a> (२-अदादिः-१०५५। सक। अनि। पर।)</li> <li id="foot_krm_1096_03"><a href="#ref_krm_1096_03">↑</a> (८३३)</li> <li id="foot_krm_1096_04"><a href="#ref_krm_1096_04">↑</a> [पृष्ठम्०९११+ २८]</li> <li id="foot_krm_1096_05"><a href="#ref_krm_1096_05">↑</a> [[१। ‘निगरणचलनार्थेभ्यः--’ (१-३-८७) इति ण्यन्तात् कर्तृगामिन्यपि क्रियाफले परस्मैपदमेव। तेन शानच् न।]]</li> <li id="foot_krm_1096_06"><a href="#ref_krm_1096_06">↑</a> [इदमेषां]</li> <li id="foot_krm_1096_07"><a href="#ref_krm_1096_07">↑</a> [[२। ‘क्तोऽधिकरणे च ध्रौव्यगतिप्रत्यवसानार्थेभ्यः’ (३-४-७६) इति अधिकरणे क्तप्रत्ययः। प्रत्यवसानार्थाः = भक्षणार्थकाः धातवः।]]</li> <li id="foot_krm_1096_08"><a href="#ref_krm_1096_08">↑</a> [[आ। ‘स्नान्त्यस्तदा श्राणमुपाश्य चान्नं निद्रां गताः प्सातिपरास्तथाऽन्याः।’ धा। का। २। ४९।]]</li> <li id="foot_krm_1096_09"><a href="#ref_krm_1096_09">↑</a> [[३। ‘नेर्गदनदपतपदघुमास्यतिहन्तियातिवातिद्रातिप्साति--’ (८-४-१७) इत्यादिना उपसर्गस्थान्निमित्तात् परस्य नेर्णत्वम्।]]</li> <li id="foot_krm_1096_10"><a href="#ref_krm_1096_10">↑</a> [[४। द्रवणेन प्सानीयो द्रप्सः। ‘घञर्थे कविधानम्--’ (वा। ३-३-५८) इति कप्रत्ययः। ‘आतो लोप इटि च’ (६-४-६४) इत्याकारलोपः। पृषोदरादित्वात् (६-३-१०९) द्रवणशब्दस्य द्रादेशः।]]</li></ul></p>

फक्क|फक्ककः-क्किका|पिफक्किषकः-षिका|पाफक्ककः-क्किका
<ul><li><sup id="ref_krm_1097_01"><a href="#foot_krm_1097_01">1</a></sup> {@“फक्क नीचैर्गतौ”@} <sup id="ref_krm_1097_02"><a href="#foot_krm_1097_02">2</a></sup> ‘नीचैर्गतिः = मन्दगमनम्, असद्व्यवहारो वा।’ इति क्षीरस्वामी। </li> <li>‘अधोगमनम्।’ इति केशवस्वामी। </li> <li>इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>फक्ककः-क्किका, फक्ककः-क्किका, पिफक्किषकः-षिका, पाफक्ककः-क्किका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकककतिवत् <sup id="ref_krm_1097_03"><a href="#foot_krm_1097_03">3</a></sup> ज्ञेयानि। </li> <li>फक्कन्- न्ती, इति शतरि रूपम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1097_01"><a href="#ref_krm_1097_01">↑</a> (१०८७)</li> <li id="foot_krm_1097_02"><a href="#ref_krm_1097_02">↑</a> (१-भ्वादिः-११६। सक। सेट्। पर।)</li> <li id="foot_krm_1097_03"><a href="#ref_krm_1097_03">↑</a> (१३९)</li></ul></p>

फण|फाणकः-णिका|फणकः-फाणकः-णिका|पिफणिषकः-षिका|पंफणकः-|पम्फणकः-णिका
<ul><li><sup id="ref_krm_1098_01"><a href="#foot_krm_1098_01">1</a></sup> {@“फण गतौ”@} <sup id="ref_krm_1098_02"><a href="#foot_krm_1098_02">2</a></sup> घटादिः। </li> <li>फाणकः-णिका, <sup id="ref_krm_1098_03"><a href="#foot_krm_1098_03">3</a></sup> फणकः-फाणकः-णिका, पिफणिषकः-षिका, पंफणकः- पम्फणकः-णिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककणतिवत् <sup id="ref_krm_1098_04"><a href="#foot_krm_1098_04">4</a></sup> <sup id="ref_krm_1098_05"><a href="#foot_krm_1098_05">5</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1098_06"><a href="#foot_krm_1098_06">6</a></sup> फाण्टः <sup id="ref_krm_1098_07"><a href="#foot_krm_1098_07">7</a></sup>, <sup id="ref_krm_1098_08"><a href="#foot_krm_1098_08">8</a></sup> फणितिः, <sup id="ref_krm_1098_09"><a href="#foot_krm_1098_09">9</a></sup> फेणिवान्-पेफणिवान्, <sup id="ref_krm_1098_10"><a href="#foot_krm_1098_10">10</a></sup> फणितः। </li> <li>इति इमानि रूपाणि अस्य धातोर्भवन्तीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1098_01"><a href="#ref_krm_1098_01">↑</a> (१०८८)</li> <li id="foot_krm_1098_02"><a href="#ref_krm_1098_02">↑</a> (१-भ्वादिः-८२१। सक। सेट्। पर।)</li> <li id="foot_krm_1098_03"><a href="#ref_krm_1098_03">↑</a> [[५। घटादित्वेन मित्त्वात् णौ, ‘मितां ह्रस्वः’ (६-४-९२) इति उपधाह्रस्वे रूपमेवम्। ‘फणेः पूर्वे घटादयः।’ इति मैत्रेय-क्षीरस्वाम्याद्युपात्तवचनानुसारेण फण- धातोर्घटादित्वं नेति ज्ञायते। तदानीं मित्त्वाभावात् फाणकः-णिका, इत्यादीन्येव रूपाणि। किञ्च, धातूनामनेकार्थकत्वात्, गत्यर्थकस्य फणधातोरेव घटादिषु पाठ इति ज्ञायते;\n\n  यतः ‘अन्यत्र फाणयति = घटं निःस्नेहयतीत्यर्थः।’ इति क्षीरस्वामी बभाण। ‘… फण-ण् निःस्नेहने--।’ इति कविकल्पद्रुम- (श्लो १७६) वाक्यमप्यत्र निःस्नेहनार्थेऽस्य धातोः प्रयोगेऽनुकूलम्।]]</li> <li id="foot_krm_1098_04"><a href="#ref_krm_1098_04">↑</a> (१५७)</li> <li id="foot_krm_1098_05"><a href="#ref_krm_1098_05">↑</a> [पृष्ठम्०९१२+ ३२]</li> <li id="foot_krm_1098_06"><a href="#ref_krm_1098_06">↑</a> [[१। ‘क्षुब्धस्वान्तध्वान्तलग्नम्लिष्टविरिब्धफाण्टबाढानि मन्थमनस्तमस्सक्ताविस्पष्टस्व- रानायासभृशेषु’ (७-२-१८) इत्यनेनास्य धातोर्निष्ठायाम्, अनायाससाध्यकषा- यविशेषश्चेत् प्रकृतिप्रत्ययसमुदायेनोच्यते तदानीमिडभावो निपात्यते। ‘अनुनासिकस्य क्विझलोः क्ङिति’ (६-४-१५) इति दीर्घः। पश्चात्, ‘ष्टुना ष्टुः’ (८-४-४१) इति ष्टुत्वेन निष्ठातकारस्य टकारः। अन्यत्र फणितमित्येव। ‘उष्णाम्बुन्यौषधं क्षुण्णं क्षिप्त्वा सद्योऽभिषुत्य च। पीयते यः कषायोऽसौ फाण्टोऽनायाससाधितः।।’ इति प्र। सर्वस्वे। माधवस्तु ‘तद्वै नवनीतं घृतं देवानाम्, फाण्टं मनुष्याणाम्--’ इति शतपथ- श्रुतिव्याख्यायाम् (३-१-३-८) ‘नवनीतं फाण्टघृतयोरन्तरालवर्ति’ इत्याह। तेन नवनीतभावात् प्रागवस्थापन्नं द्रव्यं फाण्टम् इति लभ्यते। धातुवृत्तौ तु ‘औषधस्य पञ्च कल्पनाः--रसः, कल्कः, शृतः, शीतः, क्वाथः। शीतो नाम क्षुण्णमौषधमुदके प्रक्षिप्य रात्रावधिवासितं यदुदकं प्रातः पीयते तत्। तदेवोष्णोदके प्रक्षिप्य सद्योऽभिषुत्य पूत्वा पीयते। स फाण्ट इति तद्विदः।’ इत्याह।]]</li> <li id="foot_krm_1098_07"><a href="#ref_krm_1098_07">↑</a> [[आ। ‘अम्लिष्टनादा निरगुः फाण्टचित्रास्त्रपाणयः।।’ भ। का। ९। १७।]]</li> <li id="foot_krm_1098_08"><a href="#ref_krm_1098_08">↑</a> [[२। क्तिनि, ‘तितुत्रेष्वग्रहादीनाम्--’ (वा। ७-२-९) इति वचनात् इडिति ज्ञेयम्। धातूनामनेकार्थकत्वाद् अत्र शब्दार्थकत्वमित्यपि ज्ञेयम्।]]</li> <li id="foot_krm_1098_09"><a href="#ref_krm_1098_09">↑</a> [[३। कर्तरि लिटः क्वसौ, ‘फणां च सप्तानाम्’ (६-४-१२५) इत्येत्वाभ्यासलोपविकल्पः। ‘वस्वेकाजाद्घसाम्’ (७-२-६७) इतीट्।]]</li> <li id="foot_krm_1098_10"><a href="#ref_krm_1098_10">↑</a> [[B। ‘दुष्टानपस्खादयितुं प्रयाते कृष्णे विलेपुः फणिता विमोहम्।।’ धा। का। २। १९।]]</li></ul></p>

फल|फालकः-लिका|पिफलिषकः-षिका|पाफलकः-लिका
<ul><li><sup id="ref_krm_1099_01"><a href="#foot_krm_1099_01">1</a></sup> {@“फल निष्पत्तौ”@} <sup id="ref_krm_1099_02"><a href="#foot_krm_1099_02">2</a></sup> ‘निष्पत्तिः = सिद्धिः।’ इति क्षीरस्वामी। </li> <li>‘फलेर्विशरणे फुल्लं फलितं फलति त्रयम्।। </li> <li>आदितो, ऽनादितस्त्वन्त्ये रूपे निष्पत्तिवाचिनः।’ <sup id="ref_krm_1099_03"><a href="#foot_krm_1099_03">3</a></sup> इति देवः। </li> <li>फालकः-लिका, फालकः-लिका, पिफलिषकः-षिका, पाफलकः-लिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककलतिवत् <sup id="ref_krm_1099_04"><a href="#foot_krm_1099_04">4</a></sup> ज्ञेयानि। </li> <li>फलितम्, <sup id="ref_krm_1099_05"><a href="#foot_krm_1099_05">5</a></sup> फलम्, <sup id="ref_krm_1099_06"><a href="#foot_krm_1099_06">6</a></sup> त्रिफला, <sup id="ref_krm_1099_07"><a href="#foot_krm_1099_07">7</a></sup> संफला-भस्त्रफला-अजिनफला-शणफला-पिण्डफला, <sup id="ref_krm_1099_08"><a href="#foot_krm_1099_08">8</a></sup> <sup id="ref_krm_1099_09"><a href="#foot_krm_1099_09">9</a></sup> फालः, <sup id="ref_krm_1099_10"><a href="#foot_krm_1099_10">10</a></sup> दासीफली इति रूपाण्यस्य भवन्तीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1099_01"><a href="#ref_krm_1099_01">↑</a> (१०८९)</li> <li id="foot_krm_1099_02"><a href="#ref_krm_1099_02">↑</a> (१-भ्वादिः-५३०। अक। सेट्। पर।)</li> <li id="foot_krm_1099_03"><a href="#ref_krm_1099_03">↑</a> (श्लो। १५८-१५९)</li> <li id="foot_krm_1099_04"><a href="#ref_krm_1099_04">↑</a> (१७४)</li> <li id="foot_krm_1099_05"><a href="#ref_krm_1099_05">↑</a> [[४। फलतीति फलम्, कर्तरि पचादित्वादच्। लोकप्रयोगात् क्लीबत्वम्।]]</li> <li id="foot_krm_1099_06"><a href="#ref_krm_1099_06">↑</a> [[५। अजादिषु (४-१-४) दर्शनात् स्त्रियां टाप् भवति। ङीषपवादः।]]</li> <li id="foot_krm_1099_07"><a href="#ref_krm_1099_07">↑</a> [[६। ‘पाककर्णपर्णपुष्पफल--’ (४-१-६४) इति प्राप्तं ङीषे बाधित्वा, ‘संभस्त्राजिनशण- पिण्डेभ्यः फलात्’ (ग। सू। ४-१-४) इति टाप्। भस्त्रफला इत्यत्र ‘ङ्यापोः संज्ञाच्छन्दसोर्बहुलम्’ (६-३-६३) इति ह्रस्वः।]]</li> <li id="foot_krm_1099_08"><a href="#ref_krm_1099_08">↑</a> [पृष्ठम्०९१३+ २८]</li> <li id="foot_krm_1099_09"><a href="#ref_krm_1099_09">↑</a> [[१। ‘हलश्च’ (३-३-१२१) इति संज्ञायां घञ्। फल्यते = निष्पाद्यतेऽनेन धान्यादिकमिति फालः = हलः।]]</li> <li id="foot_krm_1099_10"><a href="#ref_krm_1099_10">↑</a> [[२। ‘पाककर्णपर्णपुष्पफलमूल--’ (४-१-६४) इति जातिवाचिनः फलोत्तरपदादस्मात् स्त्रियां ङीष्।]]</li></ul></p>

ञि|फालकः-लिका|पिफलिषकः-षिका|पम्फुलकः-पंफुलकः-लिका|फलिता-त्री|फालयिता-त्री|पिफलिषिता-त्री|पम्फुलिता-त्री|फलन्-न्ती|फालयन्-न्ती|पिफलिषन्-न्ती|-|फलिष्यन्-न्ती-ती|फालयिष्यन्-न्ती-ती|पिफलिषिष्यन्-न्ती-ती|फालयमानः|फालयिष्यमाणः|पम्फुल्यमानः|पम्फुलिष्यमाणः|फल्-फलौ-फलः|-फुल्लः-फुल्लवान्|प्रफुल्तम्-प्रफुल्तः-प्रफुल्तवान्|फलितम्-फलितवान्|उत्फुल्लः-उत्फुल्लवान्|सम्फुल्लः-सम्फुल्लवान्|फालितः|पिफलिषितः|पम्फुलितः-तवान्|फलम्|फेलिवान्|फालः|पिफलिषुः|पम्फुलः|फलितव्यम्|फालयितव्यम्|पिफलिषितव्यम्|पम्फुलितव्यम्|प्रतिफलनीयम्|फालनीयम्|पिफलिषणीयम्|पम्फुलनीयम्|फाल्यम्|पिफलिष्यम्|पम्फुल्यम्|ईषत्फलः-दुष्फलः-सुफलः|फल्यमानः|फाल्यमानः|पिफलिष्यमाणः|पिफलिषः|फलितुम्|फालयितुम्|पिफलिषितुम्|पम्फुलितुम्|फुल्तिः|फालना|पिफलिषा|पम्फुला|फलनम्|फालनम्|पिफलिषणम्|पम्फुलनम्|फलित्वा|फालयित्वा|पिफलिषित्वा|पम्फुलित्वा|प्रफल्य|प्रफाल्य|प्रपिफलिष्य|प्रपम्फुल्य|फालम्|पिफलिषम्|पम्फुलम्
<ul><li><sup id="ref_krm_1100_01"><a href="#foot_krm_1100_01">1</a></sup> {@“ञि फला विशरणे”@} <sup id="ref_krm_1100_02"><a href="#foot_krm_1100_02">2</a></sup> ‘विशरणम् = विकसनम्।’ इति धा। </li> <li>का। </li> <li>व्याख्यायाम् <sup id="ref_krm_1100_03"><a href="#foot_krm_1100_03">3</a></sup>। </li> <li>‘फलेर्विशरणे फुल्लम्, फलितम्, फलति त्रयम्।। </li> <li>आदितो, ऽनादितस्त्वन्त्ये रूपे निष्पत्तिवाचिनः।’ <sup id="ref_krm_1100_04"><a href="#foot_krm_1100_04">4</a></sup> इति देवः। </li> <li>फालकः-लिका, फालकः-लिका, पिफलिषकः-षिका, <sup id="ref_krm_1100_05"><a href="#foot_krm_1100_05">5</a></sup> पम्फुलकः-पंफुलकः-लिका;</li> <li>  फलिता-त्री, फालयिता-त्री, पिफलिषिता-त्री, पम्फुलिता-त्री;</li> <li>  फलन्-न्ती, फालयन्-न्ती, पिफलिषन्-न्ती;</li> <li>  -- फलिष्यन्-न्ती-ती, फालयिष्यन्-न्ती-ती, पिफलिषिष्यन्-न्ती-ती;</li> <li>  -- -- फालयमानः, फालयिष्यमाणः, -- पम्फुल्यमानः, पम्फुलिष्यमाणः;</li> <li>  <sup id="ref_krm_1100_06"><a href="#foot_krm_1100_06">6</a></sup> फल्-फलौ-फलः;</li> <li>  -- -- -- <sup id="ref_krm_1100_07"><a href="#foot_krm_1100_07">7</a></sup> फुल्लः- <sup id="ref_krm_1100_08"><a href="#foot_krm_1100_08">8</a></sup> फुल्लवान्, <sup id="ref_krm_1100_09"><a href="#foot_krm_1100_09">9</a></sup> प्रफुल्तम्-प्रफुल्तः-प्रफुल्तवान्, <sup id="ref_krm_1100_10"><a href="#foot_krm_1100_10">10</a></sup> फलितम्-फलितवान्, <sup id="ref_krm_1100_11"><a href="#foot_krm_1100_11">11</a></sup> उत्फुल्लः- <sup id="ref_krm_1100_12"><a href="#foot_krm_1100_12">12</a></sup> उत्फुल्लवान्, सम्फुल्लः-सम्फुल्लवान्, फालितः, पिफलिषितः, पम्फुलितः-तवान्;</li> <li>  फलम्, <sup id="ref_krm_1100_13"><a href="#foot_krm_1100_13">13</a></sup> फेलिवान्, फालः, पिफलिषुः, पम्फुलः;</li> <li>  फलितव्यम्, फालयितव्यम्, पिफलिषितव्यम्, पम्फुलितव्यम्;</li> <li>  प्रतिफलनीयम्, फालनीयम्, पिफलिषणीयम्, पम्फुलनीयम्;</li> <li>  फाल्यम्, फाल्यम्, पिफलिष्यम्, पम्फुल्यम्;</li> <li>  ईषत्फलः-दुष्फलः-सुफलः;</li> <li>  -- -- फल्यमानः, फाल्यमानः, पिफलिष्यमाणः, <sup id="ref_krm_1100_14"><a href="#foot_krm_1100_14">14</a></sup> पम्फुल्यमानः;</li> <li>  फालः, फालः, पिफलिषः, पम्फुलः;</li> <li>  फलितुम्, फालयितुम्, पिफलिषितुम्, पम्फुलितुम्;</li> <li>  <sup id="ref_krm_1100_15"><a href="#foot_krm_1100_15">15</a></sup> फुल्तिः, फालना, पिफलिषा, पम्फुला;</li> <li>  फलनम्, फालनम्, पिफलिषणम्, पम्फुलनम्;</li> <li>  फलित्वा, फालयित्वा, पिफलिषित्वा, पम्फुलित्वा;</li> <li>  प्रफल्य, प्रफाल्य, प्रपिफलिष्य, प्रपम्फुल्य;</li> <li>  फालम् २, फलित्वा २, फालम् २, फालयित्वा २, पिफलिषम् २, पिफलिषित्वा २, पम्फुलम् २;</li> <li>  पम्फुलित्वा २;</li> <li>  <sup id="ref_krm_1100_16"><a href="#foot_krm_1100_16">16</a></sup> फल्गुः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1100_01"><a href="#ref_krm_1100_01">↑</a> (१०९०)</li> <li id="foot_krm_1100_02"><a href="#ref_krm_1100_02">↑</a> (१-भ्वादिः-५१६। अक। सेट्। पर।)</li> <li id="foot_krm_1100_03"><a href="#ref_krm_1100_03">↑</a> (१-६६)</li> <li id="foot_krm_1100_04"><a href="#ref_krm_1100_04">↑</a> (श्लो। १५८-१५९)</li> <li id="foot_krm_1100_05"><a href="#ref_krm_1100_05">↑</a> [[३। यङन्ताण्ण्वुलि द्वित्वादिके कृते, ‘उत् परस्यातः’ (७-४-८८) इति उत्तरखण्डस्थाकार- स्योकारे, परसवर्णविकल्पे च रूपद्वयम्। एवं यङन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_1100_06"><a href="#ref_krm_1100_06">↑</a> [[४। ‘न पदान्ताः परेऽणः सन्ति।’ इति वचनं तु भाष्यासम्मतमिति, लकारन्तस्यास्य प्रयोग उपपन्तः।]]</li> <li id="foot_krm_1100_07"><a href="#ref_krm_1100_07">↑</a> [[५। निष्ठायाम्, ‘आदितश्च’ (७-२-१६) इति इण्निषेधे, ‘अनुवसर्गात् फुल्लक्षीब--’ (८-२-५५) इत्यत्र निपातनात् निष्ठातकारस्य लकारः, प्रकृतिघटिताकारस्योत्वं च। यद्वा, लत्वस्यासिद्धत्वेन तकारादिप्रत्ययपरकत्वात्, ‘ति च’ (७-४-८९) इत्युत्वमिति ज्ञेयम्।]]</li> <li id="foot_krm_1100_08"><a href="#ref_krm_1100_08">↑</a> [[६। ‘क्तवतोरप्येतल्लत्वमिष्यते।’ इति वृत्तिः। तन्मते फुल्लवान् इत्यपि साधुः।]]</li> <li id="foot_krm_1100_09"><a href="#ref_krm_1100_09">↑</a> [[७। अनुपसर्गादेव लत्वस्य निपातनात्, सोपसृष्टात् इण्निषेधे, उत्वे च रूपमेवम्। प्रफुल्लम् इति तु ‘फुल्ल विकसने’ इत्यस्मात् पचाद्यचि ज्ञेयम्।]]</li> <li id="foot_krm_1100_10"><a href="#ref_krm_1100_10">↑</a> [[८। ‘विभाषा भावादिकर्मणोः’ (७-२-१७) इति भावे, आदिकर्मणि च या निष्ठा, तत्र विषये इण्निषेधस्य विकल्पनात् फलितम् इत्यपि साधुरिति ज्ञेयम्।]]</li> <li id="foot_krm_1100_11"><a href="#ref_krm_1100_11">↑</a> [[९। ‘उत्फुल्लसम्फुल्लयोरुपसंख्यानम्’ (वा। ८-२-५५) इति वचनादत्रापि निण्ठातकारस्य लत्वमिति ज्ञेयम्। क्तवत्वन्तस्यापीदं लत्वमिति वृत्तिकारेष्टेः तत्रापि लत्वम्।]]</li> <li id="foot_krm_1100_12"><a href="#ref_krm_1100_12">↑</a> [पृष्ठम्०९१४+ २६]</li> <li id="foot_krm_1100_13"><a href="#ref_krm_1100_13">↑</a> [[१। कर्तरि, लिटः क्वसौ, ‘तॄफलभजत्रपश्च’ (६-४-१२२) इत्येत्वाभ्यासलोपे, ‘वस्वे- काजाद्घसाम्’ (७-२-६७) इतीडागमे च रूपम्।]]</li> <li id="foot_krm_1100_14"><a href="#ref_krm_1100_14">↑</a> [[२। यङन्तात् यकि, ‘हलो यमां यमि लोपः’ (८-४-६४) इति यङो यकारस्य विकल्पेन लोपः। लोपाभावपक्षे तु ‘फम्फुल्य्यमानः’ इत्यपि साधुः। एवं यङन्तात् ल्यप्यपि ज्ञेयम्।]]</li> <li id="foot_krm_1100_15"><a href="#ref_krm_1100_15">↑</a> [[३। क्तिनि, इण्निषेधे, ‘ति च’ (७-४-८९) इत्युत्वे रूपमेवम्।]]</li> <li id="foot_krm_1100_16"><a href="#ref_krm_1100_16">↑</a> [[४। ‘फलिपाटि--’ (द। उ। १-१०३) इत्युप्रत्यये गुगागमे च रूपम्। फल्गुः = असारः।]]</li></ul></p>

फुल|फोलकः-लिका|पुफुलिषकः-षिका|पोफुलकः-लिका
