<ul><li><sup id="ref_krm_0533_01"><a href="#foot_krm_0533_01">1</a></sup> {@“चिति स्मृत्याम्”@} <sup id="ref_krm_0533_02"><a href="#foot_krm_0533_02">2</a></sup> ‘-- -- चिन्तयेत्। </li> <li>स्मृत्याम्, चेतति संज्ञाने, तत्र चेतयते णिचि।।’ <sup id="ref_krm_0533_03"><a href="#foot_krm_0533_03">3</a></sup> इति देवः। </li> <li>इदित्करणात् णिचो वैकल्पिकत्वम्। </li> <li><sup id="ref_krm_0533_04"><a href="#foot_krm_0533_04">4</a></sup> चिन्तकः-न्तिका, चिचिन्तयिषकः-षिका, <sup id="ref_krm_0533_05"><a href="#foot_krm_0533_05">5</a></sup> चिन्तकः-न्तिका, चिचिन्तिषकः-षिका, चेचिन्तकः-न्तिका;</li> <li>  चिन्तयिता-त्री, चिचिन्तयिषिता-त्री, चिन्तिता-त्री, चिचिन्तिषिता-त्री, चेचिन्तिता-त्री;</li> <li>  <sup id="ref_krm_0533_06"><a href="#foot_krm_0533_06">6</a></sup> चिन्तयन्-न्ती, चिचिन्तयिषन्-न्ती, <sup id="ref_krm_0533_07"><a href="#foot_krm_0533_07">7</a></sup> चिन्तन् <sup id="ref_krm_0533_08"><a href="#foot_krm_0533_08">8</a></sup> -न्ती, चिचिन्तिषन्-न्ती;</li> <li>  -- चिन्तयिष्यन्-न्ती-ती, चिचिन्तयिषिष्यन्-न्ती-ती, चिन्तिष्यन्-न्ती-ती;</li> <li>  चिचिन्तिषिष्यन्-न्ती-ती;</li> <li>  -- चिन्तयमानः, चिचिन्तयिषमाणः--चेचिन्त्यमानः;</li> <li>  चिन्तयिष्यमाणः चिचिन्तयिषिष्यमाणः--चेचिन्तिष्यमाणः;</li> <li>  <sup id="ref_krm_0533_09"><a href="#foot_krm_0533_09">9</a></sup> चिन्-चिन्तौ-चिन्तः;</li> <li>  -- -- -- चिन्तितम्-तः, चिचिन्तयिषितः, चिन्तितः, चिचिन्तिषितः, चेचिन्तितः-तवान्;</li> <li>  चिन्तः, चिचिन्तयिषुः, चिन्तः, चिचिन्तिषुः, चेचिन्तः;</li> <li>  चिन्तयितव्यम्, चिचिन्तयिषितव्यम्, चिन्तितव्यम्, चिचिन्तिषितव्यम्, चेचिन्तितव्यम्;</li> <li>  चिन्तनीयम्, चिचिन्तयिषणीयम्, चिन्तनीयम्, चिचिन्तिषणीयम्, चेचिन्तनीयम्;</li> <li>  चिन्त्यम्, चिचिन्तयिष्यम्, चिन्त्यम्, चिचिन्तिष्यम्, चेचिन्त्यम्;</li> <li>  ईषच्चिन्तः-दुश्चिन्तः-सुचिन्तः;</li> <li>  -- -- चिन्त्यमानः, चिचिन्तयिष्यमाणः, चिन्त्यमानः चिचिन्तिष्यमाणः, चेचिन्त्यमानः;</li> <li>  चिन्तः, चिचिन्तयिषः, चिन्तः, चिचिन्तिषः, चेचिन्तः;</li> <li>  चिन्तयितुम्, चिचिन्तयिषितुम्, चिन्तितुम्, चिचिन्तिषितुम्, चेचिन्तितुम्;</li> <li>  <sup id="ref_krm_0533_10"><a href="#foot_krm_0533_10">10</a></sup> चिन्ता, <sup id="ref_krm_0533_11"><a href="#foot_krm_0533_11">11</a></sup> चिन्तना, <sup id="ref_krm_0533_12"><a href="#foot_krm_0533_12">12</a></sup> चिचिन्तयिषा, चिन्ता, चिचिन्तिषा, चेचिन्ता;</li> <li>  चिन्तनम्, चिचिन्तयिषणम्, चिन्तनम्, चिचिन्तिषणम्, चेचिन्तनम्;</li> <li>  चिन्तयित्वा, चिचिन्तयिषित्वा, चिन्तित्वा, चिचिन्तिषित्वा, चेचिन्तित्वा;</li> <li>  विचिन्त्य, विचिचिन्तयिष्य, विचिन्त्य, विचिचिन्तिष्य, विचेचिन्त्य;</li> <li>  <sup id="ref_krm_0533_13"><a href="#foot_krm_0533_13">13</a></sup> चन्तम् २ चिन्तयित्वा २, चिचिन्तयिषम् २, चिचिन्तयिषित्वा २, चिन्तम् २, चिन्तित्वा २, चिचिन्तिषम् २, चिचिन्तिषित्वा २, चेचिन्तम् २;</li> <li>  चेचिन्तिवा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0533_01"><a href="#ref_krm_0533_01">↑</a> (५२३)</li> <li id="foot_krm_0533_02"><a href="#ref_krm_0533_02">↑</a> (१०-चुरादिः-१५३५। सक। सेट्। उभ।)</li> <li id="foot_krm_0533_03"><a href="#ref_krm_0533_03">↑</a> (श्लो। ९४)</li> <li id="foot_krm_0533_04"><a href="#ref_krm_0533_04">↑</a> [[४। धातोरिदित्त्वात्, ‘इदितो नुम् धातोः’ (७-१-५८) इति नुमि, ‘णेरनिटि’ (६-४-५१) इति णिलोपे रूपम्। एवं ण्यन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0533_05"><a href="#ref_krm_0533_05">↑</a> [[५। इदित्करणाण्णिचो वैकल्पिकत्वम्। तेन णिजभावपक्षे, शुद्धाद्धातोः, सन्नन्तात्, यङन्ताच्च रूपाणि प्रदर्शितानि।]]</li> <li id="foot_krm_0533_06"><a href="#ref_krm_0533_06">↑</a> [पृष्ठम्०५०८+ २३]</li> <li id="foot_krm_0533_07"><a href="#ref_krm_0533_07">↑</a> [[१। णिजभावपक्षे, शुद्धाद्धातोः, ‘शेषात् कर्तरि--’ (१-३-७८) इति शतैव।]]</li> <li id="foot_krm_0533_08"><a href="#ref_krm_0533_08">↑</a> [[आ। ‘सञ्चोरयन्तमरिगर्वमशेषभद्रं चिन्तन्तमन्तकमिवाप्तमयन्त्र्यवीर्यम्।’ धा। का। ३-१३।]]</li> <li id="foot_krm_0533_09"><a href="#ref_krm_0533_09">↑</a> [[२। संयोगान्तलोपे रूपम्। न च नलोपः शङ्क्यः;\n\n  संयोगान्तलोपस्यासिद्धत्वात्।]]</li> <li id="foot_krm_0533_10"><a href="#ref_krm_0533_10">↑</a> [[३। ‘चिन्तिपूजिकथिकुम्बिचर्चश्च’ (३-३-१०५) इति अङ्। युजपवादः।]]</li> <li id="foot_krm_0533_11"><a href="#ref_krm_0533_11">↑</a> [[B। ‘चिन्तावन्तः कथां चकुरुपधामेदभीरवः।’ भ। का। ७। ७२।]]</li> <li id="foot_krm_0533_12"><a href="#ref_krm_0533_12">↑</a> [[४। ‘चिन्तिपूजि’ (३-३-१०५) इति सूत्रे चकारस्यानुक्तसमुच्चयार्थकत्वेन कदाचित् युजपि भवति। तेन चिन्तना इत्यपि साधुरिति काशिका।]]</li> <li id="foot_krm_0533_13"><a href="#ref_krm_0533_13">↑</a> [पृष्ठम्०५०९+ २२]</li></ul></p>

