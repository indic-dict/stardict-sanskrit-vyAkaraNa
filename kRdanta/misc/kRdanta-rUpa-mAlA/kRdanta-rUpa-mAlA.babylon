काशनम्, काशनम्, चिकाशिषणम्, चाकाशनम्;</li> <li>  काशित्वा, काशयित्वा, चिकाशिषित्वा, चाकाशित्वा;</li> <li>  प्रकाश्य, संकाश्य, प्रचिकाशिष्य, प्रचाकाश्य;</li> <li>  काशम् २, काशित्वा २, काशम् २, काशयित्वा २, चिकाशिषम् २, चिकाशिषित्वा २, चाकाशम् २;</li> <li>  चाकाशित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0191_01"><a href="#ref_krm_0191_01">↑</a> (१८६)</li> <li id="foot_krm_0191_02"><a href="#ref_krm_0191_02">↑</a> (१-भ्वादिः-६४७। अक। सेट्। आत्म।)</li> <li id="foot_krm_0191_03"><a href="#ref_krm_0191_03">↑</a> (श्लो। १६५)</li> <li id="foot_krm_0191_04"><a href="#ref_krm_0191_04">↑</a> [[आ। ‘मनोनिवृत्तिः परमोपशान्तिः सा तीर्थवर्या मणिकर्णिका वै। ज्ञानप्रवाहा विमला हि गङ्गा सा काशिकाऽहं निजबोधरूपः।।’ इति पारिभाषिककाशिकायाः लक्षणमुक्तं शङ्कराचार्येण।’ इति शब्दकल्पद्रुमे।]]</li> <li id="foot_krm_0191_05"><a href="#ref_krm_0191_05">↑</a> [[१। ‘संज्ञायाम्’ (३-३-१०९) इति भावे ण्वुल्। ण्वुलन्तात् टाप्। अत इत्त्वम्। काशिका = वामन-जयादित्यकृता पाणिनिसूत्रवृत्तिः। काश्यां विरचनाद्वा काशिका।]]</li> <li id="foot_krm_0191_06"><a href="#ref_krm_0191_06">↑</a> [[२। ‘व्रश्चभ्रस्ज--’ (८-२-३६) इति षत्वम्। जश्त्वचर्त्वे।]]</li> <li id="foot_krm_0191_07"><a href="#ref_krm_0191_07">↑</a> [[३। काशते इति काशी। पचाद्यजन्तात् गौरादि (४-१-४१) पाठात् ङीष्।]]</li> <li id="foot_krm_0191_08"><a href="#ref_krm_0191_08">↑</a> [[४। ‘इकः काशे’ (६-३-१२३) इति उपसर्गस्य दीर्घः।]]</li> <li id="foot_krm_0191_09"><a href="#ref_krm_0191_09">↑</a> [[B। ‘तापिञ्छनीकाशरुचि प्रतीचि स्ववैरिमर्माविधि पुंसि रागात्।’ वा। वि। ३-२१।]]</li> <li id="foot_krm_0191_10"><a href="#ref_krm_0191_10">↑</a> [[५। ‘सुप्यजातौ णिनिस्ताच्छील्ये’ (३-२-७८) इति णिनिः। जितेन = जयेन काशते इति जितकाशी = जययुक्तः।]]</li> <li id="foot_krm_0191_11"><a href="#ref_krm_0191_11">↑</a> [[६। ‘अनुदात्तेतश्च हलादेः’ (३-२-१४९) इति ताच्छीलिको युच्।]]</li> <li id="foot_krm_0191_12"><a href="#ref_krm_0191_12">↑</a> [[७। ‘शेषे विभाषाऽकखादावषान्त उपदेशे’ (८-४-१८) इति णत्वं न;\n\n  ‘अकखादा’ वित्युक्तेः।]]</li> <li id="foot_krm_0191_13"><a href="#ref_krm_0191_13">↑</a> [पृष्ठम्०१८२+ २५]</li> <li id="foot_krm_0191_14"><a href="#ref_krm_0191_14">↑</a> [[आ। ‘द्राहितः शुभपथप्रकाशने सस्वजेऽथ तमनूह्यवैभवः।’ धा। का। १-८२।]]</li></ul></p>

काशृ
<ul><li><sup id="ref_krm_0192_01"><a href="#foot_krm_0192_01">1</a></sup> {@“काशृ दीप्तौ”@} <sup id="ref_krm_0192_02"><a href="#foot_krm_0192_02">2</a></sup> ‘--काशेः दीप्तौ काश्येत काशते।’ <sup id="ref_krm_0192_03"><a href="#foot_krm_0192_03">3</a></sup> इति देवः। </li> <li>काश्यमानः, काशिष्यमाणः, काशयमानः, काशयिष्यमाणः, चिकाशिषमाणः, चिकाशिषिष्यमाणः, चाकाश्यमानः, चाकाशिष्यमाणः, इति शानचि रूपाणि। </li> <li>अन्यानि सर्वाणि रूपाणि भौवादिककाशृधातुवत् <sup id="ref_krm_0192_04"><a href="#foot_krm_0192_04">4</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0192_01"><a href="#ref_krm_0192_01">↑</a> (१८७)</li> <li id="foot_krm_0192_02"><a href="#ref_krm_0192_02">↑</a> (४-दिवादिः-११६२। सक। सेट्। आत्म।)</li> <li id="foot_krm_0192_03"><a href="#ref_krm_0192_03">↑</a> (श्लो। १६५)</li> <li id="foot_krm_0192_04"><a href="#ref_krm_0192_04">↑</a> (१८६)</li></ul></p>

