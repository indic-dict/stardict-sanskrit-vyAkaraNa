<ul><li><sup id="ref_krm_0982_01"><a href="#foot_krm_0982_01">1</a></sup> {@“पद गतौ”@} <sup id="ref_krm_0982_02"><a href="#foot_krm_0982_02">2</a></sup> ‘पदॢ--’ इति पुरुषकारसम्मतः पाठः। </li> <li>‘--श्यनि गत्यर्थे पद्यते पदयेत णौ।।’ <sup id="ref_krm_0982_03"><a href="#foot_krm_0982_03">3</a></sup> इति देवः। </li> <li>पादकः-दिका, पादकः-दिका, <sup id="ref_krm_0982_04"><a href="#foot_krm_0982_04">4</a></sup> पित्सकः-त्सिका, <sup id="ref_krm_0982_05"><a href="#foot_krm_0982_05">5</a></sup> पनीपदकः-दिका;</li> <li>  पत्ता-पत्त्री, पादयिता-त्री, पित्सिता-त्री, पनीपदिता-त्री;</li> <li>  -- पादयन्-न्ती, पादयिष्यन्-न्ती-ती;</li> <li>  -- -- <sup id="ref_krm_0982_06"><a href="#foot_krm_0982_06">6</a></sup> प्रणिपद्यमानः, पादयमानः, पित्समानः, पनीपद्यमानः;</li> <li>  पत्स्यमानः, पादयिष्यमाणः, पित्सिष्यमाणः, पनीपदिष्यमाणः;</li> <li>  <sup id="ref_krm_0982_07"><a href="#foot_krm_0982_07">7</a></sup> पत्-पद्-पदौ-पदः;</li> <li>  -- -- -- <sup id="ref_krm_0982_08"><a href="#foot_krm_0982_08">8</a></sup> प्रपन्नः-पन्नवान्, पादितः, पित्सितः, पनीपदितः-तवान्;</li> <li>  पदः, <sup id="ref_krm_0982_09"><a href="#foot_krm_0982_09">9</a></sup> उत्पदिष्णुः, <sup id="ref_krm_0982_10"><a href="#foot_krm_0982_10">10</a></sup> पदनः, <sup id="ref_krm_0982_11"><a href="#foot_krm_0982_11">11</a></sup> पादुकः- <sup id="ref_krm_0982_12"><a href="#foot_krm_0982_12">12</a></sup> पादुका, <sup id="ref_krm_0982_13"><a href="#foot_krm_0982_13">13</a></sup> पादः, <sup id="ref_krm_0982_14"><a href="#foot_krm_0982_14">14</a></sup> सम्पद्यः, <sup id="ref_krm_0982_15"><a href="#foot_krm_0982_15">15</a></sup> सम्पादी, <sup id="ref_krm_0982_16"><a href="#foot_krm_0982_16">16</a></sup> प्रणिपेदिवान्, <sup id="ref_krm_0982_17"><a href="#foot_krm_0982_17">17</a></sup> पादः, पित्सुः, पनीपदः;</li> <li>  पत्तव्यम्, पादयितव्यम्, पित्सितव्यम्, पनीपदितव्यम्;</li> <li>  पदनीयम्, पादनीयम्, पित्सनीयम्, पनीपदनीयम्;</li> <li>  पाद्यम्, पाद्यम्, पित्स्यम्, पनीपद्यम्;</li> <li>  ईषत्पदः-दुष्पदः-सुपदः;</li> <li>  -- -- -- पद्यमानः, पाद्यमानः, पित्स्यमानः, पनीपद्यमानः;</li> <li>  पादः, <sup id="ref_krm_0982_18"><a href="#foot_krm_0982_18">18</a></sup> पदम्, <sup id="ref_krm_0982_19"><a href="#foot_krm_0982_19">19</a></sup> आस्पदम्, <sup id="ref_krm_0982_20"><a href="#foot_krm_0982_20">20</a></sup> <sup id="ref_krm_0982_21"><a href="#foot_krm_0982_21">21</a></sup> गोष्पदम्, पादः, पित्सः, पनीपदः;</li> <li>  पत्तुम्, पादयितुम्, पित्सितुम्, पनीपदितुम्;</li> <li>  <sup id="ref_krm_0982_22"><a href="#foot_krm_0982_22">22</a></sup> सम्पत्-सम्पत्तिः, विपत्-प्रतिपत्-आपत्, <sup id="ref_krm_0982_23"><a href="#foot_krm_0982_23">23</a></sup> पद्या, पादना, पित्सा, पनीपदा;</li> <li>  पदनम्, आपादनम्, पित्सनम्, पनीपदनम्;</li> <li>  पत्त्वा, पादयित्वा, पित्सित्वा, पनीपदित्वा;</li> <li>  प्रणिपद्य, सम्पाद्य, प्रपित्स्य, प्रपनीपद्य;</li> <li>  <sup id="ref_krm_0982_24"><a href="#foot_krm_0982_24">24</a></sup> <sup id="ref_krm_0982_25"><a href="#foot_krm_0982_25">25</a></sup> गेहानुप्रपादम्, गेहंगेहमनुप्रपादम्, गेहमनुप्रपादमनुप्रपादमास्ते;</li> <li>  पादम् २, पत्त्वा २, पादम् २, पादयित्वा २, पित्सम् २, पित्सित्वा २, पनीपदम् २;</li> <li>  पनीपदित्वा २;</li> <li>  <sup id="ref_krm_0982_26"><a href="#foot_krm_0982_26">26</a></sup> इत्यूप्रत्ययः, प्रत्ययस्य णित्त्वं च। </li> <li>पद्यते इति पादूः = पादुका। </li> <li>‘पादुका’ इत्यत्र संज्ञायां कनि, ‘केऽणः’ <sup id="ref_krm_0982_27"><a href="#foot_krm_0982_27">27</a></sup> इति ह्रस्वो ज्ञेयः।]] पादूः, <sup id="ref_krm_0982_28"><a href="#foot_krm_0982_28">28</a></sup> मन्प्रत्यये रूपम्। </li> <li>पद्यते मधुकरैरिति पद्मम् = कमलम्। </li> <li>अर्शआद्यजन्ते मत्वर्थीये पद्मा = लक्ष्मीः। </li> <li>मत्वर्थीय एव इनिप्रत्यये पद्मिनी इति च।]] पद्मम्-पद्मिनी।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0982_01"><a href="#ref_krm_0982_01">↑</a> (९७२)</li> <li id="foot_krm_0982_02"><a href="#ref_krm_0982_02">↑</a> (४-दिवादिः-११६९। सक। अनि। आत्म।)</li> <li id="foot_krm_0982_03"><a href="#ref_krm_0982_03">↑</a> (श्लो। १०९)</li> <li id="foot_krm_0982_04"><a href="#ref_krm_0982_04">↑</a> [[१। ‘सनि मीमाघुरभलभशकपतपदामच इस्’ (७-४-५४) इति सन्नन्ते सर्वत्र इस्। ‘अत्र लोपोऽभ्यासस्य’ (७-४-५८) इत्यभ्यासलोपः। ‘स्कोः संयोगाद्योरन्ते च’ (८-२-२९) इति सकारलोपः। ‘इको झल्’ (१-२-९) इति सनः कित्त्वम्। ‘खरि च’ (८-४-५५) इति दकारस्य चर्त्वं भवति।]]</li> <li id="foot_krm_0982_05"><a href="#ref_krm_0982_05">↑</a> [[२। यङन्ताण्ण्वुलि, ‘नीग् वञ्चुस्रंसुध्वंसुभ्रंसुकसपतपदस्कन्दाम्’ (७-४-८४) इत्यभ्यासस्य नीगागमः। अभ्यासदीर्घापवादः। एवं यङन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0982_06"><a href="#ref_krm_0982_06">↑</a> [[३। ‘नेर्गदनदपतपद--’ (८-४-१७) इत्यादिना नेर्णत्वम्।]]</li> <li id="foot_krm_0982_07"><a href="#ref_krm_0982_07">↑</a> [[४। पद्यतेऽनेनेति पत् = पादः। क्विबन्ते चर्त्वविकल्पः।]]</li> <li id="foot_krm_0982_08"><a href="#ref_krm_0982_08">↑</a> [[५। ‘रदाभ्यां निष्ठातो नः पूर्वस्य च दः’ (८-२-४२) इति निष्ठातकारधातुदकारयोर्नत्वे रूपम्।]]</li> <li id="foot_krm_0982_09"><a href="#ref_krm_0982_09">↑</a> [[६। ‘अलङ्कृञ्निराकृञ्प्रजनोत्पचोत्पद--’ (३-२-१३६) इत्यादिना इष्णुच् प्रत्ययः तच्छीलादिषु कर्तृषु भवति--इति माधवः। एतच्च प्रकृतसूत्रे (३-२-१३६), उत्पद इति पाठाश्रयणेन साध्यते। परं तु--पतॢधातौ (९६८) स्वयमेव माधवेन उत्पत इत्येतस्मादेव इष्णुच् साधितः। पदधातौ तु “केचित्तु ‘उत्पत’ इति पततिं पठन्ति” इति वदतः को वाऽत्र स्वाभिमतः पाठ इति न ज्ञायते।]]</li> <li id="foot_krm_0982_10"><a href="#ref_krm_0982_10">↑</a> [[७। ‘जुचङ्क्रम्यदन्द्रम्यसृगृधिज्वलशुचलषपतपदः’ (३-२-१५०) इत्यादिना ताच्छी- लिको युच्प्रत्ययः।]]</li> <li id="foot_krm_0982_11"><a href="#ref_krm_0982_11">↑</a> [[८। ‘लषपतपद--’ (३-२-१५४) इत्यादिना तच्छीलादिषु कर्तृषु उकञ् प्रत्ययः। अदन्तत्वात् स्त्रियां टाप्।]]</li> <li id="foot_krm_0982_12"><a href="#ref_krm_0982_12">↑</a> [[आ। ‘प्रकृतिं प्रतिपादुकैश्च पादैश्चकॢपे भानुमतः पुनः प्रसर्तुम्।’ शि। व। २०-३९।]]</li> <li id="foot_krm_0982_13"><a href="#ref_krm_0982_13">↑</a> [[९। ‘पदरुजविशस्पृशो घञ्’ (३-३-१६) इति कर्तरि घञ्।]]</li> <li id="foot_krm_0982_14"><a href="#ref_krm_0982_14">↑</a> [[१०। सम्पूर्वकादस्मात् कर्तरि शप्रत्यये, दिवादित्वात् श्यनि, पररूपे, रूपमेवम्। शप्रत्ययसद्भावे निदानं तु ‘कृभ्वस्तियोगे सम्पद्यकर्तरि--’ (५-४-५०) इति सूत्रे सम्पद्य इति निर्देश एव।]]</li> <li id="foot_krm_0982_15"><a href="#ref_krm_0982_15">↑</a> [पृष्ठम्०८४६+ २९]</li> <li id="foot_krm_0982_16"><a href="#ref_krm_0982_16">↑</a> [[१। ‘पपुष आगतं पपिवद्रूप्यम्’ इति भाष्य (४-३-२४) प्रयोगात्, छान्दसोऽपि क्वसुः क्वचिद् भाषायां भवति इति ज्ञायते। तेन क्वसौ, एत्वाभ्यासलोपयोः, ‘वस्वेकाजाद्धसाम्’ (७-२-६७) इति इडागमे च रूपमेवम्।]]</li> <li id="foot_krm_0982_17"><a href="#ref_krm_0982_17">↑</a> [[आ। ‘प्रायेण प्रणिपेदुषां निजमसौ योगं स्वयं शिक्षयन्।’ कामासिकाष्टके ५।]]</li> <li id="foot_krm_0982_18"><a href="#ref_krm_0982_18">↑</a> [[२। ‘खनो घ च’ (३-३-१२५) इत्यत्र चकारात् संज्ञायामन्यत्रापि घप्रत्ययो भवति इति ज्ञायते-इत्याश्रयणेन घप्रत्यये रूपम्।]]</li> <li id="foot_krm_0982_19"><a href="#ref_krm_0982_19">↑</a> [[३। आङ्पूर्वकादस्मात् संज्ञायां घप्रत्यये, ‘आस्पदं प्रतिष्ठायाम्’ (६-१-१४६) इत्यत्र निपातनात् सुडागमः।]]</li> <li id="foot_krm_0982_20"><a href="#ref_krm_0982_20">↑</a> [[B। ‘कृतास्पदा भूमिभृतां सहस्रैरुदन्वदम्भःपरिवीतमूर्तिः।’ शि। व। ३-३४।]]</li> <li id="foot_krm_0982_21"><a href="#ref_krm_0982_21">↑</a> [[४। ‘गोष्पदं सेवितासेवितप्रमाणेषु’ (६-१-१४५) इत्यनेन सेविते असेविते प्रमाणे च विषये सुट् निपात्यते। षत्वं च भवति।]]</li> <li id="foot_krm_0982_22"><a href="#ref_krm_0982_22">↑</a> [[५। ‘सम्पदादिभ्यः--’ (वा। ३-३-९४) इत्यनेन स्त्रियां भावादौ क्विप्। ‘क्तिन्न- पीष्यते’ (भाष्येष्टिः ३-३-९४) इति वचनात् क्तिनि सम्पत्तिः इत्यादिकमपि साध्वेव। प्रतिपत् = ज्ञानम्, प्रथमा तिथिश्च।]]</li> <li id="foot_krm_0982_23"><a href="#ref_krm_0982_23">↑</a> [[६। ‘संज्ञायां समजनिषदनिपत--’ (३-३-९९) इत्यत्र ‘निपद’ इति क्षीर- स्वामिपाठमाश्रित्यात्र क्यप् बोध्यः। पद्या = काव्यविशेषः। ‘एकप्रघट्टकं पद्या मुक्तकानां निबन्धनम्।’ इति तल्लक्षणम्। अत्र पक्षे ‘उपेयिवान्--’ (३-२-१०९) इत्यत्र ‘उप’ इत्यस्येव अत्र ‘नि’ इत्यस्याविवक्षितत्वं ज्ञेयम्।]]</li> <li id="foot_krm_0982_24"><a href="#ref_krm_0982_24">↑</a> [पृष्ठम्०८४७+ २५]</li> <li id="foot_krm_0982_25"><a href="#ref_krm_0982_25">↑</a> [[१। ‘विशिपतिपदिस्कन्दां व्याप्यमानासेव्यमानयोः’ (३-४-५६) इति सोपपदात् णमुल्। ‘तृतीयाप्रभृतीनि--’ (२-२-२१) इति समासविकल्पः। समासे, ‘नित्य- वीप्सयोः’ (८-१-४) इति द्विर्वचनं न भवति। समासेनैव नित्यवीप्सार्थयोरुक्तत्वात्।]]</li> <li id="foot_krm_0982_26"><a href="#ref_krm_0982_26">↑</a> [[२। ‘णिच्च कसि पद्यर्त्तेः’ [द। उ। १-१६८]</li> <li id="foot_krm_0982_27"><a href="#ref_krm_0982_27">↑</a> (७-४-१३)</li> <li id="foot_krm_0982_28"><a href="#ref_krm_0982_28">↑</a> [[३। औणादिके [द। उ। ७-२६]</li></ul></p>

पद|पदकः-दिका|पिपदयिषकः-षिका
<ul><li><sup id="ref_krm_0983_01"><a href="#foot_krm_0983_01">1</a></sup> {@“पद गतौ”@} <sup id="ref_krm_0983_02"><a href="#foot_krm_0983_02">2</a></sup> अदन्तः। </li> <li>आगर्वीयः। </li> <li>‘--श्यनि गत्यर्थे पद्यते पदयेत णौ।।’ <sup id="ref_krm_0983_03"><a href="#foot_krm_0983_03">3</a></sup> इति देवः। </li> <li>पदकः-दिका, पिपदयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिक- कथयतिवत् <sup id="ref_krm_0983_04"><a href="#foot_krm_0983_04">4</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0983_01"><a href="#ref_krm_0983_01">↑</a> (९७३)</li> <li id="foot_krm_0983_02"><a href="#ref_krm_0983_02">↑</a> (१०-चुरादिः-१८९८। सक। सेट्। आत्म।)</li> <li id="foot_krm_0983_03"><a href="#ref_krm_0983_03">↑</a> (श्लो। १०९)</li> <li id="foot_krm_0983_04"><a href="#ref_krm_0983_04">↑</a> (१६२)</li></ul></p>

पन|परं|तु-|पनायतेरार्धधातुके|आयप्रत्ययाभावपक्षेऽनुदात्तेत्त्वस्य|चरितार्थत्वात्|आत्मनेपदं|चिन्त्यम्।]]|पनायकः-पानकः-निका|पनायकः-पानकः|पिपनायिषकः-पिपनिषकः-षिका|पंपनकः-पम्पनकः-निका
<ul><li><sup id="ref_krm_0984_01"><a href="#foot_krm_0984_01">1</a></sup> {@“पन स्तुतौ”@} <sup id="ref_krm_0984_02"><a href="#foot_krm_0984_02">2</a></sup> <sup id="ref_krm_0984_03"><a href="#foot_krm_0984_03">3</a></sup> क्षीरतरङ्गिण्यां ‘पनायते हरिम्।’ इत्यात्मनेपदमायप्रत्ययान्तात् निरुच्य, तस्य साधकत्वेन, “अत्र, ‘अवयवेऽपि कृतं लिङ्गं समुदायस्य विशेषकं भवति।’ <sup id="ref_krm_0984_04"><a href="#foot_krm_0984_04">4</a></sup> इत्यायव्यवधानेऽपि आत्मनेपदम्।’ इत्युक्तम्। </li> <li>परं तु-- पनायतेरार्धधातुके आयप्रत्ययाभावपक्षेऽनुदात्तेत्त्वस्य चरितार्थत्वात् आत्मनेपदं चिन्त्यम्।]] पनायकः-पानकः-निका, पनायकः-पानकः, पिपनायिषकः-पिपनिषकः-षिका, पंपनकः-पम्पनकः-निका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकपणायतिवत् <sup id="ref_krm_0984_05"><a href="#foot_krm_0984_05">5</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0984_06"><a href="#foot_krm_0984_06">6</a></sup> असच्प्रत्यये रूपम्। </li> <li>पनसः = फलवृक्षविशेषः।]] पनसः। </li> <li><sup id="ref_krm_0984_07"><a href="#foot_krm_0984_07">7</a></sup> पनितम्। </li> <li><sup id="ref_krm_0984_08"><a href="#foot_krm_0984_08">8</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0984_01"><a href="#ref_krm_0984_01">↑</a> (९७४)</li> <li id="foot_krm_0984_02"><a href="#ref_krm_0984_02">↑</a> (१-भ्वादिः-४४०। सक। सेट्। आत्म।)</li> <li id="foot_krm_0984_03"><a href="#ref_krm_0984_03">↑</a> [[[अ]</li> <li id="foot_krm_0984_04"><a href="#ref_krm_0984_04">↑</a> (भाष्यम्-३-१-५)</li> <li id="foot_krm_0984_05"><a href="#ref_krm_0984_05">↑</a> (९६४)</li> <li id="foot_krm_0984_06"><a href="#ref_krm_0984_06">↑</a> [[४। औणादिके [द। उ। ९। ४४]</li> <li id="foot_krm_0984_07"><a href="#ref_krm_0984_07">↑</a> [[आ। ‘पणाय्यरूपा पनिताकूतीन् ययुर्भामिन्य एवाक्षमया स्वकामुकान्।’ धा। का। १। ५७।]]</li> <li id="foot_krm_0984_08"><a href="#ref_krm_0984_08">↑</a> [पृष्ठम्०८४८+ २९]</li></ul></p>

पय|पायकः-यिका|पिपयिषकः-षिका|पापयकः-यिका
<ul><li><sup id="ref_krm_0985_01"><a href="#foot_krm_0985_01">1</a></sup> {@“पय गतौ”@} <sup id="ref_krm_0985_02"><a href="#foot_krm_0985_02">2</a></sup> पायकः-यिका, पायकः-यिका, पिपयिषकः-षिका, पापयकः-यिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकचयतिवत् <sup id="ref_krm_0985_03"><a href="#foot_krm_0985_03">3</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0985_01"><a href="#ref_krm_0985_01">↑</a> (९७५)</li> <li id="foot_krm_0985_02"><a href="#ref_krm_0985_02">↑</a> (१-भ्वादिः-४७६। सक। सेट्। आत्म।)</li> <li id="foot_krm_0985_03"><a href="#ref_krm_0985_03">↑</a> (५०२)</li></ul></p>

पर्ण|पर्णकः-र्णिका|पिपर्णयिषकः-षिका
<ul><li><sup id="ref_krm_0986_01"><a href="#foot_krm_0986_01">1</a></sup> {@“पर्ण हरितभावे”@} <sup id="ref_krm_0986_02"><a href="#foot_krm_0986_02">2</a></sup> अदन्तः। </li> <li>पर्णकः-र्णिका, पिपर्णयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिक- कर्णयतिवत् <sup id="ref_krm_0986_03"><a href="#foot_krm_0986_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0986_04"><a href="#foot_krm_0986_04">4</a></sup> प्रपर्णितम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0986_01"><a href="#ref_krm_0986_01">↑</a> (९७६)</li> <li id="foot_krm_0986_02"><a href="#ref_krm_0986_02">↑</a> (१०-चुरादिः-१९३९। अक। सेट्। उभ।)</li> <li id="foot_krm_0986_03"><a href="#ref_krm_0986_03">↑</a> (१७०)</li> <li id="foot_krm_0986_04"><a href="#ref_krm_0986_04">↑</a> [[आ। ‘प्रपर्णितदिशं रुचा क्षपितभूभृतोऽस्यानुजाः सदोनिवसितं हरिं ययुरतूत्थिताङ्गाः क्रुधा।’ धा। का। ३। ६४।]]</li></ul></p>

पर्द|पर्दकः-र्दिका|पिपर्दिषकः-षिका|पापर्दकः-र्दिका
<ul><li><sup id="ref_krm_0987_01"><a href="#foot_krm_0987_01">1</a></sup> {@“पर्द कुत्सिते शब्दे”@} <sup id="ref_krm_0987_02"><a href="#foot_krm_0987_02">2</a></sup> “कुत्सितशब्दः = गुदरवः। </li> <li>तदाह केशवस्वामी-- “कौक्षे कर्दति, पर्दते गुदरवे--’ इति।” इति माधवधातुवृत्तिः। </li> <li>क्षीरस्वामी तु -- “पायुध्वनौ वर्ततेऽयम्। </li> <li>अन्ये निश्शब्दमधोवातं मन्वानाः ‘अशब्दे’ इत्याहुः।” इत्याह। </li> <li>पर्दकः-र्दिका, पर्दकः-र्दिका, पिपर्दिषकः-षिका, पापर्दकः-र्दिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककर्जतिवत् <sup id="ref_krm_0987_03"><a href="#foot_krm_0987_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0987_04"><a href="#foot_krm_0987_04">4</a></sup> पर्दनः, <sup id="ref_krm_0987_05"><a href="#foot_krm_0987_05">5</a></sup> इत्यनेन काकुप्रत्ययः, संप्रसारणं, णित्त्वम् अलोपश्च। </li> <li>पृदाकुः = पर्दकः, सर्पश्च।]] पृदाकुः <sup id="ref_krm_0987_06"><a href="#foot_krm_0987_06">6</a></sup> पर्दमानः, पर्दिष्यमाणः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0987_01"><a href="#ref_krm_0987_01">↑</a> (९७७)</li> <li id="foot_krm_0987_02"><a href="#ref_krm_0987_02">↑</a> (१-भ्वादिः-२९। अक। सेट्। आत्म।)</li> <li id="foot_krm_0987_03"><a href="#ref_krm_0987_03">↑</a> (१६९)</li> <li id="foot_krm_0987_04"><a href="#ref_krm_0987_04">↑</a> [[१। ‘चलनशब्दार्थादकर्मकाद् युच्’ (३-२-१४८) इति ताच्छीलिको युच्प्रत्ययः।]]</li> <li id="foot_krm_0987_05"><a href="#ref_krm_0987_05">↑</a> [[२। ‘पर्देर्णित् संप्रसारणमलोपश्च’ [द। उ। १-१५२]</li> <li id="foot_krm_0987_06"><a href="#ref_krm_0987_06">↑</a> [[B। ‘पृदाकुजिद् वेगमयत्नतो ययौ वियोयुतत्काननजोतिनाध्वना।।’ धा। का। १-५।]]</li></ul></p>

पर्प|पर्पकः-र्पिका|पिपर्पिषकः-षिका|पापर्पकः-र्पिका
<ul><li><sup id="ref_krm_0988_01"><a href="#foot_krm_0988_01">1</a></sup> {@“पर्प गतौ”@} <sup id="ref_krm_0988_02"><a href="#foot_krm_0988_02">2</a></sup> पर्पकः-र्पिका, पर्पकः-र्पिका, पिपर्पिषकः-षिका, पापर्पकः-र्पिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककर्बतिवत् <sup id="ref_krm_0988_03"><a href="#foot_krm_0988_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0988_04"><a href="#foot_krm_0988_04">4</a></sup> पर्पः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0988_01"><a href="#ref_krm_0988_01">↑</a> (९७८)</li> <li id="foot_krm_0988_02"><a href="#ref_krm_0988_02">↑</a> (१-भ्वादिः-४१२। सक। सेट्। पर।)</li> <li id="foot_krm_0988_03"><a href="#ref_krm_0988_03">↑</a> (१७३)</li> <li id="foot_krm_0988_04"><a href="#ref_krm_0988_04">↑</a> [[४। पर्प्यतेऽनेनेति पर्पः = येन पीठेन पङ्गवश्चरन्ति स दारुविशेषः। ‘हलश्च’ (३-३-१२१) इति संज्ञायां करणे घञ्।]]</li></ul></p>

पर्ब|पर्बकः-र्बिका|पिपर्बिषकः-षिका|पापर्बकः-र्बिका
<ul><li><sup id="ref_krm_0989_01"><a href="#foot_krm_0989_01">1</a></sup> {@“पर्ब गतौ”@} <sup id="ref_krm_0989_02"><a href="#foot_krm_0989_02">2</a></sup> पर्बकः-र्बिका, पर्बकः-र्बिका, पिपर्बिषकः-षिका, पापर्बकः-र्बिका;</li> <li>  इत्येवमादीनि समस्तान्यपि रूपाणि भौवादिककर्बतिवत् <sup id="ref_krm_0989_03"><a href="#foot_krm_0989_03">3</a></sup> ज्ञेयानि। </li> <li>शतरि <sup id="ref_krm_0989_04"><a href="#foot_krm_0989_04">4</a></sup> पर्बन्। </li> <li><sup id="ref_krm_0989_05"><a href="#foot_krm_0989_05">5</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0989_01"><a href="#ref_krm_0989_01">↑</a> (९७९)</li> <li id="foot_krm_0989_02"><a href="#ref_krm_0989_02">↑</a> (१-भ्वादिः-४१६। सक। सेट्। पर।)</li> <li id="foot_krm_0989_03"><a href="#ref_krm_0989_03">↑</a> (१७३)</li> <li id="foot_krm_0989_04"><a href="#ref_krm_0989_04">↑</a> [[C। ‘हयैः सुरम्फैर्द्रुतमर्बतो रवेः पर्बद्भिरालर्ब्यत रक्तिमा करैः। धा। का। १। ५४।]]</li> <li id="foot_krm_0989_05"><a href="#ref_krm_0989_05">↑</a> [पृष्ठम्०८४९+ २६]</li></ul></p>

पर्व|पर्वकः-र्विका|पिपर्विषकः-षिका|पापर्वकः-र्विका
<ul><li><sup id="ref_krm_0990_01"><a href="#foot_krm_0990_01">1</a></sup> {@“पर्व पूरणे”@} <sup id="ref_krm_0990_02"><a href="#foot_krm_0990_02">2</a></sup> पर्वकः-र्विका, पर्वकः-र्विका, पिपर्विषकः-षिका, पापर्वकः-र्विका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककर्वतिवत् <sup id="ref_krm_0990_03"><a href="#foot_krm_0990_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0990_04"><a href="#foot_krm_0990_04">4</a></sup> इत्यादिना अतच्प्रत्यये रूपम्।]] पर्वतः <sup id="ref_krm_0990_05"><a href="#foot_krm_0990_05">5</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0990_01"><a href="#ref_krm_0990_01">↑</a> (९८०)</li> <li id="foot_krm_0990_02"><a href="#ref_krm_0990_02">↑</a> (१-भ्वादिः-५७७। सक। सेट्। पर।)</li> <li id="foot_krm_0990_03"><a href="#ref_krm_0990_03">↑</a> (१७३-आ)</li> <li id="foot_krm_0990_04"><a href="#ref_krm_0990_04">↑</a> [[१। ‘भृदृशीङ्यजिपर्वि--’ [द। उ। ६। १४]</li> <li id="foot_krm_0990_05"><a href="#ref_krm_0990_05">↑</a> [[आ। ‘दुदूर्विषून् धूर्वितुमेव गूर्वणं मूर्वन्तमापूर्वितपर्वताध्वरम्।।’ धा। का। १। ७३।]]</li></ul></p>

पल|पालकः-लिका|पिपलिषकः-षिका|पापलकः-लिका
<ul><li><sup id="ref_krm_0991_01"><a href="#foot_krm_0991_01">1</a></sup> {@“पल गतौ”@} <sup id="ref_krm_0991_02"><a href="#foot_krm_0991_02">2</a></sup> ज्वलादिः। </li> <li>पालकः-लिका, पालकः-लिका, पिपलिषकः-षिका, पापलकः-लिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककलतिवत् <sup id="ref_krm_0991_03"><a href="#foot_krm_0991_03">3</a></sup> ज्ञेयानि। </li> <li>शतरि <sup id="ref_krm_0991_04"><a href="#foot_krm_0991_04">4</a></sup> पलन्-न्ती इति, पलः- <sup id="ref_krm_0991_05"><a href="#foot_krm_0991_05">5</a></sup> पालः, <sup id="ref_krm_0991_06"><a href="#foot_krm_0991_06">6</a></sup> पलम्, <sup id="ref_krm_0991_07"><a href="#foot_krm_0991_07">7</a></sup> कलप्रत्यये रूपम्। </li> <li>पललम् = तिलकल्कः।]] पललम्, <sup id="ref_krm_0991_08"><a href="#foot_krm_0991_08">8</a></sup> कालच्प्रत्यये रूपम्। </li> <li>पलालम् = निस्सारतृणादिकम्।]] पलालम् इति रूपाणि चास्य धातोः सम्भवन्तीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0991_01"><a href="#ref_krm_0991_01">↑</a> (९८१)</li> <li id="foot_krm_0991_02"><a href="#ref_krm_0991_02">↑</a> (१-भ्वादिः-८३९। सक। सेट्। पर।)</li> <li id="foot_krm_0991_03"><a href="#ref_krm_0991_03">↑</a> (१७४)</li> <li id="foot_krm_0991_04"><a href="#ref_krm_0991_04">↑</a> [[B। ‘स्थलीर्हली सन्नलिनीश्च तीर्त्वा पलन् हरिश्चात्मबलप्रपोलः।’ धा। का। २-२२।]]</li> <li id="foot_krm_0991_05"><a href="#ref_krm_0991_05">↑</a> [[२। ‘ज्वलितिकसन्तेभ्यो णः’ (३-१-१४०) इति कर्तरि विभाषा णप्रत्ययः। पक्षे पचाद्यचि--पलः इति रूपम्।]]</li> <li id="foot_krm_0991_06"><a href="#ref_krm_0991_06">↑</a> [[३। संज्ञायां भावे घप्रत्ययः। बाहुलकात् क्लीबत्वम्। पलम् = मांसम्, उन्मान- विशेषश्च। परिमाणवाचकत्वेऽपि बाहुलकादेव घञ् न।]]</li> <li id="foot_krm_0991_07"><a href="#ref_krm_0991_07">↑</a> [[४। औणादिके [द। उ। ८-११४]</li> <li id="foot_krm_0991_08"><a href="#ref_krm_0991_08">↑</a> [[५। औणादिके [द। उ। ८-११५]</li></ul></p>

पल्पूल|पल्पूलकः-लिका|पिपल्पूलयिषकः-षिका
<ul><li><sup id="ref_krm_0992_01"><a href="#foot_krm_0992_01">1</a></sup> {@“पल्पूल लवनपवनयोः”@} <sup id="ref_krm_0992_02"><a href="#foot_krm_0992_02">2</a></sup> अदन्तः। </li> <li>‘पल्यूल--’ इति क्षीरस्वाम्यादिसम्मतः पाठः। </li> <li>‘-- शोधनयोः’ इत्यपि क्वचित् पाठः। </li> <li>‘पल्बूल--’ इति, ‘पल्वूल--’ इति च क्वचिद् दृष्टः पाठः। </li> <li>‘लवनपतनयोः’ इति दुर्गः। </li> <li>पल्पूलकः-लिका, पिपल्पूलयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिककलयतिवत् <sup id="ref_krm_0992_03"><a href="#foot_krm_0992_03">3</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0992_01"><a href="#ref_krm_0992_01">↑</a> (९८२)</li> <li id="foot_krm_0992_02"><a href="#ref_krm_0992_02">↑</a> (१०-चुरादिः-१८८२। सक। सेट्। उभ।)</li> <li id="foot_krm_0992_03"><a href="#ref_krm_0992_03">↑</a> (१७६)</li></ul></p>

पश|पाशकः-शिका|पिपशिषकः-षिका|पम्पशकः-पंपशकः-शिका|पशिता-त्री|पाशयिता-त्री|पिपशिषिता-त्री|पम्पशिता-त्री|पशन्-न्ती|पाशयन्-न्ती|पिपशिषन्-न्ती|-|पशिष्यन्-न्ती-ती|पाशयिष्यन्-न्ती-ती|पिपशिषिष्यन्-न्ती-ती|पाशयमानः|पाशयिष्यमाणः|पम्पश्यमानः|पम्पशिष्यमाणः|पट्-पड्-पशौ-पशः|पशितम्-तः-तवान्|पाशितः|पिपशिषितः|पम्पशितः-तवान्|पशः|पाशः|पिपशिषुः|पम्पशः|पशितव्यम्|पाशयितव्यम्|पिपशिषितव्यम्|पम्पशितव्यम्|पशनीयम्|पाशनीयम्|पिपशिषणीयम्|पम्पशनीयम्|पाश्यम्|पिपशिष्यम्|पम्पश्यम्|ईषत्पशः-दुष्पशः-सुपशः|-पश्यमानः|पाश्यमानः|पिपशिष्यमाणः|पिपशिषः|पशितुम्|पाशयितुम्|पिपशिषितुम्|पम्पशितुम्|पष्टिः|पाशना|पिपशिषा|पम्पशा|पशनम्|पाशनम्|पिपशिषणम्|पम्पशनम्|पशित्वा|पाशयित्वा|पिपशिषित्वा|पम्पशित्वा|प्रपश्य|प्रपाश्य|प्रपिपशिष्य|प्रपम्पश्य|पाशम्|पिपशिषम्|पम्पशम्
<ul><li><sup id="ref_krm_0993_01"><a href="#foot_krm_0993_01">1</a></sup> {@“पश गतिनाशनयोः”@} <sup id="ref_krm_0993_02"><a href="#foot_krm_0993_02">2</a></sup> धातुपाठेऽपठितोऽप्ययं धातुः ‘जपजभदहदशभञ्जपशां च’ <sup id="ref_krm_0993_03"><a href="#foot_krm_0993_03">3</a></sup> इत्यत्रोपादानात् सौत्रोऽयमस्तीति प्रतीयते। </li> <li>अर्थनिर्देशस्य कुत्रापि स्पष्टतया <sup id="ref_krm_0993_04"><a href="#foot_krm_0993_04">4</a></sup> अप्रतीतावपि, दशपाद्युणादिवृत्तौ <sup id="ref_krm_0993_05"><a href="#foot_krm_0993_05">5</a></sup> ‘पशिः सौत्रो धातुर्नाशने’ इति दर्शनात् नाशनार्थकत्वमस्येति ज्ञायते। </li> <li>“पसधातुर्दन्त्यान्तः सौत्रो गत्यर्थ इति माधवः, तालव्यान्त इति काशिका” इति बालमनोरमायाम्, तथा, अष्टाध्यायीप्रकाशिकायाम् <sup id="ref_krm_0993_06"><a href="#foot_krm_0993_06">6</a></sup> ‘जपजभ--’ <sup id="ref_krm_0993_07"><a href="#foot_krm_0993_07">7</a></sup> इत्यत्र ‘पम्पश्यते, पम्पशीति गत्यर्थकोऽयं धातुः।’ इत्युदा- हृतत्वाच्च गतावप्ययं प्रयुज्यते इति ज्ञेयम्। </li> <li>शब्विकरणस्यौत्सर्गिकत्वात्, क्षीरतरङ्गिण्याम् ‘पशोऽनुपसर्गात्’ <sup id="ref_krm_0993_08"><a href="#foot_krm_0993_08">8</a></sup> इत्यत्र “गतावित्येव, अर्थानिर्देशात्। </li> <li>‘अनार्षोऽयम्’ इति चन्द्रः। </li> <li>‘भ्वादेश्चुरादेश्चानुपसर्गस्य पशेः णिच्यदन्तत्वविधिः--’ इत्येके। </li> <li>पशयति। </li> <li>उपसर्गान्नास्ति प्रपशति।” इत्युक्तत्वाच्च धातोरस्य भ्वादौ पाठः, गत्यर्थकत्वं चेति ज्ञायते। </li> <li>प्रकृतसूत्रे <sup id="ref_krm_0993_09"><a href="#foot_krm_0993_09">9</a></sup> ‘पस’ इति दन्त्यान्तत्वेन केचित् पठन्ति। </li> <li>गतौ सकर्मकः, नाशने त्वकर्मकः। </li> <li>अनिट्कारिकासु धातोरस्योपादानाभावेन सेट्त्वं, ‘शेषात् कर्तरि परस्मैपदम्’ <sup id="ref_krm_0993_10"><a href="#foot_krm_0993_10">10</a></sup> इति परस्मैपदत्वं चेति यथायथमूह्यम्। </li> <li>पाशकः-शिका, पाशकः-शिका, पिपशिषकः-षिका, <sup id="ref_krm_0993_11"><a href="#foot_krm_0993_11">11</a></sup> पम्पशकः-पंपशकः-शिका;</li> <li>  पशिता-त्री, पाशयिता-त्री, पिपशिषिता-त्री, पम्पशिता-त्री;</li> <li>  पशन्-न्ती, पाशयन्-न्ती, पिपशिषन्-न्ती;</li> <li>  -- पशिष्यन्-न्ती-ती, पाशयिष्यन्-न्ती-ती, पिपशिषिष्यन्-न्ती-ती;</li> <li>  -- -- पाशयमानः, पाशयिष्यमाणः, -- पम्पश्यमानः, पम्पशिष्यमाणः;</li> <li>  <sup id="ref_krm_0993_12"><a href="#foot_krm_0993_12">12</a></sup> पट्-पड्-पशौ-पशः;</li> <li>  -- -- -- पशितम्-तः-तवान्, पाशितः, पिपशिषितः, पम्पशितः-तवान्;</li> <li>  पशः, पाशः, पिपशिषुः, पम्पशः;</li> <li>  पशितव्यम्, पाशयितव्यम्, पिपशिषितव्यम्, पम्पशितव्यम्;</li> <li>  पशनीयम्, पाशनीयम्, पिपशिषणीयम्, पम्पशनीयम्;</li> <li>  पाश्यम्, पाश्यम्, पिपशिष्यम्, पम्पश्यम्;</li> <li>  ईषत्पशः-दुष्पशः-सुपशः;</li> <li>  -- -- <sup id="ref_krm_0993_13"><a href="#foot_krm_0993_13">13</a></sup> पश्यमानः, पाश्यमानः, पिपशिष्यमाणः, पम्पश्यमानः;</li> <li>  <sup id="ref_krm_0993_14"><a href="#foot_krm_0993_14">14</a></sup> पाशः, पाशः, पिपशिषः, पम्पशः;</li> <li>  पशितुम्, पाशयितुम्, पिपशिषितुम्, पम्पशितुम्;</li> <li>  <sup id="ref_krm_0993_15"><a href="#foot_krm_0993_15">15</a></sup> पष्टिः, पाशना, पिपशिषा, पम्पशा;</li> <li>  पशनम्, पाशनम्, पिपशिषणम्, पम्पशनम्;</li> <li>  पशित्वा, पाशयित्वा, पिपशिषित्वा, पम्पशित्वा;</li> <li>  प्रपश्य, प्रपाश्य, प्रपिपशिष्य, प्रपम्पश्य;</li> <li>  पाशम् २, पशित्वा २, पाशम् २, पाशयित्वा २, पिपशिषम् २, पिपशिषित्वा २, पम्पशम् २;</li> <li>  पम्पशित्वा २;</li> <li>  <sup id="ref_krm_0993_16"><a href="#foot_krm_0993_16">16</a></sup> पशुः, <sup id="ref_krm_0993_17"><a href="#foot_krm_0993_17">17</a></sup> कुप्रत्यये रूपम्। </li> <li>पश्यतेऽसौ-अल्पेनापि वायुना इति पांशुः = रेणुः। </li> <li>अत्र दशपाद्युणादिवृत्तौ ‘पशि’ इतीदित् धातुः सौत्रत्वे- नोपात्तः। </li> <li>परं तु प्रकृत <sup id="ref_krm_0993_18"><a href="#foot_krm_0993_18">18</a></sup> सूत्रे अनिदितमेव धातुं प्रतीमः। </li> <li>अत्र <sup id="ref_krm_0993_19"><a href="#foot_krm_0993_19">19</a></sup> पाठो निरीक्ष्यः।]] पांशुः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0993_01"><a href="#ref_krm_0993_01">↑</a> (९८३)</li> <li id="foot_krm_0993_02"><a href="#ref_krm_0993_02">↑</a> (१-भ्वादिः-सक। अक। सेट्। पर।)</li> <li id="foot_krm_0993_03"><a href="#ref_krm_0993_03">↑</a> (७-४-८६)</li> <li id="foot_krm_0993_04"><a href="#ref_krm_0993_04">↑</a> [पृष्ठम्०८५०+ २९]</li> <li id="foot_krm_0993_05"><a href="#ref_krm_0993_05">↑</a> (१-११२)</li> <li id="foot_krm_0993_06"><a href="#ref_krm_0993_06">↑</a> (देवप्रकाशपातञ्जलकृतायाम्)</li> <li id="foot_krm_0993_07"><a href="#ref_krm_0993_07">↑</a> (७-४-८६)</li> <li id="foot_krm_0993_08"><a href="#ref_krm_0993_08">↑</a> (ग। सू। चुरादौ)</li> <li id="foot_krm_0993_09"><a href="#ref_krm_0993_09">↑</a> (७-४-८६)</li> <li id="foot_krm_0993_10"><a href="#ref_krm_0993_10">↑</a> (१-३-७८)</li> <li id="foot_krm_0993_11"><a href="#ref_krm_0993_11">↑</a> [[१। यङन्ताण्ण्वुलि, ‘जपजभदहदशभञ्जपशां च’ (७-४-८६) इति अभ्यासस्य नुगागमः। ‘स च पदान्तवद् वाच्यः’ (वा। ७-४-८५) इति पदान्तवद्भावे सति, ‘वा पदान्तस्य’ (८-४-५९) इति परसवर्णविकल्पः। एवं यङन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0993_12"><a href="#ref_krm_0993_12">↑</a> [[२। क्विपि, ‘व्रश्चभ्रस्ज--’ (८-२-३६) इत्यादिना षत्वे जश्त्वे च रूपम्।]]</li> <li id="foot_krm_0993_13"><a href="#ref_krm_0993_13">↑</a> [पृष्ठम्०८५१+ २६]</li> <li id="foot_krm_0993_14"><a href="#ref_krm_0993_14">↑</a> [[१। पश्यतेऽनेनेति करणे, संज्ञायाम् ‘हलश्च’ (३-३-१२१) इति घञ्। पाशः = आयुधविशेषः।]]</li> <li id="foot_krm_0993_15"><a href="#ref_krm_0993_15">↑</a> [[२। क्तिनि, षत्वे, ‘ष्टुना ष्टुः’ (८-४-४१) इति ष्टुत्वे च रूपम्।]]</li> <li id="foot_krm_0993_16"><a href="#ref_krm_0993_16">↑</a> [[३। ‘उणादयो बहुलम्’ (३-३-१) इति उप्रत्यये रूपम्। पशुः = चतुष्पाज्जातिः।]]</li> <li id="foot_krm_0993_17"><a href="#ref_krm_0993_17">↑</a> [[४। औणादिके [द। उ। १-११२]</li> <li id="foot_krm_0993_18"><a href="#ref_krm_0993_18">↑</a> (७-४-८६)</li> <li id="foot_krm_0993_19"><a href="#ref_krm_0993_19">↑</a> [द। उ। १-११२]</li></ul></p>

पश|इत्यस्यैव|वा|युजादेः।’”|इति।]]|पाशकः-शिका|पिपाशयिषकः-षिका
<ul><li><sup id="ref_krm_0994_01"><a href="#foot_krm_0994_01">1</a></sup> {@“पश बन्धने”@} <sup id="ref_krm_0994_02"><a href="#foot_krm_0994_02">2</a></sup> <sup id="ref_krm_0994_03"><a href="#foot_krm_0994_03">3</a></sup> ‘पष बन्धने’ इति पुरुषकारसंमतः पाठः। </li> <li>यदाह-- “पाषण्डादिस्तु ‘पष अनुपसर्गात्’ इत्यस्य कथादेर्भविष्यति। </li> <li>‘पष बन्धने’ इत्यस्यैव वा युजादेः।’ <sup id="ref_krm_0994_04"><a href="#foot_krm_0994_04">4</a></sup>” इति।]] पाशकः-शिका, पिपाशयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकजासयतिवत् <sup id="ref_krm_0994_05"><a href="#foot_krm_0994_05">5</a></sup> ज्ञेयानि। </li> <li>अस्य धातोर्णिज्विकल्पो नास्तीति विशेषः। </li> <li><sup id="ref_krm_0994_06"><a href="#foot_krm_0994_06">6</a></sup> पाशितवान्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0994_01"><a href="#ref_krm_0994_01">↑</a> (९८४)</li> <li id="foot_krm_0994_02"><a href="#ref_krm_0994_02">↑</a> (१०-चुरादिः-१७२०। सक। सेट्। उभ।)</li> <li id="foot_krm_0994_03"><a href="#ref_krm_0994_03">↑</a> [[[अ]</li> <li id="foot_krm_0994_04"><a href="#ref_krm_0994_04">↑</a> (श्लो। १६७ दैवव्याख्याने)</li> <li id="foot_krm_0994_05"><a href="#ref_krm_0994_05">↑</a> (५९६)</li> <li id="foot_krm_0994_06"><a href="#ref_krm_0994_06">↑</a> [[आ। ‘मल्लो जिजम्भिषुरसूदितवीर्यमीशं मुष्ट्या जजास बहु पाशितवांश्च दोष्णा।।’ धा। का। ३। ३८।]]</li></ul></p>

पष|पषकः-षिका|पिपषयिषकः-षिका
<ul><li><sup id="ref_krm_0995_01"><a href="#foot_krm_0995_01">1</a></sup> {@“पष गतौ”@} <sup id="ref_krm_0995_02"><a href="#foot_krm_0995_02">2</a></sup> ‘पषोऽनुपसर्गात्’ <sup id="ref_krm_0995_03"><a href="#foot_krm_0995_03">3</a></sup> इत्यस्य स्वरूपमर्थादिकं च पूर्वस्मिन्नेव धातावुद्दिष्टमिति तत एव ज्ञेयम्। </li> <li>‘पशोऽनुपसर्गात्’ इति क्षीरस्वामि- <sup id="ref_krm_0995_04"><a href="#foot_krm_0995_04">4</a></sup> संमतः पाठः। </li> <li>पषकः-षिका, पिपषयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिककलयतिवत् <sup id="ref_krm_0995_05"><a href="#foot_krm_0995_05">5</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0995_01"><a href="#ref_krm_0995_01">↑</a> (९८५)</li> <li id="foot_krm_0995_02"><a href="#ref_krm_0995_02">↑</a> (१०-चुरादिः-१८६३। सक। सेट्। उभ। अदन्तः।)</li> <li id="foot_krm_0995_03"><a href="#ref_krm_0995_03">↑</a> (ग। सू। चुरादौ)</li> <li id="foot_krm_0995_04"><a href="#ref_krm_0995_04">↑</a> [पृष्ठम्०८५२+ २८]</li> <li id="foot_krm_0995_05"><a href="#ref_krm_0995_05">↑</a> (१७६)</li></ul></p>

पसि|पंसकः-सिका|पिपंसयिषकः-षिका|पिपंसिषकः-षिका|पापंसकः-सिका
<ul><li><sup id="ref_krm_0996_01"><a href="#foot_krm_0996_01">1</a></sup> {@“पसि नाशने”@} <sup id="ref_krm_0996_02"><a href="#foot_krm_0996_02">2</a></sup> इदित्करणात् णिचो वैकल्पिकत्वं ज्ञेयम्। </li> <li>पंसकः-सिका, पिपंसयिषकः-षिका, पंसकः-सिका, पिपंसिषकः-षिका, पापंसकः-सिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिककुंशयतिवत् <sup id="ref_krm_0996_03"><a href="#foot_krm_0996_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0996_04"><a href="#foot_krm_0996_04">4</a></sup> कुप्रत्यये दीर्घे च रूपमेवम्।]] पांसुः <sup id="ref_krm_0996_05"><a href="#foot_krm_0996_05">5</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0996_01"><a href="#ref_krm_0996_01">↑</a> (९८६)</li> <li id="foot_krm_0996_02"><a href="#ref_krm_0996_02">↑</a> (१०-चुरादिः-१६१६। सक। सेट्। उभ।)</li> <li id="foot_krm_0996_03"><a href="#ref_krm_0996_03">↑</a> (२३२)</li> <li id="foot_krm_0996_04"><a href="#ref_krm_0996_04">↑</a> [[१। औणादिके [द। उ। १-११२]</li> <li id="foot_krm_0996_05"><a href="#ref_krm_0996_05">↑</a> [[आ। ‘इत्यादिवादिषु जनेषु विमोटितारिः पापप्रपण्डिपदपांसुरवाज्यधामा।’ धा। का। ३। २३।]]</li></ul></p>

