384_21">21</a></sup> सुतङ्गमः, <sup id="ref_krm_0384_22"><a href="#foot_krm_0384_22">22</a></sup> अन्तगः, <sup id="ref_krm_0384_23"><a href="#foot_krm_0384_23">23</a></sup> अत्यन्तगः, अध्वगः, दूरगः, पारगः, सर्वगः, अनन्तगः, सर्वत्रगः, <sup id="ref_krm_0384_24"><a href="#foot_krm_0384_24">24</a></sup> पन्नगः <sup id="ref_krm_0384_25"><a href="#foot_krm_0384_25">25</a></sup> उरगः, सुगः, <sup id="ref_krm_0384_26"><a href="#foot_krm_0384_26">26</a></sup> दुर्गः <sup id="ref_krm_0384_27"><a href="#foot_krm_0384_27">27</a></sup> निर्गः, <sup id="ref_krm_0384_28"><a href="#foot_krm_0384_28">28</a></sup> <sup id="ref_krm_0384_29"><a href="#foot_krm_0384_29">29</a></sup> <sup id="ref_krm_0384_30"><a href="#foot_krm_0384_30">30</a></sup> स्त्र्यगारगः-ग्रामगः, भुजङ्गः <sup id="ref_krm_0384_31"><a href="#foot_krm_0384_31">31</a></sup> -भुजङ्गमः-भुजगः, तुरङ्गमः-तुरगः-तुरङ्गः, हृदयङ्गमः, <sup id="ref_krm_0384_32"><a href="#foot_krm_0384_32">32</a></sup> विहङ्गः-विहङ्गमः, जग्मिः, <sup id="ref_krm_0384_33"><a href="#foot_krm_0384_33">33</a></sup> जग्मिवान् <sup id="ref_krm_0384_34"><a href="#foot_krm_0384_34">34</a></sup> -जगन्वान्, <sup id="ref_krm_0384_35"><a href="#foot_krm_0384_35">35</a></sup> गमी- <sup id="ref_krm_0384_36"><a href="#foot_krm_0384_36">36</a></sup> आगामी-गामी, <sup id="ref_krm_0384_37"><a href="#foot_krm_0384_37">37</a></sup> गत्वरः <sup id="ref_krm_0384_38"><a href="#foot_krm_0384_38">38</a></sup> - <sup id="ref_krm_0384_39"><a href="#foot_krm_0384_39">39</a></sup> गत्वरी, <sup id="ref_krm_0384_40"><a href="#foot_krm_0384_40">40</a></sup> <sup id="ref_krm_0384_41"><a href="#foot_krm_0384_41">41</a></sup> गामी, <sup id="ref_krm_0384_42"><a href="#foot_krm_0384_42">42</a></sup> नगः, <sup id="ref_krm_0384_43"><a href="#foot_krm_0384_43">43</a></sup> <sup id="ref_krm_0384_44"><a href="#foot_krm_0384_44">44</a></sup> <sup id="ref_krm_0384_45"><a href="#foot_krm_0384_45">45</a></sup> पद्गः <sup id="ref_krm_0384_46"><a href="#foot_krm_0384_46">46</a></sup> प्लवङ्गः, विहगः, <sup id="ref_krm_0384_47"><a href="#foot_krm_0384_47">47</a></sup> अध्वगामी, <sup id="ref_krm_0384_48"><a href="#foot_krm_0384_48">48</a></sup> अग्रेगावा <sup id="ref_krm_0384_49"><a href="#foot_krm_0384_49">49</a></sup>, <sup id="ref_krm_0384_50"><a href="#foot_krm_0384_50">50</a></sup> गामुकः, <sup id="ref_krm_0384_51"><a href="#foot_krm_0384_51">51</a></sup> <sup id="ref_krm_0384_52"><a href="#foot_krm_0384_52">52</a></sup> हंसगामिनी, <sup id="ref_krm_0384_53"><a href="#foot_krm_0384_53">53</a></sup> <sup id="ref_krm_0384_54"><a href="#foot_krm_0384_54">54</a></sup> सुगन्मा, <sup id="ref_krm_0384_55"><a href="#foot_krm_0384_55">55</a></sup> जनङ्गमः, गमः, जिगमिषुः, <sup id="ref_krm_0384_56"><a href="#foot_krm_0384_56">56</a></sup> जङ्गमः;</li> <li>  <sup id="ref_krm_0384_57"><a href="#foot_krm_0384_57">57</a></sup> गन्तव्यम्, गमयितव्यम्, जिगमिषितव्यम्, जङ्गमितव्यम्;</li> <li>  <sup id="ref_krm_0384_58"><a href="#foot_krm_0384_58">58</a></sup> प्रगमनीयम्, <sup id="ref_krm_0384_59"><a href="#foot_krm_0384_59">59</a></sup> प्रगमनीयम्, जिगमिषणीयम्, जङ्गमनीयम्;</li> <li>  <sup id="ref_krm_0384_60"><a href="#foot_krm_0384_60">60</a></sup> <sup id="ref_krm_0384_61"><a href="#foot_krm_0384_61">61</a></sup> गम्यम्, गम्यम्, जिगमिष्यम्, जङ्गम्यम्;</li> <li>  ईषद्गमः- <sup id="ref_krm_0384_62"><a href="#foot_krm_0384_62">62</a></sup> दुर्गमः-दुरधिगमः-सुगमः;</li> <li>  -- -- गम्यमानः, गम्यमानः, जिगंस्यमानः, जङ्गम्यमानः;</li> <li>  <sup id="ref_krm_0384_63"><a href="#foot_krm_0384_63">63</a></sup> गमः, <sup id="ref_krm_0384_64"><a href="#foot_krm_0384_64">64</a></sup> एकाहगमः, <sup id="ref_krm_0384_65"><a href="#foot_krm_0384_65">65</a></sup> निगमः, <sup id="ref_krm_0384_66"><a href="#foot_krm_0384_66">66</a></sup> अभिगमः, <sup id="ref_krm_0384_67"><a href="#foot_krm_0384_67">67</a></sup> आगमः, गमः, जिगमिषः, जङ्गमः;</li> <li>  गन्तुम्, गमयितुम्, जिगमिषितुम्, जङ्गमितुम्;</li> <li>  गतिः, <sup id="ref_krm_0384_68"><a href="#foot_krm_0384_68">68</a></sup> अग्रगामिका, गमना, जिगमिषा, जङ्गमा;</li> <li>  <sup id="ref_krm_0384_69"><a href="#foot_krm_0384_69">69</a></sup> प्रगमनम्, प्रगमनम्, जिगमिषणम्, जङ्गमनम्;</li> <li>  गत्वा, गमयित्वा, जिगमिषित्वा, जङ्गमित्वा;</li> <li>  अवगत्य- <sup id="ref_krm_0384_70"><a href="#foot_krm_0384_70">70</a></sup> अवगम्य, <sup id="ref_krm_0384_71"><a href="#foot_krm_0384_71">71</a></sup> अवगमय्य, सञ्जिगंस्य, प्रजिगमिष्य, सञ्जङ्गम्य;</li> <li>  <sup id="ref_krm_0384_72"><a href="#foot_krm_0384_72">72</a></sup> गामम् २, गत्वा २, <sup id="ref_krm_0384_73"><a href="#foot_krm_0384_73">73</a></sup> गमम् २, गामम् २, गमयित्वा २, जिगमिषम् २, जिगमिषित्वा २, जङ्गमम् २;</li> <li>  जङ्गमित्वा २;</li> <li>  <sup id="ref_krm_0384_74"><a href="#foot_krm_0384_74">74</a></sup> इत्यादिना तुन्प्रत्ययः। </li> <li>गन्तुः = पथिकः। </li> <li>आगन्तुः--अतिथिः।]] गन्तुः-आगन्तुः, <sup id="ref_krm_0384_75"><a href="#foot_krm_0384_75">75</a></sup> इति डोप्रत्ययः। </li> <li>गच्छतीति गौः।]] गौः, <sup id="ref_krm_0384_76"><a href="#foot_krm_0384_76">76</a></sup> इति त्रन्प्रत्ययः। </li> <li>गात्रं = शरीरम्।]] गात्रम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0384_01"><a href="#ref_krm_0384_01">↑</a> (३७६)</li> <li id="foot_krm_0384_02"><a href="#ref_krm_0384_02">↑</a> (१-भ्वादिः-९८२। अक। अनि। पर।)</li> <li id="foot_krm_0384_03"><a href="#ref_krm_0384_03">↑</a> [[१। ‘जनीजॄष्क्रसु--’ (ग। सू। भ्वादौ) इत्यादिना अमन्तत्वेनास्य धातोर्मित्त्वम्। ‘मितां ह्रस्वः’ (६-४-९२) इति णौ उपधाह्रस्वः। एवं ण्यन्ते सर्वत्र बोध्यम्।]]</li> <li id="foot_krm_0384_04"><a href="#ref_krm_0384_04">↑</a> [[२। ‘गमेरिट् परस्मैपदेषु’ (७-२-५८) इति सन इडागमः। तत्र ‘परस्मैपदेषु’ इत्यस्य तङानयोरभावे--इत्यर्थः। एवं सन्नन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0384_05"><a href="#ref_krm_0384_05">↑</a> [[३। ‘यस्य हलः’ (६-४-४९) इति यङो यकारस्य लोपः। ‘अतो लोपः’ (६-४-४८) इत्यकारलोपः। ‘नुगतोऽनुनासिकान्तस्य’ (७-४-८५) इत्यभ्यासस्य नुगागमः। यङवयवाकारलोपस्य स्थानिवद्भावेनाजादिक्ङित्प्रत्ययपरकत्वात् ‘गमहन--’ (६-४-९८) इत्युपधालोपो न शङ्क्यः। तत्र, ‘अनङि’ इति पर्युदासेन, औपदे- शिकाजादिप्रत्यये एव लोप इति भट्टोजिदीक्षितैः ‘न धातुलोप--’ (१-१-४) इत्यत्रोक्तत्वात्। तदनुसारेण अकारलोपाघटितानि रूपाणि प्रदर्शितानि। नागेश- भट्टैस्तु--औपदेशिकाजादावित्यर्थो नाश्रितः। अतः ‘जङ्ग्मकः’ इति रूपं, ‘न धातुलोप--’ (१-१-४) इति सूत्रे उद्योते प्रदर्शितम्। प्राचीननवीनयोर्बहुषु लक्ष्येषु आशयमेदो यथा भवति, तथाऽत्रापीति बोध्यम्। एवं यङन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0384_06"><a href="#ref_krm_0384_06">↑</a> [[४। ‘इषगमियमां छः’ (७-३-७७) इति शिति प्रत्यये धातोः छकारादेशः। ‘छे च’ (६-१-७३) इति तुक्। तस्य चर्त्वेन चकारः।]]</li> <li id="foot_krm_0384_07"><a href="#ref_krm_0384_07">↑</a> [[आ। ‘पारं जिगमिषन् सोऽथ पुनरावर्त्स्यतां द्विषाम्। मत्तद्विरदवद् रेमे वने लङ्कानिवासिनाम्।।’ भ। का। ९-४३।]]</li> <li id="foot_krm_0384_08"><a href="#ref_krm_0384_08">↑</a> [[५। ‘गमेरिट् परस्मैपदेषु’ (७-२-५८) इतीडागमः।]]</li> <li id="foot_krm_0384_09"><a href="#ref_krm_0384_09">↑</a> [[६। ‘समो गम्यृच्छिभ्याम्’ (१-३-२९) इति शानच्।]]</li> <li id="foot_krm_0384_10"><a href="#ref_krm_0384_10">↑</a> [[७। ‘आगमेः क्षमायामात्मनेपदं वक्तव्यम्’ (वा। १-३-२१) इति ण्यन्तात् आङ्पूर्वका- दस्मात् आत्मनेपदमेव।]]</li> <li id="foot_krm_0384_11"><a href="#ref_krm_0384_11">↑</a> [[८। सम्पूर्वकत्वेन आत्मनेपदनिमित्तसद्भावादिडागमो न। ‘अज्झनगमां सनि’ (६-४-१६) इति दिर्घस्तु--अजादेशगमेरेव, न त्वस्य।]]</li> <li id="foot_krm_0384_12"><a href="#ref_krm_0384_12">↑</a> [पृष्ठम्०३७०+ ३४]</li> <li id="foot_krm_0384_13"><a href="#ref_krm_0384_13">↑</a> [[१। ‘गमः क्वौ’ (६-४-४०) इत्यनुनासिकलोपे ‘ह्रस्वस्य पिति--’ (६-१-७१) इति तुक्।]]</li> <li id="foot_krm_0384_14"><a href="#ref_krm_0384_14">↑</a> [[२। ‘ऊङ् च गमादीनाम्--’ (वा। ६-४-४०) इत्यनुनासिकलोपः ऊकारादेशश्च।]]</li> <li id="foot_krm_0384_15"><a href="#ref_krm_0384_15">↑</a> [[३। ‘द्युतिगमिजुहोतीनां द्वे च’ (वा। ३-२-१७८) इति क्विपि द्विर्वचनम्, अनुनासिक- लोपः। तुक्।]]</li> <li id="foot_krm_0384_16"><a href="#ref_krm_0384_16">↑</a> [[४। ‘जनसनखनक्रमगमो विट्’ (३-२-६७) इति विट्। ‘विङ्वनोरनुनासिकस्यात्’ (६-४-४१) इत्यनुनासिकस्याकारादेशः। सवर्णदीर्घः। अग्रगामी इत्यर्थः।]]</li> <li id="foot_krm_0384_17"><a href="#ref_krm_0384_17">↑</a> [[५। ‘क्तोऽधिकरणे च ध्रौव्यगतिप्रत्यवसानार्थेभ्यः’ (३-४-७६) इति अधिकरणे क्तः। ‘इदमेषां गतम्’ इत्यधिकरणे। ‘गत्यर्थाकर्मक--’ (३-४-७२) इति कर्तरि क्तः ‘देवदत्तो गतः’ इत्यत्र। ‘गतमनेन’ इत्यत्र भावे क्तः। ‘अनुदात्तोपदेश--’ (६-४-३७) इत्यनुनासिकलोपः। एवं क्तिन्यपि।]]</li> <li id="foot_krm_0384_18"><a href="#ref_krm_0384_18">↑</a> [[आ। ‘ततो मन्दगतः पक्षी तेषां प्रायोपवेशनम्। अशनीयमिवाशंसुः महानायादशोभनः।।’ भ। का। ७-७९।]]</li> <li id="foot_krm_0384_19"><a href="#ref_krm_0384_19">↑</a> [[६। ‘आदिकर्मणि क्तः कर्तरि च’ (३-४-७१) इति आदिकर्मणि क्तः। गन्तुमारब्धवान् इत्यर्थः।]]</li> <li id="foot_krm_0384_20"><a href="#ref_krm_0384_20">↑</a> [[७। ‘पञ्चम्याः स्तोकादिभ्यः’ (६-३-२) इति पञ्चम्या अलुक्।]]</li> <li id="foot_krm_0384_21"><a href="#ref_krm_0384_21">↑</a> [[८। ‘गमश्च’ (३-३-४७) संज्ञायां खच्। ‘खित्यनव्ययस्य’ (६-३-६६) इति वर्तमाने, ‘अरुर्द्विषदजन्तस्य--’ (६-३-६७) इति मुम्। एवं हृदयङ्गमः, जनङ्गमः इत्यादीनि ज्ञेयानि।]]</li> <li id="foot_krm_0384_22"><a href="#ref_krm_0384_22">↑</a> [[९। ‘अन्तात्यन्ताध्वदूरपारसर्वानन्तेषु डः’ (३-२-४८) इति डप्रत्ययः। टेर्लोपः। एबम् अत्यन्तग इत्यादि अनन्तग इति पर्यन्तम्।]]</li> <li id="foot_krm_0384_23"><a href="#ref_krm_0384_23">↑</a> [[B। ‘दूरगैरन्तगैर्बाणैर्भवान् अत्यन्तगः श्रियः। अपि सङ्क्रन्दनस्य स्यात् क्रद्धः किमुत वालिनः।।’ भ। का। ६-११०।]]</li> <li id="foot_krm_0384_24"><a href="#ref_krm_0384_24">↑</a> [[१०। ‘सर्वत्रपन्नयोरुपसंख्यानम्’ (वा। ३-२-४८) इति डः।]]</li> <li id="foot_krm_0384_25"><a href="#ref_krm_0384_25">↑</a> [[११। ‘उरसो लोपश्च’ (वा। ३-२-४८) इति डः सकारलोपश्च। उरसा गच्छतीति उरगः सर्पः।]]</li> <li id="foot_krm_0384_26"><a href="#ref_krm_0384_26">↑</a> [[१२। ‘सुदुरोरधिकरणे’ (वा। ३-२-४८) इति डः। सुखेन दुःखेन चात्र गच्छन्तीति सुगः दुर्गः।]]</li> <li id="foot_krm_0384_27"><a href="#ref_krm_0384_27">↑</a> [[C। ‘सुगेषु दुर्गेषु च तुल्यविक्रमैर्जवादहंपूर्विकया यियासुभिः। गणैरविच्छेदनिरुद्धमाबभौ वनं निरुच्छ्रवासमिवाकुलाकुलम्।।’ किरातार्जुनीये-- १४-३२।]]</li> <li id="foot_krm_0384_28"><a href="#ref_krm_0384_28">↑</a> [[१३। ‘निसो देशे’ (वा। ३-२-४८) इति डः। देशविशेषस्य नाम। निरन्तरं गच्छन्त्य- त्रेति अधिकरणे डः।]]</li> <li id="foot_krm_0384_29"><a href="#ref_krm_0384_29">↑</a> [पृष्ठम्०३७१+ ३२]</li> <li id="foot_krm_0384_30"><a href="#ref_krm_0384_30">↑</a> [[१। ‘डप्रकरणे--डोऽन्यत्रापि दृश्यते’ (वा। ३-२-४८) इति डः। एवं गुरुतल्पगः ग्रामगः इत्यादिकं ज्ञेयम्।]]</li> <li id="foot_krm_0384_31"><a href="#ref_krm_0384_31">↑</a> [[२। ‘खच्च डिद्वा वक्तव्यः’ (वा। ३-२-३८) इति वा डित्त्वेन टिलोपः। मुम्। एवं प्लवङ्ग-तुरङ्ग-विहङ्गादयः।]]</li> <li id="foot_krm_0384_32"><a href="#ref_krm_0384_32">↑</a> [[३। ‘विहायसो विह च’ (वा। ३-२-३८) इति विहायसो ‘विह’ इत्यादेशः, खचो डित्त्वं च वा भवति। मुम्। डित्त्वपक्षे ‘विहग’ इति। एवं तुरग-प्लवगादयः।]]</li> <li id="foot_krm_0384_33"><a href="#ref_krm_0384_33">↑</a> [[४। ‘भाषायां धाञ्कृञ्सृजनिगमिनमिभ्यः--’ (वा। ३-२-१७१) इति किः, किन् वा प्रत्ययः। तस्य लिड्वद्भावातिदेशात् द्वित्वादिकम्। ‘गमहन--’ (६-४-९८) इत्युपधालोपः।]]</li> <li id="foot_krm_0384_34"><a href="#ref_krm_0384_34">↑</a> [[५। ‘क्वसुश्च’ (३-२-१०७) इति लिटः क्वसुः। द्विर्वचनम्। ‘विभाषा गमहनविद- विशाम्’ (७-२-६८) इतीड्विकल्पः। जगन्वान् इत्यत्र ‘म्वोश्च’ (८-२-६५) इति मकारस्य नकारः।]]</li> <li id="foot_krm_0384_35"><a href="#ref_krm_0384_35">↑</a> [[६। ‘भविष्यति गम्यादयः’ (३-३-३) इति भविष्यत्काले इनिप्रत्ययः। “गमी गामी तथाऽऽगामी प्रयायिप्रतियायिनौ। प्रबोधी प्रतिबोधी च भावी प्रस्थाय्यमी नव।।” इति प्रक्रियासर्वस्वे गम्यादेः परिगणनं कृतम्। ‘आङि च णित्’ (ग। सू। ३-३-३) इति इनिप्रत्ययस्य णिद्वद्भावात् ‘अत उपधायाः’ (७-२-११६) इति वृद्धिः।]]</li> <li id="foot_krm_0384_36"><a href="#ref_krm_0384_36">↑</a> [[आ। ‘साधोरपि स्वः खलु गामिताऽथो गमी न तु स्वर्गमितः प्रयाणे। इत्यायती चिन्तयतो हृदि द्वे द्वयोरुदर्कः किमु शर्करे न।।’ नैषधे ६-९९।]]</li> <li id="foot_krm_0384_37"><a href="#ref_krm_0384_37">↑</a> [[७। ‘गत्वरश्च’ (३-२-१६४) इति गमेः क्वरपि अनुनासिकलोपे तुक् निपात्यते तच्छीलादिषु कर्तृषु। स्त्रियां ‘टिड्ढाणञ्--’ (४-१-१५) इति ङीप्।]]</li> <li id="foot_krm_0384_38"><a href="#ref_krm_0384_38">↑</a> [[B। ‘सृमरोऽभङ्गुरप्रज्ञो गृहीत्वा भासुरं धनुः। विदुरो जित्वरः प्राप लक्ष्मणो गत्वरान् कपीन्।।’ भ। का। ७-२२।]]</li> <li id="foot_krm_0384_39"><a href="#ref_krm_0384_39">↑</a> [[C। ‘निद्रावशेन निभृतेक्षणमुत्थितानां द्वित्राणि मन्थरपदान्यपगत्वरीणाम्। काले गृहीतमुचिते रशनाः कथञ्चित् मौनव्रतं जहति मुग्धवधूजनानाम्।।’ यादवाभ्युदये १९-६।]]</li> <li id="foot_krm_0384_40"><a href="#ref_krm_0384_40">↑</a> [व्रजं]</li> <li id="foot_krm_0384_41"><a href="#ref_krm_0384_41">↑</a> [[८। ‘आवश्यकाधमर्ण्ययोर्णिनिः’ (३-३-१७०) इति णिनिः। ‘अकेनोर्भविष्यदाध- मर्ण्ययोः’ (२-३-७०) इति षष्ठीनिषेधः।]]</li> <li id="foot_krm_0384_42"><a href="#ref_krm_0384_42">↑</a> [[९। ‘नगोऽप्राणिष्वन्यतरस्याम्’ (६-३-७७) इति नञ्समासे नलोपाभावो विकल्पेन। पक्षे--अगः। न गच्छतीति नगः पर्वतः। गमेर्डः।]]</li> <li id="foot_krm_0384_43"><a href="#ref_krm_0384_43">↑</a> [[ड्। ‘परिभावं मृगेन्द्राणां कुर्वन्तो नगमूर्धसु। विन्ध्ये तिग्मांशुमार्गस्य चेरुः परिभवोपमे।।’ भ। का। ७-५४।]]</li> <li id="foot_krm_0384_44"><a href="#ref_krm_0384_44">↑</a> [पृष्ठम्०३७२+ ३०]</li> <li id="foot_krm_0384_45"><a href="#ref_krm_0384_45">↑</a> [[आ। ‘वाचंयमान् स्थण्डिलशायिनश्च युयुक्षमाणाननिशं मुमुक्षून्। अध्यापयन्तं विनयात्प्रणेमुः पद्गाः भरद्वाजमुनिं सशिध्यम्।। भ। का। ३-४१।]]</li> <li id="foot_krm_0384_46"><a href="#ref_krm_0384_46">↑</a> [[१। ‘डोऽन्यत्रापि दृश्यते’ (वा। ३-२-४८) इति गमेर्डप्रत्ययः। ‘पादस्य पदा- ज्यातिगोपहतेषु’ (६-३-५२) इति पद्भावः। पादाभ्यां गच्छन्तीति पद्गाः = पदातयः।]]</li> <li id="foot_krm_0384_47"><a href="#ref_krm_0384_47">↑</a> [[२। ‘सुप्यजातौ णिनिस्ताच्छील्ये’ (३-२-७८) इति ताच्छील्ये णिनिः।]]</li> <li id="foot_krm_0384_48"><a href="#ref_krm_0384_48">↑</a> [[३। ‘अन्येभ्योऽपि दृश्यन्ते’ (३-२-७५) इति वनिप्। ‘विड्वनोरनुनासिकस्य--’ (६-४-४१) इत्यात्वे रूपम्। स्त्रियाम् अग्रेगावा इति भवति। ‘वनो न हशः’ (वा। ४-१-७) इति ङीब्रेफादेशनिषेधात्।]]</li> <li id="foot_krm_0384_49"><a href="#ref_krm_0384_49">↑</a> [[B। ‘अग्रेगावा च शूराणाम् अभिभूः सर्वविद्विषाम्। शंस्थरूपः स्थिरप्रज्ञः पपात सहसा भुवि।।’ भ। का। ६-१२५।]]</li> <li id="foot_krm_0384_50"><a href="#ref_krm_0384_50">↑</a> [[४। ‘लषपतपदस्थाभूवृषहनकमगमशॄभ्य उकञ्’ (३-२-१५४) इति तच्छीलादिषु कर्तृषु उकञ्। स्त्रियां गामुका इति रूपम्।]]</li> <li id="foot_krm_0384_51"><a href="#ref_krm_0384_51">↑</a> [[C। ‘अतीते वर्षुके काले प्रमत्तः स्थायुको गृहे। गामुको ध्रुवमध्वानं सुग्रीवो वालिना गतम्।।’ भ। का। ७-१८।]]</li> <li id="foot_krm_0384_52"><a href="#ref_krm_0384_52">↑</a> [[५। ‘कर्तर्युपमाने’ (३-२-७९) इति णिनिः। हंस इव गच्छतीति हंसगामिनी।]]</li> <li id="foot_krm_0384_53"><a href="#ref_krm_0384_53">↑</a> [[ड्। ‘योषिद्बृन्दारिका तस्य दयिता हंसगामिनी। दूर्वाकाण्डमिव श्यामा न्यग्रोधपरिमण्डला।।’ भ। का। ५-१८।]]</li> <li id="foot_krm_0384_54"><a href="#ref_krm_0384_54">↑</a> [[६। ‘अन्येभ्योऽपि दृश्यन्ते’ (३-२-७५) इति मनिन्। ‘नेड् वशि कृति’ (७-२-८) इतीण्णिषेधः। ‘म्वोश्च’ (८-२-६५) इति मकारस्य नकारः।]]</li> <li id="foot_krm_0384_55"><a href="#ref_krm_0384_55">↑</a> [[E। ‘औदुम्बरे वैदिशनैम्बमुख्ये देशेऽवसन् ये स जनङ्गमौघाः। ये चाघिकौशाम्बि जनास्तदानीमाकस्मिकीं प्रीतिमयासिषुस्ते।।’ वासुदेवविजये ३-१९।]]</li> <li id="foot_krm_0384_56"><a href="#ref_krm_0384_56">↑</a> [[F। ‘आ त्रिकूटमकार्षुर्ये त्वत्का निर्जङ्गमं जगत्।’ दशग्रीव कथं ब्रूषे तानवध्यान् महीपतेः।।’ भ। का। ९-१२६।]]</li> <li id="foot_krm_0384_57"><a href="#ref_krm_0384_57">↑</a> [[७। यङन्तात् पचाद्यच् (३-१-१३४)। ‘यङोऽचि च’ (२-४-७४) इति यङो लुक्।]]</li> <li id="foot_krm_0384_58"><a href="#ref_krm_0384_58">↑</a> [[८। ‘न भाभूपूकमिगमि--’ (८-४-३४) इति निषेधात् ‘कृत्यचः’ (८-४-२९) इति णत्वं न।]]</li> <li id="foot_krm_0384_59"><a href="#ref_krm_0384_59">↑</a> [[९। ‘ण्यन्तभादीनामुपसंख्यानम्--’ (वा। ८-४-३४) इति वार्तिकात् ण्यन्तादपि णत्वं न।]]</li> <li id="foot_krm_0384_60"><a href="#ref_krm_0384_60">↑</a> [पृष्ठम्०३७३+ २८]</li> <li id="foot_krm_0384_61"><a href="#ref_krm_0384_61">↑</a> [[१। ‘पोरदुपधात्’ (३-१-९८) इति यत्प्रत्ययः।]]</li> <li id="foot_krm_0384_62"><a href="#ref_krm_0384_62">↑</a> [[आ। ‘बलिनावमुमद्रीन्द्रं युवां स्तम्बेरमाविव। आचक्षाथामिथः कस्मात् शङ्करेणापि दुर्गमम्।।’ भ। का--६-९३।]]</li> <li id="foot_krm_0384_63"><a href="#ref_krm_0384_63">↑</a> [[२। ‘ग्रहवृदृनिश्चिगमश्च’ (३-३-५८) इति, भावे अकर्तरि च कारके घञपवादोऽप्- प्रत्ययः।]]</li> <li id="foot_krm_0384_64"><a href="#ref_krm_0384_64">↑</a> [[३। एकाहेन गम्यते इत्येकाहगमः = अध्वा। कर्मणि अप्। ‘परिमाणाख्यायां सर्वेभ्यः’ (३-३-२०) इति प्राप्तस्य घञोऽपवादत्वेन ‘अश्वस्यैकाहगमः’ (५-२-१९) इति सूत्रे निपातनादप्।]]</li> <li id="foot_krm_0384_65"><a href="#ref_krm_0384_65">↑</a> [[४। ‘गोचरसंचरवहव्रजव्यजापणनिगंमाश्च’ (३-३-११९) इति घञपवादः घप्रत्ययान्तो निपातः। निगम्यते = ज्ञायतेऽनेन--इति निगमः = वेदः। करणे घः। गत्यर्थानां ज्ञानार्थकत्वात् ज्ञायमानत्वम्।]]</li> <li id="foot_krm_0384_66"><a href="#ref_krm_0384_66">↑</a> [[B। ‘ततः प्रविव्राजयिषुः कुमारम् आदिक्षदस्याभिगमं वनाय। सौमित्रिसीतानुचरस्य राजा सुमन्त्रनेत्रेण रथेन शोचन्।।’ भ। का। ३-९।]]</li> <li id="foot_krm_0384_67"><a href="#ref_krm_0384_67">↑</a> [[C। ‘प्रग्राहैरिव पत्राणामन्वेष्या मैथिली कृतैः। ज्ञातव्या चेङ्गितैर्धर्म्यैर्ध्यायन्ती राघवाऽऽगमम्।।’ भ। का। ७-४४।]]</li> <li id="foot_krm_0384_68"><a href="#ref_krm_0384_68">↑</a> [[५। ‘पर्यायार्हर्णोत्पत्तिषु ण्वुच्’ (३-३-१११) इति पर्यायार्थे ण्वुच् स्त्रियाम्। ‘अग्रगा- मिका अद्य भवतः।’ अग्रगामिका = अग्रगमनम्।]]</li> <li id="foot_krm_0384_69"><a href="#ref_krm_0384_69">↑</a> [[ड्। ‘हरेः प्रगमनं नास्ति न प्रभानं हिमद्रुहः। नातिप्रवेपनं वायोर्मया गोपायिते वने।।’ भ। का--९-१०७।]]</li> <li id="foot_krm_0384_70"><a href="#ref_krm_0384_70">↑</a> [[६। ‘वा ल्यपि’ (६-४-३८) इति मान्तानिटां धातूनाम्, अनुनासिकलोपविकल्पः। लोपपक्षे तुक्। तेन रूपद्वयम्।]]</li> <li id="foot_krm_0384_71"><a href="#ref_krm_0384_71">↑</a> [[७। ‘ल्यपि लघुपूर्वात्’ (६-४-५६) इति णेरयादेशः।]]</li> <li id="foot_krm_0384_72"><a href="#ref_krm_0384_72">↑</a> [पृष्ठम्०३७४+ २६]</li> <li id="foot_krm_0384_73"><a href="#ref_krm_0384_73">↑</a> [[१। ‘चिण्णमुलोर्दीर्घोऽन्यतरस्याम्’ (६-४-९३) इति ण्यन्ताण्णमुलि उपधादीर्घविकल्पः।]]</li> <li id="foot_krm_0384_74"><a href="#ref_krm_0384_74">↑</a> [[२। ‘सितनिगमि--’ [द। उ। १-१२२]</li> <li id="foot_krm_0384_75"><a href="#ref_krm_0384_75">↑</a> [[३। ‘गमेर्डोः’ [द। उ। २-११]</li> <li id="foot_krm_0384_76"><a href="#ref_krm_0384_76">↑</a> [[४। ‘गमेरा च’ [द। उ। ८-८५]</li></ul></p>

गर्ज
<ul><li><sup id="ref_krm_0385_01"><a href="#foot_krm_0385_01">1</a></sup> {@“गर्ज शब्दे”@} <sup id="ref_krm_0385_02"><a href="#foot_krm_0385_02">2</a></sup> ‘मेघशब्दे’ इति कविकल्पद्रुमे। </li> <li>‘गर्जेद् गृञ्जेद् गजेद् गञ्जेच्छब्दने गाजयेण्णिचि।’ <sup id="ref_krm_0385_03"><a href="#foot_krm_0385_03">3</a></sup> इति देवः। </li> <li>गर्जितम् = स्तनितम्। </li> <li>शतरि <sup id="ref_krm_0385_04"><a href="#foot_krm_0385_04">4</a></sup> गर्जन्- न्ती, इति रूपम्। </li> <li>अस्य धातोः सर्वाणि रूपाणि कर्जतिवत् <sup id="ref_krm_0385_05"><a href="#foot_krm_0385_05">5</a></sup> ज्ञेयानि।।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0385_01"><a href="#ref_krm_0385_01">↑</a> (३७७)</li> <li id="foot_krm_0385_02"><a href="#ref_krm_0385_02">↑</a> (१-भ्वादिः-२२६। अक। सेट्। पर।)</li> <li id="foot_krm_0385_03"><a href="#ref_krm_0385_03">↑</a> (श्लो। ५९)</li> <li id="foot_krm_0385_04"><a href="#ref_krm_0385_04">↑</a> [[आ। ‘प्रधृज्य मोदं स दधृञ्ज तद्वनं ध्वजोद्गतिध्वञ्जितकूजदण्डजम्। स्वर्गोपमं सर्जितपुण्यसञ्चयो गभीरगर्जद्रथतर्जिताम्बुदः।।’ धा। का। १-३०।]]</li> <li id="foot_krm_0385_05"><a href="#ref_krm_0385_05">↑</a> (१६९)</li></ul></p>

गर्ज|गर्जकः-र्जिका|जिगर्जयिषकः-षिका|गर्जयिता-त्री|जिगर्जयिषिता-त्री|गर्जयन्-न्ती|जिगर्जयिषन्-न्ती|गर्जयिष्यन्-न्ती-ती|जिगर्जयिषिष्यन्-न्ती-ती|गर्जयमानः|जिगर्जयिषमाणः|गर्जयिष्यमाणः|जिगर्जयिषिष्यमाणः|गर्ग्-गर्क्-गर्जौ-गर्जः|-गर्जितम्-तः-तवान्|जिगर्जयिषितः-तवान्|गर्जः|जिगर्जयिषुः|गर्जयितव्यम्|जिगर्जयिषितव्यम्|गर्जनीयम्|जिगर्जयिषणीयम्|गर्ज्यम्|जिगर्जयिष्यम्|ईषद्गर्जः-दुर्गर्जः-सुगर्जः|-|गर्ज्यमानः|जिगर्जयिष्यमाणः|जिगर्जयिषः|गर्जयितुम्|जिगर्जयिषितुम्|गर्जना|जिगर्जयिषा|गर्जनम्|जिगर्जयिषणम्|गर्जयित्वा|जिगर्जयिषित्वा|सङ्गर्ज्य|सञ्जिगर्जयिष्य|गर्जम्|जिगर्जयिषम्
<ul><li><sup id="ref_krm_0386_01"><a href="#foot_krm_0386_01">1</a></sup> {@“गर्ज शब्दे”@} <sup id="ref_krm_0386_02"><a href="#foot_krm_0386_02">2</a></sup> केषाञ्चिन्मतेनास्य धातोः चुरादौ पाठः। </li> <li>गर्जकः-र्जिका, जिगर्जयिषकः-षिका;</li> <li>  गर्जयिता-त्री, जिगर्जयिषिता-त्री;</li> <li>  गर्जयन्-न्ती, जिगर्जयिषन्-न्ती;</li> <li>  गर्जयिष्यन्-न्ती-ती, जिगर्जयिषिष्यन्-न्ती-ती;</li> <li>  गर्जयमानः, जिगर्जयिषमाणः;</li> <li>  गर्जयिष्यमाणः, जिगर्जयिषिष्यमाणः;</li> <li>  गर्ग्-गर्क्-गर्जौ-गर्जः;</li> <li>  -- <sup id="ref_krm_0386_03"><a href="#foot_krm_0386_03">3</a></sup> गर्जितम्-तः-तवान्, जिगर्जयिषितः-तवान्;</li> <li>  गर्जः, जिगर्जयिषुः;</li> <li>  गर्जयितव्यम्, जिगर्जयिषितव्यम्;</li> <li>  गर्जनीयम्, जिगर्जयिषणीयम्;</li> <li>  <sup id="ref_krm_0386_04"><a href="#foot_krm_0386_04">4</a></sup> गर्ज्यम्, जिगर्जयिष्यम्;</li> <li>  ईषद्गर्जः-दुर्गर्जः-सुगर्जः;</li> <li>  -- गर्ज्यमानः, जिगर्जयिष्यमाणः;</li> <li>  गर्जः, जिगर्जयिषः;</li> <li>  गर्जयितुम्, जिगर्जयिषितुम्;</li> <li>  गर्जना, जिगर्जयिषा;</li> <li>  गर्जनम्, जिगर्जयिषणम्;</li> <li>  गर्जयित्वा, जिगर्जयिषित्वा;</li> <li>  सङ्गर्ज्य, सञ्जिगर्जयिष्य;</li> <li>  गर्जम् २, गर्जयित्वा २, जिगर्जयिषम् २;</li> <li>  जिगर्जयिषित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0386_01"><a href="#ref_krm_0386_01">↑</a> (३७८)</li> <li id="foot_krm_0386_02"><a href="#ref_krm_0386_02">↑</a> (१०-चुरादिः-१६६५। अक। सेट्। उभ।)</li> <li id="foot_krm_0386_03"><a href="#ref_krm_0386_03">↑</a> [[B। ‘खेदस्त्वियान् पटहगर्दनगर्जिताशे रङ्गे सगर्धनसुगुर्दितवीरलोके। मञ्चाग्रपूर्वितनृपे शिशुना रणं वः स्यादेव मानपरिजंसकमीड्यधाम्नाम्।।’ धा। का। ३-३१।]]</li> <li id="foot_krm_0386_04"><a href="#ref_krm_0386_04">↑</a> [पृष्ठम्०३७५+ २७]</li></ul></p>

गर्द|गर्दकः-र्दिका|जिगर्दिषकः-षिका|जागर्दकः-र्दिका
<ul><li><sup id="ref_krm_0387_01"><a href="#foot_krm_0387_01">1</a></sup> {@“गर्द शब्दे”@} <sup id="ref_krm_0387_02"><a href="#foot_krm_0387_02">2</a></sup> गर्दकः-र्दिका, गर्दकः-र्दिका, जिगर्दिषकः-षिका, जागर्दकः-र्दिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि कर्जतिवत् <sup id="ref_krm_0387_03"><a href="#foot_krm_0387_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0387_04"><a href="#foot_krm_0387_04">4</a></sup> इति औणादिके अपच्प्रत्यये रूपम्।]] गर्दभः <sup id="ref_krm_0387_05"><a href="#foot_krm_0387_05">5</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0387_01"><a href="#ref_krm_0387_01">↑</a> (३७९)</li> <li id="foot_krm_0387_02"><a href="#ref_krm_0387_02">↑</a> (१-भ्वादिः-५७। अक। सेट्। पर।)</li> <li id="foot_krm_0387_03"><a href="#ref_krm_0387_03">↑</a> (१६९)</li> <li id="foot_krm_0387_04"><a href="#ref_krm_0387_04">↑</a> [[१। ‘कॄगॄशॄशलिगर्दिभ्योऽभच्’ [द। उ। ७-१८]</li> <li id="foot_krm_0387_05"><a href="#ref_krm_0387_05">↑</a> [[आ। ‘पलान्यखाद्यानि खदन् बदद्वपुः गदन् अवाच्यानि रदन् सतां मनः। नदन् मदादर्दितसंक्षयोऽधुना क्षणं खलो नर्दतु गर्दभस्वरैः।।’ धा। का। १। ८।]]</li></ul></p>

गर्द
<ul><li><sup id="ref_krm_0388_01"><a href="#foot_krm_0388_01">1</a></sup> {@“गर्द शब्दे”@} <sup id="ref_krm_0388_02"><a href="#foot_krm_0388_02">2</a></sup> केषाञ्चिन्मतेनास्याधिकः पाठः। </li> <li>चौरादिकगर्जयतिवत् <sup id="ref_krm_0388_03"><a href="#foot_krm_0388_03">3</a></sup> धातोरस्य रूपाण्यवगन्तव्यानि।।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0388_01"><a href="#ref_krm_0388_01">↑</a> (३८०)</li> <li id="foot_krm_0388_02"><a href="#ref_krm_0388_02">↑</a> (१०-चुरादिः-१६६५। अक। सेट्। उभ।)</li> <li id="foot_krm_0388_03"><a href="#ref_krm_0388_03">↑</a> (३७८)</li></ul></p>

गर्ध
<ul><li><sup id="ref_krm_0389_01"><a href="#foot_krm_0389_01">1</a></sup> {@“गर्ध अभिकाङ्क्षायाम्”@} <sup id="ref_krm_0389_02"><a href="#foot_krm_0389_02">2</a></sup> ‘गृधेर्गृध्यति काङ्क्षायां, गर्धेस्तत्रैव गर्धयेत्।’ <sup id="ref_krm_0389_03"><a href="#foot_krm_0389_03">3</a></sup> इति देवः। </li> <li>गर्धकः-र्धिका, जिगर्धयिषकः-षिका, इत्यादीनि अस्यापि धातोः चौरादिक। </li> <li>गर्जयतिवत् <sup id="ref_krm_0389_04"><a href="#foot_krm_0389_04">4</a></sup> सर्वाणि रूपाणि बोध्यानि। </li> <li><sup id="ref_krm_0389_05"><a href="#foot_krm_0389_05">5</a></sup> गर्धनम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0389_01"><a href="#ref_krm_0389_01">↑</a> (३८१)</li> <li id="foot_krm_0389_02"><a href="#ref_krm_0389_02">↑</a> (१०-चुरादिः-१६६५। सक। सेट्। उभ।)</li> <li id="foot_krm_0389_03"><a href="#ref_krm_0389_03">↑</a> (श्लो। १२३)</li> <li id="foot_krm_0389_04"><a href="#ref_krm_0389_04">↑</a> (३७८)</li> <li id="foot_krm_0389_05"><a href="#ref_krm_0389_05">↑</a> [[B। ‘खेदस्त्वियान् पटहगर्दनगर्जिताशे रङ्गे सगर्धनसुगुर्दितवीरलोके।’ धा। का। ३। ३१।]]</li></ul></p>

गर्ब|गर्बकः-र्बिका|जिगर्बिषकः-षिका|जागर्बकः-र्बिका
<ul><li><sup id="ref_krm_0390_01"><a href="#foot_krm_0390_01">1</a></sup> {@“गर्ब गतौ”@} <sup id="ref_krm_0390_02"><a href="#foot_krm_0390_02">2</a></sup> गर्बकः-र्बिका, गर्बकः-र्बिका, जिगर्बिषकः-षिका, जागर्बकः-र्बिका;</li> <li>  इत्यादीनि सर्वाणि रूपाणि भौवादिककर्बतिवत् <sup id="ref_krm_0390_03"><a href="#foot_krm_0390_03">3</a></sup> ज्ञेयानि।। </li> <li><sup id="ref_krm_0390_04"><a href="#foot_krm_0390_04">4</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0390_01"><a href="#ref_krm_0390_01">↑</a> (३८२)</li> <li id="foot_krm_0390_02"><a href="#ref_krm_0390_02">↑</a> (१-भ्वादिः-४२२। अक। सेट्। पर।)</li> <li id="foot_krm_0390_03"><a href="#ref_krm_0390_03">↑</a> (१७३)</li> <li id="foot_krm_0390_04"><a href="#ref_krm_0390_04">↑</a> [पृष्ठम्०३७६+ २८]</li></ul></p>

गर्व|गर्वकः-र्विका|जिगर्विषकः-षिका|जागर्वकः-र्विका
<ul><li><sup id="ref_krm_0391_01"><a href="#foot_krm_0391_01">1</a></sup> {@“गर्व दर्पे”@} <sup id="ref_krm_0391_02"><a href="#foot_krm_0391_02">2</a></sup> ‘माने गर्वयते, दर्पे गर्वतीति भवेच्छपि।।’ <sup id="ref_krm_0391_03"><a href="#foot_krm_0391_03">3</a></sup> इति देवः। </li> <li>गर्वकः-र्विका, गर्वकः-र्विका, जिगर्विषकः-षिका, जागर्वकः-र्विका;</li> <li>  इत्यादीनि रूपाणि भौवादिककर्वतिवत् <sup id="ref_krm_0391_04"><a href="#foot_krm_0391_04">4</a></sup> ऊह्यानि। </li> <li><sup id="ref_krm_0391_05"><a href="#foot_krm_0391_05">5</a></sup> गर्वः-घञ्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0391_01"><a href="#ref_krm_0391_01">↑</a> (३८३)</li> <li id="foot_krm_0391_02"><a href="#ref_krm_0391_02">↑</a> (१-भ्वादिः-५८३। सक। सेट्। पर।)</li> <li id="foot_krm_0391_03"><a href="#ref_krm_0391_03">↑</a> (श्लो। १६१)</li> <li id="foot_krm_0391_04"><a href="#ref_krm_0391_04">↑</a> (१७३-आ)</li> <li id="foot_krm_0391_05"><a href="#ref_krm_0391_05">↑</a> [[आ। ‘अफर्विताकाङ्क्षितमर्वकं सतां मांसादिसञ्चर्वकदुष्टभर्वकम्। कर्वद्वधूकेलिरसेन खर्वितं गर्वार्वकं शर्वपरेण सर्वताम्।।’ धा। का। १-७४।]]</li></ul></p>

गर्व|गर्वकः-र्विका|जिगर्वयिषकः-षिका|गर्वयिता-त्री|जिगर्वयिषिता-त्री|गर्विता-त्री|-गर्वन्-न्ती|गर्विष्यन्-न्ती-ती|गर्वयमाणः|जिगर्वयिषमाणः|-|गर्वयिष्यमाणः|जिगर्वयिषिष्यमाणः|गर्व्-गर्वौ-गर्वः|गर्वितम्-तः|जिगर्वयिषितः|गर्वितम्-तः-तवान्|गर्वः|जिगर्वयिषुः|गर्वयितव्यम्|जिगर्वयिषितव्यम्|गर्वितव्यम्|गर्वणीयम्|जिगर्वयिषणीयम्|गर्व्यम्|जिगर्वयिष्यम्|ईषद्गर्वः-दुर्गर्वः-सुगर्वः|गर्व्यमाणः|जिगर्वयिष्यमाणः|जिगर्वयिषः|गर्वयितुम्|जिगर्वयिषितुम्|गर्वितुम्|गर्वणा|जिगर्वयिषा|गर्वा|गर्वणम्|जिगर्वयिषणम्|गर्वयित्वा|जिगर्वयिषित्वा|गर्वित्वा|प्रगर्व्य|प्रजिगर्वयिष्य|सङ्गर्व्य|गर्वम्|जिगर्वयिषम्
<ul><li><sup id="ref_krm_0392_01"><a href="#foot_krm_0392_01">1</a></sup> {@“गर्व माने”@} <sup id="ref_krm_0392_02"><a href="#foot_krm_0392_02">2</a></sup> आगर्वीयः, अदन्तश्चायं धातुः। </li> <li>मानम् = अमिमानः। </li> <li>‘माने गर्वयते, दर्पे गर्वतीति भवेच्छपि।।’ <sup id="ref_krm_0392_03"><a href="#foot_krm_0392_03">3</a></sup> इति देवः। </li> <li>गर्वकः-र्विका, जिगर्वयिषकः-षिका, <sup id="ref_krm_0392_04"><a href="#foot_krm_0392_04">4</a></sup> गर्वकः-र्विका;</li> <li>  गर्वयिता-त्री, जिगर्वयिषिता-त्री, गर्विता-त्री;</li> <li>  -- <sup id="ref_krm_0392_05"><a href="#foot_krm_0392_05">5</a></sup> गर्वन्-न्ती, गर्विष्यन्-न्ती-ती;</li> <li>  <sup id="ref_krm_0392_06"><a href="#foot_krm_0392_06">6</a></sup> गर्वयमाणः, जिगर्वयिषमाणः;</li> <li>  -- गर्वयिष्यमाणः, जिगर्वयिषिष्यमाणः;</li> <li>  -- गर्व्-गर्वौ-गर्वः, -- गर्व्-गर्वौ-गर्वः;</li> <li>  गर्वितम्- <sup id="ref_krm_0392_07"><a href="#foot_krm_0392_07">7</a></sup> तः, जिगर्वयिषितः, गर्वितम्-तः-तवान्;</li> <li>  गर्वः, जिगर्वयिषुः, गर्वः;</li> <li>  गर्वयितव्यम्, जिगर्वयिषितव्यम्, गर्वितव्यम्;</li> <li>  गर्वणीयम्, जिगर्वयिषणीयम्, गर्वणीयम्;</li> <li>  गर्व्यम्, जिगर्वयिष्यम्, गर्व्यम्;</li> <li>  ईषद्गर्वः-दुर्गर्वः-सुगर्वः;</li> <li>  -- -- गर्व्यमाणः, जिगर्वयिष्यमाणः, गर्व्यमाणः;</li> <li>  गर्वः, जिगर्वयिषः, गर्वः;</li> <li>  <sup id="ref_krm_0392_08"><a href="#foot_krm_0392_08">8</a></sup> गर्वयितुम्, जिगर्वयिषितुम्, गर्वितुम्;</li> <li>  गर्वणा, जिगर्वयिषा, गर्वा;</li> <li>  गर्वणम्, जिगर्वयिषणम्, गर्वणम्;</li> <li>  गर्वयित्वा, जिगर्वयिषित्वा, गर्वित्वा;</li> <li>  प्रगर्व्य, प्रजिगर्वयिष्य, सङ्गर्व्य;</li> <li>  गर्वम् २, गर्वयित्वा २, जिगर्वयिषम् २, जिगर्वयिषित्वा २, गर्वम् २;</li> <li>  गर्वित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0392_01"><a href="#ref_krm_0392_01">↑</a> (३८४)</li> <li id="foot_krm_0392_02"><a href="#ref_krm_0392_02">↑</a> (१०-चुरादिः-१९०७। सक। सेट्। आत्म।)</li> <li id="foot_krm_0392_03"><a href="#ref_krm_0392_03">↑</a> (श्लो। १६१)</li> <li id="foot_krm_0392_04"><a href="#ref_krm_0392_04">↑</a> [[१। अदन्तपाठसामर्थ्यात् णिचो वैकल्पिकत्वम्। णिजभावपक्षे, सन्नन्ताद्यङन्ताच्च कर्वतिवत् (१७३-आ) रूपाणि ज्ञेयानि।]]</li> <li id="foot_krm_0392_05"><a href="#ref_krm_0392_05">↑</a> [[२। णिजभावपक्षे ‘शेषात् कर्तरि--’ (१-३-७८) इति शतैव।]]</li> <li id="foot_krm_0392_06"><a href="#ref_krm_0392_06">↑</a> [[३। ‘आ गर्वादात्मनेपदिनः’ (गणसूत्रं चुरादौ) इति आत्मनेपदम्। शानच्।]]</li> <li id="foot_krm_0392_07"><a href="#ref_krm_0392_07">↑</a> [[B। ‘द्रष्टॄणां कुहकोऽथ शूरयितृभिः स्तुत्योऽसिना वीरयां- चक्रे स्थूलितभीतिरर्थितवधः सत्राशनैर्गर्वितैः।।’ धा। का। ३। ५८।]]</li> <li id="foot_krm_0392_08"><a href="#ref_krm_0392_08">↑</a> [पृष्ठम्०३७७+ २७]</li></ul></p>

