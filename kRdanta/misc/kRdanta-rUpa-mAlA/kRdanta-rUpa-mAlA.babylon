<ul><li><sup id="ref_krm_1418_01"><a href="#foot_krm_1418_01">1</a></sup> {@“रिष हिंसार्थः”@} <sup id="ref_krm_1418_02"><a href="#foot_krm_1418_02">2</a></sup> रेषकः-षिका, रेषकः-षिका, <sup id="ref_krm_1418_03"><a href="#foot_krm_1418_03">3</a></sup> रिरिषिषकः-रिरेषिषकः-षिका, रेरिषकः-षिका;</li> <li>  <sup id="ref_krm_1418_04"><a href="#foot_krm_1418_04">4</a></sup> <sup id="ref_krm_1418_05"><a href="#foot_krm_1418_05">5</a></sup> रेषिता-त्री- <sup id="ref_krm_1418_06"><a href="#foot_krm_1418_06">6</a></sup> रेष्टा-रेष्ट्री, रेषयिता-त्री, रिरिषिषिता-रिरेषिषिता-त्री, रेरिषिता-त्री;</li> <li>  रेषन्-न्ती, रेषयन्-न्ती, रिरिषिषन्-रिरेषिषन्-न्ती;</li> <li>  -- रेषिष्यन्-न्ती-ती, रेषयिष्यन्-न्ती-ती, रिरिषिषिष्यन्-रिरेषिषिष्यन्-न्ती-ती;</li> <li>  -- -- रेषयमाणः, रेषयिष्यमाणः, रेरिष्यमाणः, रेरिषिष्यमाणः;</li> <li>  रिट्-रिड्-रिषौ-रिषः;</li> <li>  -- -- -- <sup id="ref_krm_1418_07"><a href="#foot_krm_1418_07">7</a></sup> रिष्टम्-ष्टः, रेषितः, रिरिषिषितः-रिरेषिषितः, रेरिषितः-तवान्;</li> <li>  रेषः, <sup id="ref_krm_1418_08"><a href="#foot_krm_1418_08">8</a></sup> रेषणः, <sup id="ref_krm_1418_09"><a href="#foot_krm_1418_09">9</a></sup> अरिष्टः, <sup id="ref_krm_1418_10"><a href="#foot_krm_1418_10">10</a></sup> रेट्-रेषौ-रेषः, रेषः, रिषिषिषुः-रिरेषिषुः, रेरेषः;</li> <li>  रेषितव्यम्-रेष्टव्यम्, रेषयितव्यम्, रिरिषिषितव्यम्-रिरेषिषितव्यम्, रेरिषितव्यम्;</li> <li>  रेषणीयम्, रेषणीयम्, रिरिषिषणीयम्-रिरेषिषणीयम्, रेरिषणीयम्;</li> <li>  रेष्यम्, रेष्यम्, रिरिषिष्यम्-रिरेषिष्यम्, रेरिष्यम्;</li> <li>  ईषद्रेषः-दूरेषः-सुरेषः;</li> <li>  -- -- -- रिष्यमाणः, रेष्यमाणः, रिरिषिष्यमाणः-रिरेषिष्यमाणः, रेरिष्यमाणः;</li> <li>  रेषः, रेषः, रिरिषिषः-रिरेषिषः, रेरिषः;</li> <li>  रेषितुम्-रेष्टुम्, रेषयितुम्, रिरिषिषितुम्-रिरेषिषितुम्, रेरिषितुम्;</li> <li>  रिष्टिः, रेषणा, रिरिषिषा-रिरेषिषा, रेरिषा;</li> <li>  रेषणम्, रेषणम्, रिरिषिषणम्-रिरेषिषणम्, रेरिषणम्;</li> <li>  <sup id="ref_krm_1418_11"><a href="#foot_krm_1418_11">11</a></sup> रिषित्वा-रेषित्वा-रिष्ट्वा, रेषयित्वा, रिरिषिषित्वा-रिरेषिषित्वा, रेरिषित्वा;</li> <li>  प्ररिष्य, प्ररेष्य, प्ररिरिषिष्य-प्ररिरेषिष्य, प्ररेरिष्य;</li> <li>  <sup id="ref_krm_1418_12"><a href="#foot_krm_1418_12">12</a></sup> रेषम् २, रिषित्वा २, रेषित्वा २, रिष्ट्वा २, रेषम् २ रेषयित्वा २ रिरिषिषम् २ -रिरेषिषम् २, रिरिषिषित्वा २ -रिरेषिषित्वा २, रेरिषम् २;</li> <li>  रेरिषित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1418_01"><a href="#ref_krm_1418_01">↑</a> (१४०८)</li> <li id="foot_krm_1418_02"><a href="#ref_krm_1418_02">↑</a> (१-भ्वादिः-६९४। सक। सेट्। पर।)</li> <li id="foot_krm_1418_03"><a href="#ref_krm_1418_03">↑</a> [[३। ‘रलो व्युपधाद्धलादेः संश्च’ (१-२-२६) इति सनः कित्त्वविकल्पः। तेन रूपद्वयम्।]]</li> <li id="foot_krm_1418_04"><a href="#ref_krm_1418_04">↑</a> [पृष्ठम्११२०+ २४]</li> <li id="foot_krm_1418_05"><a href="#ref_krm_1418_05">↑</a> [[१। ‘तीषसहलुभरुषरिषः’ (७-२-४८) इति तकारादावार्धधातुके इड्विकल्पः। इडभाव- पक्षे ‘ष्टुना ष्टुः’ (८-४-४१) इति ष्टुत्वेन टकारः।]]</li> <li id="foot_krm_1418_06"><a href="#ref_krm_1418_06">↑</a> [[आ। ‘रेष्टारं रेषितुं व्यास्यत् रोष्टाऽक्षः शस्त्रसंहतीः।।’ भ। का। ९। ३१।]]</li> <li id="foot_krm_1418_07"><a href="#ref_krm_1418_07">↑</a> [[२। ‘यस्य विभाषा’ (७-२-१५) इति निष्ठायामिण्निषेधः।]]</li> <li id="foot_krm_1418_08"><a href="#ref_krm_1418_08">↑</a> [[३। बाहुलकेन नन्द्यादित्वकल्पनात् कर्तरि ल्युप्रत्ययः।]]</li> <li id="foot_krm_1418_09"><a href="#ref_krm_1418_09">↑</a> [[४। ‘क्तिच्क्तौ च--’ (३-३-१७४) इति संज्ञायां क्तः। अरिष्टः = अनिष्टादिकम्।]]</li> <li id="foot_krm_1418_10"><a href="#ref_krm_1418_10">↑</a> [[५। ‘अन्येभ्योऽपि दृश्यन्ते’ (३-२-७५) इति विच्। गुणः।]]</li> <li id="foot_krm_1418_11"><a href="#ref_krm_1418_11">↑</a> [[६। ‘रलो व्युपधात्--’ (१-२-२६) इति कित्त्वविकल्पः। ‘तीषसहलुभरुषरिषः’ (७-२-४८) इति इड्विकल्पश्च। तेनात्र रूपत्रयम्।]]</li> <li id="foot_krm_1418_12"><a href="#ref_krm_1418_12">↑</a> [पृष्ठम्११२१+ २५]</li></ul></p>

रिष|सिःकौमुद्यादिषु|तु|स्वतन्त्रेण|पठ्यते।]]|रेषकः-षिका|रिरिषिषकः-रिरेषिषकः-षिका|रेरिषकः-षिका|रेषिता-रेष्टा-ष्टी|रेषयिता-त्री|रिरिषिषिता-रिरेषिषिता-त्री|रेरिषिता-त्री
<ul><li><sup id="ref_krm_1419_01"><a href="#foot_krm_1419_01">1</a></sup> {@“रिष हिंसायाम्”@} <sup id="ref_krm_1419_02"><a href="#foot_krm_1419_02">2</a></sup> <sup id="ref_krm_1419_03"><a href="#foot_krm_1419_03">3</a></sup> “इह केचित् ‘रिष हिंसायां च’ इति पठन्ति। </li> <li>‘न रिष्यति न व्यथते’ इत्यादयश्च प्रयोगा दृश्यन्ते। </li> <li>आत्रेयमैत्रेयादयस्तु न पेठुः” इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>क्षीरतरङ्गिण्याम् अयं धातुः दिवादिषु न दृश्यते। </li> <li>परं तु भ्वादौ ‘दिवादौ रिष्यति।’ इति क्षीरस्वामिनैवोक्तम्। </li> <li>तेन दिवादिषु पठितोऽप्य- धुना भ्रष्टः स्यादिति भाति। </li> <li>सिःकौमुद्यादिषु तु स्वतन्त्रेण पठ्यते।]] रेषकः-षिका, रेषकः-षिका, रिरिषिषकः-रिरेषिषकः-षिका, रेरिषकः-षिका;</li> <li>  <sup id="ref_krm_1419_04"><a href="#foot_krm_1419_04">4</a></sup> रेषिता-रेष्टा-ष्टी, रेषयिता-त्री, रिरिषिषिता-रिरेषिषिता-त्री, रेरिषिता-त्री;</li> <li>  इत्यादिकानि सर्वाण्यपि रूपाणि भौवादिकरेषतिवत् <sup id="ref_krm_1419_05"><a href="#foot_krm_1419_05">5</a></sup> बोध्यानि। </li> <li>शतरि-रिष्यन्-न्ती-ती, इति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1419_01"><a href="#ref_krm_1419_01">↑</a> (१४०९)</li> <li id="foot_krm_1419_02"><a href="#ref_krm_1419_02">↑</a> (४-दिवादिः-१२३१। सक। सेट्। पर।)</li> <li id="foot_krm_1419_03"><a href="#ref_krm_1419_03">↑</a> [[[अ]</li> <li id="foot_krm_1419_04"><a href="#ref_krm_1419_04">↑</a> [[१। ‘तीषसहलुभरुषरिषः’ (७-२-४८) इत्यत्र विशेषाभावात् दैवादिकस्यास्यापि ग्रहणम्। तेनेड्विकल्पः। ‘यथालक्षणमप्रयुक्ते’ इति भाष्यन्यायमाश्रित्यैवमुक्तम्। ‘यथा- ऽलक्षणमप्रयुक्ते’ इति भाष्यपाठाश्रयणे तु (अप्रयुक्तस्थले लक्षणस्याभाव एवेत्य- धुनाऽर्थः।) इड्विकल्पाभाव एवेति बोध्यम्।]]</li> <li id="foot_krm_1419_05"><a href="#ref_krm_1419_05">↑</a> (१४०८)</li></ul></p>

री|रायकः-यिका|रेपकः-पिका|रिरीषकः-षिका|रेरीयकः-यिका|रेता-रेत्री|रेपयिता-त्री|रिरीषिता-त्री|रेरीयिता-त्री
<ul><li><sup id="ref_krm_1420_01"><a href="#foot_krm_1420_01">1</a></sup> {@“री गतिरेषणयोः”@} <sup id="ref_krm_1420_02"><a href="#foot_krm_1420_02">2</a></sup> प्वादिः, ल्वादिश्च। </li> <li>‘स्रवणे रीयते रीङो, रिणाति गतिरेषयोः।।’ <sup id="ref_krm_1420_03"><a href="#foot_krm_1420_03">3</a></sup> इति देवः। </li> <li>‘रेषणम् = <sup id="ref_krm_1420_04"><a href="#foot_krm_1420_04">4</a></sup> हिंसा’ इति क्षीरस्वामी। </li> <li>“रेषणम् = वृकशब्दः। </li> <li>यदाह यादवप्रकाशः-- ‘वृकस्य रेषणं रेषा, ह्रेषा हेषा च वाजिनाम्। </li> <li>बृंहितं करिणां शब्दः--।।’ इति।” इति पुरुषकारः। </li> <li>गतिहिंसार्थयोः सकर्मकः, वृकरवार्थकत्वे तुं अकर्मक इति बोध्यम्। </li> <li>‘श्रवणे’ इत्यपि केचित्। </li> <li>‘-- गतिशोषणयोः’ इति न्यासे <sup id="ref_krm_1420_05"><a href="#foot_krm_1420_05">5</a></sup> पाठः। </li> <li><sup id="ref_krm_1420_06"><a href="#foot_krm_1420_06">6</a></sup> रायकः-यिका, <sup id="ref_krm_1420_07"><a href="#foot_krm_1420_07">7</a></sup> रेपकः-पिका, रिरीषकः-षिका, रेरीयकः-यिका;</li> <li>  रेता-रेत्री, रेपयिता-त्री, रिरीषिता-त्री, रेरीयिता-त्री;</li> <li>  इत्यादिकानि समस्तान्यपि रूपाणि क्रैयादिकप्लिनातिवत् <sup id="ref_krm_1420_08"><a href="#foot_krm_1420_08">8</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_1420_09"><a href="#foot_krm_1420_09">9</a></sup> व्यतिरिणानः, व्यति- रिणन्-ती, <sup id="ref_krm_1420_10"><a href="#foot_krm_1420_10">10</a></sup> रयः, <sup id="ref_krm_1420_11"><a href="#foot_krm_1420_11">11</a></sup> रीतिः, रीणिः, इतीमान्यस्माद्भवन्तीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1420_01"><a href="#ref_krm_1420_01">↑</a> (१४१०)</li> <li id="foot_krm_1420_02"><a href="#ref_krm_1420_02">↑</a> (९-क्र्यादिः-१५००। सक। अनि। पर।)</li> <li id="foot_krm_1420_03"><a href="#ref_krm_1420_03">↑</a> (श्लो। १८)</li> <li id="foot_krm_1420_04"><a href="#ref_krm_1420_04">↑</a> [[२। यदा तु रेषणशब्दस्य हिंसा अर्थः, तदानीं ‘रिष हिंसायाम्’ इति भौवादिक- धातोर्निष्पन्नं पदमेतदिति बोध्यम्। यदि वृकशब्दोऽर्थः--तर्हि ‘रेषृ अव्यक्ते शब्दे’ इति भौवादिकधातोर्निष्पन्नं तदिति भेदोऽत्रानुसन्धेयः।]]</li> <li id="foot_krm_1420_05"><a href="#ref_krm_1420_05">↑</a> (७-३-३६)</li> <li id="foot_krm_1420_06"><a href="#ref_krm_1420_06">↑</a> [पृष्ठम्११२२+ ३१]</li> <li id="foot_krm_1420_07"><a href="#ref_krm_1420_07">↑</a> [[१। ण्यन्ते सर्वत्र, ‘अर्तिह्रीव्लीरीक्नूयी--’ (७-३-३६) इत्यादिना पुगागमः। ‘पुगन्तलघूपधस्य च’ (७-३-८६) इति गुणः।]]</li> <li id="foot_krm_1420_08"><a href="#ref_krm_1420_08">↑</a> (१०८१)</li> <li id="foot_krm_1420_09"><a href="#ref_krm_1420_09">↑</a> [[२। हिंसागत्यर्थंयोः ‘न गतिहिंसार्थेभ्यः’ (१-३-१५) इति आत्मनेपदनिषेधात् कर्म- व्यतीहारेऽपि व्यतिरिणन् इति शतैव। शब्दार्थकत्वे तु ‘कर्तरि कर्मव्यतीहारे’ (१-३-१४) इति शानचि व्यतिरिणानः इति रूपमिति बोध्यम्।]]</li> <li id="foot_krm_1420_10"><a href="#ref_krm_1420_10">↑</a> [[३। भावे ‘एरच्’ (३-३-५६) इत्यचि रूपमेवम्। अभिधानस्वाभाव्याद् गत्यर्थ- कस्यास्य वेगे वृत्तिरत्रेति बोध्यम्। ‘कथं पुनरन्यो नामान्यस्यार्थे वर्तते? कथम् ऊहिर्वह्यर्थे वर्तते? बह्वर्था अपि धातघो भवन्ति…’ इति भाष्य (३-१-१३१)- वाक्यमिहावधेयम्।]]</li> <li id="foot_krm_1420_11"><a href="#ref_krm_1420_11">↑</a> [[४। क्तिचि रूपमेवम्। क्तिनि तु ‘ऋकारल्वादिभ्यः क्तिन् निष्ठावद् वाच्यः’ (वा। ८-२-४४) इति वचनात् रीणिः इति नत्वे णत्वे च भवति।]]</li></ul></p>

रीङ्|रायकः-यिका|रेपकः-पिका|रिरीषकः-षिका|रेरीयकः-यिका|रेता-रेत्री|रेपयिता-त्री|रिरीषिता-त्री|रेरीयिता-त्री
<ul><li><sup id="ref_krm_1421_01"><a href="#foot_krm_1421_01">1</a></sup> {@“रीङ् स्रवणे”@} <sup id="ref_krm_1421_02"><a href="#foot_krm_1421_02">2</a></sup> स्वादिः। </li> <li>‘स्रवणे रीयते रीङो रिणाति गतिरेषयोः।।’ <sup id="ref_krm_1421_03"><a href="#foot_krm_1421_03">3</a></sup> इति देवः। </li> <li>‘-- श्रवणेऽपि’ इति क्वचित् पाठः। </li> <li>रायकः-यिका, <sup id="ref_krm_1421_04"><a href="#foot_krm_1421_04">4</a></sup> रेपकः-पिका, रिरीषकः-षिका, रेरीयकः-यिका;</li> <li>  रेता-रेत्री, रेपयिता-त्री, रिरीषिता-त्री, रेरीयिता-त्री;</li> <li>  इत्यादिकानि सर्वाण्यपि रूपाणि क्रैयादिकप्लिनातिवत् <sup id="ref_krm_1421_05"><a href="#foot_krm_1421_05">5</a></sup> ज्ञेयानि। </li> <li>शानचि <sup id="ref_krm_1421_06"><a href="#foot_krm_1421_06">6</a></sup> रीयमाणः, <sup id="ref_krm_1421_07"><a href="#foot_krm_1421_07">7</a></sup> रीणः-रीणवान्, क्तिनि--रीतिः, <sup id="ref_krm_1421_08"><a href="#foot_krm_1421_08">8</a></sup> <sup id="ref_krm_1421_09"><a href="#foot_krm_1421_09">9</a></sup> रेवती, <sup id="ref_krm_1421_10"><a href="#foot_krm_1421_10">10</a></sup> इति णुप्रत्ययः।]] रेणुः, <sup id="ref_krm_1421_11"><a href="#foot_krm_1421_11">11</a></sup> इति असुन्प्रत्यये तुगागमे च रूपम्।]] रेतः इतीमानि रूपाण्यस्मात् भवन्तीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1421_01"><a href="#ref_krm_1421_01">↑</a> (१४११)</li> <li id="foot_krm_1421_02"><a href="#ref_krm_1421_02">↑</a> (४-दिवादिः-११३८। अक। अनि। आत्म।)</li> <li id="foot_krm_1421_03"><a href="#ref_krm_1421_03">↑</a> (श्लो। १८)</li> <li id="foot_krm_1421_04"><a href="#ref_krm_1421_04">↑</a> [[५। निरनुबन्धकपरिभाषानाश्रयणेनात्रापि, ‘अर्त्तिह्रीव्लीरी--’ (७-३-३६) इति पुगागमः। ‘पुगन्त--’ (७-३-८६) इति गुणः। तदुक्तम् न्यासे, ‘तेन निरनु- बन्धकपरिभाषा नापेक्ष्यत इति रीङोऽपि ग्रहणं भवति।’ (७-३-३६) इति।]]</li> <li id="foot_krm_1421_05"><a href="#ref_krm_1421_05">↑</a> (१०८१)</li> <li id="foot_krm_1421_06"><a href="#ref_krm_1421_06">↑</a> [[६। शानचि दिवादित्वात् श्यन्। तस्य ङिद्वद्भावेन गुणो न।]]</li> <li id="foot_krm_1421_07"><a href="#ref_krm_1421_07">↑</a> [[७। ‘स्वादय ओदितः’ (ग। सू। दिवादौ) इति धातोरस्य ओदित्त्वमातिदेशिकम्। तेन, ‘ओदितश्च’ (८-२-४५) इति निष्ठानत्वम्। णत्वम्। “अत्रात्रेयः। ‘अर्थनिर्देशे शृणोतेरयं प्रयोग इति केचित्।’ तथा च रीणशब्दः कर्णपर्यायः कथितः।” इति माधवधातुवृत्तौ दृश्यते। श्रवणार्थकत्वमस्य धातोः, तत्रापि कर्णपर्यायस्य रीणशब्दस्य प्रयोगश्चास्यान्वेष्टव्यः।]]</li> <li id="foot_krm_1421_08"><a href="#ref_krm_1421_08">↑</a> [पृष्ठम्११२३+ २६]</li> <li id="foot_krm_1421_09"><a href="#ref_krm_1421_09">↑</a> [[१। कर्तरि विच्प्रत्यये, तदन्तात् मतुपि, उगित्त्वेन स्त्रियां ङीपि च रेवती इति सिद्ध्यति।]]</li> <li id="foot_krm_1421_10"><a href="#ref_krm_1421_10">↑</a> [[२। ‘अजिवृरीभ्यो निच्च’ [द। उ। १-१४८]</li> <li id="foot_krm_1421_11"><a href="#ref_krm_1421_11">↑</a> [[३। ‘स्रुरीभ्यां तुट् च’ [द। उ। ९-६२]</li></ul></p>

रु|रावकः-विका|रुरूषकः-रिरावयिषकः-षिका|रोरूयकः-यिका|रविता-त्री|रावयिता-त्री|रुरूषिता-रिरावयिषिता-त्री|रोरूयिता-त्री
<ul><li><sup id="ref_krm_1422_01"><a href="#foot_krm_1422_01">1</a></sup> {@“रु शब्दे”@} <sup id="ref_krm_1422_02"><a href="#foot_krm_1422_02">2</a></sup> ‘-- रवते रौति शब्दने।।’ <sup id="ref_krm_1422_03"><a href="#foot_krm_1422_03">3</a></sup> इति देवः। </li> <li>रावकः-विका, रावकः-विका, <sup id="ref_krm_1422_04"><a href="#foot_krm_1422_04">4</a></sup> रुरूषकः- <sup id="ref_krm_1422_05"><a href="#foot_krm_1422_05">5</a></sup> रिरावयिषकः-षिका, रोरूयकः-यिका;</li> <li>  रविता-त्री, रावयिता-त्री, रुरूषिता-रिरावयिषिता-त्री, रोरूयिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि आदादिकक्ष्णौतिवत् <sup id="ref_krm_1422_06"><a href="#foot_krm_1422_06">6</a></sup> बोद्ध्यानि। </li> <li><sup id="ref_krm_1422_07"><a href="#foot_krm_1422_07">7</a></sup> इति युच्प्रत्यये निष्पादितवान्।]] रवणः, <sup id="ref_krm_1422_08"><a href="#foot_krm_1422_08">8</a></sup> संरावः, <sup id="ref_krm_1422_09"><a href="#foot_krm_1422_09">9</a></sup> <sup id="ref_krm_1422_10"><a href="#foot_krm_1422_10">10</a></sup> रवः, <sup id="ref_krm_1422_11"><a href="#foot_krm_1422_11">11</a></sup> रावः, <sup id="ref_krm_1422_12"><a href="#foot_krm_1422_12">12</a></sup> अल्परावः, मञ्जुरावः, <sup id="ref_krm_1422_13"><a href="#foot_krm_1422_13">13</a></sup> आरावः-आरवः, <sup id="ref_krm_1422_14"><a href="#foot_krm_1422_14">14</a></sup> मयूरः, <sup id="ref_krm_1422_15"><a href="#foot_krm_1422_15">15</a></sup> <sup id="ref_krm_1422_16"><a href="#foot_krm_1422_16">16</a></sup> रुरूषुः, <sup id="ref_krm_1422_17"><a href="#foot_krm_1422_17">17</a></sup> ध्वाङ्क्षरावी, <sup id="ref_krm_1422_18"><a href="#foot_krm_1422_18">18</a></sup> मण्डूकरावी, <sup id="ref_krm_1422_19"><a href="#foot_krm_1422_19">19</a></sup> सांराविणम् <sup id="ref_krm_1422_20"><a href="#foot_krm_1422_20">20</a></sup>, <sup id="ref_krm_1422_21"><a href="#foot_krm_1422_21">21</a></sup> रोरूयः <sup id="ref_krm_1422_22"><a href="#foot_krm_1422_22">22</a></sup> लोकरावणः, <sup id="ref_krm_1422_23"><a href="#foot_krm_1422_23">23</a></sup> रविः, <sup id="ref_krm_1422_24"><a href="#foot_krm_1422_24">24</a></sup> रुरुः, <sup id="ref_krm_1422_25"><a href="#foot_krm_1422_25">25</a></sup> पुरूरवाः इतीमान्यस्माद् भवन्ति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1422_01"><a href="#ref_krm_1422_01">↑</a> (१४१२)</li> <li id="foot_krm_1422_02"><a href="#ref_krm_1422_02">↑</a> (२-अदादिः-१०३४। अक। सेट्। पर।)</li> <li id="foot_krm_1422_03"><a href="#ref_krm_1422_03">↑</a> (श्लो। २३)</li> <li id="foot_krm_1422_04"><a href="#ref_krm_1422_04">↑</a> [[४। धातोरस्य सेट्त्वेऽपि, ‘सनि ग्रहगुहोश्च’ (७-२-१२) इतीण्निषेधः। ‘इको झल्’ (१-२-९) इति झलादिसनः कित्त्वम्। ‘अज्झनगमां सनि’ (६-४-१६) इति दीर्घः। षत्वम्। एवं सन्नन्ते सर्वत्र प्रक्रियोह्या।]]</li> <li id="foot_krm_1422_05"><a href="#ref_krm_1422_05">↑</a> [[५। ण्यन्तात् सनि, ‘ओः पुयण्ज्यपरे’ (७-४-८०) इति अभ्यासस्येकारः।]]</li> <li id="foot_krm_1422_06"><a href="#ref_krm_1422_06">↑</a> (३२३)</li> <li id="foot_krm_1422_07"><a href="#ref_krm_1422_07">↑</a> [[६। तच्छीलादिषु कर्तृषु, ‘चलनशब्दार्थादकर्मकात्--’ (३-२-१४८) इति युच्। णत्वम्। क्षीरस्वामी तु औणादिके ‘सुयुरुवृञो युच्’ [द। उ। ५-२०]</li> <li id="foot_krm_1422_08"><a href="#ref_krm_1422_08">↑</a> [[७। ‘उपसर्गे रुवः’ (३-३-२२) इति घञ्। उवर्णान्तत्वप्रयुक्तापोऽपवादः।]]</li> <li id="foot_krm_1422_09"><a href="#ref_krm_1422_09">↑</a> [[आ। ‘सजलाम्भोदसंरावं हनुमन्तं सहाङ्गदम्।’ भ। का। ७। ३५।]]</li> <li id="foot_krm_1422_10"><a href="#ref_krm_1422_10">↑</a> [[८। अनुपसृष्टात् (शुद्धात्) ‘ऋदोरप्’ (३-३-५७) इति अप्प्रत्ययः।]]</li> <li id="foot_krm_1422_11"><a href="#ref_krm_1422_11">↑</a> [[९। ‘बाहुलकाद् घञपि, इत्यात्रेयः। रावः।’ इति माधवधातुवृत्तिः। “-- ‘कृत्यल्युटो बहुलम्’ (३-३-११३) इत्यनेन घञबादयः। बहुलं व्यतिकीर्यन्ते मञ्जुरावादयस्तथा।।” इति प्रक्रियासर्वस्वश्लोक इहावधेयः।]]</li> <li id="foot_krm_1422_12"><a href="#ref_krm_1422_12">↑</a> [[B। ‘केऽप्यल्परावं नुनुवुः खलेषु क्षुरक्ष्णुतात्मानममुं स्नुतास्त्राः।’ धा। का। २। ४७।]]</li> <li id="foot_krm_1422_13"><a href="#ref_krm_1422_13">↑</a> [[१०। ‘विभाषाऽऽङि रुप्लुवोः’ (३-३-५०) इति घञ्विकल्पः। तेन पक्षेऽप्प्रत्ययः।]]</li> <li id="foot_krm_1422_14"><a href="#ref_krm_1422_14">↑</a> [[११। मह्यां रौतीति मयूरः। ‘अन्येष्वपि दृश्यते’ (३-२-१०१) इति डप्रत्यये पृषोदरा- दिषु (६-३-१०९) पाठात् महीशब्दस्य ‘मयू’ इत्यादेशे च रूपमेवम्।]]</li> <li id="foot_krm_1422_15"><a href="#ref_krm_1422_15">↑</a> [पृष्ठम्११२४+ ३९]</li> <li id="foot_krm_1422_16"><a href="#ref_krm_1422_16">↑</a> [[आ। ‘संजुघुक्षव आयूंषि ततः प्रतिरुरूषवः।’ भ। का। ९। १४।]]</li> <li id="foot_krm_1422_17"><a href="#ref_krm_1422_17">↑</a> [[१। ध्वाङ्क्ष इव रौतीति ध्वाङ्क्षरावी। ‘कर्तर्युपमाने’ (३-२-७९) इति णिनिः।]]</li> <li id="foot_krm_1422_18"><a href="#ref_krm_1422_18">↑</a> [[B। ‘मण्डूकराविणं सर्पं गोमुखं च मृगादिनम्।’ (सुभाषितनीवी)]]</li> <li id="foot_krm_1422_19"><a href="#ref_krm_1422_19">↑</a> [[२। सम्पूर्वकादस्मात्, ‘अभिविधौ भाव इनुण्’ (३-३-४४) इति इनुण्प्रत्यये, ‘अण् इनुणः’ (५-४-१५) इति स्वार्थेऽण्प्रत्यये, ‘इन् अण्यनपत्ये’ (६-४-१६४) इति प्रकृतिभावे च सांराविणम् इति भवति।]]</li> <li id="foot_krm_1422_20"><a href="#ref_krm_1422_20">↑</a> [[C। ‘सांराविणं न कर्तव्यं यावन्नायाति दर्शनम्।’ भ। का। ७। ४३।]]</li> <li id="foot_krm_1422_21"><a href="#ref_krm_1422_21">↑</a> [[३। ‘उदन्तात् यङो लुङ् नेति केचित्।’ इति प्रक्रियाकौमुदी। तेनात्र यङन्तात् पचाद्यचि रूपमेवं तेषां मते। वस्तुतस्तु एवमङ्गीकरणे नियामकाभावात्, यङोऽनै- मित्तिकलुक एव भाष्यादिषु ‘यङोऽचि च’ (२-४-७४) इत्यत्राभ्युपगतत्वात् चिन्त्यमिदमिति रोरुवः इत्येव न्याय्यमिति च बोध्यम्।]]</li> <li id="foot_krm_1422_22"><a href="#ref_krm_1422_22">↑</a> [[४। लोकान् रावयतीति लोकरावणः। नन्द्यादित्वात् (३-१-१३४) ण्यन्तात् कर्तरि ल्युः। ‘रावणो लोकरावणः।’ इत्यादयः रामायणप्रयोगाः अत्रानु- सन्धेयाः।]]</li> <li id="foot_krm_1422_23"><a href="#ref_krm_1422_23">↑</a> [[५। ‘इन्’ (द। उ। १। ४६) इतीन्प्रत्ययः। रौतीति, रूयते इति वा रविः = भानुः।]]</li> <li id="foot_krm_1422_24"><a href="#ref_krm_1422_24">↑</a> [[६। ‘रुशातिभ्यां क्रुन्’ (द। उ। १। १५९) इति {??}न्प्रत्ययः। रुरुः = मृयः।]]</li> <li id="foot_krm_1422_25"><a href="#ref_krm_1422_25">↑</a> [[७। ‘पुरूरवाः’ (द। उ। ९-९२) इत्यसिप्रत्यये निरूढः। पुरु रूयते स्वयशः सर्वत्रेति पुरूरवाः = राजविशेषः। पुरुशब्दस्य दीर्घोऽपि निपातनात्।]]</li></ul></p>

रुङ्|अनिट्कारिकाप्रकरणे|पर्युदस्तेषुइत्यत्रइत्यनेन|निरनुबन्धकपरिभाषयाआदादिकरौतेरेव|ग्रहणम्|नास्य|रावकः-विका|रुरूषकः-रिरावयिषकः-षिका|रोरूयकः-यिका|रोता-रोत्री|रावयिता-त्री|रुरूषिता-त्री|रोरूयिता-त्री
<ul><li><sup id="ref_krm_1423_01"><a href="#foot_krm_1423_01">1</a></sup> {@“रुङ् गतिरेषणयोः”@} <sup id="ref_krm_1423_02"><a href="#foot_krm_1423_02">2</a></sup> <sup id="ref_krm_1423_03"><a href="#foot_krm_1423_03">3</a></sup> अनिट्कारिकाप्रकरणे, पर्युदस्तेषु ‘गणस्थमूदन्तम्, उतां च रुस्नुवौ--’ <sup id="ref_krm_1423_04"><a href="#foot_krm_1423_04">4</a></sup> इत्यत्र ‘रु’ इत्यनेन निरनुबन्धकपरिभाषया <sup id="ref_krm_1423_05"><a href="#foot_krm_1423_05">5</a></sup> आदादिकरौतेरेव ग्रहणम्, नास्य;</li> <li>  तेनास्यानिट्त्वमिति न्यास- कारादयः। </li> <li>तत्त्वबोधिन्यादिषु तु “-- ‘रु शब्दे, रुङ् गतिरेषणयोः’ इत्युभयोर्ग्रहणं निरनुबन्धकपरिभाषया, ‘लुग्विकरणालुग्विकरणयोः--’ <sup id="ref_krm_1423_06"><a href="#foot_krm_1423_06">6</a></sup> इति परिभाषया च। </li> <li>न च साहचर्यात् लुग्विकरणस्यैव ग्रहणम् इति शङ्क्यम्। </li> <li>तस्यानित्यत्वात्।” इति प्रतिपादनात् आदादिकरौतिवत् भौवादिकरवतेरपि पर्युदासेषु ग्रहणात् अस्यापि सेट्त्वमिति ज्ञायते। </li> <li>‘संनत्स्याम्यथ योद्धुं किं न रोष्ये सत्त्वहीनवत्।’ <sup id="ref_krm_1423_07"><a href="#foot_krm_1423_07">7</a></sup> इत्यत्र रोष्ये इति अनिट्त्वेन प्रयोगात् अनिट्- कारिकायां पर्युदासे भौवादिकस्य न ग्रहणमिति शब्दरस्नम्। </li> <li>परं तु जयमङ्ग- लादिप्राचीनव्याख्यादृतः, साम्प्रतमुपलभ्यमानश्च सार्वत्रिकः पाठः-- ‘संनत्स्याम्यथ वा योद्धुं न कोष्ये सत्त्वहीनवत्।’ इत्येवम्। </li> <li>अतो नैतदत्र गमकत्वेन प्रतीम इत्यलमत्र। </li> <li>उभयथाऽपि सन्नन्ते, ‘सनि ग्रहगुहोश्च’ <sup id="ref_krm_1423_08"><a href="#foot_krm_1423_08">8</a></sup> इतीण्निषेधः। </li> <li>तत्त्वबोधिनीकारादीनां मतेतृजादिषु इडागमे रविता-त्री, रवितव्यम् इत्या- दीनि रूपाणि यथायथं बोध्यानि।]] ‘-- रवते रौति <sup id="ref_krm_1423_09"><a href="#foot_krm_1423_09">9</a></sup> शब्दने।।’ <sup id="ref_krm_1423_10"><a href="#foot_krm_1423_10">10</a></sup> इति देवः। </li> <li>रावकः-विका, रावकः-विका, रुरूषकः-रिरावयिषकः-षिका, रोरूयकः-यिका;</li> <li>  <sup id="ref_krm_1423_11"><a href="#foot_krm_1423_11">11</a></sup> रोता-रोत्री, रावयिता-त्री, रुरूषिता-त्री, रोरूयिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककवतिवत् <sup id="ref_krm_1423_12"><a href="#foot_krm_1423_12">12</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1423_13"><a href="#foot_krm_1423_13">13</a></sup> रुतम् <sup id="ref_krm_1423_14"><a href="#foot_krm_1423_14">14</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1423_01"><a href="#ref_krm_1423_01">↑</a> (१४१३)</li> <li id="foot_krm_1423_02"><a href="#ref_krm_1423_02">↑</a> (१-भ्वादिः-९५९। सक। अनि। आत्म।)</li> <li id="foot_krm_1423_03"><a href="#ref_krm_1423_03">↑</a> [[[अ]</li> <li id="foot_krm_1423_04"><a href="#ref_krm_1423_04">↑</a> (व्याघ्रभूति- कारिका, काशिकायां ७-२-१०)</li> <li id="foot_krm_1423_05"><a href="#ref_krm_1423_05">↑</a> (परि। ८३)</li> <li id="foot_krm_1423_06"><a href="#ref_krm_1423_06">↑</a> (परि। ९२)</li> <li id="foot_krm_1423_07"><a href="#ref_krm_1423_07">↑</a> (भ। का। १६-२९)</li> <li id="foot_krm_1423_08"><a href="#ref_krm_1423_08">↑</a> (७-२-१२)</li> <li id="foot_krm_1423_09"><a href="#ref_krm_1423_09">↑</a> [[८। पाठेनानेन देवस्य शब्दार्थकत्वं भौवादिकस्यापि धातोः सम्मतमिति ज्ञायते। रेषणशब्दस्य वृकशब्दार्थत्वात् कथञ्चिदेवं नेयमिति पुरुषकारे विवेचितम्। ‘-- गतिरोषणयोः’ इति कुत्रचिद् दृष्टः पाठः।]]</li> <li id="foot_krm_1423_10"><a href="#ref_krm_1423_10">↑</a> (श्लो। २३)</li> <li id="foot_krm_1423_11"><a href="#ref_krm_1423_11">↑</a> [पृष्ठम्११२५+ २७]</li> <li id="foot_krm_1423_12"><a href="#ref_krm_1423_12">↑</a> (१९८)</li> <li id="foot_krm_1423_13"><a href="#ref_krm_1423_13">↑</a> [[१। इड्भाववादिनां मतेऽपि निष्ठादिषु कित्प्रत्ययेषु ‘श्रयुकः क्किति’ (७-२-११) इति निषेधात् इण्नेति बोध्यम्।]]</li> <li id="foot_krm_1423_14"><a href="#ref_krm_1423_14">↑</a> [[आ। ‘प्रवे भवाब्धिप्लवमारुतानां धृतामयं भक्तिनिमेयमङ्घ्रिम्।।’ धा। का। २-३६।]]</li></ul></p>

रुच|रोचकः-चिका|रुरोचिषकः-रुरुचिषकः-षिका|रोरुचकः-|चिका|रोचिता-त्री|रोचयिता-त्री|रुरोचिषिता-रुरुचिषिता-त्री|रोरुचिता-त्री
<ul><li><sup id="ref_krm_1424_01"><a href="#foot_krm_1424_01">1</a></sup> {@“रुच दीप्तौ अभिप्रीतौ च”@} <sup id="ref_krm_1424_02"><a href="#foot_krm_1424_02">2</a></sup> न्यासपदमञ्जर्यादिषु ‘अभिप्रीतौ’ इति न पठ्यते। </li> <li>‘अभिप्रीतिः = प्रीतिविषयीभवनम्।’ इति बालमनोरमा। </li> <li>रोचकः-चिका, रोचकः-चिका, रुरोचिषकः-रुरुचिषकः-षिका, <sup id="ref_krm_1424_03"><a href="#foot_krm_1424_03">3</a></sup> रोरुचकः- चिका;</li> <li>  रोचिता-त्री, रोचयिता-त्री, रुरोचिषिता-रुरुचिषिता-त्री, रोरुचिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककोचतिवत् <sup id="ref_krm_1424_04"><a href="#foot_krm_1424_04">4</a></sup> ज्ञेयानि। </li> <li>देवदत्ताय <sup id="ref_krm_1424_05"><a href="#foot_krm_1424_05">5</a></sup> रोचमानो मोदकः, <sup id="ref_krm_1424_06"><a href="#foot_krm_1424_06">6</a></sup> रोचयन्-न्ती, रोचयमानः, <sup id="ref_krm_1424_07"><a href="#foot_krm_1424_07">7</a></sup> रोचनः <sup id="ref_krm_1424_08"><a href="#foot_krm_1424_08">8</a></sup> रोचना, विरोचनः, <sup id="ref_krm_1424_09"><a href="#foot_krm_1424_09">9</a></sup> <sup id="ref_krm_1424_10"><a href="#foot_krm_1424_10">10</a></sup> रोचनी, <sup id="ref_krm_1424_11"><a href="#foot_krm_1424_11">11</a></sup> रुच्यः <sup id="ref_krm_1424_12"><a href="#foot_krm_1424_12">12</a></sup>, <sup id="ref_krm_1424_13"><a href="#foot_krm_1424_13">13</a></sup> रोच्यम्, <sup id="ref_krm_1424_14"><a href="#foot_krm_1424_14">14</a></sup> रोचिष्णुः <sup id="ref_krm_1424_15"><a href="#foot_krm_1424_15">15</a></sup>, <sup id="ref_krm_1424_16"><a href="#foot_krm_1424_16">16</a></sup> रुचिः-रुचिरम्, <sup id="ref_krm_1424_17"><a href="#foot_krm_1424_17">17</a></sup> नीरुक्--अभीरुक्, <sup id="ref_krm_1424_18"><a href="#foot_krm_1424_18">18</a></sup> रोकः <sup id="ref_krm_1424_19"><a href="#foot_krm_1424_19">19</a></sup>, <sup id="ref_krm_1424_20"><a href="#foot_krm_1424_20">20</a></sup> अरोचकः, <sup id="ref_krm_1424_21"><a href="#foot_krm_1424_21">21</a></sup> रुचकः, <sup id="ref_krm_1424_22"><a href="#foot_krm_1424_22">22</a></sup> रुक्मम्, <sup id="ref_krm_1424_23"><a href="#foot_krm_1424_23">23</a></sup> रुचिष्यम्, <sup id="ref_krm_1424_24"><a href="#foot_krm_1424_24">24</a></sup> वसुरोचिः-रोचिः, <sup id="ref_krm_1424_25"><a href="#foot_krm_1424_25">25</a></sup> इतीमानि रूपाण्यस्माद् भवन्तीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1424_01"><a href="#ref_krm_1424_01">↑</a> (१४१४)</li> <li id="foot_krm_1424_02"><a href="#ref_krm_1424_02">↑</a> (१-भ्वादिः-७४५। अक। सेट्। आत्म।)</li> <li id="foot_krm_1424_03"><a href="#ref_krm_1424_03">↑</a> [[२। “तच्च अवश्यम् अनभिधानमाश्रयितव्यम्। क्रियमाणेऽपि हि एकाज्झलादिग्रहणे यत्रैकाचो हलादेश्चोत्पद्यमानेन यङाऽर्थस्याभिधानं न भवति, न भवति तत्रोत्पत्तिः। तद् यथा भृशं शोभते, भृशं रोचते।” इति भाष्यात् (३-१-२२) अस्य धातोः भृशार्थे यङ् न। पौनःपुन्यार्थे तु यङ् भवति। एवञ्चात्र, ‘पौनःपुन्यं मृशार्थो वा क्रियासमभिहारः।’ इति शाब्दिकमर्यादया भृशार्थरूपक्रियासमभिहारार्थे न यङ्, पौनःपुन्यरूपक्रियासमभिहारार्थे तु यङ् भवतीति बोध्यम्।]]</li> <li id="foot_krm_1424_04"><a href="#ref_krm_1424_04">↑</a> (२००)</li> <li id="foot_krm_1424_05"><a href="#ref_krm_1424_05">↑</a> [[३। ‘रुच्यर्थानां प्रीयमाणः’ (१-४-३३) इति प्रीयमाणस्य संप्रदानसंज्ञायाम्, ‘चतुर्थी सम्प्रदाने’ (२-३-१३) इति चतुर्थी।]]</li> <li id="foot_krm_1424_06"><a href="#ref_krm_1424_06">↑</a> [[४। धातोरस्याकर्मकत्वात् अभिप्रीतिरूपार्थे चित्तवत्कर्तृकत्वादपि, ‘अणावकर्मकात्--’ (१-३-८८) इति कर्त्रभिप्राये प्राप्तस्य परस्मैपदस्य, ‘न पादम्याङ्यमाङ्यसपरिमुह- रुचिनृतिवदवसः’ (१-३-८९) इति निषेधात्, ‘णिचश्च’ (१-३-७४) इति यथा- संम्भवमुभयपदित्वमिति बोध्यम्। तेन शतृशानजन्तावुभावपि साधू इति बोध्यम्।]]</li> <li id="foot_krm_1424_07"><a href="#ref_krm_1424_07">↑</a> [[५। नन्द्यादिषु (३-१-१३४) ‘नन्दिवासिदमिदूषिमाधिवर्द्धिशोभिरोचिभ्यो ण्यन्तेभ्यः संज्ञायाम्’ (ग। सू।) इति वचनात् कर्तरि ल्युः। गुणः। रोचनः = कूटशाल्मलिः। स्त्रियामजादिषु (४-१-४) पाठात् टाप्।]]</li> <li id="foot_krm_1424_08"><a href="#ref_krm_1424_08">↑</a> [[B। ‘रोचनैर्भूषितां पम्पामस्माकं हृदयाविधम्।।’ भ। का। ६। ७४।]]</li> <li id="foot_krm_1424_09"><a href="#ref_krm_1424_09">↑</a> [पृष्ठम्११२६+ ३४]</li> <li id="foot_krm_1424_10"><a href="#ref_krm_1424_10">↑</a> [[१। रोचनी इत्यत्र ल्युटि, टित्त्वेन स्त्रियां ङीपि रूपम्।]]</li> <li id="foot_krm_1424_11"><a href="#ref_krm_1424_11">↑</a> [[२। ‘राजसूयसूर्यमृषोद्यरुच्य--’ (३-१-११४) इत्यादिना निपातनात् क्यप्। ‘सूर्य- रुच्याव्यथ्याः कर्तरि’ (वा। ३-१-११४) इति वचनात् कर्तरि निष्पन्नोऽयम्। रोचतेऽसौ रुच्यः।]]</li> <li id="foot_krm_1424_12"><a href="#ref_krm_1424_12">↑</a> [[आ। ‘अमृषोद्यं वदन् रुव्यो जगाहे द्यां निशाचरः।।’ भ। का। ६। ५८।]]</li> <li id="foot_krm_1424_13"><a href="#ref_krm_1424_13">↑</a> [[३। भावे ण्यति, ‘यजयाचरुच--’ (७-३-६६) इति निषेधात् कुत्वं न। ‘क्वाद्यजिव्रजि- याचिरुचीनामप्रतिषेधो निष्ठायामनिटः कुत्ववचनात्’ (वा। ७-३-५९) इति वार्तिकपक्षे तु रोक्यम् इति कुत्वेनैव भाव्यम्, ‘यथोत्तरं मुनीनां प्रामाण्यम्’ इति शाब्दिकसंकेतात्। यदि तु रोच्यम् इति प्रयोगो दृश्यते, तदानीं पृषोदरादित्वात् (६-३-१०९) कुत्वाभाव इति बोध्यम्।]]</li> <li id="foot_krm_1424_14"><a href="#ref_krm_1424_14">↑</a> [[४। ‘अलङ्कृञ्निराकृञ्प्रजनोत्पचोत्पतोन्मदरुचि--’ (३-२-१३६) इत्यादिना तच्छी- लादिषु कर्तृषु इष्णुच्प्रत्ययः।]]</li> <li id="foot_krm_1424_15"><a href="#ref_krm_1424_15">↑</a> [[B। ‘रोचिष्णुकाञ्चनचयाशुपिशङ्गिताशा…।’ शि। व। ५। २०।]]</li> <li id="foot_krm_1424_16"><a href="#ref_krm_1424_16">↑</a> [[५। स्त्रियाम्, ‘इक् कृष्यादिभ्यः’ (वा। ३-३-१०८) इति भावे इक्प्रत्ययः। रुचिशब्दात् मत्वर्थीयो रप्रत्ययो बाहुलकात् प्रयोगदर्शनाद् द्रष्टव्यः। रुचिरः = रुचिमान् इति यावत्।]]</li> <li id="foot_krm_1424_17"><a href="#ref_krm_1424_17">↑</a> [[६। क्विपि, ‘चोः कुः’ (८-२-३०) इति कुत्वे, ‘नहिवृतिवृषिव्यधिरुचिसहितनिषु क्वौ’ (६-३-११६) इति पूर्वपदस्य दीर्घः। ‘निरोचनम् = नीरुक्’ इति न्यासे विवरणात् बाहुलकात् करणे भावार्थे वा क्विबत्रेति ज्ञायते।]]</li> <li id="foot_krm_1424_18"><a href="#ref_krm_1424_18">↑</a> [[७। घञि, ‘चजोः कु घिण्ण्यतोः’ (७-३-५२) इति कुत्वम्, इति न्यासः (५-४-१४४)। परंतु निष्ठायामनिटो धातोरेव ‘चजोः--’ (७-३-५२) इति कुत्वमित्याश्रयितॄणां वार्तिककारभाष्यकारादीनां मते तु ‘विभाषा श्यावारोकाभ्याम्’ (५-४-१४४) इत्यत्र अरोक इति निपातनादेवात्र कुत्वमिति ज्ञेयम्।]]</li> <li id="foot_krm_1424_19"><a href="#ref_krm_1424_19">↑</a> [[C। ‘नासाविरोकपवनोल्लसितं तनीमो रोमाञ्चतामिव जगाम रजः पृथिव्याः।।’ शि। व। ५। ५४।]]</li> <li id="foot_krm_1424_20"><a href="#ref_krm_1424_20">↑</a> [[८। ‘अरोचकः’ इत्यत्र, ‘रोगाख्यायां ण्वुल् बहुलम्’ (३-३-१०८) इति ण्वुल्। अरोचकः = अरुचिव्याधिः। अत्र बहुलग्रहणात् स्त्र्यधिकारविहितत्वेऽपि स्त्रीत्वं नेति प्रक्रियासर्वस्वम्। अयं भावः-- ‘प्रत्ययस्थात्--’ (७-३-४४) इति इत्वं, टाबादिकं चास्य नेत्यर्थः।]]</li> <li id="foot_krm_1424_21"><a href="#ref_krm_1424_21">↑</a> [[९। ‘क्वुन् शिल्पिसंज्ञयोः--’ (द। उ। ३-५) इति क्वुन्। कित्त्वान्न गुणः। रुचकः। स्वर्णमयो भूषणविशेषः।]]</li> <li id="foot_krm_1424_22"><a href="#ref_krm_1424_22">↑</a> [[१०। ‘युजिरुचितिजां कुश्च’ (द। उ। ७-३३) इति मक्प्रत्ययः, कवर्गश्चान्तादेशः। प्रत्ययस्य कित्त्वान्न गुणः। रोचतेऽतिशयेन तदिति रुक्मम् = सुवर्णम्।]]</li> <li id="foot_krm_1424_23"><a href="#ref_krm_1424_23">↑</a> [[११। ‘रुचिभुजिभ्यां किष्यन्’ (द। उ। ८। १५) इति किष्यन्प्रत्ययः। रुचिष्यम् = भोज्यम्।]]</li> <li id="foot_krm_1424_24"><a href="#ref_krm_1424_24">↑</a> [[१२। ‘वसौ रुचेः संज्ञायाम्’ (द। उ। ९। ३३) इति इसिन्प्रत्ययः। वसुभ्यो रोचते, वसव अस्मिन् रोचन्ते इति वा वसुरोचिः = क्रतुः। बाहुलकात् ‘वसु’ इत्युपप- दाभावेऽपि केवलाद्धातोः इसिन्प्रत्यये रोचिः = ज्वाला।]]</li> <li id="foot_krm_1424_25"><a href="#ref_krm_1424_25">↑</a> [पृष्ठम्११२७+ ३२]</li></ul></p>

रुज|रोजकः-जिका|रुरोजयिषकः|षिका|रोजयिता-त्री|रुरोजयिषिता-त्री
<ul><li><sup id="ref_krm_1425_01"><a href="#foot_krm_1425_01">1</a></sup> {@“रुज हिंसायाम्”@} <sup id="ref_krm_1425_02"><a href="#foot_krm_1425_02">2</a></sup> आस्वदीयः। </li> <li>‘भङ्गे रुजति, हिंसायां रोजयेदिति णौ रुजेः।।’ श्लो। </li> <li>६९) इति देवः। </li> <li>रोजकः-जिका, रुरोजयिषकः षिका;</li> <li>  रोजयिता-त्री, रुरोजयिषिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिककोटयतिवत् <sup id="ref_krm_1425_03"><a href="#foot_krm_1425_03">3</a></sup> बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1425_01"><a href="#ref_krm_1425_01">↑</a> (१४१५)</li> <li id="foot_krm_1425_02"><a href="#ref_krm_1425_02">↑</a> (१०-चुरादिः-१८०५। सक। सेट्। उभ।)</li> <li id="foot_krm_1425_03"><a href="#ref_krm_1425_03">↑</a> (२०५)</li></ul></p>

रुजो|रोजकः-जिका|रुरुक्षकः-क्षिका|रोरुजकः-जिका|रोक्ता-रोक्त्री|रोजयिता-त्री|रुरुक्षिता-त्री|रोरुजिता-त्री
<ul><li><sup id="ref_krm_1426_01"><a href="#foot_krm_1426_01">1</a></sup> {@“रुजो भङ्गे”@} <sup id="ref_krm_1426_02"><a href="#foot_krm_1426_02">2</a></sup> ‘भङ्गे रुजति, हिंसायां रोजयेदिति णौ रुजेः।।’ <sup id="ref_krm_1426_03"><a href="#foot_krm_1426_03">3</a></sup> इति देवः। </li> <li>रोजकः-जिका, रोजकः-जिका, रुरुक्षकः-क्षिका, रोरुजकः-जिका;</li> <li>  रोक्ता-रोक्त्री, रोजयिता-त्री, रुरुक्षिता-त्री, रोरुजिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि रौधादिकभुनक्तिवत् <sup id="ref_krm_1426_04"><a href="#foot_krm_1426_04">4</a></sup> बोध्यानि। </li> <li>चोरस्य <sup id="ref_krm_1426_05"><a href="#foot_krm_1426_05">5</a></sup> रुजन् रोगः, नदी कूलानि रुजती गच्छति, चोरं रुजन्, नीरुजन् मिताशी स्यात्, <sup id="ref_krm_1426_06"><a href="#foot_krm_1426_06">6</a></sup> कूलमुद्रुजः <sup id="ref_krm_1426_07"><a href="#foot_krm_1426_07">7</a></sup>, <sup id="ref_krm_1426_08"><a href="#foot_krm_1426_08">8</a></sup> रोगः, <sup id="ref_krm_1426_09"><a href="#foot_krm_1426_09">9</a></sup> हृद्रोगः-हृदयरोगः, <sup id="ref_krm_1426_10"><a href="#foot_krm_1426_10">10</a></sup> रुजा, <sup id="ref_krm_1426_11"><a href="#foot_krm_1426_11">11</a></sup> रुक्, <sup id="ref_krm_1426_12"><a href="#foot_krm_1426_12">12</a></sup> <sup id="ref_krm_1426_13"><a href="#foot_krm_1426_13">13</a></sup> रुग्णवान्, <sup id="ref_krm_1426_14"><a href="#foot_krm_1426_14">14</a></sup> लुग्नम्, <sup id="ref_krm_1426_15"><a href="#foot_krm_1426_15">15</a></sup> वीरुक्, इत्यादीनि रूपाण्यस्माद्भवन्तीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1426_01"><a href="#ref_krm_1426_01">↑</a> (१४१६)</li> <li id="foot_krm_1426_02"><a href="#ref_krm_1426_02">↑</a> (६-तुदादिः-१४१६। सक। अनि। पर।)</li> <li id="foot_krm_1426_03"><a href="#ref_krm_1426_03">↑</a> (श्लो। ६९)</li> <li id="foot_krm_1426_04"><a href="#ref_krm_1426_04">↑</a> (११६२)</li> <li id="foot_krm_1426_05"><a href="#ref_krm_1426_05">↑</a> [[१। अत्र ‘रुजार्थानां भाववचनानामज्वरेः’ (२-३-५४) इति धात्वर्थस्य भावकर्तृकत्वे कर्मणि शेषत्वेन विवक्षिते षष्ठी। तुदादित्वात् शतरि शप्रत्ययः। तस्य ङिद्वद्भावे- नाङ्गस्य गुणो न। सूत्रे रुजाशब्देन व्याधिरुच्यते। तेन रुजेः व्याध्यर्थत्वे ‘भाववचनानाम्’ इत्यस्य ‘श्लेष्मा पुरुषं रुजन्’ इति प्रत्युदाहरणमिति केचित्। भाष्ये तु रुजधातोर्भङ्गार्थत्वमेवाश्रित्य, ‘नदी कूलानि रुजति।’ इति प्रत्युदाहृतम्। कर्मणोऽशेषत्वविवक्षायां द्वितीयाऽपि। तेन ‘चोरं रुजन्’ इति सिद्ध्यति। निपूर्वकोऽयं धातुर्व्याधिप्रतीकारे वर्तते। तेन नीरुजन् = (व्याध्यनभिभूतः) इति, प्रतीकारोऽत्रार्थः।]]</li> <li id="foot_krm_1426_06"><a href="#ref_krm_1426_06">↑</a> [[२। ‘उदि कूले रुजिवहोः’ (३-१-३१) इति कूलशब्दे कर्मण्युपपदे उत्पूर्बकस्यास्य खश्प्रत्ययः। ‘अरुर्द्विषदजन्तस्य--’ (६-३-६७) इति मुम्। शित्त्वात् सार्वधातुक- त्वम्। तस्य च ङिद्वद्भावाद् गुणो न। कूलानि उद्रुजतीति कूलमुद्रुजः रथः। उक्षा इति केचित्।]]</li> <li id="foot_krm_1426_07"><a href="#ref_krm_1426_07">↑</a> [[आ। ‘मदोदग्राः ककुद्मन्तः सरितां कूलमुद्रुजाः।’ रघु। ४। २२।]]</li> <li id="foot_krm_1426_08"><a href="#ref_krm_1426_08">↑</a> [[३। ‘पदरुजविशस्पृशो घञ्’ (३-३-१६) इति कर्तरि घञ्। रुजतीति रोगः। ‘चजोः--’ (७-३-५२) इति कुत्वम्।]]</li> <li id="foot_krm_1426_09"><a href="#ref_krm_1426_09">↑</a> [[४। ‘वा शोकष्यञ्रोगेषु’ (६-३-५१) इति हृदयशब्दस्य रोगशब्दे परे हृद्भावविकल्पः।]]</li> <li id="foot_krm_1426_10"><a href="#ref_krm_1426_10">↑</a> [[५। भिदादेः (३-३-१०४) आकृतिगणत्वेन तत्र पाठादङ्। प्रत्ययस्य ङित्त्वान्न गुणः।]]</li> <li id="foot_krm_1426_11"><a href="#ref_krm_1426_11">↑</a> [[६। ‘रोगाख्यायां ण्वुल् बहुलम्’ (३-३-१०८) इत्यत्र बहुलग्रहणात् रोगवाचकत्वेऽपि स्त्रियां सम्पदादि (वा। ३-३-१०८) पाठात् क्विप्।]]</li> <li id="foot_krm_1426_12"><a href="#ref_krm_1426_12">↑</a> [पृष्ठम्११२८+ २९]</li> <li id="foot_krm_1426_13"><a href="#ref_krm_1426_13">↑</a> [[१। ‘ओदितश्च’ (८-२-४४) इति निष्ठानत्वम्। निष्ठानत्वस्य परशास्त्रत्वात्, ‘चोः कुः’ (८-२-३०) इति कुत्वस्य पूर्वशास्त्रत्वाच्च, ‘त्रिपाद्यामपि पूर्वं प्रति परं शास्त्रमसिद्धम्’ इति न्यायेन निष्ठानत्वासिद्ध्या कुत्वमत्रेति बोध्यम्। ‘अट्कुप्वाङ्- नुम्व्यवायेऽपि’ (८-४-२) इति णत्वम्।]]</li> <li id="foot_krm_1426_14"><a href="#ref_krm_1426_14">↑</a> [[२। ‘क्तिच्क्तौ च--’ (३-३-१७४) इति संज्ञायां क्तः। ‘कपिलकादीनां संज्ञाच्छन्दसोः’ (वा। ८-२-१८) इत्यत्र कपिलकादिगणे पाठादत्र धातुरेफस्य लत्वम्। लुग्नम् = जीर्णवस्त्रम्।]]</li> <li id="foot_krm_1426_15"><a href="#ref_krm_1426_15">↑</a> [[३। क्विबन्ते बाहुलकात् ‘अन्येषामपि दृश्यते’ (६-३-१३७) इति पूर्वपदस्य दीर्घः। अत्र क्षीरतरङ्गिण्याम्-- “… ‘नहिवृति--’ (६-३-११६) इति दीर्घः। वीरुक्।” इत्युक्तम्। ‘नहिवृतिवृषिव्यधिरुचिसहितनिषु क्वौ’ (६-३-११६) इत्यत्र रुचि इति रुचधातोरेव सर्वैः ग्रहणात् चिन्त्यमिदम्।]]</li></ul></p>

रुट|रोटकः-टिका|रुरुटिषकः-रुरोटिषकः-षिका|रोरुटकः-टिका|रोटिता-त्री|रोटयिता-त्री|रुरुटिषिता-रुरोटिषिता-त्री|रोरुटिता-त्री
<ul><li><sup id="ref_krm_1427_01"><a href="#foot_krm_1427_01">1</a></sup> {@“रुट प्रती<sup id="ref_krm_1427_02"><a href="#foot_krm_1427_02">2</a></sup>घाते”@} <sup id="ref_krm_1427_03"><a href="#foot_krm_1427_03">3</a></sup> <sup id="ref_krm_1427_04"><a href="#foot_krm_1427_04">4</a></sup> “… ‘रुट लुट लुठ प्रती<sup id="ref_krm_1427_05"><a href="#foot_krm_1427_05">5</a></sup>घाते’ आद्यौ प्रथमान्तौ। </li> <li>अन्त्यो द्वितीयान्तः। </li> <li>अयं पाठो देवमैश्रेयादीनाम्। </li> <li>हरियोगिनस्तु आद्यावेव। </li> <li>‘धातोः कर्मणः--’ <sup id="ref_krm_1427_06"><a href="#foot_krm_1427_06">6</a></sup> इत्यत्र कैयटे द्वाविमौ द्वितीयान्तौ पठितौ। </li> <li>क्षीरस्वामी तु एवं पठित्वाऽऽह-- “-- ‘रुट लुट--’ इत्येके। </li> <li>‘बाधृ रोटने’ इति लिङ्गात्।” इति। </li> <li>तथा ‘रुट दीप्तौ’ इत्यप्यसावाह।” इति माधवो- क्तिरिहानुसन्धेया।]] ‘रोटते प्रतिघातेऽर्थे रोषे रोटयतीति णौ।।’ <sup id="ref_krm_1427_07"><a href="#foot_krm_1427_07">7</a></sup> हति देवः। </li> <li>रोटकः-टिका, रोटकः-टिका, रुरुटिषकः-रुरोटिषकः-षिका, रोरुटकः-टिका;</li> <li>  रोटिता-त्री, रोटयिता-त्री, रुरुटिषिता-रुरोटिषिता-त्री, रोरुटिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककोकतिवत् <sup id="ref_krm_1427_08"><a href="#foot_krm_1427_08">8</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1427_09"><a href="#foot_krm_1427_09">9</a></sup> रुटितम्-रोटितम्-तः, रुट्यभानः <sup id="ref_krm_1427_10"><a href="#foot_krm_1427_10">10</a></sup> इमानि रूपाण्यधिकान्यत्रेति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1427_01"><a href="#ref_krm_1427_01">↑</a> (१४१७)</li> <li id="foot_krm_1427_02"><a href="#ref_krm_1427_02">↑</a> [ति]</li> <li id="foot_krm_1427_03"><a href="#ref_krm_1427_03">↑</a> (१-भ्वादिः-४७६। सक। सेट्। आत्म।)</li> <li id="foot_krm_1427_04"><a href="#ref_krm_1427_04">↑</a> [[[अ]</li> <li id="foot_krm_1427_05"><a href="#ref_krm_1427_05">↑</a> (ति)</li> <li id="foot_krm_1427_06"><a href="#ref_krm_1427_06">↑</a> (३-१-७)</li> <li id="foot_krm_1427_07"><a href="#ref_krm_1427_07">↑</a> (श्लो। ७४)</li> <li id="foot_krm_1427_08"><a href="#ref_krm_1427_08">↑</a> (१९७)</li> <li id="foot_krm_1427_09"><a href="#ref_krm_1427_09">↑</a> [[४। ‘उदुपधात् भावादिकर्मणोः--’ (१-२-२१) इति वैकल्पिककित्त्वात् निष्ठायां रूपद्वयं बोध्यम्।]]</li> <li id="foot_krm_1427_10"><a href="#ref_krm_1427_10">↑</a> [[आ। ‘अस्विन्नरुग्घोटक रुट्यमानमार्गा जवेनालुटिता निरीयुः।।’ धा। का। २। १।]]</li></ul></p>

रुट|रोटकः-टिका|रुरोटयिषकः-षिका
<ul><li><sup id="ref_krm_1428_01"><a href="#foot_krm_1428_01">1</a></sup> {@“रुट भाषार्थः”@} <sup id="ref_krm_1428_02"><a href="#foot_krm_1428_02">2</a></sup> आस्वदीयः। </li> <li>क्षीरस्वामी चुरादिष्वेव पूर्वम् ‘रुट रोषे’ इति मैत्रेयाद्यनुसारेण पठति <sup id="ref_krm_1428_03"><a href="#foot_krm_1428_03">3</a></sup> अत्र तु भाषार्थकदण्डके पुनः पठति। </li> <li>परं तु दण्डकपठितानां सर्वेषामपि ‘भाषार्थः’ इति भासार्थकत्वमाह। </li> <li>‘… रोटयतीति णौ।।’ <sup id="ref_krm_1428_04"><a href="#foot_krm_1428_04">4</a></sup> इति देववाक्यं क्षीरस्वामिनोऽनूकूलमिति बोध्यम्। </li> <li>रोटकः-टिका, रुरोटयिषकः-षिका;</li> <li>  रोटयिता-त्री, रुरोटयिषिता-त्री, इत्यादीनि सर्वाण्यपि रूपाणि चौरादिककोटयतिवत् <sup id="ref_krm_1428_05"><a href="#foot_krm_1428_05">5</a></sup> बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1428_01"><a href="#ref_krm_1428_01">↑</a> (१४१८)</li> <li id="foot_krm_1428_02"><a href="#ref_krm_1428_02">↑</a> (१०-चुरादिः-१७८४। सक। सेट्। उभ।)</li> <li id="foot_krm_1428_03"><a href="#ref_krm_1428_03">↑</a> [पृष्ठम्११२९+ २५]</li> <li id="foot_krm_1428_04"><a href="#ref_krm_1428_04">↑</a> (श्लो। ७४)</li> <li id="foot_krm_1428_05"><a href="#ref_krm_1428_05">↑</a> (२०५)</li></ul></p>

रुटि|रुण्टकः-ण्टिका|रुरुण्टिषकः-षिका|रोरुण्टकः-ण्टिका|रुण्टिता-त्री|रुण्टयिता-त्री|रुरुण्टिषिता-त्री|रोरुण्टिता-त्री
<ul><li><sup id="ref_krm_1429_01"><a href="#foot_krm_1429_01">1</a></sup> {@“रुटि स्तेये”@} <sup id="ref_krm_1429_02"><a href="#foot_krm_1429_02">2</a></sup> ‘रुठि--’ इति, ‘रुडि--’ इति च केचिदमुं पठन्ति। </li> <li>रुण्टकः-ण्टिका, रुण्टकः-ण्टिका, रुरुण्टिषकः-षिका, रोरुण्टकः-ण्टिका;</li> <li>  रुण्टिता-त्री, रुण्टयिता-त्री, रुरुण्टिषिता-त्री, रोरुण्टिता-त्री;</li> <li>  इत्यादिकानि सर्वाण्यपि रूपाणि भौवादिककुण्ठतिवत् <sup id="ref_krm_1429_03"><a href="#foot_krm_1429_03">3</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1429_01"><a href="#ref_krm_1429_01">↑</a> (१४१९)</li> <li id="foot_krm_1429_02"><a href="#ref_krm_1429_02">↑</a> (१-भ्वादिः-३२७। सक। सेट्। पर।)</li> <li id="foot_krm_1429_03"><a href="#ref_krm_1429_03">↑</a> (२०९)</li></ul></p>

रुठ|रोठकः-ठिका|रुरोठिषकः-रुरुठिषकः-षिका|रोरुठकः-ठिका|रोठिता-त्री|रोठयिता-त्री|रुरोठिषिता-रुरुठिषिता-त्री|रोरुठिता-त्री
<ul><li><sup id="ref_krm_1430_01"><a href="#foot_krm_1430_01">1</a></sup> {@“रुठ उपघाते”@} <sup id="ref_krm_1430_02"><a href="#foot_krm_1430_02">2</a></sup> ‘रुण्ठतीति गतौ, रोठेदुपघाते--।’ <sup id="ref_krm_1430_03"><a href="#foot_krm_1430_03">3</a></sup> इति देवः। </li> <li>‘अश्मा लुलुठिषते’ इति भाष्यं व्याचक्षाणः कैयटस्तु <sup id="ref_krm_1430_04"><a href="#foot_krm_1430_04">4</a></sup> ‘रुठ लुठ प्रतीघाते’ इति पाठमादृतवान्। </li> <li>रोठकः-ठिका, रोठकः-ठिका, रुरोठिषकः-रुरुठिषकः-षिका, रोरुठकः-ठिका;</li> <li>  रोठिता-त्री, रोठयिता-त्री, रुरोठिषिता-रुरुठिषिता-त्री, रोरुठिता-त्री;</li> <li>  इतीमानि रूपाणि सर्वाण्यपि दैवादिककुप्यतिवत् <sup id="ref_krm_1430_05"><a href="#foot_krm_1430_05">5</a></sup> बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1430_01"><a href="#ref_krm_1430_01">↑</a> (१४२०)</li> <li id="foot_krm_1430_02"><a href="#ref_krm_1430_02">↑</a> (१-भ्वादिः-३३६। सक। सेट्। पर।)</li> <li id="foot_krm_1430_03"><a href="#ref_krm_1430_03">↑</a> (श्लो। ७९)</li> <li id="foot_krm_1430_04"><a href="#ref_krm_1430_04">↑</a> (३-१-७)</li> <li id="foot_krm_1430_05"><a href="#ref_krm_1430_05">↑</a> (२२४)</li></ul></p>

रुठि|रुण्ठकः-ण्ठिका|रुरुण्ठिषकः-षिका|रोरुण्ठकः-ण्ठिका|रुण्ठिता-त्री|रुण्ठयिता-त्री|रुरुण्ठिषिता-त्री|रोरुण्ठिता-त्री
<ul><li><sup id="ref_krm_1431_01"><a href="#foot_krm_1431_01">1</a></sup> {@“रुठि गतौ”@} <sup id="ref_krm_1431_02"><a href="#foot_krm_1431_02">2</a></sup> ‘रुण्ठतीति गतौ, रोठेदुपघाते--।’ <sup id="ref_krm_1431_03"><a href="#foot_krm_1431_03">3</a></sup> इति देवः। </li> <li>‘आलस्ये गतिप्रतिघाते च’ इति क्षीरस्वामी। </li> <li>रुण्ठकः-ण्ठिका, रुण्ठकः-ण्ठिका, रुरुण्ठिषकः-षिका, रोरुण्ठकः-ण्ठिका;</li> <li>  रुण्ठिता-त्री, रुण्ठयिता-त्री, रुरुण्ठिषिता-त्री, रोरुण्ठिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककुण्ठतिवत् <sup id="ref_krm_1431_04"><a href="#foot_krm_1431_04">4</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1431_01"><a href="#ref_krm_1431_01">↑</a> (१४२१)</li> <li id="foot_krm_1431_02"><a href="#ref_krm_1431_02">↑</a> (१-भ्वादिः-३४५। सक। सेट्। पर।)</li> <li id="foot_krm_1431_03"><a href="#ref_krm_1431_03">↑</a> (श्लो। ७९)</li> <li id="foot_krm_1431_04"><a href="#ref_krm_1431_04">↑</a> (२०९)</li></ul></p>

रुदिर्|रोदकः-दिका|रुरुदिषकः-षिका|रोरुदकः-दिका|रोदिता-त्री|रोदयिता-त्री|रुरुदिषिता-त्री|रोरुदिता-त्री
<ul><li><sup id="ref_krm_1432_01"><a href="#foot_krm_1432_01">1</a></sup> {@“रुदिर् अश्रुविमोचने”@} <sup id="ref_krm_1432_02"><a href="#foot_krm_1432_02">2</a></sup> <sup id="ref_krm_1432_03"><a href="#foot_krm_1432_03">3</a></sup> रोदकः-दिका, रोदकः-दिका, <sup id="ref_krm_1432_04"><a href="#foot_krm_1432_04">4</a></sup> रुरुदिषकः-षिका, रोरुदकः-दिका;</li> <li>  रोदिता-त्री, रोदयिता-त्री, रुरुदिषिता-त्री, रोरुदिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकतोहतिवत् <sup id="ref_krm_1432_05"><a href="#foot_krm_1432_05">5</a></sup> ज्ञेयानि। </li> <li>रुदित्वा, <sup id="ref_krm_1432_06"><a href="#foot_krm_1432_06">6</a></sup> रोदसी, <sup id="ref_krm_1432_07"><a href="#foot_krm_1432_07">7</a></sup> रोरुद्यमानः, रोरुदा <sup id="ref_krm_1432_08"><a href="#foot_krm_1432_08">8</a></sup>, <sup id="ref_krm_1432_09"><a href="#foot_krm_1432_09">9</a></sup> रुद्रः-रुद्राणी, रुद्रा, <sup id="ref_krm_1432_10"><a href="#foot_krm_1432_10">10</a></sup> अलं रुदित्वा, अलं रोदनेन, <sup id="ref_krm_1432_11"><a href="#foot_krm_1432_11">11</a></sup> रुरुदिषा, इतीमान्यस्माद्भवन्तीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1432_01"><a href="#ref_krm_1432_01">↑</a> (१४२२)</li> <li id="foot_krm_1432_02"><a href="#ref_krm_1432_02">↑</a> (२-अदादिः-१०६७। अक। सेट्। पर।)</li> <li id="foot_krm_1432_03"><a href="#ref_krm_1432_03">↑</a> [पृष्ठम्११३०+ २८]</li> <li id="foot_krm_1432_04"><a href="#ref_krm_1432_04">↑</a> [[१। ‘रलो व्युपधात्--’ (१-२-२६) इति क्त्वासनोः कित्त्वविकल्पे प्राप्ते, ‘रुदविद--’ (१-२-८) इत्यनेन नित्यकित्त्वम्। तेन सन्नन्तेषु क्त्वायामपि रूपमेकमेव।]]</li> <li id="foot_krm_1432_05"><a href="#ref_krm_1432_05">↑</a> (७६०)</li> <li id="foot_krm_1432_06"><a href="#ref_krm_1432_06">↑</a> [[२। ‘असुन्’ (द। उ। ९-४९) इत्यसुन्प्रत्यये रूपम्। पुष्पवन्तावित्यादिवत् अभि- धानस्वाभाव्यात् नित्यं द्विवचनान्तोऽयम्। रोदसी = द्यावाभूमी।]]</li> <li id="foot_krm_1432_07"><a href="#ref_krm_1432_07">↑</a> [[आ। ‘रोरुद्यमानः स तदाऽप्यपृच्छत् यथावदाख्यन् अथ वृत्तमस्मै।।’ भ। का। ३-२९।]]</li> <li id="foot_krm_1432_08"><a href="#ref_krm_1432_08">↑</a> [[B। ‘तां संहितोरूं युवतिं सरोरुदां शौरिर्व्यमार्क्षीत् कुररीमिवेक्षिता।।’ वा। वि। १। ४९।]]</li> <li id="foot_krm_1432_09"><a href="#ref_krm_1432_09">↑</a> [[३। ‘रोदेर्णिलुक् च’ (द। उ। ८-३९।) इति रक्प्रत्ययो णिलुक् च भवति। रोदयति दानवयोषित इति रुद्रः। स्त्रियाम्, ‘इन्द्रवरुणभवशर्वरुद्र--’ (४-१-४९) इत्यादिना पुंयोगे ङीषानुगागमौ भवतः। तेन रुद्राणी इति सिध्यति। एतच्च रुद्रपत्नीविषयकं बोध्यम्। यदा तु रुद्रा इति सुपर्णपत्नी बोध्यते-तदानीमजादिपाठ- परिकल्पनेन (४-१-४) टापि रूपनिष्पत्तिरिति बोध्यम्।]]</li> <li id="foot_krm_1432_10"><a href="#ref_krm_1432_10">↑</a> [[४। ‘अलंखल्वोः प्रतिषेधयोः प्राचां क्त्वा’ (३-४-१८) इति प्रतिषेधार्थकस्याल- मित्यव्ययस्य प्रयोगे क्त्वाप्रत्ययः। अत्र ‘स्त्र्यधिकारादूर्ध्वं वासरूपविधिर्नास्ति’ इति शाब्दिकमर्यादया पक्षे ल्युडपि भवति। तेन ‘अलं रोदनेन’ इति सिद्ध्यति। प्रकृत्यादित्वादत्र रोदनेन इति तृतीया--इत्यादिकं बृहच्छब्देन्दु- शेखरे विस्तृतम्।]]</li> <li id="foot_krm_1432_11"><a href="#ref_krm_1432_11">↑</a> [[C। ‘रुरुदिषा वदनाम्बुरुहश्रियः सुतनु सत्यमलङ्करणायते।’ शि। व। ६-१७।]]</li></ul></p>

रुधि|अनुरोधकः-धिका|अनुरुरुत्सकः-त्सिका|अनुरोरुधकः-धिका|अनुरोद्धा-द्ध्री|अनुरोधयिता-त्री|अनुरुरुत्सिता-त्री|अनुरोरुधिता-त्री
<ul><li><sup id="ref_krm_1433_01"><a href="#foot_krm_1433_01">1</a></sup> {@“<sup id="ref_krm_1433_02"><a href="#foot_krm_1433_02">2</a></sup> रुध कामे”@} <sup id="ref_krm_1433_03"><a href="#foot_krm_1433_03">3</a></sup> ‘अनुपूर्वो रुधिः कामेऽर्थे तङ्श्यनौ भजते।’ इति धा। </li> <li>का। </li> <li>व्याख्यायां <sup id="ref_krm_1433_04"><a href="#foot_krm_1433_04">4</a></sup> विवृतम्। </li> <li>‘रुन्धे रुणद्ध्यावरणे, कामेऽनावनुरुध्यते।।’ <sup id="ref_krm_1433_05"><a href="#foot_krm_1433_05">5</a></sup>। </li> <li>इति देवः। </li> <li>अनुरोधकः-धिका, अनुरोधकः-धिका, अनुरुरुत्सकः-त्सिका, अनुरोरुधकः-धिका;</li> <li>  अनुरोद्धा-द्ध्री, अनुरोधयिता-त्री, अनुरुरुत्सिता-त्री, अनुरोरुधिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि दैवादिकक्षुध्यतिवत् <sup id="ref_krm_1433_06"><a href="#foot_krm_1433_06">6</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_1433_07"><a href="#foot_krm_1433_07">7</a></sup> <sup id="ref_krm_1433_08"><a href="#foot_krm_1433_08">8</a></sup> अनुरोधी <sup id="ref_krm_1433_09"><a href="#foot_krm_1433_09">9</a></sup>]।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1433_01"><a href="#ref_krm_1433_01">↑</a> (१४२३)</li> <li id="foot_krm_1433_02"><a href="#ref_krm_1433_02">↑</a> [अनो]</li> <li id="foot_krm_1433_03"><a href="#ref_krm_1433_03">↑</a> (४-दिवादिः-११७४। सक। अनि। आत्म।)</li> <li id="foot_krm_1433_04"><a href="#ref_krm_1433_04">↑</a> (२-६२)</li> <li id="foot_krm_1433_05"><a href="#ref_krm_1433_05">↑</a> (श्लो। १२१)</li> <li id="foot_krm_1433_06"><a href="#ref_krm_1433_06">↑</a> (३१५)</li> <li id="foot_krm_1433_07"><a href="#ref_krm_1433_07">↑</a> [पृष्ठम्११३१+ ३०]</li> <li id="foot_krm_1433_08"><a href="#ref_krm_1433_08">↑</a> [[१। तच्छीलादिषु कर्तृषु, ‘सम्पृचानुरुध…’ (३-२-१४२) इति घिनुण्। अत्र, “… ‘अनो रुध कामे’ इत्यस्य तु दैवादिकस्याग्रहणम्-पृचिना साहचर्यात्। अनुना सह पठितस्य दैवादिकस्य ग्रहणमित्यन्ये।” इति पदमञ्जरी। वस्तुतः-- रौधादिकस्यैव धातोरनुपूर्वकत्वे कामनार्थकत्वे च दैवादिकपाठः इत्यस्य सैद्धान्तिक- पक्षत्वेन प्रकृतसूत्रे (३-२-१४२) दैवादिकस्यैवास्य ग्रहणम्। साहचर्यपरिभाषा- श्रयणे च अनन्यथासिद्धं बीजं न पश्यामः। अत एव क्वचिद् भट्टिकाव्यव्या- ख्याने (७-९) ‘एता देवानुरोधिन्यो द्वेषिण्य इव रागिणम्।’ इत्यत्र अनुरुध्यन्तीति श्यना विवरणं संगतम्। इत्यलमत्र।]]</li> <li id="foot_krm_1433_09"><a href="#ref_krm_1433_09">↑</a> [[आ। ‘कंसानुरोध्यणनहृन्मतिमद्युगर्च्यः--।।’ धा। का। २-६२। [अत्र धा। का। व्याख्यायां णिन्यन्तत्वेन प्रकृतशब्दस्य निष्पत्तिः कृतेति विभाव्यम्।]]</li></ul></p>

रुधि|रोधकः-धिका|रुरुत्सकः-त्सिका|रोरुधकः-धिका|रोद्धा-रोद्ध्री|रोधयिता-त्री|रुरुत्सिता-त्री|रोरुधिता-त्री
<ul><li><sup id="ref_krm_1434_01"><a href="#foot_krm_1434_01">1</a></sup> {@“रुधिर् आवरणे”@} <sup id="ref_krm_1434_02"><a href="#foot_krm_1434_02">2</a></sup> ‘आवरणम् = व्याप्तिः।’ इति क्षीरस्वामी। </li> <li>‘रुन्धे रुणध्यावरणे, कामेऽनावनुरुध्यते।।’ <sup id="ref_krm_1434_03"><a href="#foot_krm_1434_03">3</a></sup> इति देवः। </li> <li>रोधकः-धिका, रोधकः-धिका, रुरुत्सकः-त्सिका, रोरुधकः-धिका;</li> <li>  रोद्धा-रोद्ध्री, रोधयिता-त्री, रुरुत्सिता-त्री, रोरुधिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि रौधादिकभिन्दतिवत् <sup id="ref_krm_1434_04"><a href="#foot_krm_1434_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1434_05"><a href="#foot_krm_1434_05">5</a></sup> अङ्गरोधी-उपरोधी, <sup id="ref_krm_1434_06"><a href="#foot_krm_1434_06">6</a></sup> प्रतिरोधी, <sup id="ref_krm_1434_07"><a href="#foot_krm_1434_07">7</a></sup> अनुरोधी, <sup id="ref_krm_1434_08"><a href="#foot_krm_1434_08">8</a></sup> व्रजे उपरुध्य-व्रजोपरोधं, <sup id="ref_krm_1434_09"><a href="#foot_krm_1434_09">9</a></sup> कारोपरोधम् वा गाः-पाययति, <sup id="ref_krm_1434_10"><a href="#foot_krm_1434_10">10</a></sup> रोधनः, <sup id="ref_krm_1434_11"><a href="#foot_krm_1434_11">11</a></sup> मार्गरुत् <sup id="ref_krm_1434_12"><a href="#foot_krm_1434_12">12</a></sup> -द्-रुधौ-रुधः, <sup id="ref_krm_1434_13"><a href="#foot_krm_1434_13">13</a></sup> विरोधी, <sup id="ref_krm_1434_14"><a href="#foot_krm_1434_14">14</a></sup> <sup id="ref_krm_1434_15"><a href="#foot_krm_1434_15">15</a></sup> गां व्रजमवरुन्धन्, <sup id="ref_krm_1434_16"><a href="#foot_krm_1434_16">16</a></sup> रुधिरम्, <sup id="ref_krm_1434_17"><a href="#foot_krm_1434_17">17</a></sup> रोधः, इतीमान्यस्माद् भवन्तीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1434_01"><a href="#ref_krm_1434_01">↑</a> (१४२४)</li> <li id="foot_krm_1434_02"><a href="#ref_krm_1434_02">↑</a> (७-रुधादिः-१४३८। सक। अनि। उभ।)</li> <li id="foot_krm_1434_03"><a href="#ref_krm_1434_03">↑</a> (श्लो। १२१)</li> <li id="foot_krm_1434_04"><a href="#ref_krm_1434_04">↑</a> (११६०)</li> <li id="foot_krm_1434_05"><a href="#ref_krm_1434_05">↑</a> [[२। अङ्गानि रुणद्धीति अङ्गरोधी। ग्रह्यादिषु (३-१-१३४) कर्मण्यणोऽपवादो णिनिप्रत्ययः। एवम् उपरुणद्धीति उपरोधी इत्यत्रापि ग्रह्यादित्वादेव णिनिः।]]</li> <li id="foot_krm_1434_06"><a href="#ref_krm_1434_06">↑</a> [[३। ‘भविष्यति गम्यादयः’ (३-३-३) इत्यत्र गणे पाठात् भविष्यत्काले औणादिको णिनिरत्र।]]</li> <li id="foot_krm_1434_07"><a href="#ref_krm_1434_07">↑</a> [[४। ‘सम्पृचानुरुध--’ (३-२-१४२) इत्यादिना ताच्छीलिको घिनुण्प्रत्ययः।]]</li> <li id="foot_krm_1434_08"><a href="#ref_krm_1434_08">↑</a> [[५। ‘सप्तम्यां चोपपीडरुधकर्षः’ (३-४-४९) इति सप्तम्यन्ते तृतीयान्ते चोपपदे उपपूर्वकादस्मात् णमुल्। ‘तृतीयाप्रभृतीनि--’ (२-२-२१) इति समासविकल्पः।]]</li> <li id="foot_krm_1434_09"><a href="#ref_krm_1434_09">↑</a> [[B। ‘तं शूरसूनुं सह जाययोग्रः कारोपरोधं निगलैरसेष्ट।।’ वा। वि। २। ४०।]]</li> <li id="foot_krm_1434_10"><a href="#ref_krm_1434_10">↑</a> [[६। नन्द्यादिषु पाठपरिकल्पनादत्र कर्तरि ल्युप्रत्ययः।]]</li> <li id="foot_krm_1434_11"><a href="#ref_krm_1434_11">↑</a> [[७। मार्गं रुणद्धीति मार्गरुध्, ‘क्विप् च’ (३-२-७६) इति कर्मण्युपपदे क्विप्।]]</li> <li id="foot_krm_1434_12"><a href="#ref_krm_1434_12">↑</a> [[C। ‘निरुध्यमाना यदुभिः कथञ्चित् मुहुर्यदुच्चिक्षुपुरग्रपादान्। ध्रुवं गुरून् मार्गरुधः करीन्द्रानुल्लङ्ध्य गन्तुं तुरगास्तदीषुः।।’ शि। व। ३-२९।]]</li> <li id="foot_krm_1434_13"><a href="#ref_krm_1434_13">↑</a> [[८। विशेषेण रुणद्धीति विरोधी, ‘सुप्यजातौ--’ (३-२-७८) इति ताच्छील्ये णिनिः।]]</li> <li id="foot_krm_1434_14"><a href="#ref_krm_1434_14">↑</a> [पृष्ठम्११३२+ २४]</li> <li id="foot_krm_1434_15"><a href="#ref_krm_1434_15">↑</a> [[१। अयं द्विकर्मकः। तेन, अत्र ‘अकथितं च’ (१-४-५१) इति कर्मसंज्ञायां द्वितीया।।]]</li> <li id="foot_krm_1434_16"><a href="#ref_krm_1434_16">↑</a> [[२। ‘इषिमदिमुदि--’ (द। उ। ८ २६) इत्यादिना किरच्प्रत्यये रूपमेवम्। रुधिरम् = रक्तम्।]]</li> <li id="foot_krm_1434_17"><a href="#ref_krm_1434_17">↑</a> [[३। ‘असुन्’ (द। उ। ९-४९) इत्यसुन्प्रत्यये रूपम्। रोधः = जलप्रवाहः। सकारान्तः।]]</li></ul></p>

रुप|रोपकः-पिका|रुरोपिषकः-रुरुपिषकः-षिका|रोरुपकः-पिका|रोपिता-त्री|रोपयिता-त्री|रुरोपिषिता-रुरुपिषिता-त्री|रोरुपिता-त्री
<ul><li><sup id="ref_krm_1435_01"><a href="#foot_krm_1435_01">1</a></sup> {@“रुप विमोहने”@} <sup id="ref_krm_1435_02"><a href="#foot_krm_1435_02">2</a></sup> ‘रुपु <sup id="ref_krm_1435_03"><a href="#foot_krm_1435_03">3</a></sup> --’ इति धा। </li> <li>का। </li> <li>व्याख्यायाम् <sup id="ref_krm_1435_04"><a href="#foot_krm_1435_04">4</a></sup>। </li> <li>रोपकः-पिका, रोपकः-पिका, रुरोपिषकः-रुरुपिषकः-षिका, रोरुपकः-पिका;</li> <li>  रोपिता-त्री, रोपयिता-त्री, रुरोपिषिता-रुरुपिषिता-त्री, रोरुपिता-त्री;</li> <li>  इत्यादिकानि समस्तान्यपि रूपाणि दैवादिककुप्यतिवत् <sup id="ref_krm_1435_05"><a href="#foot_krm_1435_05">5</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1435_06"><a href="#foot_krm_1435_06">6</a></sup> विरोपी, <sup id="ref_krm_1435_07"><a href="#foot_krm_1435_07">7</a></sup> रोपः <sup id="ref_krm_1435_08"><a href="#foot_krm_1435_08">8</a></sup> इमे रूपे विशेषेण भवतः इति ज्ञेयम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1435_01"><a href="#ref_krm_1435_01">↑</a> (१४२५)</li> <li id="foot_krm_1435_02"><a href="#ref_krm_1435_02">↑</a> (४-दिवादिः-१२३६। सक। सेट्। पर।)</li> <li id="foot_krm_1435_03"><a href="#ref_krm_1435_03">↑</a> [[४। एतत्पक्षे क्त्वायामिड्विकल्पेन रुपित्वा-रोपित्वा इति रूपद्वयं बोध्यम्।]]</li> <li id="foot_krm_1435_04"><a href="#ref_krm_1435_04">↑</a> (२-६७)</li> <li id="foot_krm_1435_05"><a href="#ref_krm_1435_05">↑</a> (२२४)</li> <li id="foot_krm_1435_06"><a href="#ref_krm_1435_06">↑</a> [[५। ‘सुप्यजातौ--’ (३-२-७८) इति णिनिप्रत्ययः।]]</li> <li id="foot_krm_1435_07"><a href="#ref_krm_1435_07">↑</a> [[आ। ‘… किंचायोप्यविरोपिलोपक न वा लोभादिसंक्षोभिता।’ धा। का। २। ६७।]]</li> <li id="foot_krm_1435_08"><a href="#ref_krm_1435_08">↑</a> [[६। ‘हलश्च’ (३-३-१२१) इति संज्ञायां घञ्प्रत्यये रूपम्। रुप्यन्ति अनेन इति रोपः = शरः।]]</li></ul></p>

रुश|रोशकः-शिका|रुरुक्षकः-क्षिका|रोरुशकः-शिका|रुष्टा-ष्ट्री|रोशयिता-त्री|रुरुक्षिता-त्री|रोरुशिता-त्री
<ul><li><sup id="ref_krm_1436_01"><a href="#foot_krm_1436_01">1</a></sup> {@“रुश हिंसायाम्”@} <sup id="ref_krm_1436_02"><a href="#foot_krm_1436_02">2</a></sup> रोशकः-शिका, रोशकः-शिका, रुरुक्षकः-क्षिका, रोरुशकः-शिका;</li> <li>  रुष्टा-ष्ट्री, रोशयिता-त्री, रुरुक्षिता-त्री, रोरुशिता-त्री;</li> <li>  इत्यादिकानि रूपाणि सर्वाण्यपि दैवादिककुस्यतिवत् <sup id="ref_krm_1436_03"><a href="#foot_krm_1436_03">3</a></sup> ज्ञेयानि। </li> <li>तुमुनि-रोष्टुम् <sup id="ref_krm_1436_04"><a href="#foot_krm_1436_04">4</a></sup> इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1436_01"><a href="#ref_krm_1436_01">↑</a> (१४२६)</li> <li id="foot_krm_1436_02"><a href="#ref_krm_1436_02">↑</a> (६-तुदादिः-१४१९। सक। अनि। पर।)</li> <li id="foot_krm_1436_03"><a href="#ref_krm_1436_03">↑</a> (२३४)</li> <li id="foot_krm_1436_04"><a href="#ref_krm_1436_04">↑</a> [[B। ‘रोषच्छुप्तधियाथ रोष्टुमभितो योधान्द्विषद्रेशकान्…।’ धा। का। २-८४।]]</li></ul></p>

रुशि|रुंशकः-शिका|रुरुंशयिषकः-षिका|रुरुंशिषकः-षिका|रोरुंशकः-शिका|रुंशयिता-त्री|रुरुंशयिषिता-त्री|रुंशिता-त्री|रुरुंशिषिता-त्री|रोरुंशिता-त्री
<ul><li><sup id="ref_krm_1437_01"><a href="#foot_krm_1437_01">1</a></sup> {@“रुशि भाषार्थः”@} <sup id="ref_krm_1437_02"><a href="#foot_krm_1437_02">2</a></sup> आस्वदीयः। </li> <li>‘--भासार्थः।’ इति क्षीरस्वामी। </li> <li>रुंशकः-शिका, रुरुंशयिषकः-षिका, रुंशकः-शिका, रुरुंशिषकः-षिका, रोरुंशकः-शिका;</li> <li>  रुंशयिता-त्री, रुरुंशयिषिता-त्री, रुंशिता-त्री, रुरुंशिषिता-त्री, <sup id="ref_krm_1437_03"><a href="#foot_krm_1437_03">3</a></sup> रोरुंशिता-त्री;</li> <li>  इत्यादिकानि रूपाणि सर्वाणि चौरादिककुंशयतिवत् <sup id="ref_krm_1437_04"><a href="#foot_krm_1437_04">4</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1437_01"><a href="#ref_krm_1437_01">↑</a> (१४२७)</li> <li id="foot_krm_1437_02"><a href="#ref_krm_1437_02">↑</a> (१०-चुरादिः-१७८९। अक। सेट्। उभ।)</li> <li id="foot_krm_1437_03"><a href="#ref_krm_1437_03">↑</a> [पृष्ठम्११३३+ २८]</li> <li id="foot_krm_1437_04"><a href="#ref_krm_1437_04">↑</a> (२३२)</li></ul></p>

रुष|रोषकः-षिका|रुरोषिषकः-रुरुषिषकः-षिका|रोरुषकः-षिका|रोषिता-रोष्टा-ष्ट्री|रोषयिता-त्री|रुरोषिषिता-रुरुषिषिता-त्री|रोरुषिता-त्री
<ul><li><sup id="ref_krm_1438_01"><a href="#foot_krm_1438_01">1</a></sup> {@“रुष हिंसार्थः”@} <sup id="ref_krm_1438_02"><a href="#foot_krm_1438_02">2</a></sup> ‘शपि रोषति हिंसायाम्, रोषे रुष्यति रोषयेत्।।’ <sup id="ref_krm_1438_03"><a href="#foot_krm_1438_03">3</a></sup> इति देवः। </li> <li>रोषकः-षिका, रोषकः-षिका, रुरोषिषकः-रुरुषिषकः-षिका, रोरुषकः-षिका;</li> <li>  <sup id="ref_krm_1438_04"><a href="#foot_krm_1438_04">4</a></sup> रोषिता-रोष्टा <sup id="ref_krm_1438_05"><a href="#foot_krm_1438_05">5</a></sup> -ष्ट्री, रोषयिता-त्री, रुरोषिषिता-रुरुषिषिता-त्री, रोरुषिता-त्री;</li> <li>  इत्यादीनि समस्तान्यपि रूपाणि भौवादिकरेषतिवत् <sup id="ref_krm_1438_06"><a href="#foot_krm_1438_06">6</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_1438_07"><a href="#foot_krm_1438_07">7</a></sup> रुष्टः- <sup id="ref_krm_1438_08"><a href="#foot_krm_1438_08">8</a></sup> रुषितः, <sup id="ref_krm_1438_09"><a href="#foot_krm_1438_09">9</a></sup> रुषितमनेन, रोषितं वा, <sup id="ref_krm_1438_10"><a href="#foot_krm_1438_10">10</a></sup> रोषणः, <sup id="ref_krm_1438_11"><a href="#foot_krm_1438_11">11</a></sup> गृध्ररोषं रोषति इतीमान्यस्माद् भवन्तीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1438_01"><a href="#ref_krm_1438_01">↑</a> (१४२८)</li> <li id="foot_krm_1438_02"><a href="#ref_krm_1438_02">↑</a> (१-भ्वादिः-६९३। सक। सेट्। पर।)</li> <li id="foot_krm_1438_03"><a href="#ref_krm_1438_03">↑</a> (श्लो। १७९)</li> <li id="foot_krm_1438_04"><a href="#ref_krm_1438_04">↑</a> [[१। ‘तीषसहलुभरुषरिषः’ (७-२-४८) इति तकारादावार्धधातुके इड्विकल्पः। इडभाव- पक्षे ‘ष्टुना ष्टुः’ (८-४-४१) इति ष्टुत्वेन टकारः।]]</li> <li id="foot_krm_1438_05"><a href="#ref_krm_1438_05">↑</a> [[आ। ‘रेष्टारं रेषितं व्यास्यत् रोष्टाऽक्षः शस्त्रसंहतीः।।’ भ। का। ९। ३१।]]</li> <li id="foot_krm_1438_06"><a href="#ref_krm_1438_06">↑</a> (१४०८)</li> <li id="foot_krm_1438_07"><a href="#ref_krm_1438_07">↑</a> [[२। ‘रुष्यमत्वरसंघुषास्वनाम्’ (७-२-२८) इतीड्विकल्पः। धातोरस्य तकारादावार्ध- धातुके इड्विकल्पस्य विधानात् ‘यस्य विभाषा’ (७-२-१५) इति निष्ठायामिण्निषेघे प्राप्ते इड्विकल्पविधानमिति बोध्यम्। अत्र ‘मतिबुद्धिपूजार्थेभ्यश्च’ (३-२-१२८) इत्यत्र चकारस्यानुक्तसमुच्चयार्थकत्वमाश्रित्य वर्तमाने कर्तरि क्तप्रत्ययः। न्यासे (७-२-२८) ‘रुष रोषे’ इत्यस्माण्निष्ठायामिड्विकल्पस्य प्रतिंपादनात्, तत्रोपयोगाभावात्, दैवादिकस्य रोषार्थकस्य अत्र सूत्रे (७-२-२८) ग्रहणं न्यास- कारसम्मतमिति प्रतिभाति।]]</li> <li id="foot_krm_1438_08"><a href="#ref_krm_1438_08">↑</a> [[B। ‘जघान रुषितो रुष्टान् त्वरितस्तूर्णमागतान्।।’ भ। का। ९। २०।]]</li> <li id="foot_krm_1438_09"><a href="#ref_krm_1438_09">↑</a> [[३। ‘उदुपधाद् भावादिकर्मणोरन्यतरस्याम्’ (१-२-२१) इति भावे आदिकर्मणि च कित्त्वविकल्पोऽत्र।]]</li> <li id="foot_krm_1438_10"><a href="#ref_krm_1438_10">↑</a> [[४। नन्द्यादेः (३-१-१३४) आकृतिगणत्वेन कर्तरि ल्युप्रत्ययोऽत्रेति ज्ञेयम्।]]</li> <li id="foot_krm_1438_11"><a href="#ref_krm_1438_11">↑</a> [[५। ‘उपमाने कर्मणि च’ (३-४-४५) इति उपमानकर्तरि णमुल्। ‘कषादिषु--’ (३-४-४६) इति यथाविध्यनुप्रयोगः। गृध्र इव हिनस्तीत्यर्थः।]]</li></ul></p>

रुष|रोषकः-षिका|रुरोषिषकः-रुरुषिषकः-षिका|रोरुषकः-षिका|रोषिता-रोष्टा-रोष्ट्री|रोषयिता-त्री|रुरोषिषिता-रुरुषिषिता-त्री|रोरुषिता-त्री
<ul><li><sup id="ref_krm_1439_01"><a href="#foot_krm_1439_01">1</a></sup> {@“रुष रोषे”@} <sup id="ref_krm_1439_02"><a href="#foot_krm_1439_02">2</a></sup> ‘--हिंसायाम्’ इति सिद्धान्तकौमुदीपाठः। </li> <li>‘--जिहासायाम्’ इति केचित्। </li> <li>‘शपि रोषति हिंसायाम्, रोषे रुष्यति रोषयेत्।।’ <sup id="ref_krm_1439_03"><a href="#foot_krm_1439_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_1439_04"><a href="#foot_krm_1439_04">4</a></sup> रोषकः-षिका, रोषकः-षिका, रुरोषिषकः-रुरुषिषकः-षिका, रोरुषकः-षिका;</li> <li>  रोषिता-रोष्टा-रोष्ट्री, रोषयिता-त्री, रुरोषिषिता-रुरुषिषिता-त्री, रोरुषिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकरेषतिवत् <sup id="ref_krm_1439_05"><a href="#foot_krm_1439_05">5</a></sup> ज्ञेयानि। </li> <li>शतरि <sup id="ref_krm_1439_06"><a href="#foot_krm_1439_06">6</a></sup> <sup id="ref_krm_1439_07"><a href="#foot_krm_1439_07">7</a></sup> रुष्यन्-न्ती-ती, निष्ठायाम् <sup id="ref_krm_1439_08"><a href="#foot_krm_1439_08">8</a></sup> रुषितः-रुष्टः, रुषितमनेन, रुट्-रुड्- रुषौ-रुषः, <sup id="ref_krm_1439_09"><a href="#foot_krm_1439_09">9</a></sup> भीरुट्, इतीमान्यस्माद् भवन्तीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1439_01"><a href="#ref_krm_1439_01">↑</a> (१४२९)</li> <li id="foot_krm_1439_02"><a href="#ref_krm_1439_02">↑</a> (४-दिवादिः-१२३०। अक। सेट्। पर।)</li> <li id="foot_krm_1439_03"><a href="#ref_krm_1439_03">↑</a> (श्लो। १७९)</li> <li id="foot_krm_1439_04"><a href="#ref_krm_1439_04">↑</a> [पृष्ठम्११३४+ २९]</li> <li id="foot_krm_1439_05"><a href="#ref_krm_1439_05">↑</a> (१४०८)</li> <li id="foot_krm_1439_06"><a href="#ref_krm_1439_06">↑</a> [देवदत्ताय]</li> <li id="foot_krm_1439_07"><a href="#ref_krm_1439_07">↑</a> [[१। दिवादित्वात् शतरि श्यन्। ‘क्रुधद्रुहेर्ष्यासूयार्थानां यं प्रति कोपः’ (१-४-३७) इति कोपविषयस्य देवदत्तस्य सम्प्रदानसंज्ञायां ‘चतुर्थी सम्प्रदाने’ (२-३-१३) इति चतुर्थी।]]</li> <li id="foot_krm_1439_08"><a href="#ref_krm_1439_08">↑</a> [[२। ‘रुष्यमत्वर--’ (७-२-२८) इति निष्ठायामिड्विकल्पः। तकारादावार्धधातुके, ‘तीषसहलुभरुषरिषः’ (७-२-४८) इति इड्विकल्पनात्, निष्ठायाम्, ‘यस्य विभाषा’ (७-२-१५) इति इट्प्रतिषेधे प्राप्तेऽनेनेड्विकल्पोऽत्रेति बोध्यम्।]]</li> <li id="foot_krm_1439_09"><a href="#ref_krm_1439_09">↑</a> [[३। भियं रुष्यतीति भीरुट्छन्दोविशेषः। अत्र रथन्तरादिशब्देष्विवव्युत्पत्तिप्रदर्शनं कृतम्। नावयवार्थेऽभिनिवेशः कार्यः, संज्ञाशब्दत्वात्। ‘मा नानुभूः स्वकान् दोषान् मा मुहो मा रुषोऽधुना।।’ (भट्टिकाव्ये १५-१६) इत्यत्रास्य धातोः यद्यपि अकर्मकत्वं दृश्यते, तथापि अभिधानस्वाभाव्यादत्र सकर्मकत्वम्। यद्वा, भिया रुष्यतीति भीरुट् इत्यकर्मकव्युत्पत्तिरप्यत्रोपपन्नेत्यास्तां तावत्।]]</li></ul></p>

रुष|रोषकः-षिका|रुरोषयिषकः-षिका|रोषयिता-त्री|रुरोषयिषिता-त्री
<ul><li><sup id="ref_krm_1440_01"><a href="#foot_krm_1440_01">1</a></sup> {@“रुष रोषे”@} <sup id="ref_krm_1440_02"><a href="#foot_krm_1440_02">2</a></sup> ‘रुट--’ इति क्षीरस्वामी। </li> <li>‘शपि रोषति हिंसायाम्, रोषे रुष्यति रोषयेत्।।’ <sup id="ref_krm_1440_03"><a href="#foot_krm_1440_03">3</a></sup> इति देवः। </li> <li>रोषकः-षिका, रुरोषयिषकः-षिका;</li> <li>  रोषयिता-त्री, रुरोषयिषिता-त्री;</li> <li>  इत्यादीनि समस्तान्यपि रूपाणि चौरादिकचोरयतिवत् <sup id="ref_krm_1440_04"><a href="#foot_krm_1440_04">4</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1440_01"><a href="#ref_krm_1440_01">↑</a> (१४३०)</li> <li id="foot_krm_1440_02"><a href="#ref_krm_1440_02">↑</a> (१०-चुरादिः-१६७१। अक। सेट्। उभ।)</li> <li id="foot_krm_1440_03"><a href="#ref_krm_1440_03">↑</a> (श्लो। १७९)</li> <li id="foot_krm_1440_04"><a href="#ref_krm_1440_04">↑</a> (५४६)</li></ul></p>

रुसि|रुंसकः-सिका|रुरुंसयिषकः-षिका|रुंसयिता-त्री|रुरुंसयिषिता-त्री
<ul><li><sup id="ref_krm_1441_01"><a href="#foot_krm_1441_01">1</a></sup> {@“रुसि भाषार्थः”@} <sup id="ref_krm_1441_02"><a href="#foot_krm_1441_02">2</a></sup> आस्वदीयः। </li> <li>क्षीरस्वाम्यादयः अमुं न पठन्ति। </li> <li>रुंसकः-सिका, रुरुंसयिषकः-षिका;</li> <li>  रुंसयिता-त्री, रुरुंसयिषिता-त्री;</li> <li>  इत्यादिकानि सर्वाण्यपि रूपाणि चौरादिककुंशयतिवत् <sup id="ref_krm_1441_03"><a href="#foot_krm_1441_03">3</a></sup> बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1441_01"><a href="#ref_krm_1441_01">↑</a> (१४३१)</li> <li id="foot_krm_1441_02"><a href="#ref_krm_1441_02">↑</a> (१०-चुरादिः-१७९१। अक। सेट्। उभ।)</li> <li id="foot_krm_1441_03"><a href="#ref_krm_1441_03">↑</a> (२३२)</li></ul></p>

