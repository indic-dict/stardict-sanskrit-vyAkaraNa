<ul><li><sup id="ref_krm_0239_01"><a href="#foot_krm_0239_01">1</a></sup> {@“कुस संश्लेषणे”@} <sup id="ref_krm_0239_02"><a href="#foot_krm_0239_02">2</a></sup> ‘कुश--’ इति दुर्गः। </li> <li>कोसकः-सिका, कोसकः-सिका, <sup id="ref_krm_0239_03"><a href="#foot_krm_0239_03">3</a></sup> चुकुसिषकः-चुकोसिषकः-षिका, चोकुसकः-सिका;</li> <li>  कोसिता-त्री, कोसयिता-त्री, चुकुसिषिता-चुकोसिषिता-त्री, चोकुसिता-त्री;</li> <li>  <sup id="ref_krm_0239_04"><a href="#foot_krm_0239_04">4</a></sup> कुस्यन् <sup id="ref_krm_0239_05"><a href="#foot_krm_0239_05">5</a></sup> -न्ती, कोसयन्-न्ती, चुकुसिषन्-चुकोसिषन्-न्ती;</li> <li>  -- कोसिष्यन्-न्ती-ती, कोसयिष्यन्-न्ती-ती, चुकुसिषिष्यन्-चुकोसिषिष्यन्-न्ती-ती;</li> <li>  <sup id="ref_krm_0239_06"><a href="#foot_krm_0239_06">6</a></sup> <sup id="ref_krm_0239_07"><a href="#foot_krm_0239_07">7</a></sup> व्यतिकुस्यमानः, कोसयमानः, -- चोकुस्यमानः;</li> <li>  व्यतिकोसिष्यमाणः, कोसयिष्यमाणः, -- चोकुसिष्यमाणः;</li> <li>  <sup id="ref_krm_0239_08"><a href="#foot_krm_0239_08">8</a></sup> कूः-कुसौ-कुसः;</li> <li>  -- -- कुसितम्-तः, <sup id="ref_krm_0239_09"><a href="#foot_krm_0239_09">9</a></sup> कुसितायी, कोसितः, चुकुसिषितः-चुकोसिषितः, चोकुसितः-तवान्;</li> <li>  कुसः, <sup id="ref_krm_0239_10"><a href="#foot_krm_0239_10">10</a></sup> कुशः, कोसः, चुकुसिषुः-चुकोसिषुः, चोकुसः;</li> <li>  कोसितव्यम्, कोसयितव्यम्, चुकुसिषितव्यम्-चुकोसिषितव्यम्, चोकुसितव्यम्;</li> <li>  कोसनीयम्, कोसनीयम्, चुकुसिषणीयम्-चुकोसिषणीयम्, चोकुसनीयम्;</li> <li>  कोस्यम्, कोस्यम्, चुकुसिष्यम्-चुकोसिष्यम्, चोकुस्यम्;</li> <li>  ईषत्कोसः-दुष्कोसः-सुकोसः;</li> <li>  -- -- कुस्यमानः, कोस्यमानः, चुकुसिष्यमाणः-चुकोसिष्यमाणः-चोकुस्यमानः;</li> <li>  कोसः, कोसः, चुकुसिषः-चुकोसिषः, चोकुसः;</li> <li>  कोसितुम्, कोसयितुम्, चुकुसिषितुम्-चुकोसिषितुम्, चोकुसितुम्;</li> <li>  कुस्तिः, कोसना, चुकुसिषा-चुकोसिषा, चोकुसा;</li> <li>  कोसनम्, कोसनम्, चुकुसिषणम्-चुकोसिषणम्, चोकुसनम्;</li> <li>  कुसित्वा कोसित्वा कोसयित्वा, चुकुसिषित्वा-चुकोसिषित्वा, चोकुसित्वा;</li> <li>  प्रकुस्य, प्रकोस्य, प्रचुकुसिष्य-प्रचुकोसिष्य, प्रचोकुस्य;</li> <li>  कोसम् २, कुसित्वा-कोसित्वा २, कोसम् २, कोसयित्वा २, चुकुसिषिम् २-चुकोसिषम् २, चुकुसिषित्वा २-चुकोसिषित्वा २, चोकुसम् २;</li> <li>  चोकुसित्वा २। <sup id="ref_krm_0239_11"><a href="#foot_krm_0239_11">11</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0239_01"><a href="#ref_krm_0239_01">↑</a> (२३४)</li> <li id="foot_krm_0239_02"><a href="#ref_krm_0239_02">↑</a> (४-दिवादिः-१२१८। अक। सेट्। पर।)</li> <li id="foot_krm_0239_03"><a href="#ref_krm_0239_03">↑</a> [[२। ‘रलो व्युपधात्--’ (१-२-२६) इति कित्त्वविकल्पः। एवं क्त्वायामपि।]]</li> <li id="foot_krm_0239_04"><a href="#ref_krm_0239_04">↑</a> [[३। ‘दिवादिभ्यः श्यन्’ (३-१-६९) इति श्यन्।]]</li> <li id="foot_krm_0239_05"><a href="#ref_krm_0239_05">↑</a> [[C। ‘अस्तायासविजस्तविश्वतसनो निर्दस्तवासैर्नुतः वेदव्योषकृदप्लुषः विसितधीकुस्यज्जनांहोबुसम्।’ धा। का। २-६६।]]</li> <li id="foot_krm_0239_06"><a href="#ref_krm_0239_06">↑</a> [पृष्ठम्०२२४+ २०]</li> <li id="foot_krm_0239_07"><a href="#ref_krm_0239_07">↑</a> [[१। ‘कर्तरि कर्मव्यतीहारे’ (१-३-१४) इति शानच्।]]</li> <li id="foot_krm_0239_08"><a href="#ref_krm_0239_08">↑</a> [[२। ‘ससजुषो रुः’ (८-२-६६) इति रुत्वे, ‘र्वोरुपधाया दीर्घ इकः’ (८-२-७६) इति दीर्घः।]]</li> <li id="foot_krm_0239_09"><a href="#ref_krm_0239_09">↑</a> [[३। ‘वृषाकप्यग्निकुसितकुसिदानामुदात्तः’ (४-१-३७) इति प्रकृतेः ऐकारः ङीप् च पुंयोगे। कुसितः = वृद्ध्याजीवी, तत्पत्नी कुसितायी।]]</li> <li id="foot_krm_0239_10"><a href="#ref_krm_0239_10">↑</a> [[४। तालव्यान्तपाठे पचाद्यच् (३-१-१३४)। कुशः = दर्भः।]]</li> <li id="foot_krm_0239_11"><a href="#ref_krm_0239_11">↑</a> [पृष्ठम्०२२५+ २६]</li></ul></p>

कुसि
<ul><li><sup id="ref_krm_0240_01"><a href="#foot_krm_0240_01">1</a></sup> {@“कुसि भाषार्थः”@} <sup id="ref_krm_0240_02"><a href="#foot_krm_0240_02">2</a></sup> आस्वदीयः। </li> <li>‘कुशि भाषार्थः’ <sup id="ref_krm_0240_03"><a href="#foot_krm_0240_03">3</a></sup> इति पूर्वलिखितचौरादिकधातुवत्सर्वाण्यपि रूपाणि ज्ञेयानि। </li> <li>पचाद्यचि-भ्रुकुंसः-भ्रकुंसः-इति रूपे। </li> <li>‘भ्रकुंसश्च भ्रुकुंसश्च भ्रूकुंसश्चेति नर्तकः’ इत्यमरः। </li> <li>भ्रुवां कुंसयति = भाषयतीति भ्रुकुंसः। </li> <li>स्रीवेषधारी नर्तकः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0240_01"><a href="#ref_krm_0240_01">↑</a> (२३५)</li> <li id="foot_krm_0240_02"><a href="#ref_krm_0240_02">↑</a> (१०-चुरादिः-१७६४। सक। सेट्। उभ।)</li> <li id="foot_krm_0240_03"><a href="#ref_krm_0240_03">↑</a> (२३२)</li></ul></p>

कुस्म|कुस्मकः-स्मिका|चुकुस्मयिषकः-षिका|कुस्मयिता-त्री|चुकुस्मयिषिता-त्री|कुस्मयमानः|चुकुस्मयिषमाणः|कुस्मयिष्यमाणः|चुकुस्मयिषिष्यमाणः|कुः-कुस्मौ-कुस्मः|-कुस्मितम्-तः-तवान्|चुकुस्मयिषितः-तवान्|कुस्मः|कुस्मनः|चुकुस्मयिषुः|कुस्मयितव्यम्|चुकुस्मयिषितव्यम्|कुस्मनीयम्|चुकुस्मयिषणीयम्|कुस्म्यम्|चुकुस्मयिष्यम्|ईषत्कुस्मः-दुष्कुस्मः-सुकुस्मः|-|कुस्म्यमानः|चुकुस्मयिष्यमाणः|चुकुस्मयिषः|कुस्मयितुम्|चुकुस्मयिषितुम्|कुस्मना|चुकुस्मयिषा|कुस्मनम्|चुकुस्मयिषणम्|कुस्मयित्वा|चुकुस्मयिषित्वा|प्रकुस्म्य|प्रचुकुस्मयिष्य|कुस्मम्|चुकुस्मयिषम्
<ul><li><sup id="ref_krm_0241_01"><a href="#foot_krm_0241_01">1</a></sup> {@“कुस्म कुत्सितस्मयने”@} <sup id="ref_krm_0241_02"><a href="#foot_krm_0241_02">2</a></sup> आकुस्मीयः। </li> <li><sup id="ref_krm_0241_03"><a href="#foot_krm_0241_03">3</a></sup> कुस्मकः-स्मिका, चुकुस्मयिषकः-षिका;</li> <li>  कुस्मयिता-त्री, चुकुस्मयिषिता-त्री;</li> <li>  <sup id="ref_krm_0241_04"><a href="#foot_krm_0241_04">4</a></sup> कुस्मयमानः <sup id="ref_krm_0241_05"><a href="#foot_krm_0241_05">5</a></sup>, <sup id="ref_krm_0241_06"><a href="#foot_krm_0241_06">6</a></sup> चुकुस्मयिषमाणः;</li> <li>  कुस्मयिष्यमाणः, चुकुस्मयिषिष्यमाणः;</li> <li>  <sup id="ref_krm_0241_07"><a href="#foot_krm_0241_07">7</a></sup> कुः-कुस्मौ-कुस्मः;</li> <li>  -- <sup id="ref_krm_0241_08"><a href="#foot_krm_0241_08">8</a></sup> कुस्मितम्-तः-तवान्, चुकुस्मयिषितः-तवान्;</li> <li>  कुस्मः, <sup id="ref_krm_0241_09"><a href="#foot_krm_0241_09">9</a></sup> कुस्मनः, चुकुस्मयिषुः;</li> <li>  कुस्मयितव्यम्, चुकुस्मयिषितव्यम्;</li> <li>  कुस्मनीयम्, चुकुस्मयिषणीयम्;</li> <li>  कुस्म्यम्, चुकुस्मयिष्यम्;</li> <li>  ईषत्कुस्मः-दुष्कुस्मः-सुकुस्मः;</li> <li>  -- कुस्म्यमानः, चुकुस्मयिष्यमाणः;</li> <li>  <sup id="ref_krm_0241_10"><a href="#foot_krm_0241_10">10</a></sup> कुस्मः, चुकुस्मयिषः;</li> <li>  कुस्मयितुम्, चुकुस्मयिषितुम्;</li> <li>  कुस्मना, चुकुस्मयिषा;</li> <li>  कुस्मनम्, चुकुस्मयिषणम्;</li> <li>  कुस्मयित्वा, चुकुस्मयिषित्वा;</li> <li>  प्रकुस्म्य, प्रचुकुस्मयिष्य;</li> <li>  कुस्मम् २, कुस्मयित्वा २, चुकुस्मयिषम् २;</li> <li>  चुकुस्मयिषित्वा २। ‘कुस्म नाम्नो वा’ <sup id="ref_krm_0241_11"><a href="#foot_krm_0241_11">11</a></sup> इति पठ्यते। </li> <li>‘-- ‘कुस्म’ इति धातुः कुत्सितस्मये वर्तते।’ इति दुर्गमैत्रेयौ। </li> <li>तदनुसारेण ण्यन्तात्, ण्यन्तप्रकृतिकसन्नन्ताच्च सर्वाणि रूपाणि प्रदर्शितानि। </li> <li>गणसूत्रस्य एवमर्था- भ्युपगमे ‘नाम्नः’ इत्यस्य वैयर्थ्यमापतति। </li> <li>तदर्थं-- “अथ वा, ‘कुस्म’ इति प्रातिपदिकात् धात्वर्थे णिज्भवति।” इति बहुभिर्व्याख्यातम्। </li> <li>तत्र पक्षे णिचः प्रातिपदिकप्रकृतिकत्वेन, आर्धधातुकत्वं नास्ति। </li> <li>अतः ‘अतो लोपः’ <sup id="ref_krm_0241_12"><a href="#foot_krm_0241_12">12</a></sup> इति लोपो न भवति। </li> <li>किन्तु-- ‘प्रातिपदिकाद् धात्वर्थे बहुलमिष्ठवच्च’ <sup id="ref_krm_0241_13"><a href="#foot_krm_0241_13">13</a></sup> इति इष्ठवद्भावातिदेशेन प्रातिपदिकान्त्यस्य अकारस्य लोपो वक्तव्यः। </li> <li>एवं सति, कुस्मकः-स्मिका, चुकुस्मयिषकः- षिका, इत्यादीनि सर्वाण्यपि रूपाणि पुरस्तात् लिखितदिशा ज्ञेयानि। </li> <li>अर्थभेदः परमुभयोर्विद्यते-- ‘कुस्म’ धातोः कुत्सितस्मयनमात्रस्य प्रतीतिः। </li> <li>प्रातिपदिकप्रकृतिकण्यन्तस्य तु कुत्सितस्मयनकर्मककरणप्रतीतिः-- इति विशेषः। </li> <li>न चैवं सति ‘प्रातिपदिकाद् धात्वर्थे बहुलमिष्ठवच्च’ <sup id="ref_krm_0241_14"><a href="#foot_krm_0241_14">14</a></sup> इत्येव णिचि सिद्धे सति, अत्र पाठस्य वैयर्थ्यमाशङ्क्यम्। </li> <li>‘प्राति- पदिकाद् धात्वर्थे--’ <sup id="ref_krm_0241_15"><a href="#foot_krm_0241_15">15</a></sup> इति णिजुत्पत्तौ पदद्वयं स्यात्। </li> <li>अत्र पाठात् तु आकुस्मीयत्वेन आत्मनेपदमेवेति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0241_01"><a href="#ref_krm_0241_01">↑</a> (२३६)</li> <li id="foot_krm_0241_02"><a href="#ref_krm_0241_02">↑</a> (१०-चुरादिः-१७१२। अक। सेट्। आत्म।)</li> <li id="foot_krm_0241_03"><a href="#ref_krm_0241_03">↑</a> [[१। ‘णेरनिटि’ (६-४-५१) इति णिलोपः।]]</li> <li id="foot_krm_0241_04"><a href="#ref_krm_0241_04">↑</a> [[२। ‘आकुस्मादात्मनेपदिनः’ (गणसूत्रं चुरादौ) इति आत्मनेपदमेव।]]</li> <li id="foot_krm_0241_05"><a href="#ref_krm_0241_05">↑</a> [[आ। ‘इत्यादि वाद्यशतदेवनमध्य एव लोकः समालपदगारितकृष्णवीर्यः। कंसस्त्ववेदयमतिर्भयमानितोऽपि निर्यावनः कुयुधि कुस्मयमान आस्त।।’ धा। का। ३-३७।]]</li> <li id="foot_krm_0241_06"><a href="#ref_krm_0241_06">↑</a> [[३। ‘पूर्ववत् सनः’ (१-३-६२) इति आत्मनेपदम्।]]</li> <li id="foot_krm_0241_07"><a href="#ref_krm_0241_07">↑</a> [[४। णिलोपे मकारस्य संयोगान्तलोपे, सकारस्य रुत्वे, ‘र्वोरुपधायाः’ -- (८-२-७६) इति दीर्घे विसर्गे च रूपम्। प्रातिपदिकाण्णिजुत्पत्तौ तु णिलोपटिलोपयोः सतोः मकारस्य संयोगान्तलोपः, दीर्घविसर्गौ च।]]</li> <li id="foot_krm_0241_08"><a href="#ref_krm_0241_08">↑</a> [[५। ‘निष्ठायां सेटि’ (६-४-५२) इति णिलोपः।]]</li> <li id="foot_krm_0241_09"><a href="#ref_krm_0241_09">↑</a> [[६। ‘अनुदात्तेतश्च हलादेः (३-२-१४९) इति युच् ताच्छीलिकः।]]</li> <li id="foot_krm_0241_10"><a href="#ref_krm_0241_10">↑</a> [पृष्ठम्०२२६+ २९]</li> <li id="foot_krm_0241_11"><a href="#ref_krm_0241_11">↑</a> (गणसूत्रं चुरादौ)</li> <li id="foot_krm_0241_12"><a href="#ref_krm_0241_12">↑</a> (६-४-४८)</li> <li id="foot_krm_0241_13"><a href="#ref_krm_0241_13">↑</a> (गणसूत्रं चुरादौ)</li> <li id="foot_krm_0241_14"><a href="#ref_krm_0241_14">↑</a> (ग। सू चुरादौ)</li> <li id="foot_krm_0241_15"><a href="#ref_krm_0241_15">↑</a> (ग। सू। चुरादौ)</li></ul></p>

कुह|कुहकः-हिका|चुकुहयिषकः-षिका|कुहयिता-त्री|चुकुहयिषिता-त्री|कुहयमानः|चुकुहयिषमाणः|कुहयिष्यमाणः|चुकुहयिषिष्यमाणः|कुट्-कुड्-कुहौ-कुहः|-कुहितम्-तः|चुकुहयिषितः-तवान्|कुहः|चुकुहयिषुः|कुहयितव्यम्|चुकुहयिषितव्यम्|कुहनीयम्|चुकुहयिषणीयम्|कुह्यम्|चुकुहयिष्यम्|ईषत्कुहः-दुष्कुहः-सुकुहः|-|कुह्यमानः|चुकुहयिष्यमाणः|चुकुहयिषः|कुहयितुम्|चुकुहयिषितुम्|कुहना|चुकुहयिषा|कुहनम्|चुकुहयिषणम्|कुहयित्वा|चुकुहयिषित्वा|सङ्कुहय्य|सञ्चुकुहयिष्य|कुहम्|चुकुहयिषम्
<ul><li><sup id="ref_krm_0242_01"><a href="#foot_krm_0242_01">1</a></sup> {@“कुह विस्मापने”@} <sup id="ref_krm_0242_02"><a href="#foot_krm_0242_02">2</a></sup> अदन्तः, आगर्वीयः। </li> <li><sup id="ref_krm_0242_03"><a href="#foot_krm_0242_03">3</a></sup> कुहकः <sup id="ref_krm_0242_04"><a href="#foot_krm_0242_04">4</a></sup> -हिका, चुकुहयिषकः-षिका;</li> <li>  <sup id="ref_krm_0242_05"><a href="#foot_krm_0242_05">5</a></sup> कुहयिता-त्री, चुकुहयिषिता-त्री;</li> <li>  <sup id="ref_krm_0242_06"><a href="#foot_krm_0242_06">6</a></sup> कुहयमानः, चुकुहयिषमाणः;</li> <li>  कुहयिष्यमाणः, चुकुहयिषिष्यमाणः;</li> <li>  <sup id="ref_krm_0242_07"><a href="#foot_krm_0242_07">7</a></sup> कुट्-कुड्-कुहौ-कुहः;</li> <li>  -- <sup id="ref_krm_0242_08"><a href="#foot_krm_0242_08">8</a></sup> कुहितम्-तः, चुकुहयिषितः-तवान्;</li> <li>  कुहः, चुकुहयिषुः;</li> <li>  कुहयितव्यम्, चुकुहयिषितव्यम्;</li> <li>  <sup id="ref_krm_0242_09"><a href="#foot_krm_0242_09">9</a></sup> कुहनीयम्, चुकुहयिषणीयम्;</li> <li>  कुह्यम्, चुकुहयिष्यम्;</li> <li>  ईषत्कुहः-दुष्कुहः-सुकुहः;</li> <li>  -- कुह्यमानः, चुकुहयिष्यमाणः;</li> <li>  कुहः, चुकुहयिषः;</li> <li>  कुहयितुम्, चुकुहयिषितुम्;</li> <li>  कुहना, चुकुहयिषा;</li> <li>  कुहनम्, चुकुहयिषणम्;</li> <li>  कुहयित्वा, चुकुहयिषित्वा;</li> <li>  <sup id="ref_krm_0242_10"><a href="#foot_krm_0242_10">10</a></sup> सङ्कुहय्य, सञ्चुकुहयिष्य;</li> <li>  कुहम् २, कुहयित्वा २, चुकुहयिषम् २;</li> <li>  चुकुहयिषित्वा २;</li> <li>  <sup id="ref_krm_0242_11"><a href="#foot_krm_0242_11">11</a></sup> कुहूः। </li> <li><sup id="ref_krm_0242_12"><a href="#foot_krm_0242_12">12</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0242_01"><a href="#ref_krm_0242_01">↑</a> (२३७)</li> <li id="foot_krm_0242_02"><a href="#ref_krm_0242_02">↑</a> (१०-चुरादिः-१९०१। सक। सेट्। आत्म।)</li> <li id="foot_krm_0242_03"><a href="#ref_krm_0242_03">↑</a> [[१। अदन्तत्वात् ‘अतो लोपः’ (६-४-४८) इति अलोपस्य स्थानिवद्भावाल्लघूपधगुणो न। एवं सर्वत्रापि।]]</li> <li id="foot_krm_0242_04"><a href="#ref_krm_0242_04">↑</a> [[आ। ‘द्रष्टॄणां कुहकोऽथ शूरयितृभिः स्तुत्योऽसिना वीरयां- चक्रे स्थूलितभीतिरर्थितवधः सत्राशनैर्गर्धितैः।।’ धा। का। ३-५८।]]</li> <li id="foot_krm_0242_05"><a href="#ref_krm_0242_05">↑</a> [पृष्ठम्०२२७+ २१]</li> <li id="foot_krm_0242_06"><a href="#ref_krm_0242_06">↑</a> [[१। ‘आगर्वादात्मनेपदिनः’ (गणसूत्रं चुरादौ) इत्यात्मनेपदम्।]]</li> <li id="foot_krm_0242_07"><a href="#ref_krm_0242_07">↑</a> [[२। ‘हो ढः’ (८-२-३१) इति ढत्वे जश्त्वचर्त्वयोश्च रूपम्।]]</li> <li id="foot_krm_0242_08"><a href="#ref_krm_0242_08">↑</a> [[३। ‘निष्ठायां सेटि’ (६-४-५२) इति णिलोपः।]]</li> <li id="foot_krm_0242_09"><a href="#ref_krm_0242_09">↑</a> [[४। ‘णेरनिटि’ (६-४-५१) इति णिलोपः।]]</li> <li id="foot_krm_0242_10"><a href="#ref_krm_0242_10">↑</a> [[५। ‘ल्यपि लघुपूर्वात्’ (६-४-५६) इति णेरयादेशः।]]</li> <li id="foot_krm_0242_11"><a href="#ref_krm_0242_11">↑</a> [[६। ‘नृतिशृघ्योः कूः’ (द। उ। १-१७४) इत्यत्र बाहुलकादस्मादपि धातोः कूप्रत्यये कुहूः = ‘--सा नष्टेन्दुकला कुहूः।’ इत्यमरः। ‘कुहूः स्त्री कोकिलालापनष्टेन्दु- कलदर्शयोः।’ इति अमरसुधायाम्।]]</li> <li id="foot_krm_0242_12"><a href="#ref_krm_0242_12">↑</a> [पृष्ठम्०२२८+ २८]</li></ul></p>

