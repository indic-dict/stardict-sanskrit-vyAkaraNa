<ul><li><sup id="ref_krm_0369_01"><a href="#foot_krm_0369_01">1</a></sup> {@“खै खेदने”@} <sup id="ref_krm_0369_02"><a href="#foot_krm_0369_02">2</a></sup> <sup id="ref_krm_0369_03"><a href="#foot_krm_0369_03">3</a></sup> ‘खदने’ इति क्षीरस्वामि-माधवादयः। </li> <li>भक्षणे च, इति च। </li> <li>खदनम्- स्थैर्यं हिंसा च इति माधवः। </li> <li>‘खै खादने’ इति काशकृत्स्नीयधातुपाठे पठ्यते, ‘भक्षणार्थत्वं च’ इति तट्टीकायाम्’-- इति क्षीरतरङ्गिणीटीका। </li> <li>‘खनने’ इति श्रीशङ्कराचार्याः इति धातुकाव्यव्याख्यायाम् <sup id="ref_krm_0369_04"><a href="#foot_krm_0369_04">4</a></sup>।]] <sup id="ref_krm_0369_05"><a href="#foot_krm_0369_05">5</a></sup> खायकः-यिका, <sup id="ref_krm_0369_06"><a href="#foot_krm_0369_06">6</a></sup> खापकः-पिका, चिखासकः-सिका, <sup id="ref_krm_0369_07"><a href="#foot_krm_0369_07">7</a></sup> चाखायकः-यिका;</li> <li>  खाता-त्री, खापयिता-त्री, चिखासिता-त्री, चाखायिता-त्री;</li> <li>  <sup id="ref_krm_0369_08"><a href="#foot_krm_0369_08">8</a></sup> खायन्-न्ती, खापयन्-न्ती, चिखासन्-न्ती;</li> <li>  -- खास्यन्-न्ती, खापयिष्यन्-न्ती-ती, चिखासिष्यन्-न्ती-ती;</li> <li>  -- खापयमानः, खापयिष्यमाणः, चाखायमानः, चाखायिष्यमाणः;</li> <li>  प्रखाः-प्रखौ-प्रखः;</li> <li>  -- -- -- खातम्-तः, <sup id="ref_krm_0369_09"><a href="#foot_krm_0369_09">9</a></sup> खापितः, चिखासितः, चाखायितः-तवान्;</li> <li>  <sup id="ref_krm_0369_10"><a href="#foot_krm_0369_10">10</a></sup> आखाः, <sup id="ref_krm_0369_11"><a href="#foot_krm_0369_11">11</a></sup> शत्त्रुखः, <sup id="ref_krm_0369_12"><a href="#foot_krm_0369_12">12</a></sup> खायः, खापः, चिखासुः, <sup id="ref_krm_0369_13"><a href="#foot_krm_0369_13">13</a></sup> चाखाः;</li> <li>  खातव्यम्, खापयितव्यम्, चिखासितव्यम्, चाखायितव्यम्;</li> <li>  खानीयम्, खापनीयम्, चिखासनीयम्, चाखायनीयम्;</li> <li>  <sup id="ref_krm_0369_14"><a href="#foot_krm_0369_14">14</a></sup> खेयम्, खाप्यम्, चिखास्यम्, चाखाय्यम्;</li> <li>  <sup id="ref_krm_0369_15"><a href="#foot_krm_0369_15">15</a></sup> <sup id="ref_krm_0369_16"><a href="#foot_krm_0369_16">16</a></sup> ईषत्खानः-दुष्खानः-सुखानः;</li> <li>  -- -- खायमानः, खाप्यमानः, चिखास्यमानः, चाखाय्यमानः;</li> <li>  खायः, खापः, चिखासः, चाखायः;</li> <li>  खातुम्, खापयितुम्, चिखासितुम्, चाखायितुम्;</li> <li>  खातिः, <sup id="ref_krm_0369_17"><a href="#foot_krm_0369_17">17</a></sup> आखा, खापना, चिखासा, चाखाया;</li> <li>  खानम्, खापनम्, चिखासनम्, चाखायनम्;</li> <li>  खात्वा, खापयित्वा, चिखासित्वा, चाखायित्वा;</li> <li>  प्रखाय, प्रखाप्य, प्रचिखास्य, प्रचाखाय्य;</li> <li>  खायम् २, खात्वा २, खापम् २, खापयित्वा २, चिखासम् २, चिखासित्वा २, चाखायम् २;</li> <li>  चाखायित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0369_01"><a href="#ref_krm_0369_01">↑</a> (३६१)</li> <li id="foot_krm_0369_02"><a href="#ref_krm_0369_02">↑</a> (१-भ्वादिः-९१३। अक। अनि। पर।)</li> <li id="foot_krm_0369_03"><a href="#ref_krm_0369_03">↑</a> [[[अ]</li> <li id="foot_krm_0369_04"><a href="#ref_krm_0369_04">↑</a> (२-३१)</li> <li id="foot_krm_0369_05"><a href="#ref_krm_0369_05">↑</a> [[१। ‘आदेच उपदेशेऽशिति’ (६-१-४५) इति आत्वम्। ‘आतो युक् चिण्कृतोः’ (७-३-३३) इति युगागमः। एवं घञि, णमुल्यपि ज्ञेयम्।]]</li> <li id="foot_krm_0369_06"><a href="#ref_krm_0369_06">↑</a> [[२। ‘अर्तिह्रीव्लीरीक्नूयीक्ष्माय्यातां पुग् णौ’ (७-३-३६) इति पुक्। एवं सर्वत्र ण्यन्ते बोध्यम्।]]</li> <li id="foot_krm_0369_07"><a href="#ref_krm_0369_07">↑</a> [[३। ‘दीर्घोऽकितः’ (७-४-८३) इत्यभ्यासस्य दीर्घः।]]</li> <li id="foot_krm_0369_08"><a href="#ref_krm_0369_08">↑</a> [[४। शतरि, ‘एचोऽयवायावः’ (६-१-७८) इत्यायादेशः।]]</li> <li id="foot_krm_0369_09"><a href="#ref_krm_0369_09">↑</a> [[आ। ‘रायद्धयस्त्यानरुचौ रथेऽपि तं भक्तितिष्ट्यापयिषुं स दृष्ट्वा। खाताशयोऽक्षाममुदा पुनश्च मग्नोऽन्यथाऽपश्यदजानमीशम्।।’ धा। का। २-३१।]]</li> <li id="foot_krm_0369_10"><a href="#ref_krm_0369_10">↑</a> [[५। ‘आतश्चोपसर्गे’, (३-१-१३६) इति कर्तरि कः। ‘आतो लोप इटि च’ (६-४-६४) इत्याकारलोपः।]]</li> <li id="foot_krm_0369_11"><a href="#ref_krm_0369_11">↑</a> [[६। ‘आतोऽनुपसर्गे कः, (३-२-३) इति कप्रत्ययः।]]</li> <li id="foot_krm_0369_12"><a href="#ref_krm_0369_12">↑</a> [[७। ‘श्याद्व्यधास्रु--’ (३-१-१४१) इति कर्तरि णो वा।]]</li> <li id="foot_krm_0369_13"><a href="#ref_krm_0369_13">↑</a> [[८। ‘यङोऽचि च’ (२-४-७४) इति यङो लुक् भवति।]]</li> <li id="foot_krm_0369_14"><a href="#ref_krm_0369_14">↑</a> [[९। ‘अचो यत्’ (३-१-९७) इति यत्प्रत्ययः। ‘ईद्यति’ (६-४-६५) इति अङ्गस्य ईकारो भवति। गुणः।]]</li> <li id="foot_krm_0369_15"><a href="#ref_krm_0369_15">↑</a> [पृष्ठम्०३५९+ २५]</li> <li id="foot_krm_0369_16"><a href="#ref_krm_0369_16">↑</a> [[१। ‘आतो युच्’ (३-३-१२८) इति खलपवादो युच् भवति।]]</li> <li id="foot_krm_0369_17"><a href="#ref_krm_0369_17">↑</a> [[२। ‘आतश्चोपसर्गे’ (३-३-१०६) इत्यङ्प्रत्ययो भवति।]]</li></ul></p>

खोट
<ul><li><sup id="ref_krm_0370_01"><a href="#foot_krm_0370_01">1</a></sup> {@“खोट भक्षणे”@} <sup id="ref_krm_0370_02"><a href="#foot_krm_0370_02">2</a></sup> अदन्तः। </li> <li>‘खेट भक्षणे’ इत्यस्य मैत्रेयसम्मतः पाठोऽयम्। </li> <li>‘खोड’ इति तृतीयान्तं केचित् पठन्ति। </li> <li>‘केत आमन्त्रणे निमन्त्रणे च’ <sup id="ref_krm_0370_03"><a href="#foot_krm_0370_03">3</a></sup> इति चौरादिकधातुवत् सर्वाण्यपि रूपाणि ऊह्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0370_01"><a href="#ref_krm_0370_01">↑</a> (३६२)</li> <li id="foot_krm_0370_02"><a href="#ref_krm_0370_02">↑</a> (१०-चुरादिः-१८७५। सक। सेट्। उभ।)</li> <li id="foot_krm_0370_03"><a href="#ref_krm_0370_03">↑</a> (२६०)</li></ul></p>

