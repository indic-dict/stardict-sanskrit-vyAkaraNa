<ul><li><sup id="ref_krm_0404_01"><a href="#foot_krm_0404_01">1</a></sup> {@“गु पुरीषोत्सर्गे”@} <sup id="ref_krm_0404_02"><a href="#foot_krm_0404_02">2</a></sup> कुटादिः। </li> <li><sup id="ref_krm_0404_03"><a href="#foot_krm_0404_03">3</a></sup> गावकः-विका, गावकः-विका, <sup id="ref_krm_0404_04"><a href="#foot_krm_0404_04">4</a></sup> जुगूषकः-षिका, <sup id="ref_krm_0404_05"><a href="#foot_krm_0404_05">5</a></sup> जोगूयकः-यिका;</li> <li>  <sup id="ref_krm_0404_06"><a href="#foot_krm_0404_06">6</a></sup> गुता-त्री, गावयिता-त्री, जुगूषिता-त्री, जोगूयिता-त्री;</li> <li>  <sup id="ref_krm_0404_07"><a href="#foot_krm_0404_07">7</a></sup> गुवन् <sup id="ref_krm_0404_08"><a href="#foot_krm_0404_08">8</a></sup> -न्ती, गावयन्-न्ती, जुगूषन्-न्ती;</li> <li>  -- <sup id="ref_krm_0404_09"><a href="#foot_krm_0404_09">9</a></sup> गुष्यन्-न्ती-ती, गावयिष्यन्-न्ती-ती, जुगूषिष्यन्-न्ती-ती;</li> <li>  -- -- गावयमानः;</li> <li>  गावयिष्यमाणः, -- जोगूयमानः-जोगूयिष्यमाणः;</li> <li>  प्रगुत्-प्रगुतौ-प्रगुतः;</li> <li>  -- -- -- <sup id="ref_krm_0404_10"><a href="#foot_krm_0404_10">10</a></sup> गूनम्-नः-नवान्;</li> <li>  गावितः, जुगूषितः, जोगूयितः-तवान्;</li> <li>  गुवः, गावः, जुगूषुः, <sup id="ref_krm_0404_11"><a href="#foot_krm_0404_11">11</a></sup> जोगुवः;</li> <li>  गुतव्यम्, गावयितव्यम्, जुगूषितव्यम्, जोगूयितव्यम्;</li> <li>  गुवनीयम्, गावनीयम्, जुगूषणीयम्, जोगूयनीयम्;</li> <li>  <sup id="ref_krm_0404_12"><a href="#foot_krm_0404_12">12</a></sup> गुयम्, <sup id="ref_krm_0404_13"><a href="#foot_krm_0404_13">13</a></sup> अवश्यगाव्यम्, गाव्यम्, जुगूष्यम्, जोगूय्यम्;</li> <li>  ईषद्गुवः-दुर्गुवः-सुगुवः;</li> <li>  -- -- <sup id="ref_krm_0404_14"><a href="#foot_krm_0404_14">14</a></sup> गूयमानः, गाव्यमानः, जुगूष्यमाणः, जोगूय्यमानः;</li> <li>  <sup id="ref_krm_0404_15"><a href="#foot_krm_0404_15">15</a></sup> गुवः, गावः, जुगूषः, जोगूयः;</li> <li>  गुतुम्, गावयितुम्, जुगूषितुम्, जोगूयितुम्;</li> <li>  गुतिः, गावना, जुगूषा, जोगूया;</li> <li>  गुवनम्, गावनम्, जुगूषणम्, जोगूयनम्;</li> <li>  गुत्वा, गावयित्वा, जुगूषित्वा, जोगूयित्वा;</li> <li>  सङ्गुत्य, सङ्गाव्य, सञ्जुगूष्य, सञ्जोगूय्य;</li> <li>  गावम् २, गुत्वा २, गावम् २, गावयित्वा २, जुगूषम् २, जुगूषित्वा २, जोगूयम् २;</li> <li>  जोगूयित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0404_01"><a href="#ref_krm_0404_01">↑</a> (३९६)</li> <li id="foot_krm_0404_02"><a href="#ref_krm_0404_02">↑</a> (६-तुदादिः-१३९९। अक। अनि। पर।)</li> <li id="foot_krm_0404_03"><a href="#ref_krm_0404_03">↑</a> [[४। अस्य कुटादित्वेऽपि, ण्वुलो णित्त्वात्, णिद्भिन्नस्यैव ङित्त्वविधानात् ‘गाङ्कुटा- दिभ्यः--’ (१-२-१) इति ङित्त्वं न।]]</li> <li id="foot_krm_0404_04"><a href="#ref_krm_0404_04">↑</a> [[५। ‘अज्झनगमां सनि’ (६-४-१६) इति दीर्घः।]]</li> <li id="foot_krm_0404_05"><a href="#ref_krm_0404_05">↑</a> [[६। ‘अकृत्सार्वधातुकयोः--’ (७-४-२५) इति दीर्घः। अभ्यासस्य गुणः।]]</li> <li id="foot_krm_0404_06"><a href="#ref_krm_0404_06">↑</a> [[७। तृचो ङिद्वद्भावाद् गुणो न। एवं ञ्णिद्भिन्ने सर्वत्र गुणवृद्धिनिषेधो बोध्यः।]]</li> <li id="foot_krm_0404_07"><a href="#ref_krm_0404_07">↑</a> [[८। ‘तुदादिभ्यः शः’ (३-१-७७) इति शः विकरणप्रत्ययः। ‘अचि श्नुधातु--’ (६-४-७७) इत्युवङादेशः।]]</li> <li id="foot_krm_0404_08"><a href="#ref_krm_0404_08">↑</a> [[आ। ‘नूत्या किं भयधूतविद्रुतगुवल्लोकं तदा तद्धुवत्- कोदण्डं कुवमानमैक्षि दलितं भोजेश्वराकूतवत्।।’ धा। का। ८। ८२।]]</li> <li id="foot_krm_0404_09"><a href="#ref_krm_0404_09">↑</a> [पृष्ठम्०३८९+ २५]</li> <li id="foot_krm_0404_10"><a href="#ref_krm_0404_10">↑</a> [[१। ‘दुग्वोर्दीर्घश्च’ (वा। ८-२-४४) इति निष्ठानत्वम् दीर्घश्च।]]</li> <li id="foot_krm_0404_11"><a href="#ref_krm_0404_11">↑</a> [[२। यङो लुकि उवङादेशः।]]</li> <li id="foot_krm_0404_12"><a href="#ref_krm_0404_12">↑</a> [[३। ङिद्वद्भावादङ्गस्य गुणो न।]]</li> <li id="foot_krm_0404_13"><a href="#ref_krm_0404_13">↑</a> [[४। ‘ओरावश्यके’ (३-१-१२५) इति ण्यत्।]]</li> <li id="foot_krm_0404_14"><a href="#ref_krm_0404_14">↑</a> [[५। ‘अकृत्सार्वधातुकयोः--’ (७-४-२५) इति दीर्घः।]]</li> <li id="foot_krm_0404_15"><a href="#ref_krm_0404_15">↑</a> [[६। ‘ॠदोरप्’ (३-३-५७) इति अप्। उवङ्।]]</li></ul></p>

गुङ्|गावकः-विका|जुगूषकः-षिका|जोगूयकः-यिका
<ul><li><sup id="ref_krm_0405_01"><a href="#foot_krm_0405_01">1</a></sup> {@“गुङ् अव्यक्ते शब्दे”@} <sup id="ref_krm_0405_02"><a href="#foot_krm_0405_02">2</a></sup> गावकः-विका, गावकः-विका, जुगूषकः-षिका, जोगूयकः-यिका;</li> <li>  <sup id="ref_krm_0405_03"><a href="#foot_krm_0405_03">3</a></sup> गवमानः, <sup id="ref_krm_0405_04"><a href="#foot_krm_0405_04">4</a></sup> गुतः, इत्यादीनि सर्वाण्यपि रूपाणि कवतिवत् <sup id="ref_krm_0405_05"><a href="#foot_krm_0405_05">5</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0405_06"><a href="#foot_krm_0405_06">6</a></sup> ‘न कवतेर्यङि’ <sup id="ref_krm_0405_07"><a href="#foot_krm_0405_07">7</a></sup> इति निषेधस्तु नात्र प्रवर्तते--इति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0405_01"><a href="#ref_krm_0405_01">↑</a> (३९७)</li> <li id="foot_krm_0405_02"><a href="#ref_krm_0405_02">↑</a> (१-भ्वादिः-९४९। सक। अनि। आत्म।)</li> <li id="foot_krm_0405_03"><a href="#ref_krm_0405_03">↑</a> [[आ। ‘श्रुत्यन्तवाचा ध्रुवया प्रदूनं घोरद्रवच्चक्रजिताज्ञितारिम्। स्मितार्द्रवक्त्रं गवमानभूषं गै त्वां घुताशं कुतशङ्खघोषैः।।’ धा। का। २। ३५।]]</li> <li id="foot_krm_0405_04"><a href="#ref_krm_0405_04">↑</a> [[७। ‘दुग्वोर्दीर्घश्च’ (वा। ८-२-४४) इति निष्ठानत्वदीर्घे नास्य धातोर्भवतः--निरनुबन्ध- कपरिभाषया तौदादिकस्यैव तत्र ग्रहणात्।]]</li> <li id="foot_krm_0405_05"><a href="#ref_krm_0405_05">↑</a> (१९८)</li> <li id="foot_krm_0405_06"><a href="#ref_krm_0405_06">↑</a> [पृष्ठम्०३९०+ २७]</li> <li id="foot_krm_0405_07"><a href="#ref_krm_0405_07">↑</a> (७-४-६३)</li></ul></p>

गुज
<ul><li><sup id="ref_krm_0406_01"><a href="#foot_krm_0406_01">1</a></sup> {@“गुज शब्दे”@} <sup id="ref_krm_0406_02"><a href="#foot_krm_0406_02">2</a></sup> कुटादिः। </li> <li>“गुञ्जेदव्यक्तशब्दे स्यात्, शब्दमात्रे गुजेदिति।।” <sup id="ref_krm_0406_03"><a href="#foot_krm_0406_03">3</a></sup> इति देवः। </li> <li>‘अव्यक्ते शब्दे’ इत्यात्रेयः। </li> <li>गोजकः-जिका गोजकः-जिका, जुगुजिषकः-षिका, जोगुजकः-जिका, <sup id="ref_krm_0406_04"><a href="#foot_krm_0406_04">4</a></sup> गुजन्- न्ती-ती, गोजः इत्यादीनि तौदादिककुचतिवत् <sup id="ref_krm_0406_05"><a href="#foot_krm_0406_05">5</a></sup> सर्वाणि रूपाणि बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0406_01"><a href="#ref_krm_0406_01">↑</a> (३९८)</li> <li id="foot_krm_0406_02"><a href="#ref_krm_0406_02">↑</a> (६-तुदादिः-१३६९। सक। सेट्। पर।)</li> <li id="foot_krm_0406_03"><a href="#ref_krm_0406_03">↑</a> (श्लो। ६७)</li> <li id="foot_krm_0406_04"><a href="#ref_krm_0406_04">↑</a> [[आ। ‘ततोऽतिकुटिलाशयैः प्रपुटितैः कुचज्जीवितैः गुजद्भिरपि सैनिकै सुगुडितां डिपद्भिर्जनान्।’ धा। का। २। ८०।]]</li> <li id="foot_krm_0406_05"><a href="#ref_krm_0406_05">↑</a> (२०२)</li></ul></p>

गुजि|इदित्पक्षे|गुञ्जकः-ञ्जिका|जुगुञ्जिषकः-षिका|जोगुञ्जकः-ञ्जिका|गुञ्जन्-न्ती|गुञ्जा
<ul><li><sup id="ref_krm_0407_01"><a href="#foot_krm_0407_01">1</a></sup> {@“गुजि अव्यक्ते शब्दे”@} <sup id="ref_krm_0407_02"><a href="#foot_krm_0407_02">2</a></sup> ‘गुञ्जेदव्यक्तशब्दे स्यात्, शब्दमात्रे गुजेदिति।।’ <sup id="ref_krm_0407_03"><a href="#foot_krm_0407_03">3</a></sup> इति देवः। </li> <li>‘गुज’ इति केचित् पठन्ति। </li> <li>इदित्पक्षे गुञ्जकः-ञ्जिका, गुञ्जकः-ञ्जिका, जुगुञ्जिषकः-षिका, जोगुञ्जकः-ञ्जिका, गुञ्जन्-न्ती, गुञ्जा;</li> <li>  इत्यादीनि रूपाणि कुण्ठतिवत् <sup id="ref_krm_0407_04"><a href="#foot_krm_0407_04">4</a></sup> ज्ञेयानि। </li> <li>अनिदित्पक्षे गोजकः-जिका, इत्यादीनि रूपाणि भौवादिककोचतिवत् <sup id="ref_krm_0407_05"><a href="#foot_krm_0407_05">5</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0407_01"><a href="#ref_krm_0407_01">↑</a> (३९९)</li> <li id="foot_krm_0407_02"><a href="#ref_krm_0407_02">↑</a> (१-भ्वादिः-२०३। सक। सेट्। पर।)</li> <li id="foot_krm_0407_03"><a href="#ref_krm_0407_03">↑</a> (श्लो। ६७)</li> <li id="foot_krm_0407_04"><a href="#ref_krm_0407_04">↑</a> (२०९)</li> <li id="foot_krm_0407_05"><a href="#ref_krm_0407_05">↑</a> (२००)</li></ul></p>

गुठि|गुण्ठकः-ण्ठिका|जुगुण्ठयिषकः-षिका|गुण्ठयिता-त्री|जुगुण्ठयिषिता-त्री
<ul><li><sup id="ref_krm_0408_01"><a href="#foot_krm_0408_01">1</a></sup> {@“गुठि वेष्टने”@} <sup id="ref_krm_0408_02"><a href="#foot_krm_0408_02">2</a></sup> ‘गुडि वेष्टने’ इत्यस्य पाठान्तरम्। </li> <li>गुण्ठकः-ण्ठिका, जुगुण्ठयिषकः-षिका, गुण्ठयिता-त्री, जुगुण्ठयिषिता-त्री;</li> <li>  इत्यादीनि सर्वाणि रूपाणि चौरादिककुण्ठयतिवत् <sup id="ref_krm_0408_03"><a href="#foot_krm_0408_03">3</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0408_01"><a href="#ref_krm_0408_01">↑</a> (४००)</li> <li id="foot_krm_0408_02"><a href="#ref_krm_0408_02">↑</a> (१०-चुरादिः-१५८४। सक। सेट्। उभ।)</li> <li id="foot_krm_0408_03"><a href="#ref_krm_0408_03">↑</a> (२१०)</li></ul></p>

