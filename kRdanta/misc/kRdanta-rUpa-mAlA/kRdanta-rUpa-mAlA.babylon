<ul><li><sup id="ref_krm_0674_01"><a href="#foot_krm_0674_01">1</a></sup> {@“णम प्रह्वत्वे, शब्दे च”@} <sup id="ref_krm_0674_02"><a href="#foot_krm_0674_02">2</a></sup> ‘--शब्दे च’ इत्यर्थः क्षीरस्वामिना न पठ्यते। </li> <li>नामकः-मिका, <sup id="ref_krm_0674_03"><a href="#foot_krm_0674_03">3</a></sup> नमकः-नामकः- <sup id="ref_krm_0674_04"><a href="#foot_krm_0674_04">4</a></sup> प्रणमकः-मिका, <sup id="ref_krm_0674_05"><a href="#foot_krm_0674_05">5</a></sup> निनंसकः-सिका, <sup id="ref_krm_0674_06"><a href="#foot_krm_0674_06">6</a></sup> नंनमकः-नन्नमकः-मिका;</li> <li>  <sup id="ref_krm_0674_07"><a href="#foot_krm_0674_07">7</a></sup> नन्ता-त्री, नमयिता-नामयिता-प्रणमयिता-त्री, निनंसिता-त्री, नंनमिता-नन्नमिता-त्री;</li> <li>  नमन्-न्ती, नमयन्-नामयन्-प्रणमयन्-न्ती, <sup id="ref_krm_0674_08"><a href="#foot_krm_0674_08">8</a></sup> उन्नामयन्, निनंसन्-न्ती;</li> <li>  -- नंस्यन्-न्ती-ती, नमयिष्यन्-नामयिष्यन्-प्रणमयिष्यन्-न्ती-ती, निनंसिष्यन्-न्ती-ती;</li> <li>  -- -- नमयमानः-नामयमानः-प्रणमयमानः, -- नंनम्यमानः;</li> <li>  -- नमयिष्यमाणः-नामयिष्यमाणः-प्रणमयिष्यमाणः, -- नंनमिष्यमाणः;</li> <li>  <sup id="ref_krm_0674_09"><a href="#foot_krm_0674_09">9</a></sup> <sup id="ref_krm_0674_10"><a href="#foot_krm_0674_10">10</a></sup> प्रणान्-प्रणामौ-प्रणामः;</li> <li>  -- -- -- <sup id="ref_krm_0674_11"><a href="#foot_krm_0674_11">11</a></sup> नतम्-नतः-नतवान्, नमितः-नामितः-प्रणमितः, निनंसितः, नंनमितः-तवान्;</li> <li>  नमः, <sup id="ref_krm_0674_12"><a href="#foot_krm_0674_12">12</a></sup> नृनमः, <sup id="ref_krm_0674_13"><a href="#foot_krm_0674_13">13</a></sup> प्रणामी, <sup id="ref_krm_0674_14"><a href="#foot_krm_0674_14">14</a></sup> नप्ता, <sup id="ref_krm_0674_15"><a href="#foot_krm_0674_15">15</a></sup> नेमिः, <sup id="ref_krm_0674_16"><a href="#foot_krm_0674_16">16</a></sup> नमनः, <sup id="ref_krm_0674_17"><a href="#foot_krm_0674_17">17</a></sup> नम्रः,-प्रणम्रः, <sup id="ref_krm_0674_18"><a href="#foot_krm_0674_18">18</a></sup> नमः-नामः-प्रणमः, निनंसुः, नंनमः;</li> <li>  नन्तव्यम्, नमयितव्यम्-नामयितव्यम्-प्रणमयितव्यम्, निनंसितव्यम्, नंनमितव्यम्;</li> <li>  नमनीयम्, नमनीयम्-नामनीयम्-प्रणमनीयम्, निनंसनीयम्, नंनमनीयम्;</li> <li>  <sup id="ref_krm_0674_19"><a href="#foot_krm_0674_19">19</a></sup> नम्यम्, नम्यम्-नाम्यम्-प्रणम्यम्, निनंस्यम्, नंनम्यम्;</li> <li>  ईषन्नमः- <sup id="ref_krm_0674_20"><a href="#foot_krm_0674_20">20</a></sup> दुर्नमः-सुनमः;</li> <li>  -- -- -- नम्यमानः-नम्यमानः-नाम्यमानः-प्रणम्यमानः, निनंस्यमानः, <sup id="ref_krm_0674_21"><a href="#foot_krm_0674_21">21</a></sup> नंनम्यमानः;</li> <li>  <sup id="ref_krm_0674_22"><a href="#foot_krm_0674_22">22</a></sup> उन्नामः-प्रणामः, नामः, नमः-नामः-प्रणमः, निनंसः, नंनमः;</li> <li>  नन्तुम्, नमयितुम्-नामयितुम्-प्रणमयितुम्, निनंसितुम्, नंनमितुम्;</li> <li>  नतिः, नमना-नामना-प्रणमना, निनंसा, नंनमा;</li> <li>  नमनम्, नृनमनम्, नमनम्-नामनम्-प्रणमनम्, निनंसनम्, नंनमनम्;</li> <li>  नत्वा, नमयित्वा-नामयित्वा, निनंसित्वा, नंनमित्वा;</li> <li>  <sup id="ref_krm_0674_23"><a href="#foot_krm_0674_23">23</a></sup> प्रणत्य-प्रणम्य, <sup id="ref_krm_0674_24"><a href="#foot_krm_0674_24">24</a></sup> प्रणमय्य, प्रणिनंस्य, प्रणंनम्य;</li> <li>  नामम् २, नत्वा २, <sup id="ref_krm_0674_25"><a href="#foot_krm_0674_25">25</a></sup> नमम् २ -नामम् २ -नामम् २ -प्रणमम् २ -प्रणामम् २, नमयित्वा २ -नामयित्वा २, निनंसम् २, निनंसित्वा २, नंनमम् २;</li> <li>  नंनमित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0674_01"><a href="#ref_krm_0674_01">↑</a> (६६४)</li> <li id="foot_krm_0674_02"><a href="#ref_krm_0674_02">↑</a> (१-भ्वादिः-९८१। सक। अनि। पर। घटादिः।)</li> <li id="foot_krm_0674_03"><a href="#ref_krm_0674_03">↑</a> [[१। ‘ज्वलह्वलह्मलनमामनुपसर्गाद्वा’ (ग। सू। घटादौ) इति, उपसर्गसमभिव्या- हाराभावे मित्संज्ञा विकल्प्यते। मित्त्वपक्षे उपधाह्रस्वः। एवं ण्यन्ते सर्वत्रोपसर्ग- समभिव्याहाराभावे रूपद्वयं बोध्यम्।]]</li> <li id="foot_krm_0674_04"><a href="#ref_krm_0674_04">↑</a> [[२। उपसर्गसमभिव्याहारे तु ‘जनीजॄष्क्रसुरञ्जोऽमन्ताश्च’ (ग। सू। घटादौ) इत्यनेनामन्त- त्वात् नित्यं मित्त्वम्। तेन णौ उपधाह्रस्वः। ‘उपसर्गादसमासेऽपि णोपदेशस्य’ (८-४-१४) इति णत्वम्। एवम् उपसर्गसमभिव्याहारे सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0674_05"><a href="#ref_krm_0674_05">↑</a> [[३। सन्नन्तात् ण्वुलि, ‘नश्चापदान्तस्य झलि’ (८-३-२४) इति अनुस्वारः। एवं सन्नन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0674_06"><a href="#ref_krm_0674_06">↑</a> [[४। ‘नुगतोऽनुनासिकान्तस्य’ (७-४-८५) इति नुगागमः। ‘नुकाऽनुस्वारो लक्ष्यते’ इति भाष्ये उक्तम्। ‘स च पदान्तवद्वाच्यः’ (वा। ७-४-८५) इति वचनात् पक्षे ‘वा पदान्तस्य’ (८-४-५९) इति परसवर्णविकल्पः। एवं यङन्ते सर्वत्र रूपद्वयं बोध्यम्।]]</li> <li id="foot_krm_0674_07"><a href="#ref_krm_0674_07">↑</a> [[५। अस्य घातोरनुदात्तत्वात् ‘एकाच उपदेशेऽनुदात्तात्’ (७-२-१०) इतीण्णिषेधः। वलाद्यार्धधातुके सर्वत्र एवं बोध्यम्।]]</li> <li id="foot_krm_0674_08"><a href="#ref_krm_0674_08">↑</a> [[६। उपसर्गसमभिव्याहारे नित्यं मित्त्वात्, उन्नामयन् इत्यस्य साधुत्वाय घञन्ता- दुन्नामशब्दात् ‘तत्करोति तदाचष्टे’ (वा। ३-१-२६) इति णिजन्तात् शता कल्पनीयः इति सिद्धान्तकौमुदी।]]</li> <li id="foot_krm_0674_09"><a href="#ref_krm_0674_09">↑</a> [पृष्ठम्०६१७+ २६]</li> <li id="foot_krm_0674_10"><a href="#ref_krm_0674_10">↑</a> [[१। क्विपि, ‘अनुनासिकस्य क्विझलोः--’ (६-४-१५) इति उपधादीर्घे, ‘मो नो धातोः’ (८-२-६४) इति नत्वे, णत्वे च रूपम्।]]</li> <li id="foot_krm_0674_11"><a href="#ref_krm_0674_11">↑</a> [[२। ‘अनुदात्तोपदेशवनतितनोत्यादीनाम्--’ (६-४-३७) इत्यनुनासिकलोपः। एवं नतिः नत्वा इत्यात्रापि नलोपो बोध्यः।]]</li> <li id="foot_krm_0674_12"><a href="#ref_krm_0674_12">↑</a> [[३। नॄन् नमयतीति नृनमः। ण्यन्तात्, अन्तर्भावितण्यन्तात् शुद्धाद्वा धातोः पचाद्यच्। ‘क्ष्नुभ्नादिषु च’ (८-४-३९) इत्यत्र पाठात् णत्वं न। एवं नृनमनमित्यत्रापि ज्ञेयम्।]]</li> <li id="foot_krm_0674_13"><a href="#ref_krm_0674_13">↑</a> [[४। ताच्छील्ये णिनिः। णत्वम्।]]</li> <li id="foot_krm_0674_14"><a href="#ref_krm_0674_14">↑</a> [[५। ‘तृन्’ (३-२-१३५) इति ताच्छीलिके तृनि, ‘अप्तृन्तृच्स्वसृनप्तृ--’ (६-४-११) इति सूत्रे निपातनात् मकारस्य पकार इति माधवधातुवृत्तिः। संज्ञाशब्दत्वान्ना- वयवार्थेऽभिनिवेशः कार्यः। पौत्रस्य अपत्यम् = नप्ता।]]</li> <li id="foot_krm_0674_15"><a href="#ref_krm_0674_15">↑</a> [[६। ‘भाषायां धाञ्कृञ्सृजनिगमिनमिभ्यः--’ (वा। ३-२-१७१) इति किः किन् वा प्रत्ययः। तस्य लिड्वद्भावातिदेशात् द्वित्वे, एत्वाभ्यासलोपयो रूपम्। नेमिः = रथनाभिः।]]</li> <li id="foot_krm_0674_16"><a href="#ref_krm_0674_16">↑</a> [[७। शब्दार्थकत्वादस्य ‘चलनशब्दार्थादकर्मकात्--’ (३-२-१४८) इति ताच्छी- लिको युच्।]]</li> <li id="foot_krm_0674_17"><a href="#ref_krm_0674_17">↑</a> [[८। ‘नमिकम्पि--’ (३-२-१६७) इति ताच्छीलिको रप्रत्ययः।]]</li> <li id="foot_krm_0674_18"><a href="#ref_krm_0674_18">↑</a> [[आ। ‘द्रुतविगमितविप्रयोगचिह्नामपि तनयां नृपतिः पदप्रणम्राम्।’ नैषधे ४। १८।]]</li> <li id="foot_krm_0674_19"><a href="#ref_krm_0674_19">↑</a> [[९। ‘पोरदुपधात्’ (३-१-९८) इति यत्।]]</li> <li id="foot_krm_0674_20"><a href="#ref_krm_0674_20">↑</a> [[१०। ‘दुरः षत्वणत्वयोरुपसर्गत्वप्रतिषेधः--’ (वा। १-४-६०) इति वचनान्न णत्वम्।]]</li> <li id="foot_krm_0674_21"><a href="#ref_krm_0674_21">↑</a> [[B। ‘नंनम्यमानाः फलदित्सयेव चकाशिरे तत्र लता विलोलाः।।’ भ। का। २। २५।]]</li> <li id="foot_krm_0674_22"><a href="#ref_krm_0674_22">↑</a> [पृष्ठम्०६१८+ २१]</li> <li id="foot_krm_0674_23"><a href="#ref_krm_0674_23">↑</a> [[१। ‘वा ल्यपि’ (६-४-३८) इति अनुनासिकलोपविकल्पः। अनुनासिकलोपपक्षे ‘ह्रस्वस्य पिति--’ (६-१-७१) इति तुक्।]]</li> <li id="foot_krm_0674_24"><a href="#ref_krm_0674_24">↑</a> [[२। ‘ल्यपि लघुपूर्वात्’ (६-४-५६) इति णेरयादेशः।]]</li> <li id="foot_krm_0674_25"><a href="#ref_krm_0674_25">↑</a> [[३। ‘चिण्णमुलोर्दीर्घोऽन्यतरस्याम्’ (६-४-९३) इति णमुल्परे णौ दीर्घविकल्पः।]]</li></ul></p>

णय|नायकः-यिका|निनयिषकः-षिका|नानयकः-यिका
<ul><li><sup id="ref_krm_0675_01"><a href="#foot_krm_0675_01">1</a></sup> {@“णय गतौ”@} <sup id="ref_krm_0675_02"><a href="#foot_krm_0675_02">2</a></sup> ‘--रक्षणे च’ इति मैत्रेयः। </li> <li>क्षीरस्वामी तु ‘नय--’ इति पपाठ। </li> <li>स पाठश्चिन्त्यः। </li> <li>सर्वत्र णोपदेशेनैवोपलम्भात्। </li> <li>नायकः-यिका, नायकः-यिका, निनयिषकः-षिका, नानयकः-यिका;</li> <li>  <sup id="ref_krm_0675_03"><a href="#foot_krm_0675_03">3</a></sup> नयितः, <sup id="ref_krm_0675_04"><a href="#foot_krm_0675_04">4</a></sup> प्रणयमानः, इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकचयतिवत् <sup id="ref_krm_0675_05"><a href="#foot_krm_0675_05">5</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0675_01"><a href="#ref_krm_0675_01">↑</a> (६६५)</li> <li id="foot_krm_0675_02"><a href="#ref_krm_0675_02">↑</a> (१-भ्वादिः-४८०। सक। सेट्। आत्म।)</li> <li id="foot_krm_0675_03"><a href="#ref_krm_0675_03">↑</a> [[आ। ‘प्रतय्य किञ्चिन्नयितो गृहान्तिकं ददर्श धन्यः स दयालुमीश्वरम्।’ धा। का। १। ६२।]]</li> <li id="foot_krm_0675_04"><a href="#ref_krm_0675_04">↑</a> [[४। ‘उपसर्गादसमासेऽपि णोपदेशस्य’ (८-४-१४) इति णत्वम्।]]</li> <li id="foot_krm_0675_05"><a href="#ref_krm_0675_05">↑</a> (५०२)</li></ul></p>

णल|नालकः-लिका|प्रणालकः-लिका|निनलिषकः-षिका|नानलकः-लिका
<ul><li><sup id="ref_krm_0676_01"><a href="#foot_krm_0676_01">1</a></sup> {@“णल गन्धे”@} <sup id="ref_krm_0676_02"><a href="#foot_krm_0676_02">2</a></sup> ज्वलादिः। </li> <li>‘--बन्धने’ इति काश्यपः। </li> <li>गन्धः = हिंसनं वासना व। </li> <li>नालकः-लिका, प्रणालकः-लिका, निनलिषकः-षिका, नानलकः-लिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकचलतिवत् <sup id="ref_krm_0676_03"><a href="#foot_krm_0676_03">3</a></sup> ज्ञेयानि। </li> <li>घटादि- <sup id="ref_krm_0676_04"><a href="#foot_krm_0676_04">4</a></sup> कार्यं तु नास्य भवतीति विशेषः। </li> <li><sup id="ref_krm_0676_05"><a href="#foot_krm_0676_05">5</a></sup> नलः, <sup id="ref_krm_0676_06"><a href="#foot_krm_0676_06">6</a></sup> नालः, <sup id="ref_krm_0676_07"><a href="#foot_krm_0676_07">7</a></sup>] नलः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0676_01"><a href="#ref_krm_0676_01">↑</a> (६६६)</li> <li id="foot_krm_0676_02"><a href="#ref_krm_0676_02">↑</a> (१-भ्वादिः-८३८। अक। सेट्। पर।)</li> <li id="foot_krm_0676_03"><a href="#ref_krm_0676_03">↑</a> (५१०)</li> <li id="foot_krm_0676_04"><a href="#ref_krm_0676_04">↑</a> [पृष्ठम्०६१९+ २६]</li> <li id="foot_krm_0676_05"><a href="#ref_krm_0676_05">↑</a> [[१। शत्रून् नलति = बध्नातीति नलः = नृपतिविशेषः। कर्तरि पचाद्यच्।]]</li> <li id="foot_krm_0676_06"><a href="#ref_krm_0676_06">↑</a> [[२। ‘हलश्च’ (३-३-१२१) इति संज्ञायां घञ्। नालः = बिसतन्तुः।]]</li> <li id="foot_krm_0676_07"><a href="#ref_krm_0676_07">↑</a> [[३। नल्यते इति नलः = गन्धविशेषः। [नलदम् = लामज्जकम्।]]</li></ul></p>

