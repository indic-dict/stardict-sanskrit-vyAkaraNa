<ul><li><sup id="ref_krm_0380_01"><a href="#foot_krm_0380_01">1</a></sup> {@“गद व्यक्तायां वाचि”@} <sup id="ref_krm_0380_02"><a href="#foot_krm_0380_02">2</a></sup> ‘णौ देवशब्दे गदयेत्, व्यक्तवाचि गदेच्छपि।’ <sup id="ref_krm_0380_03"><a href="#foot_krm_0380_03">3</a></sup> इति देवः। </li> <li>गादकः-दिका, गादकः-दिका, जिगदिषकः-षिका, जागदकः-दिका;</li> <li>  गदिता-त्री, गादयिता-त्री, जिगदिषिता-त्री, जागदिता-त्री;</li> <li>  <sup id="ref_krm_0380_04"><a href="#foot_krm_0380_04">4</a></sup> व्यतिगदन् <sup id="ref_krm_0380_05"><a href="#foot_krm_0380_05">5</a></sup> -न्ती, प्रणिगदन्-न्ती <sup id="ref_krm_0380_06"><a href="#foot_krm_0380_06">6</a></sup>, गादयन्-न्ती, जिगदिषन्-न्ती;</li> <li>  गदिष्यन्-न्ती-ती, गादयिष्यन्-न्ती-ती, जिगदिषिष्यन्-न्ती-ती;</li> <li>  -- -- गादयमानः, गादयिष्यमाणः, -- जागद्यमानः, जागदिष्यमाणः;</li> <li>  सुगद्-सुगदौ-सुगदः;</li> <li>  -- -- -- गदितम्-तः- <sup id="ref_krm_0380_07"><a href="#foot_krm_0380_07">7</a></sup> तवान्, गादितः, जिगदिषितः, जागदितः-तवान्;</li> <li>  गदः, <sup id="ref_krm_0380_08"><a href="#foot_krm_0380_08">8</a></sup> आनुगादिकः, गादः, जिगदिषुः, जागदः;</li> <li>  <sup id="ref_krm_0380_09"><a href="#foot_krm_0380_09">9</a></sup> गदितव्यम्, गादयितव्यम्, जिगदिषितव्यम्, जागदितव्यम्;</li> <li>  गदनीयम्, गादनीयम्, जिगदिषणीयम्, जागदनीयम्;</li> <li>  <sup id="ref_krm_0380_10"><a href="#foot_krm_0380_10">10</a></sup> गद्यम्, <sup id="ref_krm_0380_11"><a href="#foot_krm_0380_11">11</a></sup> प्रगाद्यम्, गाद्यम्, जिगदिष्यम्, जागद्यम्;</li> <li>  ईषद्गदः-दुर्गदः-सुगदः;</li> <li>  -- -- -- गद्यमानः, गाद्यमानः, जिगदिष्यमाणः, जागद्यमानः;</li> <li>  <sup id="ref_krm_0380_12"><a href="#foot_krm_0380_12">12</a></sup> गदः, <sup id="ref_krm_0380_13"><a href="#foot_krm_0380_13">13</a></sup> गादः, <sup id="ref_krm_0380_14"><a href="#foot_krm_0380_14">14</a></sup> गद्गदः, <sup id="ref_krm_0380_15"><a href="#foot_krm_0380_15">15</a></sup> निगदः <sup id="ref_krm_0380_16"><a href="#foot_krm_0380_16">16</a></sup>, निगादः, गादः, जिगदिषः, जागदः;</li> <li>  गदितुम्, गादयितुम्, जिगदिषितुम्, जागदितुम्;</li> <li>  <sup id="ref_krm_0380_17"><a href="#foot_krm_0380_17">17</a></sup> गदा, गादना, जिगदिषा, जागदा;</li> <li>  गदनम्, गादनम्, जिगदिषणम्, जागदनम्;</li> <li>  गदित्वा, गादयित्वा, जिगदिषित्वा, जागदित्वा;</li> <li>  प्रणिगद्य, प्रणिगाद्य, प्रजिगदिष्य, प्रजागद्य;</li> <li>  गादम् २, गदित्वा २, गादम् २, गादयित्वा २, जिगदिषम् २, जिगदिषित्वा २, जागदम् २;</li> <li>  जागदित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0380_01"><a href="#ref_krm_0380_01">↑</a> (३७२)</li> <li id="foot_krm_0380_02"><a href="#ref_krm_0380_02">↑</a> (१-भ्वादिः-५२। सक। सेट्। पर।)</li> <li id="foot_krm_0380_03"><a href="#ref_krm_0380_03">↑</a> (श्लो। ११०)</li> <li id="foot_krm_0380_04"><a href="#ref_krm_0380_04">↑</a> [[२। ‘प्रतिषेधे हसादीनाम्--’ (वा। १-३-१५) इत्यत्रास्य धातोः ग्रहणान्न कर्मव्यतीहारे तङ्।]]</li> <li id="foot_krm_0380_05"><a href="#ref_krm_0380_05">↑</a> [[C। ‘पलान्यखाद्यानि खदन् बदद्वपुः गदन् अवाच्यानि रदन् सतां मनः। नदन् मदादर्दितसङ्क्षयोऽधुना क्षणं खलो नर्दतु गर्दभस्वरैः।।’ धा। का। १-८।]]</li> <li id="foot_krm_0380_06"><a href="#ref_krm_0380_06">↑</a> [[३। ‘नेर्गदनद--’ (८-४-१७) इत्यादिना णत्वम्।]]</li> <li id="foot_krm_0380_07"><a href="#ref_krm_0380_07">↑</a> [[ड्। ‘इति निगदितवन्तं राघवस्तं जगाद व्रज भरत गृहीत्वा पादुके त्वं मदीये। च्युतनिखिलविशङ्कः पूज्यमानो जनौघैः सकलभुवनराज्यं कारयास्मन्मतेन।।’ भ। का। ३-५६।]]</li> <li id="foot_krm_0380_08"><a href="#ref_krm_0380_08">↑</a> [[४। अनुगदतीत्यनुगादी। ‘अनुगादिनष्ठक्’ (५-४-१३) इति स्वार्थे ठक्।]]</li> <li id="foot_krm_0380_09"><a href="#ref_krm_0380_09">↑</a> [पृष्ठम्०३६७+ २५]</li> <li id="foot_krm_0380_10"><a href="#ref_krm_0380_10">↑</a> [[१। ‘गदमदचरयमश्चानुपसर्गे’ -- (३-१-१००) इति यत्। सोपसर्गात् तु ण्यदेव। निगाद्यमिति यथा।]]</li> <li id="foot_krm_0380_11"><a href="#ref_krm_0380_11">↑</a> [[आ। ‘लभ्या कथं नु वैदेही शक्यो द्रष्टुं कथं रिपुः। सत्यः कथं वियोगश्च गद्यमेतत् त्वया मम।।’ भ। का। ६-४७।]]</li> <li id="foot_krm_0380_12"><a href="#ref_krm_0380_12">↑</a> [[२। ‘पुंसि संज्ञायां घः’ (३-३-११८) इति रोगार्थे घः।]]</li> <li id="foot_krm_0380_13"><a href="#ref_krm_0380_13">↑</a> [[३। ‘हलश्च’ (३-३-१२१) इति घञ्।]]</li> <li id="foot_krm_0380_14"><a href="#ref_krm_0380_14">↑</a> [[४। ‘पृषोदरादीनि--’ (६-३-१०९) इत्यत्र पाठात् गद्गद इति सिद्धिरिति क्षीरतर- ङ्गिणी। अस्पष्टाक्षरं यथा तथोच्चार्यमाण शब्दः गद्गद इत्युच्यते।]]</li> <li id="foot_krm_0380_15"><a href="#ref_krm_0380_15">↑</a> [[५। ‘नौ गदनद--’ (३-३-६४) इत्यप्।]]</li> <li id="foot_krm_0380_16"><a href="#ref_krm_0380_16">↑</a> [[B। ‘संचेरुः सहसाः केचिदस्वनाः केचिदाटिषुः। संयामवन्तो यतिवत् निगदानपरेऽमुचन्।।’ भ। का। ७-५७।]]</li> <li id="foot_krm_0380_17"><a href="#ref_krm_0380_17">↑</a> [[६। ‘षिद्भिदादिभ्यः--’ (३-३-१०४) इत्यत्र पाठात् अङ्।]]</li></ul></p>

गद
<ul><li><sup id="ref_krm_0381_01"><a href="#foot_krm_0381_01">1</a></sup> {@“गद देवशब्दे”@} <sup id="ref_krm_0381_02"><a href="#foot_krm_0381_02">2</a></sup> अदन्तः। </li> <li>देवशब्दः = पर्जन्यध्वनिः। </li> <li>‘स्तन-गदी देवशब्दे’ इति धातुपाठे दृश्यते। </li> <li>द्विवचननिर्देशोऽयं वैचित्र्यार्थः, इत्याहुः। </li> <li>अदन्तोऽयम्। </li> <li>‘स्तन गद--’ इत्येव चान्द्राः पठन्ति। </li> <li><sup id="ref_krm_0381_03"><a href="#foot_krm_0381_03">3</a></sup> ‘णौ देवशब्दे गदयेत्, व्यक्तवाचि गदेच्छपि’ इति देवः <sup id="ref_krm_0381_04"><a href="#foot_krm_0381_04">4</a></sup>। </li> <li>केचित्तु ‘गदी--’ इति, ईदितं धातुं पठन्ति। </li> <li>शाकटायनोऽप्येवमेव-- इत्यादिकं सर्वं पुरुषकारादिषु द्रष्टव्यम्। </li> <li><sup id="ref_krm_0381_05"><a href="#foot_krm_0381_05">5</a></sup> गदनम्--ल्युट्। </li> <li>‘गण सङ्ख्याने’ <sup id="ref_krm_0381_06"><a href="#foot_krm_0381_06">6</a></sup> इति चौरादिकधातुवत् सर्वाणि रूपाणि ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0381_01"><a href="#ref_krm_0381_01">↑</a> (३७३)</li> <li id="foot_krm_0381_02"><a href="#ref_krm_0381_02">↑</a> (१०-चुरादिः-१८६१। अक। सेट्। उभ।)</li> <li id="foot_krm_0381_03"><a href="#ref_krm_0381_03">↑</a> [पृष्ठम्०३६८+ २७]</li> <li id="foot_krm_0381_04"><a href="#ref_krm_0381_04">↑</a> (११०। श्लोकः)</li> <li id="foot_krm_0381_05"><a href="#ref_krm_0381_05">↑</a> [[आ। ‘क्रुद्धेनाकथि चाप्यवर्यगणने शठ्येन भोः श्वठ्यतां मन्त्री तौ प्रपटय्य पाशवटनैः पापौ विरह्यौ पुरात्। के मूढाः स्तनयित्नुनिर्गदनवत् तूर्यध्वनिं कुर्वते मल्लौघोऽपतयद्रिपुर्न तु पतांचक्रे स पातोचितः।।’ धा। का। ३-५३।]]</li> <li id="foot_krm_0381_06"><a href="#ref_krm_0381_06">↑</a> (३७१)</li></ul></p>

गदि|गन्दकः-न्दिका|जिगन्दिषकः-षिका|जागन्दकः-न्दिका
<ul><li><sup id="ref_krm_0382_01"><a href="#foot_krm_0382_01">1</a></sup> {@“गदि वदनैकदेशे”@} <sup id="ref_krm_0382_02"><a href="#foot_krm_0382_02">2</a></sup> गन्दकः-न्दिका, गन्दकः-न्दिका, जिगन्दिषकः-षिका, जागन्दकः-न्दिका;</li> <li>  इत्यादीनि कदिवत् <sup id="ref_krm_0382_03"><a href="#foot_krm_0382_03">3</a></sup> सर्वाण्यपि रूपाणि ऊह्यानि। </li> <li>‘गडि--’ इत्यस्य पाठान्तरमिदमित्यन्ये।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0382_01"><a href="#ref_krm_0382_01">↑</a> (३७४)</li> <li id="foot_krm_0382_02"><a href="#ref_krm_0382_02">↑</a> (१-भ्वादिः-६५। अक। सेट्। पर।)</li> <li id="foot_krm_0382_03"><a href="#ref_krm_0382_03">↑</a> (१६३)</li></ul></p>

