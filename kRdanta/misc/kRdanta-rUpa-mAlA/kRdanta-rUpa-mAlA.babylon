<ul><li><sup id="ref_krm_0297_01"><a href="#foot_krm_0297_01">1</a></sup> {@“क्लुङ् गतौ”@} <sup id="ref_krm_0297_02"><a href="#foot_krm_0297_02">2</a></sup> पाठान्तरोऽयं प्लवतेः। </li> <li>क्लावकः-विका, क्लावकः-विका, <sup id="ref_krm_0297_03"><a href="#foot_krm_0297_03">3</a></sup> चुक्लूषकः-षिका, <sup id="ref_krm_0297_04"><a href="#foot_krm_0297_04">4</a></sup> चोक्लूयकः-यिका;</li> <li>  <sup id="ref_krm_0297_05"><a href="#foot_krm_0297_05">5</a></sup> क्लोता-त्री, क्लावयिता-त्री, चुक्लूषिता-त्री, चोक्लूयिता-त्री;</li> <li>  -- क्लावयन्-न्ती, क्लावयिष्यन्-न्ती-ती;</li> <li>  -- -- क्लवमानः, क्लावयमानः, चुक्लूषमाणः, चोक्लूयमानः;</li> <li>  क्लोष्यमाणः, क्लावयिष्यमाणः, चुक्लूषिष्यमाणः, चोक्लूयिष्यमाणः;</li> <li>  <sup id="ref_krm_0297_06"><a href="#foot_krm_0297_06">6</a></sup> सङ्क्लुत्-सङ्क्लुतौ-सङ्क्लुतः;</li> <li>  -- -- क्लुतम्-तः-तवान्, क्लावितः-तम्, चुक्लूषितः, चोक्लूयितः-तवान्;</li> <li>  क्लवः, <sup id="ref_krm_0297_07"><a href="#foot_krm_0297_07">7</a></sup> क्लवनः, क्लावः, चुक्लूषुः, <sup id="ref_krm_0297_08"><a href="#foot_krm_0297_08">8</a></sup> चोक्लुवः;</li> <li>  क्लोतव्यम्, क्लावयितव्यम्, चुक्लूषितव्यम्, चोक्लूयितव्यम्;</li> <li>  क्लवनीयम्, क्लावनीयम्, चुक्लूषणीयम्, चोक्लूयनीयम्;</li> <li>  <sup id="ref_krm_0297_09"><a href="#foot_krm_0297_09">9</a></sup> क्लव्यम्, <sup id="ref_krm_0297_10"><a href="#foot_krm_0297_10">10</a></sup> अवश्यक्लाव्यम्, क्लाव्यम्, चुक्लूष्यम्, चोक्लूय्यम्;</li> <li>  ईषत्क्लवः, -दुष्क्लवः, -सुक्लवः;</li> <li>  -- -- <sup id="ref_krm_0297_11"><a href="#foot_krm_0297_11">11</a></sup> क्लूयमानः, क्लाव्यमानः, चुक्लूष्यमाणः, चोक्लूय्यमानः;</li> <li>  <sup id="ref_krm_0297_12"><a href="#foot_krm_0297_12">12</a></sup> क्लवः, विक्लवः- <sup id="ref_krm_0297_13"><a href="#foot_krm_0297_13">13</a></sup> विक्लबः, क्लावः, चुक्लूषः, चोक्लूयः;</li> <li>  क्लोतुम्, क्लावयितुम्, चुक्लूषितुम्, चोक्लूयितुम्;</li> <li>  क्लुतिः, क्लावना, चुक्लूषा, चोक्लूया;</li> <li>  क्लवनम्, क्लावनम्, चुक्लूषणम्, चोक्लूयनम्;</li> <li>  क्लुत्वा, क्लावयित्वा, चुक्लूषित्वा, चोक्लूयित्वा;</li> <li>  <sup id="ref_krm_0297_14"><a href="#foot_krm_0297_14">14</a></sup> सङ्क्लुत्य, सङ्क्लाव्य, प्रचुक्लूष्य, सञ्चोक्लूय्य;</li> <li>  क्लावम् २, क्लूत्वा २, क्लावम् २, क्लावयित्वा २, चुक्लूषम् २, चुक्लूषित्वा २, चोक्लूयम् २;</li> <li>  चोक्लूयित्वा २। <sup id="ref_krm_0297_15"><a href="#foot_krm_0297_15">15</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0297_01"><a href="#ref_krm_0297_01">↑</a> (२९०)</li> <li id="foot_krm_0297_02"><a href="#ref_krm_0297_02">↑</a> (१-भ्वादिः-९५८। सक। अनि। आत्म।)</li> <li id="foot_krm_0297_03"><a href="#ref_krm_0297_03">↑</a> [[६। ‘इको झल्’ (१-२-९) इति सनः कित्त्वान्न गुणः। ‘अज्झनगमां सनि’ (६-४-१६) इति दीर्घः।]]</li> <li id="foot_krm_0297_04"><a href="#ref_krm_0297_04">↑</a> [[७। ‘अकृत्सार्वधातुकयोः--’ (७-४-२५) इति दीर्घः।]]</li> <li id="foot_krm_0297_05"><a href="#ref_krm_0297_05">↑</a> [पृष्ठम्०३०२+ २३]</li> <li id="foot_krm_0297_06"><a href="#ref_krm_0297_06">↑</a> [[१। क्विपि, ‘ह्रस्वस्य पिति कृति--’ (६-१-७१) इति तुक्।]]</li> <li id="foot_krm_0297_07"><a href="#ref_krm_0297_07">↑</a> [[२। ‘चलनशब्दार्थादकर्मकात्--’ (३-२-१४८) इति युच्।]]</li> <li id="foot_krm_0297_08"><a href="#ref_krm_0297_08">↑</a> [[३। यङन्तादचि ‘यङोऽचि च’ (२-४-७४) इति यङो लुकि, उवङ्।]]</li> <li id="foot_krm_0297_09"><a href="#ref_krm_0297_09">↑</a> [[४। ‘अचो यत्’ (३-१-९७) इति यत्।]]</li> <li id="foot_krm_0297_10"><a href="#ref_krm_0297_10">↑</a> [[५। ‘ओरावश्यके’ (३-१-१२५) इति ण्यत्।]]</li> <li id="foot_krm_0297_11"><a href="#ref_krm_0297_11">↑</a> [[६। ‘अकृत्सार्वधातुकयोः’ (७-४-२५) इति दीर्घः।]]</li> <li id="foot_krm_0297_12"><a href="#ref_krm_0297_12">↑</a> [[७। ‘ॠदोरप्’ (३-३-५७) इत्यप् भावे।]]</li> <li id="foot_krm_0297_13"><a href="#ref_krm_0297_13">↑</a> [[आ। वबयोरभेदात् ‘विक्लब’ इत्यपि अस्मादेव भवति--इति मैत्रेयः।]]</li> <li id="foot_krm_0297_14"><a href="#ref_krm_0297_14">↑</a> [[८। ‘ह्रस्वस्य पिति कृति तुक्’ (६-१-७१) इति तुक् ल्यपि।]]</li> <li id="foot_krm_0297_15"><a href="#ref_krm_0297_15">↑</a> [पृष्ठम्०३०३+ २४]</li></ul></p>

