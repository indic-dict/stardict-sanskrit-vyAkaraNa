<ul><li><sup id="ref_krm_0677_01"><a href="#foot_krm_0677_01">1</a></sup> {@“णश अदर्शने”@} <sup id="ref_krm_0677_02"><a href="#foot_krm_0677_02">2</a></sup> रधादिः। </li> <li>नाशकः-शिका, नाशकः-शिका, <sup id="ref_krm_0677_03"><a href="#foot_krm_0677_03">3</a></sup> निनशिषकः-षिका- <sup id="ref_krm_0677_04"><a href="#foot_krm_0677_04">4</a></sup> निनङ्क्षकः-क्षिका, नानशकः-शिका;</li> <li>  <sup id="ref_krm_0677_05"><a href="#foot_krm_0677_05">5</a></sup> नशिता-त्री-प्रनंष्टा-ष्ट्री, नाशयिता-त्री, निनशिषिता-त्री-निनङ्क्षिता-त्री, नानशिता-त्री;</li> <li>  नश्यन्- <sup id="ref_krm_0677_06"><a href="#foot_krm_0677_06">6</a></sup> प्रणश्यन्-न्ती, नाशयन् <sup id="ref_krm_0677_07"><a href="#foot_krm_0677_07">7</a></sup> -न्ती, निनशिषन्-निनङ्क्षन्-न्ती;</li> <li>  -- नशिष्यन्- <sup id="ref_krm_0677_08"><a href="#foot_krm_0677_08">8</a></sup> प्रनङ्क्ष्यन्-न्ती-ती, नाशयिष्यन्-न्ती-ती, निनशिषिष्यन्, निनङ्क्षिष्यन्-न्ती-ती;</li> <li>  -- -- -- -- नानश्यमानः, नानशिष्यमाणः;</li> <li>  <sup id="ref_krm_0677_09"><a href="#foot_krm_0677_09">9</a></sup> प्रनट्-प्रनक्-प्रणशौ-प्रणशः;</li> <li>  -- -- -- <sup id="ref_krm_0677_10"><a href="#foot_krm_0677_10">10</a></sup> <sup id="ref_krm_0677_11"><a href="#foot_krm_0677_11">11</a></sup> प्रनष्टम्- <sup id="ref_krm_0677_12"><a href="#foot_krm_0677_12">12</a></sup> प्रनष्टः-नष्टवान्, प्रणाशितः, निनशिषितः, निनङ्क्षितः-नानशितः, तवान्;</li> <li>  नशः, <sup id="ref_krm_0677_13"><a href="#foot_krm_0677_13">13</a></sup> विनाशी, <sup id="ref_krm_0677_14"><a href="#foot_krm_0677_14">14</a></sup> कृतनाशी, <sup id="ref_krm_0677_15"><a href="#foot_krm_0677_15">15</a></sup> विनाशकः, <sup id="ref_krm_0677_16"><a href="#foot_krm_0677_16">16</a></sup> नश्वरः <sup id="ref_krm_0677_17"><a href="#foot_krm_0677_17">17</a></sup> -नश्वरी, नाशः, <sup id="ref_krm_0677_18"><a href="#foot_krm_0677_18">18</a></sup> चितविनाशनः-वित्तनाशनः-निनङ्क्षुः, नानशः;</li> <li>  नशितव्यम्-नंष्टव्यम्, नाशयितव्यम्, निनशिषितव्यम्-निनङ्क्षितव्यम्, नानशितव्यम्;</li> <li>  नशनीयम्, नाशनीयम्, निनशिषणीयम्, निनङ्क्षणीयम्, नानशनीयम्;</li> <li>  नाश्यम्, नाश्यम्, निनशिष्यम्-निनङ्क्ष्यम्, नानश्यम्;</li> <li>  ईषन्नशः-दुर्नशः-सुनशः, <sup id="ref_krm_0677_19"><a href="#foot_krm_0677_19">19</a></sup> दूणाशः;</li> <li>  -- -- नश्यमानः, नाश्यमानः, निनशिष्यमाणः-निनङ्क्ष्यमाणः, नानश्यमानः;</li> <li>  नाशः, नाशः, निनशिषः-निनङ्क्षः, नानशः;</li> <li>  नशितुम्-नंष्टुम्, नाशयितुम्, निनशिषितुम्-निनङ्क्षितुम्, नानशितुम्;</li> <li>  नष्टिः <sup id="ref_krm_0677_20"><a href="#foot_krm_0677_20">20</a></sup> जीवनक्, नाशना, निनशिषा-निनङ्क्षा, नानशा;</li> <li>  <sup id="ref_krm_0677_21"><a href="#foot_krm_0677_21">21</a></sup> नशनम्, नाशनम्, निनशिषणम्-निनङ्क्षणम्, नानशनम्;</li> <li>  नशित्वा-नंष्ट्वा- <sup id="ref_krm_0677_22"><a href="#foot_krm_0677_22">22</a></sup>] नष्ट्वा, नाशयित्वा, निनशिषित्वा, निनङ्क्षित्वा, नानशित्वा;</li> <li>  प्रणश्य, प्रणाश्य, प्रणिनशिष्य-प्रणिनङ्क्ष्य, प्रणानश्य;</li> <li>  <sup id="ref_krm_0677_23"><a href="#foot_krm_0677_23">23</a></sup> अजकनाशं <sup id="ref_krm_0677_24"><a href="#foot_krm_0677_24">24</a></sup>, विद्युत्प्रणाशं <sup id="ref_krm_0677_25"><a href="#foot_krm_0677_25">25</a></sup>, <sup id="ref_krm_0677_26"><a href="#foot_krm_0677_26">26</a></sup> जीवनाशं <sup id="ref_krm_0677_27"><a href="#foot_krm_0677_27">27</a></sup> <sup id="ref_krm_0677_28"><a href="#foot_krm_0677_28">28</a></sup>, नाशम् २, नशित्वा-नंष्ट्वा-नष्ट्वा-२, नाशम् २, नाशयित्वा २, निनशिषम् २-निनशिषम् २-निन्ङ्क्षम् २, निनशिषित्वा २-निनङ्क्षित्वा २, नानशम् २;</li> <li>  नानशित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0677_01"><a href="#ref_krm_0677_01">↑</a> (६६७)</li> <li id="foot_krm_0677_02"><a href="#ref_krm_0677_02">↑</a> (४-दिवादिः-११९४। अक। सेट्। पर।)</li> <li id="foot_krm_0677_03"><a href="#ref_krm_0677_03">↑</a> [[४। ‘रधादिभ्यश्च’ (७-२-४५) इति वलादेरार्धधातुकस्येटो वैकल्पिकत्वात् इट्पक्षे रूपम्। एवम् इट्पक्षे सन्नन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0677_04"><a href="#ref_krm_0677_04">↑</a> [[५। इडभावपक्षे, ‘मस्जिनशोर्झलि’ (७-१-६०) इति नुमागमे, ‘व्रश्च--’ (८-२-३६) इत्यादिना शकारस्य षत्वे, ‘षढोः कः सि’ (८-२-४१) इति कत्वे, ‘नश्चा- पदान्तस्य झलि’ (८-३-२४।) इत्यनुस्वारे, ‘इण्कोः’ (८-३-५७) इति सनः सकारस्य षत्वे, ‘अनुस्वारस्य ययि--’ (८-४-५८) इति परसवर्णे च रूपम्। एवम् इडभावपक्षे सन्नन्ते प्रक्रिया सर्वत्र बोध्या।]]</li> <li id="foot_krm_0677_05"><a href="#ref_krm_0677_05">↑</a> [[६। रधादित्वादिड्विकल्पः। इडभावपक्षे, ‘नशेः षान्तस्य’ (८-४-३६) इति णत्व- निषेधः। एवं तव्यदादिष्वपि ज्ञेयम्।]]</li> <li id="foot_krm_0677_06"><a href="#ref_krm_0677_06">↑</a> [[आ। ‘प्रणश्यन्नपि नाशक्नोदत्येतुं बाणगोचरम्।’ भ। का। ९। १३४।]]</li> <li id="foot_krm_0677_07"><a href="#ref_krm_0677_07">↑</a> [[७। ‘बुधयुधनशजनेङ्प्रुद्रुस्रुभ्यो णेः’ (१-३-८६) इति ण्यन्तात् शतृप्रत्यय एव भवति। न त्वात्मनेपदं शानच्।]]</li> <li id="foot_krm_0677_08"><a href="#ref_krm_0677_08">↑</a> [[८। ‘नशेः षान्तस्य’ (८-४-३६) इत्यत्र अन्तग्रहणसामर्थ्यात् भूतपूर्वषकारान्तस्यापि प्रहणमिति, णत्वमत्रापि न।]]</li> <li id="foot_krm_0677_09"><a href="#ref_krm_0677_09">↑</a> [[९। क्विपि, ‘व्रश्च--’ (८-२-३६) इति षत्वे, ‘नशेर्वा’ (८-२-६३) इति कुत्वविकल्पः। भूतपूर्वगत्या षकारान्तत्वात् णत्वं न।]]</li> <li id="foot_krm_0677_10"><a href="#ref_krm_0677_10">↑</a> [पृष्ठम्०६२०+ २७]</li> <li id="foot_krm_0677_11"><a href="#ref_krm_0677_11">↑</a> [[१। वलादेरार्धधातुकस्य ‘रधादिभ्यश्च’ (७-२-४५) इतीड्विकल्पनात् निष्ठायाम्, ‘यस्य विभाषा’ (७-२-१५) इतीण्णिषेधः।]]</li> <li id="foot_krm_0677_12"><a href="#ref_krm_0677_12">↑</a> [[आ। ‘विद्युत्प्रणाशं स वरं प्रनष्टो यद्वोर्ध्वशोषं तृणवद्विशुष्कः।’ भ। का। ३। १४।]]</li> <li id="foot_krm_0677_13"><a href="#ref_krm_0677_13">↑</a> [[२। ‘सुप्यजातौ--’ (३-२-७८) इति ताच्छील्ये णिनिः।]]</li> <li id="foot_krm_0677_14"><a href="#ref_krm_0677_14">↑</a> [[B। ‘कुर्मश्च जीविते बुद्धिं धिक् तृष्णां कृतनाशिनाम्।।’ भ। का। १८। ३२। (मल्लिनाथसम्मतपाठानुसारेण णिनिप्रत्ययान्ततया लिखितम्।)]]</li> <li id="foot_krm_0677_15"><a href="#ref_krm_0677_15">↑</a> [[३। ‘निन्दहिंसक्लिशखादविनाश--’ (३-२-१४६) इत्यादिना तच्छीलतद्धर्मतत्साधु- कारिषु वुञ्। अकादेशः।]]</li> <li id="foot_krm_0677_16"><a href="#ref_krm_0677_16">↑</a> [[४। ‘इण्नशिजि--’ (३-२-१६३) इति तच्छीलादिषु कर्तृषु क्वरप्। स्त्रियां ‘टिड्ढा--’ (४-१-१५) इति ङीप्।]]</li> <li id="foot_krm_0677_17"><a href="#ref_krm_0677_17">↑</a> [[C। ‘रद्धारये सोऽयमनश्वराय तृप्यन्मना दृप्तजनद्रुहेऽस्मै।’ धा। का। २। ६४।]]</li> <li id="foot_krm_0677_18"><a href="#ref_krm_0677_18">↑</a> [[५। चित्तं विनाशयतीति, वित्तं नाशयतीति च चित्तविनाशनः, वित्तनाशनः। नन्द्यादित्वात् (३-१-१३४) ण्यन्तात् कर्तरि ल्युः। कर्मण्यणोऽपवादः।]]</li> <li id="foot_krm_0677_19"><a href="#ref_krm_0677_19">↑</a> [[६। दुःखेन नाशयितव्यः = दूणाशः। ‘ईषत्--’ (३-३-१२६) इत्यादिना ण्यन्तात् खल्। ‘दुरो दाशनाशदभध्येषु उत्त्वम्, उत्तरपदादेः ष्टुत्वं च’ (वा। ६-३-१०९) इति वचनेन उपसर्गान्त्यस्योत्वम्, सवर्णदीर्घः, उत्तरपदादेः ष्टुत्वं च।]]</li> <li id="foot_krm_0677_20"><a href="#ref_krm_0677_20">↑</a> [[७। जीवो नश्यतीति, जीवं नाशयति, इति वा जीवनक् = आहुतिविशेषः। बाहुलकादत्र स्त्रियाम् अर्थविशेषे क्विप उपपत्तिः।]]</li> <li id="foot_krm_0677_21"><a href="#ref_krm_0677_21">↑</a> [पृष्ठम्०६२१+ २६]</li> <li id="foot_krm_0677_22"><a href="#ref_krm_0677_22">↑</a> [[१। ‘रधादिभ्यश्च’ (७-२-४५) इतीड्विकल्पः। इट्पक्षे नशित्वा इति रूपम्। इडभावपक्षे ‘मस्जिनशोर्झलि’ (७-१-६०) इति नुमि, नंष्ट्वा इति रूपम्। ‘जान्तनशां विभाषा’ (६-४-३२) इति क्त्वायां नकारस्य विकल्पेन लोपे नष्ट्वा इति रूपम्।]]</li> <li id="foot_krm_0677_23"><a href="#ref_krm_0677_23">↑</a> [[२। ‘उपमाने कर्मणि च’ (३-४-४५) इति णमुल्। ‘कषादिषु यथाविध्यनुप्रयोगः’ (३-४-४६) इति णमुलन्तस्य धातोः अनुप्रयोगः। अजकश्व नष्ट इत्यर्थः। विद्युत्प्रणाशं नष्टः इत्यत्राप्येवमेव।]]</li> <li id="foot_krm_0677_24"><a href="#ref_krm_0677_24">↑</a> [नष्टः]</li> <li id="foot_krm_0677_25"><a href="#ref_krm_0677_25">↑</a> [नष्टः]</li> <li id="foot_krm_0677_26"><a href="#ref_krm_0677_26">↑</a> [[३। ‘कर्त्रोर्जीवपुरुषयोर्नशिवहोः’ (३-४-४३) इति णमुल्। ‘कषादिषु--’ (३-४-४६) इति अनुप्रयोगः। जीवो नश्यतीत्यर्थः।]]</li> <li id="foot_krm_0677_27"><a href="#ref_krm_0677_27">↑</a> [[आ। ‘चकम्पेऽतीव चुक्रोश जीवनाशं ननाश च।।’ भ। का। १४। ३१।]]</li> <li id="foot_krm_0677_28"><a href="#ref_krm_0677_28">↑</a> [नष्टः]</li></ul></p>

णस|नासकः-सिका|निनसिषकः-षिका|नानसकः-सिका
<ul><li><sup id="ref_krm_0678_01"><a href="#foot_krm_0678_01">1</a></sup> {@“णस कौटिल्ये”@} <sup id="ref_krm_0678_02"><a href="#foot_krm_0678_02">2</a></sup> ‘शब्दार्थे नासते नासेः, कौटिल्ये नसते नसेः।।’ <sup id="ref_krm_0678_03"><a href="#foot_krm_0678_03">3</a></sup> इति देवः। </li> <li>नासकः-सिका, नासकः-सिका, निनसिषकः-षिका, नानसकः-सिका;</li> <li>  <sup id="ref_krm_0678_04"><a href="#foot_krm_0678_04">4</a></sup> विनः-विनसौ-विनसः, <sup id="ref_krm_0678_05"><a href="#foot_krm_0678_05">5</a></sup> नसितः, इत्यादीनि सर्वाण्यपि रूपाणि भौवादिक- णभतिवत् <sup id="ref_krm_0678_06"><a href="#foot_krm_0678_06">6</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0678_01"><a href="#ref_krm_0678_01">↑</a> (६६८)</li> <li id="foot_krm_0678_02"><a href="#ref_krm_0678_02">↑</a> (१-भ्वादिः-६२७। अक। सेट्। आत्म।)</li> <li id="foot_krm_0678_03"><a href="#ref_krm_0678_03">↑</a> (श्लो। १८४)</li> <li id="foot_krm_0678_04"><a href="#ref_krm_0678_04">↑</a> [[४। क्विपि सोः रुत्वविसर्गयोः रूपम्। ‘अत्वसन्तस्य चाधातोः’ (६-४-१४) इत्यत्र ‘अधातोः’ इत्युक्तत्वात् न दीर्घः।]]</li> <li id="foot_krm_0678_05"><a href="#ref_krm_0678_05">↑</a> [[B। ‘नासोत्थरासलसितान् नसितेन दाम्ना सूतो ययाम समराभ्यसितांस्तुरङ्गान्।।’ धा। का। १। ७९।]]</li> <li id="foot_krm_0678_06"><a href="#ref_krm_0678_06">↑</a> (६६१)</li></ul></p>

