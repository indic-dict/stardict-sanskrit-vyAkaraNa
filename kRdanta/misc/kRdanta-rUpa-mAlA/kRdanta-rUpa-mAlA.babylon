<ul><li><sup id="ref_krm_1558_01"><a href="#foot_krm_1558_01">1</a></sup> {@“वद व्यक्तायां वाचि”@} <sup id="ref_krm_1558_02"><a href="#foot_krm_1558_02">2</a></sup> यजादिः। </li> <li>‘व्यक्तवाचि वदेद्वा णौ वादयेद् वदते वदेत्।’ <sup id="ref_krm_1558_03"><a href="#foot_krm_1558_03">3</a></sup> इति देवः। </li> <li>वादकः-दिका, वादकः-परिवादकः-दिका, विवदिषकः-षिका, वावदकः-दिका;</li> <li>  वदिता-त्री, वादयिता-त्री, विवदिषिता-त्री, वावदिता-त्री;</li> <li>  वदन्-न्ती, <sup id="ref_krm_1558_04"><a href="#foot_krm_1558_04">4</a></sup> <sup id="ref_krm_1558_05"><a href="#foot_krm_1558_05">5</a></sup> वादयन्-न्ती, विवदिषन्-न्ती;</li> <li>  -- वदिष्यन्-न्ती-ती, वादयिष्यन्-न्ती-ती, विवदिषिष्यन्-न्ती-ती;</li> <li>  -- <sup id="ref_krm_1558_06"><a href="#foot_krm_1558_06">6</a></sup> शास्त्रे <sup id="ref_krm_1558_07"><a href="#foot_krm_1558_07">7</a></sup> वदमानः, <sup id="ref_krm_1558_08"><a href="#foot_krm_1558_08">8</a></sup> कर्मकरान् उपवदमानः, <sup id="ref_krm_1558_09"><a href="#foot_krm_1558_09">9</a></sup> न्यायम् अपवदमानः, क्षेत्रे विवद- मानः, <sup id="ref_krm_1558_10"><a href="#foot_krm_1558_10">10</a></sup> विप्रवदन्तः-विप्रवदमाना वा मौहूर्तिकाः वैद्याः वा, कुलभार्यामुपवदमानः, <sup id="ref_krm_1558_11"><a href="#foot_krm_1558_11">11</a></sup> अनुवदमानः कठः कालापस्य, <sup id="ref_krm_1558_12"><a href="#foot_krm_1558_12">12</a></sup> सम्प्रवदमानः, गेहे विवदमानः, वादयमानः, <sup id="ref_krm_1558_13"><a href="#foot_krm_1558_13">13</a></sup> अभिवादयमानो गुरुं देवदत्तं देवदत्तेन वा, <sup id="ref_krm_1558_14"><a href="#foot_krm_1558_14">14</a></sup> वादयमानो वीणाम्, विप्रविवदिषमाणः, वावद्यमानः;</li> <li>  शास्त्रे वदिष्यमाणः, वादयिष्यमाणः, विवदिषिष्यमाणः, वावदिष्यमाणः;</li> <li>  <sup id="ref_krm_1558_15"><a href="#foot_krm_1558_15">15</a></sup> उदितम्- <sup id="ref_krm_1558_16"><a href="#foot_krm_1558_16">16</a></sup> तः-तवान्, वादितः, विवदिषितः, वावदितः-तवान्;</li> <li>  मधुरोद्-मधुरोदौ-मधुरोदः;</li> <li>  -- -- -- <sup id="ref_krm_1558_17"><a href="#foot_krm_1558_17">17</a></sup> वदः, <sup id="ref_krm_1558_18"><a href="#foot_krm_1558_18">18</a></sup> अवादी, <sup id="ref_krm_1558_19"><a href="#foot_krm_1558_19">19</a></sup> वदावदः, <sup id="ref_krm_1558_20"><a href="#foot_krm_1558_20">20</a></sup> वावदूकः, प्रवावदूकः, <sup id="ref_krm_1558_21"><a href="#foot_krm_1558_21">21</a></sup> कद्वदः <sup id="ref_krm_1558_22"><a href="#foot_krm_1558_22">22</a></sup>, <sup id="ref_krm_1558_23"><a href="#foot_krm_1558_23">23</a></sup> साधुवादी, <sup id="ref_krm_1558_24"><a href="#foot_krm_1558_24">24</a></sup> परिवादिनी, <sup id="ref_krm_1558_25"><a href="#foot_krm_1558_25">25</a></sup> प्रियंवदः-प्रियंवदा <sup id="ref_krm_1558_26"><a href="#foot_krm_1558_26">26</a></sup>, वशंवदः <sup id="ref_krm_1558_27"><a href="#foot_krm_1558_27">27</a></sup>, <sup id="ref_krm_1558_28"><a href="#foot_krm_1558_28">28</a></sup> प्रवादी, <sup id="ref_krm_1558_29"><a href="#foot_krm_1558_29">29</a></sup> ब्रह्मवादी, <sup id="ref_krm_1558_30"><a href="#foot_krm_1558_30">30</a></sup> परि- वादकः, वादः, विवदिषुः, वावदः;</li> <li>  वदितव्यम्, वादयितव्यम्, विवदिषितव्यम्, वावदितव्यम्;</li> <li>  वदनीयम्, वादनीयम्, विवदिषणीयम्, वावदनीयम्;</li> <li>  <sup id="ref_krm_1558_31"><a href="#foot_krm_1558_31">31</a></sup> अवद्यम्, <sup id="ref_krm_1558_32"><a href="#foot_krm_1558_32">32</a></sup> ब्रह्मोद्यम्-ब्रह्मवद्यम्, <sup id="ref_krm_1558_33"><a href="#foot_krm_1558_33">33</a></sup> मृषोद्यम्, सत्यवद्यः <sup id="ref_krm_1558_34"><a href="#foot_krm_1558_34">34</a></sup>, अनृतोद्यम्, <sup id="ref_krm_1558_35"><a href="#foot_krm_1558_35">35</a></sup> <sup id="ref_krm_1558_36"><a href="#foot_krm_1558_36">36</a></sup> वाद्यम्-प्रवाद्यम्, वाद्यम्, विवदिष्यम्, वावद्यम्;</li> <li>  उद्यमानः, वाद्यमानः, विवदिष्यमाणः, वावद्यमानः;</li> <li>  ईषद्वदः-दुर्वदः-सुवदः;</li> <li>  -- -- -- वादः, वादः, विवदिषः, वावदः;</li> <li>  वदितुम्, वादयितुम्, विवदिषितुम्, वावदितुम्;</li> <li>  <sup id="ref_krm_1558_37"><a href="#foot_krm_1558_37">37</a></sup> उदितिः, उत्तिः, वादना, विवदिषा, वावदा;</li> <li>  वदनम्, वादनम्, विवदिषणम्, वावदनम्;</li> <li>  <sup id="ref_krm_1558_38"><a href="#foot_krm_1558_38">38</a></sup> उदित्वा <sup id="ref_krm_1558_39"><a href="#foot_krm_1558_39">39</a></sup>, वादयित्वा, विवदिषित्वा, वावदित्वा;</li> <li>  प्रोद्य, <sup id="ref_krm_1558_40"><a href="#foot_krm_1558_40">40</a></sup> अच्छोद्य, अनुवाद्य, प्रविवदिष्य, प्रवावद्य;</li> <li>  वादम् २, उदित्वा २, वादम् २, वादयित्वा २, विवदिषम् २, विवदिषित्वा २, वावदम् २;</li> <li>  वावदित्वा २;</li> <li>  <sup id="ref_krm_1558_41"><a href="#foot_krm_1558_41">41</a></sup> इतीञ्प्रत्ययः। </li> <li>वदति तस्यामिति वादिः वीणा।]] वादिः, <sup id="ref_krm_1558_42"><a href="#foot_krm_1558_42">42</a></sup> इत्यान्यप्रत्ययः। </li> <li>वदान्यो दाता।]] वदान्यः, <sup id="ref_krm_1558_43"><a href="#foot_krm_1558_43">43</a></sup> <sup id="ref_krm_1558_44"><a href="#foot_krm_1558_44">44</a></sup> इति णिजन्तात् णित्रन्प्रत्ययः। </li> <li>वाद्यते इति वादित्रम् मृदङ्गपणवादिकम्।]] वादित्रम्, <sup id="ref_krm_1558_45"><a href="#foot_krm_1558_45">45</a></sup> इति सप्रत्ययः। </li> <li>‘तितुत्रस--’ <sup id="ref_krm_1558_46"><a href="#foot_krm_1558_46">46</a></sup> इतीण्निषेधः। </li> <li>वत्सः = कुमारः, गोबालश्च।]] वत्सः <sup id="ref_krm_1558_47"><a href="#foot_krm_1558_47">47</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1558_01"><a href="#ref_krm_1558_01">↑</a> (१५४७)</li> <li id="foot_krm_1558_02"><a href="#ref_krm_1558_02">↑</a> (१-भ्वादिः-१००९। सक। सेट्। पर।)</li> <li id="foot_krm_1558_03"><a href="#ref_krm_1558_03">↑</a> (श्लो। १०९)</li> <li id="foot_krm_1558_04"><a href="#ref_krm_1558_04">↑</a> [[आ। ‘मृषोद्यं प्रवदन्तीं तां सत्यवद्यो रघूत्तमः।’ भ। का। ५ ६०।]]</li> <li id="foot_krm_1558_05"><a href="#ref_krm_1558_05">↑</a> [[B। ‘… शैलस्य दर्दुरपुटानिव वादयन्तः।’ शि। व। ५। ९।]]</li> <li id="foot_krm_1558_06"><a href="#ref_krm_1558_06">↑</a> [पृष्ठम्११९०+ २८]</li> <li id="foot_krm_1558_07"><a href="#ref_krm_1558_07">↑</a> [[१। अत्र ‘भासनोपसम्भाषाज्ञानयत्नविमत्युपमन्त्रणेषु वदः’ (१-३-४७) इति वदतेस्तङ्। औत्सर्गिकस्य परस्मैपदस्यापवादः। अत्र भासनम् = दीप्तिः। शास्त्रे वदमानः, दीप्यमानः सन् पदार्थान् व्यक्तीकरोतीत्यर्थः। उपसम्भाषणम् = उपसान्त्वनम्। कर्मकरान् उपवदमानः उपसान्त्वयन् इत्यर्थः। ज्ञानम् = सम्यक् अवबोधः। वदमानश्चार्वी लोकायते इत्युदाहरणम्। सम्यग्वक्तुं जानातीत्यर्थः। यत्नः = उत्साहः। क्षेत्रे वदमानः। क्षेत्रविषयकमुत्साहमाविष्करोतीत्यर्थः। विमतिः = नानामतिः। गेहे विवदमानः। विमतिपतिताः विचित्रं भाषन्ते इत्यर्थः। उपमन्त्रणम् = रहसि उपच्छन्दनम्। कुलभार्यामुपवदमानः। उपच्छन्दय- तीत्यर्थः।]]</li> <li id="foot_krm_1558_08"><a href="#ref_krm_1558_08">↑</a> [[आ। ‘मासे सुतं वैजननेऽथ सूतम् आदाय शौरिः वदमानमद्यौत्।’ वा। वि। २-१४।]]</li> <li id="foot_krm_1558_09"><a href="#ref_krm_1558_09">↑</a> [[२। ‘अपाद् वदः’ (१-३-७३) इति तङ्। न्यायापवादेन धनाद्यार्जनं करोति इत्यर्थः।]]</li> <li id="foot_krm_1558_10"><a href="#ref_krm_1558_10">↑</a> [[३। ‘विभाषा विप्रलापे’ (१-३-५०) इति व्यक्तवाचां समुच्चारणेऽपि वदते- स्तङ्विकल्पः।]]</li> <li id="foot_krm_1558_11"><a href="#ref_krm_1558_11">↑</a> [[४। ‘अनोरकर्मकात्’ (१-३-४९) इति तङ्। एतदपि व्यक्तवाग्विषयकमेव।]]</li> <li id="foot_krm_1558_12"><a href="#ref_krm_1558_12">↑</a> [[५। ‘व्यक्तवाचां समुच्चारणे’ (१-३-४८) इति तङ्। व्यक्तवाचो मनुष्याः। तेन ‘वरतनु संप्रवदन्ति कुक्कुटाः’ इत्यत्र न तङ्।]]</li> <li id="foot_krm_1558_13"><a href="#ref_krm_1558_13">↑</a> [[६। ‘अभिवादिदृशोः--’ (वा। १-४-५३) इति वचनात् आत्मनेपदे प्रयोज्यस्य पाक्षिकं कर्मत्वम्।]]</li> <li id="foot_krm_1558_14"><a href="#ref_krm_1558_14">↑</a> [[७। ‘न पादम्याङ्यमाङ्यसपरिमुहरुचिनृतिवद-’ (१-३-८९) इति परस्मैपदनिषेधः। ‘अणावकर्मकात्--’ (१-३-८८) इत्यस्यापवादोऽयम्।]]</li> <li id="foot_krm_1558_15"><a href="#ref_krm_1558_15">↑</a> [[८। निष्ठायाम्, ‘वचिस्वपियजादीनाम्-’ (६-१-१५) इति सम्प्रसारणम्। तेन पूर्वरूपम्।]]</li> <li id="foot_krm_1558_16"><a href="#ref_krm_1558_16">↑</a> [[B। ‘सकलैः सकलैः परितः करुणैरुदितैः रुदितैरिव खं निचितम्।।’ भ। का। १०। ४।]]</li> <li id="foot_krm_1558_17"><a href="#ref_krm_1558_17">↑</a> [पृष्ठम्११९१+ २९]</li> <li id="foot_krm_1558_18"><a href="#ref_krm_1558_18">↑</a> [[१। ‘याचिव्याहृसंव्याहृव्रजवदवसां प्रतिषिद्धानाम्’ (ग। सू। ३-१-१३४) इति नञि उपपदे ग्रह्यादित्वात् कर्तरि णिनिः।]]</li> <li id="foot_krm_1558_19"><a href="#ref_krm_1558_19">↑</a> [[२। ‘चरिचलिपतिवदीनां द्वित्वम् अचि आक् च अभ्यासस्य’ (वा। ६-१-१२) इति वचनेन पचाद्यचि द्वित्वम्, अभ्यासस्य आक् च भवतः।]]</li> <li id="foot_krm_1558_20"><a href="#ref_krm_1558_20">↑</a> [[३। ‘कुर्वादिभ्यो ण्यः’ (४-१-१५१) इत्यत्र वावदूकशब्दपाठात् वदतेरपि यङन्तात् ऊकप्रत्ययः इति माधवाचार्याः। एवं प्रवावदूकादयोऽपि शब्दा बोध्याः।]]</li> <li id="foot_krm_1558_21"><a href="#ref_krm_1558_21">↑</a> [[४। पचाद्यचि ‘रथवदयोश्च’ (६-३-१०२) इति वदशब्दे परे कोः कत् आदेशः।]]</li> <li id="foot_krm_1558_22"><a href="#ref_krm_1558_22">↑</a> [[आ। ‘येन जातं प्रियापाये कद्वदं हंसकोकिलम्।’ भ। का। ६-७६।]]</li> <li id="foot_krm_1558_23"><a href="#ref_krm_1558_23">↑</a> [[५। अताच्छील्येऽपि ‘साधुकारिण्युपसंख्यानम्’ (वा। ३-२-७८) इति णिनिः।]]</li> <li id="foot_krm_1558_24"><a href="#ref_krm_1558_24">↑</a> [[६। ‘सुप्यजातौ णिनिः--’ (३-२-७८) इति णिनिः। तद्धर्मेऽयं प्रत्ययः। ‘सप्तभिः परिवादिनी’ इति वीणाविशेषः।]]</li> <li id="foot_krm_1558_25"><a href="#ref_krm_1558_25">↑</a> [[७। ‘प्रियवशे वदः खच्’ (३-२-३८) इति खच्। खित्त्वात् मुम्।]]</li> <li id="foot_krm_1558_26"><a href="#ref_krm_1558_26">↑</a> [[B। ‘अनुका प्रार्थयांचक्रे प्रियाकर्तु प्रियंवदा।’ भ। का। ४-१९।]]</li> <li id="foot_krm_1558_27"><a href="#ref_krm_1558_27">↑</a> [[C। ‘सौमित्रे मामुपायंस्थाः कम्रामिच्छुर्वशंवदाम्।’ भ। का। ४। २०।]]</li> <li id="foot_krm_1558_28"><a href="#ref_krm_1558_28">↑</a> [[८। तच्छीलादिषु कर्तृषु ‘प्रे लपसृद्रुमथवदवसः’ (३-२-१४५) इति घिनुण्प्रत्ययः।]]</li> <li id="foot_krm_1558_29"><a href="#ref_krm_1558_29">↑</a> [[९। ‘ब्रह्मणि वदः’ (वा। ३-२-७८) इति णिनिप्रत्ययः। अताच्छीलिकोऽयम्।]]</li> <li id="foot_krm_1558_30"><a href="#ref_krm_1558_30">↑</a> [[१०। तच्छीलादिषु कर्तृषु ‘निन्दहिंसक्लिशखादविनाशपरिक्षिपपरिरटपरिवादि--’ (३-२-१४६) इत्यादिना वुञ्प्रत्ययः।]]</li> <li id="foot_krm_1558_31"><a href="#ref_krm_1558_31">↑</a> [[११। गर्ह्यमित्यर्थे ‘अवद्यपण्यवर्याः--’ (३-१-१०१) इत्यनेन वदतेर्नञ्युपपदे यत् निपात्यते। अन्यत्र अनुद्यम् इत्येव। अत्र नञ्युपपदे वदतेः क्यप्। कित्त्वात् सम्प्रसारणम्।]]</li> <li id="foot_krm_1558_32"><a href="#ref_krm_1558_32">↑</a> [[१२। ‘वदः सुपि क्यप् च’ (३-१-१०६) इति अनुपसर्गे सुपि उपपदे क्यव्विकल्पः। पक्षे यत्। क्यपि ब्रह्मोद्यम्। यति ब्रह्मवद्यम्।]]</li> <li id="foot_krm_1558_33"><a href="#ref_krm_1558_33">↑</a> [[१३। अत्र ‘राजसूयसूर्यमृषोद्य--’ (३-१-११४) इति निपातनात् नित्यं क्यप्।]]</li> <li id="foot_krm_1558_34"><a href="#ref_krm_1558_34">↑</a> [[ड्। ‘अनृतोद्यं न तत्रास्ति सत्यवद्यं ब्रवीम्यहम्।’ भ। का। ६-५५।]]</li> <li id="foot_krm_1558_35"><a href="#ref_krm_1558_35">↑</a> [पृष्ठम्११९२+ २५]</li> <li id="foot_krm_1558_36"><a href="#ref_krm_1558_36">↑</a> [[१। ‘वदः सुपि--’ (३-१-१०६) इत्यत्र ‘सुपि’ इत्युक्तत्वात् सोपसर्गात्, निरुपसृष्टाच्च ण्यदेव। तेन वाद्यम्, प्रवाद्यम् इति सिद्ध्यतः।]]</li> <li id="foot_krm_1558_37"><a href="#ref_krm_1558_37">↑</a> [[२। स्त्रियां क्तिनि ‘तितुत्रेष्वग्रहादीनाम्--’ (वा। ७-२-९) इति वचनादिटि उदिति। क्षीरस्वामी तु उत्तिः इतीडागमाभावपक्षे मुख्यं रूपं साधयित्वा ‘इडपीष्यते उदितिः’ इत्याह।]]</li> <li id="foot_krm_1558_38"><a href="#ref_krm_1558_38">↑</a> [[३। ‘मृडमृदगुधकुषक्लिशवदवसः क्त्वा’ (१-२-७) इति सेटः क्त्वायाः कित्त्वात् सम्प्रसारणम्।]]</li> <li id="foot_krm_1558_39"><a href="#ref_krm_1558_39">↑</a> [[आ। ‘उदित्वाऽलं चिरं यत्नात् सैका धात्रा विनिर्मिता।।’ भ। का। ७। ८६।]]</li> <li id="foot_krm_1558_40"><a href="#ref_krm_1558_40">↑</a> [[४। ‘अच्छ गत्यर्थवदेषु’ (१-४-६९) इति अच्छशब्दस्य गतिसंज्ञा। तेन ‘कुगतिप्रादयः’ (२-२-१८) इति समासे ल्यप्। कित्त्वात् प्रसारणम्।]]</li> <li id="foot_krm_1558_41"><a href="#ref_krm_1558_41">↑</a> [[५। ‘वसिवपिवदि--’ [द। उ। १-५३]</li> <li id="foot_krm_1558_42"><a href="#ref_krm_1558_42">↑</a> [[६। ‘वदेरान्यः’ [द। उ। ८-९]</li> <li id="foot_krm_1558_43"><a href="#ref_krm_1558_43">↑</a> [[B। ‘वदान्यो नान्योऽस्ति त्रिजगति समो रुद्रनृपतेः…।’ प्रतापरुद्रीयं, ना। प्र। १६। श्लो।]]</li> <li id="foot_krm_1558_44"><a href="#ref_krm_1558_44">↑</a> [[७। ‘भूवादि--’ [द। उ। ८-९१]</li> <li id="foot_krm_1558_45"><a href="#ref_krm_1558_45">↑</a> [[८। ‘वृतॄवदि--’ [द। उ। ९-२१]</li> <li id="foot_krm_1558_46"><a href="#ref_krm_1558_46">↑</a> (७-२-९)</li> <li id="foot_krm_1558_47"><a href="#ref_krm_1558_47">↑</a> [पृष्ठम्११९३+ २५]</li></ul></p>

वद|वादकः-दिका|विवादयिषकः-षिका|विवदिषकः-षिका|वावदकः-दिका|वादयिता-त्री|विवादयिषिता-त्री|ण्यन्तात्|सन्नन्ते|इमानि|रूपाणीति|ज्ञेयम्|-|विवादयिषन्-न्ती|विवादयिषिष्यन्-न्ती-ती|विवा-|दयिषमाणः|विवादयिषिष्यमाणः|विवादयिट्-यिषौ-यिषः|विवादयिषितम्-तः-|तवान्|विवादयिषुः|विवादयिषितव्यम्|विवादयिषणीयम्|विवादयिष्यम्|ईषद्विवादयिषः-दुर्विवादयिषः-सुविवादयिषः
<ul><li><sup id="ref_krm_1559_01"><a href="#foot_krm_1559_01">1</a></sup> {@“वद सन्देशवचने”@} <sup id="ref_krm_1559_02"><a href="#foot_krm_1559_02">2</a></sup> आधृषीयः। </li> <li>तेन णिज्विकल्पः। </li> <li>‘--भाषणे’ इति हेमचन्द्र-जैन-कातन्त्रादयः। </li> <li>‘--वाक्सन्देशयोः’ इति वोपदेवः। </li> <li>‘-- वचने च’ इति द्रुमे इति धा। </li> <li>का। </li> <li><sup id="ref_krm_1559_03"><a href="#foot_krm_1559_03">3</a></sup>। </li> <li>‘व्यक्तवाचि वदेद्वा णौ वादयेद् वदते वदेत्।’ <sup id="ref_krm_1559_04"><a href="#foot_krm_1559_04">4</a></sup> इति देवः। </li> <li>अयं धातुः आत्मनेपदी इति शाकटायनः इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>वादकः-दिका, विवादयिषकः-षिका;</li> <li>  वादकः-दिका, विवदिषकः-षिका, वावदकः-दिका;</li> <li>  वादयिता-त्री, विवादयिषिता-त्री;</li> <li>  इत्यादिकानि रूपाणि सर्वाण्यपि ण्यन्तात् सन्नन्तं विना पूर्वलिखितभौवादिकवदतिवत् <sup id="ref_krm_1559_05"><a href="#foot_krm_1559_05">5</a></sup> ऊह्यानि। </li> <li>ण्यन्तात् सन्नन्ते इमानि रूपाणीति ज्ञेयम् -- विवादयिषिता-त्री, विवादयिषन्-न्ती, विवादयिषिष्यन्-न्ती-ती, विवा- दयिषमाणः, विवादयिषिष्यमाणः, विवादयिट्-यिषौ-यिषः;</li> <li>  विवादयिषितम्-तः- तवान्;</li> <li>  विवादयिषुः, विवादयिषितव्यम्, विवादयिषणीयम्, विवादयिष्यम्, ईषद्विवादयिषः-दुर्विवादयिषः-सुविवादयिषः;</li> <li>  विवादयिष्यमाणः, विवादयिषः, विवादयिषितुम्, विवादयिषा, विवादयिषणम्, विवादयिषित्वा, प्रविवादयिष्य, विवादयिषम् २, विवादयिषित्वा २ इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1559_01"><a href="#ref_krm_1559_01">↑</a> (१५४८)</li> <li id="foot_krm_1559_02"><a href="#ref_krm_1559_02">↑</a> (१०-चुरादिः-१८४२। सक। सेट्। उभ।)</li> <li id="foot_krm_1559_03"><a href="#ref_krm_1559_03">↑</a> (३-५१)</li> <li id="foot_krm_1559_04"><a href="#ref_krm_1559_04">↑</a> (श्लो। १०९)</li> <li id="foot_krm_1559_05"><a href="#ref_krm_1559_05">↑</a> (१५४७)</li></ul></p>

वदि|वन्दकः-न्दिका|विवन्दिषकः-षिका|वावन्दकः-न्दिका|वन्दिता-त्री|वन्दयिता-त्री|विवन्दिषिता-त्री|वावन्दिता-त्री|-|वन्दयन्-न्ती|वन्दयिष्यन्-न्ती-ती|वन्दमानः|वन्दयमानः|विवन्दिषमाणः|वावन्द्यमानः
<ul><li><sup id="ref_krm_1560_01"><a href="#foot_krm_1560_01">1</a></sup> {@“वदि अभिवादनस्तुत्योः”@} <sup id="ref_krm_1560_02"><a href="#foot_krm_1560_02">2</a></sup> ‘प्रणतिपूर्वमाशिषो वाचनम् = अभिवादनम्’ इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>‘-- नतिमात्रं वाऽभिवादनम्’ इति धा। </li> <li>का। </li> <li>व्याख्यायाम् <sup id="ref_krm_1560_03"><a href="#foot_krm_1560_03">3</a></sup>। </li> <li>‘-- नुत्यभिवादयोः’ इति वोपदेवः। </li> <li>वन्दकः-न्दिका, वन्दकः-न्दिका, विवन्दिषकः-षिका, वावन्दकः-न्दिका;</li> <li>  वन्दिता-त्री, वन्दयिता-त्री, विवन्दिषिता-त्री, वावन्दिता-त्री;</li> <li>  -- वन्दयन्-न्ती, वन्दयिष्यन्-न्ती-ती;</li> <li>  -- वन्दमानः, वन्दयमानः, विवन्दिषमाणः, वावन्द्यमानः;</li> <li>  इत्यादिकानि रूपाणि सर्वाण्यपि प्रातिस्विकरूपाणि विना भौवादिककन्दतिवत् <sup id="ref_krm_1560_04"><a href="#foot_krm_1560_04">4</a></sup> <sup id="ref_krm_1560_05"><a href="#foot_krm_1560_05">5</a></sup> ऊह्यानि। </li> <li><sup id="ref_krm_1560_06"><a href="#foot_krm_1560_06">6</a></sup> वन्दारुः, <sup id="ref_krm_1560_07"><a href="#foot_krm_1560_07">7</a></sup> <sup id="ref_krm_1560_08"><a href="#foot_krm_1560_08">8</a></sup> वन्दी, वन्दनः, <sup id="ref_krm_1560_09"><a href="#foot_krm_1560_09">9</a></sup> वन्दना, <sup id="ref_krm_1560_10"><a href="#foot_krm_1560_10">10</a></sup> वन्दा, <sup id="ref_krm_1560_11"><a href="#foot_krm_1560_11">11</a></sup> वन्दथः, <sup id="ref_krm_1560_12"><a href="#foot_krm_1560_12">12</a></sup> वन्द्रः, <sup id="ref_krm_1560_13"><a href="#foot_krm_1560_13">13</a></sup> वन्दाकः, इमानि रूपाण्यधिकान्यत्रेति विशेषः। </li> <li>सन्नन्तात् उप्रत्यये-विवन्दिषुः <sup id="ref_krm_1560_14"><a href="#foot_krm_1560_14">14</a></sup> इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1560_01"><a href="#ref_krm_1560_01">↑</a> (१५४९)</li> <li id="foot_krm_1560_02"><a href="#ref_krm_1560_02">↑</a> (१-भ्वादिः ११। सक। सेट्। आत्म।)</li> <li id="foot_krm_1560_03"><a href="#ref_krm_1560_03">↑</a> (१-३)</li> <li id="foot_krm_1560_04"><a href="#ref_krm_1560_04">↑</a> [पृष्ठम्११९४+ ३०]</li> <li id="foot_krm_1560_05"><a href="#ref_krm_1560_05">↑</a> (१६३)</li> <li id="foot_krm_1560_06"><a href="#ref_krm_1560_06">↑</a> [[१। तच्छीलादिषु कर्तृषु ‘शॄवन्द्योरारुः’ (३-२-१७३) इति आरुप्रत्यये रूपम्।]]</li> <li id="foot_krm_1560_07"><a href="#ref_krm_1560_07">↑</a> [[आ। ‘वन्दारुवृन्दारकवन्दिबृन्दमन्दारमालामकरन्दबिन्दून्।’ (अनर्घ। ६-८३)।]]</li> <li id="foot_krm_1560_08"><a href="#ref_krm_1560_08">↑</a> [[२। णिनिप्रत्यये एवं रूपम्। अचि तु वन्दी इति तरङ्गिण्याम्। ‘वन्यते याच्यते वन्दी = हठाहृता स्त्री’ इत्यमरटीकायां क्षीरस्वामी।]]</li> <li id="foot_krm_1560_09"><a href="#ref_krm_1560_09">↑</a> [[३। ‘घट्टिवन्दिविदिभ्यः उपसंख्यानम्’ (वा। ३-३-१०७) इति स्त्रियां युच्प्रत्यये रूपमेवम्।]]</li> <li id="foot_krm_1560_10"><a href="#ref_krm_1560_10">↑</a> [[४। बाहुलकात् स्त्रियां संज्ञायामकारप्रत्यये रूपमेवम्। वन्दा = वृक्षरुहा।]]</li> <li id="foot_krm_1560_11"><a href="#ref_krm_1560_11">↑</a> [[५। ‘शीङ्शपिरुगमिवन्दि--’ (द। उ। ६-३८)। इत्यथप्रत्यये रूपम्। वन्दते वन्द्यते वा वन्दथः = स्तोता, स्तुत्यश्च।]]</li> <li id="foot_krm_1560_12"><a href="#ref_krm_1560_12">↑</a> [[६। औणादिके (द। उ। ८-३१) रक्प्रत्यये वन्द्रः = हेतुः, कामो वा।]]</li> <li id="foot_krm_1560_13"><a href="#ref_krm_1560_13">↑</a> [[७। औणादिके (द। उ। ३-३१) आकप्रत्यये रूपमेवम्। वन्दाकः = कामवृक्षः इति स्वामी। ‘वन्दाकश्चीवरभिक्षुः’ इति हेमचन्द्रः।]]</li> <li id="foot_krm_1560_14"><a href="#ref_krm_1560_14">↑</a> [[B। ‘औहिष्ट तान् वीतविरुद्धबुद्धीन् विवन्दिषून् दाशरथिः स्ववर्ग्यान्।।’ भ। का। ३-४८।]]</li></ul></p>

वन|वानकः-निका|विवनिषकः-षिका|वंवनकः-निका|वनिता-त्री|वानयिता-त्री|विवनिषिता-त्री|वंवनिता-त्री
<ul><li><sup id="ref_krm_1561_01"><a href="#foot_krm_1561_01">1</a></sup> {@“वन शब्दे”@} <sup id="ref_krm_1561_02"><a href="#foot_krm_1561_02">2</a></sup> ‘--संभक्तिशब्दयोः’ इति वोपदेवः। </li> <li>‘याचने वनुते, शब्दे संभक्तौ च वनेदिति।।’ <sup id="ref_krm_1561_03"><a href="#foot_krm_1561_03">3</a></sup> इति देवः। </li> <li>वानकः-निका, वानकः-निका, विवनिषकः-षिका, वंवनकः-निका;</li> <li>  वनिता-त्री, वानयिता-त्री, विवनिषिता-त्री, वंवनिता-त्री;</li> <li>  इत्यादिकानि रूपाणि सर्वाण्यपि भौवादिककणतिवत् <sup id="ref_krm_1561_04"><a href="#foot_krm_1561_04">4</a></sup> ज्ञेयानि। </li> <li>अचि-वनम्, वन्या, <sup id="ref_krm_1561_05"><a href="#foot_krm_1561_05">5</a></sup> वनिः-वनी, वन्यम्, ल्यपि- <sup id="ref_krm_1561_06"><a href="#foot_krm_1561_06">6</a></sup> प्रवत्य, <sup id="ref_krm_1561_07"><a href="#foot_krm_1561_07">7</a></sup> वन्तिः, - <sup id="ref_krm_1561_08"><a href="#foot_krm_1561_08">8</a></sup> वतिः, <sup id="ref_krm_1561_09"><a href="#foot_krm_1561_09">9</a></sup> <sup id="ref_krm_1561_10"><a href="#foot_krm_1561_10">10</a></sup> ब्रह्मवनं त्वा क्षत्रवनिम्, <sup id="ref_krm_1561_11"><a href="#foot_krm_1561_11">11</a></sup> वनिष्ठुः इमानि रूपाण्यधिकान्यत्रेति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1561_01"><a href="#ref_krm_1561_01">↑</a> (१५५०)</li> <li id="foot_krm_1561_02"><a href="#ref_krm_1561_02">↑</a> (१-भ्वादिः-४६२। अक। सेट्। पर।)</li> <li id="foot_krm_1561_03"><a href="#ref_krm_1561_03">↑</a> (श्लो। १२४)</li> <li id="foot_krm_1561_04"><a href="#ref_krm_1561_04">↑</a> (१५७)</li> <li id="foot_krm_1561_05"><a href="#ref_krm_1561_05">↑</a> [[८। ‘कृदिकारादक्तिनः’ (ग। सू। ४-१-४५) इति स्त्रियां वा ङीष् भवति। तेन रूपद्वयमिति बोध्यम्।]]</li> <li id="foot_krm_1561_06"><a href="#ref_krm_1561_06">↑</a> [[९। ‘वा ल्यपि’ (६-४-३८) इत्यनेन अनुदात्तोपदेशादीनां विधीयमानोऽनुनासिक- लोपविकल्पः, व्यवस्थितविभाषाविज्ञानात् नान्तेषु नित्यः। तेन प्रवत्य इत्येकमेव रूपम्, नित्यत्वात्।]]</li> <li id="foot_krm_1561_07"><a href="#ref_krm_1561_07">↑</a> [[१०। क्तिचि, ‘न क्तिचि दीर्घश्च’ (६-४-३९) इति दीर्घानुनासिकलोपयोर्निषेधः।]]</li> <li id="foot_krm_1561_08"><a href="#ref_krm_1561_08">↑</a> [[११। क्तिनि-- ‘तितुत्र--’ (७-२-९) इत्यादिना इण्निषेधात् ‘अनुदात्तोपदेश- वनति--’ (६-४-३७) इत्यनुनासिकलोपे रूपमेवम्।]]</li> <li id="foot_krm_1561_09"><a href="#ref_krm_1561_09">↑</a> [पृष्ठम्११९५+ २६]</li> <li id="foot_krm_1561_10"><a href="#ref_krm_1561_10">↑</a> [[१। ‘छन्दसि वनसनरक्षिमथाम्’ (३-२-२७) इति कर्मण्युपपदे छन्दसि विषये ब्रह्म वनति, क्षत्रं वनतीत्यर्थविवक्षायाम्, इन्प्रत्यये रूपमेवम्।]]</li> <li id="foot_krm_1561_11"><a href="#ref_krm_1561_11">↑</a> [[२। ‘ऋतन्यञ्चिवनि--’ (द। उ। १०-१२) इत्यादिना इष्ठुच्प्रत्यये रूपमेवम्। ‘वनिष्ठुः = अपानं मांसविशेषश्च’ इति मा। धा। वृत्तिः। दशपाद्युणादिवृत्तौ तु (१०-१२) ‘ऋतन्यञ्जि’ इत्यत्र इष्णुच्प्रत्यये वनिष्णुः इत्युक्तम्। अपानोपरि- स्थानमित्यर्थः।]]</li></ul></p>

वन|वानकः-निका|विवनिषकः-षिका|वंवनकः-निका|वनिता-त्री|वानयिता-त्री|विवनिषिता-त्री|वंवनिता-त्री
<ul><li><sup id="ref_krm_1562_01"><a href="#foot_krm_1562_01">1</a></sup> {@“वन संभक्तौ”@} <sup id="ref_krm_1562_02"><a href="#foot_krm_1562_02">2</a></sup> ‘…संभक्तौ च वनेदिति।।’ <sup id="ref_krm_1562_03"><a href="#foot_krm_1562_03">3</a></sup> इति देवः। </li> <li>‘-- भक्तौ। </li> <li>भक्तिः भजनम्’ इति क्षीरस्वामी। </li> <li>‘वनेरर्थभेदात् पुनः पाठः’ इति मैत्रेयरक्षितः। </li> <li>वानकः-निका, वानकः-निका, विवनिषकः-षिका, वंवनकः-निका;</li> <li>  वनिता-त्री, वानयिता-त्री, विवनिषिता-त्री, वंवनिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि भौवादिककणतिवत् <sup id="ref_krm_1562_04"><a href="#foot_krm_1562_04">4</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_1562_05"><a href="#foot_krm_1562_05">5</a></sup> वानरः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1562_01"><a href="#ref_krm_1562_01">↑</a> (१५५१)</li> <li id="foot_krm_1562_02"><a href="#ref_krm_1562_02">↑</a> (१-भ्वादिः-४६३ सक। सेट्। पर।)</li> <li id="foot_krm_1562_03"><a href="#ref_krm_1562_03">↑</a> (श्लो। १२४)</li> <li id="foot_krm_1562_04"><a href="#ref_krm_1562_04">↑</a> (१५७)</li> <li id="foot_krm_1562_05"><a href="#ref_krm_1562_05">↑</a> [[३। वनशब्दात् वने भव इत्यर्थे ‘तत्र भवः’ (४-३-५३) इति अण्प्रत्यये वान इति सिद्धम्। तत औणादिके (द। उ। १०-१२) रक्प्रत्यये वानर इति रूपम्। वा = किंचित् मरो वा वानरः।]]</li></ul></p>

वन
<ul><li><sup id="ref_krm_1563_01"><a href="#foot_krm_1563_01">1</a></sup> {@“वन श्रद्धोपहिंसनयोः”@} <sup id="ref_krm_1563_02"><a href="#foot_krm_1563_02">2</a></sup> ‘चान्द्रपारायणमतेनायं पाठ इति क्षीरस्वामी, हेमचन्द्रश्च इति’ पा। </li> <li>धा। </li> <li>समीक्षायाम्। </li> <li>‘तनु’ इत्यत्र चुरादौ तरङ्गिण्यामेतत्पाठो दृश्यते। </li> <li>अस्य धातोः सर्वाण्यपि रूपाणि चौरादिककाणयतिवत् <sup id="ref_krm_1563_03"><a href="#foot_krm_1563_03">3</a></sup> ऊह्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1563_01"><a href="#ref_krm_1563_01">↑</a> (१५५१-आ)</li> <li id="foot_krm_1563_02"><a href="#ref_krm_1563_02">↑</a> (१०-चुरादिः-सक। सेट्। उभ।)</li> <li id="foot_krm_1563_03"><a href="#ref_krm_1563_03">↑</a> (१५९)</li></ul></p>

वनु|अस्यायमर्थः|इति|विशिष्य|नोच्यते|अतस्तानादिकस्य|नात्रानुवादः|वानकः-निका|वनकः-वानकः-निका|विवनिषकः-षिका|वंवनकः-निका|वनिता-त्री|वनयिता-वानयिता-त्री|विवनिषिता-त्री|वंवनिता-त्री|निष्ठायाम्-वान्तम्|क्त्वायाम्-वत्वा-वनित्वा
<ul><li><sup id="ref_krm_1564_01"><a href="#foot_krm_1564_01">1</a></sup> {@“वनु च नोच्यते”@} <sup id="ref_krm_1564_02"><a href="#foot_krm_1564_02">2</a></sup> घटादिः। </li> <li>‘च’ कारात् हिंसायामपि। </li> <li>‘वनु स्मरणे’ इति काशकृत्स्नः। </li> <li>‘-- व्यापृतौ’ इति वोपदेवः। </li> <li>अस्यायमर्थः इति विशिष्य नोच्यते;</li> <li>  क्रियासामान्यार्थवाचित्वात्। </li> <li>‘अनेकार्थत्वादित्यन्ये’ इति सि। </li> <li>कौमुदी। </li> <li>“यदि तानादिकस्यैवाऽत्रानुवादः स्यात्, तर्हि तनादिगणे ‘वनु’ इति कृतेन उदित्करणेनैव ‘उदितो वा’ <sup id="ref_krm_1564_03"><a href="#foot_krm_1564_03">3</a></sup> इत्याद्युदित्कार्यस्य सिद्धेरिह गणे पुनः <sup id="ref_krm_1564_04"><a href="#foot_krm_1564_04">4</a></sup> उदित्करणमनर्थकं स्यात्। </li> <li>अतस्तानादिकस्य नात्रानुवादः;</li> <li>  किं तु अपूर्व एवायं वनुधातुः” इति बालमनोरमायामुक्तम्। </li> <li>“उदित्करणसामर्थ्यादयमन्यो धातुः, न तानादिकस्यायमनुवादः। </li> <li>क्रियासामान्ये मित्त्वमात्रार्थे ह्यनुवादे तानादिक एवानुवाद्यः, न पुनः शब्दार्थः सम्भक्त्यर्थो वा” इति मा। </li> <li>धा। </li> <li>वृत्तिः इहानुसन्धेया। </li> <li>‘धनपालस्तु वनोतिमेव प्रस्तुत्याह-- “वनुं घटादिषु पठन्ति द्रमिडाः। </li> <li>तेषां <sup id="ref_krm_1564_05"><a href="#foot_krm_1564_05">5</a></sup> मित्संज्ञा। </li> <li>वनयति। </li> <li>आर्यास्तु विभाषा मित्त्व- मिच्छन्ति। </li> <li>तेषां वानयति” इति पुरुषकारः <sup id="ref_krm_1564_06"><a href="#foot_krm_1564_06">6</a></sup>। </li> <li>‘याचने वनुते शब्दे संभक्तौ च वनेदिति।।’ <sup id="ref_krm_1564_07"><a href="#foot_krm_1564_07">7</a></sup> इति देवः। </li> <li>वानकः-निका, वनकः- <sup id="ref_krm_1564_08"><a href="#foot_krm_1564_08">8</a></sup> वानकः-निका, विवनिषकः-षिका, वंवनकः-निका;</li> <li>  वनिता-त्री, वनयिता-वानयिता-त्री, विवनिषिता-त्री, वंवनिता-त्री;</li> <li>  निष्ठायाम्-वान्तम्, क्त्वायाम्-वत्वा- <sup id="ref_krm_1564_09"><a href="#foot_krm_1564_09">9</a></sup> वनित्वा;</li> <li>  इत्यादिकानि रूपाणि सर्वाण्यपि भौवादिकचनतिवत् <sup id="ref_krm_1564_10"><a href="#foot_krm_1564_10">10</a></sup> ज्ञेयानि। </li> <li>अनुपसृष्टे वनयन्-वानयन् इति मित्त्व- विकल्पेन रूपद्वयं भवति। </li> <li>उपसृष्टे तु प्रवनयन् इत्येव।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1564_01"><a href="#ref_krm_1564_01">↑</a> (१५५२)</li> <li id="foot_krm_1564_02"><a href="#ref_krm_1564_02">↑</a> (१-भ्वादिः-८०३। सक। सेट्। पर।)</li> <li id="foot_krm_1564_03"><a href="#ref_krm_1564_03">↑</a> (७-२-५६)</li> <li id="foot_krm_1564_04"><a href="#ref_krm_1564_04">↑</a> [पृष्ठम्११९६+ २९]</li> <li id="foot_krm_1564_05"><a href="#ref_krm_1564_05">↑</a> (नित्यं)</li> <li id="foot_krm_1564_06"><a href="#ref_krm_1564_06">↑</a> (श्लो। १२५)</li> <li id="foot_krm_1564_07"><a href="#ref_krm_1564_07">↑</a> (श्लो। १२४)</li> <li id="foot_krm_1564_08"><a href="#ref_krm_1564_08">↑</a> [[१। ‘ग्लास्नावनुवमां च’ (गणसूत्रं भ्वादिः) इत्यनेनानुपसृष्टस्य धातोः मित्त्वं विकल्पेन भवति। मित्त्वपक्षे ‘मितां ह्रस्वः’ (६-४-९२) इति उपधाह्रस्वः। तेन सर्वत्र णिजन्ते रूपद्वयमिति ज्ञेयम्।]]</li> <li id="foot_krm_1564_09"><a href="#ref_krm_1564_09">↑</a> [[२। अस्य धातोः उदित्त्वात् ‘उदितो वा’ (७-२-५६) इति क्त्वायामिड्विकल्पनात् रूपद्वयमिति बोध्यम्। इडभावपक्षे ‘अनुदात्तोपदेशवनति--’ (६-४-३७) इत्यनुनासिकलोपः।]]</li> <li id="foot_krm_1564_10"><a href="#ref_krm_1564_10">↑</a> (४९४)</li></ul></p>

वनु|वानकः-निका|विवनिषकः-षिका|वंवनकः-निका|वनिता-त्री|वानयिता-त्री|विवनिषिता-त्री|वंवनिता-त्री
<ul><li><sup id="ref_krm_1565_01"><a href="#foot_krm_1565_01">1</a></sup> {@“वनु याचने”@} <sup id="ref_krm_1565_02"><a href="#foot_krm_1565_02">2</a></sup> ‘याचने वनुते, शब्दे संभक्तौ च वनेदिति।।’ <sup id="ref_krm_1565_03"><a href="#foot_krm_1565_03">3</a></sup> इति देवः। </li> <li>चान्द्रास्तु इमं परस्मैपदिनमाहुः। </li> <li>‘उभयपदी’ इति कातन्त्र-शाकटायन- हेमचन्द्रादयः। </li> <li>वानकः-निका, वानकः- <sup id="ref_krm_1565_04"><a href="#foot_krm_1565_04">4</a></sup> <sup id="ref_krm_1565_05"><a href="#foot_krm_1565_05">5</a></sup> निका, विवनिषकः-षिका, वंवनकः-निका;</li> <li>  वनिता-त्री, वानयिता-त्री, विवनिषिता-त्री, वंवनिता-त्री;</li> <li>  <sup id="ref_krm_1565_06"><a href="#foot_krm_1565_06">6</a></sup> इत्यादिकानि रूपाणि सर्वाण्यपि दैवादिकमन्यतिवत् <sup id="ref_krm_1565_07"><a href="#foot_krm_1565_07">7</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1565_08"><a href="#foot_krm_1565_08">8</a></sup> वतम्-तः-तवान्, <sup id="ref_krm_1565_09"><a href="#foot_krm_1565_09">9</a></sup> वनीयकः-वनीपकः, <sup id="ref_krm_1565_10"><a href="#foot_krm_1565_10">10</a></sup> वतिः, <sup id="ref_krm_1565_11"><a href="#foot_krm_1565_11">11</a></sup> वन्तिः, <sup id="ref_krm_1565_12"><a href="#foot_krm_1565_12">12</a></sup> प्रवत्य, <sup id="ref_krm_1565_13"><a href="#foot_krm_1565_13">13</a></sup> वनित्वा- वत्वा, <sup id="ref_krm_1565_14"><a href="#foot_krm_1565_14">14</a></sup> वण्डः, <sup id="ref_krm_1565_15"><a href="#foot_krm_1565_15">15</a></sup> वठरः, <sup id="ref_krm_1565_16"><a href="#foot_krm_1565_16">16</a></sup> वनिष्णुः, इत्यादीनि रूपाणि अस्य धातोः विशेषेण भवन्तीति बोध्यम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1565_01"><a href="#ref_krm_1565_01">↑</a> (१५५३)</li> <li id="foot_krm_1565_02"><a href="#ref_krm_1565_02">↑</a> (८-तनादिः-१४७०। सक। सेट्। आत्म।)</li> <li id="foot_krm_1565_03"><a href="#ref_krm_1565_03">↑</a> (श्लो। १२४)</li> <li id="foot_krm_1565_04"><a href="#ref_krm_1565_04">↑</a> [[३। ‘ग्लास्नावनुवमां च’ (ग। सू। भ्वादिः) इति अनुपसृष्टानां मित्त्वविकल्पे “‘वनु च नोच्यते’ इति घाटादिकस्यास्य च ग्रहः-इत्येके” इति मा। धा। वृत्तावुक्त- त्वात् पक्षे रूपमेवमिति ज्ञेयम्। अन्ये ‘अनन्तरस्य विधिः--’ (परि-६२) इति न्यायेन घाटादिकस्यैव इति वदन्ति।]]</li> <li id="foot_krm_1565_05"><a href="#ref_krm_1565_05">↑</a> [वनकः]</li> <li id="foot_krm_1565_06"><a href="#ref_krm_1565_06">↑</a> [पृष्ठम्११९७+ २९]</li> <li id="foot_krm_1565_07"><a href="#ref_krm_1565_07">↑</a> (१२१७)</li> <li id="foot_krm_1565_08"><a href="#ref_krm_1565_08">↑</a> [[१। निष्ठायाम् ‘अनुदात्तोपदेशवनतितनोत्यादीनाम्--’ (६-४-३७) इत्यनुनासि- कलोपे रूपमेवम्।]]</li> <li id="foot_krm_1565_09"><a href="#ref_krm_1565_09">↑</a> [[२। वनी = याच्ञा, तामिच्छतीति क्यजन्तात् ण्वुलि-वनीयकः इति रूपम्। ‘वनीयको याचनको मार्गणो याचकार्थिनौ’ इत्यमरः। वनीयकः = अर्थिपर्यायः। अन्ये वनीपकः इति पकारान्तं पठन्ति। तेषां वनीं पातीति वनीपः, ततः संज्ञायां कन्प्रत्यये रूपमेवम्।]]</li> <li id="foot_krm_1565_10"><a href="#ref_krm_1565_10">↑</a> [[३। क्तिनि अनुनासिकलोपे रूपमेवम्।]]</li> <li id="foot_krm_1565_11"><a href="#ref_krm_1565_11">↑</a> [[४। क्तिचि-- ‘न क्तिचि दीर्घश्च’ (६-४-३९) इति दीर्घानुनासिकलोपनिषेधे रूपमेवम्।]]</li> <li id="foot_krm_1565_12"><a href="#ref_krm_1565_12">↑</a> [[५। ल्यपि ‘वा ल्यपि’ (६-४-३८) इति अनुदात्तोपदेशादीनां विधीयमानोऽनुनासि- कलोपविकल्पो, व्यवस्थितविभाषाश्रयणात् नान्तेषु नित्यः, तेन रूपमेवम्।]]</li> <li id="foot_krm_1565_13"><a href="#ref_krm_1565_13">↑</a> [[६। ‘उदितो वा’ (७-२-५६) इति क्त्वायामिड्विकल्पो भवति। इट्पक्षे वनित्वा, इडभावपक्षे अनुनासिकलोपे वत्वा इति रूपद्वयं बोध्यम्।]]</li> <li id="foot_krm_1565_14"><a href="#ref_krm_1565_14">↑</a> [[७। औणादिके (द। उ। ५-७) डप्रत्यये वण्डः इति रूपम्। अल्पशेष इत्यर्थः।]]</li> <li id="foot_krm_1565_15"><a href="#ref_krm_1565_15">↑</a> [[८। ‘वनिमनिभ्यां--’ (द। उ। ८-९९) इत्यरप्रत्यये ठकारे चान्तादेशे रूपमेवम्। वनति वनुते वा वठरः = बृहद्द्रोही, मूर्खश्च।]]</li> <li id="foot_krm_1565_16"><a href="#ref_krm_1565_16">↑</a> [[९। ‘ऋतन्यञ्चिवनु--’ (द। उ। १०-१२) इत्यादिना इष्णुच्प्रत्यये रूपमेवम्। वनिष्णुः = अपानोपरिस्थानम् इत्यर्थः।]]</li></ul></p>

वन्चु|वञ्चकः-ञ्चिका|विवञ्चिषकः-षिका|वनीवचकः-चिका|वञ्चिता-त्री|वञ्चयिता-त्री|विवञ्चिषिता-त्री|वनीवचिता-त्री|वञ्चन्-न्ती|वञ्चयन्-न्ती|विवञ्चिषन्-न्ती|-|वञ्चिष्यन्-न्ती-ती|वञ्चयिष्यन्-न्ती-ती|विवञ्चिषिष्यन्-न्ती-ती
<ul><li><sup id="ref_krm_1566_01"><a href="#foot_krm_1566_01">1</a></sup> {@“वन्चु गत्यर्थः”@} <sup id="ref_krm_1566_02"><a href="#foot_krm_1566_02">2</a></sup> ‘वञ्चतीति गतावर्थे वञ्चयेत प्रलम्भने।।’ <sup id="ref_krm_1566_03"><a href="#foot_krm_1566_03">3</a></sup> इति देवः। </li> <li>वञ्चकः-ञ्चिका, वञ्चकः-ञ्चिका, विवञ्चिषकः-षिका, <sup id="ref_krm_1566_04"><a href="#foot_krm_1566_04">4</a></sup> वनीवचकः-चिका;</li> <li>  वञ्चिता-त्री, वञ्चयिता-त्री, विवञ्चिषिता-त्री, वनीवचिता-त्री;</li> <li>  वञ्चन्-न्ती, वञ्चयन्-न्ती, विवञ्चिषन्-न्ती;</li> <li>  -- वञ्चिष्यन्-न्ती-ती, वञ्चयिष्यन्-न्ती-ती, विवञ्चिषिष्यन्-न्ती-ती;</li> <li>  -- इत्यादीनि रूपाणि सर्वाण्यपि भौवादिकध्वंसतिवत् <sup id="ref_krm_1566_05"><a href="#foot_krm_1566_05">5</a></sup> ऊह्यानि। </li> <li><sup id="ref_krm_1566_06"><a href="#foot_krm_1566_06">6</a></sup> <sup id="ref_krm_1566_07"><a href="#foot_krm_1566_07">7</a></sup> <sup id="ref_krm_1566_08"><a href="#foot_krm_1566_08">8</a></sup> वञ्चयमानः, <sup id="ref_krm_1566_09"><a href="#foot_krm_1566_09">9</a></sup> वक्तः-वक्तवान्, <sup id="ref_krm_1566_10"><a href="#foot_krm_1566_10">10</a></sup> वञ्च्यं वञ्चन्ति वणिजः, <sup id="ref_krm_1566_11"><a href="#foot_krm_1566_11">11</a></sup> वचित्वा- <sup id="ref_krm_1566_12"><a href="#foot_krm_1566_12">12</a></sup> वञ्चित्वा-वक्त्वा, <sup id="ref_krm_1566_13"><a href="#foot_krm_1566_13">13</a></sup> वङ्क्रिः, <sup id="ref_krm_1566_14"><a href="#foot_krm_1566_14">14</a></sup> आवक्रम् <sup id="ref_krm_1566_15"><a href="#foot_krm_1566_15">15</a></sup>, इत्यादीनि रूपाणि अस्य धातोः विशेषेण भवन्तीति ज्ञेयम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1566_01"><a href="#ref_krm_1566_01">↑</a> (१५५४)</li> <li id="foot_krm_1566_02"><a href="#ref_krm_1566_02">↑</a> (१-भ्वादिः-१८९। सक। सेट्। पर।)</li> <li id="foot_krm_1566_03"><a href="#ref_krm_1566_03">↑</a> (श्लो। ४८)</li> <li id="foot_krm_1566_04"><a href="#ref_krm_1566_04">↑</a> [[१०। यङन्ते सर्वत्र ‘नीग्वञ्चुस्रंसु--’ (७-४-८४) इत्यादिना अभ्यासस्य नीगागमे उपधानकारस्य लोपे च रूपमेवम्।]]</li> <li id="foot_krm_1566_05"><a href="#ref_krm_1566_05">↑</a> (९४२)</li> <li id="foot_krm_1566_06"><a href="#ref_krm_1566_06">↑</a> [पृष्ठम्११९८+ २७]</li> <li id="foot_krm_1566_07"><a href="#ref_krm_1566_07">↑</a> [माणवकं]</li> <li id="foot_krm_1566_08"><a href="#ref_krm_1566_08">↑</a> [[१। ण्यन्ते ‘गृधिवञ्च्योः प्रलम्भने’ (१-३-६९) इति अकर्त्रभिप्रायेऽपि प्रलम्भनार्थे तङेव। प्रलम्भनम् = मिथ्याफलाख्यानम्। अन्यत्र उभयमपि भवति।]]</li> <li id="foot_krm_1566_09"><a href="#ref_krm_1566_09">↑</a> [[२। उदित्त्वेन क्त्वायामिड्विकल्पात् ‘यस्य विभाषा’ (७-२-१५) इति निष्ठाया- मिण्निषेधे, उपधानकारलोपे च रूपमेवम्।]]</li> <li id="foot_krm_1566_10"><a href="#ref_krm_1566_10">↑</a> [[३। ‘ऋहलोर्ण्यत्’ (३-१-१२४) इति ण्यति ‘चजोः कु घिण्ण्यतोः’ (७-३-५२) इति इति प्राप्तं कुत्वं ‘वञ्चेर्गतौ’ (७-३-६३) इति गत्यर्थे निषिध्यते। अत्र गच्छन्ती- त्यर्थः। अन्यत्र वङ्क्यं काष्ठम्। अत्र कुत्वं भवति। कुटिलमित्यर्थः।]]</li> <li id="foot_krm_1566_11"><a href="#ref_krm_1566_11">↑</a> [[४। ‘वञ्चिलुञ्च्यृतश्च’ (१-२-२४) इति सेटः क्त्वाप्रत्ययस्य कित्त्वविकल्पनात् पक्षे नलोपे वञ्चित्वा-वचित्वा इति। उदित्त्वेन ‘उदितो वा’ (७-२-५६) इति क्त्वायामिड्विकल्पात् इडभावपक्षे वक्त्वा इति। आहत्य क्त्वाप्रत्यये रूपत्रयं बोध्यम्।]]</li> <li id="foot_krm_1566_12"><a href="#ref_krm_1566_12">↑</a> [[आ। ‘वञ्चित्वाऽप्यम्बरं दूरं स्वस्मिन् तिष्ठन्तमात्मनि।’ भ। का। ७-१०६।]]</li> <li id="foot_krm_1566_13"><a href="#ref_krm_1566_13">↑</a> [[५। औणादिके (द। उ। १-३५) क्रिन्प्रत्यये, निपातनात् नलोपाभावः कुत्वं च भवतः। तेन रूपमेवम्। वङ्क्रिः = शल्यं, शरीराङ्गं च।]]</li> <li id="foot_krm_1566_14"><a href="#ref_krm_1566_14">↑</a> [[६। ‘स्फायितञ्चिवञ्चि--’ (द। उ। ८-३१) इत्यादिना रक्प्रत्यये रूपम्। वक्रम् = कुटिलमित्यर्थः।]]</li> <li id="foot_krm_1566_15"><a href="#ref_krm_1566_15">↑</a> [[B। ‘आवक्रचञ्चूपुटतञ्चदारवत्वञ्चत्खगम्रुक्तशिखैर्लताद्रुमैः।’ धा। का। १-२६।]]</li></ul></p>

वन्चु|वञ्चकः-ञ्चिका|विवञ्चयिषकः-षिका|विवञ्चिषकः-षिका|वनीवचकः-चिका|वञ्चयिता-त्री|विवञ्चयिषिता-त्री|वञ्चिता-त्री|विवञ्चिषिता-त्री|वनीवचिता-त्री
<ul><li><sup id="ref_krm_1567_01"><a href="#foot_krm_1567_01">1</a></sup> {@“वन्चु प्रलम्भने”@} <sup id="ref_krm_1567_02"><a href="#foot_krm_1567_02">2</a></sup> प्रलम्भनम् = मिथ्याफलाख्यानम्। </li> <li>आकुस्मीयः। </li> <li>‘… वञ्चयेत प्रलम्भने।।’ <sup id="ref_krm_1567_03"><a href="#foot_krm_1567_03">3</a></sup> इति देवः। </li> <li>उदित्करणात् णिज्विकल्पः। </li> <li>‘-- वञ्चने’ इति वोपदेवः। </li> <li>वञ्चकः-ञ्चिका, विवञ्चयिषकः-षिका, वञ्चकः-ञ्चिका, विवञ्चिषकः-षिका, वनीवचकः-चिका;</li> <li>  वञ्चयिता-त्री, विवञ्चयिषिता-त्री, वञ्चिता-त्री, विवञ्चिषिता-त्री, वनीवचिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि ण्यन्तं तत्प्रकृतिकसन्नन्तं च विना भौवादिक- ध्वंसतिवत् <sup id="ref_krm_1567_04"><a href="#foot_krm_1567_04">4</a></sup> ऊह्यानि। </li> <li><sup id="ref_krm_1567_05"><a href="#foot_krm_1567_05">5</a></sup> ऊह्यानि। </li> <li>णिजन्तात्, तत्प्रकृतिकसन्नन्ताच्च रूपाणि सर्वाणि चौरादिक- गन्धयतिवत् <sup id="ref_krm_1567_06"><a href="#foot_krm_1567_06">6</a></sup> ज्ञेयानि। </li> <li>णिजभावपक्षे सन्नन्तात् उप्रत्यये--विवञ्चिषुः <sup id="ref_krm_1567_07"><a href="#foot_krm_1567_07">7</a></sup> इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1567_01"><a href="#ref_krm_1567_01">↑</a> (१५५५)</li> <li id="foot_krm_1567_02"><a href="#ref_krm_1567_02">↑</a> (१०-चुरादिः-१७०४। सक। सेट्। आत्म।)</li> <li id="foot_krm_1567_03"><a href="#ref_krm_1567_03">↑</a> (श्लो। ४८)</li> <li id="foot_krm_1567_04"><a href="#ref_krm_1567_04">↑</a> (९४२)</li> <li id="foot_krm_1567_05"><a href="#ref_krm_1567_05">↑</a> [पृष्ठम्११९९+ २८]</li> <li id="foot_krm_1567_06"><a href="#ref_krm_1567_06">↑</a> (३७५)</li> <li id="foot_krm_1567_07"><a href="#ref_krm_1567_07">↑</a> [[आ। ‘रामसंघुषितं नैतन्मृगस्यैव विवञ्चिषोः।’ भ। का। ५-५५।]]</li></ul></p>

वप्|प्रणिवापकः-पिका|वापकः-पिका|विवप्सकः-प्सिका|वावपकः-पिका|प्रणिवप्ता-वप्त्री|प्रणिवापयिता-त्री|विवप्सिता-त्री|वावपिता-त्री|प्रणिवपन्-आवपन्-न्ती|वापयन्-न्ती|विवप्सन्-न्ती|-|वप्स्यन्-न्ती-ती|वापयिष्यन्-न्ती-ती|विवप्सिष्यन्-न्ती-ती|वपमानः|वापयमानः|विवप्समानः|वावप्यमानः|वप्स्यमानः|वापयिष्यमाणः|विवप्सिष्यमाणः|वावपिष्यमाणः|यवोप्-यवोब्-यवोपौ-यवोपः|-उप्तम्-उप्तः-उप्तवान्|वापितः|विवप्सितः|वावपितः-तवान्|वपः|वपनः|प्रवापी|निवापी|धान्यवापी|वापः|विवप्सुः|वावपः|प्रणिवप्तव्यम्|वापयितव्यम्|विवप्सितव्यम्|वावपितव्यम्|प्रणिवपनीयम्|वापनीयम्|विवप्सनीयम्|वावपनीयम्|वाप्यम्|विवप्स्यम्|वावप्यम्|ईषद्वपः-दुर्वपः-सुवपः|उप्यमानः|वाप्यमानः|विवप्स्यमानः|उप्त्रिमम्|विवप्सः|वप्तुम्|वापयितुम्|विवप्सितुम्|वावपितुम्|उप्तिः|वपा|वापना|विवप्सा|वावपा|प्रणिवपनम्|वापनम्|विवप्सनम्|वावपनम्|उप्त्वा|वापयित्वा|विवप्सित्वा|वावपित्वा|प्रवोप्य|प्रवाप्य|प्रविवप्स्य|प्रवावप्य|वापम्उप्त्वावापम्वापयित्वाविवप्सम्विवप्सित्वावावपम्
<ul><li><sup id="ref_krm_1568_01"><a href="#foot_krm_1568_01">1</a></sup> {@“<sup id="ref_krm_1568_02"><a href="#foot_krm_1568_02">2</a></sup> वप् बीजसन्ताने”@} <sup id="ref_krm_1568_03"><a href="#foot_krm_1568_03">3</a></sup> यजादिः। </li> <li>“बीजसन्तानः = क्षेत्रे बीजविकिरणम्। </li> <li>अयं गर्भाधानेऽपि दृश्यते। </li> <li>यथा-- ‘मा वः क्षेत्रे परबीजा <sup id="ref_krm_1568_04"><a href="#foot_krm_1568_04">4</a></sup> न्यवाप्सुः’ <sup id="ref_krm_1568_05"><a href="#foot_krm_1568_05">5</a></sup> इति। </li> <li>छेदनेऽपि दृश्यते, ‘केशान्वपति’ इति” इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>‘-- बीजतन्तुसन्ताने’ इति कातन्त्रः। </li> <li>द। </li> <li>उ। </li> <li>वृत्तावपि <sup id="ref_krm_1568_06"><a href="#foot_krm_1568_06">6</a></sup> एवमेव। </li> <li>‘-- छेदने’ इति केचित्। </li> <li>‘--मुण्डबीजोप्त्योः’ इति वोपदेवः। </li> <li>‘निपूर्वात् पितृक्रियार्थता’ इति धा। </li> <li>का। </li> <li>व्याख्यायाम् <sup id="ref_krm_1568_07"><a href="#foot_krm_1568_07">7</a></sup>। </li> <li>‘बीज- तन्तुसन्ताने, वपने, घर्षणे, तन्तुनिर्माणे च’ इति काशकृत्स्नः। </li> <li>प्रणिवापकः-पिका, वापकः-पिका, <sup id="ref_krm_1568_08"><a href="#foot_krm_1568_08">8</a></sup> विवप्सकः-प्सिका, वावपकः-पिका;</li> <li>  प्रणिवप्ता-वप्त्री, प्रणिवापयिता-त्री, विवप्सिता-त्री, वावपिता-त्री;</li> <li>  <sup id="ref_krm_1568_09"><a href="#foot_krm_1568_09">9</a></sup> प्रणिवपन्-आवपन् <sup id="ref_krm_1568_10"><a href="#foot_krm_1568_10">10</a></sup> -न्ती, वापयन्-न्ती, विवप्सन्-न्ती;</li> <li>  -- वप्स्यन्-न्ती-ती, वापयिष्यन्-न्ती-ती, विवप्सिष्यन्-न्ती-ती;</li> <li>  -- वपमानः, वापयमानः, विवप्समानः, वावप्यमानः;</li> <li>  वप्स्यमानः, वापयिष्यमाणः, विवप्सिष्यमाणः, वावपिष्यमाणः;</li> <li>  <sup id="ref_krm_1568_11"><a href="#foot_krm_1568_11">11</a></sup> यवोप्-यवोब्-यवोपौ-यवोपः;</li> <li>  -- -- <sup id="ref_krm_1568_12"><a href="#foot_krm_1568_12">12</a></sup> उप्तम्- <sup id="ref_krm_1568_13"><a href="#foot_krm_1568_13">13</a></sup> उप्तः-उप्तवान्, वापितः, विवप्सितः, वावपितः-तवान्;</li> <li>  <sup id="ref_krm_1568_14"><a href="#foot_krm_1568_14">14</a></sup> वपः, वपनः <sup id="ref_krm_1568_15"><a href="#foot_krm_1568_15">15</a></sup>, प्रवापी <sup id="ref_krm_1568_16"><a href="#foot_krm_1568_16">16</a></sup>, निवापी, धान्यवापी, वापः, <sup id="ref_krm_1568_17"><a href="#foot_krm_1568_17">17</a></sup> विवप्सुः, वावपः;</li> <li>  प्रणिवप्तव्यम्, वापयितव्यम्, विवप्सितव्यम्, वावपितव्यम्;</li> <li>  प्रणिवपनीयम्, वापनीयम्, विवप्सनीयम्, वावपनीयम्;</li> <li>  <sup id="ref_krm_1568_18"><a href="#foot_krm_1568_18">18</a></sup> वाप्यम्, वाप्यम्, विवप्स्यम्, वावप्यम्;</li> <li>  ईषद्वपः-दुर्वपः-सुवपः;</li> <li>  -- -- -- उप्यमानः, वाप्यमानः, विवप्स्यमानः, वावप्यमानः;</li> <li>  वापः, <sup id="ref_krm_1568_19"><a href="#foot_krm_1568_19">19</a></sup> उप्त्रिमम्, <sup id="ref_krm_1568_20"><a href="#foot_krm_1568_20">20</a></sup> वापः, विवप्सः, वावपः;</li> <li>  वप्तुम्, वापयितुम्, विवप्सितुम्, वावपितुम्;</li> <li>  उप्तिः, <sup id="ref_krm_1568_21"><a href="#foot_krm_1568_21">21</a></sup> वपा, वापना, विवप्सा, वावपा;</li> <li>  प्रणिवपनम्, वापनम्, विवप्सनम्, वावपनम्;</li> <li>  उप्त्वा, वापयित्वा, विवप्सित्वा, वावपित्वा;</li> <li>  प्रवोप्य, प्रवाप्य, प्रविवप्स्य, प्रवावप्य;</li> <li>  वापम् २ उप्त्वा २ वापम् २ वापयित्वा २ विवप्सम् २ विवप्सित्वा २ वावपम् २;</li> <li>  वावपित्वा २;</li> <li>  <sup id="ref_krm_1568_22"><a href="#foot_krm_1568_22">22</a></sup> वप्रिः, वापिः <sup id="ref_krm_1568_23"><a href="#foot_krm_1568_23">23</a></sup>, <sup id="ref_krm_1568_24"><a href="#foot_krm_1568_24">24</a></sup> <sup id="ref_krm_1568_25"><a href="#foot_krm_1568_25">25</a></sup> वप्रः <sup id="ref_krm_1568_26"><a href="#foot_krm_1568_26">26</a></sup>, <sup id="ref_krm_1568_27"><a href="#foot_krm_1568_27">27</a></sup> वपुः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1568_01"><a href="#ref_krm_1568_01">↑</a> (१५५६)</li> <li id="foot_krm_1568_02"><a href="#ref_krm_1568_02">↑</a> [डु]</li> <li id="foot_krm_1568_03"><a href="#ref_krm_1568_03">↑</a> (१-भ्वादिः-१००३। सक। अनि। उभ।)</li> <li id="foot_krm_1568_04"><a href="#ref_krm_1568_04">↑</a> [नि]</li> <li id="foot_krm_1568_05"><a href="#ref_krm_1568_05">↑</a> (आप-धर्मसूत्रे-२-६-१३-६)</li> <li id="foot_krm_1568_06"><a href="#ref_krm_1568_06">↑</a> (९। ३९)</li> <li id="foot_krm_1568_07"><a href="#ref_krm_1568_07">↑</a> (२। ४२)</li> <li id="foot_krm_1568_08"><a href="#ref_krm_1568_08">↑</a> [[१। ‘एकाच उपदेशे--’ (७-२-१०) इति धातोरनिट्त्वम्। सन्नन्ते अभ्यासस्येकारः।]]</li> <li id="foot_krm_1568_09"><a href="#ref_krm_1568_09">↑</a> [[२। ‘नेर्गदनदपतपदघुमास्यतिहन्तियातिवातिद्रातिप्सातिवपति--’ (८-४-१७) इत्या- दिना उपसर्गस्थान्निमित्तादुत्तरस्य नकारस्य णकारादेशे रूपमेवम्। एवं तव्य- अनीयर्-ल्युटादिप्रत्ययेष्वपि प्रक्रिया ज्ञेया।]]</li> <li id="foot_krm_1568_10"><a href="#ref_krm_1568_10">↑</a> [[B। ‘तरीषु तत्रत्यमफल्गु भाण्डं सांयात्रिकान् आवपतोऽभ्यनन्दत्।।’ शि। व। ३। ७६।]]</li> <li id="foot_krm_1568_11"><a href="#ref_krm_1568_11">↑</a> [[३। यवान् वपतीत्यर्थः। ‘वपादेस्तु यवोब् विश्वोट् दोषवीश्च पटोत् तुकि।’ इति प्रक्रियासर्वस्वे।]]</li> <li id="foot_krm_1568_12"><a href="#ref_krm_1568_12">↑</a> [[४। निष्ठायां यजादित्वात् ‘वचिस्वपि--’ (६-१-१५) इति संप्रसारणे रूपमेवम्। एवं यक्क्त्वाक्तिन्नादिष्वपि।]]</li> <li id="foot_krm_1568_13"><a href="#ref_krm_1568_13">↑</a> [[C। ‘तस्योल्लसत्काञ्चनकुण्डलाग्रप्रत्युप्तगारुत्मतरत्नभासा।’ शि। व। ३। ५।]]</li> <li id="foot_krm_1568_14"><a href="#ref_krm_1568_14">↑</a> [पृष्ठम्१२००+ २५]</li> <li id="foot_krm_1568_15"><a href="#ref_krm_1568_15">↑</a> [[१। नन्द्यादिषु (३-१-१३४) पाठात् कर्तरि ल्युप्रत्ययः इति केचित्।]]</li> <li id="foot_krm_1568_16"><a href="#ref_krm_1568_16">↑</a> [[२। ‘रक्षश्रुवपीनाम्’ (वा। ३-१-१३४) इति ग्रहादिपाठाण्णिनिप्रत्ययः।]]</li> <li id="foot_krm_1568_17"><a href="#ref_krm_1568_17">↑</a> [[आ। ‘आतिथ्यमेभ्यः परिनिर्विवप्सोः कल्पद्रुमा योगबलेन फेलुः।’ भ। का। ३। ४२।]]</li> <li id="foot_krm_1568_18"><a href="#ref_krm_1568_18">↑</a> [[३। ‘आसुयुवपि--’ (३-१-१२६) इति ण्यत्प्रत्ययः। ‘पोरदुपधात्’ (३-१-९८) इति यतोऽपवादः।]]</li> <li id="foot_krm_1568_19"><a href="#ref_krm_1568_19">↑</a> [[४। ‘ड्वितः क्त्रिः’ (३-३-८८) इति क्त्रिप्रत्यये, ‘क्त्रेर्मम्नित्यम्’ (४-४-२०) इति नित्यं मप्प्रत्यये च रूपमेवम्।]]</li> <li id="foot_krm_1568_20"><a href="#ref_krm_1568_20">↑</a> [[B। ‘असंस्कृत्रिमसंव्यानावनुप्त्रिमफलाशिनौ।’ भ। का। ४। ३७।]]</li> <li id="foot_krm_1568_21"><a href="#ref_krm_1568_21">↑</a> [[५। भिदादि (३-३-१०४) पाठात् स्त्रियां अङि रूपमेवम्। वपा = नाभेः श्वेतं मांसम्।]]</li> <li id="foot_krm_1568_22"><a href="#ref_krm_1568_22">↑</a> [[६। ‘वङ्क्र्यादयश्च’ (द। उ। १-३५) इति क्रिन्प्रत्यये रूपम्। वप्रिः = क्षेत्रम्।]]</li> <li id="foot_krm_1568_23"><a href="#ref_krm_1568_23">↑</a> [[७। ‘वसिवपिवदि--’ (द। उ। १-५३) इति इञ्प्रत्यये वृद्धौ च रूपमेवम्। वपति अस्यामिति वापिः = पुष्करिणी। कृतसोपानकः कूपः।]]</li> <li id="foot_krm_1568_24"><a href="#ref_krm_1568_24">↑</a> [पृष्ठम्१२०१+ २६]</li> <li id="foot_krm_1568_25"><a href="#ref_krm_1568_25">↑</a> [[१। ‘वृधिवपिभ्यां रन्’ (द। उ। ८-४५) इति रन्प्रत्यये रूपमेवम्। उप्यतेऽस्मिन् बीजमिति वप्रम् = क्षेत्रम्, प्राकारजातिर्वा। ‘वप्रोऽस्त्री सानुमानयोः’ इति कोशः।]]</li> <li id="foot_krm_1568_26"><a href="#ref_krm_1568_26">↑</a> [[आ। ‘… तीव्रं महाव्रतमिवात्र चरन्ति वप्राः।।’ शि। व। ४। ५८।]]</li> <li id="foot_krm_1568_27"><a href="#ref_krm_1568_27">↑</a> [[२। ‘अर्त्तिपॄवपियजि--’ (द। उ। ९-३९) इति उसिप्रत्ययः। उप्यते प्राक्कर्मभिरिति वपुः = शरीरं, तेजश्च।]]</li></ul></p>

वभ्र|वभ्रकः-भ्रिका|विवभ्रिषकः-विवब्भ्रिषकः-षिका|वावभ्रकः-भ्रिका|वभ्रिता-त्री|वभ्रयिता-त्री|विवभ्रिषिता-विवब्भ्रिषिता-त्री|वावभ्रिता-त्री
<ul><li><sup id="ref_krm_1569_01"><a href="#foot_krm_1569_01">1</a></sup> {@“वभ्र गत्यर्थः”@} <sup id="ref_krm_1569_02"><a href="#foot_krm_1569_02">2</a></sup> ‘-- गतौ--चलने’ इति काशकृत्स्नः। </li> <li>वभ्रकः-भ्रिका, वभ्रकः-भ्रिका, विवभ्रिषकः- <sup id="ref_krm_1569_03"><a href="#foot_krm_1569_03">3</a></sup> विवब्भ्रिषकः-षिका, वावभ्रकः-भ्रिका;</li> <li>  वभ्रिता-त्री, वभ्रयिता-त्री, विवभ्रिषिता-विवब्भ्रिषिता-त्री, वावभ्रिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि भौवादिककर्बतिवत् <sup id="ref_krm_1569_04"><a href="#foot_krm_1569_04">4</a></sup> ऊह्यानि। </li> <li>शतरि वभ्रन्-न्ती इति। </li> <li>वभ्रः = विवादः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1569_01"><a href="#ref_krm_1569_01">↑</a> (१५५७)</li> <li id="foot_krm_1569_02"><a href="#ref_krm_1569_02">↑</a> (१-भ्वादिः-५५७। सक। सेट्। पर।)</li> <li id="foot_krm_1569_03"><a href="#ref_krm_1569_03">↑</a> [[३। सनि ‘अनचि च’ (८-४-४७) इति भकारस्य पक्षे द्विर्वचने ‘झलां जश् झशि’ (८-४-५३) इति पूर्वस्य जश्त्वे च रूपमेवम्। एवं सन्नन्ते सर्वत्र रूपद्वयं बोध्यम्।]]</li> <li id="foot_krm_1569_04"><a href="#ref_krm_1569_04">↑</a> (१७३)</li></ul></p>

टु|वामकः-मिका|वमकः-मिका|विवमिषकः-षिका|वंवमकः-मिका|वमिता-त्री|वामयिता-वमयिता-त्री|विवमिषिता-त्री|वंवमिता-त्री|वमन्-न्ती|वामयन्-वमयन्-न्ती|विवमिषन्-न्ती|-|वमिष्यन्-न्ती-ती|वामयिष्यन्-न्ती-ती|विवमिषिष्यन्-न्ती-ती|वामयमानः-वमयमानः|वंवम्यमानः|वंवमिष्यमाणः|वमितम्-तः-तवान्|वान्तम्-वान्तः-वान्तवान्|वमितः|विवमिषितः|वंवमितः-तवान्|वमः-वामः|वमी|वमथुः|वामः-वमः|वामी|वामनः|विवमिषुः|वंवमः
<ul><li><sup id="ref_krm_1570_01"><a href="#foot_krm_1570_01">1</a></sup> {@“टु वम उद्गिरणे”@} <sup id="ref_krm_1570_02"><a href="#foot_krm_1570_02">2</a></sup> ‘उद्गिरणे = वमने’ इति काशकृत्स्नः। </li> <li>ज्वलादिः, मिच्च। </li> <li>‘उद्गिरणम् = अन्तर्गतस्य मुखेन निःसारणम्’ इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>‘-- भुक्तस्योर्ध्वगतिः’ इति क्षीरस्वामी। </li> <li>‘उदित् इति काशकृत्स्नपाठः’ इति तरङ्गिण्याम्। </li> <li>प्रकृतकाशकृत्स्नधातुपाठे तु ‘डु वम--’ इत्येव दृश्यते। </li> <li>‘काश्यपादीनामपि उदित्पाठः’ इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li><sup id="ref_krm_1570_03"><a href="#foot_krm_1570_03">3</a></sup> वामकः-मिका, वामकः-मिका, <sup id="ref_krm_1570_04"><a href="#foot_krm_1570_04">4</a></sup> वमकः-मिका, विवमिषकः-षिका, वंवमकः-मिका;</li> <li>  <sup id="ref_krm_1570_05"><a href="#foot_krm_1570_05">5</a></sup> वमिता-त्री, वामयिता-वमयिता-त्री, विवमिषिता-त्री, वंवमिता-त्री;</li> <li>  वमन्-न्ती, वामयन्-वमयन्-न्ती, विवमिषन्-न्ती;</li> <li>  -- वमिष्यन्-न्ती-ती, वामयिष्यन्-न्ती-ती, विवमिषिष्यन्-न्ती-ती;</li> <li>  -- -- वामयमानः-वमयमानः, -- वंवम्यमानः, वंवमिष्यमाणः;</li> <li>  वमितम्-तः-तवान्, <sup id="ref_krm_1570_06"><a href="#foot_krm_1570_06">6</a></sup> वान्तम्-वान्तः-वान्तवान्, वमितः, विवमिषितः, वंवमितः-तवान्;</li> <li>  वमः- <sup id="ref_krm_1570_07"><a href="#foot_krm_1570_07">7</a></sup> वामः, <sup id="ref_krm_1570_08"><a href="#foot_krm_1570_08">8</a></sup> वमी, <sup id="ref_krm_1570_09"><a href="#foot_krm_1570_09">9</a></sup> वमथुः <sup id="ref_krm_1570_10"><a href="#foot_krm_1570_10">10</a></sup>, वामः-वमः वामी, <sup id="ref_krm_1570_11"><a href="#foot_krm_1570_11">11</a></sup> वामनः, विवमिषुः, वंवमः;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि भौवादिकचनतिवत् <sup id="ref_krm_1570_12"><a href="#foot_krm_1570_12">12</a></sup> ऊह्यानि। </li> <li><sup id="ref_krm_1570_13"><a href="#foot_krm_1570_13">13</a></sup> वम्यम्, वान्तिः, <sup id="ref_krm_1570_14"><a href="#foot_krm_1570_14">14</a></sup> वमित्वा-वान्त्वा इमानि रूपाण्यधिकान्यत्रेति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1570_01"><a href="#ref_krm_1570_01">↑</a> (१५५८)</li> <li id="foot_krm_1570_02"><a href="#ref_krm_1570_02">↑</a> (१-भ्वादिः-८४९। सक। सेट्। पर।)</li> <li id="foot_krm_1570_03"><a href="#ref_krm_1570_03">↑</a> [[४। ‘नोदात्तोपदेशस्य मान्तस्य--’ (७-३-३४) इत्यादिना वृद्धिनिषेधे प्राप्ते ‘अनाचमि- कमिवमीनाम्--’ (वा। ७-३-३४) इति वार्त्तिकात् वृद्धिनिषेधो न। तेन ण्वुलि वामकः इति रूपम्।]]</li> <li id="foot_krm_1570_04"><a href="#ref_krm_1570_04">↑</a> [[५। ‘ग्लास्नावनुवमाम्--’ (ग। सू। भ्वादिः) इति अनुपसृष्टस्य धातोः मित्त्वं विकल्पेन भवति। ततः ‘मितां ह्रस्वः’ (६-४-९२) इति ह्रस्वः, तेन ण्यन्ते सर्वत्र रूपद्वयं बोध्यम्।]]</li> <li id="foot_krm_1570_05"><a href="#ref_krm_1570_05">↑</a> [पृष्ठम्१२०२+ ३०]</li> <li id="foot_krm_1570_06"><a href="#ref_krm_1570_06">↑</a> [[१। ‘आदितश्च’ (७-२-१६) इति चकारस्यानुक्तसमुच्चयार्थकत्वात् निष्ठायामनिट्त्वम् इति काशिकादौ। “‘धारानिपातैः सह किन्तु वा-तः चन्द्रोऽयमित्यार्ततरं रसासे’ इति पाणिनिः” इति प्रक्रियासर्वस्वटीकायाम् (पु। २६)। ‘वम्जप्- व्याश्वसो निष्ठायाः इड् वा इति केचित्’ इत्युक्त्या वमितः-वान्तः इति’ प्रक्रियाकौमुदी।]]</li> <li id="foot_krm_1570_07"><a href="#ref_krm_1570_07">↑</a> [[२। कर्तरि ‘ज्वलितिकसन्तेभ्यो णः’ (३-१-१४०) इति विकल्पेन णप्रत्ययः। अचो- ऽपवादः। तेन रूपद्वयम्।]]</li> <li id="foot_krm_1570_08"><a href="#ref_krm_1570_08">↑</a> [[३। ‘जिदृक्षिविश्रीण्वम--’ (३-२-१५७) इत्यादिना तच्छीलादिषु कर्तृषु इनिप्रत्यये रूपमेवम्।]]</li> <li id="foot_krm_1570_09"><a href="#ref_krm_1570_09">↑</a> [[४। भावादौ दवितो धातोः ‘ट्वितोऽथुच्’ (३-३-८९) इति अथुच्प्रत्यये रूपमेवम्। ‘पुमांस्तु वमथुः समाः’ इत्यमरः।]]</li> <li id="foot_krm_1570_10"><a href="#ref_krm_1570_10">↑</a> [[आ। ‘सरक्तं वमथुं केचिद् भ्राजथुं न च केचन।।’ भ। का। ४-४३।]]</li> <li id="foot_krm_1570_11"><a href="#ref_krm_1570_11">↑</a> [[५। वृद्धिपक्षे ण्यन्तात् नन्द्यादित्वात् (३-१-१३४) कर्तरि ल्युः। वामनः = लघुपरिमाणः विष्णोरवतारः।]]</li> <li id="foot_krm_1570_12"><a href="#ref_krm_1570_12">↑</a> (४९४)</li> <li id="foot_krm_1570_13"><a href="#ref_krm_1570_13">↑</a> [[६। ‘पोरदुपधात्’ (३-१-९८) इति यत्प्रत्यये रूपम्। ण्यतोऽपवादः।]]</li> <li id="foot_krm_1570_14"><a href="#ref_krm_1570_14">↑</a> [[७। उदित्पक्षे क्त्वायाम् ‘उदितो वा’ (७-२-५६) इति इड्विकल्पः। इडभावपक्षे ‘अनुनासिकस्य--’ (६-४-१५) इति दीर्घे वान्त्वा इति रूपम्। तेन रूपद्वयं बोध्यम्।]]</li></ul></p>

वय|वायकः-यिका|विवयिषकः-षिका|वावयकः-यिका|वयिता-त्री|वाययिता-त्री|विवयिषिता-त्री|वावयिता-त्री
<ul><li><sup id="ref_krm_1571_01"><a href="#foot_krm_1571_01">1</a></sup> {@“वय गतौ”@} <sup id="ref_krm_1571_02"><a href="#foot_krm_1571_02">2</a></sup> वायकः-यिका, वायकः-यिका, विवयिषकः-षिका, वावयकः-यिका;</li> <li>  वयिता-त्री, वाययिता-त्री, विवयिषिता-त्री, वावयिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि भौवादिकचयतिवत् <sup id="ref_krm_1571_03"><a href="#foot_krm_1571_03">3</a></sup> बोध्यानि। </li> <li>शानचि- <sup id="ref_krm_1571_04"><a href="#foot_krm_1571_04">4</a></sup> वयमानः, <sup id="ref_krm_1571_05"><a href="#foot_krm_1571_05">5</a></sup> वयनः, <sup id="ref_krm_1571_06"><a href="#foot_krm_1571_06">6</a></sup> वयटः, <sup id="ref_krm_1571_07"><a href="#foot_krm_1571_07">7</a></sup> इति असच्प्रत्यये णित्संज्ञके च रूपमेवम्। </li> <li>णित्त्वात् उपधावृद्धिः। </li> <li>वायसः = काकः।]] वायसः, <sup id="ref_krm_1571_08"><a href="#foot_krm_1571_08">8</a></sup> असुन्प्रत्यये रूपमेवम्। </li> <li>वयते गच्छति तदाशु इति वयः = शरीरावस्था। </li> <li>पक्षी इति केचित्।]] वयः, इमानि रूपाण्यधिकान्यत्रेति विशेषः। </li> <li>वयी = स्त्री, वायिः = सगोत्रः, वायः = व्यर्थः, वायम् = मुखम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1571_01"><a href="#ref_krm_1571_01">↑</a> (१५५९)</li> <li id="foot_krm_1571_02"><a href="#ref_krm_1571_02">↑</a> (१-भ्वादिः-४७५। सक। सेट्। आत्म।)</li> <li id="foot_krm_1571_03"><a href="#ref_krm_1571_03">↑</a> (५०२)</li> <li id="foot_krm_1571_04"><a href="#ref_krm_1571_04">↑</a> [पृष्ठम्१२०३+ २९]</li> <li id="foot_krm_1571_05"><a href="#ref_krm_1571_05">↑</a> [[१। तच्छीलादिषु कर्तृषु ‘अनुदात्तेतश्च हलादेः’ (३-२-१४९) इति युच्प्रत्ययः।]]</li> <li id="foot_krm_1571_06"><a href="#ref_krm_1571_06">↑</a> [[२। ‘शकादिभ्योऽटन्’ (द। उ। ५-२) इत्यटन्प्रत्यये रूपमेवम्। वयटः = रसः।]]</li> <li id="foot_krm_1571_07"><a href="#ref_krm_1571_07">↑</a> [[३। ‘वयो णित्’ [द। उ। ९-४६]</li> <li id="foot_krm_1571_08"><a href="#ref_krm_1571_08">↑</a> [[४। औणादिके [द। उ। ९-४९]</li></ul></p>

वर|वरकः-रिका|विवरयिषकः-षिका|वरयिता-त्री|विवरयिषिता-त्री|वरयन्-न्ती|विवरयिषन्-न्ती|वरयिष्यन्-न्ती-ती|विवरयिषिष्यन्-न्ती-ती
<ul><li><sup id="ref_krm_1572_01"><a href="#foot_krm_1572_01">1</a></sup> {@“वर ईप्सायाम्”@} <sup id="ref_krm_1572_02"><a href="#foot_krm_1572_02">2</a></sup> कथादिः, अदन्तश्च। </li> <li><sup id="ref_krm_1572_03"><a href="#foot_krm_1572_03">3</a></sup> वरकः-रिका, विवरयिषकः-षिका, वरयिता-त्री, विवरयिषिता-त्री;</li> <li>  वरयन्-न्ती, विवरयिषन्-न्ती, वरयिष्यन्-न्ती-ती, विवरयिषिष्यन्-न्ती-ती;</li> <li>  क्विपि-वः-वरौ-वरः, ल्यपि- <sup id="ref_krm_1572_04"><a href="#foot_krm_1572_04">4</a></sup> संवरय्य, संविवरयिष्य इत्यादीनि रूपाणि सर्वाण्यपि चौरादिककलयतिवत् <sup id="ref_krm_1572_05"><a href="#foot_krm_1572_05">5</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1572_01"><a href="#ref_krm_1572_01">↑</a> (१५६०)</li> <li id="foot_krm_1572_02"><a href="#ref_krm_1572_02">↑</a> (१०-चुरादिः-१८५३। सक। सेट्। उभ।)</li> <li id="foot_krm_1572_03"><a href="#ref_krm_1572_03">↑</a> [[५। अत्र सर्वत्र अल्लोपस्य स्थानिवत्त्वात् उपधावृद्धिर्न भवति।]]</li> <li id="foot_krm_1572_04"><a href="#ref_krm_1572_04">↑</a> [[६। ‘ल्यपि लघुपूर्वात्’ (६-४-५६) इति णेरयादेशे रूपमेवम्।]]</li> <li id="foot_krm_1572_05"><a href="#ref_krm_1572_05">↑</a> (१७६)</li></ul></p>

वर्च|वर्चकः-र्चिका|विवर्चिषकः-षिका|वावर्चकः-र्चिका|वर्चिता-त्री|वर्चयिता-त्री|विवर्चिषिता-त्री|वावर्चिता-त्री
<ul><li><sup id="ref_krm_1573_01"><a href="#foot_krm_1573_01">1</a></sup> {@“वर्च दीप्तौ”@} <sup id="ref_krm_1573_02"><a href="#foot_krm_1573_02">2</a></sup> वर्चकः-र्चिका, वर्चकः-र्चिका, विवर्चिषकः-षिका, वावर्चकः-र्चिका;</li> <li>  वर्चिता-त्री, वर्चयिता-त्री, विवर्चिषिता-त्री, वावर्चिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि भौवादिकचर्चतिवत् <sup id="ref_krm_1573_03"><a href="#foot_krm_1573_03">3</a></sup> ऊह्यानि। </li> <li>अस्य धातोः आत्मनेपदित्वात् शानचि- <sup id="ref_krm_1573_04"><a href="#foot_krm_1573_04">4</a></sup> वर्चमानः, क्विपि- <sup id="ref_krm_1573_05"><a href="#foot_krm_1573_05">5</a></sup> अवावर्क-वर्चौ-वर्चः, सुवर्ची, सुवर्चिका, सुवर्चला, वर्चस्कम्, ब्रह्मवर्चसम्-हस्तिवर्चसम्, ण्यति- <sup id="ref_krm_1573_06"><a href="#foot_krm_1573_06">6</a></sup> वर्च्यम्, <sup id="ref_krm_1573_07"><a href="#foot_krm_1573_07">7</a></sup> वर्चा, <sup id="ref_krm_1573_08"><a href="#foot_krm_1573_08">8</a></sup> असुन्प्रत्यये रूपमेवम्। </li> <li>वर्चः = आशुतेजसी इत्यर्थः।]] वर्चः इत्यादीनि रूपाणि अस्य धातोः विशेषेण भवन्तीति बोध्यम्। </li> <li><sup id="ref_krm_1573_09"><a href="#foot_krm_1573_09">9</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1573_01"><a href="#ref_krm_1573_01">↑</a> (१५६१)</li> <li id="foot_krm_1573_02"><a href="#ref_krm_1573_02">↑</a> (१-भ्वादिः-१६२। अक। सेट्। आत्म।)</li> <li id="foot_krm_1573_03"><a href="#ref_krm_1573_03">↑</a> (५०५)</li> <li id="foot_krm_1573_04"><a href="#ref_krm_1573_04">↑</a> [[आ। ‘सुमङ्घिताः शिङ्घितपुष्पसौरभा यद्वर्चमानाः पशुपाः प्रसेचिरे।।’ धा। का। १। २२।]]</li> <li id="foot_krm_1573_05"><a href="#ref_krm_1573_05">↑</a> [[७। ‘रात् सस्य’ (८-२-२४) इति नियमात् न संयोगान्तलोपः।]]</li> <li id="foot_krm_1573_06"><a href="#ref_krm_1573_06">↑</a> [[८। ण्यति ‘चजोः कु घिण्ण्यतोः’ (७-३-५२) इति कुत्वं न भवति। ‘न क्वादेः’ (७-३-५९) इत्यत्र ‘क्वाद्यजिव्रजियाचिरुचीनामप्रतिषेधो निष्ठायामनिटः कुत्व- वचनात्’ इति वार्तिकम्। ये क्वादयोऽन्ये वा निष्ठायामनिटस्तेषां कुत्वम्, ये तु सेटस्तेषां नेति संग्रहार्थः। तेनात्र कुत्वं नेति ज्ञेयम्।]]</li> <li id="foot_krm_1573_07"><a href="#ref_krm_1573_07">↑</a> [[९। ‘गुरोश्च हलः’ (३-३-१०३) इति स्त्रियामकारप्रत्ययः। क्तिनोऽपवादः।]]</li> <li id="foot_krm_1573_08"><a href="#ref_krm_1573_08">↑</a> [[१०। औणादिके [द। उ। ९-४९]</li> <li id="foot_krm_1573_09"><a href="#ref_krm_1573_09">↑</a> [पृष्ठम्१२०४+ २७]</li></ul></p>

वर्ण|वर्णकः-र्णिका|विवर्णयिषकः-षिका|वर्णयिता-त्री|विवर्णयिषिता-त्री
<ul><li><sup id="ref_krm_1574_01"><a href="#foot_krm_1574_01">1</a></sup> {@“वर्ण प्रेरणे”@} <sup id="ref_krm_1574_02"><a href="#foot_krm_1574_02">2</a></sup> ‘मैत्रेय एवमुक्तवान्’ इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>क्षीरस्वामी तु ‘-- वर्णने’ इत्याह। </li> <li>सि। </li> <li>कौमुद्यामपि ‘-- प्रेरणे’ इति पठित्वा, ‘वर्णने इत्येके’ इति दृश्यते। </li> <li>वर्णकः-र्णिका, विवर्णयिषकः-षिका;</li> <li>  वर्णयिता-त्री, विवर्णयिषिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि चौरादिकचूर्णयतिवत् <sup id="ref_krm_1574_03"><a href="#foot_krm_1574_03">3</a></sup> बोध्यानि। </li> <li>वर्णं गृह्णाति इत्यर्थे वर्णयति-- ‘सत्यापपाशरूपवीणातूलश्लोकसेनालोमत्वचवर्मवर्ण--’ <sup id="ref_krm_1574_04"><a href="#foot_krm_1574_04">4</a></sup> इति णिच्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1574_01"><a href="#ref_krm_1574_01">↑</a> (१५६२)</li> <li id="foot_krm_1574_02"><a href="#ref_krm_1574_02">↑</a> (१०-चुरादिः-१५५१। सक। सेट्। उभ।)</li> <li id="foot_krm_1574_03"><a href="#ref_krm_1574_03">↑</a> (५५९)</li> <li id="foot_krm_1574_04"><a href="#ref_krm_1574_04">↑</a> (३-१-२५)</li></ul></p>

वर्ण|वर्णकः-र्णिका|विवर्णयिषकः-षिका|वर्णयिता-त्री|विवर्णयिषिता-त्री
<ul><li><sup id="ref_krm_1575_01"><a href="#foot_krm_1575_01">1</a></sup> {@“वर्ण वर्णक्रियाविस्तारगुणवचनेषु”@} <sup id="ref_krm_1575_02"><a href="#foot_krm_1575_02">2</a></sup> अदन्तः। </li> <li>वर्णक्रिया = वर्णनं, वर्णकरणं वा। </li> <li>कथां वर्णयति, सुवर्णं वर्णयति, विस्तृणाती- त्यर्थः। </li> <li>विस्तारे--वर्णनेयम्। </li> <li>गुणवचनं = स्तुतिः, शुक्लाद्युक्तिर्वा। </li> <li>राजान- मुपवर्णयति। </li> <li>‘-- रागे विस्तारे प्रशंसायां च’ इति काशकृत्स्नः। </li> <li>वर्णकः-र्णिका, विवर्णयिषकः-षिका;</li> <li>  वर्णयिता-त्री, विवर्णयिषिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाणि भेदनार्थकचौरादिककर्णयतिवत् <sup id="ref_krm_1575_03"><a href="#foot_krm_1575_03">3</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1575_01"><a href="#ref_krm_1575_01">↑</a> (१५६३)</li> <li id="foot_krm_1575_02"><a href="#ref_krm_1575_02">↑</a> (१०-चुरादिः-१९३८। सक। सेट्। उभ।)</li> <li id="foot_krm_1575_03"><a href="#ref_krm_1575_03">↑</a> (१७०)</li></ul></p>

वर्ध
<ul><li><sup id="ref_krm_1576_01"><a href="#foot_krm_1576_01">1</a></sup> {@“वर्ध छेदनपूरणयोः”@} <sup id="ref_krm_1576_02"><a href="#foot_krm_1576_02">2</a></sup> ‘छेदने पूरणे चार्थे वर्धेः वर्धयतीति णौ।।’ <sup id="ref_krm_1576_03"><a href="#foot_krm_1576_03">3</a></sup> इति देवः। </li> <li>काशकृत्स्नेन ‘वृधु वर्धने’ इति पठित्वा वर्धकिः--तक्षकः इत्युक्तम्। </li> <li>तत्र टिप्पन्यां तु ‘प्राङ् नाभिवर्धनात् पुंसः’ इति मनु <sup id="ref_krm_1576_04"><a href="#foot_krm_1576_04">4</a></sup> वचने छेदनार्थ एव दृश्यते। </li> <li>वर्धकिप्रयोगेऽपि स एवार्थोऽभिप्रेतः। </li> <li>अतः काशकृत्स्न- पाठे लेखकप्रमादात् भ्रष्टपाठः स्यात्, यद्वा वर्धनशब्दस्य छेदन एवात्रार्थो ग्रहीतव्यः’ इत्येवमुक्तम्। </li> <li>वर्धकः-र्धिका, विवर्धयिषकः-षिका, वर्धयिता-त्री, विवर्धयिषिता-त्री, इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकचर्चयतिवत् <sup id="ref_krm_1576_05"><a href="#foot_krm_1576_05">5</a></sup> ऊह्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1576_01"><a href="#ref_krm_1576_01">↑</a> (१५६४)</li> <li id="foot_krm_1576_02"><a href="#ref_krm_1576_02">↑</a> (१०-चुरादिः-१६५५। सक। सेट्। उभ।)</li> <li id="foot_krm_1576_03"><a href="#ref_krm_1576_03">↑</a> (श्लो। १२३।)</li> <li id="foot_krm_1576_04"><a href="#ref_krm_1576_04">↑</a> (२। २९।)</li> <li id="foot_krm_1576_05"><a href="#ref_krm_1576_05">↑</a> (५०७)</li></ul></p>

वर्फ|वर्फकः-र्फिका|विवर्फिषकः-षिका|वावर्फकः-र्फिका|वर्फिता-त्री|वर्फयिता-त्री|विवर्फिषिता-त्री|वावर्फिता-त्री
<ul><li><sup id="ref_krm_1577_01"><a href="#foot_krm_1577_01">1</a></sup> {@“वर्फ गतौ”@} <sup id="ref_krm_1577_02"><a href="#foot_krm_1577_02">2</a></sup> “क्षीरस्वामिचन्द्रकातन्त्रहेरम्बादयः ‘वर्फ--’ इति पठन्ति। </li> <li>मैत्रेयसायणजैनकाशकृत्स्नशाकटायनप्रभृतयः न पठन्ति” इति पा। </li> <li>धा। </li> <li><sup id="ref_krm_1577_03"><a href="#foot_krm_1577_03">3</a></sup> समीक्षा। </li> <li>क्षीरतरङ्गिण्याम् ‘वर्फ--’ इति पठित्वा ‘हिंसार्थे कण्ठः पठति’ इत्युक्तम्। </li> <li>‘वफ--’ इति काशकृत्स्नः। </li> <li>‘पर्प--’ इति सायणः। </li> <li>वर्फकः-र्फिका, वर्फकः-र्फिका, विवर्फिषकः-षिका, वावर्फकः-र्फिका;</li> <li>  वर्फिता-त्री, वर्फयिता-त्री, विवर्फिषिता-त्री, वावर्फिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककर्बतिवत् <sup id="ref_krm_1577_04"><a href="#foot_krm_1577_04">4</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1577_01"><a href="#ref_krm_1577_01">↑</a> (१५६५)</li> <li id="foot_krm_1577_02"><a href="#ref_krm_1577_02">↑</a> (१-भ्वादिः-४१२तःआ#} सक। सेट्। पर।)</li> <li id="foot_krm_1577_03"><a href="#ref_krm_1577_03">↑</a> [पृष्ठम्१२०५+ २६]</li> <li id="foot_krm_1577_04"><a href="#ref_krm_1577_04">↑</a> (१७३)</li></ul></p>

वर्ष|वर्षकः-र्षिका|विवर्षिषकः-षिका|वावर्षकः-र्षिका|वर्षिता-त्री|वर्षयिता-त्री|विवर्षिषिता-त्री|वावर्षिता-त्री
<ul><li><sup id="ref_krm_1578_01"><a href="#foot_krm_1578_01">1</a></sup> {@“वर्ष स्नेहने”@} <sup id="ref_krm_1578_02"><a href="#foot_krm_1578_02">2</a></sup> ‘… स्नेहे तु वर्षते।।’ <sup id="ref_krm_1578_03"><a href="#foot_krm_1578_03">3</a></sup> इति देवः। </li> <li>‘पर्ष--’ इति क्षीरस्वामी। </li> <li>चन्द्रकाशकृत्स्नकातन्त्रहेरम्बवोपदेवादयः न पठन्ति। </li> <li>शाकटायनदेवमैत्रेयसायणभट्टोजिदीक्षितादयः ‘वर्ष स्नेहने’ इत्यभ्युपगच्छन्ति। </li> <li>स्नेहनं = स्निग्धीभावः। </li> <li>‘पर्ष वर्ष’ इति पृथक्त्वेन मैत्रेयः पठति। </li> <li>वर्षकः-र्षिका, वर्षकः-र्षिका, विवर्षिषकः-षिका, वावर्षकः-र्षिका;</li> <li>  वर्षिता-त्री, वर्षयिता-त्री, विवर्षिषिता-त्री, वावर्षिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि भौवादिककर्बतिवत् <sup id="ref_krm_1578_04"><a href="#foot_krm_1578_04">4</a></sup> ज्ञेयानि। </li> <li>अवावर्ट्- <sup id="ref_krm_1578_05"><a href="#foot_krm_1578_05">5</a></sup> अवावर्ड्-वर्षौ-वर्षः, <sup id="ref_krm_1578_06"><a href="#foot_krm_1578_06">6</a></sup> प्रियवर्षी, धनवर्षी, निष्ठायाम्-वर्षितम्-तः-तवान्, इमानि रूपाणि विशेषेण भवन्ति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1578_01"><a href="#ref_krm_1578_01">↑</a> (१५६६)</li> <li id="foot_krm_1578_02"><a href="#ref_krm_1578_02">↑</a> (१-भ्वादिः-६१३। अक। सेट्। आत्म।)</li> <li id="foot_krm_1578_03"><a href="#ref_krm_1578_03">↑</a> (श्लो। १७६)</li> <li id="foot_krm_1578_04"><a href="#ref_krm_1578_04">↑</a> (१७३)</li> <li id="foot_krm_1578_05"><a href="#ref_krm_1578_05">↑</a> [[१। क्विपि, ‘रात् सस्य’ (८-२-२४) इति नियमात् न संयोगान्तलोपः।]]</li> <li id="foot_krm_1578_06"><a href="#ref_krm_1578_06">↑</a> [[२। ताच्छीलिके णिनिप्रत्यये रूपमेवम्।]]</li></ul></p>

वर्ह|वर्हकः-र्हिका|विवर्हिषकः-षिका|वावर्हकः-र्हिका|वर्हिता-त्री|वर्हयिता-त्री|विवर्हिषिता-त्री|वावर्हिता-त्री
<ul><li><sup id="ref_krm_1579_01"><a href="#foot_krm_1579_01">1</a></sup> {@“वर्ह परिभाषणहिंसाच्छादनेषु”@} <sup id="ref_krm_1579_02"><a href="#foot_krm_1579_02">2</a></sup> ‘-- परिभाषणहिंसादानेषु’ इति क्षीरस्वामिमैत्रेयद्रुमसायणा- दयः। </li> <li>‘-- प्राधान्यपरिभाषण… दानेषु’ इति कातन्त्रे। </li> <li>चन्द्रकाश- कृत्स्नौ न पठतः। </li> <li>“अत्र धनपालमैत्रेयौ परिभाषणादावोष्ठ्यादित्वम्, वृद्धौ दन्त्योष्ठ्यादित्वं चाहतुः। </li> <li>‘छादयत्यनेनेति वर्हः घञ्’ इति वदन् शाकटाय- नोऽप्यत्रैवानुकूलः। </li> <li>यथा वयं तथा स्वामी।” इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>‘परिभाषणमत्र वञ्चनवादः’ इति धा। </li> <li>का। </li> <li>व्याख्या <sup id="ref_krm_1579_03"><a href="#foot_krm_1579_03">3</a></sup>। </li> <li><sup id="ref_krm_1579_04"><a href="#foot_krm_1579_04">4</a></sup> वर्हकः-र्हिका, वर्हकः-र्हिका, विवर्हिषकः-षिका, वावर्हकः-र्हिका;</li> <li>  वर्हिता-त्री, वर्हयिता-त्री, विवर्हिषिता-त्री, वावर्हिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि भौवादिकगर्हतिवत् <sup id="ref_krm_1579_05"><a href="#foot_krm_1579_05">5</a></sup> बोध्यानि। </li> <li>युचि- <sup id="ref_krm_1579_06"><a href="#foot_krm_1579_06">6</a></sup> वर्हणः, <sup id="ref_krm_1579_07"><a href="#foot_krm_1579_07">7</a></sup> वर्हा इति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1579_01"><a href="#ref_krm_1579_01">↑</a> (१५६७)</li> <li id="foot_krm_1579_02"><a href="#ref_krm_1579_02">↑</a> (१-भ्वादिः-६४०। सक। सेट्। आत्म।)</li> <li id="foot_krm_1579_03"><a href="#ref_krm_1579_03">↑</a> (१-८१)</li> <li id="foot_krm_1579_04"><a href="#ref_krm_1579_04">↑</a> [पृष्ठम्१२०६+ २६]</li> <li id="foot_krm_1579_05"><a href="#ref_krm_1579_05">↑</a> (३८५)</li> <li id="foot_krm_1579_06"><a href="#ref_krm_1579_06">↑</a> [[१। ‘अनुदात्तेतश्च हलादेः’ (३-२-१४९) इति युचि रूपमेवम्।]]</li> <li id="foot_krm_1579_07"><a href="#ref_krm_1579_07">↑</a> [[२। ‘गुरोश्च हलः’ (३-३-१०३) इति स्त्रियामकारप्रत्ययः। क्तिनोऽपवादः।]]</li></ul></p>

वर्ह
<ul><li><sup id="ref_krm_1580_01"><a href="#foot_krm_1580_01">1</a></sup> {@“वर्ह भासार्थः”@} <sup id="ref_krm_1580_02"><a href="#foot_krm_1580_02">2</a></sup> इति क्षीरस्वामिशाकटायनौ इति पाणिनीयधातुपाठसमीक्षायामुपात्तम्। </li> <li>प्रकृतक्षीरतरङ्गिण्यां तु ‘बर्ह’ इत्येव दृश्यते। </li> <li>रूपाणि यथासम्भवं बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1580_01"><a href="#ref_krm_1580_01">↑</a> (१५६७-आ)</li> <li id="foot_krm_1580_02"><a href="#ref_krm_1580_02">↑</a> (१०-चुरादिः-१८४३। सक। सेट्। उभ।)</li></ul></p>

वल|वालकः-लिका|वलकः-वालकः-लिका|विवलिषकः-षिका|वावलकः-लिका|वलिता-त्री|वालयिता-त्री|विवलिषिता-त्री|वावलिता-त्री|-|वालयन्-न्ती|वालयिष्यन्-न्ती-ती|वलमानः|वालयमानः|विवलिषमाणः|वावल्यमानः|वलूकम्|=|उत्पलद्रव्यम्।]]|वलयम्
<ul><li><sup id="ref_krm_1581_01"><a href="#foot_krm_1581_01">1</a></sup> {@“वल संवरणसंचरणयोः”@} <sup id="ref_krm_1581_02"><a href="#foot_krm_1581_02">2</a></sup> घटादिः। </li> <li>‘-- संवरणे’ इत्येव क्षीरतरङ्गिणी। </li> <li>‘-- संवृतौ’ इति जैनेन्द्रे। </li> <li>‘-- चलने संवरणे च’ इति कातन्त्रः। </li> <li>‘-- स्मृतौ’इति वोपदेवः। </li> <li>‘-- संवरणे--प्रसारे’ इति काशकृत्स्नः। </li> <li>इतः पूर्वं भ्वादौ ‘वल निष्पत्तौ--फलितभावे’ इति च पठितम्। </li> <li>अन्यत्र कोशेषु अस्य पाठो न दृश्यते। </li> <li>‘वलतेरात्मनेपदमनित्यम्’ इति वामनालंकारे <sup id="ref_krm_1581_03"><a href="#foot_krm_1581_03">3</a></sup>। </li> <li>वालकः-लिका, <sup id="ref_krm_1581_04"><a href="#foot_krm_1581_04">4</a></sup> वलकः-वालकः-लिका, विवलिषकः-षिका, वावलकः-लिका;</li> <li>  वलिता-त्री, वालयिता-त्री, विवलिषिता-त्री, वावलिता-त्री;</li> <li>  -- वालयन्-न्ती, वालयिष्यन्-न्ती-ती;</li> <li>  -- वलमानः, वालयमानः, विवलिषमाणः, वावल्यमानः;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि भौवादिककलतिवत् <sup id="ref_krm_1581_05"><a href="#foot_krm_1581_05">5</a></sup> बोध्यानि। </li> <li>शतरि वलन्- <sup id="ref_krm_1581_06"><a href="#foot_krm_1581_06">6</a></sup> न्ती। </li> <li><sup id="ref_krm_1581_07"><a href="#foot_krm_1581_07">7</a></sup> <sup id="ref_krm_1581_08"><a href="#foot_krm_1581_08">8</a></sup> वालः-वारः-वालिः, वलिः- <sup id="ref_krm_1581_09"><a href="#foot_krm_1581_09">9</a></sup> वली, वलिनः, <sup id="ref_krm_1581_10"><a href="#foot_krm_1581_10">10</a></sup> वलीकम्, वलिभः, वलभी, <sup id="ref_krm_1581_11"><a href="#foot_krm_1581_11">11</a></sup> वालाकिः, <sup id="ref_krm_1581_12"><a href="#foot_krm_1581_12">12</a></sup> वल्मीकम्, वलिः, <sup id="ref_krm_1581_13"><a href="#foot_krm_1581_13">13</a></sup> वल्कः, <sup id="ref_krm_1581_14"><a href="#foot_krm_1581_14">14</a></sup> वलाका-वलाकी, <sup id="ref_krm_1581_15"><a href="#foot_krm_1581_15">15</a></sup> <sup id="ref_krm_1581_16"><a href="#foot_krm_1581_16">16</a></sup> इत्यूकप्रत्यये निरूढः। </li> <li>वलूकम् = उत्पलद्रव्यम्।]] वलूकम्, <sup id="ref_krm_1581_17"><a href="#foot_krm_1581_17">17</a></sup> वलयम्;</li> <li>  इत्यादिकानि रूपाण्यधिकान्यत्रेति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1581_01"><a href="#ref_krm_1581_01">↑</a> (१५६८)</li> <li id="foot_krm_1581_02"><a href="#ref_krm_1581_02">↑</a> (१-भ्वादिः-४९१। सक। सेट्। आत्म।)</li> <li id="foot_krm_1581_03"><a href="#ref_krm_1581_03">↑</a> (५-२-३)</li> <li id="foot_krm_1581_04"><a href="#ref_krm_1581_04">↑</a> [[३। ‘दलिवलि…’ इति घटादिषु भोजसम्मतः पाठः। ‘घटादयो मितः’ (ग। सू। भ्वादिः) इति मित्त्वात् ‘मितां ह्रस्वः’ (६-४-९२) इति णौ उपधाह्रस्वः। तेन वलकः इत्यादिकानि रूपाणि। ण्यन्ते सर्वत्र एवं ह्रस्वघटितरूपाणि ऊह्यानि।]]</li> <li id="foot_krm_1581_05"><a href="#ref_krm_1581_05">↑</a> (१७४)</li> <li id="foot_krm_1581_06"><a href="#ref_krm_1581_06">↑</a> [[४। ‘अनुदात्तेतां तङोऽनित्यत्वात् शतरि वलन्’ इति धा। का। व्याख्या- याम् (१-६३)।]]</li> <li id="foot_krm_1581_07"><a href="#ref_krm_1581_07">↑</a> [पृष्ठम्१२०७+ २८]</li> <li id="foot_krm_1581_08"><a href="#ref_krm_1581_08">↑</a> [[१। संज्ञायाम् ‘हलश्च’ (३-३-१२१) इति करणे घञ्प्रत्यये रूपमेवम्। ‘वालमूल--’ (वा। ८-२-१८) इत्यादिना पक्षे रः। तेन रूपद्वयं बोध्यम्। वालः = केशः, पुच्छम् च। वालिः = देवेन्द्रस्य पुत्रः।]]</li> <li id="foot_krm_1581_09"><a href="#ref_krm_1581_09">↑</a> [[२। इन्नन्तात् ‘कृदिकारादक्तिनः’ (ग। सू। ४-१-४५) इति वा ङीष्।]]</li> <li id="foot_krm_1581_10"><a href="#ref_krm_1581_10">↑</a> [[३। वलति आवृणोतीत्यर्थे ‘अलीकादयश्च’ (द। उ। ३-४३) इति ईकन्प्रत्ययः। ‘वलीकनीध्रे पटलप्रान्ते’ इत्यमरः।]]</li> <li id="foot_krm_1581_11"><a href="#ref_krm_1581_11">↑</a> [[४। वलाकाया अपत्यमित्यर्थे ‘बाह्वादिभ्यश्च’ (४-१-९६) इतीञ्प्रत्यये रूपम्।]]</li> <li id="foot_krm_1581_12"><a href="#ref_krm_1581_12">↑</a> [[५। ‘अलीकादयश्च’ (द। उ। ३-४३) इत्यत्र ईकनन्तो निपातितः। मुमागमोऽपि निपातनादेव। ‘वामलूरुश्च नाकुश्च वल्मीकं पुन्नपुंसकम्’ इत्यमरः। वल्मीके भवः इत्यर्थे अण्प्रत्यये इञि च वाल्मीकिः = आदिकविः श्रीमद्रामायणस्य कर्ता।]]</li> <li id="foot_krm_1581_13"><a href="#ref_krm_1581_13">↑</a> [[६। ‘शुकवल्कोल्काः’ (द। उ। ३-२०) इति कप्रत्यये निपातितः। वल्कः = वासः, तरुत्वक् च।]]</li> <li id="foot_krm_1581_14"><a href="#ref_krm_1581_14">↑</a> [[७। ‘वलाकादयश्च’ (द। उ। ३-३२) इत्याकप्रत्यये, टापि च रूपमेवम्। वलाका = पक्षिजातिः। वलाका अस्य सन्तीति ‘व्रीह्यादिभ्यश्च’ (५-२-११६) इति मत्वर्थे इनिः।]]</li> <li id="foot_krm_1581_15"><a href="#ref_krm_1581_15">↑</a> [[८। ‘वलूकः’ [व्यलूकः]</li> <li id="foot_krm_1581_16"><a href="#ref_krm_1581_16">↑</a> (द। उ। ३-४५)</li> <li id="foot_krm_1581_17"><a href="#ref_krm_1581_17">↑</a> [[९। ‘वलिमलितनिभ्यः कयन्’ (द। उ। ८-१०) इति कयन्प्रत्यये रूपमेवम्। वलयम् = आभरणविशेषः। ‘कटकं वलये सानौ’ इत्यमरः।]]</li></ul></p>

वल्क|वल्ककः-ल्किका|विवल्कयिषकः-षिका|वल्कयिता-त्री|विवल्कयिषिता-त्री
<ul><li><sup id="ref_krm_1582_01"><a href="#foot_krm_1582_01">1</a></sup> {@“वल्क परिभाषणे”@} <sup id="ref_krm_1582_02"><a href="#foot_krm_1582_02">2</a></sup> ‘श्वल्क’ इति मैत्रेयादयः। </li> <li>‘-- भाषणे’ इति चन्द्रजैनकाश- कृत्स्नकातन्त्रादयः। </li> <li>वल्ककः-ल्किका, विवल्कयिषकः-षिका;</li> <li>  वल्कयिता-त्री, विवल्कयिषिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि चौरादिकचर्चयतिवत् <sup id="ref_krm_1582_03"><a href="#foot_krm_1582_03">3</a></sup> बोध्यानि। </li> <li>निष्ठायां वल्कितं-तः-तवान् इति। </li> <li><sup id="ref_krm_1582_04"><a href="#foot_krm_1582_04">4</a></sup> वल्कलम् = वृक्षत्वक्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1582_01"><a href="#ref_krm_1582_01">↑</a> (१५६९)</li> <li id="foot_krm_1582_02"><a href="#ref_krm_1582_02">↑</a> (१०-चुरादिः-१५७१। सक। सेट्। उभ।)</li> <li id="foot_krm_1582_03"><a href="#ref_krm_1582_03">↑</a> (५०७)</li> <li id="foot_krm_1582_04"><a href="#ref_krm_1582_04">↑</a> [[आ। ‘… वल्कलेनापि तन्वी किमिव हि मधुराणां मण्डनं नाकृतीनाम्।’ शाकुन्तले-१-२०]]</li></ul></p>

वल्क
<ul><li><sup id="ref_krm_1583_01"><a href="#foot_krm_1583_01">1</a></sup> {@“वल्क दर्शने”@} <sup id="ref_krm_1583_02"><a href="#foot_krm_1583_02">2</a></sup> सर्वाण्यपि रूपाणि चर्चयतिवत् <sup id="ref_krm_1583_03"><a href="#foot_krm_1583_03">3</a></sup> ऊह्यानि। </li> <li>क्षीरस्वामिमाधवादयः न पठन्ति। </li> <li><sup id="ref_krm_1583_04"><a href="#foot_krm_1583_04">4</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1583_01"><a href="#ref_krm_1583_01">↑</a> (१५६९-आ)</li> <li id="foot_krm_1583_02"><a href="#ref_krm_1583_02">↑</a> (१०-चुरादिः-१९१६। सक। सेट्। उभ।)</li> <li id="foot_krm_1583_03"><a href="#ref_krm_1583_03">↑</a> (५०७)</li> <li id="foot_krm_1583_04"><a href="#ref_krm_1583_04">↑</a> [पृष्ठम्१२०८+ २६]</li></ul></p>

वल्ग|वल्गकः-ल्गिका|विवल्गिषकः-षिका|वावल्गकः-ल्गिका|वल्गिता-त्री|वल्गयिता-त्री|विवल्गिषिता-त्री|वावल्गिता-त्री
<ul><li><sup id="ref_krm_1584_01"><a href="#foot_krm_1584_01">1</a></sup> {@“वल्ग गत्यर्थः”@} <sup id="ref_krm_1584_02"><a href="#foot_krm_1584_02">2</a></sup> ‘वल्गि--’ इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>‘-- प्लुतगतौ’ इति भट्टमल्लः। </li> <li>वल्गकः-ल्गिका, वल्गकः-ल्गिका, विवल्गिषकः-षिका, वावल्गकः-ल्गिका;</li> <li>  वल्गिता-त्री, वल्गयिता-त्री, विवल्गिषिता-त्री, वावल्गिता-त्री;</li> <li>  वल्गन्-न्ती, इत्यादिकानि रूपाणि सर्वाण्यपि भौवादिकगल्भतिवत् <sup id="ref_krm_1584_03"><a href="#foot_krm_1584_03">3</a></sup> ऊह्यानि। </li> <li>ल्युटि- <sup id="ref_krm_1584_04"><a href="#foot_krm_1584_04">4</a></sup> वल्गनम्, निष्ठायाम्-वल्गितः <sup id="ref_krm_1584_05"><a href="#foot_krm_1584_05">5</a></sup> इति विशेषः। </li> <li><sup id="ref_krm_1584_06"><a href="#foot_krm_1584_06">6</a></sup> वल्गुः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1584_01"><a href="#ref_krm_1584_01">↑</a> (१५७०)</li> <li id="foot_krm_1584_02"><a href="#ref_krm_1584_02">↑</a> (१-भ्वादिः-१४३। सक। सेट्। पर।)</li> <li id="foot_krm_1584_03"><a href="#ref_krm_1584_03">↑</a> (३८९)</li> <li id="foot_krm_1584_04"><a href="#ref_krm_1584_04">↑</a> [[आ। ‘एखच्चकोरोत्करमिङ्खितं शुकैः प्रेङ्खल्लतावल्गनरङ्गमण्डपम्।’ धा। का। १-२०।]]</li> <li id="foot_krm_1584_05"><a href="#ref_krm_1584_05">↑</a> [[B। ‘विलोलतां चक्षुषि हस्तवेपथुं भ्रुवोर्विभङ्गं स्तनयुग्मवल्गितम्।’ भ। का। ११-३७।]]</li> <li id="foot_krm_1584_06"><a href="#ref_krm_1584_06">↑</a> [[१। औणादिके (द। उ। १-१०४) उप्रत्यये रूपमेवम्। वल्गुः = सरसं, दर्शनीयं च।]]</li></ul></p>

वल्भ|वल्भकः-ल्भिका|विवल्भिषकः-षिका|वावल्भकः|ल्भिका|वल्भिता-त्री|वल्भयिता-त्री|विवल्भिषिता-त्री|वावल्भिता-त्री
<ul><li><sup id="ref_krm_1585_01"><a href="#foot_krm_1585_01">1</a></sup> {@“वल्भ भोजने”@} <sup id="ref_krm_1585_02"><a href="#foot_krm_1585_02">2</a></sup> वल्भकः-ल्भिका, वल्भकः-ल्भिका, विवल्भिषकः-षिका, वावल्भकः ल्भिका;</li> <li>  वल्भिता-त्री, वल्भयिता-त्री, विवल्भिषिता-त्री, वावल्भिता-त्री;</li> <li>  इत्यादिकानि रूपाणि सर्वाण्यपि धार्ष्ट्यार्थकभौवादिकगल्भतिवत् <sup id="ref_krm_1585_03"><a href="#foot_krm_1585_03">3</a></sup> ऊह्यानि। </li> <li>णिनिप्रत्यये-प्रवल्भी, युचि-वल्भनः, इति विशेषः। </li> <li>ण्यन्तात् शतरि- <sup id="ref_krm_1585_04"><a href="#foot_krm_1585_04">4</a></sup> वल्भयन्- न्ती, इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1585_01"><a href="#ref_krm_1585_01">↑</a> (१५७१)</li> <li id="foot_krm_1585_02"><a href="#ref_krm_1585_02">↑</a> (१-भ्वादिः-३९१। सक। सेट्। आत्म।)</li> <li id="foot_krm_1585_03"><a href="#ref_krm_1585_03">↑</a> (३८९)</li> <li id="foot_krm_1585_04"><a href="#ref_krm_1585_04">↑</a> [[२। निगरणार्थत्वेन णिजन्तात् ‘निगरणचलनार्थेभ्यश्च’ (१-३-८७) इति नित्यं परस्मैपदम्।]]</li></ul></p>

वल्ल|वल्लकः-ल्लिका|विवल्लिषकः-षिका|वावल्लकः-ल्लिका|वल्लिता-त्री|वल्लयिता-त्री|विवल्लिषिता-त्री|वावल्लिता-त्री|-|वल्लयन्-न्ती|वल्लयिष्यन्-न्ती-ती|वल्लमानः|वल्लयमानः|विवल्लिषमाणः|वावल्ल्यमानः
<ul><li><sup id="ref_krm_1586_01"><a href="#foot_krm_1586_01">1</a></sup> {@“वल्ल संवरणे संचरणे च”@} <sup id="ref_krm_1586_02"><a href="#foot_krm_1586_02">2</a></sup> अमुं धातुं क्षीरस्वामी न पठति। </li> <li>‘-- चलने च’ इति कातन्त्रः। </li> <li>‘सौत्रोऽयं धातुः’ इति द। </li> <li>उ। </li> <li>वृत्त्याम् <sup id="ref_krm_1586_03"><a href="#foot_krm_1586_03">3</a></sup>। </li> <li>काशकृत्स्नीये ‘-- संवरणे’ इति पठित्वा इतः पूर्वं <sup id="ref_krm_1586_04"><a href="#foot_krm_1586_04">4</a></sup> ‘वल्ल निष्पत्तौ’ इत्यपि पृथक् धातुः पठितः। </li> <li>वल्लकः-ल्लिका, वल्लकः-ल्लिका, विवल्लिषकः-षिका, वावल्लकः-ल्लिका;</li> <li>  वल्लिता-त्री, वल्लयिता-त्री, विवल्लिषिता-त्री, वावल्लिता-त्री;</li> <li>  -- वल्लयन्-न्ती, वल्लयिष्यन्-न्ती-ती;</li> <li>  वल्लमानः, वल्लयमानः, विवल्लिषमाणः, वावल्ल्यमानः;</li> <li>  इत्यादिकानि सर्वाण्यपि रूपाणि प्रातिस्विकरूपाणि विना भौवादिककड्डतिवत् <sup id="ref_krm_1586_05"><a href="#foot_krm_1586_05">5</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1586_06"><a href="#foot_krm_1586_06">6</a></sup> <sup id="ref_krm_1586_07"><a href="#foot_krm_1586_07">7</a></sup> वल्लरी-वल्लरिः, <sup id="ref_krm_1586_08"><a href="#foot_krm_1586_08">8</a></sup> इति इन्प्रत्यये, हिरण्यभिन्नार्थे वलिरित्यादेशे च रूपमेवम्। </li> <li>वल्लति वल्ल्यते वा वलिः = त्वङ्मांससंकोचः। </li> <li>वल्लिः इत्यस्य तु हिरण्यशलाका इत्यर्थः। </li> <li>वल्ली इत्यत्र ‘कृदिकारात्--’ <sup id="ref_krm_1586_09"><a href="#foot_krm_1586_09">9</a></sup> इति ङीष्। </li> <li>‘सौत्रोऽयं धातुः’ इति द। </li> <li>उ। </li> <li>वृत्त्याम्।]] वलिः- <sup id="ref_krm_1586_10"><a href="#foot_krm_1586_10">10</a></sup> वल्लिः-वल्ली-लता, <sup id="ref_krm_1586_11"><a href="#foot_krm_1586_11">11</a></sup> इत्यभच्प्रत्यये रूपमेवम्। </li> <li>वल्लति वल्ल्यते वा वल्लभः = दयितः, प्राणप्रिय इति स्वामी। </li> <li>‘वल्लभो दयितेऽध्यक्षे सल्लक्षण- तुरङ्गमे’ इति विश्वः।]] वल्लभः <sup id="ref_krm_1586_12"><a href="#foot_krm_1586_12">12</a></sup> <sup id="ref_krm_1586_13"><a href="#foot_krm_1586_13">13</a></sup> वल्लकी, <sup id="ref_krm_1586_14"><a href="#foot_krm_1586_14">14</a></sup> वल्लवः वल्लूरः <sup id="ref_krm_1586_15"><a href="#foot_krm_1586_15">15</a></sup> इमानि रूपाण्यधिकानीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1586_01"><a href="#ref_krm_1586_01">↑</a> (१५७२)</li> <li id="foot_krm_1586_02"><a href="#ref_krm_1586_02">↑</a> (१-भ्वादिः-४९२। सक। सेट्। आत्म।)</li> <li id="foot_krm_1586_03"><a href="#ref_krm_1586_03">↑</a> (१-५२)</li> <li id="foot_krm_1586_04"><a href="#ref_krm_1586_04">↑</a> (भ्वादौ)</li> <li id="foot_krm_1586_05"><a href="#ref_krm_1586_05">↑</a> (१५६)</li> <li id="foot_krm_1586_06"><a href="#ref_krm_1586_06">↑</a> [पृष्ठम्१२०९+ २९]</li> <li id="foot_krm_1586_07"><a href="#ref_krm_1586_07">↑</a> [[१। बाहुलकाद् अरप्रत्यये पिप्पल्यादित्वात् (ग। सू। ४-१-४१) ङीष्प्रत्यये च रूपम्।]]</li> <li id="foot_krm_1586_08"><a href="#ref_krm_1586_08">↑</a> [[२। ‘वल्लेर्वलिरहिरण्ये’ [द। उ। १-५२]</li> <li id="foot_krm_1586_09"><a href="#ref_krm_1586_09">↑</a> (वा। ४-१-४५)</li> <li id="foot_krm_1586_10"><a href="#ref_krm_1586_10">↑</a> [[आ। ‘विहङ्गराजाङ्गरुहैरिवायतैर्हिरण्मयोर्वीरुदृवल्लितन्तुभिः।’ शि। व। १-७]]</li> <li id="foot_krm_1586_11"><a href="#ref_krm_1586_11">↑</a> [[३। ‘रासिवल्लिभ्यां च’ [द। उ। ७-२१]</li> <li id="foot_krm_1586_12"><a href="#ref_krm_1586_12">↑</a> [[B। ‘रात्रिर्यामत्रयपरिमिता वल्लभास्ते सहस्रं…’। प्रतापरुद्रीयेम् नायकप्रकरणे--श्लो। ५०।]]</li> <li id="foot_krm_1586_13"><a href="#ref_krm_1586_13">↑</a> [[४। औणादिके (द। उ। ३-५) क्वुन्प्रत्यये गौरादित्वाद् ङीषि च रूपमेवम्। ‘… वीणा तु वल्लकी’ इत्यमरः।]]</li> <li id="foot_krm_1586_14"><a href="#ref_krm_1586_14">↑</a> [[५। औणादिके (द। उ। ८-१३२) वन्प्रत्यये रूपमेवम्। वल्लवः = गोधुक्।]]</li> <li id="foot_krm_1586_15"><a href="#ref_krm_1586_15">↑</a> [[६। ‘खर्जिपिञ्जादिभ्य ऊरोलचौ’ (द। उ। १०-१०) इति ऊरप्रत्यये रूपमेवम्। वल्लूरः = शुष्कमांसम् इत्यर्थः। ‘उत्तप्तं शुष्कमांसं स्यात्तद्वल्लूरं त्रिलिङ्गकम्’ इत्यमरः।]]</li></ul></p>

वल्ह|वल्हकः-ल्हिका|विवल्हिषकः-षिका|वावल्हकः-ल्हिका|वल्हिता-त्री|वल्हयिता-त्री|विवल्हिषिता-त्री|वावल्हिता-त्री
<ul><li><sup id="ref_krm_1587_01"><a href="#foot_krm_1587_01">1</a></sup> {@“वल्ह परिभाषणहिंसाच्छादनेषु”@} <sup id="ref_krm_1587_02"><a href="#foot_krm_1587_02">2</a></sup> ‘केचित्तु ओष्ठ्यादिः इत्याहुः’ इति सि। </li> <li>कौमुद्याम्। </li> <li>‘-- परिभाषणहिंसा- दानेषु’ इति, दन्त्यौष्ठ्यादिः, ‘अत्र धनपालमैत्रेयौ परिभाषणादावोष्ठ्या- दित्वम्, वृद्धौ दन्त्यौष्ठ्यादित्वं चाहतुः’ इति च माधवः। </li> <li>‘बल्ह प्राधान्ये’ इति तरङ्गिण्याम्। </li> <li>पाणिनीयधातुपाठममीक्षायाम्-- ‘वल्ह प्राधान्ये’ इति मैत्रैयकातन्त्रशाकटायनहेमादयः पठन्ति। </li> <li>‘-- श्रैष्ठ्ये’ इति वोपदेवः’ इत्युक्तम्। </li> <li>“-- दाने च’ इति द्रुमे। </li> <li>परिभाषणमत्र वञ्चनवादः।” इति धा। </li> <li>का। </li> <li>व्याख्यायाम् <sup id="ref_krm_1587_03"><a href="#foot_krm_1587_03">3</a></sup>। </li> <li>वल्हकः-ल्हिका, वल्हकः-ल्हिका, विवल्हिषकः-षिका, वावल्हकः-ल्हिका;</li> <li>  वल्हिता-त्री, वल्हयिता-त्री, विवल्हिषिता-त्री, वावल्हिता-त्री;</li> <li>  <sup id="ref_krm_1587_04"><a href="#foot_krm_1587_04">4</a></sup> इत्यादिकानि रूपाणि सर्वाण्यपि भौवादिकगर्हतिवत् <sup id="ref_krm_1587_05"><a href="#foot_krm_1587_05">5</a></sup> ज्ञेयानि। </li> <li>ल्यपि- प्रवल्ह्य।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1587_01"><a href="#ref_krm_1587_01">↑</a> (१५७३)</li> <li id="foot_krm_1587_02"><a href="#ref_krm_1587_02">↑</a> (१-भ्वादिः-६४१। सक। सेट्। आत्म।)</li> <li id="foot_krm_1587_03"><a href="#ref_krm_1587_03">↑</a> (१-८१)</li> <li id="foot_krm_1587_04"><a href="#ref_krm_1587_04">↑</a> [पृष्ठम्१२१०+ २७]</li> <li id="foot_krm_1587_05"><a href="#ref_krm_1587_05">↑</a> (३८५)</li></ul></p>

वश|वाशकः-शिका|विवशिषकः-षिका|वावशकः-शिका|वशिता-त्री|वाशयिता-त्री|विवशिषिता-त्री|वावशिता-त्री|उशन्-न्ती|वाशयन्-न्ती|विवशिषन्-न्ती|-|वशिष्यन्-न्ती-ती|वाशयिष्यन्-न्ती-ती|विवशिषिष्यन्-न्ती-ती|वाशयमानः|वाशयिष्यमाणः|वावश्यमानः|वावशिष्यमाणः|उट्-उशौ-उशः|उशितम्-तः-तवान्|वाशितम्-तः|विवशिषितः|वावशितः-तवान्|वशः|वशा|गोवशा|वशी|वाशः|वाशनः|विवशिषुः|वावशः|वशितव्यम्|वाशयितव्यम्|विवशिषितव्यम्|वावशितव्यम्|वशनीयम्|वाशनीयम्|विवशिषणीयम्|वावशनीयम्|वश्यम्|वाश्यम्|विवशिष्यम्|वावश्यम्|ईषद्वशः-दुर्वशः-सुवशः|उश्यमानः|वाश्यमानः|विवशिष्यमाणः|विवशिषः|वशितुम्|वाशयितुम्|विवशिषितुम्|वावशितुम्|उष्टिः|वाशना|विवशिषा|वावशा|वशनम्|वाशनम्|विवशिषणम्|वावशनम्|वशित्वा|वाशयित्वा|विवशिषित्वा|वावशित्वा|प्रोश्य|प्रवाश्य|प्रविवशिष्य|प्रवावश्य|वाशम्वशित्वावाशम्वाशयित्वाविवशिषम्विवशिषित्वावावशम्
<ul><li><sup id="ref_krm_1588_01"><a href="#foot_krm_1588_01">1</a></sup> {@“वश कान्तौ”@} <sup id="ref_krm_1588_02"><a href="#foot_krm_1588_02">2</a></sup> ग्रह्यादिः। </li> <li>कान्तिः = इच्छा इति क्षीरस्वामी। </li> <li>वाशकः-शिका, वाशकः-शिका, विवशिषकः-षिका, <sup id="ref_krm_1588_03"><a href="#foot_krm_1588_03">3</a></sup> वावशकः-शिका;</li> <li>  वशिता-त्री, वाशयिता-त्री, विवशिषिता-त्री;</li> <li>  वावशिता-त्री;</li> <li>  <sup id="ref_krm_1588_04"><a href="#foot_krm_1588_04">4</a></sup> उशन्-न्ती, वाशयन्-न्ती, विवशिषन्-न्ती;</li> <li>  -- वशिष्यन्-न्ती-ती, वाशयिष्यन्-न्ती-ती, विवशिषिष्यन्-न्ती-ती;</li> <li>  -- -- वाशयमानः, वाशयिष्यमाणः, -- वावश्यमानः, वावशिष्यमाणः;</li> <li>  उट्-उशौ-उशः;</li> <li>  -- -- उशितम्-तः-तवान्, वाशितम्-तः, विवशिषितः, वावशितः-तवान्;</li> <li>  वशः, <sup id="ref_krm_1588_05"><a href="#foot_krm_1588_05">5</a></sup> वशा, <sup id="ref_krm_1588_06"><a href="#foot_krm_1588_06">6</a></sup> गोवशा, वशी, वाशः, <sup id="ref_krm_1588_07"><a href="#foot_krm_1588_07">7</a></sup> वाशनः, <sup id="ref_krm_1588_08"><a href="#foot_krm_1588_08">8</a></sup> विवशिषुः, वावशः;</li> <li>  वशितव्यम्, वाशयितव्यम्, विवशिषितव्यम्, वावशितव्यम्;</li> <li>  वशनीयम्, वाशनीयम्, विवशिषणीयम्, वावशनीयम्;</li> <li>  वश्यम्, वाश्यम्, विवशिष्यम्, वावश्यम्;</li> <li>  ईषद्वशः-दुर्वशः-सुवशः;</li> <li>  -- -- उश्यमानः, वाश्यमानः, विवशिष्यमाणः, वावश्यमानः;</li> <li>  <sup id="ref_krm_1588_09"><a href="#foot_krm_1588_09">9</a></sup> वशः, वाशः, विवशिषः, वावशः;</li> <li>  वशितुम्, वाशयितुम्, विवशिषितुम्, वावशितुम्;</li> <li>  <sup id="ref_krm_1588_10"><a href="#foot_krm_1588_10">10</a></sup> उष्टिः, वाशना, विवशिषा, वावशा;</li> <li>  वशनम्, वाशनम्, विवशिषणम्, वावशनम्;</li> <li>  <sup id="ref_krm_1588_11"><a href="#foot_krm_1588_11">11</a></sup> वशित्वा, वाशयित्वा, विवशिषित्वा, वावशित्वा;</li> <li>  प्रोश्य, प्रवाश्य, प्रविवशिष्य, प्रवावश्य;</li> <li>  वाशम् २ वशित्वा २ वाशम् २ वाशयित्वा २ विवशिषम् २ विवशिषित्वा २ वावशम् २;</li> <li>  वावशित्वा २;</li> <li>  <sup id="ref_krm_1588_12"><a href="#foot_krm_1588_12">12</a></sup> उशिक्, <sup id="ref_krm_1588_13"><a href="#foot_krm_1588_13">13</a></sup> ईरन्प्रत्यये, कित्त्वात् संप्रसारणे च रूपमेवम्। </li> <li>उश्यते तदिति उशीरम् = गन्धद्रव्यम्। </li> <li>उशीनरम् इति तु देशविशेषवाचकं शब्दान्तरम्।]] उशीरम्, <sup id="ref_krm_1588_14"><a href="#foot_krm_1588_14">14</a></sup> उशनाः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1588_01"><a href="#ref_krm_1588_01">↑</a> (१५७४)</li> <li id="foot_krm_1588_02"><a href="#ref_krm_1588_02">↑</a> (२-अदादिः-१०८०। सक। सेट्। पर।)</li> <li id="foot_krm_1588_03"><a href="#ref_krm_1588_03">↑</a> [[१। ‘न वशः’ (६-१-२०) इति यङि परतः वशेः संप्रसारणं न भवति।]]</li> <li id="foot_krm_1588_04"><a href="#ref_krm_1588_04">↑</a> [[२। शतरि, ‘ग्रहिज्यावयिव्यधिवष्टिविचति--’ (६-१-१६) इति किति ङिति च प्रत्यये परतः संप्रसारणं भवति। तेनैवं रूपम्। एवं क्विप्-निष्ठा-क्तिनादिषु च ज्ञेयम्।]]</li> <li id="foot_krm_1588_05"><a href="#ref_krm_1588_05">↑</a> [[३। पचाद्यचि, तदन्तात् टापि च रूपमेवम्। वशा = मांसम्।]]</li> <li id="foot_krm_1588_06"><a href="#ref_krm_1588_06">↑</a> [[४। अत्र ‘पोटायुवतिस्तोककतिपयगृष्टिधेनुवशा--’ (२-१-६५) इत्यादिना तत्पुरुष- समासः। गोवशा = बन्ध्या गौरित्यर्थः।]]</li> <li id="foot_krm_1588_07"><a href="#ref_krm_1588_07">↑</a> [[५। ण्यन्तात्, ‘नन्दिवाशि--’ (वा। ३-१-१३४) इत्यादिना संज्ञायां ल्युप्रत्यये रूपमेवम्।]]</li> <li id="foot_krm_1588_08"><a href="#ref_krm_1588_08">↑</a> [[आ। ‘भृङ्गालीकोकिलक्रुङ्भिर्वाशनैः पश्य लक्ष्मण।’ भ। का। ६-७४।]]</li> <li id="foot_krm_1588_09"><a href="#ref_krm_1588_09">↑</a> [[६। ‘वशिरण्योरुपसंख्यानम्’ (वा। ३-३-५८) इति भावे घञपवादोऽप्प्रत्ययः।]]</li> <li id="foot_krm_1588_10"><a href="#ref_krm_1588_10">↑</a> [पृष्ठम्१२११+ २६]</li> <li id="foot_krm_1588_11"><a href="#ref_krm_1588_11">↑</a> [[१। क्त्वाप्रत्यये, ‘न क्त्वा सेट्’ (१-२-१८) इति कित्त्वनिषेधात् न संप्रसारणम्।]]</li> <li id="foot_krm_1588_12"><a href="#ref_krm_1588_12">↑</a> [[२। ‘वशेः कित्’ (द। उ। ४-९) इति धातोरिजिप्रत्यये कित्त्वात् संप्रसारणम्। वष्टि उश्यतेऽसौ श्रेयोऽर्थिभिरिति उशिक् = अग्न्यादिः।]]</li> <li id="foot_krm_1588_13"><a href="#ref_krm_1588_13">↑</a> [[३। औणादिके [द। उ। ८-७३]</li> <li id="foot_krm_1588_14"><a href="#ref_krm_1588_14">↑</a> [[४। ‘वशेः कनसिः’ (द। उ। ९-९९) इति कनसिप्रत्यये, कित्त्वात् ‘ग्रहिज्या--’ (६-१-१६) इत्यादिना सम्प्रसारणे रूपमेवम्। उशनाः = शुक्रः।]]</li></ul></p>

वष|वाषकः-षिका|विवषिषकः-षिका|वावषकः-षिका|वषिता-त्री|वाषयिता-त्री|विवषिषिता-त्री|वावषिता-त्री|ल्युटि-|वषणम्|क्विपि|वट्-वड्-वषौ-वषः
