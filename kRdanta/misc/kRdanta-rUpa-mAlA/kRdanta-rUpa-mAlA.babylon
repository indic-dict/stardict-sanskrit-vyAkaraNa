<ul><li id="foot_krm_0301_01"><a href="#ref_krm_0301_01">↑</a> (२९४)</li> <li id="foot_krm_0301_02"><a href="#ref_krm_0301_02">↑</a> (१-भ्वादिः-८४६। सक। सेट्। पर।)</li> <li id="foot_krm_0301_03"><a href="#ref_krm_0301_03">↑</a> [[२। धातोरस्य घटादिषु पाठ इति माधवीयधातुवृत्तावुक्तम्। तदानीं ‘क्वथकः--’ इत्यादि रूपम्। मित्त्वाद्ध्रस्वः। अन्ये तु घटादौ धातुममुं न पेठुः।]]</li> <li id="foot_krm_0301_04"><a href="#ref_krm_0301_04">↑</a> [[आ। ‘अहोलसत्त्वा रविरश्मिजालेऽप्यविक्वथन्ती तटपाथिपाथाः।’ धा। का। २-२३]]</li> <li id="foot_krm_0301_05"><a href="#ref_krm_0301_05">↑</a> [[३। ‘कर्तरि कर्मव्यतीहारे’ (१-३-१४) इति शानच्।]]</li> <li id="foot_krm_0301_06"><a href="#ref_krm_0301_06">↑</a> [[४। ‘वाऽवसाने’ (८-४-५६) इति चर्त्वं विकल्पेन।]]</li> <li id="foot_krm_0301_07"><a href="#ref_krm_0301_07">↑</a> [[५। ‘ज्वलितिकसन्तेभ्यो णः’ (३-१-१४०) इति कर्तरि णो वा। पक्षे अच्।]]</li> <li id="foot_krm_0301_08"><a href="#ref_krm_0301_08">↑</a> [पृष्ठम्०३०७+ २४]</li> <li id="foot_krm_0301_09"><a href="#ref_krm_0301_09">↑</a> [[१। ‘तितुत्र--’ (७-२-९) इत्यादिना इण्णिषेधः। चर्त्वम्। ‘तितुत्रेष्वग्रहादीनां--’ (वा। ७-२-९) इत्यङ्गीकृत्य केचित् ‘क्वथितिः’ इति रूपमाहुः।]]</li></ul></p>

