<ul><li><sup id="ref_krm_0617_01"><a href="#foot_krm_0617_01">1</a></sup> {@“जु गतौ वेगे च”@} <sup id="ref_krm_0617_02"><a href="#foot_krm_0617_02">2</a></sup> सौत्रोऽयं धातुः साक्षाद्धातुपाठेष्वपठितोऽपि, ‘जुचङ्क्रम्य--’ <sup id="ref_krm_0617_03"><a href="#foot_krm_0617_03">3</a></sup>, ‘प्रजोरिनिः’ <sup id="ref_krm_0617_04"><a href="#foot_krm_0617_04">4</a></sup>, ‘भ्राजभासधुर्विद्युतोर्जिपॄजुग्रावस्तुवः क्विप्’ <sup id="ref_krm_0617_05"><a href="#foot_krm_0617_05">5</a></sup> ‘ऊतियूतिजूतिसातिहेतिकीर्तयश्च’ <sup id="ref_krm_0617_06"><a href="#foot_krm_0617_06">6</a></sup> इत्यादिषु अनुवादबलाद् अभ्युपगम्यते। </li> <li>‘वेगितायां गतौ’ इति काशिकादिष्वर्थ- निर्देशस्योपलम्भात् तदनुसारेणास्माभिरप्यर्थोऽस्य निर्दिष्टः। </li> <li>क्षीरस्वामी तु ‘जुङ्’ इति ङितं पपाठ। </li> <li>वृत्तिन्यासपदमञ्जर्यादिषु अस्य धातोः सौत्रत्वमेवाङ्गीकृतम्। </li> <li>माधवधातुवृत्तौ तु परस्मैपदिष्वेव पाठोऽभ्युपगतः। </li> <li>जावकः-विका, जावकः-विका, <sup id="ref_krm_0617_07"><a href="#foot_krm_0617_07">7</a></sup> जिजावयिष्कः, <sup id="ref_krm_0617_08"><a href="#foot_krm_0617_08">8</a></sup> जुजूषकः-षिका, <sup id="ref_krm_0617_09"><a href="#foot_krm_0617_09">9</a></sup> जोजूयकः-यिका;</li> <li>  <sup id="ref_krm_0617_10"><a href="#foot_krm_0617_10">10</a></sup> जोता-त्री, जावयिता-त्री, जिजावयिषिता-त्री, जुजूषिता-त्री, जोजूयिता-त्री;</li> <li>  जवन्-न्ती, जावयन्-न्ती, जिजावयिषन्-न्ती, जुजूषन्-न्ती;</li> <li>  -- जोष्यन्, जावयिष्यन्-न्ती-ती, जिजावयिषिष्यन्-न्ती-ती, जुजूषिष्यन्-न्ती-ती;</li> <li>  <sup id="ref_krm_0617_11"><a href="#foot_krm_0617_11">11</a></sup> <sup id="ref_krm_0617_12"><a href="#foot_krm_0617_12">12</a></sup> जवमानः, जावयमानः, जिजावयिषमाणः, -- जोजूयमानः;</li> <li>  जोष्यमाणः, जावयिष्यमाणः, जिजावयिषिष्यमाणः, -- जोजूयिष्यमाणः;</li> <li>  <sup id="ref_krm_0617_13"><a href="#foot_krm_0617_13">13</a></sup> जूः-जुवौ-जुवः;</li> <li>  -- -- जुतम्-जुतः-जुतवान्, जावितः, जिजावयिषितः, जुजूषितः, जोजूयितः-तवान्;</li> <li>  जवः, <sup id="ref_krm_0617_14"><a href="#foot_krm_0617_14">14</a></sup> जवनः, <sup id="ref_krm_0617_15"><a href="#foot_krm_0617_15">15</a></sup> <sup id="ref_krm_0617_16"><a href="#foot_krm_0617_16">16</a></sup> प्रजवी, <sup id="ref_krm_0617_17"><a href="#foot_krm_0617_17">17</a></sup> जावः, जिजावयिषुः, जुजूषुः, <sup id="ref_krm_0617_18"><a href="#foot_krm_0617_18">18</a></sup> जोजुवः;</li> <li>  जोतव्यम्, जावयितव्यम्, जिजावयिषितव्यम्, जुजूषितव्यम्, जोजूयितव्यम्;</li> <li>  जवनीयम्, जावनीयम्, जिजावयिषणीयम्, जुजूषणीयम्, जोजूयनीयम्;</li> <li>  <sup id="ref_krm_0617_19"><a href="#foot_krm_0617_19">19</a></sup> जव्यम्-अवश्यजाव्यम् <sup id="ref_krm_0617_20"><a href="#foot_krm_0617_20">20</a></sup>, जाव्यम्, जिजावयिष्यम्, जुजूष्यम्, जोजूय्यम्;</li> <li>  ईषज्जवः-दुर्जवः-सुजवः;</li> <li>  -- -- -- <sup id="ref_krm_0617_21"><a href="#foot_krm_0617_21">21</a></sup> जूयमानः, जाव्यमानः, जिजावयिष्यमाणः, जुजूष्यमाणः, जोजूय्यमानः;</li> <li>  <sup id="ref_krm_0617_22"><a href="#foot_krm_0617_22">22</a></sup> जवः, जावः, जिजावयिषः, जुजूषः, जोजूयः;</li> <li>  जोतुम्, जावयितुम्, जिजावयिषितुम्, जुजूषितुम्, जोजूयितुम्;</li> <li>  <sup id="ref_krm_0617_23"><a href="#foot_krm_0617_23">23</a></sup> जूतिः, <sup id="ref_krm_0617_24"><a href="#foot_krm_0617_24">24</a></sup> जावना, जिजावयिषा, जुजूषा, जोजूया;</li> <li>  <sup id="ref_krm_0617_25"><a href="#foot_krm_0617_25">25</a></sup> जवनम्, जावनम्, जिजावयिषणम्, जुजूषणम्, जोजूयनम्;</li> <li>  जुत्वा, जावयित्वा, जिजावयिषित्वा, जुजूषित्वा, जोजूयित्वा;</li> <li>  <sup id="ref_krm_0617_26"><a href="#foot_krm_0617_26">26</a></sup> प्रजुत्य, प्रजाव्य, प्रजिजावयिष्य, प्रजुजूष्य, प्रजोजूय्य;</li> <li>  जावम् २, जुत्वा २, जावम् २, जावयित्वा २, जिजावयिषम् २, जिजावयिषित्वा २, जुजूषम् २, जुजूषित्वा २, जोजूयम् २, जोजूयित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0617_01"><a href="#ref_krm_0617_01">↑</a> (६०७)</li> <li id="foot_krm_0617_02"><a href="#ref_krm_0617_02">↑</a> (१-भ्वादिः-अक। अनि। पर।)</li> <li id="foot_krm_0617_03"><a href="#ref_krm_0617_03">↑</a> (३-२-१५०)</li> <li id="foot_krm_0617_04"><a href="#ref_krm_0617_04">↑</a> (३-२-१५६)</li> <li id="foot_krm_0617_05"><a href="#ref_krm_0617_05">↑</a> (३-२-१७७)</li> <li id="foot_krm_0617_06"><a href="#ref_krm_0617_06">↑</a> (३-३-९७)</li> <li id="foot_krm_0617_07"><a href="#ref_krm_0617_07">↑</a> [[५। यद्यपि ण्यन्तात् सन्प्रत्यये रूपप्तदर्शनमस्माभिः न प्रतिज्ञातम्;\n\n  अथापि, ‘ओः पुयण्ज्यपरे’ (७-४-८०) इत्यनेनाभ्यासघटकोकारस्येत्त्वविधानसामर्थ्यात् तानि रूपाणि प्रकृते प्रदर्शितानि। एवं सर्वत्र ण्यन्तात् सनि अभ्यासे इकारो ज्ञेयः।]]</li> <li id="foot_krm_0617_08"><a href="#ref_krm_0617_08">↑</a> [[६। ‘इको झल्’ (१-२-९) इति सनः कित्त्वेन न गुणः। ‘अज्झनगमां सनि’ (६-४-१६) इति दीर्घः। षत्वम्। एवं सन्नन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0617_09"><a href="#ref_krm_0617_09">↑</a> [[७। अभ्यासस्य ‘गुणो यङ्लुकोः’ (७-४-८२) इति गुणे, ‘अकृत्सार्वधातुकयोः--’ (७-४-२५) इति दीर्घः। एवं यङन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0617_10"><a href="#ref_krm_0617_10">↑</a> [[८। ‘एकाच उपदेशेऽनुदात्तात्’ (७-२-१०) इतीण्णिषेधे गुणः। एवं तव्यदादिष्वपि ज्ञेयम्।]]</li> <li id="foot_krm_0617_11"><a href="#ref_krm_0617_11">↑</a> [पृष्ठम्०५७६+ २५]</li> <li id="foot_krm_0617_12"><a href="#ref_krm_0617_12">↑</a> [[१। क्षीरस्वामिमते धातोरस्य ङित्त्वात् ‘अनुदात्तङित आत्मनेपदम्’ (१-३-१२) इति शानच्।]]</li> <li id="foot_krm_0617_13"><a href="#ref_krm_0617_13">↑</a> [[२। ‘भ्राजभासधुर्विद्युतोर्जिपॄजुग्रावस्तुवः क्विप्’ (३-२-१७७) इति ताच्छीलिके क्विपि, ‘वचिप्रच्छ्यायस्तुकटप्रुजुश्रीणां दीर्घोऽसम्प्रसारणं च’ (वा। ३-२-१७८) इति वचनाद् दीर्घः। जूः = पिशाचः।]]</li> <li id="foot_krm_0617_14"><a href="#ref_krm_0617_14">↑</a> [[३। ‘जुचङ्क्रम्यदन्द्रम्य--’ (३-२-१५०) इति ताच्छीलिको युच्। अनादेशः।]]</li> <li id="foot_krm_0617_15"><a href="#ref_krm_0617_15">↑</a> [[आ। ‘विविधकामहिता महिताम्भसः स्फुटसरोजवना जवना नदीः।।’ किरातार्जुनीये ५। ७।]]</li> <li id="foot_krm_0617_16"><a href="#ref_krm_0617_16">↑</a> [[४। ‘प्रजोरिनिः’ (३-२-१५६) इति तच्छीलादिषुकर्तृषु इनिप्रत्ययः।]]</li> <li id="foot_krm_0617_17"><a href="#ref_krm_0617_17">↑</a> [[B। ‘जल्पाकीभिः सहासीनः स्त्रीभिः प्रजविना त्वया।’ भ। का। ७। १९।]]</li> <li id="foot_krm_0617_18"><a href="#ref_krm_0617_18">↑</a> [[५। यङन्तात् पचाद्यचि, यङो लुकि, ‘न धातुलोप--’ (१-१-४) इति गुणनिषेधे, ‘अचि श्नुधातु--’ (६-४-७७) इत्युवङ्।]]</li> <li id="foot_krm_0617_19"><a href="#ref_krm_0617_19">↑</a> [[६। ‘अचो यत्’ (३-१-९७) इति यति, गुणावादेशौ।]]</li> <li id="foot_krm_0617_20"><a href="#ref_krm_0617_20">↑</a> [[७। ‘ओरावश्यके’ (३-१-१२५) इति ण्यति, वृद्धिः आवादेशश्च।]]</li> <li id="foot_krm_0617_21"><a href="#ref_krm_0617_21">↑</a> [[८। ‘अकृत्सार्वधातुकयोः--’ (७-४-२५) इति दीर्घः।]]</li> <li id="foot_krm_0617_22"><a href="#ref_krm_0617_22">↑</a> [[९। ‘ॠदोरप्’ (३-३-५७) इति घञपवादः अप्प्रत्ययः।]]</li> <li id="foot_krm_0617_23"><a href="#ref_krm_0617_23">↑</a> [[१०। ‘ऊतियूतिजूतिसातिहेतिकीर्तयश्च’ (३-३-९७) इति सूत्रेण क्तिनि दीर्घो निपातितः।]]</li> <li id="foot_krm_0617_24"><a href="#ref_krm_0617_24">↑</a> [[C। ‘जूतिमिच्छथ चेत् तूर्णं कीर्ति वा पातुमात्मनः’ भ। का। ७। ६९।]]</li> <li id="foot_krm_0617_25"><a href="#ref_krm_0617_25">↑</a> [पृष्ठम्०५७७+ २२]</li> <li id="foot_krm_0617_26"><a href="#ref_krm_0617_26">↑</a> [[१। समासे क्त्वाप्रत्ययस्य ल्यबादेशे, ‘ह्रस्वस्य पिति कृति--’ (६-१-७१) इति तुक्।]]</li></ul></p>

जुगि|जुङ्गकः-ङ्गिका|जुजुङ्गिषकः-षिका|जोजुङ्गकः-ङ्गिका|जुङ्गिता-त्री|जुङ्गयिता-त्री|जुजुङ्गिषिता-त्री|जोजुङ्गिता-त्री
<ul><li><sup id="ref_krm_0618_01"><a href="#foot_krm_0618_01">1</a></sup> {@“जुगि वर्जने”@} <sup id="ref_krm_0618_02"><a href="#foot_krm_0618_02">2</a></sup> जुङ्गकः-ङ्गिका, जुङ्गकः-ङ्गिका, जुजुङ्गिषकः-षिका, जोजुङ्गकः-ङ्गिका;</li> <li>  जुङ्गिता-त्री, जुङ्गयिता-त्री, जुजुङ्गिषिता-त्री, जोजुङ्गिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककुठि <sup id="ref_krm_0618_03"><a href="#foot_krm_0618_03">3</a></sup> धातुवत् ज्ञेयानि। </li> <li>विजुङ्ग्य <sup id="ref_krm_0618_04"><a href="#foot_krm_0618_04">4</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0618_01"><a href="#ref_krm_0618_01">↑</a> (६०८)</li> <li id="foot_krm_0618_02"><a href="#ref_krm_0618_02">↑</a> (१-भ्वादिः-१५७। सक। सेट्। पर।)</li> <li id="foot_krm_0618_03"><a href="#ref_krm_0618_03">↑</a> (२०९)</li> <li id="foot_krm_0618_04"><a href="#ref_krm_0618_04">↑</a> [[आ। ‘विजुङ्ग्य बुङ्ग्यं गुणसङ्गदङ्घका अलङ्घितानन्दरसात्तघर्घनाः।’ धा। का। १। २२।]]</li></ul></p>

