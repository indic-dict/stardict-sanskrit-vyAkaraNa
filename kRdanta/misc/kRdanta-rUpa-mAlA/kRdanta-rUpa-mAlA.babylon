<ul><li><sup id="ref_krm_0541_01"><a href="#foot_krm_0541_01">1</a></sup> {@“चीव भाषार्थः”@} <sup id="ref_krm_0541_02"><a href="#foot_krm_0541_02">2</a></sup> <sup id="ref_krm_0541_03"><a href="#foot_krm_0541_03">3</a></sup> अस्य धातोरास्वदीयत्वेन, ‘आ स्वदः सकर्मकात्’ <sup id="ref_krm_0541_04"><a href="#foot_krm_0541_04">4</a></sup> इति वचनात्, कर्मसंज्ञकार्थान्वय्यर्थबोधकत्व एव णिज् भवति। </li> <li>अकर्मकत्वे तु नेति बोद्धव्यम्।]] चीवकः-विका, चिचीवयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिककीटयतिवत् <sup id="ref_krm_0541_05"><a href="#foot_krm_0541_05">5</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0541_06"><a href="#foot_krm_0541_06">6</a></sup> चीवनम्,। </li> <li>क्विपि, <sup id="ref_krm_0541_07"><a href="#foot_krm_0541_07">7</a></sup> च्यूः-च्युवौ- च्युवः;</li> <li>  इति रूपाणि। </li> <li><sup id="ref_krm_0541_08"><a href="#foot_krm_0541_08">8</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0541_01"><a href="#ref_krm_0541_01">↑</a> (५३१)</li> <li id="foot_krm_0541_02"><a href="#ref_krm_0541_02">↑</a> (१०-चुरादिः-१७७५। सक। सेट्। उभ। आस्वदीयः)</li> <li id="foot_krm_0541_03"><a href="#ref_krm_0541_03">↑</a> [[[अ]</li> <li id="foot_krm_0541_04"><a href="#ref_krm_0541_04">↑</a> (ग। सू। चुरादौ)</li> <li id="foot_krm_0541_05"><a href="#ref_krm_0541_05">↑</a> (१९४)</li> <li id="foot_krm_0541_06"><a href="#ref_krm_0541_06">↑</a> [[B। ‘नाहं बर्हयताऽस्म्यबल्ह्यमपि भोः सर्वैरिदं गोप्यते तांस्त्वं धूपय विच्छयन् क इव न त्वच्चीवनात् पोथयेत्।।’ धा। का। ३। ४४।]]</li> <li id="foot_krm_0541_07"><a href="#ref_krm_0541_07">↑</a> [[३। क्विपि, णिलोपे, ‘च्छ्वोः शूडनुनासिके च’ (६-४-१९) इति वकारस्य ऊठि, यणि रूपम्।]]</li> <li id="foot_krm_0541_08"><a href="#ref_krm_0541_08">↑</a> [पृष्ठम्०५१७+ ३३]</li></ul></p>

चीवृ|चीवकः-विका|चिचीविषकः-षिका|चेचीवकः-विका|अस्य|धातोरुभयपदीत्वेन|शतरि|चीवन्-न्ती|चीवयन्-न्ती|चिचीविषन्-न्ती|चीविष्यन्-न्ती-ती|चीवयिष्यन्-न्ती-ती|चिचीविषिष्यन्-|न्ती-ती|क्विपि|इत्यूठि|यणादेशे|च्यूः-च्युवौ-च्युवः
<ul><li><sup id="ref_krm_0542_01"><a href="#foot_krm_0542_01">1</a></sup> {@“चीवृ आदानसंवरणयोः”@} <sup id="ref_krm_0542_02"><a href="#foot_krm_0542_02">2</a></sup> चीवकः-विका, चीवकः-विका, चिचीविषकः-षिका, चेचीवकः-विका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि कत्थनार्थकभौवादिकचीभतिवत् <sup id="ref_krm_0542_03"><a href="#foot_krm_0542_03">3</a></sup> बोध्यानि। </li> <li>अस्य धातोरुभयपदीत्वेन शतरि चीवन्-न्ती, चीवयन्-न्ती, चिचीविषन्-न्ती;</li> <li>  चीविष्यन्-न्ती-ती, चीवयिष्यन्-न्ती-ती, चिचीविषिष्यन्- न्ती-ती;</li> <li>  इति रूपाण्यधिकानि। </li> <li>क्विपि, ‘च्छ्वोः शूडनुनासिके च’ <sup id="ref_krm_0542_04"><a href="#foot_krm_0542_04">4</a></sup> इत्यूठि, यणादेशे च्यूः-च्युवौ-च्युवः;</li> <li>  इति रूपाणि। </li> <li>‘छित्वर--’ <sup id="ref_krm_0542_05"><a href="#foot_krm_0542_05">5</a></sup> इत्यादिना वरचि प्रत्यये, ‘लोपो व्योर्वलि’ <sup id="ref_krm_0542_06"><a href="#foot_krm_0542_06">6</a></sup> इति धातुवकारस्य लोपे, ‘नेड् वशि कृति’ <sup id="ref_krm_0542_07"><a href="#foot_krm_0542_07">7</a></sup> इति इण्णिषेधे च चीवरम् इति भवति। </li> <li><sup id="ref_krm_0542_08"><a href="#foot_krm_0542_08">8</a></sup> चीवरम् = मुनीनां वसनम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0542_01"><a href="#ref_krm_0542_01">↑</a> (५३२)</li> <li id="foot_krm_0542_02"><a href="#ref_krm_0542_02">↑</a> (१-भ्वादिः-८७९। सक। सेट्। उभ।)</li> <li id="foot_krm_0542_03"><a href="#ref_krm_0542_03">↑</a> (५३०)</li> <li id="foot_krm_0542_04"><a href="#ref_krm_0542_04">↑</a> (६-४-१९)</li> <li id="foot_krm_0542_05"><a href="#ref_krm_0542_05">↑</a> [द। उ। ८-४९]</li> <li id="foot_krm_0542_06"><a href="#ref_krm_0542_06">↑</a> (६-१-६६)</li> <li id="foot_krm_0542_07"><a href="#ref_krm_0542_07">↑</a> (७-२-८)</li> <li id="foot_krm_0542_08"><a href="#ref_krm_0542_08">↑</a> [[आ। ‘प्रवुन्द्यवेणीजववेनमाना खातान्तिका चीवरिभिर्निषादैः।’ धा। का। २। २७।]]</li></ul></p>

चुक्कं|चुक्ककः-क्किका|चुचुक्कयिषकः-षिका
<ul><li><sup id="ref_krm_0543_01"><a href="#foot_krm_0543_01">1</a></sup> {@“चुक्कं व्यथने”@} <sup id="ref_krm_0543_02"><a href="#foot_krm_0543_02">2</a></sup> चुक्ककः-क्किका, चुचुक्कयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिककुट्टयतिवत् <sup id="ref_krm_0543_03"><a href="#foot_krm_0543_03">3</a></sup> बोध्यानि। </li> <li>ल्युटि <sup id="ref_krm_0543_04"><a href="#foot_krm_0543_04">4</a></sup> चुक्कनम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0543_01"><a href="#ref_krm_0543_01">↑</a> (५३३)</li> <li id="foot_krm_0543_02"><a href="#ref_krm_0543_02">↑</a> (१०-चुरादिः-१५९६। अक। सेट्। उभ।)</li> <li id="foot_krm_0543_03"><a href="#ref_krm_0543_03">↑</a> (२०७)</li> <li id="foot_krm_0543_04"><a href="#ref_krm_0543_04">↑</a> [[B। ‘दुर्दान्तचक् पशुपचुक्कनमप्यरौत्सीत् प्रक्षालितक्षितितलातुलवर्षरोधी।’ धा। का। ३। २१।]]</li></ul></p>

चुच्य|इति|घातोः|पाठभेदोऽयम्|चुच्यकः-च्यिका|चुचुच्यिषकः-षिका|चोचुच्यकः-च्यिका|चुच्यिता-त्री|चुच्ययिता-त्री|चुचुच्यिषिता-त्री|चोचुच्यिता-त्री|चुच्यन्-न्ती|चुच्ययन्-न्ती|चुचुच्यिषन्-न्ती|-|चुच्यिष्यन्-न्ती-ती|चुच्ययिष्यन्-न्ती-ती|चुचुच्यिषिष्यन्-न्ती-ती|चुच्यमानः|चुच्ययिष्यमाणः|चोचुच्य्यमानः|चोचुच्यिष्यमाणः|सुचुक्-सुचुच्यौ-सुचुच्यः|-चुच्यितम्-तः|चुच्यितः|चुचुच्यिषितः|चोचुच्यितः-तवान्|चुच्यः|चुचुच्यिषुः|चोचुच्यः|चुच्यितव्यम्|चुच्ययितव्यम्|चुचुच्यिषितव्यम्|चोचुच्यितव्यम्|चुच्यनीयम्|चुचुच्यिषणीयम्|चोचुच्यनीयम्|चुच्य्यम्-चुच्यम्|चुच्यम्|चुचुच्यिष्यम्|चोचुच्य्यम्|ईषच्चुच्यः-दुश्चुच्यः-सुचुच्यः|चुच्य्यमानः-चुच्यमानः|चुचुच्यिष्यमाणः|चुचुच्यिषः|चुच्यितुम्|चुच्ययितुम्|चुचुच्यिषितुम्|चोचुच्यितुम्|चुच्या|चुच्यना|चुचुच्यिषा|चोचुच्या|चुच्यनम्|चुचुच्यिषणम्|चोचुच्यनम्|चुच्यित्वा|चुच्ययित्वा|चुचुच्यिषित्वा|चोचुच्यित्वा|प्रचुच्य्य-प्रचुच्य|प्रचुच्य|प्रचुचुच्यिष्य|प्रचोचुच्य|चिच्यम्चुच्यित्वाचुच्यम्चुच्ययित्वाचुच्यिषम्चोचुच्यम्
<ul><li><sup id="ref_krm_0544_01"><a href="#foot_krm_0544_01">1</a></sup> {@“चुच्य अभिषवे”@} <sup id="ref_krm_0544_02"><a href="#foot_krm_0544_02">2</a></sup> अभिषवः = अवयवानां शिथिलीकरणम्, सुरायाः सन्धानं वा। </li> <li>स्नानं च। </li> <li>‘शुच्य’ इति घातोः पाठभेदोऽयम्;</li> <li>  इति सिद्धान्तकौमुदी। </li> <li>चुच्यकः-च्यिका, चुच्यकः-च्यिका, चुचुच्यिषकः-षिका, <sup id="ref_krm_0544_03"><a href="#foot_krm_0544_03">3</a></sup> चोचुच्यकः-च्यिका;</li> <li>  चुच्यिता-त्री, चुच्ययिता-त्री, चुचुच्यिषिता-त्री, <sup id="ref_krm_0544_04"><a href="#foot_krm_0544_04">4</a></sup> चोचुच्यिता-त्री;</li> <li>  <sup id="ref_krm_0544_05"><a href="#foot_krm_0544_05">5</a></sup> चुच्यन्-न्ती, चुच्ययन्-न्ती, चुचुच्यिषन्-न्ती;</li> <li>  -- चुच्यिष्यन्-न्ती-ती, चुच्ययिष्यन्-न्ती-ती, चुचुच्यिषिष्यन्-न्ती-ती;</li> <li>  -- -- चुच्यमानः, चुच्ययिष्यमाणः, <sup id="ref_krm_0544_06"><a href="#foot_krm_0544_06">6</a></sup> चोचुच्य्यमानः, चोचुच्यिष्यमाणः;</li> <li>  <sup id="ref_krm_0544_07"><a href="#foot_krm_0544_07">7</a></sup> सुचुक्-सुचुच्यौ-सुचुच्यः;</li> <li>  -- -- -- <sup id="ref_krm_0544_08"><a href="#foot_krm_0544_08">8</a></sup> चुच्यितम्-तः, चुच्यितः, चुचुच्यिषितः, चोचुच्यितः-तवान्;</li> <li>  चुच्यः, चुच्यः, चुचुच्यिषुः, चोचुच्यः;</li> <li>  चुच्यितव्यम्, चुच्ययितव्यम्, चुचुच्यिषितव्यम्, चोचुच्यितव्यम्;</li> <li>  चुच्यनीयम्, चुच्यनीयम्, चुचुच्यिषणीयम्, चोचुच्यनीयम्;</li> <li>  <sup id="ref_krm_0544_09"><a href="#foot_krm_0544_09">9</a></sup> चुच्य्यम्-चुच्यम्, चुच्यम्, चुचुच्यिष्यम्, चोचुच्य्यम्;</li> <li>  ईषच्चुच्यः-दुश्चुच्यः-सुचुच्यः;</li> <li>  -- -- -- चुच्य्यमानः-चुच्यमानः, चुच्यमानः, चुचुच्यिष्यमाणः, चोचुच्य्यमानः;</li> <li>  चुच्यः, चुच्यः, चुचुच्यिषः, चोचुच्यः;</li> <li>  चुच्यितुम्, चुच्ययितुम्, चुचुच्यिषितुम्, चोचुच्यितुम्;</li> <li>  <sup id="ref_krm_0544_10"><a href="#foot_krm_0544_10">10</a></sup> <sup id="ref_krm_0544_11"><a href="#foot_krm_0544_11">11</a></sup> चुच्या, चुच्यना, चुचुच्यिषा, चोचुच्या;</li> <li>  चुच्यनम्, चुच्यनम्, चुचुच्यिषणम्, चोचुच्यनम्;</li> <li>  चुच्यित्वा, चुच्ययित्वा, चुचुच्यिषित्वा, चोचुच्यित्वा;</li> <li>  प्रचुच्य्य-प्रचुच्य, प्रचुच्य, प्रचुचुच्यिष्य, प्रचोचुच्य;</li> <li>  चिच्यम् २ चुच्यित्वा २ चुच्यम् २ चुच्ययित्वा २ चुच्यिषम् २ चोचुच्यम् २;</li> <li>  चोचुच्यित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0544_01"><a href="#ref_krm_0544_01">↑</a> (५३४)</li> <li id="foot_krm_0544_02"><a href="#ref_krm_0544_02">↑</a> (१-भ्वादिः-५१३। सक। सेट्। पर।)</li> <li id="foot_krm_0544_03"><a href="#ref_krm_0544_03">↑</a> [[१। अस्माद्धातोर्यङि, ‘सन्यङोः’ (६-१-९) इति प्रथमैकाचो द्वित्वे, अभ्यासगुणे च सति, यङवयवस्य यकारस्य ‘यस्य हलः’ (६-४-४९) इति लोपे, अकारस्य ‘अतो लोपः’ (६-४-४८) इति लोपे च, चोचुच्यकः-च्यिका इति रूपम्।]]</li> <li id="foot_krm_0544_04"><a href="#ref_krm_0544_04">↑</a> [[२। ‘यस्य हलः’ (६-४-४९) इति यकारस्य, ‘अतो लोपः’ (६-४-४८) इत्यका- रस्य च लोपे, ‘चोचुच्यिता’ इति रूपं भवति। माधवधातुवृत्तौ तु ‘हलो यमां यमि’ (८-४-६४) इति लोपपक्षे, यङो यलोपे, अकारलोपे च, सति, लघूपधगुणमाशङ्क्य, ‘न धातुलोप--’ (१-१-४) इति निषेधात्, स्थानिवद्भावाद्वा, लघूपधगुणाभावे, ‘चोचुचिता’ इति यकाररहितमेकं रूपम्, ‘हलो यमां-’ (८-४-६४) इति लोपस्य वैकल्पिकत्वात्, लोपाभावपक्षे च यकारघटितं ‘चोचुच्यिता’ इति रूपान्तरमुक्तम्। अत्र, ‘हलो यमाम्--’ (८-४-६४) इत्यस्य त्रैपादिकत्वेन, पूर्वमप्रवृत्तौ, ‘यस्य हलः’ (६-४-४९) इति यकारलोपे यम्परत्वाभावेन, ‘हलो यमाम्-’ (८-४-६४) इत्यस्यानन्तरमप्रवृत्तौ यकारघटितमेव रूपं शास्त्रानुगतमिति प्रतिभाति। सुधियोऽस्य तत्त्वं विभावयन्तु।]]</li> <li id="foot_krm_0544_05"><a href="#ref_krm_0544_05">↑</a> [पृष्ठम्०५१८+ २०]</li> <li id="foot_krm_0544_06"><a href="#ref_krm_0544_06">↑</a> [[१। यङन्ताच्छानचि, धातुयकारयङ्यकारयोरुभयोरपि श्रवणम्।]]</li> <li id="foot_krm_0544_07"><a href="#ref_krm_0544_07">↑</a> [[२। ‘वेरपृक्तलोपाद् वलि लोपो विप्रतिषेधेन’ (वा। १-४-२) इति, धातुयकारस्य, ‘लोपो व्योर्वलि’ (६-१-६६) इति लोपेनापहारे, ‘चोः कुः’ (८-२-३०) इति पदान्ते चकारस्य ककारः।]]</li> <li id="foot_krm_0544_08"><a href="#ref_krm_0544_08">↑</a> [[३। घातोरस्योदात्तत्वादिडागमे चुच्यितम् इति रूपम्। क्षीरस्वामिना ‘चुच्यी’ इति ईदित्पाठमवलम्ब्य, ‘श्वीदितो निष्ठायाम्’ (७-२-१४) इति निष्ठायामिडभावमवलम्ब्य यकारस्य वलि लोपे, कुत्वे च चुक्तः इत्यङ्गीकृतम्।]]</li> <li id="foot_krm_0544_09"><a href="#ref_krm_0544_09">↑</a> [[४। हलन्तत्वेन, ‘ऋहलोर्ण्यत्’ (३-१-१२४) इति ण्यत्प्रत्यये, ‘हलो यमाम्--’ (८-४-६४) इति लोपस्य वैकल्पिकत्वात्, कदाचिद् द्वियकारघटितं रूपम्, कदाचिच्च एकयकारघटितमिति रूपद्वयम्। एवं यगन्तेऽपि ज्ञेयम्।]]</li> <li id="foot_krm_0544_10"><a href="#ref_krm_0544_10">↑</a> [पृष्ठम्०५१९+ २३]</li> <li id="foot_krm_0544_11"><a href="#ref_krm_0544_11">↑</a> [[१। ‘गुरोश्च हलः’ (३-३-१०३) इति स्त्रियां भावादौ, अप्रत्ययः।]]</li></ul></p>

चुट|चोटकः-टिका|चुचुटिषकः-षिका|चोचुटकः-टिका
<ul><li><sup id="ref_krm_0545_01"><a href="#foot_krm_0545_01">1</a></sup> {@“चुट छेदने”@} <sup id="ref_krm_0545_02"><a href="#foot_krm_0545_02">2</a></sup> चोटकः-टिका, चोटकः-टिका, चुचुटिषकः-षिका, चोचुटकः-टिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि तौदादिककौटिल्यार्थककुटतिवत् <sup id="ref_krm_0545_03"><a href="#foot_krm_0545_03">3</a></sup> बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0545_01"><a href="#ref_krm_0545_01">↑</a> (५३५)</li> <li id="foot_krm_0545_02"><a href="#ref_krm_0545_02">↑</a> (६-तुदादिः-१३७७। सक। सेट्। पर। कुटादिः।)</li> <li id="foot_krm_0545_03"><a href="#ref_krm_0545_03">↑</a> (२०४)</li></ul></p>

चुट|चोटकः-टिका|चुचोटयिषकः-षिका|अस्य|धातोरुभयपदीत्वेन|शतरि|चोटयन्-न्ती|चुचोटयिषन्-न्ती-ती|चुचोटयिषिष्यन्-न्ती-ती
<ul><li><sup id="ref_krm_0546_01"><a href="#foot_krm_0546_01">1</a></sup> {@“चुट छेदने”@} <sup id="ref_krm_0546_02"><a href="#foot_krm_0546_02">2</a></sup> चोटकः-टिका, चुचोटयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिककुटधातुवत् <sup id="ref_krm_0546_03"><a href="#foot_krm_0546_03">3</a></sup> बोध्यानि। </li> <li>अस्य धातोरुभयपदीत्वेन, शतरि चोटयन्-न्ती, चुचोटयिषन्-न्ती-ती, चुचोटयिषिष्यन्-न्ती-ती;</li> <li>  इति रूपाण्य- घिकानीति विशेषः। </li> <li><sup id="ref_krm_0546_04"><a href="#foot_krm_0546_04">4</a></sup> विचोटी, णिनिप्रत्ययः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0546_01"><a href="#ref_krm_0546_01">↑</a> (५३६)</li> <li id="foot_krm_0546_02"><a href="#ref_krm_0546_02">↑</a> (१०-चुरादिः-१६१३। सक। सेट्। उभ।)</li> <li id="foot_krm_0546_03"><a href="#ref_krm_0546_03">↑</a> (२०५)</li> <li id="foot_krm_0546_04"><a href="#ref_krm_0546_04">↑</a> [[आ। ‘सम्पालयेद् विमतलूष्यपशुल्बभूमा क्ष्मामेष राम इव शूर्पणखाविचोटी।।’ धा। का। ३। २२।]]</li></ul></p>

चुटि|चुण्टकः-ण्टिका|चुचुण्टयिषकः-षिका|चुचुण्टिषकः-षिका|चोचुण्टकः-ण्टिका
<ul><li><sup id="ref_krm_0547_01"><a href="#foot_krm_0547_01">1</a></sup> {@“चुटि छेदने”@} <sup id="ref_krm_0547_02"><a href="#foot_krm_0547_02">2</a></sup> “चुट” इति क्षीरस्वामिसम्मतः पाठः। </li> <li>चुण्टकः-ण्टिका, चुचुण्टयिषकः-षिका, चुण्टकः-ण्टिका, चुचुण्टिषकः-षिका, चोचुण्टकः-ण्टिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकचिन्तयतिवत् <sup id="ref_krm_0547_03"><a href="#foot_krm_0547_03">3</a></sup> बोध्यानि। </li> <li>इदित्करणेन णिचो वैकल्पिकत्वम्। </li> <li>अतः, णिजभावपक्षे, शुद्धात्- सन्नन्तात्-यङन्ताच्च रूपाणि चिन्तयतिवदेव बोध्यानि। </li> <li><sup id="ref_krm_0547_04"><a href="#foot_krm_0547_04">4</a></sup> चुण्टितः। </li> <li><sup id="ref_krm_0547_05"><a href="#foot_krm_0547_05">5</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0547_01"><a href="#ref_krm_0547_01">↑</a> (५३७)</li> <li id="foot_krm_0547_02"><a href="#ref_krm_0547_02">↑</a> (१०-चुरादिः-१६६०। सक। सेट्। उभ।)</li> <li id="foot_krm_0547_03"><a href="#ref_krm_0547_03">↑</a> (५२३)</li> <li id="foot_krm_0547_04"><a href="#ref_krm_0547_04">↑</a> [[B। ‘प्रह्लापये किमपरं परिचुण्टितारिः भूयोऽयमेलयति चेदिह को निषेद्धा।।’ धा। का। ३। २९।]]</li> <li id="foot_krm_0547_05"><a href="#ref_krm_0547_05">↑</a> [पृष्ठम्०५२०+ २३]</li></ul></p>

चुट्ट|चुट्टकः-ट्टिका|चुचुट्टयिषकः-षिका
<ul><li><sup id="ref_krm_0548_01"><a href="#foot_krm_0548_01">1</a></sup> {@“चुट्ट अल्पीभावे”@} <sup id="ref_krm_0548_02"><a href="#foot_krm_0548_02">2</a></sup> चुट्टकः-ट्टिका, चुचुट्टयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिक- कुट्टयतिवत् <sup id="ref_krm_0548_03"><a href="#foot_krm_0548_03">3</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_0548_04"><a href="#foot_krm_0548_04">4</a></sup> चुट्टितः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0548_01"><a href="#ref_krm_0548_01">↑</a> (५३८)</li> <li id="foot_krm_0548_02"><a href="#ref_krm_0548_02">↑</a> (१०-चुरादिः। १५६०। अक। सेट्। उभ।)</li> <li id="foot_krm_0548_03"><a href="#ref_krm_0548_03">↑</a> (२०७)</li> <li id="foot_krm_0548_04"><a href="#ref_krm_0548_04">↑</a> [[आ। ‘सा पूतना च शिशुभक्षणकुट्टनोत्का जघ्ने प्रपुट्टितकृपेण विचुट्टिताघा।’ धा। का। ३। १६।]]</li></ul></p>

चुड|चोडकः-डिका|चुचुडिषकः-षिका|चोचुडकः-डिका|स्त्रियां|भावादौ|भिदादिपाठात्|अङ्|उपधायाः|दीर्घश्च
<ul><li><sup id="ref_krm_0549_01"><a href="#foot_krm_0549_01">1</a></sup> {@“चुड संवरणे”@} <sup id="ref_krm_0549_02"><a href="#foot_krm_0549_02">2</a></sup> चोडकः-डिका, चोडकः-डिका, चुचुडिषकः-षिका, चोचुडकः-डिका;</li> <li>  इत्या- दीनि सर्वाण्यपि रूपाणि तौदादिककुटतिवत् <sup id="ref_krm_0549_03"><a href="#foot_krm_0549_03">3</a></sup> ज्ञेयानि। </li> <li>स्त्रियां भावादौ भिदादि <sup id="ref_krm_0549_04"><a href="#foot_krm_0549_04">4</a></sup> पाठात् अङ्, उपधायाः दीर्घश्च;</li> <li>  चूडा-इति भवति। </li> <li><sup id="ref_krm_0549_05"><a href="#foot_krm_0549_05">5</a></sup>] चुडितम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0549_01"><a href="#ref_krm_0549_01">↑</a> (५३९)</li> <li id="foot_krm_0549_02"><a href="#ref_krm_0549_02">↑</a> (६-तुदादिः-१३९२। सक। सेट्। पर। कुटादिः।)</li> <li id="foot_krm_0549_03"><a href="#ref_krm_0549_03">↑</a> (२०४)</li> <li id="foot_krm_0549_04"><a href="#ref_krm_0549_04">↑</a> (३-३-१०४)</li> <li id="foot_krm_0549_05"><a href="#ref_krm_0549_05">↑</a> [[B। ‘क्षौमेण स्फुडितं स्रजा निचुडितं (चुलितं) चाव्रोड्यशोभं धनुः गेहक्रोडतले स मोदकुलितो दृष्ट्वाऽगुरिष्ट क्षणात्।’ धा। का। २। ८२। [लडयोरभेदात् निचुलितम् इति भवति।]]</li></ul></p>

चुडि|चुण्डकः-ण्डिका|चुचुण्डिषकः-षिका|चोचुण्डकः-ण्डिका
<ul><li><sup id="ref_krm_0550_01"><a href="#foot_krm_0550_01">1</a></sup> {@“चुडि अल्पीभावे”@} <sup id="ref_krm_0550_02"><a href="#foot_krm_0550_02">2</a></sup> चुण्डकः-ण्डिका, चुण्डकः-ण्डिका, चुचुण्डिषकः-षिका, चोचुण्डकः-ण्डिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककुण्ठतिवत् <sup id="ref_krm_0550_03"><a href="#foot_krm_0550_03">3</a></sup> ज्ञेयानि। </li> <li>क्विपि <sup id="ref_krm_0550_04"><a href="#foot_krm_0550_04">4</a></sup> चुन्-चुण्डौ-चुण्डः इति भवति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0550_01"><a href="#ref_krm_0550_01">↑</a> (५४०)</li> <li id="foot_krm_0550_02"><a href="#ref_krm_0550_02">↑</a> (१-भ्वादिः-३२५। अक। सेट्। पर।)</li> <li id="foot_krm_0550_03"><a href="#ref_krm_0550_03">↑</a> (२०९)</li> <li id="foot_krm_0550_04"><a href="#ref_krm_0550_04">↑</a> [[C। ‘अचुन्ननुन्मुण्डितपुण्डरीकभृत्सरःश्रियो रुण्डकलुण्डनोज्झितान्।’ धा। का। १। ४३।]]</li></ul></p>

चुड्ड|चुड्डकः-ड्डिका|चुचुड्डिषकः-षिका|चोचुड्डकः-ड्डिका
<ul><li><sup id="ref_krm_0551_01"><a href="#foot_krm_0551_01">1</a></sup> {@“चुड्ड भावकरणे”@} <sup id="ref_krm_0551_02"><a href="#foot_krm_0551_02">2</a></sup> दोपधोऽयम्। </li> <li>भावकरणम् = अभिप्रायाविष्करणम्। </li> <li>चुड्डकः-ड्डिका, चुड्डकः-ड्डिका, चुचुड्डिषकः-षिका, चोचुड्डकः-ड्डिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककड्डतिवत् <sup id="ref_krm_0551_03"><a href="#foot_krm_0551_03">3</a></sup> बोध्यानि। </li> <li>घञि चुड्डः <sup id="ref_krm_0551_04"><a href="#foot_krm_0551_04">4</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0551_01"><a href="#ref_krm_0551_01">↑</a> (५४१)</li> <li id="foot_krm_0551_02"><a href="#ref_krm_0551_02">↑</a> (१-भ्वादिः-३४७। अक। सेट्। पर।)</li> <li id="foot_krm_0551_03"><a href="#ref_krm_0551_03">↑</a> (१५६)</li> <li id="foot_krm_0551_04"><a href="#ref_krm_0551_04">↑</a> [[ड्। ‘प्ररुण्ठिताधैरनुलुण्ठकैर्हरेः प्रचुड्डबोधाद्भिरतीव शोभितान्।।’ धा। का। १। ४५।]]</li></ul></p>

चुद|चोदकः-दिका|चुचोदयिषकः-षिका|चोदयिता-त्री|चुचोदयिषिता-त्री|चोदयन्-न्ती|माणवकमर्थं]|चोदयन्|चुचोदयिषन्-न्ती|चोदयिष्यन्-न्ती-ती|चुचोदयिषिष्यन्-न्ती-ती|चोदयमानः|चुचोदयिषमाणः|चोदयिष्यमाणः|चुचोदयिषिष्यमाणः|प्रचोत्-प्रचोदौ-प्रचोदः|चोदितम्-तः|चुचोदयिषितः-तवान्|चोदः|चुचोदयिषुः|चोदयितव्यम्|चुचोदयिषितव्यम्|चोदनीयम्|चुचोदयिषणीयम्|चोद्यम्|चुचोदयिष्यम्|ईषच्चोदः-दुश्चोदः-सुचोदः|-|चोद्यमानः|चुचोदयिष्यमाणः|चुचोदयिषः|चोदयितुम्|चुचोदयिषितुम्|चोदना|चूडा|चुचोदयिषा|चोदनम्|चुचोदयिषणम्|चोदयित्वा|चुचोदयिषित्वा|प्रचोद्य|परिचोद्य|प्रचुचोदयिष्य
<ul><li><sup id="ref_krm_0552_01"><a href="#foot_krm_0552_01">1</a></sup> {@“चुद सञ्चोदने”@} <sup id="ref_krm_0552_02"><a href="#foot_krm_0552_02">2</a></sup> सञ्चोदनम् = प्रश्नः, प्रेरणं वा। </li> <li>प्रश्ने द्विकर्मकः। </li> <li><sup id="ref_krm_0552_03"><a href="#foot_krm_0552_03">3</a></sup> चोदकः-दिका, चुचोदयिषकः-षिका;</li> <li>  चोदयिता-त्री, चुचोदयिषिता-त्री;</li> <li>  चोदयन्-न्ती, <sup id="ref_krm_0552_04"><a href="#foot_krm_0552_04">4</a></sup> माणवकमर्थं] चोदयन्, चुचोदयिषन्-न्ती;</li> <li>  चोदयिष्यन्-न्ती-ती, चुचोदयिषिष्यन्-न्ती-ती, चोदयमानः, चुचोदयिषमाणः;</li> <li>  चोदयिष्यमाणः, चुचोदयिषिष्यमाणः;</li> <li>  <sup id="ref_krm_0552_05"><a href="#foot_krm_0552_05">5</a></sup> प्रचोत्-प्रचोदौ-प्रचोदः;</li> <li>  चोदितम्-तः, चुचोदयिषितः-तवान्;</li> <li>  चोदः, चुचोदयिषुः;</li> <li>  चोदयितव्यम्, चुचोदयिषितव्यम्;</li> <li>  चोदनीयम्, चुचोदयिषणीयम्;</li> <li>  चोद्यम्, चुचोदयिष्यम्;</li> <li>  ईषच्चोदः-दुश्चोदः-सुचोदः;</li> <li>  -- चोद्यमानः, चुचोदयिष्यमाणः;</li> <li>  चोदः, चुचोदयिषः;</li> <li>  चोदयितुम्, चुचोदयिषितुम्;</li> <li>  <sup id="ref_krm_0552_06"><a href="#foot_krm_0552_06">6</a></sup> चोदना, <sup id="ref_krm_0552_07"><a href="#foot_krm_0552_07">7</a></sup> चूडा, चुचोदयिषा;</li> <li>  चोदनम्, चुचोदयिषणम्;</li> <li>  चोदयित्वा, चुचोदयिषित्वा;</li> <li>  प्रचोद्य, <sup id="ref_krm_0552_08"><a href="#foot_krm_0552_08">8</a></sup> परिचोद्य, प्रचुचोदयिष्य;</li> <li>  चोदम् २ -चोदयित्वा २, चुचोदयिषम् २ -चुचोदयिषित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0552_01"><a href="#ref_krm_0552_01">↑</a> (५४२)</li> <li id="foot_krm_0552_02"><a href="#ref_krm_0552_02">↑</a> (१०-चुरादिः-१५९२। सक। सेट्। उभ।)</li> <li id="foot_krm_0552_03"><a href="#ref_krm_0552_03">↑</a> [पृष्ठम्०५२१+ २७]</li> <li id="foot_krm_0552_04"><a href="#ref_krm_0552_04">↑</a> [[[१। ‘अकथितं च’ (१-४-५१) इत्यनेन माणवकस्य कर्मसंज्ञा। न चात्र कृद्योगलक्षणा षष्ठी शङ्क्या;\n\n  ‘न लोकाव्ययनिष्ठाखलर्थतृनाम्’ (२-३-६९) इति षष्ठीनिषेधात्।]]</li> <li id="foot_krm_0552_05"><a href="#ref_krm_0552_05">↑</a> [[२। णिनिमित्तको गुणः।]]</li> <li id="foot_krm_0552_06"><a href="#ref_krm_0552_06">↑</a> [[आ। ‘कर्मचोदनया जीवः कायमन्यमिवेन्द्रियैः।।’ भारतचम्पूः (२-१८)]]</li> <li id="foot_krm_0552_07"><a href="#ref_krm_0552_07">↑</a> [[३। ‘भिदादिषु (३-३-१०४) निपातनात् धातोरुपधाया दीर्घः, दकारस्य डकारः णिलोपश्च भवति’ इति माधवधातुवृत्तिः। ‘अबाधकान्यपि निपातनानि’ (परिभाषा- ११८) इति वचनात् ‘चोदना’ इत्यपि साधुः।]]</li> <li id="foot_krm_0552_08"><a href="#ref_krm_0552_08">↑</a> [[B। ‘संबुस्तिते गिरिमखे परिचोद्य गोपान् प्रानक्कयद्धरिमखं मदधक्कनार्थी।।’ धा। का। ३। २०।]]</li></ul></p>

चुप|चोपकः-पिका|चुचोपिषकः-चुचुपिषकः-षिका|चोचुपकः-पिका
<ul><li><sup id="ref_krm_0553_01"><a href="#foot_krm_0553_01">1</a></sup> {@“चुप मन्दायां गतौ”@} <sup id="ref_krm_0553_02"><a href="#foot_krm_0553_02">2</a></sup> ‘स्पर्शे चुपति, मन्दायां गतौ तु शपि चोपति।’ <sup id="ref_krm_0553_03"><a href="#foot_krm_0553_03">3</a></sup> इति देवः। </li> <li>चोपकः-पिका, चोपकः-पिका, चुचोपिषकः-चुचुपिषकः-षिका, चोचुपकः-पिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककुचतिवत् <sup id="ref_krm_0553_04"><a href="#foot_krm_0553_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0553_05"><a href="#foot_krm_0553_05">5</a></sup> गले- <sup id="ref_krm_0553_06"><a href="#foot_krm_0553_06">6</a></sup> चोपकः, <sup id="ref_krm_0553_07"><a href="#foot_krm_0553_07">7</a></sup> चोपनः, <sup id="ref_krm_0553_08"><a href="#foot_krm_0553_08">8</a></sup> चोपयन्-न्ती, चोपयिष्यन्-न्ती-ती, <sup id="ref_krm_0553_09"><a href="#foot_krm_0553_09">9</a></sup> चुपित्वा-चोपित्वा, इति रूपाण्यस्येति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0553_01"><a href="#ref_krm_0553_01">↑</a> (५४३)</li> <li id="foot_krm_0553_02"><a href="#ref_krm_0553_02">↑</a> (१-भ्वादिः-४०३। अक। सेट्। पर।)</li> <li id="foot_krm_0553_03"><a href="#ref_krm_0553_03">↑</a> (श्लो। १३८)</li> <li id="foot_krm_0553_04"><a href="#ref_krm_0553_04">↑</a> (२००)</li> <li id="foot_krm_0553_05"><a href="#ref_krm_0553_05">↑</a> [[४। गले चोप्यते इति, ‘कृत्यल्युटो बहुलम्’ (३-३-११३) इति ण्यन्तादस्मात् कर्मणि ण्वुल्। ‘कर्तृकरणे कृता बहुलम्’ (२-१-३२) इति बहुलग्रहणात् सप्तम्यन्तस्यापि समासः। ‘तत्पुरुषे कृति बहुलम्’ (६-३-१४) इति, ‘अमूर्धमस्तकात् स्वाङ्गादकामे’ (६-३-१२) इति वा सप्तम्या अलुक्।]]</li> <li id="foot_krm_0553_06"><a href="#ref_krm_0553_06">↑</a> [पृष्ठम्०५२२+ २२]</li> <li id="foot_krm_0553_07"><a href="#ref_krm_0553_07">↑</a> [[१। ‘चलनशब्दार्थादकर्मकाद्युच्’ (३-२-१४८) इति ताच्छीलिको युच्।]]</li> <li id="foot_krm_0553_08"><a href="#ref_krm_0553_08">↑</a> [[२। ण्यन्तात्, ‘अणावकर्मकात्--’ (१-३-८८) इति परस्मैपदमेव।]]</li> <li id="foot_krm_0553_09"><a href="#ref_krm_0553_09">↑</a> [[आ। ‘श्येनाश्चुपित्वा तुतुपुः कपोतकान् काकानतुम्पन्नभितुत्रुपुः शशान्।।’ धा। का। १। ५२।]]</li></ul></p>

चुबि|चुम्बकः-म्बिका|चुचुम्बिषकः-षिका|चोचुम्बकः-म्बिका
<ul><li><sup id="ref_krm_0554_01"><a href="#foot_krm_0554_01">1</a></sup> {@“चुबि वक्त्रसंयोगे”@} <sup id="ref_krm_0554_02"><a href="#foot_krm_0554_02">2</a></sup> ‘हिंसायाम्, वक्त्रसंयोगे चुम्बयेच्चुम्बति क्रमात्।’ <sup id="ref_krm_0554_03"><a href="#foot_krm_0554_03">3</a></sup> इति देवः। </li> <li>चुम्बकः-म्बिका, चुम्बकः-म्बिका, चुचुम्बिषकः-षिका, चोचुम्बकः-म्बिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककुण्ठतिवत् <sup id="ref_krm_0554_04"><a href="#foot_krm_0554_04">4</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_0554_05"><a href="#foot_krm_0554_05">5</a></sup> चुम्बितम्, <sup id="ref_krm_0554_06"><a href="#foot_krm_0554_06">6</a></sup> शिरश्चुम्बी <sup id="ref_krm_0554_07"><a href="#foot_krm_0554_07">7</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0554_01"><a href="#ref_krm_0554_01">↑</a> (५४४)</li> <li id="foot_krm_0554_02"><a href="#ref_krm_0554_02">↑</a> (१-भ्वादिः-४२९। अक। सेट्। पर।)</li> <li id="foot_krm_0554_03"><a href="#ref_krm_0554_03">↑</a> (श्लो। १४०)</li> <li id="foot_krm_0554_04"><a href="#ref_krm_0554_04">↑</a> (२०९)</li> <li id="foot_krm_0554_05"><a href="#ref_krm_0554_05">↑</a> [[B। ‘वियोगसंतुम्बितकोकचुम्बिता सन्तापसृब्धाऽपि जगाद तद्वधूः।’ धा। का। १। ५६।]]</li> <li id="foot_krm_0554_06"><a href="#ref_krm_0554_06">↑</a> [[३। शिरः चुम्बितुं शीलमस्येति ताच्छील्ये णिनिः।]]</li> <li id="foot_krm_0554_07"><a href="#ref_krm_0554_07">↑</a> [[C। ‘नमस्तुङ्गशिरश्चुम्बिचन्द्रचामरचारवे’। हर्षचरिते। १। १।]]</li></ul></p>

चुबि|चुम्बकः-म्बिका|चुचुम्बयिषकः-षिका|चुचुम्बिषकः-षिका|चोचुम्बकः-म्बिका
<ul><li><sup id="ref_krm_0555_01"><a href="#foot_krm_0555_01">1</a></sup> {@“चुबि हिंसायाम्”@} <sup id="ref_krm_0555_02"><a href="#foot_krm_0555_02">2</a></sup> ‘हिंसायाम्, वक्त्रसंयोगे चुम्बयेच्चुम्बति क्रमात्।’ <sup id="ref_krm_0555_03"><a href="#foot_krm_0555_03">3</a></sup> इति देवः। </li> <li>चुम्बकः-म्बिका, चुचुम्बयिषकः-षिका, <sup id="ref_krm_0555_04"><a href="#foot_krm_0555_04">4</a></sup> चुम्बकः-म्बिका, चुचुम्बिषकः-षिका, चोचुम्बकः-म्बिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि <sup id="ref_krm_0555_05"><a href="#foot_krm_0555_05">5</a></sup> चौरादिकचिन्तयतिवत् <sup id="ref_krm_0555_06"><a href="#foot_krm_0555_06">6</a></sup> बोध्यानि। </li> <li>घञि-चुम्बकः <sup id="ref_krm_0555_07"><a href="#foot_krm_0555_07">7</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0555_01"><a href="#ref_krm_0555_01">↑</a> (५४५)</li> <li id="foot_krm_0555_02"><a href="#ref_krm_0555_02">↑</a> (१०-चुरादिः-१६३६। सक। सेट्। उभ।)</li> <li id="foot_krm_0555_03"><a href="#ref_krm_0555_03">↑</a> (श्लो। १४०)</li> <li id="foot_krm_0555_04"><a href="#ref_krm_0555_04">↑</a> [[४। इदित्करणात् णिचो वैकल्पिकत्वम्। णिजभावपक्षे शुद्धात् सन्नन्तात्-यङन्ताच्च क्रमेण रूपाण्यूह्यानि।]]</li> <li id="foot_krm_0555_05"><a href="#ref_krm_0555_05">↑</a> [विशेषरूपाणि विना]</li> <li id="foot_krm_0555_06"><a href="#ref_krm_0555_06">↑</a> (५२३)</li> <li id="foot_krm_0555_07"><a href="#ref_krm_0555_07">↑</a> [[ड्। ‘न स्फिट्ट्यामि किमु चुम्बभिया स्थितोऽसि किं पूलितान्नकृतपुंसनयाऽत्र पुंसाम्।।’ धा। का। ३। २६।]]</li></ul></p>

चुर|चोरकः-रिका|चुचोरयिषकः-षिका|चोरयिता-त्री|चुचोरयिषिता-त्री|चोरयन्-न्ती|चुचोरयिषन्-न्ती|चोरयिष्यन्-न्ती-ती|चुचोरयिषिष्यन्-न्ती-ती|चोरयमाणः|चुचोरयिषमाणः|चोरयिष्यमाणः|चुचोरयिषिष्यमाणः|चोः-चोरौ-चोरः|-|चोरितम्-तः|चुचोरयिषितः-तवान्|चोरः|चौरः|चुचोरयिषुः|चोरयितव्यम्|चुचोरयिषितव्यम्|चोरणीयम्|चुचोरयिषणीयम्|चोर्यम्|चुचोरयिष्यम्|ईषच्चोरः-दुश्चोरः-सुचोरः|चोर्यमाणः|चुचोरयिष्यमाणः|चुचोरयिषः|चोरयितुम्|चुचोरयिषितुम्|चोरणा|चुरा|व्यवचोरी|चुचोरयिषा|चोरणम्|चुचोरयिषणम्|चोरयित्वा|चुचोरयिषित्वा|प्रचोर्य|प्रचुचोरयिष्य|चोरम्चोरयित्वाचुचोरयिषम्
<ul><li><sup id="ref_krm_0556_01"><a href="#foot_krm_0556_01">1</a></sup> {@“चुर स्तेये”@} <sup id="ref_krm_0556_02"><a href="#foot_krm_0556_02">2</a></sup> ‘स्तेये चोरयतीति स्यात्, चुरेश्छेदे चुरेदिति।’ <sup id="ref_krm_0556_03"><a href="#foot_krm_0556_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_0556_04"><a href="#foot_krm_0556_04">4</a></sup> चोरकः-रिका, चुचोरयिषकः-षिका;</li> <li>  चोरयिता-त्री, चुचोरयिषिता-त्री;</li> <li>  <sup id="ref_krm_0556_05"><a href="#foot_krm_0556_05">5</a></sup> चोरयन्-न्ती, चुचोरयिषन्-न्ती;</li> <li>  चोरयिष्यन्-न्ती-ती, चुचोरयिषिष्यन्-न्ती-ती;</li> <li>  चोरयमाणः, चुचोरयिषमाणः;</li> <li>  चोरयिष्यमाणः, चुचोरयिषिष्यमाणः;</li> <li>  <sup id="ref_krm_0556_06"><a href="#foot_krm_0556_06">6</a></sup> चोः-चोरौ-चोरः;</li> <li>  -- चोरितम्-तः, चुचोरयिषितः-तवान्;</li> <li>  <sup id="ref_krm_0556_07"><a href="#foot_krm_0556_07">7</a></sup> चोरः चौरः, चुचोरयिषुः;</li> <li>  चोरयितव्यम्, चुचोरयिषितव्यम्;</li> <li>  चोरणीयम्;</li> <li>  चुचोरयिषणीयम्;</li> <li>  चोर्यम्, चुचोरयिष्यम्;</li> <li>  ईषच्चोरः-दुश्चोरः-सुचोरः;</li> <li>  -- चोर्यमाणः, चुचोरयिष्यमाणः;</li> <li>  चोरः, चुचोरयिषः;</li> <li>  चोरयितुम्, चुचोरयिषितुम्;</li> <li>  <sup id="ref_krm_0556_08"><a href="#foot_krm_0556_08">8</a></sup> चोरणा, <sup id="ref_krm_0556_09"><a href="#foot_krm_0556_09">9</a></sup> चुरा, व्यवचोरी, <sup id="ref_krm_0556_10"><a href="#foot_krm_0556_10">10</a></sup> चुचोरयिषा;</li> <li>  चोरणम्, चुचोरयिषणम्;</li> <li>  <sup id="ref_krm_0556_11"><a href="#foot_krm_0556_11">11</a></sup> चोरयित्वा, चुचोरयिषित्वा;</li> <li>  प्रचोर्य, प्रचुचोरयिष्य;</li> <li>  चोरम् २ चोरयित्वा २ चुचोरयिषम् २;</li> <li>  चुचोरयिषित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0556_01"><a href="#ref_krm_0556_01">↑</a> (५४६)</li> <li id="foot_krm_0556_02"><a href="#ref_krm_0556_02">↑</a> (१०-चुरादिः-१५३४। सक। सेट्। उभ।)</li> <li id="foot_krm_0556_03"><a href="#ref_krm_0556_03">↑</a> (श्लो। १५१)</li> <li id="foot_krm_0556_04"><a href="#ref_krm_0556_04">↑</a> [पृष्ठम्०५२३+ २४]</li> <li id="foot_krm_0556_05"><a href="#ref_krm_0556_05">↑</a> [[आ। ‘सञ्चोरयन्तमरिगर्वमशेषभद्रं चिन्तन्तमन्तकमिवाप्तमयन्त्र्यवीर्यम्।’ धा। का। ३। १३।]]</li> <li id="foot_krm_0556_06"><a href="#ref_krm_0556_06">↑</a> [[१। णिनिमित्तके लघूपधगुणे, पदान्तरेफस्य विसर्गः।]]</li> <li id="foot_krm_0556_07"><a href="#ref_krm_0556_07">↑</a> [[२। चोर एव चौरः। ‘प्रज्ञादिभ्यश्च’ (५-४-३८) इति स्वार्थेऽण् प्रत्ययः। पचादिषु (३-१-१३४) ‘चोरट्’ इति टित्करणेन पाठात् स्त्रियां ङीप्।]]</li> <li id="foot_krm_0556_08"><a href="#ref_krm_0556_08">↑</a> [[३। ‘ण्यासश्रन्थो युच्’ (३-३-१०७) इति युच्।]]</li> <li id="foot_krm_0556_09"><a href="#ref_krm_0556_09">↑</a> [[४। ‘छत्त्रादिभ्यो णः’ (४-४-६२) इत्यत्र (गणे) ‘चुरा’ इति पाठात् अङ्, गुणाभावः, णिलोपश्च। चुरा शीलमस्या इत्यर्थे स्त्रियां चौरी। ‘ताच्छीलिकेऽपि णेऽण्कृतं कार्यं भवति’ (परिभाषा-८८) इति वचनात् ङीप्।]]</li> <li id="foot_krm_0556_10"><a href="#ref_krm_0556_10">↑</a> [[५। ‘कर्मव्यतीहारे णच् स्त्रियाम्’ (३-३-४३) इति णच्। ‘णचस्त्रियामञ्’ (५-४-१४) इति अञ्। ङीष्। ‘न कर्मव्यतीहारे’ (७-३-६) इति ऐजागमनिषेधः।]]</li> <li id="foot_krm_0556_11"><a href="#ref_krm_0556_11">↑</a> [पृष्ठम्०५२४+ २३]</li></ul></p>

चुल|चोलकः-लिका|चुचोलयिषकः-षिका|क्विपि|चोल्-चोलौ-चोलः
<ul><li><sup id="ref_krm_0557_01"><a href="#foot_krm_0557_01">1</a></sup> {@“चुल समुच्छ्राये”@} <sup id="ref_krm_0557_02"><a href="#foot_krm_0557_02">2</a></sup> चोलकः-लिका, चुचोलयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिक- चोरयतिवत् <sup id="ref_krm_0557_03"><a href="#foot_krm_0557_03">3</a></sup> ज्ञेयानि। </li> <li>सञ्चोलितम् <sup id="ref_krm_0557_04"><a href="#foot_krm_0557_04">4</a></sup>। </li> <li>क्विपि चोल्-चोलौ-चोलः;</li> <li>  इति रूपाणीति, चोलना इति स्त्रियां युचि रूपमिति च विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0557_01"><a href="#ref_krm_0557_01">↑</a> (५४७)</li> <li id="foot_krm_0557_02"><a href="#ref_krm_0557_02">↑</a> (१०-चुरादिः-१६०२। सक। सेट्। उभ।)</li> <li id="foot_krm_0557_03"><a href="#ref_krm_0557_03">↑</a> (५४६)</li> <li id="foot_krm_0557_04"><a href="#ref_krm_0557_04">↑</a> [[आ। ‘सन्दोलयन्नधिकपोलितमद्रिराजं सञ्चोलितं सुबहुमूलितशाखिबृन्दैः।।’ धा। का। ३। २१।]]</li></ul></p>

चुल्ल|चुल्लकः-ल्लिका|चुचुल्लिषकः-षिका|चोचुल्लकः-ल्लिका
<ul><li><sup id="ref_krm_0558_01"><a href="#foot_krm_0558_01">1</a></sup> {@“चुल्ल भावकरणे”@} <sup id="ref_krm_0558_02"><a href="#foot_krm_0558_02">2</a></sup> भावकरणम् = अभिप्रायाविष्कारः। </li> <li>चुल्लकः-ल्लिका, चुल्लकः-ल्लिका, चुचुल्लिषकः-षिका, चोचुल्लकः-ल्लिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकचिल्लतिवत् <sup id="ref_krm_0558_03"><a href="#foot_krm_0558_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0558_04"><a href="#foot_krm_0558_04">4</a></sup> चुल्लन्- न्ती, इति शतरि रूपम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0558_01"><a href="#ref_krm_0558_01">↑</a> (५४८)</li> <li id="foot_krm_0558_02"><a href="#ref_krm_0558_02">↑</a> (१-भ्वादिः ५३१। अक। सेट्। पर।)</li> <li id="foot_krm_0558_03"><a href="#ref_krm_0558_03">↑</a> (५२८)</li> <li id="foot_krm_0558_04"><a href="#ref_krm_0558_04">↑</a> [[B। ‘मूलं फलं वाऽप्यदतामचुल्लतां प्रफुल्लभक्त्युन्नतिचिल्लचेतसाम्।।’ धा। का। १। ६८। अचुल्लताम् = अनाविष्कृताशयानामित्यर्थः।]]</li></ul></p>

चूरी|चूरकः-रिका|चुचूरिषकः-षिका|चोचूरकः-रिका
<ul><li><sup id="ref_krm_0559_01"><a href="#foot_krm_0559_01">1</a></sup> {@“चूरी दाहे”@} <sup id="ref_krm_0559_02"><a href="#foot_krm_0559_02">2</a></sup> चूरकः-रिका, चूरकः-रिका, चुचूरिषकः-षिका, चोचूरकः-रिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि दैवादिकगूर्यतिवत् <sup id="ref_krm_0559_03"><a href="#foot_krm_0559_03">3</a></sup> बोध्यानि। </li> <li>चूरणम् <sup id="ref_krm_0559_04"><a href="#foot_krm_0559_04">4</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0559_01"><a href="#ref_krm_0559_01">↑</a> (५४९)</li> <li id="foot_krm_0559_02"><a href="#ref_krm_0559_02">↑</a> (४-दिवादिः-११५८। सक। सेट्। आत्म।)</li> <li id="foot_krm_0559_03"><a href="#ref_krm_0559_03">↑</a> (४१९)</li> <li id="foot_krm_0559_04"><a href="#ref_krm_0559_04">↑</a> [[C। ‘गूर्णेऽस्मिन् बहुजन्तुघूरिणि खले जूर्णैः शशंसे नृभिः शौरिः शूरकगर्वचूरणपरः सन्तप्यमानः सताम्।’ धा। का। २। ६०।]]</li></ul></p>

चूर्ण|चुचूर्णयिषकः-षिका|चुचूर्णयिषिता-त्री|चुचूर्णयिषन्-न्ती|चुचूर्णयिषिष्यन्-न्ती-ती|चुचूर्णयिषमाणः|चुचूर्णयिषिष्यमाणः|चुचूर्णयिट्-चुचूर्णयिषौ-चुचूर्णयिषः|चुचूर्णयिषितः-तवान्|चुचूर्णयिषुः|चुचूर्णयिषितव्यम्|चुचूर्णयिषणीयम्|चुचूर्णयिष्यम्|ईषच्चुचूर्णयिषः-दुश्चुचूर्णयिषः-सुचुचूर्णयिषः|चुचूर्णयिष्यमाणः|चुचूर्णयिषः|चुचूर्णयिषितुम्|चुचूर्णयिषा|चुचूर्णयिषणम्|चुचूर्णयिषित्वा|प्रचुचूर्णयिष्य|चुचूर्णयिषम्
<ul><li><sup id="ref_krm_0560_01"><a href="#foot_krm_0560_01">1</a></sup> {@“चूर्ण प्रेरणे”@} <sup id="ref_krm_0560_02"><a href="#foot_krm_0560_02">2</a></sup> ‘पेषणे’ इति चन्द्रः। </li> <li>अस्य धातोः क्षोदनमप्यर्थ इति धातुकाव्यव्याख्याने <sup id="ref_krm_0560_03"><a href="#foot_krm_0560_03">3</a></sup>। </li> <li><sup id="ref_krm_0560_04"><a href="#foot_krm_0560_04">4</a></sup> चूर्णक-र्णिका, चूर्णयिता-त्री, इत्यादिकानि रूपाणि भ्रमणार्थक--<sup id="ref_krm_0560_05"><a href="#foot_krm_0560_05">5</a></sup> भौवादिकघूर्णधातोर्ण्यन्तरूपाणीव बोध्यानि। </li> <li>ल्युटि <sup id="ref_krm_0560_06"><a href="#foot_krm_0560_06">6</a></sup> -चूर्णनम्। </li> <li>ण्यन्तात् सनि तु इमानि रूपाणीति विशेषः। </li> <li>चुचूर्णयिषकः-षिका, चुचूर्णयिषिता-त्री, चुचूर्णयिषन्-न्ती;</li> <li>  चुचूर्णयिषिष्यन्-न्ती-ती, चुचूर्णयिषमाणः, चुचूर्णयिषिष्यमाणः;</li> <li>  चुचूर्णयिट्-चुचूर्णयिषौ-चुचूर्णयिषः, चुचूर्णयिषितः-तवान्;</li> <li>  चुचूर्णयिषुः, चुचूर्णयिषितव्यम्, चुचूर्णयिषणीयम्, चुचूर्णयिष्यम्;</li> <li>  ईषच्चुचूर्णयिषः-दुश्चुचूर्णयिषः-सुचुचूर्णयिषः;</li> <li>  चुचूर्णयिष्यमाणः, चुचूर्णयिषः, चुचूर्णयिषितुम्, चुचूर्णयिषा;</li> <li>  चुचूर्णयिषणम्, चुचूर्णयिषित्वा, प्रचुचूर्णयिष्य, चुचूर्णयिषम् २;</li> <li>  चुचूर्णयिषित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0560_01"><a href="#ref_krm_0560_01">↑</a> (५५०)</li> <li id="foot_krm_0560_02"><a href="#ref_krm_0560_02">↑</a> (१०-चुरादिः-१५५२। सक। सेट्। उभ।)</li> <li id="foot_krm_0560_03"><a href="#ref_krm_0560_03">↑</a> (३-१५)</li> <li id="foot_krm_0560_04"><a href="#ref_krm_0560_04">↑</a> [पृष्ठम्०५२५+ २४]</li> <li id="foot_krm_0560_05"><a href="#ref_krm_0560_05">↑</a> (४७४)</li> <li id="foot_krm_0560_06"><a href="#ref_krm_0560_06">↑</a> [[आ। ‘संपक्ष्य तन्निजदृशैवमवर्णि लोकैरेषोऽजनिष्ट किल दुष्टविचूर्णनार्थम्।’ धा। का। ३। १५।]]</li></ul></p>

चूर्ण|चूर्णकः-र्णिका|चुचूर्णयिषकः-षिका
<ul><li><sup id="ref_krm_0561_01"><a href="#foot_krm_0561_01">1</a></sup> {@“चूर्ण सङ्कोचने”@} <sup id="ref_krm_0561_02"><a href="#foot_krm_0561_02">2</a></sup> ‘चूण सङ्कोचने’ इति क्षीरस्वामी पपाठ। </li> <li>चूर्णकः-र्णिका, चुचूर्णयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिक- चूर्णयतिवत् <sup id="ref_krm_0561_03"><a href="#foot_krm_0561_03">3</a></sup> बोद्ध्यानि। </li> <li>स्त्रियाम्-चूर्णना <sup id="ref_krm_0561_04"><a href="#foot_krm_0561_04">4</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0561_01"><a href="#ref_krm_0561_01">↑</a> (५५१)</li> <li id="foot_krm_0561_02"><a href="#ref_krm_0561_02">↑</a> (१०-चुरादिः-१६४२। सक। सेट्। उभ)</li> <li id="foot_krm_0561_03"><a href="#ref_krm_0561_03">↑</a> (५५०)</li> <li id="foot_krm_0561_04"><a href="#ref_krm_0561_04">↑</a> [[B। ‘सौधे विटङ्कजुषि पश्यति धूसितोऽयं राजारिकीटबलचूर्णनयाऽतिपूज्यः।’ धा। का। ३। २७।]]</li></ul></p>

