यः <ul><li id="foot_krm_0908_01"><a href="#ref_krm_0908_01">↑</a> (८९८)</li> <li id="foot_krm_0908_02"><a href="#ref_krm_0908_02">↑</a> (१-भ्वादिः-६०३। सक। सेट्। आत्म।)</li> <li id="foot_krm_0908_03"><a href="#ref_krm_0908_03">↑</a> [[B। ‘संधुक्षमाणमरिधिक्षकमूष्मजालं संवृक्ष्यवेदमतशिक्षकभिक्षुगम्यम्।’ धा। का। १। ७७।]]</li> <li id="foot_krm_0908_04"><a href="#ref_krm_0908_04">↑</a> [[२। सन्नन्ताण्ण्वुलि, ‘स्कोः संयोगाद्योरन्ते च’ (८-२-२९) इति ककारलोपे, ‘षढोः कः सि’ (८-२-४१) इति षकारस्य ककारे, सनः सकारस्य षत्वे च रूपमेवम्। संयोगादिलोपस्यासिद्धत्वात् लघूपधगुणो न। एवं सन्नन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0908_05"><a href="#ref_krm_0908_05">↑</a> [[३। क्विपि, संयोगादिलोपे, षकारस्य ‘झलां जशोऽन्ते’ (८-२-३९) इति जश्त्वे, तस्य चर्त्वविकल्पे च रूपम्।]]</li> <li id="foot_krm_0908_06"><a href="#ref_krm_0908_06">↑</a> [[४। ण्यन्तात् क्विपि, णिलोपे, संयोगान्तलोपे च रूपमेवम्।]]</li> <li id="foot_krm_0908_07"><a href="#ref_krm_0908_07">↑</a> [[५। ‘अनुदात्तेतश्च हलादेः’ (३-२-१४९) इति तच्छीलादिषु कर्तृषु युच्।]]</li> <li id="foot_krm_0908_08"><a href="#ref_krm_0908_08">↑</a> [[६। ताच्छीलिको णिनिप्रत्ययः।]]</li> <li id="foot_krm_0908_09"><a href="#ref_krm_0908_09">↑</a> [पृष्ठम्०७९६+ २७]</li></ul></p>

धिवि|धिन्वकः|न्विका|धिन्वकः-न्विका|दिधिन्विषकः-षिका|देधिन्वकः-न्विका
<ul><li><sup id="ref_krm_0909_01"><a href="#foot_krm_0909_01">1</a></sup> {@“धिवि प्रीणने”@} <sup id="ref_krm_0909_02"><a href="#foot_krm_0909_02">2</a></sup> धिन्वकः न्विका, धिन्वकः-न्विका, दिधिन्विषकः-षिका, देधिन्वकः-न्विका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि जिन्वतिवत् <sup id="ref_krm_0909_03"><a href="#foot_krm_0909_03">3</a></sup> ज्ञेयानि। </li> <li>शतरि <sup id="ref_krm_0909_04"><a href="#foot_krm_0909_04">4</a></sup> धिन्वन् ती इति रूपम्। </li> <li><sup id="ref_krm_0909_05"><a href="#foot_krm_0909_05">5</a></sup> धिन्वितम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0909_01"><a href="#ref_krm_0909_01">↑</a> (८९९)</li> <li id="foot_krm_0909_02"><a href="#ref_krm_0909_02">↑</a> (१-भ्वादिः-५९३। सक। सेट्। पर।)</li> <li id="foot_krm_0909_03"><a href="#ref_krm_0909_03">↑</a> (६०४)</li> <li id="foot_krm_0909_04"><a href="#ref_krm_0909_04">↑</a> [[१। शतरि, इदित्त्वान्नुमि, धिन्व् इति स्थिते, ‘धिन्विकृण्ब्योर च’ (३-१-८०) इति शपोऽपवादतया उप्रत्यये, तत्सन्नियोगेन धातुवकारस्याकारादेशे च कृते, उप्रत्ययस्य ‘धातोः--’ (३-१-२२) इति विहितत्वात्, तिङ्शिद्भ्यो भिन्नत्वाच्चार्धधातुकत्वेन, ‘अतो लोपः’ (६-४-४८) इति अकारस्य लोपे, यणादेशे, उगित्त्वान्नुमि च धिन्वन् इति रूपम्।]]</li> <li id="foot_krm_0909_05"><a href="#ref_krm_0909_05">↑</a> [[आ। ‘हिन्वन्तमाभीरकुलं विलासिनीर्दिन्वन्तमाधिन्वितदेवमण्डलम्।।’ धा। का। १। ७५।]]</li></ul></p>

