<ul><li><sup id="ref_krm_0008_01"><a href="#foot_krm_0008_01">1</a></sup> {@“अज गतिक्षेपणयोः”@} <sup id="ref_krm_0008_02"><a href="#foot_krm_0008_02">2</a></sup> क्षेपणम् = प्रेरणम्। </li> <li><sup id="ref_krm_0008_03"><a href="#foot_krm_0008_03">3</a></sup> वायकः-यिका, वायकः-यिका विवीषकः- <sup id="ref_krm_0008_04"><a href="#foot_krm_0008_04">4</a></sup> अजिजिषकः-षिका,;</li> <li>  वेवीयक;</li> <li>  <sup id="ref_krm_0008_05"><a href="#foot_krm_0008_05">5</a></sup> वेता-त्री, <sup id="ref_krm_0008_06"><a href="#foot_krm_0008_06">6</a></sup> अजिता-त्री, वाययिता-त्री, विवीषिता-त्री, अजिजिषिता, वेवीयिता-त्री;</li> <li>  अजन् <sup id="ref_krm_0008_07"><a href="#foot_krm_0008_07">7</a></sup> -न्ती, वाययन्-न्ती, विवीषन्-न्ती, अजिजिषन्-न्ती;</li> <li>  वेष्यन्-न्ती-ती, अजिष्यन्-ती-न्ती, बाययिष्यन्-ती-न्ती, विवीषिष्यन्-ती-न्ती, अजिजिषिष्यन्-ती-न्ती;</li> <li>  वाययमानः, वाययिष्यमाणः, वेवीयमानः, वेवीयिष्यमाणः;</li> <li>  परिवीः-परिव्यौ-परिव्यः, समक्-समजौ-समजः;</li> <li>  वीतः, अजितः-वायितम्-तः, विवीषितः, अजिजिषितः, वेवीयितः-तम्-तवान्, अजः, <sup id="ref_krm_0008_08"><a href="#foot_krm_0008_08">8</a></sup> अजा, <sup id="ref_krm_0008_09"><a href="#foot_krm_0008_09">9</a></sup> आजिः, <sup id="ref_krm_0008_10"><a href="#foot_krm_0008_10">10</a></sup> पदाजिः, <sup id="ref_krm_0008_11"><a href="#foot_krm_0008_11">11</a></sup> विवीषुः, विवाययिषुः, अजिजिषुः, आजिजयिषुः, वेबीय;</li> <li>  <sup id="ref_krm_0008_12"><a href="#foot_krm_0008_12">12</a></sup> वेतव्यम्-अजितव्यम्, वाययितव्यम्, विवीषितव्यम्, अजिजिषितव्यम्, वेवीयितव्यम्;</li> <li>  वयनीयम्, वायनीयम्, विवीषणीयम्, अजिजिषणीयम्, वेवीयनीयम्;</li> <li>  वेयम्, वाय्यम्, विवीष्यम्, अजिजिष्यम्, वेवीय्यम्;</li> <li>  ईषद्वयः, दुर्वयः, सुवयः;</li> <li>  वीयमानः, वाय्यमानः, विवीष्यमाणः, अजिजिष्यमाणः;</li> <li>  वेवीय्यमानः;</li> <li>  <sup id="ref_krm_0008_13"><a href="#foot_krm_0008_13">13</a></sup> समजः, <sup id="ref_krm_0008_14"><a href="#foot_krm_0008_14">14</a></sup> समाजः <sup id="ref_krm_0008_15"><a href="#foot_krm_0008_15">15</a></sup>, उदाजः, -वायः, वात <sup id="ref_krm_0008_16"><a href="#foot_krm_0008_16">16</a></sup> मजा <sup id="ref_krm_0008_17"><a href="#foot_krm_0008_17">17</a></sup> ः <sup id="ref_krm_0008_18"><a href="#foot_krm_0008_18">18</a></sup>, व्यजः <sup id="ref_krm_0008_19"><a href="#foot_krm_0008_19">19</a></sup>, व्याजः <sup id="ref_krm_0008_20"><a href="#foot_krm_0008_20">20</a></sup>;</li> <li>  वेतुम्, अजितुम्, वाययितुम्, विवीषितुम्, अजिजिषितुम्, वेवीयितुम्;</li> <li>  वीतिः, अक्तिः, <sup id="ref_krm_0008_21"><a href="#foot_krm_0008_21">21</a></sup> समज्या, वायना, विवीषा, विवाययिषा, अजिजिषा, आजिजयिषा, वेवीया;</li> <li>  प्रवयणम् <sup id="ref_krm_0008_22"><a href="#foot_krm_0008_22">22</a></sup> -प्राजनम्, वायनम्, विवीषणम्, अजिजिषणम्, वेवीयनम्;</li> <li>  वीत्वा, अजित्वा, वाययित्वा, विवीषित्वा, अजिजिषित्वा, वेवीयित्वा;</li> <li>  प्रवीय, प्राज्य, प्रवाय्य, प्रविवीष्य, प्राजिजिष्य, प्रवेवीय्य;</li> <li>  वायम् २, वीत्वा २, अजित्वा २, वायम् २ वाययित्वा २, विवीषम् २, विवीषित्वा २, अजिजिषम् २, अजिजिषित्वा २, वेवीयम् २, वेवीयित्वा २;</li> <li>  औणादिके = अजिनम् <sup id="ref_krm_0008_23"><a href="#foot_krm_0008_23">23</a></sup> -अजिरम् <sup id="ref_krm_0008_24"><a href="#foot_krm_0008_24">24</a></sup>;</li> <li>  <sup id="ref_krm_0008_25"><a href="#foot_krm_0008_25">25</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0008_01"><a href="#ref_krm_0008_01">↑</a> (९)</li> <li id="foot_krm_0008_02"><a href="#ref_krm_0008_02">↑</a> (भ्वादिः-१-२३०-सक। सेट्-पर-)</li> <li id="foot_krm_0008_03"><a href="#ref_krm_0008_03">↑</a> [[१। ‘अजेर्व्यघञपोः’ (२-४-५६) इति वीभावः।]]</li> <li id="foot_krm_0008_04"><a href="#ref_krm_0008_04">↑</a> [[२। ‘वलादावार्धधातुके वेष्यते’ (२-४-५६ वा) इति वा वीभावः।]]</li> <li id="foot_krm_0008_05"><a href="#ref_krm_0008_05">↑</a> [[१। आ। आर्धधातुकविवक्षायां वीभावात् हलादित्वात् यङ्।]]</li> <li id="foot_krm_0008_06"><a href="#ref_krm_0008_06">↑</a> [[२। ‘वलादावार्धधातुके वेष्यते’ (२-४-५६ वा) इति वा वीभावः।]]</li> <li id="foot_krm_0008_07"><a href="#ref_krm_0008_07">↑</a> [[आ। ‘अकर्जितोऽसौ हरिखर्जनोत्कधीः अजत्पशुब्रातमजेन तेजितम्’ धा-का-१-३१।]]</li> <li id="foot_krm_0008_08"><a href="#ref_krm_0008_08">↑</a> [[आ। ‘अकर्जितोऽसौ हरिखर्जनोत्कधीः अजत्पशुब्रातमजेन तेजितम्’ धा-का-१-३१।]]</li> <li id="foot_krm_0008_09"><a href="#ref_krm_0008_09">↑</a> [[३। ‘अजाद्यतष्टाप्’ (४-१-४) इति टाप्]]</li> <li id="foot_krm_0008_10"><a href="#ref_krm_0008_10">↑</a> [[४। ‘अज्यतिभ्याम्--पादे च’ (४-१३१) इत्यौणादिकः इण् प्रत्ययः।]]</li> <li id="foot_krm_0008_11"><a href="#ref_krm_0008_11">↑</a> [[४। ‘अज्यतिभ्याम्--पादे च’ (४-१३१) इत्यौणादिकः इण् प्रत्ययः।]]</li> <li id="foot_krm_0008_12"><a href="#ref_krm_0008_12">↑</a> [पृष्ठम्०००९+ ३९]</li> <li id="foot_krm_0008_13"><a href="#ref_krm_0008_13">↑</a> [[१। ‘समुदोरजः पशुषु’ (३-३-६९) इत्यपू।]]</li> <li id="foot_krm_0008_14"><a href="#ref_krm_0008_14">↑</a> [[१आ ‘अजिव्रज्योश्च’ (७-३-६०) इति कुत्वं न भवति। ‘पशूनां समजो ऽन्येषां समाजोऽथ सधर्मिणाम्’ इति अमरकोशः।]]</li> <li id="foot_krm_0008_15"><a href="#ref_krm_0008_15">↑</a> [[B। ‘गुहाद्वारेण निर्यातः समजेन पशूनिव’ भट्टिकाव्ये-७-५९।]]</li> <li id="foot_krm_0008_16"><a href="#ref_krm_0008_16">↑</a> [[C। ‘मेघात्ययोपात्तवनोपशोभं कदम्बकं वातमजं मृगाणाम्’ भ-का-२-१७।]]</li> <li id="foot_krm_0008_17"><a href="#ref_krm_0008_17">↑</a> [[२। ‘वातशुनीतिलशर्घेषु अजधेट्जहातीनां’ (वा। ३-२-२८) इति खश्। मुम्। सार्वधातुकत्वान्न वीभावः।]]</li> <li id="foot_krm_0008_18"><a href="#ref_krm_0008_18">↑</a> (मृगाः)</li> <li id="foot_krm_0008_19"><a href="#ref_krm_0008_19">↑</a> [[३। ‘गोचरसंचरवहव्रजव्यज-’ (३-३-११९) इति घान्तो निपातितः।]]</li> <li id="foot_krm_0008_20"><a href="#ref_krm_0008_20">↑</a> [[ड्। ‘निर्व्याजमिज्या ववृते वचश्च भूयो बभाषे मुनिना कुमारः’ भ-का-२-३७।]]</li> <li id="foot_krm_0008_21"><a href="#ref_krm_0008_21">↑</a> [[४। ‘संज्ञायां समज-’ (३-३-९९) इति स्त्रियां क्यप्। निपातनात् वीभावो न।]]</li> <li id="foot_krm_0008_22"><a href="#ref_krm_0008_22">↑</a> [[५। ‘वा यौ’ (२-४-५७) इति वीभावो वा।]]</li> <li id="foot_krm_0008_23"><a href="#ref_krm_0008_23">↑</a> [[६। अजिनम् = चर्म। अजति-वीयते वा तत्-कर्म, कर्ता वा। इन प्रत्ययः।]]</li> <li id="foot_krm_0008_24"><a href="#ref_krm_0008_24">↑</a> [[७। अजिरम् = वेश्म। अजन्त्यस्मिन् इत्यधिकरणे किर प्रत्ययः।]]</li> <li id="foot_krm_0008_25"><a href="#ref_krm_0008_25">↑</a> [पृष्ठम्००१०+ २७]</li></ul></p>

