<ul><li><sup id="ref_krm_0902_01"><a href="#foot_krm_0902_01">1</a></sup> {@“धण शब्दे”@} <sup id="ref_krm_0902_02"><a href="#foot_krm_0902_02">2</a></sup> ‘ध्वण’ इत्यस्य पाठभेदोऽयम्। </li> <li>धाणकः-णिका, धाणकः-णिका, दिधणिषकः-षिका, दन्धणकः-दंधणकः- णिका;</li> <li>  इत्यादीनि सर्वाणि रूपाणि कणतिवत् <sup id="ref_krm_0902_03"><a href="#foot_krm_0902_03">3</a></sup> बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0902_01"><a href="#ref_krm_0902_01">↑</a> (८९२)</li> <li id="foot_krm_0902_02"><a href="#ref_krm_0902_02">↑</a> (१-भ्वादिः-४५३। अक। सेट्। पर।)</li> <li id="foot_krm_0902_03"><a href="#ref_krm_0902_03">↑</a> (१५७)</li></ul></p>

धन|धानकः-निका|दिधनिषकः-षिका|दन्धनकः|दंधनकः-निका
<ul><li><sup id="ref_krm_0903_01"><a href="#foot_krm_0903_01">1</a></sup> {@“धन धान्ये”@} <sup id="ref_krm_0903_02"><a href="#foot_krm_0903_02">2</a></sup> छान्दसः। </li> <li>‘धान्ये = धान्यार्जने, इत्यर्थः’ इति सि। </li> <li>कौमुदी। </li> <li>धानकः-निका, धानकः-निका, दिधनिषकः-षिका, दन्धनकः, दंधनकः-निका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि जननार्थकजनधातुवत् <sup id="ref_krm_0903_03"><a href="#foot_krm_0903_03">3</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_0903_04"><a href="#foot_krm_0903_04">4</a></sup> धनुः, <sup id="ref_krm_0903_05"><a href="#foot_krm_0903_05">5</a></sup> धनुः इति रूपाणि विशेषः। </li> <li><sup id="ref_krm_0903_06"><a href="#foot_krm_0903_06">6</a></sup> प्रधनम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0903_01"><a href="#ref_krm_0903_01">↑</a> (८९३)</li> <li id="foot_krm_0903_02"><a href="#ref_krm_0903_02">↑</a> (३-जुहोत्यादिः-११०४। अक। सेट्। पर।)</li> <li id="foot_krm_0903_03"><a href="#ref_krm_0903_03">↑</a> (५८२)</li> <li id="foot_krm_0903_04"><a href="#ref_krm_0903_04">↑</a> [[१। ‘कृषिचमितनिधनि--’ (द। उ। १-१६४) इति ऊप्रत्ययो भवति। धनूः = धान्यनिचयः, पृथिवी इत्यर्थः।]]</li> <li id="foot_krm_0903_05"><a href="#ref_krm_0903_05">↑</a> [[२। ‘अर्तिपॄवपियजिधनि--’ (द। उ। ९। ३९) इति उसिप्रत्यये एवं रूपम्। दधन्तीति धनुः = शरासनम्।]]</li> <li id="foot_krm_0903_06"><a href="#ref_krm_0903_06">↑</a> [[B। ‘घर्मोष्मभिस्तत्र समारताग्रे नभस्तुरैस्तैः प्रधने प्रवीणैः।।’ धा। का। २। ५५।]]</li></ul></p>

धवि|धन्वकः-न्विका|दिधन्विषकः-षिका|दाधन्वकः-न्विका
<ul><li><sup id="ref_krm_0904_01"><a href="#foot_krm_0904_01">1</a></sup> {@“धवि गत्यर्थः”@} <sup id="ref_krm_0904_02"><a href="#foot_krm_0904_02">2</a></sup> धन्वकः-न्विका, धन्वकः-न्विका, दिधन्विषकः-षिका, दाधन्वकः-न्विका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि कन्दतिवत् <sup id="ref_krm_0904_03"><a href="#foot_krm_0904_03">3</a></sup> ऊह्यानि। </li> <li><sup id="ref_krm_0904_04"><a href="#foot_krm_0904_04">4</a></sup> धन्वा <sup id="ref_krm_0904_05"><a href="#foot_krm_0904_05">5</a></sup> इति विशेषः। </li> <li><sup id="ref_krm_0904_06"><a href="#foot_krm_0904_06">6</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0904_01"><a href="#ref_krm_0904_01">↑</a> (८९४)</li> <li id="foot_krm_0904_02"><a href="#ref_krm_0904_02">↑</a> (१-भ्वादिः-५९७। अक। सेट्। पर।)</li> <li id="foot_krm_0904_03"><a href="#ref_krm_0904_03">↑</a> (१६३)</li> <li id="foot_krm_0904_04"><a href="#ref_krm_0904_04">↑</a> [[३। ‘कनिन्युवृषितक्षिराजिधन्वि--’ (द। उ। ६। ५१) इति कनिन्प्रत्यये एवं रूपम्। धन्वा = कुत्सितो देशः, मरुप्रदेशः।]]</li> <li id="foot_krm_0904_05"><a href="#ref_krm_0904_05">↑</a> [[C। ‘जिन्वन्तमुर्वीं निजरिण्वनैः सतां रण्वन्तमन्तर्भवधन्वपादपम्।’ धा। का। १। ७६।]]</li> <li id="foot_krm_0904_06"><a href="#ref_krm_0904_06">↑</a> [पृष्ठम्०७८९+ २७]</li></ul></p>

डु|धायकः-यिका|धापकः-पिका|धित्सकः-त्सिका|देधीयकः-यिका|धाता-धात्री|धापयिता-त्री|धित्सिता-त्री|देधीयिता-त्री|प्रणिदधत्-दधती|धापयन्-न्ती|धित्सन्-न्ती|-|धास्यन्-न्ती-ती|धापयिष्यन्-न्ती-ती|धित्सिष्यन्-न्ती-ती|-प्रणिदधानः|धापयमानः|धित्समानः|देधीयमानः|धास्यमानः|धापयिष्यमाणः|धित्सिष्यमाणः|देधीयिष्यमाणः|रत्नधाः-धौ-धाः|-हितम्-प्रणिहितः-हितवान्|धापितः|धित्सितः|देधीयितः-तवान्|प्रधः|दधः|धायः|किष्किन्धा|धामा|धीवा-धीवरी|बहुधीवरी|शिरोधिः-विधिः|प्रणिधिः|बालधिः-उपाधिः|भूतधात्री|श्रद्धालुः|विधेयः|विधाता|धापः|धित्सुः|दाधाः|धातव्यम्|धापयितव्यम्|धित्सितव्यम्|देधीयितव्यम्|प्रणिधानीयम्|धापनीयम्|धित्सनीयम्|देधीयनीयम्|धेयम्|धाय्याधाप्यम्|धित्स्यम्|देधीय्यम्|ईषद्धानम्-दुर्धानम्-सुधानम्|-धीयमानः|धाप्यमानः|धित्स्यमानः|देधीय्यमानः|धात्री|उपधिः-निधिः|अन्तर्धिः-उदधिः|सन्धिः-सुषन्धिः-दुष्षन्धिः|दधि|हित्रिमम्धापः|धित्सः|देधीयः|धातुम्|धापयितुम्|धित्सितुम्|देधीयितुम्|हितिः|अभिधा-श्रद्धा|उपधा|धापना|धित्सा|देधीया|प्रणिधानम्-अपिधानम्-पिधानम्|धापनम्|धित्सनम्|देधीयनम्|हित्वा|धापयित्वा|धित्सित्वा|देधीयित्वा|प्रधाय-निधाय|प्रधाप्य|प्रधित्स्य|प्रदेधीय्य|घृतनिधायं|निहितं|गोत्राभिधायम्|धायम्|धापम्|धित्सम्|देधीयम्
<ul><li><sup id="ref_krm_0905_01"><a href="#foot_krm_0905_01">1</a></sup> {@“डु धाञ् धारणपोषणयोः”@} <sup id="ref_krm_0905_02"><a href="#foot_krm_0905_02">2</a></sup> <sup id="ref_krm_0905_03"><a href="#foot_krm_0905_03">3</a></sup> ‘डु धाञ् दानधारणयोः’ इति क्षीरस्वामी। </li> <li>निरुक्ते <sup id="ref_krm_0905_04"><a href="#foot_krm_0905_04">4</a></sup> “रत्नधात- मम् = रमणीयानां धनानां दातृतमम्।” इति विवरणमप्यत्रैवानुकूलतया दृश्यते। </li> <li>मैत्रैयरक्षितप्रभृतिभिरस्य धातोर्दानार्थत्वमष्यङ्गीकृतम्।]] ‘घेटो धयति पानार्थे, धाञो धत्ते दधात्यपि।’ <sup id="ref_krm_0905_05"><a href="#foot_krm_0905_05">5</a></sup> इति देवः। </li> <li><sup id="ref_krm_0905_06"><a href="#foot_krm_0905_06">6</a></sup> धायकः-यिका, <sup id="ref_krm_0905_07"><a href="#foot_krm_0905_07">7</a></sup> धापकः-पिका, <sup id="ref_krm_0905_08"><a href="#foot_krm_0905_08">8</a></sup> धित्सकः-त्सिका, <sup id="ref_krm_0905_09"><a href="#foot_krm_0905_09">9</a></sup> देधीयकः-यिका;</li> <li>  धाता-धात्री, धापयिता-त्री, धित्सिता-त्री, देधीयिता-त्री;</li> <li>  <sup id="ref_krm_0905_10"><a href="#foot_krm_0905_10">10</a></sup> प्रणिदधत्-दधती, धापयन्-न्ती, धित्सन्-न्ती;</li> <li>  -- धास्यन्-न्ती-ती, धापयिष्यन्-न्ती-ती, धित्सिष्यन्-न्ती-ती;</li> <li>  -- <sup id="ref_krm_0905_11"><a href="#foot_krm_0905_11">11</a></sup> प्रणिदधानः, धापयमानः, धित्समानः, देधीयमानः;</li> <li>  धास्यमानः, धापयिष्यमाणः, धित्सिष्यमाणः, देधीयिष्यमाणः;</li> <li>  रत्नधाः-धौ-धाः;</li> <li>  -- -- -- <sup id="ref_krm_0905_12"><a href="#foot_krm_0905_12">12</a></sup> हितम्- <sup id="ref_krm_0905_13"><a href="#foot_krm_0905_13">13</a></sup> प्रणिहितः-हितवान्, धापितः, धित्सितः, देधीयितः-तवान्;</li> <li>  <sup id="ref_krm_0905_14"><a href="#foot_krm_0905_14">14</a></sup> <sup id="ref_krm_0905_15"><a href="#foot_krm_0905_15">15</a></sup> प्रधः, <sup id="ref_krm_0905_16"><a href="#foot_krm_0905_16">16</a></sup> दधः <sup id="ref_krm_0905_17"><a href="#foot_krm_0905_17">17</a></sup>, <sup id="ref_krm_0905_18"><a href="#foot_krm_0905_18">18</a></sup> धायः, <sup id="ref_krm_0905_19"><a href="#foot_krm_0905_19">19</a></sup> किष्किन्धा <sup id="ref_krm_0905_20"><a href="#foot_krm_0905_20">20</a></sup>, <sup id="ref_krm_0905_21"><a href="#foot_krm_0905_21">21</a></sup> धामा, <sup id="ref_krm_0905_22"><a href="#foot_krm_0905_22">22</a></sup> धीवा-धीवरी, बहुधीवरी, <sup id="ref_krm_0905_23"><a href="#foot_krm_0905_23">23</a></sup> शिरोधिः-विधिः, प्रणिधिः, बालधिः <sup id="ref_krm_0905_24"><a href="#foot_krm_0905_24">24</a></sup> -उपाधिः, <sup id="ref_krm_0905_25"><a href="#foot_krm_0905_25">25</a></sup> भूतधात्री, <sup id="ref_krm_0905_26"><a href="#foot_krm_0905_26">26</a></sup> श्रद्धालुः, <sup id="ref_krm_0905_27"><a href="#foot_krm_0905_27">27</a></sup> <sup id="ref_krm_0905_28"><a href="#foot_krm_0905_28">28</a></sup> विधेयः, <sup id="ref_krm_0905_29"><a href="#foot_krm_0905_29">29</a></sup> विधाता, धापः, धित्सुः, <sup id="ref_krm_0905_30"><a href="#foot_krm_0905_30">30</a></sup> दाधाः;</li> <li>  <sup id="ref_krm_0905_31"><a href="#foot_krm_0905_31">31</a></sup> धातव्यम्, धापयितव्यम्, धित्सितव्यम्, देधीयितव्यम्;</li> <li>  प्रणिधानीयम्, धापनीयम्, धित्सनीयम्, देधीयनीयम्;</li> <li>  धेयम्, <sup id="ref_krm_0905_32"><a href="#foot_krm_0905_32">32</a></sup> धाय्या <sup id="ref_krm_0905_33"><a href="#foot_krm_0905_33">33</a></sup> <sup id="ref_krm_0905_34"><a href="#foot_krm_0905_34">34</a></sup> धाप्यम्, धित्स्यम्, देधीय्यम्;</li> <li>  ईषद्धानम्-दुर्धानम्-सुधानम्;</li> <li>  -- -- -- <sup id="ref_krm_0905_35"><a href="#foot_krm_0905_35">35</a></sup> धीयमानः, धाप्यमानः, धित्स्यमानः, देधीय्यमानः;</li> <li>  <sup id="ref_krm_0905_36"><a href="#foot_krm_0905_36">36</a></sup> धात्री, <sup id="ref_krm_0905_37"><a href="#foot_krm_0905_37">37</a></sup> उपधिः-निधिः, <sup id="ref_krm_0905_38"><a href="#foot_krm_0905_38">38</a></sup> अन्तर्धिः- <sup id="ref_krm_0905_39"><a href="#foot_krm_0905_39">39</a></sup> उदधिः सन्धिः- <sup id="ref_krm_0905_40"><a href="#foot_krm_0905_40">40</a></sup> सुषन्धिः-दुष्षन्धिः, <sup id="ref_krm_0905_41"><a href="#foot_krm_0905_41">41</a></sup> दधि;</li> <li>  <sup id="ref_krm_0905_42"><a href="#foot_krm_0905_42">42</a></sup> धायः, <sup id="ref_krm_0905_43"><a href="#foot_krm_0905_43">43</a></sup> हित्रिमम् <sup id="ref_krm_0905_44"><a href="#foot_krm_0905_44">44</a></sup> धापः, धित्सः, देधीयः;</li> <li>  धातुम्, धापयितुम्, धित्सितुम्, देधीयितुम्;</li> <li>  हितिः, <sup id="ref_krm_0905_45"><a href="#foot_krm_0905_45">45</a></sup> अभिधा- <sup id="ref_krm_0905_46"><a href="#foot_krm_0905_46">46</a></sup> श्रद्धा, <sup id="ref_krm_0905_47"><a href="#foot_krm_0905_47">47</a></sup> उपधा, धापना, धित्सा, देधीया;</li> <li>  प्रणिधानम्-अपिधानम्- <sup id="ref_krm_0905_48"><a href="#foot_krm_0905_48">48</a></sup> पिधानम्, धापनम्, धित्सनम्, देधीयनम्;</li> <li>  हित्वा, धापयित्वा, धित्सित्वा, देधीयित्वा;</li> <li>  <sup id="ref_krm_0905_49"><a href="#foot_krm_0905_49">49</a></sup> प्रधाय-निधाय, प्रधाप्य, प्रधित्स्य, प्रदेधीय्य;</li> <li>  <sup id="ref_krm_0905_50"><a href="#foot_krm_0905_50">50</a></sup> घृतनिधायं निहितं <sup id="ref_krm_0905_51"><a href="#foot_krm_0905_51">51</a></sup>, <sup id="ref_krm_0905_52"><a href="#foot_krm_0905_52">52</a></sup> गोत्राभिधायम्, <sup id="ref_krm_0905_53"><a href="#foot_krm_0905_53">53</a></sup> धायम् २, हित्वा २, धापम् २, धापयित्वा २, धित्सम् २, धित्सित्वा २, देधीयम् २;</li> <li>  देधीयित्वा २;</li> <li>  <sup id="ref_krm_0905_54"><a href="#foot_krm_0905_54">54</a></sup> तुन्प्रत्यये रूपम्। </li> <li>दधात्यर्थम्, धीयतेऽस्मिन्नर्थ इति वा धातुः = शब्दप्रकृतिः, पर्वतनिस्रावो वा।]] धातुः, <sup id="ref_krm_0905_55"><a href="#foot_krm_0905_55">55</a></sup> इति कूप्रत्ययान्तो निपातितः। </li> <li>एवं शकन्धूरपि। </li> <li>धातव्याऽसौ इति दिधिषूः। </li> <li>अस्यैव धातोः कूप्रत्यये द्विर्वचनम्, षुगागम इत्वं च निपात्यन्ते।]] कर्कन्धूः-शकन्धूः-दिधिषूः, <sup id="ref_krm_0905_56"><a href="#foot_krm_0905_56">56</a></sup> आनकप्रत्यये रूपम्। </li> <li>धानकः = सुवर्णपरिमाणम्।]] धानकः, <sup id="ref_krm_0905_57"><a href="#foot_krm_0905_57">57</a></sup> क्युप्रत्यये रूपम्। </li> <li>निधनम् = विनाशः। </li> <li>बाहुलकाद् धनमित्यपि क्युप्रत्यय एव बोध्यः।]] निधनम्-धनम्, <sup id="ref_krm_0905_58"><a href="#foot_krm_0905_58">58</a></sup> <sup id="ref_krm_0905_59"><a href="#foot_krm_0905_59">59</a></sup> इति नप्रत्यये रूपम्। </li> <li>धीयन्ते यासां विकारैः प्राणिन इति धानाः = यवविकाराः।]] धानाः, <sup id="ref_krm_0905_60"><a href="#foot_krm_0905_60">60</a></sup> इति यन्प्रत्यये नुडागमो विधीयते।]] धान्यम्, <sup id="ref_krm_0905_61"><a href="#foot_krm_0905_61">61</a></sup> इति क्रन्प्रत्यये ईत्वे च रूपम्। </li> <li>दधाति आपत्सु चित्तमिति धीरः = सत्त्ववान्।]] धीरः, <sup id="ref_krm_0905_62"><a href="#foot_krm_0905_62">62</a></sup> इति विपूर्वाद्धाञोऽसिप्रत्ययः, वेध इति इत्ययं चादेशः। </li> <li>विदधाति प्रजाः इति वेधाः = ब्रह्मा।]] वेघाः, <sup id="ref_krm_0905_63"><a href="#foot_krm_0905_63">63</a></sup> इत्येभिः असिप्रत्ययो विधीयते। </li> <li>डिच्चायम्, तेन टेर्लोपः। </li> <li>वयोधाः = प्राणी चन्द्रश्च। </li> <li>पयोधाः = समुद्रः। </li> <li>पुरोधाः = उपाध्यायः।]] वयोधाः-पुरोधाः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0905_01"><a href="#ref_krm_0905_01">↑</a> (८९५)</li> <li id="foot_krm_0905_02"><a href="#ref_krm_0905_02">↑</a> (३-जुहोत्यादिः-१०९२-सक। अनि। उभ।)</li> <li id="foot_krm_0905_03"><a href="#ref_krm_0905_03">↑</a> [[[अ]</li> <li id="foot_krm_0905_04"><a href="#ref_krm_0905_04">↑</a> (७-१५)</li> <li id="foot_krm_0905_05"><a href="#ref_krm_0905_05">↑</a> (श्लो। ६)</li> <li id="foot_krm_0905_06"><a href="#ref_krm_0905_06">↑</a> [[१। ण्वुलि, ‘आतो युक् चिण्कृतोः’ (७-३-३३) इति युगागमः। एवं घञि णमुल्प्र- भृतिष्वपि ज्ञेयम्।]]</li> <li id="foot_krm_0905_07"><a href="#ref_krm_0905_07">↑</a> [[२। ण्यन्तात् ण्वुलि, आदन्तलक्षणः पुगागमः। ण्यन्ते सर्वत्र एवमेवेति ज्ञेयम्।]]</li> <li id="foot_krm_0905_08"><a href="#ref_krm_0905_08">↑</a> [[३। ‘दाधा ध्वदाप्’ (१-१-२०) इति घुसंज्ञायाम् ‘सनि मीमाघु--’ (७-४-५४) इत्यादिना सन्नन्ते आकारस्य इस्। ‘सः स्यार्धधातुके’ (७-४-४९) इति सकारस्य तकारे, ‘अत्र लोपोऽभ्यासस्य’ (७-४-५८) इत्यभ्यासलोपः। ‘इको झल्’ (१-२-९) इति सनः कित्त्वान्न गुणः। एवं सन्नन्ते सर्वत्र प्रक्रिया ज्ञेया।]]</li> <li id="foot_krm_0905_09"><a href="#ref_krm_0905_09">↑</a> [[४। यङन्ताण्ण्वुलि, ‘घुमास्था--’ (६-४-६६) इत्यादिना ईत्वे, द्विर्वचनादिकम्। अभ्यासे गुणः। यङन्ते सर्वत्रैवमेव।]]</li> <li id="foot_krm_0905_10"><a href="#ref_krm_0905_10">↑</a> [[५। शतरि, ‘जुहोत्यादिभ्यः--’ (२-४-७५) इति शपः श्लुः। ‘श्लौ’ (६-१-१०) इति द्विर्वचनम्। ‘श्नाऽभ्यस्तयोरातः’ (६-४-११२) इत्याकारलोपः। ‘नेर्गदनदपतपदघुमा--’ (८-४-१७) इत्यादिना उपसर्गस्थान्निमित्तात् परस्य नेः णत्वम्। ‘नाभ्यस्ताच्छतुः’ (७-१-७८) इति नुम्निषेधः।]]</li> <li id="foot_krm_0905_11"><a href="#ref_krm_0905_11">↑</a> [[आ। ‘अस्रावि भूमिपतिभिः क्षणवीतनिद्रैरश्नन् पुरो हरितकं मुदमादधानः।’ शि। व। ५। ५८।]]</li> <li id="foot_krm_0905_12"><a href="#ref_krm_0905_12">↑</a> [[६। निष्ठायाम्, ‘दधातेर्हिः’ (७-४-४२) इति प्रकृतेः हिः आदेशः। एवं तकारादौ किति प्रत्यये सर्वत्र (क्त्वा, क्तिन्प्रभृतिषु) ज्ञेयम्।]]</li> <li id="foot_krm_0905_13"><a href="#ref_krm_0905_13">↑</a> [[B। ‘ततः प्रणिहितः स्वार्थे राक्षसेन्द्रं बिभीषणः।।’ भ। का। ९। ९९।]]</li> <li id="foot_krm_0905_14"><a href="#ref_krm_0905_14">↑</a> [पृष्ठम्०७९०+ ३२]</li> <li id="foot_krm_0905_15"><a href="#ref_krm_0905_15">↑</a> [[१। ‘आतश्चोपसर्गे’ (३-१-१३६) इति कर्तरि कप्रत्ययः।]]</li> <li id="foot_krm_0905_16"><a href="#ref_krm_0905_16">↑</a> [[२। ‘ददातिदधात्योर्विभाषा’ (३-१-१३९) इति शप्रत्यये, शित्त्वात् शपि, तस्य श्लौ, द्विर्वचने, शप्रत्ययस्य सार्वधातुकत्वेन ‘श्नाऽभ्यस्तयोः--’ (६-४-११२) इत्या- कारलोपे च दधः इति रूपम्।]]</li> <li id="foot_krm_0905_17"><a href="#ref_krm_0905_17">↑</a> [[आ। ‘नभस्स्पृगूर्मिस्तितरीषतोऽस्य हरे दधस्यैकपदीमदात् सः।।’ वा। वि। ३। ३८।]]</li> <li id="foot_krm_0905_18"><a href="#ref_krm_0905_18">↑</a> [[३। दधातेरस्य शप्रत्ययस्य विभाषितत्वात् पक्षे, ‘श्याऽऽद्व्यध--’ (३-१-१४१) इत्यादिना कर्तरि णप्रत्यये, युगागमे च धायः इति रूपम्।]]</li> <li id="foot_krm_0905_19"><a href="#ref_krm_0905_19">↑</a> [[४। किं किं दधातीत्यर्थे ‘आतोऽनुपसर्गे कः’ (३-२-३) इति कर्मण्युपपदे कर्तरि कप्रत्यये, ‘पारस्करप्रमृतीनि च’ (६-१-१५७) इति सुडागमे, किमो मकारस्य लोपः षत्वं च भवति।]]</li> <li id="foot_krm_0905_20"><a href="#ref_krm_0905_20">↑</a> [[B। ‘किष्किन्धाद्रिसदात्यर्थं निष्पिष्टः कोष्णमुच्छ्वसन्।।’ भ। का। ६। १२१।]]</li> <li id="foot_krm_0905_21"><a href="#ref_krm_0905_21">↑</a> [[५। ‘अन्येभ्योऽपि दृश्यन्ते’ (३-२-७५) इति निरुपपदादस्मात् मनिन्प्रत्यये रूपम्।]]</li> <li id="foot_krm_0905_22"><a href="#ref_krm_0905_22">↑</a> [[६। ‘अन्येभ्योऽपि दृश्यन्ते’ (३-२-७५) इति निरुपपदादस्मात् क्वनिप्प्रत्यये, ईत्वे, रूपम्। स्त्रियाम्, ‘वनो र च’ (४-१-७) इति ङीब्रेफौ। बहुधीवा बहुधीवरी इत्यत्र तु ‘अनो बहुव्रीहेः’ (४-१-१२) इति निषेधात् ङीबभावः, ‘डाबुभाभ्या- मन्यतरस्याम्’ (४-१-१३) इति पाक्षिकः ङीप् रेफः डाप् च भवति।]]</li> <li id="foot_krm_0905_23"><a href="#ref_krm_0905_23">↑</a> [[७। शिरो धत्ते इति शिरोधिः = ग्रीवा। बाहुलकात् कर्तरि किप्रत्यये, ‘आतो लोप इटि च’ (६-४-६४) इत्याकारलोपः। केचित्तु शिरो धीयते अस्यामिति विगृह्य ‘कर्मण्यधिकरणे च’ (३-३-९३) इति किप्रत्यये निष्पादयन्ति। विधिः, प्रणिधिः इत्यादिषु तु कर्तर्येव किप्रत्ययः बाहुलकात्।]]</li> <li id="foot_krm_0905_24"><a href="#ref_krm_0905_24">↑</a> [[C। ‘आनिन्यिरे श्रेणिकृतास्तथाऽन्यैः परस्परं चालधिसंनिबद्धाः।।’ भ। का। ११। ४२।]]</li> <li id="foot_krm_0905_25"><a href="#ref_krm_0905_25">↑</a> [[८। भूतानि धत्ते इति भूतधात्री = पृथिवी। बाहुलकात् कर्तरि ष्ट्रन्प्रत्यये, स्त्रियां षित्त्वात् ङीष्।]]</li> <li id="foot_krm_0905_26"><a href="#ref_krm_0905_26">↑</a> [[९। तच्छीलादिषु कर्तृषु ‘स्पृहिगृहिपतिदयिनिद्रातन्द्राश्रद्धाभ्य आलुच्’ (३-२-१५८) इत्यालुच्प्रत्ययः।]]</li> <li id="foot_krm_0905_27"><a href="#ref_krm_0905_27">↑</a> [[ड्। ‘श्रद्धालुर्भ्रातुरङ्गानि चन्दनेष्वप्यरोचकी।।’ अनर्घराघबे। ७। १४३।]]</li> <li id="foot_krm_0905_28"><a href="#ref_krm_0905_28">↑</a> [[१०। ‘अर्हे कृत्यतृचश्च’ (३-३-१६९) इति कर्तरि यत्प्रत्ययः। ‘ईद्यति’ (६-४-६५) इति धातोरीत्वे गुणः।]]</li> <li id="foot_krm_0905_29"><a href="#ref_krm_0905_29">↑</a> [[११। विदधातीति विधाता = ब्रह्मा। ‘तृन्’ (३-२-१३५) ताच्छीलिकस्तृन्प्रत्ययः।]]</li> <li id="foot_krm_0905_30"><a href="#ref_krm_0905_30">↑</a> [[१२। यङन्तात् पचाद्यचि यङो लुकि ईत्वाभावे, अभ्यासे ‘दीर्घोऽकितः’ (७-४-८३) इति दीर्घः।]]</li> <li id="foot_krm_0905_31"><a href="#ref_krm_0905_31">↑</a> [पृष्ठम्०७९१+ २७]</li> <li id="foot_krm_0905_32"><a href="#ref_krm_0905_32">↑</a> [[१। सामिधेनीरूपऋत्विग्विशेषवाचित्वे सति, ‘पाय्यसान्नाय्यनिकाय्यधाय्या मानह- विर्निवाससामिधेनीषु’ (३-१-१२९) इत्यनेन ण्यत् आयादेशश्च निपात्येते। ‘धाय्येति न सर्वा सामिधेन्युच्यते, किं तर्हि? काचिदेव। रूढिशब्दो ह्ययम्। तथा च असामिधेन्यामपि दृश्यते-- ‘धाथ्याः शंसत्यग्निर्नेता त्वं सोमक्रतुभिः।’ इति काशिकाऽत्रानुसन्धेया। ‘सामिधेन्यभिधास्वृक्षु काचिद्धाय्येति कथ्यते। शस्त्रादिष्वपि धाय्याऽस्ति तेनैतदुपलक्षणम्।।’ इति प्रक्रियासर्वस्व श्लोकोऽ- प्यत्रानुसन्धेयः।]]</li> <li id="foot_krm_0905_33"><a href="#ref_krm_0905_33">↑</a> [[आ। ‘मदनानलबोधने भवेत् खग, धाय्या धिगधैर्यधारिणः।।’ नैषधे। २। ५९।]]</li> <li id="foot_krm_0905_34"><a href="#ref_krm_0905_34">↑</a> [ऋक्]</li> <li id="foot_krm_0905_35"><a href="#ref_krm_0905_35">↑</a> [[२। यगन्ताच्छानचि, ‘घुमास्था--’ (६-४-६६) इतीत्वम्।]]</li> <li id="foot_krm_0905_36"><a href="#ref_krm_0905_36">↑</a> [[३। धीयते = धार्यते शिरसीति धात्री = आमलकी। ‘धः कर्मणि ष्ट्रन्’ (३-२-१८१) इति ष्ट्रन्प्रत्ययः। षित्त्वात् स्त्रियां ङीष्।]]</li> <li id="foot_krm_0905_37"><a href="#ref_krm_0905_37">↑</a> [[४। ‘उपसर्गे घोः किः’ (३-३-९२) इति किप्रत्यये आकारलोपे च रूपम्। एवं निधिरित्यादिष्वपि ज्ञेयम्।]]</li> <li id="foot_krm_0905_38"><a href="#ref_krm_0905_38">↑</a> [[५। ‘अन्तश्शब्दस्य अङ्किविधिणत्वेषूपसर्गत्वं वाच्यम्’ (वा। १-४-६५) इत्युप- सर्गसंज्ञायां किप्रत्यये रूपम्। एवं अन्तर्धा अन्तर्णिधानम् इत्यत्रापि अङ्- विधौ णत्वविधौ चोपसर्गत्वं ज्ञेयमन्तश्शब्दस्य।]]</li> <li id="foot_krm_0905_39"><a href="#ref_krm_0905_39">↑</a> [[६। उदकं धीयतेऽत्रेति उदधिः = समुद्रः। ‘कर्मण्यधिकरणे च’ (३-३-९३) इति अधिकरणे किप्रत्ययः। ‘उदकस्योदः संज्ञायाम्’ (६-३-५७) इति उदक- शब्दस्य उदभावः। असंज्ञायां तु ‘पेषंवासवाहनधिषु च’ (६-३-५८) इति उदभावः--इति विशेषः।]]</li> <li id="foot_krm_0905_40"><a href="#ref_krm_0905_40">↑</a> [[७। सुषामादित्वात् (८-३-९८) सुषन्धिः दुष्षन्धिः इत्यत्र षत्वम्।]]</li> <li id="foot_krm_0905_41"><a href="#ref_krm_0905_41">↑</a> [[८। ‘भाषायां धाञ्--’ (वा। ३-२-१७१) इत्यादिना किः किन् वा प्रत्ययः। तस्य लिड्वद्भावातिदेशात् द्विर्वचनादिकं भवति।]]</li> <li id="foot_krm_0905_42"><a href="#ref_krm_0905_42">↑</a> [पृष्ठम्०७९२+ ३२]</li> <li id="foot_krm_0905_43"><a href="#ref_krm_0905_43">↑</a> [[१। ‘ड्वितः क्त्रिः’ (३-३-८८) इति क्त्रिप्रत्यये, तेन निवृत्तम् इत्यर्थे, ‘क्त्रेर्मम्नि- त्यम्’ (४-४-२०) इति मप्प्रत्यये, हिभावे च रूपमेवम्।]]</li> <li id="foot_krm_0905_44"><a href="#ref_krm_0905_44">↑</a> [[आ। ‘निष्ठां गते दत्त्रिमसभ्यतोषे विहित्रिमे कर्मणि राजपत्न्यः।’ भ। का। १। १३।]]</li> <li id="foot_krm_0905_45"><a href="#ref_krm_0905_45">↑</a> [[२। ‘आतश्चोपसर्गे’ (३-३-१०६) इत्यङ्।]]</li> <li id="foot_krm_0905_46"><a href="#ref_krm_0905_46">↑</a> [[३। ‘श्रढन्तरोरुपसर्गवद्वृत्तिः’ (वा। १-४-५९) इति वचनादुपसर्गभावेऽङ्।]]</li> <li id="foot_krm_0905_47"><a href="#ref_krm_0905_47">↑</a> [[B। ‘चिन्तावन्तः कथां चक्रुरुपधामेदभीरवः।’ भ। का। ७। ७४।]]</li> <li id="foot_krm_0905_48"><a href="#ref_krm_0905_48">↑</a> [[४। अपिपूर्वकात् धाञो ल्युटि ‘वष्टि भागुरिरल्लोपमवाप्योरुपसर्गयोः।’ इति वचनात् अपिघटिताकारस्य लोपे पिधानम् इति भवति। अन्येषां मते तु अपिघानम् इत्येव।]]</li> <li id="foot_krm_0905_49"><a href="#ref_krm_0905_49">↑</a> [[५। ‘न ल्यपि’ (६-४-६९) इतीत्वनिषेधः। ‘अन्तरङ्गानपि विधीन् बहिरङ्गो लुग् बाधते’ (परिभाषा ५३) इति न्यायात् पूर्वमेव ल्यपः प्रवृत्त्या तादिकितोऽभावात् न प्रकृतर्हिरादेशः।]]</li> <li id="foot_krm_0905_50"><a href="#ref_krm_0905_50">↑</a> [[६। ‘उपमाने कर्मणि च’ (३-४-४५) इति णमुलि युगागमे, अस्यः कषादित्वात् ‘कषादिषु यथाविध्यनुप्रयोगः’ (३-४-४६) इति पूर्वप्रयुक्तधातोरनुप्रयोगः।]]</li> <li id="foot_krm_0905_51"><a href="#ref_krm_0905_51">↑</a> [जलम्]</li> <li id="foot_krm_0905_52"><a href="#ref_krm_0905_52">↑</a> [[७। ‘द्वितीयायां च’ (३-४-५३) इति णमुल्। अत्र सूत्रे पूर्वसूत्रात् ‘परीप्सायाम्’ इति नानुवर्तते इति पदमञ्जर्यादौ स्पष्टम्।]]</li> <li id="foot_krm_0905_53"><a href="#ref_krm_0905_53">↑</a> [[C। {??} दित्वा करुणं सशब्दे गोत्रभिवायं सरितं समेत्य।’ भ। का। ३।५०। ]]</li> <li id="foot_krm_0905_54"><a href="#ref_krm_0905_54">↑</a> [[८। औणादिके [द। उ। १-१२२]</li> <li id="foot_krm_0905_55"><a href="#ref_krm_0905_55">↑</a> [[९। कर्क दधातीति कर्कन्धूः = बदरीवृक्षः। ‘अन्दूदृम्भूजम्बूकफेलूकर्कन्धूदिधिषूः’ [द। उ। १। १७६]</li> <li id="foot_krm_0905_56"><a href="#ref_krm_0905_56">↑</a> [[१०। औणादिके [द। उ। ३-२७]</li> <li id="foot_krm_0905_57"><a href="#ref_krm_0905_57">↑</a> [[११। निपूर्वकादस्मात् औणादिके [द। उ। ५। २६]</li> <li id="foot_krm_0905_58"><a href="#ref_krm_0905_58">↑</a> [पृष्ठम्०७९३+ २३]</li> <li id="foot_krm_0905_59"><a href="#ref_krm_0905_59">↑</a> [[१। ‘धापृ--’ [द। उ। ५-३९]</li> <li id="foot_krm_0905_60"><a href="#ref_krm_0905_60">↑</a> [[२। ‘दधातेर्यन् नुट् च’ [द। उ। ८। १९]</li> <li id="foot_krm_0905_61"><a href="#ref_krm_0905_61">↑</a> [[३। ‘सुसूधा--’ [द। उ। ८-४२]</li> <li id="foot_krm_0905_62"><a href="#ref_krm_0905_62">↑</a> [[४। ‘विधाञो वेध च’ [द। उ। ९-८४]</li> <li id="foot_krm_0905_63"><a href="#ref_krm_0905_63">↑</a> [[५। ‘वयसि धाञः’, ‘पयसि च’ ‘पुरसि च’ [द। उ। ९-८९-९०-९१]</li></ul></p>

