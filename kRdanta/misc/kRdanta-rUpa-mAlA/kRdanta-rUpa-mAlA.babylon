<ul><li><sup id="ref_krm_0893_01"><a href="#foot_krm_0893_01">1</a></sup> {@“द्रु गतौ”@} <sup id="ref_krm_0893_02"><a href="#foot_krm_0893_02">2</a></sup> <sup id="ref_krm_0893_03"><a href="#foot_krm_0893_03">3</a></sup> अग्न्यातप{??}ंयोगात् “द्रवति घृतम्” इत्यत्र अकर्मकः। </li> <li>‘रक्षांसि भीतानि दिशो द्रवन्ती’ त्यत्र <sup id="ref_krm_0893_04"><a href="#foot_krm_0893_04">4</a></sup> सकर्मकः।]] द्रावकः-विका, द्रावकः-विका, <sup id="ref_krm_0893_05"><a href="#foot_krm_0893_05">5</a></sup> दुद्रूषकः-षिका, <sup id="ref_krm_0893_06"><a href="#foot_krm_0893_06">6</a></sup> दिद्रावयिषकः-षिका, दुद्रावयिषकः-षिका, <sup id="ref_krm_0893_07"><a href="#foot_krm_0893_07">7</a></sup> दोद्रूयकः-यिका;</li> <li>  द्रोता-त्री, द्रावयिता-त्री, दुद्रूषिता-त्री, दिद्रावयिषिता-त्री,दुद्रावयिषिता-त्री, दोद्रूयिता-त्री;</li> <li>  <sup id="ref_krm_0893_08"><a href="#foot_krm_0893_08">8</a></sup> द्रवन्-न्ती, <sup id="ref_krm_0893_09"><a href="#foot_krm_0893_09">9</a></sup> द्रावयन्-न्ती, दुद्रूषन्-न्ती, दिद्रावयिषन्-न्ती, दुद्रावयिषन्-न्ती;</li> <li>  -- द्रोष्यन्-न्ती-ती, द्रावयिष्यन्-न्ती-ती, दुद्रूषिष्यन्, दिद्रावयिषिष्न् दुद्रावयिषिष्यन्-न्ती-ती;</li> <li>  -- -- -- -- -- दोद्रूयमाणः, दोद्रूयिष्यमाणः;</li> <li>  <sup id="ref_krm_0893_10"><a href="#foot_krm_0893_10">10</a></sup> प्रद्रुत्-प्रद्रुतौ-प्रद्रुतः;</li> <li>  -- -- -- <sup id="ref_krm_0893_11"><a href="#foot_krm_0893_11">11</a></sup> द्रुतम्-तः-तवान्, द्रावितम्, दुद्रूषितः, दिद्रावयिषितः-दुद्रावयिषितः, दोद्रूयितः-तवान्;</li> <li>  द्रवः, <sup id="ref_krm_0893_12"><a href="#foot_krm_0893_12">12</a></sup> मितद्रुः, <sup id="ref_krm_0893_13"><a href="#foot_krm_0893_13">13</a></sup>, हरिद्रुः, शतद्रुः, <sup id="ref_krm_0893_14"><a href="#foot_krm_0893_14">14</a></sup> प्रद्रावी, <sup id="ref_krm_0893_15"><a href="#foot_krm_0893_15">15</a></sup> द्रवणः, द्रावः, <sup id="ref_krm_0893_16"><a href="#foot_krm_0893_16">16</a></sup> दुद्रूषुः, दिद्रावयिषुः-दुद्रावयिषुः, दोद्रुवः;</li> <li>  द्रोतव्यम्, द्रावयितव्यम्, दुद्रूषितव्यम्, दिद्रावयिषितव्यम्-दुद्रावयिषितव्यम्, दोद्रूयितव्यम्;</li> <li>  <sup id="ref_krm_0893_17"><a href="#foot_krm_0893_17">17</a></sup> द्रवणीयम्, द्रावणीयम्, दुद्रूषणीयम्, दिद्रावयिषणीयम् दुद्रावयिषणीयम्, दोद्रूयणीयम्;</li> <li>  <sup id="ref_krm_0893_18"><a href="#foot_krm_0893_18">18</a></sup> द्रव्यम्, <sup id="ref_krm_0893_19"><a href="#foot_krm_0893_19">19</a></sup> अवश्यद्राव्यम्, द्राव्यम्, दुद्रूष्यम्, दिद्रावयिष्यम्-दुद्रावयिष्यम्, दोद्रूय्यम्;</li> <li>  <sup id="ref_krm_0893_20"><a href="#foot_krm_0893_20">20</a></sup> ईषद्द्रवः-दुर्द्रवः-सुद्रवः;</li> <li>  -- -- -- द्रूयमाणः, द्राव्यमाणः, दुद्रूषमाणः, दिद्रावयिषमाणः-दुद्रावयिषमाणः, दोद्रूय्यमाणः;</li> <li>  <sup id="ref_krm_0893_21"><a href="#foot_krm_0893_21">21</a></sup> द्रवः, विद्रवः, उपद्रवः, <sup id="ref_krm_0893_22"><a href="#foot_krm_0893_22">22</a></sup> प्रद्रावः, <sup id="ref_krm_0893_23"><a href="#foot_krm_0893_23">23</a></sup> सन्द्रावः, <sup id="ref_krm_0893_24"><a href="#foot_krm_0893_24">24</a></sup> उद्द्रावः, द्रावः, दुद्रूषः, दिद्रावयिषः-दुद्रावयिषः, दोद्रूयः;</li> <li>  द्रोतुम्, द्रावयितुम्, दुद्रूषितुम्, दिद्रावयिषितुम्-दुद्रावयिषितुम्, दोद्रूयितुम्;</li> <li>  द्रुतिः, द्रावणा, दुद्रूषा, दिद्रावयिषा-दुद्रावयिषा, दोद्रूया;</li> <li>  द्रवणम्, <sup id="ref_krm_0893_25"><a href="#foot_krm_0893_25">25</a></sup> सान्द्राविणम्, द्रावणम्, दुद्रूषणम्, दिद्रावयिषणम्-दुद्रावयिषणम्, दोद्रूयणम्;</li> <li>  द्रुत्वा, द्रावयित्वा, दुद्रूषित्वा, दिद्रावयिषित्वा-दुद्रावयिषित्वा, दोद्रूयित्वा;</li> <li>  प्रद्रुत्य, प्रद्राव्य, प्रदुद्रूष्य, प्रदिद्रावयिष्य-प्रदुद्रावयिष्य, प्रदोद्रूय्य;</li> <li>  द्रावम् २, द्रुत्वा २, द्रावम् २, द्रावयित्वा २, दुद्रूषम् २, दुद्रूषित्वा २, दिद्रावयिषम् २- दिद्रावयिषित्वा २- दुद्रावयिषम् २, दुद्रावयिषित्वा २, दोद्रूयम् २;</li> <li>  दोद्रूयित्वा २;</li> <li>  <sup id="ref_krm_0893_26"><a href="#foot_krm_0893_26">26</a></sup> द्रविणम्, <sup id="ref_krm_0893_27"><a href="#foot_krm_0893_27">27</a></sup> इति नप्रत्ययः। </li> <li>द्रोणः = मानभाण्डम्।]] द्रोणः, <sup id="ref_krm_0893_28"><a href="#foot_krm_0893_28">28</a></sup> इति क्विप्प्रत्यये दीर्घश्च भवति। </li> <li>द्रूः = शल्यकः हिरण्यम्।]] द्रूः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0893_01"><a href="#ref_krm_0893_01">↑</a> (८८३)</li> <li id="foot_krm_0893_02"><a href="#ref_krm_0893_02">↑</a> (१-भ्वादिः-९४५। सक। अनि। पर।)</li> <li id="foot_krm_0893_03"><a href="#ref_krm_0893_03">↑</a> [[[अ]</li> <li id="foot_krm_0893_04"><a href="#ref_krm_0893_04">↑</a> (गीता १०)</li> <li id="foot_krm_0893_05"><a href="#ref_krm_0893_05">↑</a> [[३। सन्नन्ताण्ण्वुलि, ‘इको झल्’ (१-२-९) इति सनः कित्त्वे, ‘अज्झनगमां सनि’ (६-४-१६) इति दीर्घः। एवं सन्नन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0893_06"><a href="#ref_krm_0893_06">↑</a> [[४। ण्यन्तात् सनि, ‘स्रवतिशृणोतिद्रवतिप्रवतिप्लवतिच्यवतीनां वा’ (७-४-८१) इत्यनेनाभ्यासस्य इकारविकल्पः। एवं ण्यन्तात् सनि उत्तरत्र सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0893_07"><a href="#ref_krm_0893_07">↑</a> [[५। यङन्तात् ण्वुलि उत्तरखण्डे ‘अकृत्सार्वधातुकयोः--’ (७-४-२५) इति दीर्घः। अभ्यासे ‘गुणो यङ्लुकोः’ (७-४-८२) इति गुणः। एवं यङन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0893_08"><a href="#ref_krm_0893_08">↑</a> [पृष्ठम्०७८०+ २१]</li> <li id="foot_krm_0893_09"><a href="#ref_krm_0893_09">↑</a> [[१। ण्यन्तात्, ‘बुधयुधनशजनेङ्प्रुद्रुश्रुभ्यो णेः’ (१-३-८६) इति परस्मैपदमेव’ नात्मनेपदम्।]]</li> <li id="foot_krm_0893_10"><a href="#ref_krm_0893_10">↑</a> [[२। क्विपि, ‘ह्रस्वस्य पिति कृति--’ (६-१-७१) इति तुगागमः।]]</li> <li id="foot_krm_0893_11"><a href="#ref_krm_0893_11">↑</a> [[आ। ‘द्रुतं द्रुतं वह्निसमागतं गतं महीमहीनद्युतिरोचितं चितम्।’ भ। का। १०। ११।]]</li> <li id="foot_krm_0893_12"><a href="#ref_krm_0893_12">↑</a> [[३। कर्मण्युपपदे, ‘दुप्रकरणे--मितद्रुवादिभ्य उपसंख्यानम्’ (वा। ३-२-१८०) इति डुप्रत्ययः। मितं द्रावयतीति मितद्रुः। एवं हरिद्रुः शतद्रुः इत्यत्रापि डुप्रत्ययो ज्ञेयः। मित्रद्रुः शुतुद्रुः इति प्रक्रियासर्वस्वे पाठः।]]</li> <li id="foot_krm_0893_13"><a href="#ref_krm_0893_13">↑</a> [मित्रद्रुः]</li> <li id="foot_krm_0893_14"><a href="#ref_krm_0893_14">↑</a> [[४। तच्छीलादिषु कर्तृषु ‘प्रे लपसृद्रु--’ (३-२-१४५) इति घिनुण् प्रत्ययः।]]</li> <li id="foot_krm_0893_15"><a href="#ref_krm_0893_15">↑</a> [[५। धातोरनेकार्यत्वेनाकर्मकत्वे, चलनार्थकत्वात्, ‘चलनशब्दार्थात्--’ (३-२-१४८) इति ताच्छीलिके युचि, अनादेशे रूपम्।]]</li> <li id="foot_krm_0893_16"><a href="#ref_krm_0893_16">↑</a> [[B। ‘उन्नायानधिगच्छन्तः प्रद्रावैः वसुधाभृताम्।’ भ। का। ७। ३७।]]</li> <li id="foot_krm_0893_17"><a href="#ref_krm_0893_17">↑</a> [[६। ल्युटि, ‘अट्कुप्वाङ्नुम्व्यवायेऽपि’ (८-४-२) इति णत्वम्।]]</li> <li id="foot_krm_0893_18"><a href="#ref_krm_0893_18">↑</a> [[७। ‘अचो यत्’ (३-१-९७) इति यति, गुणे, अवादेशः। स च ‘वान्तो यि प्रत्यये’ (६-१-७९) इति वान्तो अवादेशः।]]</li> <li id="foot_krm_0893_19"><a href="#ref_krm_0893_19">↑</a> [[८। ‘ओरावश्यके’ (३-१-१२५) इति ण्यत्। वान्तोऽवादेशः।]]</li> <li id="foot_krm_0893_20"><a href="#ref_krm_0893_20">↑</a> [पृष्ठम्०७८१+ २१]</li> <li id="foot_krm_0893_21"><a href="#ref_krm_0893_21">↑</a> [[१। ‘ॠदोरप्’ (३-३-५७) इति घञपवादोऽप्प्रत्ययः।]]</li> <li id="foot_krm_0893_22"><a href="#ref_krm_0893_22">↑</a> [[२। ‘प्रे द्रुस्तुस्रुवः’ (३-३-२७) इति प्रपूर्वकाद् घञ्।]]</li> <li id="foot_krm_0893_23"><a href="#ref_krm_0893_23">↑</a> [[३। ‘समि युद्रुदुवः’ (३-३-२३) इति सम्पूर्वकादस्माद् घञ्।]]</li> <li id="foot_krm_0893_24"><a href="#ref_krm_0893_24">↑</a> [[४। ‘उदिश्रयतियौतिपूद्रुवः’ (३-३-४९) इति घञ्।]]</li> <li id="foot_krm_0893_25"><a href="#ref_krm_0893_25">↑</a> [[५। ‘अभिविधौ भाव इनुण्’ (३-३-४४) इति इनुण्प्रत्यये, ‘अण् इनुणः’ (५-४-१५) इति नित्यमिनुणन्तादण्प्रत्ययः। अभिविध्यर्थे तु धातोरस्मात् पुन- र्भावे इति वर्तनाद् घञ् न भवति।]]</li> <li id="foot_krm_0893_26"><a href="#ref_krm_0893_26">↑</a> [[६। ‘द्रुदक्षिभ्यामिनन्’ (द। उ। ५-१६) इति इनन्प्रत्ययः। द्रविणम् = धनम्।]]</li> <li id="foot_krm_0893_27"><a href="#ref_krm_0893_27">↑</a> [[७। ‘कॄवृजॄसिद्रु--’ [द। उ। ५। ४२।]</li> <li id="foot_krm_0893_28"><a href="#ref_krm_0893_28">↑</a> [[८। ‘क्विब्वचिप्रच्छिश्रिद्रु--’ [द। उ। १०। २।]</li></ul></p>

द्रुण|द्रोणकः-णिका|दुद्रुणिषकः-दुद्रोणिषकः-षिका|दोद्रुणकः-|णिका
<ul><li><sup id="ref_krm_0894_01"><a href="#foot_krm_0894_01">1</a></sup> {@“द्रुण हिंसागतिकौटिल्येषु”@} <sup id="ref_krm_0894_02"><a href="#foot_krm_0894_02">2</a></sup> <sup id="ref_krm_0894_03"><a href="#foot_krm_0894_03">3</a></sup> द्रोणकः-णिका, द्रोणकः-णिका, दुद्रुणिषकः-दुद्रोणिषकः-षिका, दोद्रुणकः- णिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकघोणतिवत् <sup id="ref_krm_0894_04"><a href="#foot_krm_0894_04">4</a></sup> ज्ञेयानि। </li> <li>अस्य धातोः परस्मैपदित्वात् तुदादित्वाच्च शतरि द्रुणन्-ती इति रूपमिति विशेषः। </li> <li>द्रुणः = खर्जूरः। </li> <li>इगुपधलक्षणः कप्रत्ययः। </li> <li>गौरादिषु <sup id="ref_krm_0894_05"><a href="#foot_krm_0894_05">5</a></sup> पाठात् ङीषि द्रुणी = कच्छपी। </li> <li>पचादिषु पाठात् कर्तर्यच्प्रत्यये द्रोणः। </li> <li><sup id="ref_krm_0894_06"><a href="#foot_krm_0894_06">6</a></sup> विद्रोणनम्। </li> <li>‘परिमाणाख्यायां सर्वेभ्यः’ <sup id="ref_krm_0894_07"><a href="#foot_krm_0894_07">7</a></sup> इति घञि द्रोणः = परिमाणविशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0894_01"><a href="#ref_krm_0894_01">↑</a> (८८४)</li> <li id="foot_krm_0894_02"><a href="#ref_krm_0894_02">↑</a> (६-तुदादिः-१३३७। सक। सेट्। पर।)</li> <li id="foot_krm_0894_03"><a href="#ref_krm_0894_03">↑</a> [पृष्ठम्०७८२+ २४]</li> <li id="foot_krm_0894_04"><a href="#ref_krm_0894_04">↑</a> (४६६)</li> <li id="foot_krm_0894_05"><a href="#ref_krm_0894_05">↑</a> (४-१-४१)</li> <li id="foot_krm_0894_06"><a href="#ref_krm_0894_06">↑</a> [[आ। ‘विद्रोणनेष्वघुणिता मदघूर्णदक्षा युद्धे सुरानपि खरोत्कुरिताः खुरन्तः।।’ धा। का। २। ७६।]]</li> <li id="foot_krm_0894_07"><a href="#ref_krm_0894_07">↑</a> (३-३-२०)</li></ul></p>

