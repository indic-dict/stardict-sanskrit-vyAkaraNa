<ul><li><sup id="ref_krm_0323_01"><a href="#foot_krm_0323_01">1</a></sup> {@“क्षुभ सञ्चलने”@} <sup id="ref_krm_0323_02"><a href="#foot_krm_0323_02">2</a></sup> सञ्चलनम् = प्रकृतिविपर्यासः, गमनं च। </li> <li>इति मा-धातुबृत्तौ। </li> <li>‘क्षुभ्नाति क्षोभते क्षुभ्येत्, इति संचलने क्षुभेः।।’ <sup id="ref_krm_0323_03"><a href="#foot_krm_0323_03">3</a></sup> इति देवः। </li> <li>क्षोभकः-भिका, क्षोभकः-भिका, <sup id="ref_krm_0323_04"><a href="#foot_krm_0323_04">4</a></sup> चुक्षुभिषकः-चुक्षोभिषकः-षिका, चोक्षुभकः-भिका;</li> <li>  क्षोभिता-त्री, क्षोभयिता-त्री, चुक्षुभिषिता-चुक्षोभिषिता-त्री, चोक्षुभिता-त्री;</li> <li>  -- क्षोभयन्-न्ती;</li> <li>  क्षोभयिष्यन्-न्ती-ती;</li> <li>  -- क्षोभमाणः, क्षोभयमाणः, चुक्षुभिषमाणः-चुक्षोभिषमाणः, चोक्षुभ्यमाणः;</li> <li>  क्षोभिष्यमाणः, क्षोभयिष्यमाणः, चुक्षुभिषिष्यमाणः-चुक्षोभिषिष्यमाणः, चोक्षुभिष्यमाणः;</li> <li>  प्रक्षुप्-प्रक्षुब्-प्रक्षुभौ-प्रक्षुभः;</li> <li>  -- -- <sup id="ref_krm_0323_05"><a href="#foot_krm_0323_05">5</a></sup> <sup id="ref_krm_0323_06"><a href="#foot_krm_0323_06">6</a></sup> क्षुभितम्- <sup id="ref_krm_0323_07"><a href="#foot_krm_0323_07">7</a></sup> क्षोभितम्, <sup id="ref_krm_0323_08"><a href="#foot_krm_0323_08">8</a></sup> क्षुब्धः, क्षोभितः, चुक्षुभिषितः-चुक्षोभिषितः, चोक्षु-भितः-तवान्;</li> <li>  क्षुभः, <sup id="ref_krm_0323_09"><a href="#foot_krm_0323_09">9</a></sup> क्षोभणः, <sup id="ref_krm_0323_10"><a href="#foot_krm_0323_10">10</a></sup> प्रक्षोभी, क्षोभः, चुक्षुभिषुः-चुक्षोभिषुः, चोक्षुभः;</li> <li>  क्षोभितव्यम्, क्षोभयितव्यम्, चुक्षुभिषितव्यम्-चुक्षोभिषितव्यम्, चोक्षुभितव्यम्;</li> <li>  क्षोभणीयम्, क्षोभणीयम्, चुक्षुभिषणीयम्-चुक्षोभिषणीयम्, चोक्षुभणीयम्;</li> <li>  क्षोभ्यम्, क्षोभ्यम्, चुक्षुभिष्यम्-चुक्षोभिष्यम्, चोक्षुभ्यम्;</li> <li>  ईषत्क्षोभः-दुःक्षोभः-सुक्षोभः;</li> <li>  -- -- क्षुभ्यमाणः, क्षोभ्यमाणः, चुक्षुभिष्यमाणः-चुक्षोभिष्यमाणः, चोक्षुभ्यमाणः;</li> <li>  <sup id="ref_krm_0323_11"><a href="#foot_krm_0323_11">11</a></sup> क्षोभः, क्षोभः, चुक्षुभिषः-चुक्षोभिषः, चोक्षुभः;</li> <li>  क्षोभितुम्, क्षोभयितुम्, चुक्षुभिषितुम्-चुक्षोभिषितुम्, चोक्षुभितुम्;</li> <li>  <sup id="ref_krm_0323_12"><a href="#foot_krm_0323_12">12</a></sup> क्षुब्धिः, क्षोभणा, चुक्षुभिषा-चुक्षोभिषा, चोक्षुभा;</li> <li>  क्षोभणम्, क्षोभणम्, चुक्षुभिषणम्-चुक्षोभिषणम्, चोक्षुभणम्;</li> <li>  <sup id="ref_krm_0323_13"><a href="#foot_krm_0323_13">13</a></sup> क्षुभित्वा-क्षोभित्वा, क्षोभयित्वा, चुक्षुभिषित्वा-चुक्षोभिषित्वा, चोक्षुभित्वा;</li> <li>  <sup id="ref_krm_0323_14"><a href="#foot_krm_0323_14">14</a></sup> प्रक्षुभ्य, प्रक्षोभ्य, प्रचुक्षुभिष्य-प्रचुक्षोभिष्य, प्रचोक्षुभ्य;</li> <li>  क्षोभम् २, क्षुभित्वा २ -क्षोभित्वा २, क्षोभम् २, क्षोभयित्वा २, चुक्षुभिषम् २ -चुक्षोभिषम् २, चुक्षुभिषित्वा २ -चुक्षोभिषित्वा २, चोक्षुभम् २;</li> <li>  चोक्षुभित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0323_01"><a href="#ref_krm_0323_01">↑</a> (३१६)</li> <li id="foot_krm_0323_02"><a href="#ref_krm_0323_02">↑</a> (१-भ्वादिः-७५१। सक। सेट्। आत्म।)</li> <li id="foot_krm_0323_03"><a href="#ref_krm_0323_03">↑</a> (श्लो-१४४)</li> <li id="foot_krm_0323_04"><a href="#ref_krm_0323_04">↑</a> [[३। ‘रलो व्युपधात्--’ (१-२-२६) इति सनः कित्त्वविकल्पः।]]</li> <li id="foot_krm_0323_05"><a href="#ref_krm_0323_05">↑</a> [पृष्ठम्०३३१+ २५]</li> <li id="foot_krm_0323_06"><a href="#ref_krm_0323_06">↑</a> [[१। ‘उदुपधात् भावादिकर्मणोरन्यतरस्याम्’ (१-२-२१) इति वा कित्त्वम्।]]</li> <li id="foot_krm_0323_07"><a href="#ref_krm_0323_07">↑</a> [[आ। ‘कृष्णोऽपि तापोल्लुठिताङ्गशोभा आश्वास्य मारक्षुभिता महेलाः। अनभ्यसन्तोभककंसजीवस्रंसाय पापध्वदयं प्रतस्थे।।’ धा। का। २-२। ‘क्षुभितस्य महीभृतस्त्वयि प्रशमोपन्यसनं वृथा मम। प्रलयोल्लसितस्य वारिधेः परिवाहो जगतः करोति किम्।।’ शिशुपालवधे--१६-५१।]]</li> <li id="foot_krm_0323_08"><a href="#ref_krm_0323_08">↑</a> [[२। ‘क्षुब्धस्वान्त--’ (७-२-१८) इत्यादिना मन्थे विवक्षिते सति निष्ठायाः इडभावो निपातितः। ‘क्षुब्धादयोऽनिटः क्तान्ता मन्थाद्यर्थे निपातिताः। मन्थो मथनदण्डः स्यात्, सक्तवो वा द्रवीकृताः।। तद्वाची क्षुब्धशब्दोऽयं तयोश्च चलितत्वतः। चलितेष्वपि सर्वेषु प्रयोगोऽस्योपचारतः।।’ इति प्रक्रियासर्वस्वे।]]</li> <li id="foot_krm_0323_09"><a href="#ref_krm_0323_09">↑</a> [[३। ‘अनुदात्तेतश्च हलादेः’ (३-२-१४८) इति ताच्छीलिको युच्।]]</li> <li id="foot_krm_0323_10"><a href="#ref_krm_0323_10">↑</a> [[४। ‘सुप्यजातौ--’ (३-२-७८) इति णिनिः ताच्छील्ये।]]</li> <li id="foot_krm_0323_11"><a href="#ref_krm_0323_11">↑</a> [[B। ‘इति भीष्मभाषितवचोऽर्थमधिगतवतामिव क्षणात्। क्षोभमगमदतिमात्रमथो शिशुपालपक्षपृथिवीभृतां गणः।।’ शिशुपालवधे--१५-४७।]]</li> <li id="foot_krm_0323_12"><a href="#ref_krm_0323_12">↑</a> [[५। ‘तितुत्र--’ (७-२-९) इत्यादिना क्तिनि इण्णिषेधः।]]</li> <li id="foot_krm_0323_13"><a href="#ref_krm_0323_13">↑</a> [[६। ‘रलो व्युपधात्--’ (१-२-२६) इति क्त्वायां कित्त्वविकल्पः। तेन रूपद्वयम्।]]</li> <li id="foot_krm_0323_14"><a href="#ref_krm_0323_14">↑</a> [पृष्ठम्०३३२+ २५]</li></ul></p>

क्षुभ|अस्य|धातोर्दिवादित्वात्|शतरिक्षुभ्यन्-न्ती|क्षोभिष्यन्-न्ती-ती
<ul><li><sup id="ref_krm_0324_01"><a href="#foot_krm_0324_01">1</a></sup> {@“क्षुभ सञ्चलने”@} <sup id="ref_krm_0324_02"><a href="#foot_krm_0324_02">2</a></sup> ‘क्षुभ्नाति क्षोभते क्षुभ्येत्, इति संचलने क्षुभेः।।’ <sup id="ref_krm_0324_03"><a href="#foot_krm_0324_03">3</a></sup> इति देवः। </li> <li>अस्य धातोर्दिवादित्वात् शतरि <sup id="ref_krm_0324_04"><a href="#foot_krm_0324_04">4</a></sup> क्षुभ्यन्-न्ती, क्षोभिष्यन्-न्ती-ती;</li> <li>  इत्यादीनि रूपाणि। </li> <li>अन्यानि सर्वाणि रूपाणि भौवादिकक्षोभतिवत् <sup id="ref_krm_0324_05"><a href="#foot_krm_0324_05">5</a></sup>, ज्ञेयानि। </li> <li>‘उदुपधात्--’ <sup id="ref_krm_0324_06"><a href="#foot_krm_0324_06">6</a></sup> इति वैकल्पिककित्त्वं तु नात्र प्रवर्तते। </li> <li>‘शब्विकरणेभ्य एवेष्यते’ <sup id="ref_krm_0324_07"><a href="#foot_krm_0324_07">7</a></sup> इत्युक्तत्वात्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0324_01"><a href="#ref_krm_0324_01">↑</a> (३१७)</li> <li id="foot_krm_0324_02"><a href="#ref_krm_0324_02">↑</a> (४-दिवादिः-१२३९। सक। सेट्। पर।)</li> <li id="foot_krm_0324_03"><a href="#ref_krm_0324_03">↑</a> (श्लो। १४४)</li> <li id="foot_krm_0324_04"><a href="#ref_krm_0324_04">↑</a> [[आ। ‘ततः क्रोधानिलापातकम्प्रास्याम्भोजसंहतिः। महाह्रद इव क्षूभ्यन् कपिमाह स्म रावणः।।’ भ। का। ९-११८।]]</li> <li id="foot_krm_0324_05"><a href="#ref_krm_0324_05">↑</a> (३१६)</li> <li id="foot_krm_0324_06"><a href="#ref_krm_0324_06">↑</a> (१-२-२१)</li> <li id="foot_krm_0324_07"><a href="#ref_krm_0324_07">↑</a> (भाष्येष्टिः १-२-२१)</li></ul></p>

क्षुभ
<ul><li><sup id="ref_krm_0325_01"><a href="#foot_krm_0325_01">1</a></sup> {@“क्षुभ सञ्चलने”@} <sup id="ref_krm_0325_02"><a href="#foot_krm_0325_02">2</a></sup> ‘क्षुभ्नाति क्षोभते क्षुभ्येदिति संचलने क्षुभेः।।’ <sup id="ref_krm_0325_03"><a href="#foot_krm_0325_03">3</a></sup> अस्य धातोः क्र्यादित्वात् <sup id="ref_krm_0325_04"><a href="#foot_krm_0325_04">4</a></sup> क्षुभ्नन् <sup id="ref_krm_0325_05"><a href="#foot_krm_0325_05">5</a></sup> -ती, इति रूपमिति विशेषः। </li> <li>अन्यानि रूपाणि भौवादिकक्षुभधातुवत् <sup id="ref_krm_0325_06"><a href="#foot_krm_0325_06">6</a></sup> बोध्यानि। </li> <li>‘उदुपधात्--’ <sup id="ref_krm_0325_07"><a href="#foot_krm_0325_07">7</a></sup> इति अत्रापि न प्रवर्तते, क्रैयादिकत्वात्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0325_01"><a href="#ref_krm_0325_01">↑</a> (३१८)</li> <li id="foot_krm_0325_02"><a href="#ref_krm_0325_02">↑</a> (९-क्र्यादिः-१५१९। सक। सेट्। पर।)</li> <li id="foot_krm_0325_03"><a href="#ref_krm_0325_03">↑</a> (श्लो। १४४ इति देवः)</li> <li id="foot_krm_0325_04"><a href="#ref_krm_0325_04">↑</a> [[१। ‘क्र्यादिभ्यः श्ना’-- (३-१-८१) इति श्ना। ‘श्नाऽभ्यस्तयोरातः’ (६-४-११२) इत्याकारलोपः। ‘क्षुभ्नादिषु च’ (८-४-३९) इति णत्वनिषेधः।]]</li> <li id="foot_krm_0325_05"><a href="#ref_krm_0325_05">↑</a> [[B। ‘रोषभीममुखेनैवं क्षुभ्नतोक्ते प्लवङ्गमः। प्रोचे सानुनयं वाक्यं रावणं स्वार्थसिद्धये।।’ भ। का। ९-१०९।]]</li> <li id="foot_krm_0325_06"><a href="#ref_krm_0325_06">↑</a> (३१६)</li> <li id="foot_krm_0325_07"><a href="#ref_krm_0325_07">↑</a> (१-२-२१)</li></ul></p>

क्षुर
<ul><li><sup id="ref_krm_0326_01"><a href="#foot_krm_0326_01">1</a></sup> {@“क्षुर विलेखने”@} <sup id="ref_krm_0326_02"><a href="#foot_krm_0326_02">2</a></sup> विलेखनम् = छेदः। </li> <li>क्षोरकः-रिका, क्षोरकः-रिका, चुक्षुरिषकः-चुक्षोरिषकः-षिका, चोक्षुरकः- रिका, इत्यादीनि रूपाणि तौदादिककुरतिवत् <sup id="ref_krm_0326_03"><a href="#foot_krm_0326_03">3</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0326_01"><a href="#ref_krm_0326_01">↑</a> (३१९)</li> <li id="foot_krm_0326_02"><a href="#ref_krm_0326_02">↑</a> (६-तुदादिः-१३४४। सक। सेट्। पर।)</li> <li id="foot_krm_0326_03"><a href="#ref_krm_0326_03">↑</a> (२२९)</li></ul></p>

