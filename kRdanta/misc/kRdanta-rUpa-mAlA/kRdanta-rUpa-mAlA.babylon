<ul><li><sup id="ref_krm_0280_01"><a href="#foot_krm_0280_01">1</a></sup> {@“क्रमु पादविक्षेपे”@} <sup id="ref_krm_0280_02"><a href="#foot_krm_0280_02">2</a></sup> ‘पदविक्षेपे’ इति कुत्रचित् पाठः। </li> <li>पादविक्षेपः = पादन्यासः। </li> <li><sup id="ref_krm_0280_03"><a href="#foot_krm_0280_03">3</a></sup> <sup id="ref_krm_0280_04"><a href="#foot_krm_0280_04">4</a></sup> क्रमकः-मिका, <sup id="ref_krm_0280_05"><a href="#foot_krm_0280_05">5</a></sup> क्रमकः-मिका, <sup id="ref_krm_0280_06"><a href="#foot_krm_0280_06">6</a></sup> उत्क्रामकः-सङ्क्रामकः, <sup id="ref_krm_0280_07"><a href="#foot_krm_0280_07">7</a></sup> चिक्रमिषकः-षिका, चिक्रंसकः-सिका, <sup id="ref_krm_0280_08"><a href="#foot_krm_0280_08">8</a></sup> चङ्क्रमकः-मिका;</li> <li>  <sup id="ref_krm_0280_09"><a href="#foot_krm_0280_09">9</a></sup> क्रन्ता-प्रक्रन्ता, <sup id="ref_krm_0280_10"><a href="#foot_krm_0280_10">10</a></sup> क्रमिता-सङ्क्रमिता-त्री, क्रमयिता-त्री, चिक्रमिषिता-चिक्रंसिता-त्री, चङ्क्रमिता-त्री;</li> <li>  <sup id="ref_krm_0280_11"><a href="#foot_krm_0280_11">11</a></sup> क्राम्यन्-क्रामन्-न्ती, क्रमयन्-न्ती, चिक्रमिषन्-न्ती;</li> <li>  -- क्रमिष्यन्-न्ती-न्ती, कमयिष्यन्-न्ती-ती, चिक्रमिषिष्यन्-न्ती-ती;</li> <li>  -- <sup id="ref_krm_0280_12"><a href="#foot_krm_0280_12">12</a></sup> <sup id="ref_krm_0280_13"><a href="#foot_krm_0280_13">13</a></sup> क्रममाणः <sup id="ref_krm_0280_14"><a href="#foot_krm_0280_14">14</a></sup> -<sup id="ref_krm_0280_15"><a href="#foot_krm_0280_15">15</a></sup> क्रममाणः-<sup id="ref_krm_0280_16"><a href="#foot_krm_0280_16">16</a></sup> क्रममाणा, <sup id="ref_krm_0280_17"><a href="#foot_krm_0280_17">17</a></sup> <sup id="ref_krm_0280_18"><a href="#foot_krm_0280_18">18</a></sup> उपक्रममाणः-पराक्रममाणः, <sup id="ref_krm_0280_19"><a href="#foot_krm_0280_19">19</a></sup> <sup id="ref_krm_0280_20"><a href="#foot_krm_0280_20">20</a></sup> <sup id="ref_krm_0280_21"><a href="#foot_krm_0280_21">21</a></sup> आक्रममाणः, <sup id="ref_krm_0280_22"><a href="#foot_krm_0280_22">22</a></sup> <sup id="ref_krm_0280_23"><a href="#foot_krm_0280_23">23</a></sup> <sup id="ref_krm_0280_24"><a href="#foot_krm_0280_24">24</a></sup> विक्रममाणः, <sup id="ref_krm_0280_25"><a href="#foot_krm_0280_25">25</a></sup> प्रक्रममाणः <sup id="ref_krm_0280_26"><a href="#foot_krm_0280_26">26</a></sup> -उपक्रममाणः <sup id="ref_krm_0280_27"><a href="#foot_krm_0280_27">27</a></sup>, <sup id="ref_krm_0280_28"><a href="#foot_krm_0280_28">28</a></sup> क्रममाणः, <sup id="ref_krm_0280_29"><a href="#foot_krm_0280_29">29</a></sup> क्रम्यमाणः, क्रमयमाणः, <sup id="ref_krm_0280_30"><a href="#foot_krm_0280_30">30</a></sup> प्रचिक्रंसमानः-पराचिक्रंसमानः-उपचिक्रंसमानः, चङ्क्रम्यमाणः;</li> <li>  <sup id="ref_krm_0280_31"><a href="#foot_krm_0280_31">31</a></sup> <sup id="ref_krm_0280_32"><a href="#foot_krm_0280_32">32</a></sup> क्रंस्यमानः, क्रमयिष्यमाणः, प्रचिक्रंसिष्यमाणः, चङ्क्रमिष्यमाणः;</li> <li>  <sup id="ref_krm_0280_33"><a href="#foot_krm_0280_33">33</a></sup> प्रक्रान्-प्रकामौ-प्रकामः, <sup id="ref_krm_0280_34"><a href="#foot_krm_0280_34">34</a></sup> दूरक्राः-दधिक्राः, <sup id="ref_krm_0280_35"><a href="#foot_krm_0280_35">35</a></sup> वनक्रान्;</li> <li>  -- <sup id="ref_krm_0280_36"><a href="#foot_krm_0280_36">36</a></sup> <sup id="ref_krm_0280_37"><a href="#foot_krm_0280_37">37</a></sup> क्रान्तम् <sup id="ref_krm_0280_38"><a href="#foot_krm_0280_38">38</a></sup> -विक्रान्तः-क्रान्तवान्, क्रमितः, चिक्रमिषितः-चिक्रंसितः, चङ्क्रमितः-तवान्;</li> <li>  क्रमः, <sup id="ref_krm_0280_39"><a href="#foot_krm_0280_39">39</a></sup> नक्रः, <sup id="ref_krm_0280_40"><a href="#foot_krm_0280_40">40</a></sup> त्रिविक्रमः, क्रमः, चिक्रमिषुः-चिक्रंसुः, चिक्रमयिषुः, चङ्क्रमः- <sup id="ref_krm_0280_41"><a href="#foot_krm_0280_41">41</a></sup> चङ्क्रमणः <sup id="ref_krm_0280_42"><a href="#foot_krm_0280_42">42</a></sup>;</li> <li>  <sup id="ref_krm_0280_43"><a href="#foot_krm_0280_43">43</a></sup> क्रमितव्यम्, क्रमयितव्यम्, चिक्रमिषितव्यम्-चिक्रंसितव्यम्, चङ्क्रमि- तव्यम्;</li> <li>  क्रमणीयम्, क्रमणीयम्, चिक्रमिषणीयम्-चिक्रंसनीयम्, चङ्क्रमणीयम्;</li> <li>  <sup id="ref_krm_0280_44"><a href="#foot_krm_0280_44">44</a></sup> क्रम्यम्, क्रम्यम्, चिक्रमिष्यम्-चिक्रंस्यम्, चङ्क्रम्यम्;</li> <li>  ईषत्क्रमः-दुष्क्रमः-सुक्रमः;</li> <li>  -- -- क्रम्यमाणः, क्रम्यमाणः, प्रचिक्रंस्यमानः, चङ्क्रम्यमाणः;</li> <li>  क्रमः, विक्रमः-पराक्रमः-उपक्रमः-सङ्क्रमः, क्रमः, चिक्रमिषः-चिक्रंसः, चङ्क्रमः;</li> <li>  क्रमितुम्, <sup id="ref_krm_0280_45"><a href="#foot_krm_0280_45">45</a></sup> सङ्क्रमितुम् <sup id="ref_krm_0280_46"><a href="#foot_krm_0280_46">46</a></sup>, चिक्रमिषितुम्-चिक्रंसितुम्, चङ्क्रमितुम्;</li> <li>  <sup id="ref_krm_0280_47"><a href="#foot_krm_0280_47">47</a></sup> विक्रान्तिः-सङ्क्रान्तिः, क्रमणा, चिक्रमिषा-चिंक्रसा <sup id="ref_krm_0280_48"><a href="#foot_krm_0280_48">48</a></sup>, चिक्रमयिषा, चङ्क्रमा;</li> <li>  <sup id="ref_krm_0280_49"><a href="#foot_krm_0280_49">49</a></sup> सङ्क्रमणम्, क्रमणम्, चिक्रमिषणम्-चिक्रंसनम्, चङ्क्रमणम्;</li> <li>  <sup id="ref_krm_0280_50"><a href="#foot_krm_0280_50">50</a></sup> क्रमित्वा-क्रान्त्वा-क्रन्त्वा, क्रमयित्वा, चिक्रमिषित्वा-चिक्रंसित्वा, चङ्क्रमित्वा;</li> <li>  <sup id="ref_krm_0280_51"><a href="#foot_krm_0280_51">51</a></sup> प्रकम्य-विक्रम्य, <sup id="ref_krm_0280_52"><a href="#foot_krm_0280_52">52</a></sup> सङ्क्रमय्य, सञ्चिक्रमिष्य-प्रचिक्रंस्य, सञ्चङ्क्रम्य;</li> <li>  क्रामम् २, क्रमित्वा २, <sup id="ref_krm_0280_53"><a href="#foot_krm_0280_53">53</a></sup> क्रान्त्वा २, क्रन्त्वा २, <sup id="ref_krm_0280_54"><a href="#foot_krm_0280_54">54</a></sup> क्रामम्-क्रमम् २, क्रमयित्वा २, चिक्रमिषम्-चिक्रंसम् २, चिक्रमिषित्वा-चिक्रंसित्वा २, चङ्क्रमम् २, चङ्क्रमित्वा २;</li> <li>  <sup id="ref_krm_0280_55"><a href="#foot_krm_0280_55">55</a></sup> क्रमुकः, <sup id="ref_krm_0280_56"><a href="#foot_krm_0280_56">56</a></sup> इतीन् प्रत्ययः। </li> <li>क्रामति, क्रम्यते वा क्रिमिः = कीटविशेषः। </li> <li>‘बाहुलकात् कृमिः इत्यपि’ इति क्षीरस्वामी।]] क्रिमिः-कृमिः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0280_01"><a href="#ref_krm_0280_01">↑</a> (२७३)</li> <li id="foot_krm_0280_02"><a href="#ref_krm_0280_02">↑</a> (१-भ्वादिः-४७३। सक। सेट्। पर।)</li> <li id="foot_krm_0280_03"><a href="#ref_krm_0280_03">↑</a> [पृष्ठम्०२८०+ २६]</li> <li id="foot_krm_0280_04"><a href="#ref_krm_0280_04">↑</a> [[१। ‘नोदात्तोपदेशस्य मान्तस्यानाचमेः’ (७-३-३४) इति वृद्धिनिषेधः। एवं घञ्यपि ज्ञेयम्।]]</li> <li id="foot_krm_0280_05"><a href="#ref_krm_0280_05">↑</a> [[२। ‘जनीजॄष्क्नसुरञ्जोऽमन्ताश्च’ (गणसूत्रं भ्वादौ) इति मित्त्वम्। ‘मितां ह्रस्वः’ (६-४-९२) इति णौ ह्रस्वः। एवं सर्वत्र ण्यन्ते बोध्यम्।]]</li> <li id="foot_krm_0280_06"><a href="#ref_krm_0280_06">↑</a> [[३। ‘मितां ह्रस्वः’ (६-४-९२) इत्यत्र, ‘वा चित्तविरागे’ (६-४-९१) इत्यतः ‘वा इत्यनुवर्त्य व्यवस्थितविभाषाश्रयणात् ‘उत्क्रामयति, सङ्क्रामयति’ इत्यादि- सिद्धिं वदन्ति।’ इति काशिका (६-४-९२)। तेन ण्यन्तेऽत्र धातौ दीर्घविकल्प इति ज्ञायते। ‘अविगीतस्तु-- ‘सङ्क्रमयति’ इत्येव।’ इति माधव- धातुवृत्तौ।]]</li> <li id="foot_krm_0280_07"><a href="#ref_krm_0280_07">↑</a> [[४। ‘अनुपसर्गाद्वा’ (१-३-४३) इति क्रमेः आत्मनेपदविकल्पः। तेन ‘पूर्ववत् सनः’ (१-३-६२) इति सन्नन्तात्, परस्मैपदम्--आत्मनेपदम्--इत्युभयमापि भवति। यदा परस्मैपदम् = तदानी सन इट् भवति। यदा त्वात्मनेपदं तदानीं, ‘स्नुक्रमो- रनात्मनेपदनिमित्ते’ (७-२-३६) इति नियमादिण्णिषेधः। एवं सन्नन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0280_08"><a href="#ref_krm_0280_08">↑</a> [[५। ‘नित्यं कौटिल्ये गतौ’ (३-१-२३) इति यङ्। ‘नुगतोऽनुनासिकान्तस्य’ (७-४-८५) इति अभ्यासस्य नुगागमः।]]</li> <li id="foot_krm_0280_09"><a href="#ref_krm_0280_09">↑</a> [[६। ‘क्रमेः कर्तर्यात्मनेपदविषयात् कृत इण्णिषेधो वाच्यः’ (वा। ७-२-३६) इति इण्णिषेधः।]]</li> <li id="foot_krm_0280_10"><a href="#ref_krm_0280_10">↑</a> [[७। ‘क्रमेः कर्तरि--’ (वा। ७-२-३६) इतीण्णिषेधवार्तिके ‘आत्मनेपदविषयात्’ इत्युक्तेः परस्मैपदविषये तु इड् भवत्येव।]]</li> <li id="foot_krm_0280_11"><a href="#ref_krm_0280_11">↑</a> [[८। ‘वा भ्राशभ्लाशभ्रमुक्रमुक्लमुत्रसित्रुटिलषः’ (३-१-७०) इति श्यन्विकल्पः। ‘क्रमः परस्मैपदेषु’ (७-३-७६) इति शिति प्रत्यये परे दीर्घः।]]</li> <li id="foot_krm_0280_12"><a href="#ref_krm_0280_12">↑</a> [[९। ‘वृत्तिसर्गतायनेषु क्रमः’ (१-३-३८) इत्यात्मनेपदं शानच्। वृत्तिः = अप्रति- बन्धः। सर्गः = उत्साहः। तायनम् = स्फीतता। वृत्त्याद्यर्थप्रतीतिः उदाहरणेषु यथाक्रममत्र बोध्या।]]</li> <li id="foot_krm_0280_13"><a href="#ref_krm_0280_13">↑</a> [ऋचि]</li> <li id="foot_krm_0280_14"><a href="#ref_krm_0280_14">↑</a> [[आ। ‘विमेष्ये क्रोधमथवा क्रममाणोऽरिसंसदि।’ भ। का। ८-२२।]]</li> <li id="foot_krm_0280_15"><a href="#ref_krm_0280_15">↑</a> [व्याकरणाध्ययनाय]</li> <li id="foot_krm_0280_16"><a href="#ref_krm_0280_16">↑</a> [प्राज्ञे बुद्धिः]</li> <li id="foot_krm_0280_17"><a href="#ref_krm_0280_17">↑</a> [पृष्ठम्०२८१+ २९]</li> <li id="foot_krm_0280_18"><a href="#ref_krm_0280_18">↑</a> [[१। ‘उपपराभ्याम्’ (१-३-३९) इत्यात्मनेपदं शानच्। अत्रापि पूर्वोक्तवृत्त्याद्यर्थेष्वेवा- त्मनेपदम्। तेन, ‘सङ्क्रामन्’ इत्यत्र परस्मैपदमेव।]]</li> <li id="foot_krm_0280_19"><a href="#ref_krm_0280_19">↑</a> [[२। ‘आङ उद्गमने’ (१-३-४०) इत्यात्मनेपदम्। ‘ज्योतिरुद्गमन इति वक्तव्यम्’ (वा। १-३-४०) इति वचनात्, ‘आक्रामन् धूमो हर्म्यतलात् इत्यत्र परस्मै- पदमेव। ‘नभः समाक्रामति चन्द्रमाः’ इत्यत्र नोद्गमनं विवक्षितम्। किं तर्हि? व्याप्तिः, इति परस्मैपदम्--’ इति माधवधातुवृत्तौ।]]</li> <li id="foot_krm_0280_20"><a href="#ref_krm_0280_20">↑</a> [सूर्यः]</li> <li id="foot_krm_0280_21"><a href="#ref_krm_0280_21">↑</a> [[आ। ‘परीक्षितुमुपाक्रंस्त राक्षसी तस्य विक्रमम्। दिवमाक्रममाणेव केतुतारा भयप्रदा।।’ भ। का। ८-२३।]]</li> <li id="foot_krm_0280_22"><a href="#ref_krm_0280_22">↑</a> [[३। ‘वेः पादविहरणे’ (१-३-४१) इत्यात्मनेपदम्। पादविहरणम् = अश्वस्य गति- विशेषः। पादविहरणादन्यत्र ‘विक्रामन् सन्धिः’ इत्येव। त्रुट्यन् इत्यर्थः। पादविक्षेपे इत्यर्थ एव धातोः पठितत्वात् अत्र सूत्रे (१-३-४१) ‘पादविहरणे’ इत्युक्तिः--धातूनामनेकार्थत्वे लिङ्गं भवति इति केचित्।]]</li> <li id="foot_krm_0280_23"><a href="#ref_krm_0280_23">↑</a> [वाजी साधु]</li> <li id="foot_krm_0280_24"><a href="#ref_krm_0280_24">↑</a> [[B। ‘जले विक्रममाणाया हनूमान् शतयोजनम्।’ भ। का। ८-२४।]]</li> <li id="foot_krm_0280_25"><a href="#ref_krm_0280_25">↑</a> [[४। ‘प्रोपाभ्यां समर्थाभ्याम्’ (१-३-४२) इत्यात्मनेपदम्। समर्थः = तुल्यार्थः। तच्च तुल्यार्थत्वं प्रारम्भे। तेन ‘प्रकामन्’ इत्यत्र परस्मैपदमेव।]]</li> <li id="foot_krm_0280_26"><a href="#ref_krm_0280_26">↑</a> [[C। ‘द्रष्टुं प्रक्रममाणोऽसौ सीतामम्भोनिधेस्तटम्। उपाक्रंस्ताकुलं घोरैः क्रममाणैर्निशाचरैः।।’ भ। का। ८-२५।]]</li> <li id="foot_krm_0280_27"><a href="#ref_krm_0280_27">↑</a> [वा भोक्तुम्]</li> <li id="foot_krm_0280_28"><a href="#ref_krm_0280_28">↑</a> [[५। ‘अनुपसर्गाद्वा’ (१-३-४३) इत्यात्मनेपदविकल्पः। तेन शानच्।]]</li> <li id="foot_krm_0280_29"><a href="#ref_krm_0280_29">↑</a> [[६। ‘वा भ्राश--’ (३-१-७०) इति श्यन्पक्षे रूपम्।]]</li> <li id="foot_krm_0280_30"><a href="#ref_krm_0280_30">↑</a> [[७। उक्तेष्वात्मनेपदनिमित्तेषु कस्यचिद्विवक्षायाम्, ‘पूर्ववत् सनः’ (१-३-६२) इत्यात्मने- पदम्। ‘स्नुक्रमोरनात्मनेपदनिमित्ते’ (७-२-३६) इति नियमादिण्णिषेधः।]]</li> <li id="foot_krm_0280_31"><a href="#ref_krm_0280_31">↑</a> [[८। ‘वृत्तिसर्गतायनेषु क्रमः’ (१-३-३८) इति आत्मनेपदम्। एवं उपपरापूर्वकाभ्या- मपि उदाहरणं ज्ञेयम्।]]</li> <li id="foot_krm_0280_32"><a href="#ref_krm_0280_32">↑</a> [ऋचि]</li> <li id="foot_krm_0280_33"><a href="#ref_krm_0280_33">↑</a> [[९। क्विपि, ‘अनुनासिकस्य क्विझलोः क्ङिति’ (६-४-१५) इति दीर्घे, ‘मो नो धातोः’ (८-२-६४) इति पदान्ते नकारः।]]</li> <li id="foot_krm_0280_34"><a href="#ref_krm_0280_34">↑</a> [[१०। ‘जनसनखनक्रमगमो विट्’ (३-२-६७) इति विट्। ‘विड्वनोरनुनासिकस्यात्’ (६-४-४१) इति मकारस्यात्वम्। सवर्णदीर्घः।]]</li> <li id="foot_krm_0280_35"><a href="#ref_krm_0280_35">↑</a> [[११। ‘क्विप् च’ (३-२-७६) इति कर्मण्युपपदे क्विप्। दीर्घः। नत्वम्।]]</li> <li id="foot_krm_0280_36"><a href="#ref_krm_0280_36">↑</a> [पृष्ठम्०२८२+ २८]</li> <li id="foot_krm_0280_37"><a href="#ref_krm_0280_37">↑</a> [[१। उदित्त्वेन क्त्वायामिड्विकल्पात्, ‘यस्य विभाषा’ (७-२-१५) इति निष्ठाया इण्णिषेधः। दीर्घः।]]</li> <li id="foot_krm_0280_38"><a href="#ref_krm_0280_38">↑</a> [[आ। ‘क्षणेन क्षीणविक्रान्ताः कपिनाऽनेषत क्षयम्।।’ भ। का। ९-२२।]]</li> <li id="foot_krm_0280_39"><a href="#ref_krm_0280_39">↑</a> [[२। न क्रामतीति नक्रः = ग्राहः। ‘अन्येष्वपि दृश्यते’ (३-२-१०१) इत्यत्र ‘अपि’ ग्रहणं सर्वोपाधिव्यभिचारार्थम्। तेन, धात्वन्तरादपि डप्रत्ययो भवति--इति व्याख्यानात् डप्रत्ययः। नञ्समासः। ‘नभ्राण्णपान्नवेदानासत्यानमुचिनकुल- नखनपुंसकनक्षत्रनक्रनाकेषु प्रकृत्या’ (६-३-७५) इति निषातनान्तञो लोपो न।]]</li> <li id="foot_krm_0280_40"><a href="#ref_krm_0280_40">↑</a> [[३। त्रीणि--जगन्ति क्राम्यतीति त्रिविक्रमः। पचाद्यच् (३-१-१३४)। परमात्मा विष्णुरुच्यते। त्रयो विक्रमाः यस्येति वा त्रिविक्रमः। ‘आनन्दो नन्दनो नन्दः सत्यधर्मा त्रिविक्रमः।’ इति भगवन्नामसहस्रे।]]</li> <li id="foot_krm_0280_41"><a href="#ref_krm_0280_41">↑</a> [[४। ‘जुचङ्क्रम्यदन्द्रम्य--’ (३-२-१५०) इत्यादिना ताच्छीलिको युच्। पौनः- पुन्येन गमनकर्ता चङ्क्रमणः।]]</li> <li id="foot_krm_0280_42"><a href="#ref_krm_0280_42">↑</a> [[B। ‘कपिश्चङ्क्रमणोऽद्यापि नासौ भवति गर्धनः।’ भ। का। ७-१६।]]</li> <li id="foot_krm_0280_43"><a href="#ref_krm_0280_43">↑</a> [[५। ‘क्रमेः कर्तरि--’ (वा। ७-२-३६) इतीण्णिषेधवार्तिके ‘कर्तरि’ इत्युक्तत्वात् भावकर्मणोर्विषये इड् भवत्येव, तव्यदादीनां कर्त्रर्थकत्वाभावात्।]]</li> <li id="foot_krm_0280_44"><a href="#ref_krm_0280_44">↑</a> [[६। ‘पोरदुपधात्’ (३-१-९८) इति यत्।]]</li> <li id="foot_krm_0280_45"><a href="#ref_krm_0280_45">↑</a> [[C। ‘अपि प्रसन्नेन महर्षिणा त्वं सम्यग् विनीयानुमतो गृहाय। कालो ह्ययं सङ्क्रमितुं द्वितीयं सर्वोपकारक्षममाश्रमं ते।।’ रघुवंशे ५-१०।]]</li> <li id="foot_krm_0280_46"><a href="#ref_krm_0280_46">↑</a> [[७। ‘कालसमयवेलासु तुमुन्’ (३-३-१६७) इति तुमुन्।]]</li> <li id="foot_krm_0280_47"><a href="#ref_krm_0280_47">↑</a> [पृष्ठम्०२८३+ २३]</li> <li id="foot_krm_0280_48"><a href="#ref_krm_0280_48">↑</a> [[आ। ‘चिक्रंसया कृत्रिमपत्रिपङ्क्तेः कपोतपालीषु निकेतनानाम्। मार्जारमप्यायतनिश्चलाङ्गं यस्यां जनः कृत्रिममेव मेने।।’ शिशुपालवधे ३-५१।]]</li> <li id="foot_krm_0280_49"><a href="#ref_krm_0280_49">↑</a> [[B। ‘चङ्क्रमावान् समागत्य सीतामूचे सुखाभव।।’ भ। का। ५-६४।]]</li> <li id="foot_krm_0280_50"><a href="#ref_krm_0280_50">↑</a> [[१। ‘उदितो वा’ (७-२-५६) इति क्त्वायामिड्विकल्पः। इडभावपक्षे, ‘क्रमश्च क्त्वि’ (६-४-१८) इति दीर्घविकल्पः।]]</li> <li id="foot_krm_0280_51"><a href="#ref_krm_0280_51">↑</a> [[२। ‘प्रक्रम्य, उपक्रम्य इति बहिरङ्गोऽपि ल्यबादेशः, अन्तरङ्गानपि विधीन् बा- धते--इति पूर्वमेव दीर्घत्वं न प्रवर्तते।’ इति ‘क्रमश्च क्त्वि’ (६-४-१८) इत्यत्र काशिका।]]</li> <li id="foot_krm_0280_52"><a href="#ref_krm_0280_52">↑</a> [[३। ‘ल्यपि लघुपूर्वात्’ (६-४-५६) इति णेरयादेशः।]]</li> <li id="foot_krm_0280_53"><a href="#ref_krm_0280_53">↑</a> [[C। ‘स्थायं स्थायं क्वचिद् यान्तं क्रान्त्वा क्रान्त्वा स्थितं क्वचित्। वीक्षमाणो मृगं रामः चित्रवृत्तिं विसिष्मिये।।’ भ। का। ५-५१।]]</li> <li id="foot_krm_0280_54"><a href="#ref_krm_0280_54">↑</a> [[४। ‘चिण्णमुलोर्दीर्घोऽन्यतरस्याम्’ (६-४-९३) इति ण्यन्ताण्णमुलि दीर्घविकल्पः।]]</li> <li id="foot_krm_0280_55"><a href="#ref_krm_0280_55">↑</a> [[५। ‘बाहुलकात् उः। संज्ञायां कन्। ‘क्रमुकस्तु पुमान् भद्रमुस्तके ब्रह्मदारुणि। फले कार्पासिकायाश्च पटिकालोध्रपूगयोः।।’ इति मेदिनी।’ इति अमरसुधा।]]</li> <li id="foot_krm_0280_56"><a href="#ref_krm_0280_56">↑</a> [[६। ‘कमितमिस्तम्भाम् अत इच्च’ [द। उ। १-५०]</li></ul></p>

