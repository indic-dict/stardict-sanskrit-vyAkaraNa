<ul><li><sup id="ref_krm_0172_01"><a href="#foot_krm_0172_01">1</a></sup> {@“कमु कान्तौ”@} <sup id="ref_krm_0172_02"><a href="#foot_krm_0172_02">2</a></sup> कान्तिः = इच्छा। </li> <li><sup id="ref_krm_0172_03"><a href="#foot_krm_0172_03">3</a></sup> कामकः <sup id="ref_krm_0172_04"><a href="#foot_krm_0172_04">4</a></sup> कामकः मिका, कामकः-मिका, <sup id="ref_krm_0172_05"><a href="#foot_krm_0172_05">5</a></sup> चिकामयिषकः-षिका, चिकमिषकः-षिका, <sup id="ref_krm_0172_06"><a href="#foot_krm_0172_06">6</a></sup> चङ्कामकः-मिका;</li> <li>  चङ्कमकः-मिका;</li> <li>  कामयिता-त्री, कमिता-त्री, कामयिता-त्री, चिकामयिषिता-त्री, चिकमिषिता-त्री, चङ्कामयिता-त्री;</li> <li>  चङ्कमिता-त्री;</li> <li>  -- <sup id="ref_krm_0172_07"><a href="#foot_krm_0172_07">7</a></sup> कामयन्-न्ती, कामयिष्यन्-न्ती-ती;</li> <li>  -- <sup id="ref_krm_0172_08"><a href="#foot_krm_0172_08">8</a></sup> कामयमानः, कामयमानः, चिकामयिषमाणः चिकमिषमाणः चङ्काम्यमानः;</li> <li>  चङ्कम्यमानः;</li> <li>  कामयिष्यमाणः, कामयिष्यमाणः, चिकामयिषिष्यमाणः, चिकमिषिष्यमाणः, चङ्कामयिष्यमाणः;</li> <li>  चङ्कमिष्यमाणः;</li> <li>  <sup id="ref_krm_0172_09"><a href="#foot_krm_0172_09">9</a></sup> कान्-कामौ-कामः;</li> <li>  -- -- -- <sup id="ref_krm_0172_10"><a href="#foot_krm_0172_10">10</a></sup> कामितम्-तः-तवान्, <sup id="ref_krm_0172_11"><a href="#foot_krm_0172_11">11</a></sup> कान्तम्-न्तः-न्तवान्, कामितम्-तः, चिकामयिषितः, चिकमिषितः, चङ्कामितः चङ्कमितः तवान्;</li> <li>  <sup id="ref_krm_0172_12"><a href="#foot_krm_0172_12">12</a></sup> कामः-कमः, <sup id="ref_krm_0172_13"><a href="#foot_krm_0172_13">13</a></sup> प्रकामी, <sup id="ref_krm_0172_14"><a href="#foot_krm_0172_14">14</a></sup> मांसकामः-मांसकामा, <sup id="ref_krm_0172_15"><a href="#foot_krm_0172_15">15</a></sup> हन्तुकामः <sup id="ref_krm_0172_16"><a href="#foot_krm_0172_16">16</a></sup>, <sup id="ref_krm_0172_17"><a href="#foot_krm_0172_17">17</a></sup> हरिकामा, <sup id="ref_krm_0172_18"><a href="#foot_krm_0172_18">18</a></sup> कम्रः <sup id="ref_krm_0172_19"><a href="#foot_krm_0172_19">19</a></sup>, <sup id="ref_krm_0172_20"><a href="#foot_krm_0172_20">20</a></sup> कमनः, <sup id="ref_krm_0172_21"><a href="#foot_krm_0172_21">21</a></sup> कामुक <sup id="ref_krm_0172_22"><a href="#foot_krm_0172_22">22</a></sup> ः-कामुकी-कामुका, कामः, चिकामयिषुः, चिकमिषुः, चङ्कामः-चङ्कमः;</li> <li>  कामयितव्यम्, कमितव्यम्, कामयितव्यम्, चिकामयिषितव्यम्, चिकमिषितव्यम्, चङ्कामयितव्यम्;</li> <li>  चङ्कमितव्यम्;</li> <li>  <sup id="ref_krm_0172_23"><a href="#foot_krm_0172_23">23</a></sup> प्रकामनीयम्, प्रकमनीयम्, कामनीयम्, चिकामयिषणीयम्, चिकमिषणीयम्, चङ्कामनीयम्;</li> <li>  चङ्कमनीयम्;</li> <li>  <sup id="ref_krm_0172_24"><a href="#foot_krm_0172_24">24</a></sup> काम्यम्- <sup id="ref_krm_0172_25"><a href="#foot_krm_0172_25">25</a></sup> कम्यम्, काम्यम्, चिकामयिष्यम्, चिकमिष्यम्, चङ्काम्यम्-चङ्कम्यम्;</li> <li>  ईषत्कामः-दुष्कामः-सुकामः, ईषत्कमः-दुष्कमः-सुकमः;</li> <li>  -- <sup id="ref_krm_0172_26"><a href="#foot_krm_0172_26">26</a></sup> काम्यमानः, काम्यमानः, काम्यमानः, चिकामयिष्यमाणः, चिकमिष्यमाणः, चङ्काम्यमानः-चङ्कम्यमानः;</li> <li>  <sup id="ref_krm_0172_27"><a href="#foot_krm_0172_27">27</a></sup> कामः-कामः, कामः, चिकामयिषः, चिकमिषः, चङ्कामः-चङ्कमः;</li> <li>  कामयितुम्-कमितुम्, कामयितुम्, चिकामयिषितुम्, चिकमिषितुम्, चङ्कामयितुम्;</li> <li>  चङ्कमितुम्;</li> <li>  कामना- <sup id="ref_krm_0172_28"><a href="#foot_krm_0172_28">28</a></sup> कान्तिः, कामना, चिकामयिषा-चिकमिषा, <sup id="ref_krm_0172_29"><a href="#foot_krm_0172_29">29</a></sup> चङ्कामा-चङ्कमा;</li> <li>  कामनम्, कमनम्, कामनम्, चिकामयिषणम्-चिकमिषणम्, चङ्कामनम्-चङ्कमनम्;</li> <li>  कामयित्वा, <sup id="ref_krm_0172_30"><a href="#foot_krm_0172_30">30</a></sup> कमित्वा, कान्त्वा, कामयित्वा, चिकामयिषित्वा चिकमिषित्वा चङ्कामयित्वा-चङ्कमित्वा;</li> <li>  प्रकाम्य-प्रकम्य, प्रकाम्य, प्रचिकामयिष्य-प्रचिकमिष्य, प्रचङ्काम्य-प्रचङ्कम्य;</li> <li>  <sup id="ref_krm_0172_31"><a href="#foot_krm_0172_31">31</a></sup> कामम् २ कामयित्वा २ कामम् २ कमित्वा २ कान्त्वा २ कामम् २ कामयित्वा २ चिकामयिषम् २, चिकामयिषित्वा २, चिकमिषम् २, चिकमिषित्वा २, चङ्कामम् २ -चङ्कमम् २;</li> <li>  चङ्कामयित्वा २ -चङ्कमित्वा २;</li> <li>  <sup id="ref_krm_0172_32"><a href="#foot_krm_0172_32">32</a></sup> कमठः, <sup id="ref_krm_0172_33"><a href="#foot_krm_0172_33">33</a></sup> कन्तुः, <sup id="ref_krm_0172_34"><a href="#foot_krm_0172_34">34</a></sup> कमलम्, <sup id="ref_krm_0172_35"><a href="#foot_krm_0172_35">35</a></sup> कंसः। </li> <li><sup id="ref_krm_0172_36"><a href="#foot_krm_0172_36">36</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0172_01"><a href="#ref_krm_0172_01">↑</a> (१६८)</li> <li id="foot_krm_0172_02"><a href="#ref_krm_0172_02">↑</a> (१-भ्वादिः-४४३। सक। सेट्। आत्म।)</li> <li id="foot_krm_0172_03"><a href="#ref_krm_0172_03">↑</a> [[१। ‘कमेर्णिङ्’ (३-१-३०) इति स्वार्थे णिङ्। अमन्तत्वेन मित्त्वं तु न, ‘न कम्य- मिचमाम्’ (ग। सू। भ्वादौ) इति निषेधात्। अतः, ‘अत उपधायाः’ (७-२-११६) इति वृद्धिः। एवं घञ्यपि।]]</li> <li id="foot_krm_0172_04"><a href="#ref_krm_0172_04">↑</a> [[२। ‘आयादय आर्धधातुके वा’ (३-१-३१) इति णिङो वैकल्पिकत्वात् णिङभावपक्षे, ण्वुलि वृद्धौ रूपम्। ‘नोदात्तोपदेशस्य--’ (७-३-४) इति निषेधस्तु न;\n\n  ‘अनाचमि- कमिवमीनाम्’ (वा। ७-३-३४) इति निषेधात्।]]</li> <li id="foot_krm_0172_05"><a href="#ref_krm_0172_05">↑</a> [[३। णिङ्पक्षे रूपम्। एवं सन्नन्ते सर्वत्र बोध्यम्।]]</li> <li id="foot_krm_0172_06"><a href="#ref_krm_0172_06">↑</a> [[४। यङन्तात् ण्वुलि ‘नुगतोऽनुनासिकान्तस्य’ (७-४-८५) इति अभ्यासे नुक्।]]</li> <li id="foot_krm_0172_07"><a href="#ref_krm_0172_07">↑</a> [[५। णिजन्तात् ‘णिचश्च’ (१-३-७४) इत्युभयपदी, न तु णिङन्तात्।]]</li> <li id="foot_krm_0172_08"><a href="#ref_krm_0172_08">↑</a> [[६। शानचः शित्त्वेन आर्धधातुकत्वाभावात् नित्यं णिङ्। णिङो ङित्त्वात् ‘अनुदात्तङित आत्मनेपदम्’ (१-३-१२) इति आत्मनेपदमेव।]]</li> <li id="foot_krm_0172_09"><a href="#ref_krm_0172_09">↑</a> [[७। णिङन्तात् शुद्धाच्च धातोः क्विपि ‘अनुनासिकस्य--’ (६-४-१५) इति दीर्घः। ‘मो नो धातोः’ (८-२-६४) इति नत्वम्।]]</li> <li id="foot_krm_0172_10"><a href="#ref_krm_0172_10">↑</a> [[८। णिङ्पक्षे ‘णेरनिटि’ (६-४-५१) इति निष्ठायां णिङो लोपः। सूत्रे ‘णेः’ इत्यनेन णिङोऽपि ग्रहणम्।]]</li> <li id="foot_krm_0172_11"><a href="#ref_krm_0172_11">↑</a> [[९। णिङभावपक्षे, धातोरुदित्त्वात् क्त्वायाम् इड्विकल्पः। तेन ‘यस्य विभाषा’ (७-२-१५) इति निष्ठायामिण्णिषेधे, ‘अनुनासिकस्य--’ (६-४-१५) इति दीर्घे च रूपम्।]]</li> <li id="foot_krm_0172_12"><a href="#ref_krm_0172_12">↑</a> [पृष्ठम्०१६४+ २६]</li> <li id="foot_krm_0172_13"><a href="#ref_krm_0172_13">↑</a> [[१। ताच्छील्ये णिनिः।]]</li> <li id="foot_krm_0172_14"><a href="#ref_krm_0172_14">↑</a> [[२। ‘शीलिकामिभक्ष्याचरिभ्यो णः’ (वा। ३-२-१) इति अणपवादः णः। तेन स्त्रियां टाप्।]]</li> <li id="foot_krm_0172_15"><a href="#ref_krm_0172_15">↑</a> [[३। ‘तुं काममनसोरपि।’ (वा। ६-३-१०९) इति तुमुनो मकारस्य लोपः।]]</li> <li id="foot_krm_0172_16"><a href="#ref_krm_0172_16">↑</a> [[आ। ‘इन्द्राबृहस्पत्युपकॢप्तमन्त्रा उत्साहिनोऽग्नीवरुणौ तथाऽन्ये। सुरा भवन्तं बत हन्तुकामाः प्रबोधयांचक्रुरधोक्षजं तम्।।’ वा। वि। २। ३३।]]</li> <li id="foot_krm_0172_17"><a href="#ref_krm_0172_17">↑</a> [[B। ‘स्तुतिशीला हरिकामा फलभक्षा कानने व्रताचारा। तदुपग्रहप्रतीक्षा वसति द्वन्द्वक्षमा मुनिश्रेणी।।’ इति प्र। सर्वस्वे।]]</li> <li id="foot_krm_0172_18"><a href="#ref_krm_0172_18">↑</a> [[४। ‘नमिकम्पिस्म्यजसकमहिंसदीपो रः’ (३-२-१६७) इति ताच्छीलिको रः प्रत्ययः।]]</li> <li id="foot_krm_0172_19"><a href="#ref_krm_0172_19">↑</a> [[C। ‘कम्राभिरावृतः स्त्रीभिराशंसुः क्षेममात्मनः। इच्छुः प्रसादं प्रणमन् सुग्रीवः प्रावदन् नृपम्।।’ भ। का। ७-२४।]]</li> <li id="foot_krm_0172_20"><a href="#ref_krm_0172_20">↑</a> [[५। ‘अनुदात्तेतश्च हलादेः’ (३-२-१४९) इति युच् ताच्छीलिकः। ‘ताच्छीलिकेषु ‘वाऽसरूपः--’ (३-१-९४) इति विधिर्नास्तीति प्रायिकम्;\n\n  तेन कम्रा कमना युवतिः, इति सिद्धम्--’ इति सि। कौमुदी।]]</li> <li id="foot_krm_0172_21"><a href="#ref_krm_0172_21">↑</a> [[६। ‘लषपतपदस्थाभूकमगम--’ (३-२-१५४) इत्यादिना तच्छीलादिषु उकञ्। स्त्रियां, ‘जानपद--’ (४-१-४२) इति विहितः ङीष् ‘कामुकी मैथुनेच्छा चेत्, कामुकाऽन्या,’ (वा। ४-१-४२) इति वार्तिकेन अर्थविशेषे नियमितः।]]</li> <li id="foot_krm_0172_22"><a href="#ref_krm_0172_22">↑</a> [[ड्। ‘प्रघिण्य भूषाः परिघुण्य मालिकाः प्रघृण्य घोणापुटघूर्णिचन्दनम्। पणाय्यरूपाः पनिताकृतीन् ययुर्भामिन्य एवाक्षमया स्वकामुकान्।।’ धा। का। १-५७।]]</li> <li id="foot_krm_0172_23"><a href="#ref_krm_0172_23">↑</a> [[७। ‘न भाभूपूकमिगमि--’ (८-४-३४) इति ‘ण्यन्तभादीनामुपसंख्यानम्’ (वा। ८-४-३४) इति च णत्वनिषेधः।]]</li> <li id="foot_krm_0172_24"><a href="#ref_krm_0172_24">↑</a> [[८। णिङन्तात्--णिजन्ताच्च ‘अचो यत्’ (३-१-९७) इति यत्।]]</li> <li id="foot_krm_0172_25"><a href="#ref_krm_0172_25">↑</a> [[९। शुद्धाद्धातोः ‘पोरदुपधात्’ (३-१-९८) इति यत्।]]</li> <li id="foot_krm_0172_26"><a href="#ref_krm_0172_26">↑</a> [पृष्ठम्०१६५+ २०]</li> <li id="foot_krm_0172_27"><a href="#ref_krm_0172_27">↑</a> [[आ। ‘यायास्त्वमिति कामो मे गन्तुमुत्सहसे न च। इच्छुः कामयितुं त्वं माम् इत्यसौ जगदे तया।।’ भ। का। ५-५९।]]</li> <li id="foot_krm_0172_28"><a href="#ref_krm_0172_28">↑</a> [[B। ‘सायन्तनीं तिथिप्रण्यः पङ्कजानां दिवातनीम्। कान्तिं कान्त्या सदातन्या ह्रेपयन्ती शुचिस्मिता।।’ भ। का। ५-६५।]]</li> <li id="foot_krm_0172_29"><a href="#ref_krm_0172_29">↑</a> [[१। ‘यस्य हलः’ (६-४-४९) इति यलोपे, अतो लोपे च रूपमेवम्।]]</li> <li id="foot_krm_0172_30"><a href="#ref_krm_0172_30">↑</a> [[२। णिङभावपक्षे धातोरुदित्त्वात् ‘उदितो वा’ (७-२-५६) इति क्त्वायामिड्विकल्पः। इडभावपक्षे दीर्घे रूपम्।]]</li> <li id="foot_krm_0172_31"><a href="#ref_krm_0172_31">↑</a> [[३। ‘न कम्यमि--’ (ग। सू। भ्वादौ) इति मित्त्वनिषेधात् णिङन्तात् णिजन्ताच्च न दीर्घविकल्पः।]]</li> <li id="foot_krm_0172_32"><a href="#ref_krm_0172_32">↑</a> [[४। ‘कमेरठः’ (द। उ। ५। ५।) इत्यठः प्रत्ययः। कमठः = कूर्मः, भिक्षाभाजनं वा।]]</li> <li id="foot_krm_0172_33"><a href="#ref_krm_0172_33">↑</a> [[५। औणादिके (द। उ। १-११२) कुप्रत्यये तुगागमः। कन्तुः = कामी।]]</li> <li id="foot_krm_0172_34"><a href="#ref_krm_0172_34">↑</a> [[६। औणादिके (द। उ। ८-१०७) कलप्रत्यये रूपम्। कमलम् = पद्मम्।]]</li> <li id="foot_krm_0172_35"><a href="#ref_krm_0172_35">↑</a> [[७। औणादिके (द। उ। ९-२१।) सप्रत्यये रूपम्।]]</li> <li id="foot_krm_0172_36"><a href="#ref_krm_0172_36">↑</a> [पृष्ठम्०१६६+ २४]</li></ul></p>

