<ul><li><sup id="ref_krm_0878_01"><a href="#foot_krm_0878_01">1</a></sup> {@“दॄ विदारणे”@} <sup id="ref_krm_0878_02"><a href="#foot_krm_0878_02">2</a></sup> प्वादिः। </li> <li>‘भये च’ इति कविकल्पद्रुमे। </li> <li>अर्थविशेषे घटादिः। </li> <li><sup id="ref_krm_0878_03"><a href="#foot_krm_0878_03">3</a></sup> ‘दॄ भये’ इति क्र्यातिषु पठितो धातुः, अस्यैव मित्त्वार्थमर्थविशेषे घटादित्वम् इति बहूनां मतम्। </li> <li>क्षीरस्वाम्यादयस्तु भ्वादिषु स्वतन्त्रं धातुममुं मन्यन्ते। </li> <li>देवोऽपि तेषामनुकूलः। </li> <li>सिद्धान्तकौमुद्याद्यनुसारेणास्माभिः अर्थविशेषे घटादित्वमङ्गीकृत्य विलिखितम्।]] ‘दरेद् दृणाति द्रियते क्रमाद् भीदारणादरे।’ <sup id="ref_krm_0878_04"><a href="#foot_krm_0878_04">4</a></sup> इति देवः। </li> <li><sup id="ref_krm_0878_05"><a href="#foot_krm_0878_05">5</a></sup> <sup id="ref_krm_0878_06"><a href="#foot_krm_0878_06">6</a></sup> दारकः-रिका, दारकः- <sup id="ref_krm_0878_07"><a href="#foot_krm_0878_07">7</a></sup> दरकः- <sup id="ref_krm_0878_08"><a href="#foot_krm_0878_08">8</a></sup> ह्मल्यचित्तां स्मरयत्यसौ मां नन्दात्मजः सन्दरकः खलानाम्।’ धा। </li> <li>का। </li> <li>२। ११।]] रिका, <sup id="ref_krm_0878_09"><a href="#foot_krm_0878_09">9</a></sup> दिदरिषकः-दिदरीषकः-दिदीर्षकः-र्षिका, <sup id="ref_krm_0878_10"><a href="#foot_krm_0878_10">10</a></sup> देदिरकः-रिका;</li> <li>  <sup id="ref_krm_0878_11"><a href="#foot_krm_0878_11">11</a></sup> दरिता-दरीता-त्री, दारयिता-दरयिता-त्री, दिदरिषिता-दिदरीषिता-दिदीर्षिता-त्री, देदिरिता-त्री;</li> <li>  <sup id="ref_krm_0878_12"><a href="#foot_krm_0878_12">12</a></sup> दृणन्-ती, दारयन्-दरयन्-न्ती, दिदरिषन्-दिदरीषन्-दिदीर्षन्-न्ती;</li> <li>  -- दरिष्यन्-दरीष्यन्-न्ती-ती, दारयिष्यन्-दरयिष्यन्-न्ती-ती, दिदरिषिष्यन्-दिदरीषिष्यन्-दिदीर्षिष्यन्-न्ती-ती;</li> <li>  -- <sup id="ref_krm_0878_13"><a href="#foot_krm_0878_13">13</a></sup> व्यतिदृणानः, दारयमाणः-दरयमाणः, व्यतिदिदरिषमाणः-व्यतिदिदरीषमाणः-व्यतिदिदीर्षमाणः, देदीर्यमाणः;</li> <li>  व्यतिदरिष्यमाणः-व्यतिदरीष्यमाणः, दारयिष्यमाणः-दरयिष्यमाणः, व्यतिदि- दरि<sup id="ref_krm_0878_14"><a href="#foot_krm_0878_14">14</a></sup>षिष्यमाणः, व्यतिदिदीर्षिष्यमाणः, देदिरिष्यमाणः;</li> <li>  <sup id="ref_krm_0878_15"><a href="#foot_krm_0878_15">15</a></sup> प्रदीः-प्रदिरौः-प्रदिरः, <sup id="ref_krm_0878_16"><a href="#foot_krm_0878_16">16</a></sup> ददृत्;</li> <li>  -- -- <sup id="ref_krm_0878_17"><a href="#foot_krm_0878_17">17</a></sup> <sup id="ref_krm_0878_18"><a href="#foot_krm_0878_18">18</a></sup> दीर्णम्-दीर्णः-दीर्णवान्, <sup id="ref_krm_0878_19"><a href="#foot_krm_0878_19">19</a></sup> दारितः-दरितः, दिदरिषितः-दिदरीषितः-दिदीर्षितः, देदिरितः-तवान्;</li> <li>  <sup id="ref_krm_0878_20"><a href="#foot_krm_0878_20">20</a></sup> दरः-दरी, <sup id="ref_krm_0878_21"><a href="#foot_krm_0878_21">21</a></sup> दाराः, <sup id="ref_krm_0878_22"><a href="#foot_krm_0878_22">22</a></sup> पुरन्दरः, <sup id="ref_krm_0878_23"><a href="#foot_krm_0878_23">23</a></sup> <sup id="ref_krm_0878_24"><a href="#foot_krm_0878_24">24</a></sup> भगन्दरः, विदारी, दारः-दरः, दिदरिषुः-दिदरीषुः-दिदीर्षुः, देदिरः;</li> <li>  दरितव्यम्-दरीतव्यम्, दारयितव्यम्-दरयितव्यम्, दिदरिषितव्यम्-दिदरीषितव्यम्-दिदीर्षितव्यम्, देदिरितव्यम्;</li> <li>  दरणीयम्, दारणीयम्-दरणीयम्, दिदरिषणीयम्-दिदरीषणीयम्-दिदीर्षणीयम्, देदिरणीयम्;</li> <li>  दार्यम्, दार्यम्-दर्यम्, दिदरिष्यम्-दिदरीष्यम्-दिदीर्ष्यम्, देदीर्यम्;</li> <li>  ईषद्दरः-दुर्दरः-सुदरः;</li> <li>  -- -- -- दीर्यमाणः, दार्यमाणः-दर्यमाणः, दिदरिष्यमाणः-दिदरीष्यमाणः-दिदीर्ष्यमाणः, देदीर्यमाणः;</li> <li>  दरः, दारः-दरः, दिदरिषः-दिदरीषः-दिदीर्षः, देदिरः;</li> <li>  दरितुम्-दरीतुम्, दारयितुम्, दरयितुम्, दिदरिषितुम्-दिदरीषितुम्-दिदीर्षितुम्, देदिरितुम्;</li> <li>  <sup id="ref_krm_0878_25"><a href="#foot_krm_0878_25">25</a></sup> <sup id="ref_krm_0878_26"><a href="#foot_krm_0878_26">26</a></sup> दीर्णिः, दारणा-दरणा, दिदरिषा-दिदरीषा-दिदीर्षा, देदिरा;</li> <li>  दरणम्, दारणम्-दरणम्, दिदरिषणम्-दिदरीषणम्-दिदीर्षणम्, देदिरणम्;</li> <li>  <sup id="ref_krm_0878_27"><a href="#foot_krm_0878_27">27</a></sup> दीर्त्वा, दारयित्वा-दरयित्वा, दिदरिषित्वा-दिदरीषित्वा-दिदीर्षित्वा, देदिरित्वा;</li> <li>  विदीर्य, विदार्य- <sup id="ref_krm_0878_28"><a href="#foot_krm_0878_28">28</a></sup> विदरय्य, विदिदरिष्य-विदिदरीष्य-विदिदीर्ष्य, विदेदीर्य;</li> <li>  <sup id="ref_krm_0878_29"><a href="#foot_krm_0878_29">29</a></sup> उरोविदारं <sup id="ref_krm_0878_30"><a href="#foot_krm_0878_30">30</a></sup> <sup id="ref_krm_0878_31"><a href="#foot_krm_0878_31">31</a></sup> दारम् २, दीर्त्वा २, दारम् २- <sup id="ref_krm_0878_32"><a href="#foot_krm_0878_32">32</a></sup> दरम् २, दारम् २, दारयित्वा २ -दरयित्वा २, दिदरिषम् २ -दिदरीषम् २ -दिदरिषित्वा २ -दिदरीषित्वा २ -दिदीर्षम् २, दिदीर्षित्वा २, देदिरम् २;</li> <li>  देदिरित्वा २। <sup id="ref_krm_0878_33"><a href="#foot_krm_0878_33">33</a></sup> इति तिप्रत्यये रूपम्। </li> <li>ह्रस्वश्च। </li> <li>दृतिः = भस्त्रा।]] दृतिः, <sup id="ref_krm_0878_34"><a href="#foot_krm_0878_34">34</a></sup> इति ञुण्प्रत्यये वृद्धौ च रूपम्। </li> <li>दारु = काष्ठम्।]] दारु, <sup id="ref_krm_0878_35"><a href="#foot_krm_0878_35">35</a></sup> इत्यत्र पाठात् साधुः। </li> <li>दर्दरीकम् = वाद्यविशेषः।]] दर्दरीकम्, <sup id="ref_krm_0878_36"><a href="#foot_krm_0878_36">36</a></sup> इत्युनन्प्रत्ययः। </li> <li>दारुणः = घोरः।]] दारुणः, <sup id="ref_krm_0878_37"><a href="#foot_krm_0878_37">37</a></sup> इत्यदिप्रत्ययः। </li> <li>दरत् = भीरुः।]] दरत्, <sup id="ref_krm_0878_38"><a href="#foot_krm_0878_38">38</a></sup> इत्यदिप्रत्यये षुगागमह्रस्वौ भवतः दृषत् = शिला।]] दृषत्, <sup id="ref_krm_0878_39"><a href="#foot_krm_0878_39">39</a></sup> इत्युरच्प्रत्ययो दुगागमः गुणश्च निपात्यते दर्दुरः = मण्डूकः।]] दर्दुरः, <sup id="ref_krm_0878_40"><a href="#foot_krm_0878_40">40</a></sup> इति अल् अच् वा प्रत्यः उपसर्गान्त्यलोपश्च। </li> <li>उदरम् = जठरम्।]] उदरम्। </li> <li><sup id="ref_krm_0878_41"><a href="#foot_krm_0878_41">41</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0878_01"><a href="#ref_krm_0878_01">↑</a> (८६८)</li> <li id="foot_krm_0878_02"><a href="#ref_krm_0878_02">↑</a> (९-क्र्यादिः-१४९३। सक। सेट्। पर।)</li> <li id="foot_krm_0878_03"><a href="#ref_krm_0878_03">↑</a> [[[अ]</li> <li id="foot_krm_0878_04"><a href="#ref_krm_0878_04">↑</a> (श्लो। ३६)</li> <li id="foot_krm_0878_05"><a href="#ref_krm_0878_05">↑</a> [पृष्ठम्०७६९+ २२]</li> <li id="foot_krm_0878_06"><a href="#ref_krm_0878_06">↑</a> [[१। ‘इत्त्वोत्त्वाभ्यां गुणवृद्धी विप्रतिषेधेन’ (वा। ७-१-१०२) इति वचनात् इत्त्वं बाधि- त्वाऽत्र वृद्धिः। एवं गुणवृद्धियोग्यस्थलेषु ज्ञेयम्।]]</li> <li id="foot_krm_0878_07"><a href="#ref_krm_0878_07">↑</a> [[२। ‘दॄ भये’ इति घटादिषु पाठात् मित्त्वम्। तेन ण्यन्ते, ‘मितां ह्रस्वः’ (६-४-९२) इत्युपधाया ह्रस्वः। एवं घटादिषु पाठे ण्यन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0878_08"><a href="#ref_krm_0878_08">↑</a> [[आ। ‘प्र [अ]</li> <li id="foot_krm_0878_09"><a href="#ref_krm_0878_09">↑</a> [[३। ‘इट् समि वा’ (७-२-४१) इतीड्विकल्पः। इट्पक्षे, ‘वॄतो वा’ (७-२-३८) इति दीर्घविकल्पः। तेन सन्नन्ते सर्वत्र रूपत्रयं बोध्यम्।]]</li> <li id="foot_krm_0878_10"><a href="#ref_krm_0878_10">↑</a> [[४। यङन्तात् ण्वुलि, ‘ॠत इद् धातोः’ (७-१-१००) इति इत्त्वे रपरत्वे, अभ्यासे गुणे च रूपम्। एवं यङन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0878_11"><a href="#ref_krm_0878_11">↑</a> [[५। तृचि, इटो दीर्घविकल्पाद्रूपद्वयम्। एवं तव्यदादिष्वपि ज्ञेयम्।]]</li> <li id="foot_krm_0878_12"><a href="#ref_krm_0878_12">↑</a> [[६। शतरि, ‘क्र्यादिभ्यः--’ (३-१-८१) इति श्नाप्रत्यये, ‘प्वादीनां ह्रस्वः’ (७-३-८०) इत्यङ्गस्य ह्रस्वे, ‘श्नाऽभ्यस्तयोरातः’ (६-४-११२) इत्याकारलोपे णत्वे च रूपम्। एवं शानजन्तेऽपि प्रक्रिया ज्ञेया।]]</li> <li id="foot_krm_0878_13"><a href="#ref_krm_0878_13">↑</a> [[७। ‘कर्तरि कर्मव्यतीहारे’ (१-३-१४) इति शानच्।]]</li> <li id="foot_krm_0878_14"><a href="#ref_krm_0878_14">↑</a> [री]</li> <li id="foot_krm_0878_15"><a href="#ref_krm_0878_15">↑</a> [[८। क्विपि, इत्वे रपरत्वे च, ‘र्वोरुपधाया दीर्घ इकः’ (८-२-७६) इति दीर्घे विसर्गे च रूपम्।]]</li> <li id="foot_krm_0878_16"><a href="#ref_krm_0878_16">↑</a> [[९। भयार्थादस्मात्, तच्छीलादिषु कर्तृषु ‘दृणातेर्ह्रस्वश्च’ (वा। ३-२-१७८) इति क्विपि, अङ्गस्य द्वित्वे ह्रस्वे च, ‘ह्रस्वस्य पिति कृति--’ (६-१-७१) इति तुकि च रूपम्।]]</li> <li id="foot_krm_0878_17"><a href="#ref_krm_0878_17">↑</a> [पृष्ठम्०७७०+ २४]</li> <li id="foot_krm_0878_18"><a href="#ref_krm_0878_18">↑</a> [[१। निष्ठायाम्, इत्वे रपरत्वे दीर्घे, च ‘रदाभ्याम्--’ (८-२-४२) इति निष्ठानत्वे णत्वे च, रूपम्।]]</li> <li id="foot_krm_0878_19"><a href="#ref_krm_0878_19">↑</a> [[आ। ‘क्रव्यात्पूगैः पुष्कराण्यानकानां प्रत्याशाभिर्मेदसो दारितानि।’ शि। व। १८। ७८।]]</li> <li id="foot_krm_0878_20"><a href="#ref_krm_0878_20">↑</a> [[२। पचादिषु पाठात् अच्। स्त्रियाम् गौरादिपाठात् (४-१-४१) ङीष् इति माधवः। पचादिषु ‘दरट्’ इति पाठात् टित्त्वेन, ‘टिड्ढा--’ (४-१-१५) इति ङीप् इति क्षीरस्वामी।]]</li> <li id="foot_krm_0878_21"><a href="#ref_krm_0878_21">↑</a> [[३। ‘दारजारौ कर्तरि णिलुक् च’ (वा। ३-३-२०) इति कर्तरि घञ्। दारयन्ति इति दाराः = पत्नी। बहुवचनं तु लोकाद्भवति।]]</li> <li id="foot_krm_0878_22"><a href="#ref_krm_0878_22">↑</a> [[४। ‘पूःसर्वयोर्दारिसहोः’ (३-२-४१) इति ण्यन्तात् खच्। ‘खित्यनव्ययस्य’ (६-३-६६) इति वर्तमाने, ‘अरुर्द्विषदजन्तस्य--’ (६-३-६७) इति मुम्। ‘खचि ह्रस्वः’ (६-४-९४) इति वा, ‘मितां ह्रस्वः’ (६-४-९२) इति वा ह्रस्वः। ‘बाचंयमपुरन्दरौ च’ (६-३-६९) इत्यनेन निपातनादमन्तत्वम्। पुरं दारयतीति पुरन्दरः = इन्द्रः।]]</li> <li id="foot_krm_0878_23"><a href="#ref_krm_0878_23">↑</a> [[B। ‘पौलोमीकुचकुम्भकुङ्कुमरजःस्वाजन्यजन्मोद्धताः शीतांशोर्द्युतयः पुरन्दरपुरीसीम्नामुपस्कुर्वते।’ अनर्घराघवे २। ७३।]]</li> <li id="foot_krm_0878_24"><a href="#ref_krm_0878_24">↑</a> [[५। ‘भगे च दारेरिति वक्तव्यम्’ (वा। ३-२-४१) इति खचि, मुमि च रूपम्। भगन्दरः = व्याधिविशेषः।]]</li> <li id="foot_krm_0878_25"><a href="#ref_krm_0878_25">↑</a> [पृष्ठम्०७७१+ २४]</li> <li id="foot_krm_0878_26"><a href="#ref_krm_0878_26">↑</a> [[१। ‘ॠल्वादिभ्यः--’ (वा। ८-२-४४) इति क्तिनस्तकारस्य नत्वे णत्वे च रूपम्। :]]</li> <li id="foot_krm_0878_27"><a href="#ref_krm_0878_27">↑</a> [[२। ‘श्रयुकः क्किति’ (७-२-११) इति क्त्वाया इण्निषेधः।]]</li> <li id="foot_krm_0878_28"><a href="#ref_krm_0878_28">↑</a> [[३। भयार्थे ण्यन्तात् ल्यपि, उपधाह्रस्वे, ‘ल्यपि लघुपूर्वात्’ (६-४-५६) इति णेरयादेशः।]]</li> <li id="foot_krm_0878_29"><a href="#ref_krm_0878_29">↑</a> [[४। ‘परिक्लिश्यमाने च’ (३-४-५५) इति णमुल्।]]</li> <li id="foot_krm_0878_30"><a href="#ref_krm_0878_30">↑</a> [[आ। ‘स मुधिकान्तास्तनसङ्गभङ्गुरैरुरोविदारं प्रतिचस्करे नखैः।।’ शि। व। १। ४७।]]</li> <li id="foot_krm_0878_31"><a href="#ref_krm_0878_31">↑</a> [प्रतिचस्करे नखैः।]</li> <li id="foot_krm_0878_32"><a href="#ref_krm_0878_32">↑</a> [[५। ‘चिण्णमुलोर्दीर्घोऽन्यतरस्याम्’ (६-४-९३) इति ण्यन्ताण्णमुलि दीर्घविकल्पः।]]</li> <li id="foot_krm_0878_33"><a href="#ref_krm_0878_33">↑</a> [[६। ‘दृणातेः किध्रस्वश्च’ [द। उ। १-७६]</li> <li id="foot_krm_0878_34"><a href="#ref_krm_0878_34">↑</a> [[७। ‘दॄसनिजनि--’ [द। उ। १। ८८]</li> <li id="foot_krm_0878_35"><a href="#ref_krm_0878_35">↑</a> [[८। ‘फर्फरीकादयश्च’ [द। उ। ३। ३८]</li> <li id="foot_krm_0878_36"><a href="#ref_krm_0878_36">↑</a> [[९। ‘कॄवृतॄदारिभ्य उनन्’ [द। उ। ५। ५२]</li> <li id="foot_krm_0878_37"><a href="#ref_krm_0878_37">↑</a> [[१०। ‘श्रॄदृभसोऽदिः’ [द। उ। ६। ४२]</li> <li id="foot_krm_0878_38"><a href="#ref_krm_0878_38">↑</a> [[११। ‘दृणातेः षुग्घ्रस्वश्च’ [द। उ। ६। ४५]</li> <li id="foot_krm_0878_39"><a href="#ref_krm_0878_39">↑</a> [[१२। ‘मुकुरदर्दुरौ’ [द। उ। ८। २३]</li> <li id="foot_krm_0878_40"><a href="#ref_krm_0878_40">↑</a> [[१३। ‘उदि दृणातेरलचौ पूर्वपदान्त्यलोपश्च’ [द। उ। ८-९७]</li> <li id="foot_krm_0878_41"><a href="#ref_krm_0878_41">↑</a> [पृष्ठम्०७७२+ २६]</li></ul></p>

देङ्|दायकः-यिका|दापकः-पिका|दित्सकः-त्सिका|देदीयकः-यिका
<ul><li><sup id="ref_krm_0879_01"><a href="#foot_krm_0879_01">1</a></sup> {@“देङ् रक्षणे”@} <sup id="ref_krm_0879_02"><a href="#foot_krm_0879_02">2</a></sup> ‘दाञो दत्ते ददातीति दाणो यच्छति दो द्यति। </li> <li>दाति दायति दाप्दैपोर्दयते रक्षणे ङितः।।’ <sup id="ref_krm_0879_03"><a href="#foot_krm_0879_03">3</a></sup> इति देवः। </li> <li>दायकः-यिका, दापकः-पिका, दित्सकः-त्सिका, देदीयकः-यिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकदानार्थकदाण्धातुवत् <sup id="ref_krm_0879_04"><a href="#foot_krm_0879_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0879_05"><a href="#foot_krm_0879_05">5</a></sup> प्रणिदयमानः, प्रणिदास्यमानः इति शानजन्ते ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0879_01"><a href="#ref_krm_0879_01">↑</a> (८६९)</li> <li id="foot_krm_0879_02"><a href="#ref_krm_0879_02">↑</a> (१-भ्वादिः-९६२। सक। अनि। आत्म।)</li> <li id="foot_krm_0879_03"><a href="#ref_krm_0879_03">↑</a> (श्लो। ४)</li> <li id="foot_krm_0879_04"><a href="#ref_krm_0879_04">↑</a> (८३१)</li> <li id="foot_krm_0879_05"><a href="#ref_krm_0879_05">↑</a> [[१। शानचि, आत्वाभावे, अयादेशे, ‘नेर्गदनदपतपदघु--’ (८-४-१७) इत्यादिना णत्वे, च रूपम्।]]</li></ul></p>

देवृ|देवकः-विका|दिदेविषकः-षिका|देदेवकः-विका
<ul><li><sup id="ref_krm_0880_01"><a href="#foot_krm_0880_01">1</a></sup> {@“देवृ देवने”@} <sup id="ref_krm_0880_02"><a href="#foot_krm_0880_02">2</a></sup> ‘अर्दने देवयेत् दीव्येत् क्रीडादौ परिकूजने।। </li> <li>देवयेतेदितो दिन्वेद् देवेर्देवेत देवने।’ <sup id="ref_krm_0880_03"><a href="#foot_krm_0880_03">3</a></sup> इति देवः। </li> <li>देवकः-विका, देवकः-विका, दिदेविषकः-षिका, देदेवकः-विका;</li> <li>  इत्यादीनि सर्वाणि रूपाणि भौवादिककेपतिवत् <sup id="ref_krm_0880_04"><a href="#foot_krm_0880_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0880_05"><a href="#foot_krm_0880_05">5</a></sup> देवनम्। </li> <li><sup id="ref_krm_0880_06"><a href="#foot_krm_0880_06">6</a></sup> आदेवकः, <sup id="ref_krm_0880_07"><a href="#foot_krm_0880_07">7</a></sup> परिदेवी <sup id="ref_krm_0880_08"><a href="#foot_krm_0880_08">8</a></sup>, <sup id="ref_krm_0880_09"><a href="#foot_krm_0880_09">9</a></sup> दयूः-दय्वौ-दय्वः, <sup id="ref_krm_0880_10"><a href="#foot_krm_0880_10">10</a></sup> इति अरन्प्रत्ययः। </li> <li>देवरः = पति- भ्राता।]] देवरः, <sup id="ref_krm_0880_11"><a href="#foot_krm_0880_11">11</a></sup> इति कलप्रत्ययः। </li> <li>देवलः = ऋषिः।]] देवलः, देवनः युजन्तोऽयम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0880_01"><a href="#ref_krm_0880_01">↑</a> (८७०)</li> <li id="foot_krm_0880_02"><a href="#ref_krm_0880_02">↑</a> (१-भ्वादिः-५००। अक। सेट्। आत्म।)</li> <li id="foot_krm_0880_03"><a href="#ref_krm_0880_03">↑</a> (श्लो। १६०-६१)</li> <li id="foot_krm_0880_04"><a href="#ref_krm_0880_04">↑</a> (२६१)</li> <li id="foot_krm_0880_05"><a href="#ref_krm_0880_05">↑</a> [[आ। ‘कलोरुकल्लोलकलिन्दजाजले बालैस्तयूभिस्सह देवनोत्सुकम्।।’ धा। का। १। ६४।]]</li> <li id="foot_krm_0880_06"><a href="#ref_krm_0880_06">↑</a> [[२। ‘देविक्रुशोश्चोपसर्गे’ (३-२-१४७) इति तच्छीलादिषु कर्तृषु वुन्प्रत्ययः।]]</li> <li id="foot_krm_0880_07"><a href="#ref_krm_0880_07">↑</a> [[३। ‘सम्पृचानुरुधाङ्यमाङ्यसपरिसृसंसृजपरिदेवि--’ (३-२-१४२) इति तच्छीलादिषु कर्तृषु घिनुण्प्रत्ययः।]]</li> <li id="foot_krm_0880_08"><a href="#ref_krm_0880_08">↑</a> [[B। ‘श्रुत्वा विस्फूर्जथुप्रख्यं निनादं परिदेविनी।’ भ। का। ५। ५३।]]</li> <li id="foot_krm_0880_09"><a href="#ref_krm_0880_09">↑</a> [[४। क्विपि, वकारस्य ऊठि, अयादेशे, रूपम्।]]</li> <li id="foot_krm_0880_10"><a href="#ref_krm_0880_10">↑</a> [[५। ‘अर्त्तिकमिभ्रमिदेवि--’ [द। उ। ८-६२]</li> <li id="foot_krm_0880_11"><a href="#ref_krm_0880_11">↑</a> [[६। ‘वृषादिभ्यश्चित्’ [द। उ। ८-१०९]</li></ul></p>

दैप्|दायकः-यिका|दापकः-पिका|दिदासकः-सिका|दादायकः-यिका
<ul><li><sup id="ref_krm_0881_01"><a href="#foot_krm_0881_01">1</a></sup> {@“दैप् शोधने”@} <sup id="ref_krm_0881_02"><a href="#foot_krm_0881_02">2</a></sup> ‘दाति दायति दाप्दैपोः दयते रक्षणे ङितः।।’ <sup id="ref_krm_0881_03"><a href="#foot_krm_0881_03">3</a></sup> इति देवः। </li> <li>दायकः-यिका, दापकः-पिका, दिदासकः-सिका, दादायकः-यिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि आदादिकदाप्धातुवत् <sup id="ref_krm_0881_04"><a href="#foot_krm_0881_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0881_05"><a href="#foot_krm_0881_05">5</a></sup> <sup id="ref_krm_0881_06"><a href="#foot_krm_0881_06">6</a></sup> प्रणिदायन्-प्रनिदायन्-न्ती, इति शतरि रूपमिति विशेषः। </li> <li><sup id="ref_krm_0881_07"><a href="#foot_krm_0881_07">7</a></sup> अवदातः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0881_01"><a href="#ref_krm_0881_01">↑</a> (८७१)</li> <li id="foot_krm_0881_02"><a href="#ref_krm_0881_02">↑</a> (१-भ्वादिः-९२४। सक। अनि। पर।)</li> <li id="foot_krm_0881_03"><a href="#ref_krm_0881_03">↑</a> (श्लो। ४)</li> <li id="foot_krm_0881_04"><a href="#ref_krm_0881_04">↑</a> (८३३)</li> <li id="foot_krm_0881_05"><a href="#ref_krm_0881_05">↑</a> [पृष्ठम्०७७३+ २३]</li> <li id="foot_krm_0881_06"><a href="#ref_krm_0881_06">↑</a> [[१। शतरि, आयादेशे, ‘शेषे विभाषा--’ (८-४-१८) इति प्रपूर्वकात् नेः णत्वविकल्पे च रूपमेवम्।]]</li> <li id="foot_krm_0881_07"><a href="#ref_krm_0881_07">↑</a> [[आ। ‘स्नातावदातः स पिबंस्तदाभां जिघ्रन् सुगन्धं विधमन् अघानि।’ धा। का। २। ३३।]]</li></ul></p>

दो|दायकः-यिका|दापकः-पिका|दित्सकः-त्सिका|देदीयकः-यिका
<ul><li><sup id="ref_krm_0882_01"><a href="#foot_krm_0882_01">1</a></sup> {@“दो अवखण्डने”@} <sup id="ref_krm_0882_02"><a href="#foot_krm_0882_02">2</a></sup> दायकः-यिका, दापकः-पिका, दित्सकः-त्सिका, देदीयकः-यिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकदाण्धातुवत् <sup id="ref_krm_0882_03"><a href="#foot_krm_0882_03">3</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_0882_04"><a href="#foot_krm_0882_04">4</a></sup> प्रणिद्यन्-द्यती, <sup id="ref_krm_0882_05"><a href="#foot_krm_0882_05">5</a></sup> दितम्-दितः-दितवान्, दितिः, दित्वा, <sup id="ref_krm_0882_06"><a href="#foot_krm_0882_06">6</a></sup> प्रदाय, <sup id="ref_krm_0882_07"><a href="#foot_krm_0882_07">7</a></sup> जनदः, <sup id="ref_krm_0882_08"><a href="#foot_krm_0882_08">8</a></sup> इत्यादीनि रूपाण्यस्य भवन्तीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0882_01"><a href="#ref_krm_0882_01">↑</a> (८७२)</li> <li id="foot_krm_0882_02"><a href="#ref_krm_0882_02">↑</a> (४-दिवादिः-११४८। सक। अनि। पर।)</li> <li id="foot_krm_0882_03"><a href="#ref_krm_0882_03">↑</a> (८३१)</li> <li id="foot_krm_0882_04"><a href="#ref_krm_0882_04">↑</a> [[२। शतरि, ‘दिवादिभ्यः--’ (३-१-६९) इति श्यन्प्रत्यये, ‘ओतः श्यनि’ (७-३-७१) इत्योकारलोपः। घुसंज्ञकत्वात् नेर्णत्वम्।]]</li> <li id="foot_krm_0882_05"><a href="#ref_krm_0882_05">↑</a> [[३। ‘द्यतिस्यतिमास्थामित् ति किति’ (७-४-४०) इतीत्वम्, तकारादौ किति प्रत्यये परतः सर्वत्र ज्ञेयम्। निष्ठायामजन्तोपसर्गात् परत्र तु यथासम्भवं अवत्तः इत्यादिकानि रूपाणि भवन्त्येव।]]</li> <li id="foot_krm_0882_06"><a href="#ref_krm_0882_06">↑</a> [[४। ‘न ल्यपि’ (६-४-६९) इति ईत्वनिषेधः। ‘अन्तरङ्गानपि विधीन् बहिरङ्गो ल्यब् बाधते’ (परिभाषा ५५) इति न्यायेन इत्वमपि न भवति।]]</li> <li id="foot_krm_0882_07"><a href="#ref_krm_0882_07">↑</a> [[५। क्विबन्तमेतत्। क्विपि सर्वलोपः।]]</li> <li id="foot_krm_0882_08"><a href="#ref_krm_0882_08">↑</a> [[B। ‘धर्मावसायजनदाः खलु योऽजनिष्ट दीप्तोष्मपूर्णभुजतूर्णविधूर्णवैरी।।’ धा। का। २। ५९।]]</li></ul></p>

द्यु|द्यावकः-विका|दुद्यूषकः-षिका|देद्यूयकः-यिका
<ul><li><sup id="ref_krm_0883_01"><a href="#foot_krm_0883_01">1</a></sup> {@“द्यु अभिगमने”@} <sup id="ref_krm_0883_02"><a href="#foot_krm_0883_02">2</a></sup> द्यावकः-विका, द्यावकः-विका, दुद्यूषकः-षिका, देद्यूयकः-यिका;</li> <li>  इति सर्वाण्यपि रूपाणि भौवादिकदुधातुवत् <sup id="ref_krm_0883_03"><a href="#foot_krm_0883_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0883_04"><a href="#foot_krm_0883_04">4</a></sup> द्युवन्-द्युवती इति शतरि रूपमिति विशेषः। </li> <li>“केचिदस्य सेट्त्वमिच्छन्ति। </li> <li>इति धातुपारायणे। </li> <li>तत् ‘उतां च रुस्नुवौ क्षुवं तथोर्णोतिमथो युणुक्ष्णुवः।’ इत्युकारान्तसेट्परिगणने पाठाभावादिच्छामात्रम्।” इति माधवधातुवृत्तिः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0883_01"><a href="#ref_krm_0883_01">↑</a> (८७३)</li> <li id="foot_krm_0883_02"><a href="#ref_krm_0883_02">↑</a> (२-अदादिः-१०४०। सक। अनि। पर।)</li> <li id="foot_krm_0883_03"><a href="#ref_krm_0883_03">↑</a> (८४७)</li> <li id="foot_krm_0883_04"><a href="#ref_krm_0883_04">↑</a> [[C। ‘गुहाया निरगाद् वाली सिंहो मृगमिव द्युवन्।’ भ। का। ६। ११९।]]</li></ul></p>

द्युत|द्योतकः-तिका|दिद्युतिषकः-दिद्योतिषकः-षिका|देद्युतकः-तिका|द्योतिता-त्री|द्योतयिता-त्री|दिद्युतिषिता-दिद्योतिषिता-त्री|देद्युतिता-त्री|-|द्योतयन्-न्ती|द्योतयिष्यन्-न्ती-ती|द्योतमानः|द्योतयमानः|दिद्युतिषमाणः-दिद्योतिषमाणः|देद्युत्यमानः|द्योतिष्यमाणः|द्योतयिष्यमाणः|दिद्युतिषिष्यमाणः-दिद्योतिषिष्यमाणः|देद्युतिष्यमाणः|दिद्युत्-दिद्युतौ-दिद्युतः|-द्युतितम्-द्योतितम्-तः|द्योतितः|दिद्युतिषितः-दिद्योतिषितः|देद्युतितः-तवान्|द्योतः|खद्योतः|प्रद्योतनः|उद्द्योती|विदिद्युतिवान्|दिद्युतिषुः-दिद्योतिषुः|देद्योतः|द्योतितव्यम्|द्योतयितव्यम्|दिद्युतिषितव्यम्-दिद्योतिषितव्यम्|देद्युतितव्यम्|द्योतनीयम्|दिद्युतिषणीयम्-दिद्योतिषणीयम्|देद्युतनीयम्|द्योत्यम्|दिद्युतिष्यम्-दिद्योतिष्यम्|देद्युत्यम्|ईषद्द्योतः-दुर्द्योतः-सुद्योतः|द्युत्यमानः|द्योत्यमानः|दिद्युतिष्यमाणः-दिद्योतिष्यमाणः|प्रद्योतः|दिद्युतिषः-दिद्योतिषः|देद्युतः|द्योतितुम्|द्योतयितुम्|दिद्युतिषितुम्-दिद्योतिषितुम्|देद्युतितुम्|विद्युत्|द्युतिः|द्योतना|दिद्युतिषा-दिद्योतिषा|देद्युता|द्योतनम्|दिद्युतिषणम्-दिद्योतिषणम्|देद्युतनम्|द्युतित्वा-द्योतित्वा|द्योतयित्वा|दिद्युतिषित्वा-दिद्योतिषित्वा|देद्युतित्वा|प्रद्युत्य|प्रद्योत्य|प्रदिद्युतिष्य-प्रदिद्योतिष्य|प्रदेद्युत्य|द्योतम्|दिद्युतिषम्-दिद्योतिषम्|देद्युतम्
<ul><li><sup id="ref_krm_0884_01"><a href="#foot_krm_0884_01">1</a></sup> {@“द्युत दीप्तौ”@} <sup id="ref_krm_0884_02"><a href="#foot_krm_0884_02">2</a></sup> प्रायेणायं विपूर्वकः। </li> <li><sup id="ref_krm_0884_03"><a href="#foot_krm_0884_03">3</a></sup> द्योतकः-तिका, द्योतकः-तिका, <sup id="ref_krm_0884_04"><a href="#foot_krm_0884_04">4</a></sup> दिद्युतिषकः-दिद्योतिषकः-षिका, <sup id="ref_krm_0884_05"><a href="#foot_krm_0884_05">5</a></sup> देद्युतकः-तिका;</li> <li>  द्योतिता-त्री, द्योतयिता-त्री, दिद्युतिषिता-दिद्योतिषिता-त्री, देद्युतिता-त्री;</li> <li>  -- द्योतयन्-न्ती, द्योतयिष्यन्-न्ती-ती;</li> <li>  -- द्योतमानः, <sup id="ref_krm_0884_06"><a href="#foot_krm_0884_06">6</a></sup> द्योतयमानः, दिद्युतिषमाणः-दिद्योतिषमाणः, देद्युत्यमानः;</li> <li>  द्योतिष्यमाणः, द्योतयिष्यमाणः, दिद्युतिषिष्यमाणः-दिद्योतिषिष्यमाणः, देद्युतिष्यमाणः;</li> <li>  <sup id="ref_krm_0884_07"><a href="#foot_krm_0884_07">7</a></sup> दिद्युत्-दिद्युतौ-दिद्युतः;</li> <li>  -- -- <sup id="ref_krm_0884_08"><a href="#foot_krm_0884_08">8</a></sup> द्युतितम्- <sup id="ref_krm_0884_09"><a href="#foot_krm_0884_09">9</a></sup> द्योतितम्-तः, द्योतितः, दिद्युतिषितः-दिद्योतिषितः, देद्युतितः-तवान्;</li> <li>  <sup id="ref_krm_0884_10"><a href="#foot_krm_0884_10">10</a></sup> द्योतः, <sup id="ref_krm_0884_11"><a href="#foot_krm_0884_11">11</a></sup> खद्योतः, <sup id="ref_krm_0884_12"><a href="#foot_krm_0884_12">12</a></sup> प्रद्योतनः, <sup id="ref_krm_0884_13"><a href="#foot_krm_0884_13">13</a></sup> <sup id="ref_krm_0884_14"><a href="#foot_krm_0884_14">14</a></sup> उद्द्योती, <sup id="ref_krm_0884_15"><a href="#foot_krm_0884_15">15</a></sup> विदिद्युतिवान्, द्योतः, दिद्युतिषुः- <sup id="ref_krm_0884_16"><a href="#foot_krm_0884_16">16</a></sup> दिद्योतिषुः, देद्योतः;</li> <li>  <sup id="ref_krm_0884_17"><a href="#foot_krm_0884_17">17</a></sup> द्योतितव्यम्, द्योतयितव्यम्, दिद्युतिषितव्यम्-दिद्योतिषितव्यम्, देद्युतितव्यम्;</li> <li>  द्योतनीयम्, द्योतनीयम्, दिद्युतिषणीयम्-दिद्योतिषणीयम्, देद्युतनीयम्;</li> <li>  द्योत्यम्, द्योत्यम्, दिद्युतिष्यम्-दिद्योतिष्यम्, देद्युत्यम्;</li> <li>  ईषद्द्योतः-दुर्द्योतः-सुद्योतः;</li> <li>  -- -- द्युत्यमानः, द्योत्यमानः, दिद्युतिष्यमाणः-दिद्योतिष्यमाणः, देद्युत्यमानः;</li> <li>  प्रद्योतः, द्योतः, दिद्युतिषः-दिद्योतिषः, देद्युतः;</li> <li>  द्योतितुम्, द्योतयितुम्, दिद्युतिषितुम्-दिद्योतिषितुम्, देद्युतितुम्;</li> <li>  <sup id="ref_krm_0884_18"><a href="#foot_krm_0884_18">18</a></sup> विद्युत्, <sup id="ref_krm_0884_19"><a href="#foot_krm_0884_19">19</a></sup> द्युतिः, द्योतना, दिद्युतिषा-दिद्योतिषा, देद्युता;</li> <li>  द्योतनम्, द्योतनम्, दिद्युतिषणम्-दिद्योतिषणम्, देद्युतनम्;</li> <li>  <sup id="ref_krm_0884_20"><a href="#foot_krm_0884_20">20</a></sup> द्युतित्वा-द्योतित्वा, द्योतयित्वा, दिद्युतिषित्वा-दिद्योतिषित्वा, देद्युतित्वा;</li> <li>  प्रद्युत्य, प्रद्योत्य, प्रदिद्युतिष्य-प्रदिद्योतिष्य, प्रदेद्युत्य;</li> <li>  द्योतम् २, द्युतित्वा २ -द्योतित्वा २, द्योतम् २, द्योतयित्वा २, दिद्युतिषम् २ -दिद्योतिषम् २, दिद्युतिषित्वा २ -दिद्योतिषित्वा २, देद्युतम् २;</li> <li>  देद्युतित्वा २;</li> <li>  <sup id="ref_krm_0884_21"><a href="#foot_krm_0884_21">21</a></sup> इतीसिन्प्रत्यये, आदेश्च जकारादेशः। </li> <li>ज्योतिः = ग्रहनक्षत्रादिः। </li> <li>केचित्तु “अमरटीकायाम्, क्षीरस्वामिना “ज्योतते ज्योतिः।” इत्युक्तम्। </li> <li>वस्तुतस्तु द्युतिरिव ज्युतिरपि स्वतन्त्रो धातुः। </li> <li>तस्य कात्यायनश्रौतसूत्रे ‘तृणेनावज्योत्यासिच्यापः पुनरवज्योत्य निधायं त्रिरुद्वासयत्युदक्।’ <sup id="ref_krm_0884_22"><a href="#foot_krm_0884_22">22</a></sup> इति ल्यबन्तः प्रयोगोऽप्युपलभ्यते।” इत्याहुः। </li> <li>‘अवज्योतनम् दृष्टार्थम्’ इति कर्कभाष्येऽपि ल्युडन्तः प्रयोगोऽ- प्युपलभ्यते।]] ज्योतिः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0884_01"><a href="#ref_krm_0884_01">↑</a> (८७४)</li> <li id="foot_krm_0884_02"><a href="#ref_krm_0884_02">↑</a> (१-भ्वादिः-७४१। अक। सेट्। आत्म।)</li> <li id="foot_krm_0884_03"><a href="#ref_krm_0884_03">↑</a> [पृष्ठम्०७७४+ २७]</li> <li id="foot_krm_0884_04"><a href="#ref_krm_0884_04">↑</a> [[१। सन्नन्ताण्ण्वुलि, ‘रलो व्युपधाद्धलादेः संश्च’ (१-२-२६) इति सेटः सनः क्त्वायाश्च कित्त्वविकल्पनात्, कित्त्वपक्षे गुणप्रतिषेधः, कित्त्वाभावपक्षे गुण इति रूपद्वयम्। ‘द्युतिस्वाप्योः सम्प्रसारणम्’ (७-४-६७) इति अभ्यासे हलादिशेषं बाधित्वा यकारस्य सम्प्रसारणम् इकारः। सन्नन्ते सर्वत्रैषा प्रक्रिया ज्ञेया। क्त्वायामप्येवमेव कित्त्वविकल्पः।]]</li> <li id="foot_krm_0884_05"><a href="#ref_krm_0884_05">↑</a> [[२। यङन्तात् ण्वुलि, ‘द्युतिस्वाप्योः--’ (७-४-६७) इति प्रथमं हलादिशेषं बाधित्वा सम्प्रसारणे, अनन्तरम्, ‘गुणो यङ्लुकोः’ (७-४-८२) इति गुणः। एवं यङन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0884_06"><a href="#ref_krm_0884_06">↑</a> [[आ। ‘दिशो द्योतयमानाभिः दिव्यनारीभिराकुलम्।’ भ। का। ८। ४६।]]</li> <li id="foot_krm_0884_07"><a href="#ref_krm_0884_07">↑</a> [[३। कर्तरि, क्विपि, ‘द्युतिगमिजुहोतीनां द्वे च’ (वा। ३-२-१७८) इति द्वित्वे, अभ्यासे सम्प्रसारणे, रूपमेवम्।]]</li> <li id="foot_krm_0884_08"><a href="#ref_krm_0884_08">↑</a> [[४। ‘उदुपधाद्भावादिकर्मणोरन्यतरस्याम्’ (१-२-२१) इति निष्ठायाः कित्त्वविकल्पः। एतच्च भावे आदिकर्मणि च या निष्ठा, तत्रैवेति। तेन रूपद्वयम्।]]</li> <li id="foot_krm_0884_09"><a href="#ref_krm_0884_09">↑</a> [[B। ‘श्रिया समग्रं द्युतितं मदेनेव प्रलोठितम्।।’ भ। का। ७। १०४।]]</li> <li id="foot_krm_0884_10"><a href="#ref_krm_0884_10">↑</a> [[५। इगुपधलक्षणं कप्रत्ययं बाधित्वा पचादिषु (३-१-१३४) पाठात् कर्तर्यच्प्रत्ययः।]]</li> <li id="foot_krm_0884_11"><a href="#ref_krm_0884_11">↑</a> [[६। खं द्योतयतीति खद्योतः = क्रिमिविशेषः। अन्तर्भावितण्यन्तादस्मात् ‘कर्म- ण्यण्’ (३-२-१) इत्यण्प्रत्यये रूपम्।]]</li> <li id="foot_krm_0884_12"><a href="#ref_krm_0884_12">↑</a> [[७। तच्छीलादिषु कर्तृषु ‘अनुदात्तेतश्च हलादेः’ (३-२-१४९) इति युच्।]]</li> <li id="foot_krm_0884_13"><a href="#ref_krm_0884_13">↑</a> [[C। ‘प्रद्योतनस्योदयमाप्य गोपाः श्वेतांशुक्रोन्मेदुरचारुवेषाः।’ धा। का। २। १।]]</li> <li id="foot_krm_0884_14"><a href="#ref_krm_0884_14">↑</a> [[८। ‘सुप्यजातौ--’ (३-२-७८) इति ताच्छील्ये णिनिः।]]</li> <li id="foot_krm_0884_15"><a href="#ref_krm_0884_15">↑</a> [[९। लिटः क्वसौ, ‘वस्वेकाजाद्धसाम्’ (७-२-६७) इतीडागमे अभ्यासे सम्प्रसारणे च रूपम्।]]</li> <li id="foot_krm_0884_16"><a href="#ref_krm_0884_16">↑</a> [[ड्। ‘मेरोर्जेतुमिवाभोगमुच्चैर्दिद्योतिषुं मुहुः।।’ भ। का। ७। १०७।]]</li> <li id="foot_krm_0884_17"><a href="#ref_krm_0884_17">↑</a> [पृष्ठम्०७७५+ २५]</li> <li id="foot_krm_0884_18"><a href="#ref_krm_0884_18">↑</a> [[१। स्त्रियाम्, भावादौ, ‘सम्पदादिभ्यः--’ (वा। ३-३-९४) इति क्विप्। क्तिनोऽ- पवादः।]]</li> <li id="foot_krm_0884_19"><a href="#ref_krm_0884_19">↑</a> [[२। ‘इक् कृष्यादिभ्यः’ (वा। ३-३-१०८) इति इक्प्रत्ययः।]]</li> <li id="foot_krm_0884_20"><a href="#ref_krm_0884_20">↑</a> [[आ। ‘द्युतित्वा शशिना नक्तं रश्मिभिः परिवर्धितम्।’ भ। का। ७। १०७।]]</li> <li id="foot_krm_0884_21"><a href="#ref_krm_0884_21">↑</a> [[३। ‘द्युतेरिसिन् आदेश्च जः’ [द। उ। ९-३२]</li> <li id="foot_krm_0884_22"><a href="#ref_krm_0884_22">↑</a> (४-१४-५)</li></ul></p>

द्यै|द्यायकः-यिका|द्यापकः-पिका|दिद्यासकः-सिका|दाद्यायकः-यिका
<ul><li><sup id="ref_krm_0885_01"><a href="#foot_krm_0885_01">1</a></sup> {@“द्यै न्यक्करणे”@} <sup id="ref_krm_0885_02"><a href="#foot_krm_0885_02">2</a></sup> ‘न्यङ्गविधाने’ इति क्षीरस्वामी। </li> <li>न्यङ्गम् = कुत्सिताङ्गम्। </li> <li>द्यायकः-यिका, द्यापकः-पिका, दिद्यासकः-सिका, दाद्यायकः-यिका;</li> <li>  <sup id="ref_krm_0885_03"><a href="#foot_krm_0885_03">3</a></sup> इत्यादीनि सर्वाण्यपि रूपाणि भौवादिवकायतिवत् <sup id="ref_krm_0885_04"><a href="#foot_krm_0885_04">4</a></sup> ज्ञेयानि। </li> <li>निष्ठायाम्- <sup id="ref_krm_0885_05"><a href="#foot_krm_0885_05">5</a></sup> द्यानम् <sup id="ref_krm_0885_06"><a href="#foot_krm_0885_06">6</a></sup> -द्यानः-द्यानवान् इति रूपाणीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0885_01"><a href="#ref_krm_0885_01">↑</a> (८७५)</li> <li id="foot_krm_0885_02"><a href="#ref_krm_0885_02">↑</a> (१-भ्वादिः-९०५। सक। अनि- पर।)</li> <li id="foot_krm_0885_03"><a href="#ref_krm_0885_03">↑</a> [पृष्ठम्०७७६+ २५]</li> <li id="foot_krm_0885_04"><a href="#ref_krm_0885_04">↑</a> (२६३)</li> <li id="foot_krm_0885_05"><a href="#ref_krm_0885_05">↑</a> [[१। ‘संयोगादेरातो धातोर्यण्वतः’ (८-२-४३) इति निष्ठानत्वम्।]]</li> <li id="foot_krm_0885_06"><a href="#ref_krm_0885_06">↑</a> [[आ। ‘धयन् दृशा ग्लानरुचिं स कृष्णं म्लानिं त्यजन् द्यानमले जलान्ते।’ धा। का। २। ३०।]]</li></ul></p>

द्रम|द्रमकः-मिका|दिद्रमिषकः-षिका|दंद्रमिषकः-दन्द्रमकः-मिका|द्रमिता-त्री|द्रमयिता-त्री|दिद्रमिषिता-त्री|दन्द्रमिता-त्री|द्रमन्-न्ती|द्रमयन्-न्ती|दिद्रमिषन्-न्ती
<ul><li><sup id="ref_krm_0886_01"><a href="#foot_krm_0886_01">1</a></sup> {@“द्रम गतौ”@} <sup id="ref_krm_0886_02"><a href="#foot_krm_0886_02">2</a></sup> द्रमकः-मिका, द्रमकः-मिका, दिद्रमिषकः-षिका, <sup id="ref_krm_0886_03"><a href="#foot_krm_0886_03">3</a></sup> दंद्रमिषकः-दन्द्रमकः-मिका;</li> <li>  द्रमिता-त्री, द्रमयिता-त्री, दिद्रमिषिता-त्री, दन्द्रमिता-त्री;</li> <li>  <sup id="ref_krm_0886_04"><a href="#foot_krm_0886_04">4</a></sup> द्रमन्-न्ती, द्रमयन्-न्ती, दिद्रमिषन्-न्ती;</li> <li>  -- इत्यादीनि सर्वाण्यपि रूपाणि दैवादिकक्लाम्यतिवत् <sup id="ref_krm_0886_05"><a href="#foot_krm_0886_05">5</a></sup> ज्ञेयानि। </li> <li>द्रमितम्, द्रमित्वा, इति निष्ठायाम्, क्त्वायां चास्य रूपे इति विशेषः। </li> <li><sup id="ref_krm_0886_06"><a href="#foot_krm_0886_06">6</a></sup> दन्द्रमणः, <sup id="ref_krm_0886_07"><a href="#foot_krm_0886_07">7</a></sup> <sup id="ref_krm_0886_08"><a href="#foot_krm_0886_08">8</a></sup> इति डप्रत्यये, ‘आर्धधातुकस्येड्वलादेः’ <sup id="ref_krm_0886_09"><a href="#foot_krm_0886_09">9</a></sup> इतीडागमः। </li> <li>‘नेड् वशि कृति’ <sup id="ref_krm_0886_10"><a href="#foot_krm_0886_10">10</a></sup> इतीण्निषेधस्तु बाहुलकादत्र न प्रवर्तते।]] द्रमिडः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0886_01"><a href="#ref_krm_0886_01">↑</a> (८७६)</li> <li id="foot_krm_0886_02"><a href="#ref_krm_0886_02">↑</a> (१-भ्वादिः-४६६। सक। सेट्। पर।)</li> <li id="foot_krm_0886_03"><a href="#ref_krm_0886_03">↑</a> [[२। ‘नित्यं कौटिल्ये गतौ’ (३-१-२३) इति गत्यर्थकादस्माद् यङ्। अभ्यासे, ‘नुगतोऽनुनासिकान्तस्य’ (७-४-८५) इति नुगागमः। ‘स च पदान्तवद् वाच्यः’ (वा। ७-४-८५) इति नुगागमस्य पदान्तवद्धावेन ‘वा पदान्तस्य’ (८-४-५९) इति परसवर्णविकल्पः। तेनात्र यङन्तेषु सर्वत्र रूपद्वयं ज्ञेयम्।]]</li> <li id="foot_krm_0886_04"><a href="#ref_krm_0886_04">↑</a> [[B। ‘वनाद् वनं सानुममन् द्रमन् गृहं व्याधोत्करोऽहम्मतिमीमिताशयः।’ धा। का। १। ६०।]]</li> <li id="foot_krm_0886_05"><a href="#ref_krm_0886_05">↑</a> (२८३)</li> <li id="foot_krm_0886_06"><a href="#ref_krm_0886_06">↑</a> [[३। तच्छीलादिषु कर्तृषु, ‘जुचङ्क्रम्यदन्द्रम्य--’ (३-२-१५०) इत्यादिना यङन्तात् युचि अनादेशे, णत्वे च रूपमेवम्।]]</li> <li id="foot_krm_0886_07"><a href="#ref_krm_0886_07">↑</a> [[C। ‘पश्य दन्द्रमणान् हंसान् अरविन्दसमुत्सुकान्।।’ भ। का। ७। १५।]]</li> <li id="foot_krm_0886_08"><a href="#ref_krm_0886_08">↑</a> [[४। ‘ञमन्ताड्डः’ [द। उ। ५-७]</li> <li id="foot_krm_0886_09"><a href="#ref_krm_0886_09">↑</a> (७-२-३५)</li> <li id="foot_krm_0886_10"><a href="#ref_krm_0886_10">↑</a> (७-२-८)</li></ul></p>

द्रा|द्रायकः-यिका|द्रापकः-पिका|दिद्रासकः-सिका|दाद्रायकः-यिका
<ul><li><sup id="ref_krm_0887_01"><a href="#foot_krm_0887_01">1</a></sup> {@“द्रा कुत्सायां गतौ”@} <sup id="ref_krm_0887_02"><a href="#foot_krm_0887_02">2</a></sup> कुत्सितगतिः = पलायनम्, निन्द्रा च। </li> <li>स्वापे निपूर्वकोऽयम्। </li> <li>‘द्रै स्वप्ने द्रायति द्राति कुत्सिते गमने लुकि।।’ <sup id="ref_krm_0887_03"><a href="#foot_krm_0887_03">3</a></sup> इति देवः। </li> <li>द्रायकः-यिका, द्रापकः-पिका, दिद्रासकः-सिका, दाद्रायकः-यिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि आदादिकदातिवत् <sup id="ref_krm_0887_04"><a href="#foot_krm_0887_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0887_05"><a href="#foot_krm_0887_05">5</a></sup> <sup id="ref_krm_0887_06"><a href="#foot_krm_0887_06">6</a></sup> निद्रालुः <sup id="ref_krm_0887_07"><a href="#foot_krm_0887_07">7</a></sup> -तन्द्रालुः <sup id="ref_krm_0887_08"><a href="#foot_krm_0887_08">8</a></sup>, <sup id="ref_krm_0887_09"><a href="#foot_krm_0887_09">9</a></sup> तन्द्रा, <sup id="ref_krm_0887_10"><a href="#foot_krm_0887_10">10</a></sup> द्राणम्-द्राणः-द्राणवान्, <sup id="ref_krm_0887_11"><a href="#foot_krm_0887_11">11</a></sup> प्रणिद्राता, इत्यादीन्यस्य रूपाणि यथायथं भवन्तीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0887_01"><a href="#ref_krm_0887_01">↑</a> (८७७)</li> <li id="foot_krm_0887_02"><a href="#ref_krm_0887_02">↑</a> (२-अदादिः-१०५४। अक। अनि। पर।)</li> <li id="foot_krm_0887_03"><a href="#ref_krm_0887_03">↑</a> (श्लो। ६)</li> <li id="foot_krm_0887_04"><a href="#ref_krm_0887_04">↑</a> (८३३)</li> <li id="foot_krm_0887_05"><a href="#ref_krm_0887_05">↑</a> [पृष्ठम्०७७७+ २८]</li> <li id="foot_krm_0887_06"><a href="#ref_krm_0887_06">↑</a> [[१। तच्छीलादिषु कर्तृषु, ‘स्पृहिगृहिपतिदयिनिद्रातन्द्राश्रद्धाभ्य आलुच्’ (३-२-१५८) इत्यनेन निपूर्वकात् तत्पूर्वकाच्चास्मात् आलुच्प्रत्ययः। तदो दकारस्य प्रत्ययसन्नियोगेन नकारादेशोऽपि सूत्रकारनिर्देशाद् भवति।]]</li> <li id="foot_krm_0887_07"><a href="#ref_krm_0887_07">↑</a> [[आ। ‘स्पृहयालुं कपिं स्त्रीभ्यो निद्रालुमदयालुवत्।’ भ। का। ७। २१।]]</li> <li id="foot_krm_0887_08"><a href="#ref_krm_0887_08">↑</a> [[B। ‘तं पश्यन् नकुलं राजा तन्द्रालुर्दृङ्निमेषणे।’ च। भा। ६। १५।]]</li> <li id="foot_krm_0887_09"><a href="#ref_krm_0887_09">↑</a> [[२। ‘घञर्थे कविधानम्’ (वा। ३-३-५८) इति कप्रत्यये, ‘स्पृहिगृहिपतिदयिनिद्रा- तन्द्रा--’ (३-२-१५८) इति सूत्रे निर्देशबलात् तदो दकारस्य नकारे, अदन्त- त्वेन टापि रूपमेवम्।]]</li> <li id="foot_krm_0887_10"><a href="#ref_krm_0887_10">↑</a> [[३। ‘संयोगादेरातो धातोर्यण्वतः’ (८-२-४३) इति निष्ठानत्वे णत्वे च रूपम्।]]</li> <li id="foot_krm_0887_11"><a href="#ref_krm_0887_11">↑</a> [[४। तृचि, प्रपूर्वकात् नेः, ‘नेगदनदपतपदघुमास्यतिहन्तियातिवातिद्राति--’ (८-४-१७) इति णत्वम्।]]</li></ul></p>

द्राक्षि|व्याख्यानेद्राङ्क्षकः-क्षिका|द्राङ्क्षकः-क्षिका|दिद्रांक्षिषकः-षिका|दाद्रांक्षकः-क्षिका
<ul><li><sup id="ref_krm_0888_01"><a href="#foot_krm_0888_01">1</a></sup> {@“द्राक्षि घोरवासिते च”@} <sup id="ref_krm_0888_02"><a href="#foot_krm_0888_02">2</a></sup> ‘घोरनिवाशिते’ इति क्षीरस्वामी। </li> <li>चकारात् काङ्क्षायाम् इति धा। </li> <li>का। </li> <li>व्याख्याने <sup id="ref_krm_0888_03"><a href="#foot_krm_0888_03">3</a></sup> द्राङ्क्षकः-क्षिका, द्राङ्क्षकः-क्षिका, दिद्रांक्षिषकः-षिका, दाद्रांक्षकः-क्षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककाङ्क्षतिवत् <sup id="ref_krm_0888_04"><a href="#foot_krm_0888_04">4</a></sup> ज्ञेयानि। </li> <li>क्तिनि <sup id="ref_krm_0888_05"><a href="#foot_krm_0888_05">5</a></sup> द्राक्षा <sup id="ref_krm_0888_06"><a href="#foot_krm_0888_06">6</a></sup> इति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0888_01"><a href="#ref_krm_0888_01">↑</a> (८७८)</li> <li id="foot_krm_0888_02"><a href="#ref_krm_0888_02">↑</a> (१-भ्वादिः-६७०। अक। सेट्। पर।)</li> <li id="foot_krm_0888_03"><a href="#ref_krm_0888_03">↑</a> (१-८५)</li> <li id="foot_krm_0888_04"><a href="#ref_krm_0888_04">↑</a> (१८३)</li> <li id="foot_krm_0888_05"><a href="#ref_krm_0888_05">↑</a> [[५। यवादौ (८-२-९) द्राक्षा इति निपातनान्नलोपः।]]</li> <li id="foot_krm_0888_06"><a href="#ref_krm_0888_06">↑</a> [[C। ‘द्राक्षां जनो वाञ्छति नो फलानि ध्राङ्क्षद्बहुध्वाङ्क्षविचूषितानि।।’ धा। का। १। ८५।]]</li></ul></p>

द्राखृ|द्राखकः-खिका|दिद्राखिषकः-षिका|दाद्राखकः-खिका|द्राखिता-त्री|द्राखयिता-त्री|दिद्राखिषिता-त्री|दाद्राखिता-त्री|द्राखन्-न्ती|द्राखयन्-न्ती|दिद्राखिषन्-न्ती|-|द्राखिष्यन्-न्ती-ती|द्राखयिष्यन्-न्ती-ती|दिद्राखिषिष्यन्-न्ती-ती|-द्राखयमाणः|द्राखयिष्यमाणः|दाद्राख्यमानः|दाद्राखिष्यमाणः|विद्राख्-विद्राक्-विद्राखौ-विद्राखः|-द्राखितम्-तः|द्राखितः|दिद्राखिषितः|दाद्राखितः-तवान्|द्राखः|दिद्राखिषुः|दाद्राखः|द्राखितव्यम्|द्राखयितव्यम्|दिद्राखिषितव्यम्|दाद्राखितव्यम्|द्राखणीयम्|दिद्राखिषणीयम्|दाद्राखणीयम्|द्राख्यम्|दिद्राखिष्यम्|दाद्राख्यम्|ईषद्द्राखः-दुर्द्राखः-सुद्राखः|द्राख्यमाणः|दिद्राखिष्यमाणः|दाद्राख्यमाणः|दिद्राखिषः|द्राखितुम्|द्राखयितुम्|दिद्राखिषितुम्|दाद्राखितुम्|द्राखा|द्राखणा|दिद्राखिषा|दाद्राखा|द्राखणम्|दिद्राखिषणम्|दाद्राखणम्|द्राखित्वा|द्राखयित्वा|दिद्राखिषित्वा|दाद्राखित्वा|प्रद्राख्य|प्रदिद्राखिष्य|प्रदाद्राख्य|द्राखम्|दिद्राखिषम्|दाद्राखम्
<ul><li><sup id="ref_krm_0889_01"><a href="#foot_krm_0889_01">1</a></sup> {@“द्राखृ शोषणामलमर्थयोः”@} <sup id="ref_krm_0889_02"><a href="#foot_krm_0889_02">2</a></sup> द्राखकः-खिका, द्राखकः-खिका, दिद्राखिषकः-षिका, दाद्राखकः-खिका;</li> <li>  द्राखिता-त्री, द्राखयिता-त्री, दिद्राखिषिता-त्री, दाद्राखिता-त्री;</li> <li>  द्राखन्-न्ती, द्राखयन्-न्ती, दिद्राखिषन्-न्ती;</li> <li>  -- द्राखिष्यन्-न्ती-ती, द्राखयिष्यन्-न्ती-ती, दिद्राखिषिष्यन्-न्ती-ती;</li> <li>  -- --द्राखयमाणः, द्राखयिष्यमाणः, -- दाद्राख्यमानः, दाद्राखिष्यमाणः;</li> <li>  विद्राख्-विद्राक्-विद्राखौ-विद्राखः;</li> <li>  -- <sup id="ref_krm_0889_03"><a href="#foot_krm_0889_03">3</a></sup> <sup id="ref_krm_0889_04"><a href="#foot_krm_0889_04">4</a></sup> द्राखितम्-तः, द्राखितः, दिद्राखिषितः, दाद्राखितः-तवान्;</li> <li>  द्राखः, द्राखः, दिद्राखिषुः, दाद्राखः;</li> <li>  द्राखितव्यम्, द्राखयितव्यम्, दिद्राखिषितव्यम्, दाद्राखितव्यम्;</li> <li>  <sup id="ref_krm_0889_05"><a href="#foot_krm_0889_05">5</a></sup> द्राखणीयम्, द्राखणीयम्, दिद्राखिषणीयम्, दाद्राखणीयम्;</li> <li>  द्राख्यम्, द्राख्यम्, दिद्राखिष्यम्, दाद्राख्यम्;</li> <li>  ईषद्द्राखः-दुर्द्राखः-सुद्राखः;</li> <li>  -- -- द्राख्यमाणः, द्राख्यमाणः, दिद्राखिष्यमाणः, दाद्राख्यमाणः, द्राखः, द्राखः, दिद्राखिषः, दाद्राखः;</li> <li>  द्राखितुम्, द्राखयितुम्, दिद्राखिषितुम्, दाद्राखितुम्;</li> <li>  <sup id="ref_krm_0889_06"><a href="#foot_krm_0889_06">6</a></sup> द्राखा, द्राखणा, दिद्राखिषा, दाद्राखा;</li> <li>  द्राखणम्, द्राखणम्, दिद्राखिषणम्, दाद्राखणम्;</li> <li>  द्राखित्वा, द्राखयित्वा, दिद्राखिषित्वा, दाद्राखित्वा;</li> <li>  प्रद्राख्य, प्रद्राख्य, प्रदिद्राखिष्य, प्रदाद्राख्य;</li> <li>  द्राखम् २, द्राखित्वा २, द्राखम् २, द्राखयित्वा २, दिद्राखिषम् २, दिद्राखिषित्वा २, दाद्राखम् २;</li> <li>  दाद्राखित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0889_01"><a href="#ref_krm_0889_01">↑</a> (८७९)</li> <li id="foot_krm_0889_02"><a href="#ref_krm_0889_02">↑</a> (१-भ्वादिः-१२४। सक। सेट्। पर।)</li> <li id="foot_krm_0889_03"><a href="#ref_krm_0889_03">↑</a> [पृष्ठम्०७७८+ २३]</li> <li id="foot_krm_0889_04"><a href="#ref_krm_0889_04">↑</a> [[आ। ‘अराखितत्वग्भिरलाखितच्छदैः प्रद्राखिताध्राखिफलैश्च शाखिभिः।’ धा। का। १। १८।]]</li> <li id="foot_krm_0889_05"><a href="#ref_krm_0889_05">↑</a> [[१। ‘अट्कुप्वाङ्नुम्व्यवायेऽपि’ (८-४-२) इति णत्वम्। एवं ल्युडादिष्वपि ज्ञेयम्।]]</li> <li id="foot_krm_0889_06"><a href="#ref_krm_0889_06">↑</a> [[२। ‘गुरोश्च हलः’ (३-३-१०३) इत्यकारप्रत्ययः।]]</li></ul></p>

द्राघृ|द्राघघः-घिका|द्राघकः-घिका|दिद्राघिषकः-षिका|दाद्राघकः-घिका|अस्य|घातोरात्मनेपदित्वात्|द्राघमाणः|दिद्राघिषमाणः|द्राघिष्यमाणः|दिद्राघिषिष्यमाणः
<ul><li><sup id="ref_krm_0890_01"><a href="#foot_krm_0890_01">1</a></sup> {@“द्राघृ सामर्थ्ये आयामे च”@} <sup id="ref_krm_0890_02"><a href="#foot_krm_0890_02">2</a></sup> “आयामः = दैर्घ्यक्रियेति कौशिकः। </li> <li>कदर्थनम् इति स्वामी।” इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>‘ध्राघृ’ इत्यपि केचित् पठन्ति। </li> <li>द्राघघः-घिका, द्राघकः-घिका, दिद्राघिषकः-षिका, दाद्राघकः-घिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि पूर्वोक्तद्राखतिवत् <sup id="ref_krm_0890_03"><a href="#foot_krm_0890_03">3</a></sup> ज्ञेयानि। </li> <li>अस्य घातोरात्मनेपदित्वात्, द्राघमाणः, दिद्राघिषमाणः, द्राघिष्यमाणः, दिद्राघिषिष्यमाणः;</li> <li>  इति शानचि विशेषः। </li> <li><sup id="ref_krm_0890_04"><a href="#foot_krm_0890_04">4</a></sup> प्रद्राघितः। </li> <li><sup id="ref_krm_0890_05"><a href="#foot_krm_0890_05">5</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0890_01"><a href="#ref_krm_0890_01">↑</a> (८८०)</li> <li id="foot_krm_0890_02"><a href="#ref_krm_0890_02">↑</a> (१-भ्वादिः-११४। अक। सेट्। आत्म।)</li> <li id="foot_krm_0890_03"><a href="#ref_krm_0890_03">↑</a> (८७९)</li> <li id="foot_krm_0890_04"><a href="#ref_krm_0890_04">↑</a> [[B। ‘निकाममुल्लाघतनोः समत्यगात् प्रद्राघिता श्{??}ध्यगुणस्य बर्तनी।।’ धा। का। १। १६।]]</li> <li id="foot_krm_0890_05"><a href="#ref_krm_0890_05">↑</a> [पृष्ठम्०७७९+ २६]</li></ul></p>

द्राडृ|द्राडकः-डिका|दिद्राडिषकः-षिका|दाद्राडकः-डिका
<ul><li><sup id="ref_krm_0891_01"><a href="#foot_krm_0891_01">1</a></sup> {@“द्राडृ विशरणे”@} <sup id="ref_krm_0891_02"><a href="#foot_krm_0891_02">2</a></sup> द्राडकः-डिका, द्राडकः-डिका, दिद्राडिषकः-षिका, दाद्राडकः-डिका;</li> <li>  इत्यादीनि सर्वाणि रूपाणि द्राखतिवत् <sup id="ref_krm_0891_03"><a href="#foot_krm_0891_03">3</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_0891_04"><a href="#foot_krm_0891_04">4</a></sup> विद्राली <sup id="ref_krm_0891_05"><a href="#foot_krm_0891_05">5</a></sup> इति णिनिप्रत्यये रूपमिति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0891_01"><a href="#ref_krm_0891_01">↑</a> (८८१)</li> <li id="foot_krm_0891_02"><a href="#ref_krm_0891_02">↑</a> (१-भ्वादिः। २८७। अक। सेट्। आत्म।)</li> <li id="foot_krm_0891_03"><a href="#ref_krm_0891_03">↑</a> (८७९)</li> <li id="foot_krm_0891_04"><a href="#ref_krm_0891_04">↑</a> [[१। ‘सुप्यजातौ--’ (३-२-७८) इति णिनिः। ‘डलयोरुक्तिभेदस्तु डकारो नाक्षरान्तरम्।’ इत्युक्त्या डस्य लः। अत एव विद्राली इति रूपम्।]]</li> <li id="foot_krm_0891_05"><a href="#ref_krm_0891_05">↑</a> [[आ। ‘सुपाकविद्रालिफलालिभिर्द्रुमैः स्निग्धानविध्राडितचारुशालिकान्।।’ धा। का। १। ३८।]]</li></ul></p>

