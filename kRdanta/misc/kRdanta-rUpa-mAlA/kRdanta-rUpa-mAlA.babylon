<ul><li><sup id="ref_krm_1170_01"><a href="#foot_krm_1170_01">1</a></sup> {@“भिदिर् विदारणे”@} <sup id="ref_krm_1170_02"><a href="#foot_krm_1170_02">2</a></sup> भेदकह्-दिका, भेदकः-दिका, <sup id="ref_krm_1170_03"><a href="#foot_krm_1170_03">3</a></sup> बिभित्सकः-त्सिका, <sup id="ref_krm_1170_04"><a href="#foot_krm_1170_04">4</a></sup> बेभिदकः-दिका;</li> <li>  भेत्ता-भेत्री, भेदयिता-त्री, बिभित्सिता-त्री, बेभिदिता- <sup id="ref_krm_1170_05"><a href="#foot_krm_1170_05">5</a></sup> त्री;</li> <li>  <sup id="ref_krm_1170_06"><a href="#foot_krm_1170_06">6</a></sup> भिन्दन्- <sup id="ref_krm_1170_07"><a href="#foot_krm_1170_07">7</a></sup> ती, भेदयन्-न्ती, बिभित्सन्-न्ती;</li> <li>  -- भेत्स्यन्-न्ती, भेदयिष्यन्-न्ती-ती, बिभित्सिष्यन्-न्ती-ती;</li> <li>  -- भिन्दानः, भेदयमानः, बिभित्समानः, बेभिद्यमानः;</li> <li>  भेत्स्यमानः, भेदयिष्यमाणः, बिभित्सिष्यमाणः, बेभिदिष्यमाणः;</li> <li>  <sup id="ref_krm_1170_08"><a href="#foot_krm_1170_08">8</a></sup> गोत्रभिद्, काष्ठभिद्, उद्भित्, प्रभित्-प्रभिदौ-प्रभिदः;</li> <li>  <sup id="ref_krm_1170_09"><a href="#foot_krm_1170_09">9</a></sup> भित्तम् <sup id="ref_krm_1170_10"><a href="#foot_krm_1170_10">10</a></sup>, भित्तः, <sup id="ref_krm_1170_11"><a href="#foot_krm_1170_11">11</a></sup> भिन्नम्-भिन्नवान्, भेदितम्-तः, बिभित्सितः, बेभिदितः-तवान्;</li> <li>  <sup id="ref_krm_1170_12"><a href="#foot_krm_1170_12">12</a></sup> <sup id="ref_krm_1170_13"><a href="#foot_krm_1170_13">13</a></sup> उद्भिदः, <sup id="ref_krm_1170_14"><a href="#foot_krm_1170_14">14</a></sup> भिदेलिमाः, <sup id="ref_krm_1170_15"><a href="#foot_krm_1170_15">15</a></sup> भिदुरम्, <sup id="ref_krm_1170_16"><a href="#foot_krm_1170_16">16</a></sup> <sup id="ref_krm_1170_17"><a href="#foot_krm_1170_17">17</a></sup> भिद्यः <sup id="ref_krm_1170_18"><a href="#foot_krm_1170_18">18</a></sup> <sup id="ref_krm_1170_19"><a href="#foot_krm_1170_19">19</a></sup>, <sup id="ref_krm_1170_20"><a href="#foot_krm_1170_20">20</a></sup> कर्णभेदी, <sup id="ref_krm_1170_21"><a href="#foot_krm_1170_21">21</a></sup> <sup id="ref_krm_1170_22"><a href="#foot_krm_1170_22">22</a></sup> काष्ठभेदः, <sup id="ref_krm_1170_23"><a href="#foot_krm_1170_23">23</a></sup> बिभिद्वान्, <sup id="ref_krm_1170_24"><a href="#foot_krm_1170_24">24</a></sup> भेदनः-भेदः, बिभित्सुः, बेभिदः;</li> <li>  भेत्तव्यम्, भेदयितव्यम्, बिभित्सितव्यम्, बेभिदितव्यम्;</li> <li>  भेदनीयम्, भेदनीयम्, बिभित्सनीयम्, बेभिदनीयम्;</li> <li>  भेद्यम्, भेद्यम्, बिभित्स्यम्, बेभिद्यम्;</li> <li>  भिद्यमानः, भेद्यमानः, बिभित्स्यमानः, बेभिद्यमानः;</li> <li>  ईषद्भेदः-दुर्भेदः-सुभेदः;</li> <li>  -- -- भेदः, उद्भेदः, भेदः, बिभित्सः, बेभिदः;</li> <li>  भेत्तुम्, भेदयितुम्, बिभित्सितुम्, बेभिदितुम्;</li> <li>  <sup id="ref_krm_1170_25"><a href="#foot_krm_1170_25">25</a></sup> <sup id="ref_krm_1170_26"><a href="#foot_krm_1170_26">26</a></sup> भिदा, भित्तिः-भिदिः, भेदना, बिभित्सा, बेभिदा;</li> <li>  भेदनम्, भेदनम्, बिभित्सनम्, बेभिदनम्;</li> <li>  भित्त्वा, भेदयित्वा, बिभित्सित्वा, बेभिदित्वा;</li> <li>  संभिद्य, संभेद्य, प्रबिभित्स्य, प्रबेभिद्य, <sup id="ref_krm_1170_27"><a href="#foot_krm_1170_27">27</a></sup> प्रबेभिदय्य गतः;</li> <li>  भेदम् २, भित्त्वा २, भेदम् २, भेदयित्वा २, बिभित्सम् २, बिभित्सित्वा २, बेभिदम् २;</li> <li>  बेभिदित्वा २;</li> <li>  <sup id="ref_krm_1170_28"><a href="#foot_krm_1170_28">28</a></sup> भिदुः, <sup id="ref_krm_1170_29"><a href="#foot_krm_1170_29">29</a></sup> भिदिरम्, <sup id="ref_krm_1170_30"><a href="#foot_krm_1170_30">30</a></sup> भिद्रः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1170_01"><a href="#ref_krm_1170_01">↑</a> (११६०)</li> <li id="foot_krm_1170_02"><a href="#ref_krm_1170_02">↑</a> (७-रुधादिः-१४३९। सक। अनि। उभ।)</li> <li id="foot_krm_1170_03"><a href="#ref_krm_1170_03">↑</a> [[१। सन्नन्ताण्ण्वुलि, ‘हलन्ताच्च’ (१-२-१०) इति सनः कित्त्वे, द्विर्वचनादिषु कृतेषु धातुदकारस्य चर्त्वेन तकारः। एवमुत्तरत्रापि प्रक्रिया ज्ञेया।]]</li> <li id="foot_krm_1170_04"><a href="#ref_krm_1170_04">↑</a> [[२। यङन्ते द्विर्वचनादिकेषु कृतेषु, ‘गुणो यङ्लुकोः’ (७-४-८२) इत्यभ्यासे गुणः सर्वत्र बोध्यः।]]</li> <li id="foot_krm_1170_05"><a href="#ref_krm_1170_05">↑</a> [[B। ‘आत्तायुधाहितजनैः सह संयतित्री शत्रोर्मनोरथशतान्यथ बेभिदित्री।’ वा। वि। ३। ५१।]]</li> <li id="foot_krm_1170_06"><a href="#ref_krm_1170_06">↑</a> [[३। शतरि, ‘रुधादिभ्यः--’ (३-१-७८) इति श्नम् विकरणप्रत्ययः। स च अन्त्यादचः परो भवति। ‘श्नसोरल्लोपः’ (६-४-१११) इति श्नमोऽकारस्य लोपः। एवमेव शानजन्तेऽपि प्रक्रिया ज्ञेया।]]</li> <li id="foot_krm_1170_07"><a href="#ref_krm_1170_07">↑</a> [[C। ‘निहतश्च स्थितिं भिन्दन् दानवोऽसौ बलद्विषा।’ भ। का। ७। ६८।]]</li> <li id="foot_krm_1170_08"><a href="#ref_krm_1170_08">↑</a> [[४। ‘सत्सूद्विषद्रुहयुजविदभिद--’ (३-२-६१) इत्यादिना कर्मण्युपपदे, उपसर्गे उपपदेऽपि क्विप्प्रत्ययः। गोत्रं भिनत्तीति गोत्रभित् = इन्द्रः। उद्भित् = लतागुल्मादिः।]]</li> <li id="foot_krm_1170_09"><a href="#ref_krm_1170_09">↑</a> [[५। क्तप्रत्यये शकलेऽभिधेये ‘भित्तं शकलम्’ (८-२-५९) इत्यनेन निष्ठानत्वाभावो निपात्यते। भित्तमिति शकलपर्यायो रूढिशब्दः। अत्र भिदिक्रिया शब्दव्युत्पत्ते- र्निमित्तम्। स्पष्टमिदं प्रकृतसूत्रे भाष्यादिषु।]]</li> <li id="foot_krm_1170_10"><a href="#ref_krm_1170_10">↑</a> [शकलम्]</li> <li id="foot_krm_1170_11"><a href="#ref_krm_1170_11">↑</a> [[६। शकलादन्यत्र, ‘रदाभ्यां निष्ठातो नः, पूर्वस्य च दः’ (८-२-४२) इत्यनेन निष्ठात- कार-धातुदकारयोर्नत्वे रूपमेवम्।]]</li> <li id="foot_krm_1170_12"><a href="#ref_krm_1170_12">↑</a> [पृष्ठम्०९५३+ २८]</li> <li id="foot_krm_1170_13"><a href="#ref_krm_1170_13">↑</a> [[१। ‘इगुपध--’ (३-१-१३५) इत्यादिना कर्तरि कप्रत्ययः। कित्त्वान्न गुणः।]]</li> <li id="foot_krm_1170_14"><a href="#ref_krm_1170_14">↑</a> [[२। ‘केलिमर उपसंख्यानम्’ (वा। ३-१-९६) इत्यनेन केलिमर्प्रत्ययः। धातोरस्य सकर्मकत्वादयं कर्मणि सम्पद्यते। वृत्त्यादिषु तु ‘कर्मकर्तरि चायमिष्यते’ (काशिका। ३-१-९६) इत्युक्तम्। ‘भिदेलिमाः सरलाः--भेत्तव्याः।’ इति भाष्ये (३-१-९६) कर्मार्थकेन तव्यप्रत्ययेन विवरणात् कर्मार्थकत्वमेवास्य प्रत्ययस्येति बोध्यम्।]]</li> <li id="foot_krm_1170_15"><a href="#ref_krm_1170_15">↑</a> [[३। ‘विदिभिदिच्छिदेः कुरच्’ (३-२-१६२) इति ताच्छीलिकः कुरच्प्रत्ययः। कर्म- कर्तरि प्रत्ययोऽयमिति वृत्तौ लक्ष्यते। भेदनकर्तुः वज्रायुधस्य ‘भिदुरम्’ इत्य- भिधानात् शुद्धकर्तर्येवायं प्रत्यय इति प्रतिभाति।]]</li> <li id="foot_krm_1170_16"><a href="#ref_krm_1170_16">↑</a> [[आ। ‘अयशो भिदुरालोके कोपधामरणादृते।’ शि। व। १९। ५८।]]</li> <li id="foot_krm_1170_17"><a href="#ref_krm_1170_17">↑</a> [[४। भिनत्ति कूलमित्यर्थे नदेऽभिधेये कर्तरि ‘भिद्योद्ध्यौ नदे’ (३-१-११५) इति क्यप् निपात्यते। भिद्यः = नदः;\n\n  अधुना ‘जम्मू’ राज्ये ‘बई’ इति देशभाषया व्यवह्रियते।]]</li> <li id="foot_krm_1170_18"><a href="#ref_krm_1170_18">↑</a> [[B। ‘तोयदागम इवोद्ध्यभिद्ययोर्नामधेयसदृशं बिचेष्टितम्।।’ रघुवंशे ११। ८।]]</li> <li id="foot_krm_1170_19"><a href="#ref_krm_1170_19">↑</a> [नदः]</li> <li id="foot_krm_1170_20"><a href="#ref_krm_1170_20">↑</a> [[५। कर्ण भिनत्तीति कर्णभेदी = रूक्षध्वनिः, पिशुनश्च। ताच्छील्ये णिनिप्रत्यये रूपमेवम्।]]</li> <li id="foot_krm_1170_21"><a href="#ref_krm_1170_21">↑</a> [[C। ‘तेषां निहन्यमानानां संघुष्टैः कर्णभेदिभिः।’ भ। का। ९। २१।]]</li> <li id="foot_krm_1170_22"><a href="#ref_krm_1170_22">↑</a> [[६। कर्मण्युपपदेऽणि रूपमेवम्। ‘कर्मण्यण्’ (३-२-१) इत्यत्र भाष्ये एवं प्रयुक्तम्।]]</li> <li id="foot_krm_1170_23"><a href="#ref_krm_1170_23">↑</a> [[७। लिटः क्वसौ द्विर्वचनादिकेषु कृतेषु रूपमेवम्। ‘वस्वेकाजाद्घसाम्’ (७-२-६७) इत्यत्र कृतद्विर्वचनस्य एकाच एव ग्रहणादत्र नेडिति ज्ञेयम्।]]</li> <li id="foot_krm_1170_24"><a href="#ref_krm_1170_24">↑</a> [[८। नन्द्यादेराकृतिगणत्वात्, ‘कृत्यल्युटो बहुलम्’ (३-३-११३) इति बहुलग्रहणाद्वा कर्तरि ल्युः ल्युट् वा प्रत्ययः। भेदनः = रोगविशेषः, वराहश्च।]]</li> <li id="foot_krm_1170_25"><a href="#ref_krm_1170_25">↑</a> [पृष्ठम्०९५४+ २७]</li> <li id="foot_krm_1170_26"><a href="#ref_krm_1170_26">↑</a> [[१। स्त्रियाम्, ‘भिदा विदारणे’ (ग। सू। ३-३-१०४) इति भिदादिपाठाद् भावादौ अङ्। अन्यत्र भित्तिः इत्येव। भित्तिः = कुड्यम्। स्वार्थे कन्प्रत्यये भित्तिका इति भवति। ‘इक् कृष्यादिभ्यः’ (वा। ३-३-१०८) इतीक्प्रत्यये भिदिः इत्यपि भवति।]]</li> <li id="foot_krm_1170_27"><a href="#ref_krm_1170_27">↑</a> [[२। यङन्तात् णिचि ल्यपि, ‘ल्यपि लघुपूर्वात्’ (६-४-५६) इति णेरयादेशः। काशि- कायाम् (६-४-५६) उदाहृतोऽयम्।]]</li> <li id="foot_krm_1170_28"><a href="#ref_krm_1170_28">↑</a> [[३। ‘पॄभिदि--’ (द। उ। १-१०८) इति कुप्रत्ययः। भिदुः = वज्रम्।]]</li> <li id="foot_krm_1170_29"><a href="#ref_krm_1170_29">↑</a> [[४। ‘इषिमदिमुदिखिदिच्छिदिभिदि--’ (द। उ। ८-२६) इति किरच्प्रत्यये रूपमेवम्। भिदिरम् = भेदः।]]</li> <li id="foot_krm_1170_30"><a href="#ref_krm_1170_30">↑</a> [[५। औणादिके (द। उ। ८-३१) रक्प्रत्यये रूपमेवम्। भिद्रः = शरः।]]</li></ul></p>

