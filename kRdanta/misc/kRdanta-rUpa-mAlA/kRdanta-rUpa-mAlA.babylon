<ul><li><sup id="ref_krm_0295_01"><a href="#foot_krm_0295_01">1</a></sup> {@“क्लिशू विबाधने”@} <sup id="ref_krm_0295_02"><a href="#foot_krm_0295_02">2</a></sup> <sup id="ref_krm_0295_03"><a href="#foot_krm_0295_03">3</a></sup> ‘एवमाराध्यमानोऽपि क्लिश्नाति भुवनत्रयम्।’ <sup id="ref_krm_0295_04"><a href="#foot_krm_0295_04">4</a></sup> इत्यादि- प्रयोगात् सकर्मकत्वमप्यस्य धातोरिति ज्ञायते।]] ‘व्यक्तोक्तौ क्लेशते क्लेशेः, क्लिश्नाति तु विबाधने। </li> <li>दिवादेरुपतापेऽर्थे तङि स्यात् क्लिश्यते पदम्।।’ <sup id="ref_krm_0295_05"><a href="#foot_krm_0295_05">5</a></sup> इति देवः। </li> <li>क्लेशः-शिका, क्लेशकः-शिका, <sup id="ref_krm_0295_06"><a href="#foot_krm_0295_06">6</a></sup> चिक्लिशिषकः-चिक्लेशिषकः-षिका, <sup id="ref_krm_0295_07"><a href="#foot_krm_0295_07">7</a></sup> चिक्लिक्षकः-क्षिका, चेक्लिशकः-शिका;</li> <li>  क्लेशिता-त्री-क्लेष्टा-ष्ट्री, क्लेशयिता-त्री, चिक्लिशिषिता-चिक्लेशिषिता-त्री, चिक्लिक्षिता-त्री, चेक्लिशिता-त्री;</li> <li>  <sup id="ref_krm_0295_08"><a href="#foot_krm_0295_08">8</a></sup> क्लिश्नन् <sup id="ref_krm_0295_09"><a href="#foot_krm_0295_09">9</a></sup> -ती, क्लेशयन्-न्ती, चिक्लिशिषन्-चिक्लेशिषन्-चिक्लिक्षन्-न्ती;</li> <li>  -- <sup id="ref_krm_0295_10"><a href="#foot_krm_0295_10">10</a></sup> क्लेशिष्यन्-क्लेक्ष्यन्-न्ती-ती, क्लेशयिष्यन्-न्ती-ती, चिक्लिशिषिष्यन्-चिक्लेशिषिष्यन्-चिक्लिक्षिष्यन्-न्ती-ती;</li> <li>  -- -- क्लेशयमानः, क्लेशयिष्यमाणः, चेक्लिश्यमानः, चेक्लिशिष्यमाणः;</li> <li>  <sup id="ref_krm_0295_11"><a href="#foot_krm_0295_11">11</a></sup> क्लिट्-क्लिशौ-क्लिशः, <sup id="ref_krm_0295_12"><a href="#foot_krm_0295_12">12</a></sup> क्लेट्-क्लेशौ-क्लेशः;</li> <li>  -- -- <sup id="ref_krm_0295_13"><a href="#foot_krm_0295_13">13</a></sup> क्लिशितम्-तः- <sup id="ref_krm_0295_14"><a href="#foot_krm_0295_14">14</a></sup> तवान्, क्लिष्टम्-ष्टः-ष्टवान्, क्लेशितः-तम्, चिक्लिशिषितः-चिक्लेशिषितः-चिक्लिक्षितः-तवान्, चेक्लिशितः-तवान्;</li> <li>  क्लिशः, <sup id="ref_krm_0295_15"><a href="#foot_krm_0295_15">15</a></sup> क्लेशकः <sup id="ref_krm_0295_16"><a href="#foot_krm_0295_16">16</a></sup>, क्लेशः, चिक्लिशिषुः-चिक्लेशिषुः-चिक्लिक्षुः, चेक्लिशः;</li> <li>  क्लेशितव्यम्-क्लेष्टव्यम्, क्लेशयितव्यम्, चिक्लिशिषितव्यम्-चिक्लेशिषितव्यम्-चिक्लिक्षितव्यम्, चेक्लिशितव्यम्;</li> <li>  क्लेशनीयम्, क्लेशनीयम्, चिक्लिशिषणीयम्-चिक्लेशिषणीयम्-चिक्लिक्षणीयम्, चेक्लिशनीयम्;</li> <li>  क्लेशयम्, क्लेश्यम्, चिक्लिशिष्यम्-चिक्लेशिष्यम्-चिक्लिक्ष्यम्, चेक्लिश्यम्;</li> <li>  ईषत्कलेशः-दुष्क्लेशः-सुक्लेशः;</li> <li>  -- -- -- क्लिश्यमानः, क्लेश्यमानः, चिक्लिशिष्यमाणः-चिक्लेशिष्यमाणः-चिक्लिक्ष्यमाणः, चेक्लिश्यमानः;</li> <li>  क्लेशः, क्लेशः, चिक्लिशिषः-चिक्लेशिषः-चिक्लिक्षः, चेक्लिशः;</li> <li>  क्लेशितुम्-क्लेष्टुम्, क्लेशयितुम्, चिक्लिशिषितुम्-चिक्लेशिषितुम्-चिक्लिक्षितुम्, चेक्लिशितुम्;</li> <li>  क्लिष्टिः, क्लेशना, चिक्लिशिषा-चिक्लेशिषा-चिक्लिक्षा, चेक्लिशा;</li> <li>  क्लेशनम्, क्लेशनम्, चिक्लिशिषणम्-चिक्लेशिषणम्-चिक्लिक्षणम्, चेक्लिशनम्;</li> <li>  <sup id="ref_krm_0295_17"><a href="#foot_krm_0295_17">17</a></sup> <sup id="ref_krm_0295_18"><a href="#foot_krm_0295_18">18</a></sup> क्लिशित्वा <sup id="ref_krm_0295_19"><a href="#foot_krm_0295_19">19</a></sup> -क्लिष्ट्वा, <sup id="ref_krm_0295_20"><a href="#foot_krm_0295_20">20</a></sup> <sup id="ref_krm_0295_21"><a href="#foot_krm_0295_21">21</a></sup> अलंक्लिशित्वा <sup id="ref_krm_0295_22"><a href="#foot_krm_0295_22">22</a></sup>, क्लेशयित्वा, चिक्लिशिषित्वा-चिक्लेशिषित्वा-चिक्लिक्षित्वा, चेक्लिशित्वा;</li> <li>  परिक्लिश्य, परिक्लेश्य, परिचिक्लिशिष्य-परिचिक्लि{??}शिष्य-परिचिक्लिक्ष्य, परिचेक्लिश्य;</li> <li>  क्लेशम् २, क्लिशित्वा २, क्लिष्ट्वा २, क्लेशम् २, क्लेशयित्वा २, चिक्लिशिषम् २ -चिक्लेशिषम् २ -चिक्लिक्षम् २, चिक्लिशिषित्वा २ -चिक्लेशिषित्वा २ -चिक्लिक्षित्वा २, चेक्लिलशम् २;</li> <li>  चेक्लिशित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0295_01"><a href="#ref_krm_0295_01">↑</a> (२८८)</li> <li id="foot_krm_0295_02"><a href="#ref_krm_0295_02">↑</a> (९-क्र्यादिः-१५२२-अक। वेट्। पर।)</li> <li id="foot_krm_0295_03"><a href="#ref_krm_0295_03">↑</a> [[[अ]</li> <li id="foot_krm_0295_04"><a href="#ref_krm_0295_04">↑</a> (कुमारसम्भवे २-४०)</li> <li id="foot_krm_0295_05"><a href="#ref_krm_0295_05">↑</a> (श्लो। १६३-१६४)</li> <li id="foot_krm_0295_06"><a href="#ref_krm_0295_06">↑</a> [[३। ‘स्वरतिसूतिसूयतिधूञूदितो वा’ (७-२-४४) इतीड्विकल्पे, ‘रलो व्युपधात्-- (१-२-२६) इति कित्त्वविकल्पः। एवं सन्नन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0295_07"><a href="#ref_krm_0295_07">↑</a> [[४। इडभावपक्षे ‘व्रश्च--’ (८-२-३६) इत्यादिना षत्वे ‘षढोः कः सि’ (८-२-४१) इति कः।]]</li> <li id="foot_krm_0295_08"><a href="#ref_krm_0295_08">↑</a> [[५। ‘क्र्यादिभ्यः श्ना’ (३-१-८१) इति श्ना। ‘श्नाऽभ्यस्तयोः--’ (६-४-११२)’ इत्याकारलोपः। ‘शात्’ (८-४-४४) इति श्चुत्वनिषेधः।]]</li> <li id="foot_krm_0295_09"><a href="#ref_krm_0295_09">↑</a> [[B। ‘आधोरणानपि च दन्तवरेण तुभ्नन् क्लिश्नन् मतिं पलसुरादिकमश्नतां सः।’ धा। का। ३-११।]]</li> <li id="foot_krm_0295_10"><a href="#ref_krm_0295_10">↑</a> [पृष्ठम्०३००+ १९]</li> <li id="foot_krm_0295_11"><a href="#ref_krm_0295_11">↑</a> [[१। ‘व्रश्च भ्रस्ज--’ (८-२-३६) इत्यादिना षत्वे जश्त्वचर्त्वयोरूपम्।]]</li> <li id="foot_krm_0295_12"><a href="#ref_krm_0295_12">↑</a> [[२। ‘अन्येभ्योऽपि--’ (३-२-७५) इत्यादिना विच्। गुणः।]]</li> <li id="foot_krm_0295_13"><a href="#ref_krm_0295_13">↑</a> [[३। ‘क्लिशः क्त्वानिष्ठयोः’ (७-२-५०) इति वा इट्। ‘यस्य विभाषा’ (७-२-१५) इत्यस्य बाधकः।]]</li> <li id="foot_krm_0295_14"><a href="#ref_krm_0295_14">↑</a> [[आ। ‘उपद्रुतश्चिरं द्वन्द्वैर्ययोः क्लिशितवानहम्।।’ भ। का। २२-७।]]</li> <li id="foot_krm_0295_15"><a href="#ref_krm_0295_15">↑</a> [[४। ‘निन्दहिंसक्लिशखाद--’ (३-२-१४६) इत्यादिना ताच्छील्ये वुञ्।]]</li> <li id="foot_krm_0295_16"><a href="#ref_krm_0295_16">↑</a> [[B। ‘निन्दको रजनिम्मन्यं दिवसं क्लेशको निशाम्।’ भ। का। ७-१३।]]</li> <li id="foot_krm_0295_17"><a href="#ref_krm_0295_17">↑</a> [पृष्ठम्०३०१+ २३]</li> <li id="foot_krm_0295_18"><a href="#ref_krm_0295_18">↑</a> [[आ। ‘चिरं क्लिशित्वा मर्मावित् रामो विलुभितप्लवम्।’ भ। का। ५-५२।]]</li> <li id="foot_krm_0295_19"><a href="#ref_krm_0295_19">↑</a> [[१। ‘क्लिशः क्त्वानिष्ठयोः’ (७-२-५०) इति वा इट्। ‘मृडमृद--’ (१-२-७) इत्या- दिना नित्यं कित्त्वम्।]]</li> <li id="foot_krm_0295_20"><a href="#ref_krm_0295_20">↑</a> [[B। ‘मायाभिः सुचिरं क्लिष्ट्वा राक्षसोऽक्लिशितक्रियम्।’ भ। का। ९-३८।]]</li> <li id="foot_krm_0295_21"><a href="#ref_krm_0295_21">↑</a> [[२। ‘अलंखल्वोः प्रतिषेधयोः प्राचां क्त्वा’ (३-४-१८) इति क्त्वा।]]</li> <li id="foot_krm_0295_22"><a href="#ref_krm_0295_22">↑</a> [[C। ‘अलं क्लिशित्वा गुरुमल्पकोऽयं विधिस्त्वदाज्ञैव गरीयसी नः’। अनर्घराघवे २-५७।]]</li></ul></p>

क्लीबृ|क्लीबकः-बिका|चिक्लीबिषकः-षिका|चेक्लीबकः-बिका|क्लीबनः|क्लीबमानः|क्लीबिष्यमाणः|चिक्लीबिषमाणः-चिक्लीबिषिष्यमाणः
<ul><li><sup id="ref_krm_0296_01"><a href="#foot_krm_0296_01">1</a></sup> {@“क्लीबृ अधार्ष्ट्ये”@} <sup id="ref_krm_0296_02"><a href="#foot_krm_0296_02">2</a></sup> क्लीबकः-बिका, क्लीबकः-बिका, चिक्लीबिषकः-षिका, चेक्लीबकः-बिका;</li> <li>  क्लीबिता-त्री, क्लीबितः <sup id="ref_krm_0296_03"><a href="#foot_krm_0296_03">3</a></sup> -तवान्, इत्यादीनि सर्वाण्यपि रूपाणि भौवादिक- क्रीडति धातुवत् <sup id="ref_krm_0296_04"><a href="#foot_krm_0296_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0296_05"><a href="#foot_krm_0296_05">5</a></sup> क्लीबनः, <sup id="ref_krm_0296_06"><a href="#foot_krm_0296_06">6</a></sup> क्लीबमानः, क्लीबिष्यमाणः, <sup id="ref_krm_0296_07"><a href="#foot_krm_0296_07">7</a></sup> चिक्लीबिषमाणः-चिक्लीबिषिष्यमाणः;</li> <li>  इति रूपाणि भवन्ति-इति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0296_01"><a href="#ref_krm_0296_01">↑</a> (२८९)</li> <li id="foot_krm_0296_02"><a href="#ref_krm_0296_02">↑</a> (१-भ्वादिः-३८१। अक। सेट्। आत्म।)</li> <li id="foot_krm_0296_03"><a href="#ref_krm_0296_03">↑</a> [[ड्। ‘प्रलम्बसास्नाः कबरत्विषो वृषा अक्लीबिताः क्षीबतयाऽतिशीभराः।।’ धा। का। १-४९।]]</li> <li id="foot_krm_0296_04"><a href="#ref_krm_0296_04">↑</a> (२७५)</li> <li id="foot_krm_0296_05"><a href="#ref_krm_0296_05">↑</a> [[३। ‘अनुदात्तेतश्च हलादेः’ (३-२-१४९) इति ताच्छीलिको युच्।]]</li> <li id="foot_krm_0296_06"><a href="#ref_krm_0296_06">↑</a> [[४। आत्मनेपदित्वात् शानच्।]]</li> <li id="foot_krm_0296_07"><a href="#ref_krm_0296_07">↑</a> [[५। ‘पूर्ववत् सनः’ (१-३-६२) इति सन्नन्तादप्यात्मनेपदमेव।]]</li></ul></p>

