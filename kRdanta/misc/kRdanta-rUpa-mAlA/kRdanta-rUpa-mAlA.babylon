<ul><li><sup id="ref_krm_0393_01"><a href="#foot_krm_0393_01">1</a></sup> {@“गर्ह कुत्सायाम्”@} <sup id="ref_krm_0393_02"><a href="#foot_krm_0393_02">2</a></sup> “ण्यन्तस्य ग्रहणे गृहेर्गृहयते तत्रानदन्ताद् गृहेः भूवादेः शपि गर्हते, श्नि तु पदे गृह्णात्यगृह्णीत च। </li> <li>गर्हेर्वा णिचि निन्दनार्थविषये गर्हेत् तथा गर्हयेद् भूवादेः शपि कुत्सनार्थविषये गर्हेर्भवेत् गर्हते।।” <sup id="ref_krm_0393_03"><a href="#foot_krm_0393_03">3</a></sup> इति देवः। </li> <li>गर्हकः-र्हिका, गर्हकः-र्हिका, जिगर्हिषकः-षिका, <sup id="ref_krm_0393_04"><a href="#foot_krm_0393_04">4</a></sup> जागर्हकः-र्हिका;</li> <li>  गर्हिता-त्री, गर्हयिता-त्री, जिगर्हिषिता-त्री, जागर्हिता-त्री;</li> <li>  -- गर्हयन्-न्ती, गर्हयिष्यन्-न्ती-ती;</li> <li>  -- गर्हमाणः, गर्हयमाणः, जिगर्हिषमाणः, जागर्ह्यमाणः;</li> <li>  गर्हिष्यमाणः, गर्हयिष्यमाणः, जिगर्हिषिष्यमाणः, जागर्हिष्यमाणः;</li> <li>  <sup id="ref_krm_0393_05"><a href="#foot_krm_0393_05">5</a></sup> घर्ट्-घर्ड्-गर्हौ-गर्हः;</li> <li>  -- -- -- गर्हितम्-तः, <sup id="ref_krm_0393_06"><a href="#foot_krm_0393_06">6</a></sup> विगर्हितम्, गर्हितः, जिगर्हिषितः, जागर्हितः-तवान्;</li> <li>  गर्हः, <sup id="ref_krm_0393_07"><a href="#foot_krm_0393_07">7</a></sup> गर्हणः, गर्हः, जिगर्हिषुः, जागर्हः;</li> <li>  गर्हितव्यम्, गर्हयितव्यम्, जिगर्हिषितव्यम्, जागर्हितव्यम्;</li> <li>  गर्हणीयम्, गर्हणीयम्, जिगर्हिषणीयम्, जागर्हणीयम्;</li> <li>  <sup id="ref_krm_0393_08"><a href="#foot_krm_0393_08">8</a></sup> गर्ह्यम्, गर्ह्यम्, जिगर्हिष्यम्, जागर्ह्यम्;</li> <li>  ईषद्गर्हः-दुर्गर्हः-सुगर्हः;</li> <li>  -- -- गर्ह्यमाणः, गर्ह्यमाणः, जिगर्हिष्यमाणः, जागर्ह्यमाणः;</li> <li>  गर्हः, गर्हः, जिगर्हिषः, जागर्हः;</li> <li>  गर्हितुम्, गर्हयितुम्, जिगर्हिषितुम्, जागर्हितुम्;</li> <li>  <sup id="ref_krm_0393_09"><a href="#foot_krm_0393_09">9</a></sup> गर्हा, गर्हणा, जिगर्हिषा, जागर्हा;</li> <li>  गर्हणम्, गर्हणम्, जिगर्हिषणम्, जागर्हणम्;</li> <li>  गर्हित्वा, गर्हयित्वा, जिगर्हिषित्वा, जागर्हित्वा;</li> <li>  विगर्ह्य, प्रगर्ह्य, सञ्जिगर्हिष्य, सञ्जागर्ह्य;</li> <li>  गर्हम् २, गर्हित्वा २, गर्हम् २, गर्हयित्वा २, जिगर्हिषम् २, जिगर्हिषित्वा २, जागर्हम् २;</li> <li>  जागर्हित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0393_01"><a href="#ref_krm_0393_01">↑</a> (३८५)</li> <li id="foot_krm_0393_02"><a href="#ref_krm_0393_02">↑</a> (१-भ्वादिः।-६३६। सक। सेट्। आत्म।)</li> <li id="foot_krm_0393_03"><a href="#ref_krm_0393_03">↑</a> (श्लो। १९४)</li> <li id="foot_krm_0393_04"><a href="#ref_krm_0393_04">↑</a> [[१। ‘दीर्घोऽकितः’ (७-४-८३) इत्यभ्यासस्य दीर्घः।]]</li> <li id="foot_krm_0393_05"><a href="#ref_krm_0393_05">↑</a> [[२। पदान्ते ‘हो ढः’ (८-२-३१) इति ढत्वम्। ‘रात् सस्य’ (८-२-२४) इति नियमात् संयोगान्तलोपो न। ‘एकाचो बशो भष् झषन्तस्य स्ध्वोः’ (८-२-३७) इति पदान्तनिमित्तको भष्भावः। चर्त्वं विकल्पेन।]]</li> <li id="foot_krm_0393_06"><a href="#ref_krm_0393_06">↑</a> [[आ। ‘मांसविक्रयिणः कर्म व्याधस्यापि विगर्हितम्। मां घ्नता भवताऽकारि निश्शङ्कं पापदृश्वना।।’ भ। का। ६-१३२।]]</li> <li id="foot_krm_0393_07"><a href="#ref_krm_0393_07">↑</a> [[३। ‘अनुदात्तेतश्च हलादेः’ (३-२-१४९) इति ताच्छीलिकः युच्।]]</li> <li id="foot_krm_0393_08"><a href="#ref_krm_0393_08">↑</a> [पृष्ठम्०३७८+ २६]</li> <li id="foot_krm_0393_09"><a href="#ref_krm_0393_09">↑</a> [[आ। ‘आशंसिताप्तिमुदितो भुवनग्रसिष्णुं विष्णुं तमेनमसतां ग्लसमानमीहाम्। अक्रूर एत्य बहुधा गदमंहितांहा गर्होज्झितोऽपतदगल्ह्यतमे पदाब्जे।।’ धा। का। १-८०।]]</li></ul></p>

गर्ह|ण्यन्तात्|सनि|तु-जिगर्हयिषकः-षिका|जिगर्हयिषितम्-तः-तवान्|जिगर्हयिषिता-त्री|जिगर्हयिषुः|जिगर्हयिषिषन्-न्ती|जिगर्हयिषितव्यम्|जिगर्हयिषिष्यन्-न्ती-ती|जिगर्हयिषणीयम्|जिगर्हयिषमाणः|जिगर्हयिष्यम्|जिगर्हयिषिष्यमाणः|ईषज्जिगर्हयिषः-दुर्जिगर्हयिषः-सुजिगर्हयिषः|जिगर्हयिट्-जिगर्हयिड्-यिषौ-यिषः|जिगर्हयिष्यमाणः|जिगर्हयिषः|जिगर्हयिषित्वा|जिगर्हयिषितुम्|सञ्जिगर्हयिष्य|जिगर्हयिषा|जिगर्हयिषम्|जिगर्हयिषित्वा।|जिगर्हयिषणम्
<ul><li><sup id="ref_krm_0394_01"><a href="#foot_krm_0394_01">1</a></sup> {@“गर्ह निन्दायाम्”@} <sup id="ref_krm_0394_02"><a href="#foot_krm_0394_02">2</a></sup> आधृषीयः। </li> <li>“ण्यन्तस्य ग्रहणे गृहेर्गृहयते तत्रानदन्ताद् गृहेः भूवादेः शपि गर्हते, श्नि तु पदे गृह्णात्यगृह्णीत च। </li> <li>गर्हेर्वा णिचि निन्दनार्थविषये गर्हेत् तथा गर्हयेत् भूवादेः शपि कुत्सनार्थविषये गर्हेर्भवेत् गर्हते।।” <sup id="ref_krm_0394_03"><a href="#foot_krm_0394_03">3</a></sup> इति देवः। </li> <li>अस्य धातोराधृषीयत्वात् ‘आधृषाद्वा’ <sup id="ref_krm_0394_04"><a href="#foot_krm_0394_04">4</a></sup> इति णिचो वैकल्पिकत्वम्। </li> <li>णिच्पक्षे, णिजभावपक्षे च कुत्सार्थकभौवादिकगर्हतिवत् <sup id="ref_krm_0394_05"><a href="#foot_krm_0394_05">5</a></sup> सर्वाणि रूपाणि ज्ञेयानि। </li> <li>णिजभावपक्षे शुद्धात् सनि, यङि च तत्र लिखितान्येव रूपाण्यस्यापि। </li> <li>शुद्धाद्धातोः ‘शेषात् कर्तरि--’ <sup id="ref_krm_0394_06"><a href="#foot_krm_0394_06">6</a></sup> इति शतैव। </li> <li><sup id="ref_krm_0394_07"><a href="#foot_krm_0394_07">7</a></sup> गर्हन्-न्ती, इति रूपम्। </li> <li>ण्यन्तात् सनि तु-- <sup id="ref_krm_0394_08"><a href="#foot_krm_0394_08">8</a></sup> जिगर्हयिषकः-षिका, जिगर्हयिषितम्-तः-तवान्, जिगर्हयिषिता-त्री, जिगर्हयिषुः, जिगर्हयिषिषन्-न्ती, जिगर्हयिषितव्यम्, जिगर्हयिषिष्यन्-न्ती-ती, जिगर्हयिषणीयम्, जिगर्हयिषमाणः, जिगर्हयिष्यम्, जिगर्हयिषिष्यमाणः, ईषज्जिगर्हयिषः-दुर्जिगर्हयिषः-सुजिगर्हयिषः, जिगर्हयिट्- <sup id="ref_krm_0394_09"><a href="#foot_krm_0394_09">9</a></sup> जिगर्हयिड्-यिषौ-यिषः, जिगर्हयिष्यमाणः, जिगर्हयिषः;</li> <li>  जिगर्हयिषित्वा;</li> <li>  जिगर्हयिषितुम्;</li> <li>  सञ्जिगर्हयिष्य;</li> <li>  जिगर्हयिषा;</li> <li>  जिगर्हयिषम् २;</li> <li>  जिगर्हयिषित्वा २। जिगर्हयिषणम्;</li> <li>  इति रूपाणि इति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0394_01"><a href="#ref_krm_0394_01">↑</a> (३८६)</li> <li id="foot_krm_0394_02"><a href="#ref_krm_0394_02">↑</a> (१०-चुरादिः-१८४६। अक। सेट्। उभ।)</li> <li id="foot_krm_0394_03"><a href="#ref_krm_0394_03">↑</a> (श्लो। १९४)</li> <li id="foot_krm_0394_04"><a href="#ref_krm_0394_04">↑</a> (ग। सू। चुरादौ)</li> <li id="foot_krm_0394_05"><a href="#ref_krm_0394_05">↑</a> (३८५)</li> <li id="foot_krm_0394_06"><a href="#ref_krm_0394_06">↑</a> (१-३-७८)</li> <li id="foot_krm_0394_07"><a href="#ref_krm_0394_07">↑</a> [[B। ‘वचन्तो मानन्तो हरिविभवमानन्दमखिला बभूबुर्गर्हन्तो मनसि नृपतिं मार्गितखलम्। स्त्रियश्चोत्कण्ठन्त्यो ददृशुरजितं मृष्टतनवः मृपस्त्वेतन्नामर्षत रिपुजनाधर्षितबलः।।’ धा। का। ३। ५२।]]</li> <li id="foot_krm_0394_08"><a href="#ref_krm_0394_08">↑</a> [पृष्ठम्०३७९+ २४]</li> <li id="foot_krm_0394_09"><a href="#ref_krm_0394_09">↑</a> [[१। क्विपि अतो लोपे कृते, ‘झलां जशोऽन्ते’ (८-२-३९) इति डकारः। चर्त्वविकल्पः]]</li></ul></p>

गल|गालकः-लिका|जिगलिषकः-षिका|जागलकः-लिका|गलिता-त्री|गालयिता-त्री|जिगलिषिता-त्री|जागलिता-त्री|गलन्-न्ती|गालयन्-न्ती|जिगलिषन्-न्ती|-|गलिष्यन्-न्ती-ती|गालयिष्यन्-न्ती-ती|जिगलिषिष्यन्-न्ती-ती|जागल्यमानः|जागलिष्यमाणः|सुगल्-सुगलौ-सुगलः|गलितम्-तः-तवान्|गालितः|जिगलिषितः|जागलितः-तवान्|गलः|निगलः|सुगाली|गालः|जिगलिषुः|जागलः|गलितव्यम्|गालयितव्यम्|जिगलिषितव्यम्|जागलितव्यम्|गलनीयम्|गालनीयम्|जिगलिषणीयम्|जागलनीयम्|गाल्यम्|जिगलिष्यम्|जागल्यम्|ईषद्गलः-दुर्गलः-सुगलः|गल्यमानः|गाल्यमानः|जिगलिष्यमाणः|जिगलिषः|गलितुम्|गालयितुम्|जिगलिषितुम्|जागलितुम्|गलितिः|गालना|जिगलिषा|जागला|विगलनम्|गालनम्|जिगलिषणम्|जागलनम्|गलित्वा|गालयित्वा|जिगलिषित्वा|जागलित्वा|निगल्य|निगाल्य|प्रजिगलिष्य|प्रजागल्य|गालम्|जिगलिषम्|जागलम्
<ul><li><sup id="ref_krm_0395_01"><a href="#foot_krm_0395_01">1</a></sup> {@“गल अदने”@} <sup id="ref_krm_0395_02"><a href="#foot_krm_0395_02">2</a></sup> धातूनामनेकार्थत्वात् स्रवणेऽप्ययं धातुः इति क्षीरस्वामी। </li> <li>गालकः-लिका, गालकः-लिका, जिगलिषकः-षिका, जागलकः-लिका;</li> <li>  गलिता-त्री, गालयिता-त्री, जिगलिषिता-त्री, जागलिता-त्री;</li> <li>  गलन्-न्ती, <sup id="ref_krm_0395_03"><a href="#foot_krm_0395_03">3</a></sup> गालयन्-न्ती, जिगलिषन्-न्ती;</li> <li>  -- गलिष्यन्-न्ती-ती, गालयिष्यन्-न्ती-ती, जिगलिषिष्यन्-न्ती-ती;</li> <li>  -- -- -- जागल्यमानः, जागलिष्यमाणः;</li> <li>  सुगल्-सुगलौ-सुगलः;</li> <li>  -- -- -- गलितम्-तः-तवान्, गालितः, जिगलिषितः, जागलितः-तवान्;</li> <li>  <sup id="ref_krm_0395_04"><a href="#foot_krm_0395_04">4</a></sup> <sup id="ref_krm_0395_05"><a href="#foot_krm_0395_05">5</a></sup> गलः <sup id="ref_krm_0395_06"><a href="#foot_krm_0395_06">6</a></sup>, निगलः <sup id="ref_krm_0395_07"><a href="#foot_krm_0395_07">7</a></sup>, <sup id="ref_krm_0395_08"><a href="#foot_krm_0395_08">8</a></sup> सुगाली, गालः, जिगलिषुः, जागलः;</li> <li>  गलितव्यम्, गालयितव्यम्, जिगलिषितव्यम्, जागलितव्यम्;</li> <li>  गलनीयम्, गालनीयम्, जिगलिषणीयम्, जागलनीयम्;</li> <li>  गाल्यम्, गाल्यम्, जिगलिष्यम्, जागल्यम्;</li> <li>  ईषद्गलः-दुर्गलः-सुगलः;</li> <li>  -- -- गल्यमानः, गाल्यमानः, जिगलिष्यमाणः, जागल्यमानः;</li> <li>  गालः, गालः, जिगलिषः, जागलः;</li> <li>  गलितुम्, गालयितुम्, जिगलिषितुम्, जागलितुम्;</li> <li>  <sup id="ref_krm_0395_09"><a href="#foot_krm_0395_09">9</a></sup> गलितिः, गालना, जिगलिषा, जागला;</li> <li>  विगलनम्, गालनम्, जिगलिषणम्, जागलनम्;</li> <li>  गलित्वा, गालयित्वा, जिगलिषित्वा, जागलित्वा;</li> <li>  निगल्य, निगाल्य, प्रजिगलिष्य, प्रजागल्य;</li> <li>  गालम् २, गलित्वा २, गालम् २, गालयित्वा २, जिगलिषम् २, जिगलिषित्वा २, जागलम् २;</li> <li>  जागलित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0395_01"><a href="#ref_krm_0395_01">↑</a> (३८७)</li> <li id="foot_krm_0395_02"><a href="#ref_krm_0395_02">↑</a> (१-भ्वादिः-५४६। अक। सेट्। पर।)</li> <li id="foot_krm_0395_03"><a href="#ref_krm_0395_03">↑</a> [[२। अस्य धातोः परस्मैपदित्वात् शानच् न। ण्यन्तात् ‘निगरणचलनार्थेभ्यः--’ (१-३-८७) इति निषेधात् ‘णिचश्च’ (१-३-७४) इति प्राप्तः शानजपि न। ‘पूर्ववत् सनः’ (१-३-६२) इति वचनात् सन्नन्तादपि न।]]</li> <li id="foot_krm_0395_04"><a href="#ref_krm_0395_04">↑</a> [पृष्ठम्०३८०+ २५]</li> <li id="foot_krm_0395_05"><a href="#ref_krm_0395_05">↑</a> [[आ। ‘सुमार्गशेलात् स्खलतां खलात्मनां गलच्छिदार्थं सलितं महीतलम्। दलत्तनुप्रश्वलितान् परान् प्रति प्रश्वल्लिताखोडसुदर्शनायुधम्।।’ धा। का। १-७०।]]</li> <li id="foot_krm_0395_06"><a href="#ref_krm_0395_06">↑</a> [[१। गलति = भक्षयतीति कर्तरि पचाद्यच्। ‘गोचरसञ्चर--’ (३-३-११९) इति सूत्रे चकारस्यानुक्तसमुच्चयार्थकत्वात् घञपवादो घः संज्ञायाम्--इति माधवधातुवृत्तौ।]]</li> <li id="foot_krm_0395_07"><a href="#ref_krm_0395_07">↑</a> [[B। ‘चरमतश्च ऋणादिव देवकीपतिरमुच्यत शृङ्खलतः स्थिरात्। निखिलबन्धनिवर्तकसन्निधौ विगलनं निगलस्य किमद्भुतम्।।’ यादवाभ्युदये--३-११।]]</li> <li id="foot_krm_0395_08"><a href="#ref_krm_0395_08">↑</a> [[२। ‘सुप्यजातौ--’ (३-२-७८) इति ताच्छील्ये णिनिः।]]</li> <li id="foot_krm_0395_09"><a href="#ref_krm_0395_09">↑</a> [[३। ‘तितुत्रेष्वग्रहादीनाम्--’ (वा। ७-२-९) इति वचनात् इड् भवति, ग्रहादयो = ग्रहप्रकारा इत्युक्तत्वात्।]]</li></ul></p>

गल|गालकः-लिका|जिगालयिषकः-षिका|गालयिता-त्री|जिगालयिषिता-त्री|गालयमानः|जिगालयिषमाणः|गालयिष्यमाणः|जिगालयिषिष्यमाणः|सुगाल्-सुगालौ-सुगालः|-|गालितम्-तः-तवान्|जिगालयिषितः-तवान्|गालः|जिगालयिषुः|गालयितव्यम्|जिगालयिषितव्यम्|गालनीयम्|जिगालयिषणीयम्|गाल्यम्|जिगालयिष्यम्|ईषद्गालः-दुर्गालः-सुगालः|गाल्यमानः|जिगालयिष्यमाणः|जिगालयिषः|गालयितुम्|जिगालयिषितुम्|गालना|जिगालयिषा|गालनम्|जिगालयिषणम्|गालयित्वा|जिगालयिषित्वा|निगाल्य|प्रजिगालयिष्य|गालम्|जिगालयिषम्
<ul><li><sup id="ref_krm_0396_01"><a href="#foot_krm_0396_01">1</a></sup> {@“गल स्रवणे”@} <sup id="ref_krm_0396_02"><a href="#foot_krm_0396_02">2</a></sup> <sup id="ref_krm_0396_03"><a href="#foot_krm_0396_03">3</a></sup> गालकः-लिका, <sup id="ref_krm_0396_04"><a href="#foot_krm_0396_04">4</a></sup> जिगालयिषकः-षिका;</li> <li>  गालयिता-त्री, जिगालयिषिता-त्री;</li> <li>  <sup id="ref_krm_0396_05"><a href="#foot_krm_0396_05">5</a></sup> <sup id="ref_krm_0396_06"><a href="#foot_krm_0396_06">6</a></sup> गालयमानः, जिगालयिषमाणः;</li> <li>  गालयिष्यमाणः, जिगालयिषिष्यमाणः;</li> <li>  सुगाल्-सुगालौ-सुगालः;</li> <li>  -- गालितम्-तः-तवान्, जिगालयिषितः-तवान्;</li> <li>  गालः, जिगालयिषुः;</li> <li>  गालयितव्यम्, जिगालयिषितव्यम्;</li> <li>  गालनीयम्, जिगालयिषणीयम्;</li> <li>  गाल्यम्, जिगालयिष्यम्;</li> <li>  ईषद्गालः-दुर्गालः-सुगालः;</li> <li>  -- गाल्यमानः, जिगालयिष्यमाणः;</li> <li>  गालः, जिगालयिषः;</li> <li>  गालयितुम्, जिगालयिषितुम्;</li> <li>  गालना, जिगालयिषा;</li> <li>  <sup id="ref_krm_0396_07"><a href="#foot_krm_0396_07">7</a></sup> गालनम्, जिगालयिषणम्;</li> <li>  गालयित्वा, जिगालयिषित्वा;</li> <li>  निगाल्य, प्रजिगालयिष्य;</li> <li>  गालम् २, गालयित्वा २, जिगालयिषम् २;</li> <li>  जिगालयिषित्वा २</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0396_01"><a href="#ref_krm_0396_01">↑</a> (३८८)</li> <li id="foot_krm_0396_02"><a href="#ref_krm_0396_02">↑</a> (१०-चुरादिः-१७००। सक। सेट्। आत्म। आकुस्मीयः।)</li> <li id="foot_krm_0396_03"><a href="#ref_krm_0396_03">↑</a> [[४। ‘अत उपधायाः’ (७-२-११६) इति णौ वृद्धिः। ‘णेरनिटि’ (६-४-५१) इति णिलोपः।]]</li> <li id="foot_krm_0396_04"><a href="#ref_krm_0396_04">↑</a> [[५। ण्यन्तात् सनि गुणायादेशौ। ‘सन्यतः’ (७-४-७९) इतीत्त्वमभ्यासे।]]</li> <li id="foot_krm_0396_05"><a href="#ref_krm_0396_05">↑</a> [पृष्ठम्०३८१+ २४]</li> <li id="foot_krm_0396_06"><a href="#ref_krm_0396_06">↑</a> [[१। ‘आकुस्मादात्मनेपदिनः’ (ग। सू। चुरादौ) इति आत्मनेपदमेव।]]</li> <li id="foot_krm_0396_07"><a href="#ref_krm_0396_07">↑</a> [[आ। ‘कुत्स्या हि गालनपटा इव कष्टमेते दुष्कीर्तिभालनपराः खलु कूटवृत्त्या। तद्वञ्चनं निरसितुं न हि वर्षिताः स्मः किं कुर्महे खलजना इह मादयन्ताम्।।’ धा। का। ३-३६। इति अकारस्य अनुदात्तत्वप्रतिज्ञानात् शानच् प्रत्ययः।]]</li></ul></p>

