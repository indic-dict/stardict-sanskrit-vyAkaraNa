<ul><li><sup id="ref_krm_1403_01"><a href="#foot_krm_1403_01">1</a></sup> {@“राघृ सामर्थ्ये”@} <sup id="ref_krm_1403_02"><a href="#foot_krm_1403_02">2</a></sup> राघकः-घिका, राघकः-घिका, रिराघिषकः-षिका, राराघकः-घिका;</li> <li>  राघिता-त्री, राघयिता-त्री, रिराघिषिता-त्री, राराघिता-त्री;</li> <li>  इत्यादिकानि समस्तान्यपि रूपाणि भौवादिकद्राखतिवत् <sup id="ref_krm_1403_03"><a href="#foot_krm_1403_03">3</a></sup> ज्ञेयानि। </li> <li>अस्यात्मने- पदत्वात् राघमानः, राघिष्यमाणः, रिराघिषमाणः, रिराघिषिष्यमाणः इति शानचि रूपाणि बोध्यानि। </li> <li><sup id="ref_krm_1403_04"><a href="#foot_krm_1403_04">4</a></sup> राघितः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1403_01"><a href="#ref_krm_1403_01">↑</a> (१३९३)</li> <li id="foot_krm_1403_02"><a href="#ref_krm_1403_02">↑</a> (१-भ्वादिः-११२। अक। सेट्। आत्म।)</li> <li id="foot_krm_1403_03"><a href="#ref_krm_1403_03">↑</a> (८७९)</li> <li id="foot_krm_1403_04"><a href="#ref_krm_1403_04">↑</a> [[आ। ‘प्रवङ्घमानस्य च तस्य सत्वरं विमङ्घनस्याधिकराघितात्मनः।’ धा। का। १। १६।]]</li></ul></p>

राजृ|राजकः-जिका|रिराजिषकः-षिका|राराजकः-जिका|राजिता-त्री|राजयिता-त्री|रिराजिषिता-त्री|राराजिता-त्री
<ul><li><sup id="ref_krm_1404_01"><a href="#foot_krm_1404_01">1</a></sup> {@“राजृ दीप्तौ”@} <sup id="ref_krm_1404_02"><a href="#foot_krm_1404_02">2</a></sup> फणादिः। </li> <li>राजकः-जिका, राजकः-जिका, रिराजिषकः-षिका, राराजकः-जिका, राजिता-त्री, राजयिता-त्री, रिराजिषिता-त्री, राराजिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककाशतिवत् <sup id="ref_krm_1404_03"><a href="#foot_krm_1404_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1404_04"><a href="#foot_krm_1404_04">4</a></sup> रराजिवान्-रेजिवान्, <sup id="ref_krm_1404_05"><a href="#foot_krm_1404_05">5</a></sup> सम्राट्, <sup id="ref_krm_1404_06"><a href="#foot_krm_1404_06">6</a></sup> विश्वाराट्-राट्, चेदिराट्, <sup id="ref_krm_1404_07"><a href="#foot_krm_1404_07">7</a></sup> राष्टिः, <sup id="ref_krm_1404_08"><a href="#foot_krm_1404_08">8</a></sup> राजिः, <sup id="ref_krm_1404_09"><a href="#foot_krm_1404_09">9</a></sup> राजानकः, <sup id="ref_krm_1404_10"><a href="#foot_krm_1404_10">10</a></sup> राजा, <sup id="ref_krm_1404_11"><a href="#foot_krm_1404_11">11</a></sup> राष्ट्रम्-राष्ट्री, इतीमान्यस्माद् भवन्तीति बोध्यम्। </li> <li><sup id="ref_krm_1404_12"><a href="#foot_krm_1404_12">12</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1404_01"><a href="#ref_krm_1404_01">↑</a> (१३९४)</li> <li id="foot_krm_1404_02"><a href="#ref_krm_1404_02">↑</a> (१-भ्वादिः-८२२। अक। सेट्। उभ।)</li> <li id="foot_krm_1404_03"><a href="#ref_krm_1404_03">↑</a> (१८६)</li> <li id="foot_krm_1404_04"><a href="#ref_krm_1404_04">↑</a> [[१। कर्तरि लिटः क्वसौ, ‘फणां च सप्तानाम्’ (६-४-१२५) इत्येत्वाभ्यासलोप- विकल्पः। ‘वस्वेकाजाद्धसाम्’ (७-२-६७) इतीडागमः।]]</li> <li id="foot_krm_1404_05"><a href="#ref_krm_1404_05">↑</a> [[२। ‘सत्सूद्विषद्रुहदुहयुजविदभिदच्छिदजिनीराजामुपसर्गेऽपि क्विप्’ (३-२-६१) इति ‘सम्’ इत्युपसर्गपूर्वकादस्मात् क्विप्। ‘मोऽनुस्वारः’ (८-३-२३) इत्यस्यापवा- दतया, ‘मो राजि समः क्वौ’ (८-२-२५) इति प्रतिपदविहितो मकारः।]]</li> <li id="foot_krm_1404_06"><a href="#ref_krm_1404_06">↑</a> [[३। ‘विश्वाराट्’ इत्यत्र ‘अन्येभ्योऽपि दृश्यते’ (३-२-१७८) इति क्विप्। ‘विश्वस्य वसुराटोः’ (६-३-१२८) इति दीर्घः।]]</li> <li id="foot_krm_1404_07"><a href="#ref_krm_1404_07">↑</a> [[४। ‘क्तिन् आबादिभ्यः--’ (वा। ३-३-९४) इति बाहुलकात् क्तिन्। हलन्तलक्षणाका- रप्रत्ययस्यापवादः। ‘तितुत्र--’ (७-२-९) इतीण्निषेधे ‘व्रश्चभ्रस्जसृजमृजयज- राजभ्राजच्छशां षः’ (८-२-३६) इति झलि परतो, जकारस्य षकारः।]]</li> <li id="foot_krm_1404_08"><a href="#ref_krm_1404_08">↑</a> [[५। ‘इक् कृष्यादिभ्यः’ (वा। ३-३-१०८) इतीक्प्रत्यये रूपम्। राजते इति राजिः।]]</li> <li id="foot_krm_1404_09"><a href="#ref_krm_1404_09">↑</a> [[६। बाहुलकात् ‘आनकः शीङ्भियः’ (द। उ। ३-२६) इत्यानकप्रत्यये रूपम्। अत्यथं राजते इति राजानकः। अत्र सूत्रे राजधातोरसंग्रहेऽपि, “प्राक् प्रत्ययनिर्देशः” (दशपाद्युणादिवृत्तिः १०-२) इत्यसकृदुक्तत्वादत्रापि राजतेरानकप्रत्यय इति बोध्यम्।]]</li> <li id="foot_krm_1404_10"><a href="#ref_krm_1404_10">↑</a> [[७। ‘कनिन् युवृषितक्षिराजि--’ (द। उ। ६-५१) इति कनिन्प्रत्ययः। ‘सर्वनामस्थाने चासम्बुद्धौ, (६-४-८) इति दीर्घे, ‘न लोपः प्रातिपदिकान्तस्य’ (८-२-७) इति नकारलोपः।]]</li> <li id="foot_krm_1404_11"><a href="#ref_krm_1404_11">↑</a> [[८। ष्ट्रन्प्रत्यये रूपम्। ‘तितुत्र--’ (७-२-९) इतीण्निषेधे षत्वम्। स्त्रियाम् षित्त्वात् ङीष्।]]</li> <li id="foot_krm_1404_12"><a href="#ref_krm_1404_12">↑</a> [पृष्ठम्१११४+ ३०]</li></ul></p>

राध|सिद्ध्यर्थे’इति|द्रोहार्थे|माघप्रयोगाच्च|काश्यपोक्तिर्न|समीचीना|राधकः-धिका|रिरात्सकः-त्सिका|राराधकः-धिका|राद्धा-राद्ध्री|राधयिता-त्री|रिरात्सिता-त्री|राराधिता-त्री
<ul><li><sup id="ref_krm_1405_01"><a href="#foot_krm_1405_01">1</a></sup> {@“राध संसिद्धौ”@} <sup id="ref_krm_1405_02"><a href="#foot_krm_1405_02">2</a></sup> <sup id="ref_krm_1405_03"><a href="#foot_krm_1405_03">3</a></sup> ‘राधोऽकर्मकाद् वृद्धावेव’ <sup id="ref_krm_1405_04"><a href="#foot_krm_1405_04">4</a></sup> इति दिवादिषु पठ्यते। </li> <li>अस्यायमर्थः- एवकारो भिन्नकमः। </li> <li>अस्मादकर्मकादेव श्यन्। </li> <li>वृद्धिग्रहणं तु उदाहरणप्रदर्शनार्थम् यथा वृद्धावकर्मकः, एवमकर्मकेषु सर्वत्राप्यर्थेषु श्यनं लभतेऽयमिति। </li> <li>ततश्च, ‘वृद्धिक्षय-भय-जीवित-मरणं लज्जा-सत्ता-स्थिति-जागरणम्। </li> <li>शयन-क्रीडा-रुचि-दीप्त्यर्थं धातुगणं तमकर्मकमाहुः।।’ इत्युपात्तानामर्थानाम् वृद्धिशब्द उपलक्षक इति भावः। </li> <li>एवञ्च, ‘राध्येद् वृद्धावकर्मकात्।’ इति देववचने <sup id="ref_krm_1405_05"><a href="#foot_krm_1405_05">5</a></sup> वृद्धिग्रहणं तु अकर्मकक्रियोदाहरणमात्रमिति पुरुषकारे व्यक्तम्। </li> <li>धातुकाव्यव्याख्यायां तु <sup id="ref_krm_1405_06"><a href="#foot_krm_1405_06">6</a></sup> एवकारस्य इवार्थकत्वमाश्रित्य, ‘वृद्धावेव = वृद्ध्यर्थ इव।’ इति विवृतम्। </li> <li>काश्यपस्तु एवकारस्य यथाश्रुतान्वयमिच्छन् वृद्ध्यर्थ एव श्यन् इत्यभ्युपगतवानिति माधवधातुवृत्तितो ज्ञायते। </li> <li>सिद्ध्यर्थे ‘राध्यत्योदनः स्वयमेव’ इति भाष्य <sup id="ref_krm_1405_07"><a href="#foot_krm_1405_07">7</a></sup> प्रयोगात्, ‘देवदत्ताय राध्यति’ इति दैवपर्यालोचनार्थे काशिकायां <sup id="ref_krm_1405_08"><a href="#foot_krm_1405_08">8</a></sup> प्रयुक्तत्वात्, ‘-- यन्मह्यमपराध्यति।’ <sup id="ref_krm_1405_09"><a href="#foot_krm_1405_09">9</a></sup> इति द्रोहार्थे माघप्रयोगाच्च काश्यपोक्तिर्न समीचीना;</li> <li>  उपात्तस्थलेषु सर्वत्राकर्मकत्वे मति वृद्ध्यर्थत्वाभावात्। </li> <li>विस्तरस्तु अन्यत्र।]] ‘राध्नोति संसिद्ध्यर्थे श्नौ, राध्येद् वृद्धावकर्मकात्।’ <sup id="ref_krm_1405_10"><a href="#foot_krm_1405_10">10</a></sup> इति देवः। </li> <li>“अस्य तु सिद्धिद्रोहदैवपर्यालोचनादयोऽर्थाः।” इति धा। </li> <li>का। </li> <li>व्याख्या <sup id="ref_krm_1405_11"><a href="#foot_krm_1405_11">11</a></sup>। </li> <li>राधकः-धिका, राधकः-धिका, रिरात्सकः-त्सिका, राराधकः-धिका;</li> <li>  राद्धा-राद्ध्री, राधयिता-त्री, रिरात्सिता-त्री, राराधिता-त्री;</li> <li>  इतीमानि सर्वाण्यपि रूपाणि दैवादिकक्षुध्यतिवत् <sup id="ref_krm_1405_12"><a href="#foot_krm_1405_12">12</a></sup> बोध्यानि। </li> <li>देवदत्ताय <sup id="ref_krm_1405_13"><a href="#foot_krm_1405_13">13</a></sup> राध्यन्-न्ती-ती, <sup id="ref_krm_1405_14"><a href="#foot_krm_1405_14">14</a></sup> राध्यन् ओदनः स्वयमेव, <sup id="ref_krm_1405_15"><a href="#foot_krm_1405_15">15</a></sup> राद्धिः, इतीमान्य- स्माद् भवन्ति। </li> <li><sup id="ref_krm_1405_16"><a href="#foot_krm_1405_16">16</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1405_01"><a href="#ref_krm_1405_01">↑</a> (१३९५)</li> <li id="foot_krm_1405_02"><a href="#ref_krm_1405_02">↑</a> (४-दिवादिः-११८०। अक। अनि। पर।)</li> <li id="foot_krm_1405_03"><a href="#ref_krm_1405_03">↑</a> [[[अ]</li> <li id="foot_krm_1405_04"><a href="#ref_krm_1405_04">↑</a> (ग। सू।)</li> <li id="foot_krm_1405_05"><a href="#ref_krm_1405_05">↑</a> (श्लो १। २२)</li> <li id="foot_krm_1405_06"><a href="#ref_krm_1405_06">↑</a> (२-६३)</li> <li id="foot_krm_1405_07"><a href="#ref_krm_1405_07">↑</a> (३-१-८७)</li> <li id="foot_krm_1405_08"><a href="#ref_krm_1405_08">↑</a> (१-४-३७)</li> <li id="foot_krm_1405_09"><a href="#ref_krm_1405_09">↑</a> (शिशुपालवधे २-११)</li> <li id="foot_krm_1405_10"><a href="#ref_krm_1405_10">↑</a> (श्लो। १२२)</li> <li id="foot_krm_1405_11"><a href="#ref_krm_1405_11">↑</a> (२-६३)</li> <li id="foot_krm_1405_12"><a href="#ref_krm_1405_12">↑</a> (३१५)</li> <li id="foot_krm_1405_13"><a href="#ref_krm_1405_13">↑</a> [[१। ‘राधोऽकर्मकाद् वृद्धावेव’ (ग। सू। दिवादिषु) इति श्यन्। स्त्रियाम्, ‘आच्छीनद्योर्नुम्’ (७-१-८०) इति नुम्विकल्पः। ‘राधीक्ष्योर्यस्य विप्रश्नः’ (१-४-३९) इति चतुर्थी। नैमित्तिकः पृष्टः सन् देवदत्तस्य दैवं पर्यालोचयन् इत्यर्थः।]]</li> <li id="foot_krm_1405_14"><a href="#ref_krm_1405_14">↑</a> [[२। कर्मकर्तरि प्रयोगः। अत्र ‘राध्यतेर्विक्लित्तिवचनत्वात्…’ इति भाष्यप्रदीपः। तेनात्र सामान्यतः सिद्ध्यर्थकत्वेऽपि सिद्धिविशेषरूपपाकोऽपि धातूनामनेकार्थकत्वाद् बोध्यः।]]</li> <li id="foot_krm_1405_15"><a href="#ref_krm_1405_15">↑</a> [[३। हलन्तलक्षणाकारप्रत्ययापवादः ‘क्तिन् आबादिभ्यः…’ (वा। ३-३-९४) इति क्तिन्।]]</li> <li id="foot_krm_1405_16"><a href="#ref_krm_1405_16">↑</a> [पृष्ठम्१११५+ २६]</li></ul></p>

राध|राधकः-धिका|आरिरात्सकः-प्रतिरित्सकः-त्सिका|राराधकः-|धिका|राद्धा-राद्ध्री|राधयिता-त्री|आरिरात्सिता-त्री|राराधिता-त्री|राध्नुवन्-ती|राधयन्-न्ती|आरिरात्सन्-प्रतिरित्सन्-न्ती
<ul><li><sup id="ref_krm_1406_01"><a href="#foot_krm_1406_01">1</a></sup> {@“राध संसिद्धौ”@} <sup id="ref_krm_1406_02"><a href="#foot_krm_1406_02">2</a></sup> ‘राध्नोति संसिद्ध्यर्थे श्नौ राध्येद् वृद्धावकर्मकात्।’ <sup id="ref_krm_1406_03"><a href="#foot_krm_1406_03">3</a></sup> इति देवः। </li> <li>राधकः-धिका, राधकः-धिका, <sup id="ref_krm_1406_04"><a href="#foot_krm_1406_04">4</a></sup> आरिरात्सकः-प्रतिरित्सकः-त्सिका, राराधकः- धिका;</li> <li>  राद्धा-राद्ध्री, राधयिता-त्री, आरिरात्सिता-त्री, राराधिता-त्री;</li> <li>  <sup id="ref_krm_1406_05"><a href="#foot_krm_1406_05">5</a></sup> राध्नुवन्-ती, राधयन्-न्ती, आरिरात्सन्-प्रतिरित्सन्-न्ती;</li> <li>  -- इत्यादीनि सर्वाण्यपि रूपाणि दैवादिकक्षुध्यतिवत् <sup id="ref_krm_1406_06"><a href="#foot_krm_1406_06">6</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1406_07"><a href="#foot_krm_1406_07">7</a></sup> अपरेधिवान्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1406_01"><a href="#ref_krm_1406_01">↑</a> (१३९६)</li> <li id="foot_krm_1406_02"><a href="#ref_krm_1406_02">↑</a> (५-स्वादिः-१२६२। सक। अनि। पर।)</li> <li id="foot_krm_1406_03"><a href="#ref_krm_1406_03">↑</a> (श्लो। १२२)</li> <li id="foot_krm_1406_04"><a href="#ref_krm_1406_04">↑</a> [[१। संसिद्ध्यर्थे रूपमेवम्। धातूनामनेकाथत्वात् हिंसार्थे तु ‘राधो हिंसायां सनीम् वाच्यः’ (वा। ७-४-५४) इति सनि इस्। ‘अत्र लोपोऽभ्यासस्य’ (७-४-५३) इत्यभ्यासलोपः। ‘स्कोः--’ (८-२-२९) इति सकारस्य लोपः। इदमेव वार्तिकं (वा। ७-४-५४) धातोरस्य हिंसार्थत्वे ज्ञापकम्। हिंसार्थे सकर्मकोऽयं धातुः।]]</li> <li id="foot_krm_1406_05"><a href="#ref_krm_1406_05">↑</a> [[२। धातोः सकर्मकत्वे ‘स्वादिभ्यः--’ (३-१-७३) इति श्नुः। अकर्मकत्वे तु ‘राधोऽकर्मकाद् वृद्धावेव’ (ग। सू। दिवादौ) इति श्यनेव।]]</li> <li id="foot_krm_1406_06"><a href="#ref_krm_1406_06">↑</a> (३१५)</li> <li id="foot_krm_1406_07"><a href="#ref_krm_1406_07">↑</a> [[३। कर्तरि लिटः क्वसौ, ‘राधो हिंसायाम्’ (६-४-१२३) इति एत्वाभ्यासलोपौ। अत्रापि धातोर्हिसार्थकत्वस्यानूद्यमानत्वात् धातोरनेकार्थत्वमिति ज्ञेयम्। हिंसाभि- न्नार्थेषु तु रराधिवान् इति क्वसुप्रत्यये रूपमिति ज्ञेयम्।]]</li></ul></p>

रासृ|रासकः-सिका|रिरासिषकः-षिका|रारासकः-सिका|रासिता-त्री|रासयिता-त्री|रिरासिषिता-त्री|रारासिता-त्री
<ul><li><sup id="ref_krm_1407_01"><a href="#foot_krm_1407_01">1</a></sup> {@“रासृ शब्दे”@} <sup id="ref_krm_1407_02"><a href="#foot_krm_1407_02">2</a></sup> रासकः-सिका, रासकः-सिका, रिरासिषकः-षिका, रारासकः-सिका;</li> <li>  रासिता-त्री, रासयिता-त्री, रिरासिषिता-त्री, रारासिता-त्री;</li> <li>  इत्यादिकानि समस्तान्यपि रूपाणि भौवादिककासतिवत् <sup id="ref_krm_1407_03"><a href="#foot_krm_1407_03">3</a></sup> बोध्यानि। </li> <li>घञि- <sup id="ref_krm_1407_04"><a href="#foot_krm_1407_04">4</a></sup> रासः, <sup id="ref_krm_1407_05"><a href="#foot_krm_1407_05">5</a></sup> रासभः इमे रूपे विशेषेण भवतः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1407_01"><a href="#ref_krm_1407_01">↑</a> (१३९७)</li> <li id="foot_krm_1407_02"><a href="#ref_krm_1407_02">↑</a> (१-भ्वादिः-६२६। अक। सेट्। आत्म।)</li> <li id="foot_krm_1407_03"><a href="#ref_krm_1407_03">↑</a> (१८८)</li> <li id="foot_krm_1407_04"><a href="#ref_krm_1407_04">↑</a> [[४। ‘हलश्च’ (३-३-१२१) इति संज्ञायां घञि रूपमेवम्। रासः = क्रीडाविशेषः।]]</li> <li id="foot_krm_1407_05"><a href="#ref_krm_1407_05">↑</a> [[५। ‘रासिवल्लिभ्यां च’ (द। उ। ७। २१) इति अभच्प्रत्यये रूपमेवम्। अत्र ‘रासृ दीप्तौ’ इति दशपाद्युणादिवृत्तिपाठः।]]</li></ul></p>

रि|रायकः-यिका|रिरीषकः-षिका|रेरीयकः-यिका|रेता-त्री|राययिता-त्री|रिरीषिता-त्री|रेरीयिता-त्री
<ul><li><sup id="ref_krm_1408_01"><a href="#foot_krm_1408_01">1</a></sup> {@“रि हिंसायाम्”@} <sup id="ref_krm_1408_02"><a href="#foot_krm_1408_02">2</a></sup> अयं घातुः क्षीरतरङ्गिण्यां न दृश्यते। </li> <li>रायकः-यिका, रायकः-यिका, रिरीषकः-षिका, रेरीयकः-यिका;</li> <li>  रेता-त्री, राययिता-त्री, रिरीषिता-त्री, रेरीयिता-त्री;</li> <li>  <sup id="ref_krm_1408_03"><a href="#foot_krm_1408_03">3</a></sup> इत्यादिकानि सर्वाण्यपि रूपाणि तौदादिकपियतिवत् <sup id="ref_krm_1408_04"><a href="#foot_krm_1408_04">4</a></sup> ज्ञेयानि। </li> <li>शतरि- <sup id="ref_krm_1408_05"><a href="#foot_krm_1408_05">5</a></sup> रिण्वन्-ती, <sup id="ref_krm_1408_06"><a href="#foot_krm_1408_06">6</a></sup> व्यतिरिण्वन्-ती, इति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1408_01"><a href="#ref_krm_1408_01">↑</a> (१३९८)</li> <li id="foot_krm_1408_02"><a href="#ref_krm_1408_02">↑</a> (५-स्वादिः-१२७५। सक। अनि। पर।)</li> <li id="foot_krm_1408_03"><a href="#ref_krm_1408_03">↑</a> [पृष्ठम्१११६+ २६]</li> <li id="foot_krm_1408_04"><a href="#ref_krm_1408_04">↑</a> (९९१)</li> <li id="foot_krm_1408_05"><a href="#ref_krm_1408_05">↑</a> [[१। अस्य धातोः स्वादित्वात्, श्नुप्रत्यये, णत्वे च रूपमेवम्।]]</li> <li id="foot_krm_1408_06"><a href="#ref_krm_1408_06">↑</a> [[२। ‘न गतिहिंसार्थेभ्यः’ (१-३-८७) इति शानचो निषेधात् कर्मव्यतीहारेऽपि परस्मैपदमेव।]]</li></ul></p>

रि|रायकः-यिका|रिरीषकः-षिका|रेरीयकः-यिका|रेता-त्री|राययिता-त्री|रिरीषिता-त्री|रेरीयिता-त्री
<ul><li><sup id="ref_krm_1409_01"><a href="#foot_krm_1409_01">1</a></sup> {@“रि गतौ”@} <sup id="ref_krm_1409_02"><a href="#foot_krm_1409_02">2</a></sup> रायकः-यिका, रायकः-यिका, रिरीषकः-षिका, रेरीयकः-यिका;</li> <li>  रेता-त्री, राययिता-त्री, रिरीषिता-त्री, रेरीयिता-त्री;</li> <li>  इत्यादिकानि सर्वाण्यपि रूपाणि तौदादिकपियतिवत् <sup id="ref_krm_1409_03"><a href="#foot_krm_1409_03">3</a></sup> ज्ञेयानि। </li> <li>शतरि-रियन् <sup id="ref_krm_1409_04"><a href="#foot_krm_1409_04">4</a></sup> -न्ती-ती, इति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1409_01"><a href="#ref_krm_1409_01">↑</a> (१३९९)</li> <li id="foot_krm_1409_02"><a href="#ref_krm_1409_02">↑</a> (६-तुदादिः-१४०४। सक। अनि। पर।)</li> <li id="foot_krm_1409_03"><a href="#ref_krm_1409_03">↑</a> (९९१)</li> <li id="foot_krm_1409_04"><a href="#ref_krm_1409_04">↑</a> [[आ। ‘व्यापारेऽत्र तदामरानपि रियन्नाशाः पियन्नाधित…।’ धा। का। २-८३।]]</li></ul></p>

रिख|रेखकः-खिका|रिरिखिषकः-रिरेखिषकः-षिका|रेरिखकः-खिका|रेखिता-त्री|रेखयिता-त्री|रिरिखिषिता-रिरेखिषिता-त्री|रेरिखिता-त्री
<ul><li><sup id="ref_krm_1410_01"><a href="#foot_krm_1410_01">1</a></sup> {@“रिख गत्यर्थः”@} <sup id="ref_krm_1410_02"><a href="#foot_krm_1410_02">2</a></sup> ‘द्रमिडास्तु रिख <sup id="ref_krm_1410_03"><a href="#foot_krm_1410_03">3</a></sup> मपि पठन्ति।’ इति मा। </li> <li>धा। </li> <li>वृत्त्यादिषु दर्शनादयं लिख्यते। </li> <li>रेखकः-खिका, रेखकः-खिका, रिरिखिषकः-रिरेखिषकः-षिका, रेरिखकः-खिका;</li> <li>  रेखिता-त्री, रेखयिता-त्री, रिरिखिषिता-रिरेखिषिता-त्री, रेरिखिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाणि भौवादिककिटतिवत् <sup id="ref_krm_1410_04"><a href="#foot_krm_1410_04">4</a></sup> बोध्यानि। </li> <li>रेखा <sup id="ref_krm_1410_05"><a href="#foot_krm_1410_05">5</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1410_01"><a href="#ref_krm_1410_01">↑</a> (१४००)</li> <li id="foot_krm_1410_02"><a href="#ref_krm_1410_02">↑</a> (१-भ्वादिः-१५५। सक। सेट्। पर।)</li> <li id="foot_krm_1410_03"><a href="#ref_krm_1410_03">↑</a> (खि)</li> <li id="foot_krm_1410_04"><a href="#ref_krm_1410_04">↑</a> (१९०)</li> <li id="foot_krm_1410_05"><a href="#ref_krm_1410_05">↑</a> [[३। स्त्रियाम्, भिदादि (३-३-१०४) पाठात् अङि रूपमेवम्।]]</li></ul></p>

रिखि|रिङ्खकः-ङ्खिका|रिङ्खकः-खिका|रिरिङ्खिषकः-षिका|रेरिङ्खकः-ङ्खिका|रिङ्खिता-त्री|रिङ्खयिता-त्री|रिरिङ्खिषिता-त्री|रेरिङ्खिता-त्री
<ul><li><sup id="ref_krm_1411_01"><a href="#foot_krm_1411_01">1</a></sup> {@“रिखि गत्यर्थः”@} <sup id="ref_krm_1411_02"><a href="#foot_krm_1411_02">2</a></sup> ‘द्रमिडानां रिखिरपि। </li> <li>रिङ्खति, रिङ्खणम् = स्खलनम्।’ इति क्षीरतरङ्गिण्यां दर्शनात्, धातुकाव्ये <sup id="ref_krm_1411_03"><a href="#foot_krm_1411_03">3</a></sup> उदाहरणाच्चायं लिख्यते। </li> <li>रिङ्खकः-ङ्खिका, रिङ्खकः-खिका, रिरिङ्खिषकः-षिका, रेरिङ्खकः-ङ्खिका;</li> <li>  रिङ्खिता-त्री, रिङ्खयिता-त्री, रिरिङ्खिषिता-त्री, रेरिङ्खिता-त्री;</li> <li>  इत्यादिकानि सर्वाण्यपि रूपाणि भौवादिककङ्कतिवत् <sup id="ref_krm_1411_04"><a href="#foot_krm_1411_04">4</a></sup> ज्ञेयानि। </li> <li>क्तप्रत्यये-रिङ्खितः <sup id="ref_krm_1411_05"><a href="#foot_krm_1411_05">5</a></sup> इति। </li> <li><sup id="ref_krm_1411_06"><a href="#foot_krm_1411_06">6</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1411_01"><a href="#ref_krm_1411_01">↑</a> (१४०१)</li> <li id="foot_krm_1411_02"><a href="#ref_krm_1411_02">↑</a> (१-भ्वादिः-१५५। सक। सेट्। पर।)</li> <li id="foot_krm_1411_03"><a href="#ref_krm_1411_03">↑</a> (१-१९)</li> <li id="foot_krm_1411_04"><a href="#ref_krm_1411_04">↑</a> (१४०)</li> <li id="foot_krm_1411_05"><a href="#ref_krm_1411_05">↑</a> [[B। ‘रखच्छशं रङ्खितरङ्कु रिङ्खितद्विपं लखत्केसरिलङ्खदारवम्।।’ ध। का। १। १९।]]</li> <li id="foot_krm_1411_06"><a href="#ref_krm_1411_06">↑</a> [पृष्ठम्१११७+ २८]</li></ul></p>

रिगि|रिङ्गकः-ङ्गिका|रिरिङ्गिषकः-षिका|रेरिङ्गकः-ङ्गिका|रिङ्गिता-त्री|रिङ्गयिता-त्री|रिरिङ्गिषिता-त्री|रेरिङ्गिता-त्री|खलि|ईषद्रिङ्गः-दूरिङ्गः-सुरिङ्गः
<ul><li><sup id="ref_krm_1412_01"><a href="#foot_krm_1412_01">1</a></sup> {@“रिगि गत्यर्थः”@} <sup id="ref_krm_1412_02"><a href="#foot_krm_1412_02">2</a></sup> रिङ्गकः-ङ्गिका, रिङ्गकः-ङ्गिका, रिरिङ्गिषकः-षिका, रेरिङ्गकः-ङ्गिका;</li> <li>  रिङ्गिता-त्री, रिङ्गयिता-त्री, रिरिङ्गिषिता-त्री, रेरिङ्गिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाणि भौवादिककङ्कतिवत् <sup id="ref_krm_1412_03"><a href="#foot_krm_1412_03">3</a></sup> ज्ञेयानि। </li> <li>खलि ईषद्रिङ्गः-दूरिङ्गः-सुरिङ्गः;</li> <li>  शतरि-रिङ्गन्-न्ती इति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1412_01"><a href="#ref_krm_1412_01">↑</a> (१४०२)</li> <li id="foot_krm_1412_02"><a href="#ref_krm_1412_02">↑</a> (१-भ्वादिः-१५४। सक। सेट्। पर।)</li> <li id="foot_krm_1412_03"><a href="#ref_krm_1412_03">↑</a> (१४०)</li></ul></p>

रिच|रेचकः-चिका|रिरेचयिषकः-षिका|रिरिक्षकः-क्षिका|रेरिचकः-चिका|रेचयिता-त्री|रिरेचयिषिता-त्री|रेचिता-त्री|रिरिक्षिता-त्री|रेरिचिता-त्री
<ul><li><sup id="ref_krm_1413_01"><a href="#foot_krm_1413_01">1</a></sup> {@“रिच वियोजनसंपर्चनयोः”@} <sup id="ref_krm_1413_02"><a href="#foot_krm_1413_02">2</a></sup> आधृषीयः। </li> <li>‘-- वियोजनसंयमनयोः इति मुकुटः’ इति अमरसुधा <sup id="ref_krm_1413_03"><a href="#foot_krm_1413_03">3</a></sup>। </li> <li>सम्पर्चनम् = मिश्रीकरणम्। </li> <li>अभिधानवैचित्र्यात् धातोरस्य परस्परविरुद्धार्थकत्वम्। </li> <li>‘रिचिर् विरेचने रिङ्क्ते रिणक्ति श्ने, वियोजने। </li> <li>सम्पर्चने च यौ वा णौ रेचयत्यपि रेचति।।’ <sup id="ref_krm_1413_04"><a href="#foot_krm_1413_04">4</a></sup> इति देवः। </li> <li>रेचकः-चिका, रिरेचयिषकः-षिका, रेचकः-चिका, रिरिक्षकः-क्षिका, रेरिचकः-चिका;</li> <li>  रेचयिता-त्री, रिरेचयिषिता-त्री, रेचिता-त्री, रिरिक्षिता-त्री, रेरिचिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकचर्पयतिवत् <sup id="ref_krm_1413_05"><a href="#foot_krm_1413_05">5</a></sup> बोध्यानि। </li> <li>आधृषीयत्वादस्य णिज्विकल्पः। </li> <li>णिजभावपक्षे ‘पचिं वचिं विचिरिचि- रञ्जिपृच्छतीन्--’ <sup id="ref_krm_1413_06"><a href="#foot_krm_1413_06">6</a></sup> इत्यनिट्कारिकासु पाठा- दनिट्त्वं बोध्यम्। </li> <li>अत्र ‘रिचि--’ इति रौधादिकस्य, चुरादिषु पठितस्य णिजभावपक्षे औत्सर्गिकशब्विकरणकस्य च सामान्येन ग्रहणम्। </li> <li>णिजभावपक्षे निष्ठायाम्-- <sup id="ref_krm_1413_07"><a href="#foot_krm_1413_07">7</a></sup> विरिक्तः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1413_01"><a href="#ref_krm_1413_01">↑</a> (१४०३)</li> <li id="foot_krm_1413_02"><a href="#ref_krm_1413_02">↑</a> (१०-चुरादिः-१८१७। सक। सेट्। उभ।)</li> <li id="foot_krm_1413_03"><a href="#ref_krm_1413_03">↑</a> (१-१७)</li> <li id="foot_krm_1413_04"><a href="#ref_krm_1413_04">↑</a> (श्लो। ५२)</li> <li id="foot_krm_1413_05"><a href="#ref_krm_1413_05">↑</a> (५५४)</li> <li id="foot_krm_1413_06"><a href="#ref_krm_1413_06">↑</a> (व्याघ्रभूतिकारिका ७-२-१०)</li> <li id="foot_krm_1413_07"><a href="#ref_krm_1413_07">↑</a> [[आ। ‘अजरद्वृषवद् विरिक्तपीडः पुनरभ्येत्य विशिष्टचित्तताऽपि।’ धा। का। ३-४९।]]</li></ul></p>

रिचिर्|रेचकः-चिका|रिरिक्षकः-क्षिका|रेरिचकः-चिका|रेक्ता-रेक्त्री|रेचयिता-त्री|रिरिक्षिता-त्री|रेरिचिता-त्री|रिञ्चन्-ती|रेचयन्-न्ती|रिरिक्षन्-न्ती|-|रेक्ष्यन्-न्ती-ती|रेचयिष्यन्-न्ती-ती|रिरिक्षिष्यन्-न्ती-ती|रिञ्चानः|रेचयमानः|रिरिक्षमाणः|रेरिच्यमानः|रेक्ष्यमाणः|रेचयिष्यमाणः|रिरिक्षिष्यमाणः|रेरिचिष्यमाणः
<ul><li><sup id="ref_krm_1414_01"><a href="#foot_krm_1414_01">1</a></sup> {@“रिचिर् विरेचने”@} <sup id="ref_krm_1414_02"><a href="#foot_krm_1414_02">2</a></sup> ‘विरेचनम् = निःसारणम्।’ इति क्षीरस्वामी। </li> <li>‘रिचिर् विरेचने रिङ्क्ते रिणक्ति श्ने, वियोजने। </li> <li>सम्पर्चने च यौ वा णौ रेचयत्यपि रेचति।।’ <sup id="ref_krm_1414_03"><a href="#foot_krm_1414_03">3</a></sup> इति देवः। </li> <li>रेचकः-चिका, रेचकः-चिका, <sup id="ref_krm_1414_04"><a href="#foot_krm_1414_04">4</a></sup> रिरिक्षकः-क्षिका, रेरिचकः-चिका;</li> <li>  रेक्ता-रेक्त्री, रेचयिता-त्री, रिरिक्षिता-त्री, रेरिचिता-त्री;</li> <li>  <sup id="ref_krm_1414_05"><a href="#foot_krm_1414_05">5</a></sup> <sup id="ref_krm_1414_06"><a href="#foot_krm_1414_06">6</a></sup> रिञ्चन् <sup id="ref_krm_1414_07"><a href="#foot_krm_1414_07">7</a></sup> -ती, रेचयन्-न्ती, रिरिक्षन्-न्ती;</li> <li>  -- रेक्ष्यन्-न्ती-ती, रेचयिष्यन्-न्ती-ती, रिरिक्षिष्यन्-न्ती-ती;</li> <li>  -- रिञ्चानः, रेचयमानः, रिरिक्षमाणः, रेरिच्यमानः;</li> <li>  रेक्ष्यमाणः, रेचयिष्यमाणः, रिरिक्षिष्यमाणः, रेरिचिष्यमाणः;</li> <li>  <sup id="ref_krm_1414_08"><a href="#foot_krm_1414_08">8</a></sup> रेक्यम्, रेकः-अतिरेकः-व्यतिरेकः-उद्रेकः, <sup id="ref_krm_1414_09"><a href="#foot_krm_1414_09">9</a></sup> विरेचनम्, <sup id="ref_krm_1414_10"><a href="#foot_krm_1414_10">10</a></sup> रिक्तः, <sup id="ref_krm_1414_11"><a href="#foot_krm_1414_11">11</a></sup> विरिञ्चः-विरिञ्चिः-विरिचिनः, <sup id="ref_krm_1414_12"><a href="#foot_krm_1414_12">12</a></sup> रिक्थम्, <sup id="ref_krm_1414_13"><a href="#foot_krm_1414_13">13</a></sup> रेक्णः, इत्यादीनि सर्वाण्यपि रूपाणि प्रातिस्विकरूपाणि विना रौधादिकभुनक्तिवत् <sup id="ref_krm_1414_14"><a href="#foot_krm_1414_14">14</a></sup> बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1414_01"><a href="#ref_krm_1414_01">↑</a> (१४०४)</li> <li id="foot_krm_1414_02"><a href="#ref_krm_1414_02">↑</a> (७-रुधादिः-१४४१। अक। अनि। उभ।)</li> <li id="foot_krm_1414_03"><a href="#ref_krm_1414_03">↑</a> (श्लो। ५२)</li> <li id="foot_krm_1414_04"><a href="#ref_krm_1414_04">↑</a> [[१। अनिटकारिकासु (काशिका ७-२-१०) पाठादस्यानिट्त्वम्। ‘इको झल्’ (१-२-९) इति सनः कित्त्वे, ‘चोः कुः’ (८-२-३०) इति कुत्वे षत्वे च रूपम्।]]</li> <li id="foot_krm_1414_05"><a href="#ref_krm_1414_05">↑</a> [पृष्ठम्१११८+ २८]</li> <li id="foot_krm_1414_06"><a href="#ref_krm_1414_06">↑</a> [[१। शतरि, विकरणप्रत्यये श्नमि, ‘श्नसोरल्लोपः’ (६-४-१११) इत्यकारलोपे, नकारस्य अनुस्वारे परसवर्णे च रूपमेवम्।]]</li> <li id="foot_krm_1414_07"><a href="#ref_krm_1414_07">↑</a> [[आ। ‘… प्रच्छिन्नसंशयमतिर्मुदमाशु रिञ्चन्।’ धा। का। ३-१।]]</li> <li id="foot_krm_1414_08"><a href="#ref_krm_1414_08">↑</a> [[२। निष्ठायामनिट्त्वात्, ण्यति घञि च ‘चजोः कु घिण्ण्यतोः’ (७-३-५२) इति कुत्वम्।]]</li> <li id="foot_krm_1414_09"><a href="#ref_krm_1414_09">↑</a> [[३। विरेचनम् = रक्तस्रावरूपो व्याधिविशेषः। ‘रोगाख्यायां ण्वुल् बहुलम्’ (३-३-१०८) इत्यत्र बहुलग्रहणात् व्याधिवाचकत्वेऽपि ल्युडेवात्र।]]</li> <li id="foot_krm_1414_10"><a href="#ref_krm_1414_10">↑</a> [[४। ‘क्तिच्क्तौ च संज्ञायाम्’ (३-३-१७४) इति संज्ञायां कर्तरि क्तप्रत्ययः। रिक्तः = निर्धनः।]]</li> <li id="foot_krm_1414_11"><a href="#ref_krm_1414_11">↑</a> [[५। “विरिञ्चः--विरिञ्चिः--विरिचिनः, एते पृषोदरादयः (६-३-१०९)।” इति मा। धा। वृत्तिः।]]</li> <li id="foot_krm_1414_12"><a href="#ref_krm_1414_12">↑</a> [[६। ‘पातॄतुदिवचिरिचि--’ (द। उ। ६। ३२) इति थक्प्रत्ययः। कित्त्वान्न गुणः। रिच्यते तदिति रिक्थम् = गृहमूलधनम्। गोत्रजद्रव्यमिति केचित्।]]</li> <li id="foot_krm_1414_13"><a href="#ref_krm_1414_13">↑</a> [[७। ‘रिचेर्धने घिच्च’ (द। उ। ९। ५९) इति असुन्प्रत्ययः। घित्त्वात् कुत्वम्। रेक्णः = धनम्। ‘रेकः--’ इति दशपाद्युणादिवृत्तौ पूर्वसूत्रान्नुममनुवर्त्यो- दाहृतं दृश्यते। तत्तु तत्त्वबोधिन्यादिषु खण्डितम्।]]</li> <li id="foot_krm_1414_14"><a href="#ref_krm_1414_14">↑</a> (११६२)</li></ul></p>

रिफ|रेफकः-फिका|रिरेफिषकः-रिरिफिषकः-षिका|रेरिफकः-फिका|रेफिता-त्री|रेफयिता-त्री|रिरेफिषिता-रिरिफिषिता-त्री|रेरिफिता-त्री
<ul><li><sup id="ref_krm_1415_01"><a href="#foot_krm_1415_01">1</a></sup> {@“रिफ कत्थनयुद्धनिन्दाहिंसादानेषु”@} <sup id="ref_krm_1415_02"><a href="#foot_krm_1415_02">2</a></sup> ‘ऋफ--’ इति क्षीरस्वामी। </li> <li>“… ‘रिह इति द्रमिडाः--इति स्वामी। </li> <li>अनिट्कारिकासु <sup id="ref_krm_1415_03"><a href="#foot_krm_1415_03">3</a></sup> वामनश्च-- ‘रिहिलुही धातुषु न पठ्येते। </li> <li>कैश्चिदभ्युपगम्येते’ इति। </li> <li>अत्र न्यासे-- ‘कैश्चिदिति। </li> <li>आपिशलिप्रभृतिभिः।’ इति। </li> <li>तस्मात् तावपि स्त एव। </li> <li>प्रयुज्यते च -- ‘शिशुं न विप्रा मतिभी रिहन्ति।’ इति।” इति माधवधातुवृत्तिः। </li> <li>अत्रोपात्तः स्वामी न क्षीरस्वामी, अपितु अन्य इति ज्ञेयम्। </li> <li><sup id="ref_krm_1415_04"><a href="#foot_krm_1415_04">4</a></sup> रेफकः-फिका, रेफकः-फिका, रिरेफिषकः-रिरिफिषकः-षिका, रेरिफकः-फिका;</li> <li>  रेफिता-त्री, रेफयिता-त्री, रिरेफिषिता-रिरिफिषिता-त्री, रेरिफिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि तौदादिककिलतिवत् <sup id="ref_krm_1415_05"><a href="#foot_krm_1415_05">5</a></sup> बोद्ध्यानि। </li> <li><sup id="ref_krm_1415_06"><a href="#foot_krm_1415_06">6</a></sup> रेफित्वा। </li> <li><sup id="ref_krm_1415_07"><a href="#foot_krm_1415_07">7</a></sup> रेफः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1415_01"><a href="#ref_krm_1415_01">↑</a> (१४०५)</li> <li id="foot_krm_1415_02"><a href="#ref_krm_1415_02">↑</a> (६-तुदादिः-१३०६। सक। सेट्। पर।)</li> <li id="foot_krm_1415_03"><a href="#ref_krm_1415_03">↑</a> (काशिका ७-२-१०)</li> <li id="foot_krm_1415_04"><a href="#ref_krm_1415_04">↑</a> [पृष्ठम्१११९+ २६]</li> <li id="foot_krm_1415_05"><a href="#ref_krm_1415_05">↑</a> (१९३)</li> <li id="foot_krm_1415_06"><a href="#ref_krm_1415_06">↑</a> [[१। अत्र, ‘न क्त्वा सेट्’ (१-२-१८) इति कित्त्वनिषेधात् रूपमेकमेवेति माधवधातु- वृत्तिः। ‘रलो व्युपधात् हलादेः संश्च’ (१-२-२६) इति कित्त्वविकल्पे तु रिफित्वा रेफित्वा इति रूपद्वयं भवेत्, तत्तु ‘नोपधात् थफान्ताद् वा’ (१-२-२३) इत्यत्र नोपधादेवेति नियमाश्रयणात् नेति माधवाशयः। वस्तुतस्तु ‘प्रकल्प्य चापवाद- विषयं तत उत्सर्गोऽभिनिविशते’ (परि। ६४) इति न्यायेन इकारोकारोपधधातुषु विषये परत्वात् अपवादत्वाच्च ‘रलो व्युपधात्--’ (१-२-२६) इत्यस्य प्रवृत्तेरनिवार्य- तया, रिफित्वा इति पाक्षिकरूपस्य सिद्ध्यर्थं च सन्नन्ते इव कित्त्वविकल्प एव न्याय्यः। नियमाश्रयणे च न किञ्चिद् बीजं दृश्यते। विस्तरस्त्वन्यश्रेत्यत्रालम्।]]</li> <li id="foot_krm_1415_07"><a href="#ref_krm_1415_07">↑</a> [[२। ‘हलश्च’ (३-३-१२१) इति संज्ञायां घञ्। रेफः = अधमः। धात्वर्थोऽत्र निन्दा।]]</li></ul></p>

रिवि|रिण्वकः-रिण्विका|रिण्वकः-ण्विका|रिरिण्विषकः-षिका|रेरिण्वकः-ण्विका|रिण्विता-त्री|रिण्वयिता-त्री|रिरिण्विषिता-त्री|रेरिण्विता-त्री
<ul><li><sup id="ref_krm_1416_01"><a href="#foot_krm_1416_01">1</a></sup> {@“रिवि गत्यर्थः”@} <sup id="ref_krm_1416_02"><a href="#foot_krm_1416_02">2</a></sup> रिण्वकः-रिण्विका, रिण्वकः-ण्विका, रिरिण्विषकः-षिका, रेरिण्वकः-ण्विका;</li> <li>  रिण्विता-त्री, रिण्वयिता-त्री, रिरिण्विषिता-त्री, रेरिण्विता-त्री;</li> <li>  इत्यादीनि तर्वाण्यपि रूपाणि भौवादिकजिन्वतिवत् <sup id="ref_krm_1416_03"><a href="#foot_krm_1416_03">3</a></sup> बोध्यानि। </li> <li>ल्युटि <sup id="ref_krm_1416_04"><a href="#foot_krm_1416_04">4</a></sup> रिण्वनम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1416_01"><a href="#ref_krm_1416_01">↑</a> (१४०६)</li> <li id="foot_krm_1416_02"><a href="#ref_krm_1416_02">↑</a> (१-भ्वादिः-५९५। सक। सेट्। पर।)</li> <li id="foot_krm_1416_03"><a href="#ref_krm_1416_03">↑</a> (६०४)</li> <li id="foot_krm_1416_04"><a href="#ref_krm_1416_04">↑</a> [[आ। ‘जिन्वन्तमुर्वीं निजरिण्वनैः सतां रण्वन्तमन्तर्भवधन्वपादपम्।’ धा। का। १। ७६।]]</li></ul></p>

रिश|रेशकः-शिका|रिरिक्षकः-क्षिका|रेरिशकः-शिका|रेष्टा-रेष्ट्री|रेशयिता-त्री|रिरिक्षिता-त्री|रेरिशिता-त्री
<ul><li><sup id="ref_krm_1417_01"><a href="#foot_krm_1417_01">1</a></sup> {@“रिश हिंसायाम्”@} <sup id="ref_krm_1417_02"><a href="#foot_krm_1417_02">2</a></sup> ‘--रिंशि रुशिं क्रोशतिमष्टमं विशिम्।’ <sup id="ref_krm_1417_03"><a href="#foot_krm_1417_03">3</a></sup> इति वचनाद् धातुरयमनिट्। </li> <li><sup id="ref_krm_1417_04"><a href="#foot_krm_1417_04">4</a></sup> रेशकः-शिका, रेशकः-शिका, रिरिक्षकः-क्षिका, रेरिशकः-शिका;</li> <li>  रेष्टा-रेष्ट्री, रेशयिता-त्री, रिरिक्षिता-त्री, रेरिशिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि दैवादिकखिद्यतिवत् <sup id="ref_krm_1417_05"><a href="#foot_krm_1417_05">5</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1417_01"><a href="#ref_krm_1417_01">↑</a> (१४०७)</li> <li id="foot_krm_1417_02"><a href="#ref_krm_1417_02">↑</a> (६-तुदादिः-१४२०। सक। अनि। पर।)</li> <li id="foot_krm_1417_03"><a href="#ref_krm_1417_03">↑</a> (व्याघ्रमूतिकारिका ७-२-१०)</li> <li id="foot_krm_1417_04"><a href="#ref_krm_1417_04">↑</a> [[B। ‘रोषच्छुप्तधियाऽथ रोष्टुमभितो योधान् द्विषद्रेशकान्--’ धा। का। ३-८३।]]</li> <li id="foot_krm_1417_05"><a href="#ref_krm_1417_05">↑</a> (३४९)</li></ul></p>

