<ul><li><sup id="ref_krm_0694_01"><a href="#foot_krm_0694_01">1</a></sup> {@“णुद प्रेरणे”@} <sup id="ref_krm_0694_02"><a href="#foot_krm_0694_02">2</a></sup> नोदकः-दिका, नोदकः-दिका, <sup id="ref_krm_0694_03"><a href="#foot_krm_0694_03">3</a></sup> नुनुत्सकः-त्सिका, नोनुदकः-दिका;</li> <li>  <sup id="ref_krm_0694_04"><a href="#foot_krm_0694_04">4</a></sup> नोत्ता-त्री, नोदयिता-त्री, नुनुत्सिता-त्री, नोनुदिता-त्री;</li> <li>  <sup id="ref_krm_0694_05"><a href="#foot_krm_0694_05">5</a></sup> <sup id="ref_krm_0694_06"><a href="#foot_krm_0694_06">6</a></sup> नुदन् ती-न्ती, नोदयन्-न्ती, नुनुत्सन्-न्ती;</li> <li>  -- नोत्स्यन्-न्ती-ती, नोदयिष्यन्-न्ती-ती, नुनुत्सिष्यन्-न्ती-ती;</li> <li>  -- नुदमानः, <sup id="ref_krm_0694_07"><a href="#foot_krm_0694_07">7</a></sup> प्रणुदमानः, नोदयमानः, नुनुत्समानः, नोनुद्यमानः;</li> <li>  नोत्स्यमानः, नोदयिष्यमाणः, नुनुत्सिष्यमाणः, नोनुदिष्यमाणः;</li> <li>  अपनुत्-अपनुद्-अपनुदौ-अपनुदः;</li> <li>  -- -- <sup id="ref_krm_0694_08"><a href="#foot_krm_0694_08">8</a></sup> नुन्नः-नुत्तः- <sup id="ref_krm_0694_09"><a href="#foot_krm_0694_09">9</a></sup> प्रणुन्नम्-नुत्तम्-नुन्नम्-नुन्नवान्-नुत्तवान्, नोदितः, नुनुत्सितः, नोनुदितः-तवान्;</li> <li>  <sup id="ref_krm_0694_10"><a href="#foot_krm_0694_10">10</a></sup> नुदः, <sup id="ref_krm_0694_11"><a href="#foot_krm_0694_11">11</a></sup> शोकापनुदः, <sup id="ref_krm_0694_12"><a href="#foot_krm_0694_12">12</a></sup> <sup id="ref_krm_0694_13"><a href="#foot_krm_0694_13">13</a></sup> शोकापनोदः, विनोदी, नोदः, <sup id="ref_krm_0694_14"><a href="#foot_krm_0694_14">14</a></sup> नुनुत्सुः, नोनुदः;</li> <li>  नोत्तव्यम्, नोदयितव्यम्, नुनुत्सितव्यम्, नोनुदितव्यम्;</li> <li>  नोदनीयम्, नोदनीयम्, नुनुत्सनीयम्, नोनुदनीयम्;</li> <li>  नोद्यम्, नोद्यम्, नुनुत्स्यम्, नोनुद्यम्;</li> <li>  ईषन्नोदः-दुर्नोदः-सुनोदः;</li> <li>  -- -- नुद्यमानः, नोद्यमानः, नुनुत्स्यमानः, नोनुद्यमानः;</li> <li>  नोदः-विनोदः, <sup id="ref_krm_0694_15"><a href="#foot_krm_0694_15">15</a></sup> काकुदः <sup id="ref_krm_0694_16"><a href="#foot_krm_0694_16">16</a></sup>, नुनुत्सः, नोनुदः;</li> <li>  <sup id="ref_krm_0694_17"><a href="#foot_krm_0694_17">17</a></sup> नोत्तुम्, नोदयितुम्, नुनुत्सितुम्, नोनुदितुम्;</li> <li>  नुत्तिः, नोदना, नुनुत्सा, नोनुदा;</li> <li>  नोदनम्, नोदनम्, नुनुत्सनम्, नोनुदनम्;</li> <li>  नुत्त्वा, नोदयित्वा, नुनुत्सित्वा, नोनुदित्वा;</li> <li>  प्रणुद्य, प्रणोद्य, प्रणुनुत्स्य, प्रणोनुद्य;</li> <li>  नोदम् २, नुत्त्वा २, नोदम् २, नोदयित्वा २, नुनुत्सम् २, नुनुत्सित्वा २, नोनुदम् २;</li> <li>  नोनुदित्वा २;</li> <li>  <sup id="ref_krm_0694_18"><a href="#foot_krm_0694_18">18</a></sup> इति डौप्रत्ययः। </li> <li>टिलोपः। </li> <li>नुदति, नुद्यते घा नौः = प्लवः।]] नौः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0694_01"><a href="#ref_krm_0694_01">↑</a> (६८४)</li> <li id="foot_krm_0694_02"><a href="#ref_krm_0694_02">↑</a> (६-तुदादिः-१२८२। सक। अनि। उभ।)</li> <li id="foot_krm_0694_03"><a href="#ref_krm_0694_03">↑</a> [[४। धातोरनुदात्तत्वेनेडभावे, ‘हलन्ताच्च’ (१-२-१०) इति सनः कित्त्वे, लघूपधगुणो न। एवं सन्नन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0694_04"><a href="#ref_krm_0694_04">↑</a> [[५। ‘एकाच उपदेशेऽनुदात्तात्’ (७-२-१०) इति इण्णिषेधे, ‘पुगन्तलघूपधस्य च’ (७-३-८६) इति गुणः। एवं तव्यदादिष्वपि ज्ञेयम्।]]</li> <li id="foot_krm_0694_05"><a href="#ref_krm_0694_05">↑</a> [पृष्ठम्०६३४+ २७]</li> <li id="foot_krm_0694_06"><a href="#ref_krm_0694_06">↑</a> [[१। ‘तुदादिभ्यः--’ (३-१-७७) शः विकरणप्रत्ययः। शस्य ङिद्वद्भावादङ्गस्य गुणो न। स्त्रियाम्, ‘आच्छीनद्योर्नुम्’ (७-१-८०) इति नुम् वा।]]</li> <li id="foot_krm_0694_07"><a href="#ref_krm_0694_07">↑</a> [[आ। ‘तुदन् कुचरितान् शुमे प्रणुदमान इष्टं दिशन् प्रमृष्टपललान् क्षिपन् अरिमतिं कृषन् माधवः।’ धा। का। २। ७२।]]</li> <li id="foot_krm_0694_08"><a href="#ref_krm_0694_08">↑</a> [[२। ‘नुदविदोन्दत्राघ्राह्रीभ्योऽन्यतरस्याम्’ (८-२-५६) इत्यनेन निष्ठातकारस्य धातुदकारस्य च नत्वविकल्पः तेन रूपद्वयम्।]]</li> <li id="foot_krm_0694_09"><a href="#ref_krm_0694_09">↑</a> [[B। ‘दयितावलोकविकसन्नयनप्रसरप्रणुन्नमिव वारिरुहम्।।’ शि। व। ९। ७१।]]</li> <li id="foot_krm_0694_10"><a href="#ref_krm_0694_10">↑</a> [[३। ‘इगुपध--’ (३-१-१३५) इति कर्तरि कप्रत्ययः।]]</li> <li id="foot_krm_0694_11"><a href="#ref_krm_0694_11">↑</a> [[४। ‘तुन्दशोकयोः परिमृजापनुदोः’ (३-२-५) इत्यत्र ‘आलस्य सुखाहरणयोरिति वक्तव्यम्’ (वा। ३-२-५) इति वचनात् शोकनिवृत्तिपूर्वकं सुखसम्पादके पुत्रादौ शोकापनुद इति कप्रत्ययो भवति। कर्मण्यणोऽपवादः।]]</li> <li id="foot_krm_0694_12"><a href="#ref_krm_0694_12">↑</a> [[C। ‘पौरा निवर्तध्वमिति न्यगादीत् तातस्य शोकापनुदा भवेत।’ भ। का। ३। १५।]]</li> <li id="foot_krm_0694_13"><a href="#ref_krm_0694_13">↑</a> [[५। केवलं शोकमात्रं यः अपनुदति, न तु सुखस्याहर्ता, तत्र ‘कर्मण्यण्’ (३-२-१) इत्यणेव।]]</li> <li id="foot_krm_0694_14"><a href="#ref_krm_0694_14">↑</a> [[ड्। ‘यदवादिषमप्रियं तव प्रियमाधाय नुनुत्सुरस्मि तत्।’ नैषधे-- २। ११।]]</li> <li id="foot_krm_0694_15"><a href="#ref_krm_0694_15">↑</a> [[६। काकुः = जिह्वा। सा अस्मिन् नुद्यते इति काकुदम् = तालु। घञर्थे कविधानम्। पृषोदरादित्वात्-- (६-३-१०९) नुशब्दस्य{??} लोपः।]]</li> <li id="foot_krm_0694_16"><a href="#ref_krm_0694_16">↑</a> [तालु]</li> <li id="foot_krm_0694_17"><a href="#ref_krm_0694_17">↑</a> [पृष्ठम्०६३५+ २८]</li> <li id="foot_krm_0694_18"><a href="#ref_krm_0694_18">↑</a> [[१। ‘ग्लानुदिभ्यां डौः’ [द। उ। २-१२]</li></ul></p>

णुद|नोदकः-दिका|नुनुत्सकः-त्सिका|नोनुदकः-दिका
<ul><li><sup id="ref_krm_0695_01"><a href="#foot_krm_0695_01">1</a></sup> {@“णुद प्रेरणे”@} <sup id="ref_krm_0695_02"><a href="#foot_krm_0695_02">2</a></sup> नोदकः-दिका, नोदकः-दिका, नुनुत्सकः-त्सिका, नोनुदकः-दिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि पूर्वलिखिततौदादिकनुदतिवत् <sup id="ref_krm_0695_03"><a href="#foot_krm_0695_03">3</a></sup> ज्ञेयानि। </li> <li>अस्य घातोः परस्मैपदिषु पाठात् शानच्प्रत्ययो न भवति। </li> <li>तुदादावेव पुनः पाठफलं तु--कर्तृगामिन्यपि क्रियाफले परस्मैपदित्वमिति बोध्यम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0695_01"><a href="#ref_krm_0695_01">↑</a> (६८५)</li> <li id="foot_krm_0695_02"><a href="#ref_krm_0695_02">↑</a> (६-तुदादिः-१४२६। सक। अनि। पर।)</li> <li id="foot_krm_0695_03"><a href="#ref_krm_0695_03">↑</a> (६८४)</li></ul></p>

णू|ण्यन्तात्|सन्नन्तात्|यङन्ताच्च|क्रमेण|नावकः-विका|नुनूषकः|षिका|नोनूयकः-यिका
<ul><li><sup id="ref_krm_0696_01"><a href="#foot_krm_0696_01">1</a></sup> {@“णू स्तवने”@} <sup id="ref_krm_0696_02"><a href="#foot_krm_0696_02">2</a></sup> कुटादिः। </li> <li>‘--स्तुत्यां नुवति, नौति वा।।’ <sup id="ref_krm_0696_03"><a href="#foot_krm_0696_03">3</a></sup> इति देवः। </li> <li>नावकः-विका, <sup id="ref_krm_0696_04"><a href="#foot_krm_0696_04">4</a></sup> नुविता-त्री, नुवन्-ती-न्ती, नुविष्यन्-न्ती-ती, प्रणूः, <sup id="ref_krm_0696_05"><a href="#foot_krm_0696_05">5</a></sup> प्रण्वौ-प्रण्वः, <sup id="ref_krm_0696_06"><a href="#foot_krm_0696_06">6</a></sup> नूतम्-नूतः-नूतवान्, नुवः, नुवितव्यम्, नुवनीयम्, नव्यम्, <sup id="ref_krm_0696_07"><a href="#foot_krm_0696_07">7</a></sup> अवश्यनाव्यम्, ईषन्नुवः-दुर्नुवः-सुनुवः, नूयमानः, नुवः-नुवितुम्, <sup id="ref_krm_0696_08"><a href="#foot_krm_0696_08">8</a></sup> <sup id="ref_krm_0696_09"><a href="#foot_krm_0696_09">9</a></sup> नूतिः, नुवनम्, नूत्वा, प्रणूय, नावम् २ नूत्वा २ इति शुद्धाद्धातो रूपाणि। </li> <li>ण्यन्तात्, सन्नन्तात् यङन्ताच्च क्रमेण नावकः-विका, नुनूषकः, षिका, नोनूयकः-यिका;</li> <li>  इत्यादीनि रूपाणि आदादिकनौतिवत् <sup id="ref_krm_0696_10"><a href="#foot_krm_0696_10">10</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0696_01"><a href="#ref_krm_0696_01">↑</a> (६८६)</li> <li id="foot_krm_0696_02"><a href="#ref_krm_0696_02">↑</a> (६-तुदादिः-१३९७। सक। सेट्। पर।)</li> <li id="foot_krm_0696_03"><a href="#ref_krm_0696_03">↑</a> (श्लो। २४)</li> <li id="foot_krm_0696_04"><a href="#ref_krm_0696_04">↑</a> [[२। अस्य धातोः कुटादिषु पाठात् ‘गाङ्कुटादिभ्यः--’ (१-२-१) इति ञित्णिद्- भिन्नानां प्रत्ययानां ङिद्वद्भावातिदेशात् ‘क्ङिति च’ (१-१-५) इति गुणनिषेधे, उवङादेशे च नुविता नुविष्यन् इत्यादीनि रूपाणि बोध्यानि।]]</li> <li id="foot_krm_0696_05"><a href="#ref_krm_0696_05">↑</a> [[३। क्विबन्ते द्विवचनादौ ‘उपसर्गादसमासेऽपि--’ (८-४-१४) इति णत्वे, ‘ओः सुपि’ (६-४-८३) इति यण्।]]</li> <li id="foot_krm_0696_06"><a href="#ref_krm_0696_06">↑</a> [[४। अस्य कुटादित्वात् विशेषविहितेन ङिद्वद्भावेन क्तप्रत्ययस्य कित्त्वं बाध्यते। अतश्च ‘श्र्युकः क्किति’ (७-२-११) इति निषेधाप्रवृत्त्या इडागमे ‘नुवितः-तवान्’ इति केचिद्वदन्ति। तत्तु न समीचीनम्। अत एव ‘गाड्कुटादिम्यः--’ (१-२-१) इति सूत्रे भाष्ये--‘तस्मात् नूत्वा धूत्वा इत्येव भवितव्यम्।’ इत्युक्तिः सङ्गच्छते।]]</li> <li id="foot_krm_0696_07"><a href="#ref_krm_0696_07">↑</a> [[५। ‘ओरावश्यके’ (३-१-१२५) इति ण्यत्। आवादेशः।]]</li> <li id="foot_krm_0696_08"><a href="#ref_krm_0696_08">↑</a> [पृष्ठम्०६३६+ २४]</li> <li id="foot_krm_0696_09"><a href="#ref_krm_0696_09">↑</a> [[आ। ‘नूत्या किं भयधूतविद्रुतगुवल्लोकं तदा तद्ध्रुवत् कोदण्डं कुवमानमैक्षि दलितं भोजेश्वराकूतवत्।।’ धा। का। २। ८२।]]</li> <li id="foot_krm_0696_10"><a href="#ref_krm_0696_10">↑</a> (६८३)</li></ul></p>

णेदृ|प्रणेदकः-दिका|नेदकः-दिका|निनेदिषकः-षिका|नेनेदकः-दिका
<ul><li><sup id="ref_krm_0697_01"><a href="#foot_krm_0697_01">1</a></sup> {@“णेदृ कुत्सासन्निकर्षयोः”@} <sup id="ref_krm_0697_02"><a href="#foot_krm_0697_02">2</a></sup> ‘प्रत्येकं निदिनेद्योः स्तां नेदते नेदतीत्युभे। </li> <li>कुत्सायां सन्निकर्षे वा, कुत्सामात्रे तु निन्दति।।’ <sup id="ref_krm_0697_03"><a href="#foot_krm_0697_03">3</a></sup> इति देवः। </li> <li>प्रणेदकः-दिका, नेदकः-दिका, निनेदिषकः-षिका, नेनेदकः-दिका;</li> <li>  <sup id="ref_krm_0697_04"><a href="#foot_krm_0697_04">4</a></sup> नेदितः इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककेपतिवत् <sup id="ref_krm_0697_05"><a href="#foot_krm_0697_05">5</a></sup> ज्ञेयानि। </li> <li>अस्य धातोः उभयपदित्वात् नेदन्-न्ती नेदिष्यन्-न्ती-ती, इत्यादीनि रूपा- ण्यधिकानि इति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0697_01"><a href="#ref_krm_0697_01">↑</a> (६८७)</li> <li id="foot_krm_0697_02"><a href="#ref_krm_0697_02">↑</a> (१-भ्वादिः-८७२। सक। सेट्। उभ।)</li> <li id="foot_krm_0697_03"><a href="#ref_krm_0697_03">↑</a> (श्लो। ११४)</li> <li id="foot_krm_0697_04"><a href="#ref_krm_0697_04">↑</a> [[B। ‘या नेदितोर्वीपरिशर्धिवीचीविमृद्धवृक्षादिविबोध्यशैत्या।।’ धा। का। २। २६।]]</li> <li id="foot_krm_0697_05"><a href="#ref_krm_0697_05">↑</a> (२६१)</li></ul></p>

णेषृ|प्रणेषकः-षिका|नेषकः-षिका|निनेषिषकः-षिका|नेनेषकः-षिका
<ul><li><sup id="ref_krm_0698_01"><a href="#foot_krm_0698_01">1</a></sup> {@“णेषृ गतौ”@} <sup id="ref_krm_0698_02"><a href="#foot_krm_0698_02">2</a></sup> प्रणेषकः-षिका, नेषकः-षिका, निनेषिषकः-षिका, नेनेषकः-षिका;</li> <li>  <sup id="ref_krm_0698_03"><a href="#foot_krm_0698_03">3</a></sup> नेषितः इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककेपतिवत् <sup id="ref_krm_0698_04"><a href="#foot_krm_0698_04">4</a></sup> ज्ञेयानि। </li> <li>क्विपि प्रणेट्-प्रणेड्-प्रणेषौ-प्रणेषः इति रूपाण्यस्येति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0698_01"><a href="#ref_krm_0698_01">↑</a> (६८८)</li> <li id="foot_krm_0698_02"><a href="#ref_krm_0698_02">↑</a> (१-भ्वादिः-६१७। सक। सेट्। आत्म।)</li> <li id="foot_krm_0698_03"><a href="#ref_krm_0698_03">↑</a> [[C। ‘येषणाप्तहरिजेषसंभ्रमान्नेषितस्मृतिरपेषितो रथात्।।’ धा। का। १। ७८।]]</li> <li id="foot_krm_0698_04"><a href="#ref_krm_0698_04">↑</a> (२६१)</li></ul></p>

तक|ताककः-किका|तितकिषकः-षिका|तातककः-किका|अस्य|धातोः|परस्मैपदित्वात्|तकन्-न्ती|तकिष्यन्-न्ती-ती|तितकिषन्-न्ती-ती|तितकिषिष्यन्-न्ती-ती
<ul><li><sup id="ref_krm_0699_01"><a href="#foot_krm_0699_01">1</a></sup> {@“तक हसने”@} <sup id="ref_krm_0699_02"><a href="#foot_krm_0699_02">2</a></sup> ‘तकेत् तङ्केद् यथासंख्यं हसने कृच्छ्रजीवने।।’ <sup id="ref_krm_0699_03"><a href="#foot_krm_0699_03">3</a></sup> इति देवः। </li> <li>ताककः-किका, ताककः-किका, तितकिषकः-षिका, तातककः-किका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकककतिवत् <sup id="ref_krm_0699_04"><a href="#foot_krm_0699_04">4</a></sup> ज्ञेयानि। </li> <li>अस्य धातोः परस्मैपदित्वात् तकन्-न्ती, तकिष्यन्-न्ती-ती, तितकिषन्-न्ती-ती, तितकिषिष्यन्-न्ती-ती;</li> <li>  इति शतरि रूपाणि भवन्तीति विशेषः। </li> <li><sup id="ref_krm_0699_05"><a href="#foot_krm_0699_05">5</a></sup> तक्यम्, <sup id="ref_krm_0699_06"><a href="#foot_krm_0699_06">6</a></sup> व्यतितकन्-न्ती। </li> <li><sup id="ref_krm_0699_07"><a href="#foot_krm_0699_07">7</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0699_01"><a href="#ref_krm_0699_01">↑</a> (६८९)</li> <li id="foot_krm_0699_02"><a href="#ref_krm_0699_02">↑</a> (१-भ्वादिः-११७। अक। सेट्। पर।)</li> <li id="foot_krm_0699_03"><a href="#ref_krm_0699_03">↑</a> (श्लो। ४३)</li> <li id="foot_krm_0699_04"><a href="#ref_krm_0699_04">↑</a> (१३९)</li> <li id="foot_krm_0699_05"><a href="#ref_krm_0699_05">↑</a> [[१। ‘तकिशसिजनिभ्यो यद्वाच्यः’ (वा। ३-१-९७) इति ण्यदपवादो यत्प्रत्ययः।]]</li> <li id="foot_krm_0699_06"><a href="#ref_krm_0699_06">↑</a> [[२। ‘प्रतिषेधे हसादीनामुपसंख्यानम्’ (वा। १-३-१५) इति वचनात् कर्मव्यतीहारेऽपि शानज् न। हसादयः = हसनाद्यर्थकाः धातवः।]]</li> <li id="foot_krm_0699_07"><a href="#ref_krm_0699_07">↑</a> [पृष्ठम्०६३७+ २७]</li></ul></p>

तकि|तङ्ककः-ङ्किका|तितङ्किषकः-षिका|तातङ्ककः-ङ्किका
<ul><li><sup id="ref_krm_0700_01"><a href="#foot_krm_0700_01">1</a></sup> {@“तकि कृच्छ्रजीवने”@} <sup id="ref_krm_0700_02"><a href="#foot_krm_0700_02">2</a></sup> ‘तकेत् तङ्केद् यथासंख्यं हसने, कृच्छ्रजीवने।।’ <sup id="ref_krm_0700_03"><a href="#foot_krm_0700_03">3</a></sup> इति देवः। </li> <li>तङ्ककः-ङ्किका, तङ्ककः-ङ्किका, तितङ्किषकः-षिका, तातङ्ककः-ङ्किका;</li> <li>  <sup id="ref_krm_0700_04"><a href="#foot_krm_0700_04">4</a></sup> तङ्कन्-न्ती, इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककन्दतिवत् <sup id="ref_krm_0700_05"><a href="#foot_krm_0700_05">5</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0700_01"><a href="#ref_krm_0700_01">↑</a> (६९०)</li> <li id="foot_krm_0700_02"><a href="#ref_krm_0700_02">↑</a> (१-भ्वादिः-११८। अक। सेट्। पर।)</li> <li id="foot_krm_0700_03"><a href="#ref_krm_0700_03">↑</a> (श्लो। ४३)</li> <li id="foot_krm_0700_04"><a href="#ref_krm_0700_04">↑</a> [[आ। ‘अकक्कतातक्यगुणेन तङ्कता खलश्वबुक्कापरुषे पुरेऽमुना।’ धा। का। १। १७।]]</li> <li id="foot_krm_0700_05"><a href="#ref_krm_0700_05">↑</a> (१६३)</li></ul></p>

तक्ष|तक्षकः-क्षिका|तितक्षिषकः-षिका|तातक्षकः-क्षिका|तक्षिता-त्री|तक्षयिता-त्री|तितक्षिषिता-त्री|तातक्षिता-त्री|तक्षन्-न्ती|तक्षयन्-न्ती|तितक्षिषन्-न्ती|-|तक्षिष्यन्-न्ती-ती|तक्षयिष्यन्-न्ती-ती|तितक्षिषिष्यन्-न्ती-ती|तक्षयमाणः|तक्षयिष्यमाणः|तातक्ष्यमाणः|तातक्षिष्यमाणः|तट्-तड्-तक्षौ-तक्षः|-तक्षितः-तम्|तक्षितः|तितक्षिषितः|तातक्षितः-तवान्|तक्षः|तितक्षिषुः|तातक्षः|तक्षितव्यम्|तक्षयितव्यम्|तितक्षिषितव्यम्|तातक्षितव्यम्|तक्षणीयम्|तितक्षिषणीयम्|तातक्षणीयम्|तक्ष्यम्|तितक्षिष्यम्|तातक्ष्यम्|ईषत्तक्षः-दुस्तक्षः-सुतक्षः|तक्ष्यमाणः|तितक्षिष्यमाणः|तितक्षिषः|तक्षितुम्|तक्षयितुम्|तितक्षिषितुम्|तातक्षितुम्|तक्षा|तक्षणा|तितक्षिषा|तातक्षा|तक्षणम्|तितक्षिषणम्|तातक्षणम्|तक्षित्वा|तक्षयित्वा|तितक्षिषित्वा|तातक्षित्वा|सन्तक्ष्य|सन्तितक्षिष्य|सन्तातक्ष्य|तक्षम्|तितक्षिषम्|तातक्षम्
<ul><li><sup id="ref_krm_0701_01"><a href="#foot_krm_0701_01">1</a></sup> {@“तक्ष त्वचने”@} <sup id="ref_krm_0701_02"><a href="#foot_krm_0701_02">2</a></sup> <sup id="ref_krm_0701_03"><a href="#foot_krm_0701_03">3</a></sup> इदमिहावधेयम्। </li> <li>‘त्वक्ष त्वचने’ इति क्षीरस्वामिसम्मतः पाठः। </li> <li>न तु ‘तक्ष त्वचने’ इति। </li> <li>अत एव, काशिकावृत्तौ ‘तनूकरणे तक्षः’ <sup id="ref_krm_0701_04"><a href="#foot_krm_0701_04">4</a></sup> इत्यत्र तक्षधातोः तनूकरणेऽर्थे एव पाठात् सिद्धे, ‘तनूकरणे’ इति विशेषणं किमर्थमित्याशङ्क्य, धातूनामनेकार्थत्वेन अर्थान्तरवृत्तेस्तक्षधातोः श्नुप्रत्ययो न भवतीत्युक्तम्। </li> <li>यदि तक्षधातुः त्वचनार्थे प्रामाणिकः स्यात्, त्वचनार्थकतक्ष- धातोर्व्यावर्तनेन ‘तनूकरणे’ इति विशेषणस्य सार्थक्यं वदेत्। </li> <li>तथा, बाल- मनोरमायामपि-- ‘न च तक्षूधातोस्तनूकरणार्थकत्वाव्यभिचारात् श्नुविधौ तनूकरणग्रहणं व्यर्थमिति वाच्यम्--अत एव धातुपाठेऽर्थनिर्देशस्योपलक्षणत्वाव- गमात्।’ इत्युक्तिस्त्वचनार्थकतक्षतेरभावेऽनुकूला भवति। </li> <li>‘सङ्घाते द्वौ म्रक्ष- मृक्ष-त्वचने त्वक्ष कथ्यते।।’ <sup id="ref_krm_0701_05"><a href="#foot_krm_0701_05">5</a></sup> इति धातुपाठकारिकाऽपि ‘त्वक्ष त्वचने’ इति पाठस्यैवानुकूला। </li> <li>सुधियोऽत्र तत्त्वं निर्णयन्तु।]] ‘त्वचनम् = संवरणम्, त्वचो ग्रहणं च’ इति सिद्धान्तकौमुदी। </li> <li>‘ग्रहणमात्रे च’ इति द्रुमे।’ इति धातुकाव्यव्याख्याने <sup id="ref_krm_0701_06"><a href="#foot_krm_0701_06">6</a></sup>। </li> <li>‘स्यात् तक्षतीति त्वचनेऽथ वा श्नौ तक्ष्णोति तक्षेच्च तनूक्रियायाम्।’ <sup id="ref_krm_0701_07"><a href="#foot_krm_0701_07">7</a></sup> इति देवः। </li> <li>तक्षकः-क्षिका, तक्षकः-क्षिका, तितक्षिषकः-षिका, तातक्षकः-क्षिका;</li> <li>  तक्षिता-त्री, तक्षयिता-त्री, तितक्षिषिता-त्री, तातक्षिता-त्री;</li> <li>  तक्षन्-न्ती, तक्षयन्-न्ती, तितक्षिषन्-न्ती;</li> <li>  -- तक्षिष्यन्-न्ती-ती, तक्षयिष्यन्-न्ती-ती, तितक्षिषिष्यन्-न्ती-ती;</li> <li>  -- -- तक्षयमाणः, तक्षयिष्यमाणः, -- तातक्ष्यमाणः, तातक्षिष्यमाणः;</li> <li>  <sup id="ref_krm_0701_08"><a href="#foot_krm_0701_08">8</a></sup> तट्-तड्-तक्षौ-तक्षः;</li> <li>  -- -- -- <sup id="ref_krm_0701_09"><a href="#foot_krm_0701_09">9</a></sup> तक्षितः-तम्, तक्षितः, तितक्षिषितः, तातक्षितः-तवान्;</li> <li>  तक्षः, तक्षः, तितक्षिषुः, तातक्षः;</li> <li>  तक्षितव्यम्, तक्षयितव्यम्, तितक्षिषितव्यम्, तातक्षितव्यम्;</li> <li>  तक्षणीयम्, तक्षणीयम्, तितक्षिषणीयम्, तातक्षणीयम्;</li> <li>  तक्ष्यम्, तक्ष्यम्, तितक्षिष्यम्, तातक्ष्यम्;</li> <li>  ईषत्तक्षः-दुस्तक्षः-सुतक्षः;</li> <li>  -- -- तक्ष्यमाणः, तक्ष्यमाणः, तितक्षिष्यमाणः, तातक्ष्यमाणः;</li> <li>  तक्षः, तक्षः, तितक्षिषः, तातक्षः;</li> <li>  तक्षितुम्, तक्षयितुम्, तितक्षिषितुम्, तातक्षितुम्;</li> <li>  <sup id="ref_krm_0701_10"><a href="#foot_krm_0701_10">10</a></sup> तक्षा, तक्षणा, तितक्षिषा, तातक्षा;</li> <li>  तक्षणम्, तक्षणम्, तितक्षिषणम्, तातक्षणम्;</li> <li>  तक्षित्वा, तक्षयित्वा, तितक्षिषित्वा, तातक्षित्वा;</li> <li>  सन्तक्ष्य, सन्तक्ष्य, सन्तितक्षिष्य, सन्तातक्ष्य;</li> <li>  तक्षम् २, तक्षित्वा २, तक्षम् २, तक्षयित्वा २, तितक्षिषम् २, तितक्षिषित्वा २, तातक्षम् २;</li> <li>  तातक्षित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0701_01"><a href="#ref_krm_0701_01">↑</a> (६९१)</li> <li id="foot_krm_0701_02"><a href="#ref_krm_0701_02">↑</a> (१-भ्वादिः-६६५। सक। सेट्। पर।)</li> <li id="foot_krm_0701_03"><a href="#ref_krm_0701_03">↑</a> [[[अ]</li> <li id="foot_krm_0701_04"><a href="#ref_krm_0701_04">↑</a> (३-१-७६)</li> <li id="foot_krm_0701_05"><a href="#ref_krm_0701_05">↑</a> (श्लो। १४४)</li> <li id="foot_krm_0701_06"><a href="#ref_krm_0701_06">↑</a> (१-८४)</li> <li id="foot_krm_0701_07"><a href="#ref_krm_0701_07">↑</a> (श्लो। १८३)</li> <li id="foot_krm_0701_08"><a href="#ref_krm_0701_08">↑</a> [[१। पदान्ते, ‘स्कोः संयोगाद्योरन्ते च’ (८-२-२९) इति कलोपे, ‘झलां जशोऽन्ते’ (८-२-३९) इति जश्त्वे, चर्त्वे च रूपम्।]]</li> <li id="foot_krm_0701_09"><a href="#ref_krm_0701_09">↑</a> [पृष्ठम्०६३८+ २६]</li> <li id="foot_krm_0701_10"><a href="#ref_krm_0701_10">↑</a> [[१। ‘गुरोश्च हलः’ (३-३-१०३) इत्यकारप्रत्ययः।]]</li></ul></p>

