<ul><li><sup id="ref_krm_0520_01"><a href="#foot_krm_0520_01">1</a></sup> {@“चल कम्पने”@} <sup id="ref_krm_0520_02"><a href="#foot_krm_0520_02">2</a></sup> घटादिः। </li> <li>ज्वलादिः। </li> <li>‘--भृत्यां चालयेत् कंपने चलेत्।’ <sup id="ref_krm_0520_03"><a href="#foot_krm_0520_03">3</a></sup> इति देवः। </li> <li>चालकः-लिका, चालकः-लिका- <sup id="ref_krm_0520_04"><a href="#foot_krm_0520_04">4</a></sup> चलकः-लिका, चिचलिषकः-षिका, चाचलकः-लिका;</li> <li>  <sup id="ref_krm_0520_05"><a href="#foot_krm_0520_05">5</a></sup> चलिता-त्री, चालयिता-चलयिता-त्री, चिचलिषिता-त्री, चाचलिता-त्री;</li> <li>  चलन्-न्ती, चालयन्-चलयन् <sup id="ref_krm_0520_06"><a href="#foot_krm_0520_06">6</a></sup> -न्ती, चिचलिषन्-न्ती;</li> <li>  -- चलिष्यन्-न्ती-ती, चालयिष्यन्-चलयिष्यन्-न्ती-ती, चिचलिषिष्यन्-न्ती-ती;</li> <li>  व्यतिचलमानः, व्यतिचलिष्यमाणः, -- चाचल्यमानः, चाचलिष्यमाणः;</li> <li>  चल्-चलौ-चलः;</li> <li>  -- -- -- चलितम्-तः, चालितम्-चलितम्-तः, चिचलिषितः, चाचलितः-तवान्;</li> <li>  <sup id="ref_krm_0520_07"><a href="#foot_krm_0520_07">7</a></sup> चलः- <sup id="ref_krm_0520_08"><a href="#foot_krm_0520_08">8</a></sup> चालः, <sup id="ref_krm_0520_09"><a href="#foot_krm_0520_09">9</a></sup> चलनः, <sup id="ref_krm_0520_10"><a href="#foot_krm_0520_10">10</a></sup> चलाचलः, <sup id="ref_krm_0520_11"><a href="#foot_krm_0520_11">11</a></sup> चाचलिः, चालः-चलः, चिचलिषुः, चाचलः;</li> <li>  चलितव्यम्, चालयितव्यम्-चलयितव्यम्, चिचलिषितव्यम्, चाचलितव्यम्;</li> <li>  चलनीयम्, चालनीयम्-चलनीयम्, चिचलिषणीयम्, चाचलनीयम्;</li> <li>  चाल्यम्, चाल्यम्-चल्यम्, चिचलिष्यम्, चाचल्यम्, ईषच्चलः-दुश्चलः-सुचलः;</li> <li>  -- -- चल्यमानः, चाल्यमानः-चल्यमानः, चिचलिष्यमाणः, चाचल्यमानः;</li> <li>  चालः, चालः-चलः, चिचलिषः, चाचलः;</li> <li>  चलितुत्, चालयितुम्-चलयितुम्, चिचलिषितुम्, चाचलितुम्;</li> <li>  <sup id="ref_krm_0520_12"><a href="#foot_krm_0520_12">12</a></sup> चलितिः, चालना-चलना, चिचलिषा, चाचला;</li> <li>  चलनम्, चालनम्-चलनम्, चिचलिषणम्, चाचलनम्;</li> <li>  चलित्वा, चालयित्वा-चलयित्वा, चिचलिषित्वा, चाचलित्वा;</li> <li>  प्रचल्य, प्रचाल्य- <sup id="ref_krm_0520_13"><a href="#foot_krm_0520_13">13</a></sup> प्रचलय्य, प्रचिचलिष्य, प्रचाचल्य;</li> <li>  <sup id="ref_krm_0520_14"><a href="#foot_krm_0520_14">14</a></sup> चालम् २, चलित्वा २, चालम् २- <sup id="ref_krm_0520_15"><a href="#foot_krm_0520_15">15</a></sup> चलम् २ -चालम् २, चालयित्वा-२, चलयित्वा २, चिचलिषम् २, चिचलिषित्वा २, चाचलम् २;</li> <li>  चाचलित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0520_01"><a href="#ref_krm_0520_01">↑</a> (५१०)</li> <li id="foot_krm_0520_02"><a href="#ref_krm_0520_02">↑</a> (१-भ्वादिः-८३२। अक। सेट्। पर।)</li> <li id="foot_krm_0520_03"><a href="#ref_krm_0520_03">↑</a> (श्लो। १५८)</li> <li id="foot_krm_0520_04"><a href="#ref_krm_0520_04">↑</a> [[१। ‘कम्पने चलिः’ इति घटादौ पाठात् कम्पनार्थे मित्त्वम्। ‘मितां ह्रस्वः’ (६-४-९२) इति णौ उपधाया ह्रस्वः। कम्पनादन्यार्थे तु मित्त्वं न। शीलं चालयन् = अन्यथा कुर्वन् इत्यर्थः। एवं ण्यन्ते रूपद्वयमर्थभेदेन बोध्यम्।]]</li> <li id="foot_krm_0520_05"><a href="#ref_krm_0520_05">↑</a> [पृष्ठम्०४९२+ २७]</li> <li id="foot_krm_0520_06"><a href="#ref_krm_0520_06">↑</a> [[आ। ‘तां प्राविशत् कपिव्याघ्रस्तरूनचलयन् शनैः।’ भ। का। ८-६०।]]</li> <li id="foot_krm_0520_07"><a href="#ref_krm_0520_07">↑</a> [[B। ‘ज्वालेन तापेन चला जडाङ्गीरटालशोकट्वलितप्रतापाः।।’ धा। का। २-२१।]]</li> <li id="foot_krm_0520_08"><a href="#ref_krm_0520_08">↑</a> [[१। ‘ज्वलितिकसन्तेभ्यो णः’ (३-१-१४०) इति कर्तरि वा णः, पक्षे पचाद्यच्।]]</li> <li id="foot_krm_0520_09"><a href="#ref_krm_0520_09">↑</a> [[२। ‘चलनशब्दार्थादकर्मकाद्युच्’ (३-२-१४८) इति ताच्छीलिको युच्।]]</li> <li id="foot_krm_0520_10"><a href="#ref_krm_0520_10">↑</a> [[३। ‘चरिचलिपतिवदीनां द्वित्वमचि, आक् चाभ्यासस्य’ (वा। ३-१-१३४) इति द्वित्वम्, अभ्यासस्य आगागमः। पक्षे चलः इत्यपि साधुः।]]</li> <li id="foot_krm_0520_11"><a href="#ref_krm_0520_11">↑</a> [[४। ‘सासहिवावहिपापतिचाचलीनामुपसंख्यानम्’ (वा। ३-२-१७१) इति वचनात् किः, किन् वा प्रत्ययः। द्वित्वादिकं बोध्यम्।]]</li> <li id="foot_krm_0520_12"><a href="#ref_krm_0520_12">↑</a> [[५। ‘तितुत्रेष्वग्रहादीनाम्--’ (बा। ७-२-९) इति वचनात् भणितिरित्यत्रेव इड् भवति।]]</li> <li id="foot_krm_0520_13"><a href="#ref_krm_0520_13">↑</a> [[६। ‘ल्यपि लघुपूर्वात्’ (६-४-५६) इति णेरयादेशः।]]</li> <li id="foot_krm_0520_14"><a href="#ref_krm_0520_14">↑</a> [पृष्ठम्०४९३+ २२]</li> <li id="foot_krm_0520_15"><a href="#ref_krm_0520_15">↑</a> [[१। ‘चिण्णमुलोर्दीर्घोऽन्यतरस्याम्’ (६-४-९३) इति णमुल्परे णौ उपधाया दीर्घविकल्पः।]]</li></ul></p>

चल|चालकः-लिका|चिचलिषकः-षिका|चाचलकः-लिका
<ul><li><sup id="ref_krm_0521_01"><a href="#foot_krm_0521_01">1</a></sup> {@“चल विलसने”@} <sup id="ref_krm_0521_02"><a href="#foot_krm_0521_02">2</a></sup> ‘--भृत्यां चालयेत्, कम्पने चलेत्।’ <sup id="ref_krm_0521_03"><a href="#foot_krm_0521_03">3</a></sup> इति देवः। </li> <li>चालकः-लिका, चालकः-लिका, चिचलिषकः-षिका, चाचलकः-लिका;</li> <li>  अित्यादीनि सर्वाण्यपि रूपाणि भौवादिकचलतिवत् <sup id="ref_krm_0521_04"><a href="#foot_krm_0521_04">4</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_0521_05"><a href="#foot_krm_0521_05">5</a></sup> चलन्-न्ती-ती, इति शतरि स्त्रियां रूपद्वयम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0521_01"><a href="#ref_krm_0521_01">↑</a> (५११)</li> <li id="foot_krm_0521_02"><a href="#ref_krm_0521_02">↑</a> (६-तुदादिः-१३५६। अक। सेट्। पर।)</li> <li id="foot_krm_0521_03"><a href="#ref_krm_0521_03">↑</a> (श्लो। १५८)</li> <li id="foot_krm_0521_04"><a href="#ref_krm_0521_04">↑</a> (५११)</li> <li id="foot_krm_0521_05"><a href="#ref_krm_0521_05">↑</a> [[आ। ‘चिलितपीतपटेन चलन् इलन् अविलितोरुकृपां परितो दृशम्।।’ धा। का। २-७८।]]</li></ul></p>

चल|ण्यन्तात्|सनि|तु-|चिचालयिषकः-षिका|चिचालयिषिता-त्री|चिचालयिषन्-न्ती|चिचालयिषिष्यन्-न्ती-ती|चिचालयिषमाणः|चिचालयिषिष्यमाणः|चिचालयिट्-यिषौ-यिषः|चिचालयिषितम्-तः-तवान्|चिचालयिषुः|चिचालयिषितव्यम्|चिचालयिषणीयम्|चिचालयिष्यम्|ईषच्चिचालयिषः-दुश्चिचालयिषः-सुचिचालयिषः|चिचालयिष्यमाणः|चिचालयिषः|चिचालयिषितुम्|चिचालयिषा|चिचालयिषणम्|चिचालयिषित्वा|प्रचिचालयिष्य|चिचालयिषम्
<ul><li><sup id="ref_krm_0522_01"><a href="#foot_krm_0522_01">1</a></sup> {@“चल भृतौ”@} <sup id="ref_krm_0522_02"><a href="#foot_krm_0522_02">2</a></sup> भृतिः = भरणम्, पोषणमिति यावत्। </li> <li>‘--भृत्यां चालयेत्, कम्पने चलेत्।’ <sup id="ref_krm_0522_03"><a href="#foot_krm_0522_03">3</a></sup> इति देवः। </li> <li>चालकः-लिका, <sup id="ref_krm_0522_04"><a href="#foot_krm_0522_04">4</a></sup> चाल्यम्, इत्यादीनि रूपाणि सर्वाण्यपि ण्यन्तात् भौवादिकचलतिवत् <sup id="ref_krm_0522_05"><a href="#foot_krm_0522_05">5</a></sup> ऊह्यानि। </li> <li>ण्यन्तात् सनि तु-- चिचालयिषकः-षिका, चिचालयिषिता-त्री, चिचालयिषन्-न्ती, चिचालयिषिष्यन्-न्ती-ती, चिचालयिषमाणः, चिचालयिषिष्यमाणः, चिचालयिट्-यिषौ-यिषः, चिचालयिषितम्-तः-तवान्;</li> <li>  चिचालयिषुः, चिचालयिषितव्यम्, चिचालयिषणीयम्;</li> <li>  चिचालयिष्यम्, ईषच्चिचालयिषः-दुश्चिचालयिषः-सुचिचालयिषः चिचालयिष्यमाणः, चिचालयिषः, चिचालयिषितुम्;</li> <li>  चिचालयिषा, चिचालयिषणम्, चिचालयिषित्वा, प्रचिचालयिष्य;</li> <li>  चिचालयिषम् २;</li> <li>  चिचालयिषित्वा २। इति रूपाणीति विशेषः। </li> <li>इति रूपाणीति विशेषः। </li> <li><sup id="ref_krm_0522_06"><a href="#foot_krm_0522_06">6</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0522_01"><a href="#ref_krm_0522_01">↑</a> (५१२)</li> <li id="foot_krm_0522_02"><a href="#ref_krm_0522_02">↑</a> (१०-चुरादिः-१६०८। सक। सेट्। उभ।)</li> <li id="foot_krm_0522_03"><a href="#ref_krm_0522_03">↑</a> (श्लो। १५८)</li> <li id="foot_krm_0522_04"><a href="#ref_krm_0522_04">↑</a> [[B। ‘काल्यप्रवेदनकरोऽयमवेलयद् द्राग् अन्याश्च तेलितकृपः खलु कंसचाल्यान्।’ कंसचाल्यान् = कंसपोष्यान् इत्यर्थः। धा। का। ३-२२।]]</li> <li id="foot_krm_0522_05"><a href="#ref_krm_0522_05">↑</a> (५१०)</li> <li id="foot_krm_0522_06"><a href="#ref_krm_0522_06">↑</a> [पृष्ठम्०४९४+ २४]</li></ul></p>

