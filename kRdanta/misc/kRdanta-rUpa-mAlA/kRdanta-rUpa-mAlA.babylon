<ul><li><sup id="ref_krm_0507_01"><a href="#foot_krm_0507_01">1</a></sup> {@“चप सान्त्वने”@} <sup id="ref_krm_0507_02"><a href="#foot_krm_0507_02">2</a></sup> चापकः-पिका, चापकः-पिका, चिचपिषकः-षिका, चाचपकः-पिका;</li> <li>  चपिता-त्री, चापयिता-त्री, चिचपिषिता-त्री, चाचपिता-त्री;</li> <li>  चपन्-न्ती, चापयन्-न्ती, चिचपिषन्-न्ती;</li> <li>  -- चपिष्यन्-न्ती-ती, चापयिष्यन्-न्ती-ती, चिचपिषिष्यन्-न्ती-ती;</li> <li>  -- -- चापयमानः, चापयिष्यमाणः, -- चाचप्यमानः, चाचपिष्यमाणः;</li> <li>  सुचप्-सुचपौ-सुचपः;</li> <li>  -- -- -- <sup id="ref_krm_0507_03"><a href="#foot_krm_0507_03">3</a></sup> चपितम्-तः, चापितः, चिचपिषितः, चाचपितः-तवान्;</li> <li>  <sup id="ref_krm_0507_04"><a href="#foot_krm_0507_04">4</a></sup> चपः, चापः, चिचपिषुः, चाचपः;</li> <li>  चपितव्यम्, चापयितव्यम्, चिचपिषितव्यम्, चाचपितव्यम्;</li> <li>  चपनीयम्, चापनीयम्, चिचपिषणीयम्, चाचपनीयम्;</li> <li>  <sup id="ref_krm_0507_05"><a href="#foot_krm_0507_05">5</a></sup> चप्यम्, चाप्यम्, चिचपिष्यम्, चाचप्यम्;</li> <li>  ईषच्चपः-दुश्चपः-सुचपः;</li> <li>  -- -- चप्यमानः, चाप्यमानः, चिचपिष्यमाणः, चाचप्यमानः;</li> <li>  चापः, चापः, चिचपिषः, चाचपः;</li> <li>  चपितुम्, चापयितुम्, चिचपिषितुम्, चाचपितुम्;</li> <li>  चप्तिः, चापना, चिचपिषा, चाचपा;</li> <li>  चपनम्, चापनम्, चिचपिषणम्;</li> <li>  चाचपनम्;</li> <li>  चपित्वा, चापयित्वा, चिचपिषित्वा, चाचपित्वा;</li> <li>  प्रचप्य, प्रचाप्य, प्रचिचपिष्य, प्रचाचप्य;</li> <li>  चापम् २, चपित्वा २, चापम् २, चापयित्वा २, चिचपिषम् २, चिचपिषित्वा २, चाचपम् २;</li> <li>  चाचपित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0507_01"><a href="#ref_krm_0507_01">↑</a> (४९७)</li> <li id="foot_krm_0507_02"><a href="#ref_krm_0507_02">↑</a> (१-भ्वादिः-३९९। सक। सेट्। पर।)</li> <li id="foot_krm_0507_03"><a href="#ref_krm_0507_03">↑</a> [पृष्ठम्०४७९+ २५]</li> <li id="foot_krm_0507_04"><a href="#ref_krm_0507_04">↑</a> [[१। चपः = वृक्षविशेषः इति मैत्रेयरक्षितः। वेणुविशेष इति दण्डनाथः। चपस्य विकारः चापम्। ‘तालादिभ्योऽण्’ (४-३-१५२) इति विकारार्थेऽण्।]]</li> <li id="foot_krm_0507_05"><a href="#ref_krm_0507_05">↑</a> [[२। ‘पोरदुपधात्’ (३-१-९८) इति यत्।]]</li></ul></p>

