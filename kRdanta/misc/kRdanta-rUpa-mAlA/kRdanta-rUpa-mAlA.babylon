<ul><li><sup id="ref_krm_1075_01"><a href="#foot_krm_1075_01">1</a></sup> {@“प्यैङ् वृद्धौ”@} <sup id="ref_krm_1075_02"><a href="#foot_krm_1075_02">2</a></sup> प्यायकः-यिका, प्यापकः-पिका, पिप्यासकः-सिका, पाप्यायकः-यिका;</li> <li>  प्याता-त्री, प्यापयिता-त्री, पिप्यासिता-त्री, पाप्यायिता-त्री;</li> <li>  -- प्यापयन्-न्ती, प्यापयिष्यन्-न्ती-ती;</li> <li>  -- <sup id="ref_krm_1075_03"><a href="#foot_krm_1075_03">3</a></sup> प्यायमानः, <sup id="ref_krm_1075_04"><a href="#foot_krm_1075_04">4</a></sup> प्यापयमानः, पिप्यासमानः, पाप्यायमानः;</li> <li>  प्यास्यमानः, प्यापयिष्यमाणः, पिप्यासिष्यमाणः, पाप्यायिष्यमाणः;</li> <li>  प्याः-प्यौ-प्यः;</li> <li>  -- -- <sup id="ref_krm_1075_05"><a href="#foot_krm_1075_05">5</a></sup> प्यानम्- <sup id="ref_krm_1075_06"><a href="#foot_krm_1075_06">6</a></sup> नः, प्यानवान्, प्यापितः, पिप्यासितः, पाप्यायितः-तवान्;</li> <li>  <sup id="ref_krm_1075_07"><a href="#foot_krm_1075_07">7</a></sup> आप्यायः, <sup id="ref_krm_1075_08"><a href="#foot_krm_1075_08">8</a></sup> पीवा- <sup id="ref_krm_1075_09"><a href="#foot_krm_1075_09">9</a></sup> पीवरी, प्यापः, पिप्यासुः, पाप्यः;</li> <li>  प्यातव्यम्, प्यापयितव्यम्, पिप्यासितव्यम्, पाप्यायितव्यम्;</li> <li>  प्यानीयम्, प्यापनीयम्, पिप्यासनीयम्, पाप्यायनीयम्;</li> <li>  प्येयम्, प्याप्यम्, पिप्यास्यम्, पाप्याय्यम्;</li> <li>  <sup id="ref_krm_1075_10"><a href="#foot_krm_1075_10">10</a></sup> ईषत्प्यानः-दुष्प्यानः-सुप्यानः;</li> <li>  -- -- प्यायमानः, प्याप्यमानः, पिप्यास्यमानः, पाप्याय्यमानः;</li> <li>  प्यायः, प्यापः, पिप्यासः, पाप्यायः;</li> <li>  प्यातुम्, प्यापयितुम्, पिप्यासितुम्, पाप्यायितुम्;</li> <li>  प्यातिः, <sup id="ref_krm_1075_11"><a href="#foot_krm_1075_11">11</a></sup> आप्या, प्यापना, पिप्यासा, पाप्याया;</li> <li>  प्यानम्, प्यापनम्, पिप्यासनम्, पाप्यायनम्;</li> <li>  प्यात्वा, प्यापयित्वा, पिप्यासित्वा, पाप्यायित्वा;</li> <li>  प्रप्याय, प्रप्याप्य, प्रपिप्यासिष्य, प्रपाप्याय्य;</li> <li>  प्यायम् २, प्यात्वा २, प्यापम् २, प्यापयित्वा २, पिप्यासम् २, पिप्यासित्वा २, पाप्यायम् २;</li> <li>  पाप्यायित्वा २। <sup id="ref_krm_1075_12"><a href="#foot_krm_1075_12">12</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1075_01"><a href="#ref_krm_1075_01">↑</a> (१०६५)</li> <li id="foot_krm_1075_02"><a href="#ref_krm_1075_02">↑</a> (१-भ्वादिः-९६४। अक। अनि। आत्म।)</li> <li id="foot_krm_1075_03"><a href="#ref_krm_1075_03">↑</a> [पृष्ठम्०८९९+ २५]</li> <li id="foot_krm_1075_04"><a href="#ref_krm_1075_04">↑</a> [[१। अचित्तवत्कर्तृकत्वे शानच्। चित्तवत्कर्तृकत्वे तु ‘अणावकर्मकात्--’ (१-३-८८) इति ण्यन्ताच्छतैव।]]</li> <li id="foot_krm_1075_05"><a href="#ref_krm_1075_05">↑</a> [[२। ‘संयोगादेरातो धातोर्यण्वतः’ (८-२-४३) इति निष्ठानत्वे रूपम्।]]</li> <li id="foot_krm_1075_06"><a href="#ref_krm_1075_06">↑</a> [[आ। ‘दयस्व मां देव कृपाम्बुशीत प्यानौजसा त्रातजगत्त्रयं त्वाम्।’ धा। का। २। ३७।]]</li> <li id="foot_krm_1075_07"><a href="#ref_krm_1075_07">↑</a> [[३। ‘श्याऽऽद्--’ (३-१-१४१) इत्यादिना कर्तरि णप्रत्यये युगागमः।]]</li> <li id="foot_krm_1075_08"><a href="#ref_krm_1075_08">↑</a> [[४। ‘आतो मनिन्--’ (३-२-७४) इत्यनेन बाहुलकात् क्वनिप्प्रत्यये, ‘ध्याप्योः सम्प्रसारणं च’ (भाष्यम्-३-२-१७८) इति प्रक्रियासर्वस्वानुसारिभाष्य- वाक्येन सम्प्रसारणे च रूपम्। स्त्रियाम्, ‘वनो र च’ (४-१-७) इति ङीब्रेफौ भवतः।]]</li> <li id="foot_krm_1075_09"><a href="#ref_krm_1075_09">↑</a> [[B। ‘जघ{??}मलघुपीवरोरु कृच्छ्रादुरुनिबिरीसनितम्बभारखेदि।’ शि। व। ७। २०।]]</li> <li id="foot_krm_1075_10"><a href="#ref_krm_1075_10">↑</a> [[५। ईषदाद्युपपदेषु, ‘आतो युच्’ (३-३-१२८) इति युच्प्रत्ययः। खलोऽप्रवादः।]]</li> <li id="foot_krm_1075_11"><a href="#ref_krm_1075_11">↑</a> [[६। ‘आतश्चोपसर्गे’ (३-३-१०६) इत्यङ्।]]</li> <li id="foot_krm_1075_12"><a href="#ref_krm_1075_12">↑</a> [पृष्ठम्०९००+ २४]</li></ul></p>

प्रच्छ|प्रच्छकः-च्छिका|पिपृच्छिषकः-षिका|परीपृच्छकः-च्छिका|प्रष्टा-प्रष्ट्री|प्रच्छयिता-त्री|पिपृच्छिषिता-त्री|परीपृच्छिता-त्री|पृच्छन्-न्ती-ती|प्रच्छयन्-न्ती|पिपृच्छिषन्-न्ती|-प्रक्ष्यन्-न्ती-ती|प्रच्छयिष्यन्|पिपृच्छिषिष्यन्-न्ती-ती|-सम्पृच्छमानः|आपृच्छमानः|प्रच्छयमानः|आपिपृच्छिषमाणः|संपिपृच्छिषमाणः|परीपृच्छ्यमानः|सम्प्रक्ष्यमाणः-आप्रक्ष्यमाणः|प्रच्छयिष्यमाणः|आपिपृच्छिषिष्यमाणः-|सम्पिपृच्छिषिष्यमाणः|परीपृच्छिष्यमाणः|प्राट्|शब्दप्राट्-प्राड्-प्राशौ-प्राशः|-|-पृष्टम्-पृष्टः-पृष्टवान्|प्रच्छितः|पितृच्छिषितः|परीपृच्छितः-तवान्|प्रच्छः|पिपृच्छिषुः|परीपृच्छः|प्रष्टव्यम्|प्रच्छयितव्यम्|पिपृच्छिषितव्यम्|परीपृच्छितव्यम्|प्रच्छनीयम्|पिपृच्छिषणीयम्|परीपृच्छनीयम्|प्रच्छ्यम्|पिपृच्छिष्यम्|परीपृच्छ्यम्|ईषत्प्रच्छः-दुष्प्रच्छः-सुप्रच्छः|पृच्छ्यमानः|प्रच्छ्यमानः|पिपृच्छिष्यमाणः|प्रश्नः|पिपृच्छिषः|प्रष्टुम्|प्रच्छयितुम्|पिपृच्छिषितुम्|परीपृच्छितुम्|पृष्टिः|पृच्छा|प्रच्छना|पिपृच्छिषा|परीपृच्छा|प्रच्छनम्|पिपृच्छिषणम्|परीपृच्छनम्|पृष्ट्वा|प्रच्छयित्वा|पिपृच्छिषित्वा|परीपृच्छित्वा|आपृच्छ्य|सम्प्रच्छ्य|प्रपिपृच्छिष्य|प्रपरीपृच्छ्य|प्रच्छम्|पिपृच्छिषम्|परीपृच्छम्
<ul><li><sup id="ref_krm_1076_01"><a href="#foot_krm_1076_01">1</a></sup> {@“प्रच्छ ज्ञीप्सायाम्”@} <sup id="ref_krm_1076_02"><a href="#foot_krm_1076_02">2</a></sup> किरादिः। </li> <li><sup id="ref_krm_1076_03"><a href="#foot_krm_1076_03">3</a></sup> प्रच्छकः-च्छिका, प्रच्छकः-च्छिका, <sup id="ref_krm_1076_04"><a href="#foot_krm_1076_04">4</a></sup> पिपृच्छिषकः-षिका, <sup id="ref_krm_1076_05"><a href="#foot_krm_1076_05">5</a></sup> परीपृच्छकः-च्छिका;</li> <li>  <sup id="ref_krm_1076_06"><a href="#foot_krm_1076_06">6</a></sup> प्रष्टा-प्रष्ट्री, प्रच्छयिता-त्री, पिपृच्छिषिता-त्री, परीपृच्छिता-त्री;</li> <li>  <sup id="ref_krm_1076_07"><a href="#foot_krm_1076_07">7</a></sup> पृच्छन्-न्ती-ती, प्रच्छयन्-न्ती, पिपृच्छिषन्-न्ती;</li> <li>  -- <sup id="ref_krm_1076_08"><a href="#foot_krm_1076_08">8</a></sup> प्रक्ष्यन्-न्ती-ती, प्रच्छयिष्यन्, पिपृच्छिषिष्यन्-न्ती-ती;</li> <li>  -- <sup id="ref_krm_1076_09"><a href="#foot_krm_1076_09">9</a></sup> सम्पृच्छमानः, <sup id="ref_krm_1076_10"><a href="#foot_krm_1076_10">10</a></sup> आपृच्छमानः, <sup id="ref_krm_1076_11"><a href="#foot_krm_1076_11">11</a></sup> प्रच्छयमानः, <sup id="ref_krm_1076_12"><a href="#foot_krm_1076_12">12</a></sup> आपिपृच्छिषमाणः, संपिपृच्छिषमाणः, परीपृच्छ्यमानः;</li> <li>  सम्प्रक्ष्यमाणः-आप्रक्ष्यमाणः, प्रच्छयिष्यमाणः, आपिपृच्छिषिष्यमाणः- सम्पिपृच्छिषिष्यमाणः, परीपृच्छिष्यमाणः;</li> <li>  <sup id="ref_krm_1076_13"><a href="#foot_krm_1076_13">13</a></sup> <sup id="ref_krm_1076_14"><a href="#foot_krm_1076_14">14</a></sup> प्राट्, शब्दप्राट्-प्राड्-प्राशौ-प्राशः;</li> <li>  -- -- <sup id="ref_krm_1076_15"><a href="#foot_krm_1076_15">15</a></sup> पृष्टम्-पृष्टः-पृष्टवान्, प्रच्छितः, पितृच्छिषितः, परीपृच्छितः-तवान्;</li> <li>  प्रच्छः, प्रच्छः, <sup id="ref_krm_1076_16"><a href="#foot_krm_1076_16">16</a></sup> पिपृच्छिषुः, परीपृच्छः;</li> <li>  प्रष्टव्यम्, प्रच्छयितव्यम्, पिपृच्छिषितव्यम्, परीपृच्छितव्यम्;</li> <li>  प्रच्छनीयम्, प्रच्छनीयम्, पिपृच्छिषणीयम्, परीपृच्छनीयम्;</li> <li>  प्रच्छ्यम्, प्रच्छ्यम्, पिपृच्छिष्यम्, परीपृच्छ्यम्;</li> <li>  ईषत्प्रच्छः-दुष्प्रच्छः-सुप्रच्छः;</li> <li>  -- -- पृच्छ्यमानः, प्रच्छ्यमानः, पिपृच्छिष्यमाणः, परीपृच्छ्यमानः;</li> <li>  प्रच्छः, <sup id="ref_krm_1076_17"><a href="#foot_krm_1076_17">17</a></sup> प्रश्नः, प्रच्छः, पिपृच्छिषः, परीपृच्छः;</li> <li>  प्रष्टुम्, प्रच्छयितुम्, पिपृच्छिषितुम्, परीपृच्छितुम्;</li> <li>  पृष्टिः, <sup id="ref_krm_1076_18"><a href="#foot_krm_1076_18">18</a></sup> पृच्छा, प्रच्छना, पिपृच्छिषा, परीपृच्छा;</li> <li>  प्रच्छनम्, प्रच्छनम्, पिपृच्छिषणम्, परीपृच्छनम्;</li> <li>  पृष्ट्वा, प्रच्छयित्वा, पिपृच्छिषित्वा, परीपृच्छित्वा;</li> <li>  <sup id="ref_krm_1076_19"><a href="#foot_krm_1076_19">19</a></sup> आपृच्छ्य, सम्प्रच्छ्य, प्रपिपृच्छिष्य, प्रपरीपृच्छ्य;</li> <li>  प्रच्छम् २, पृष्ट्वा २, प्रच्छम् २, प्रच्छयित्वा २, पिपृच्छिषम् २, पिपृच्छिषित्वा २, परीपृच्छम् २;</li> <li>  परीपृच्छित्वा २। <sup id="ref_krm_1076_20"><a href="#foot_krm_1076_20">20</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1076_01"><a href="#ref_krm_1076_01">↑</a> (१०६६)</li> <li id="foot_krm_1076_02"><a href="#ref_krm_1076_02">↑</a> (६-तुदादिः-१४१३। सक। अनि। पर।)</li> <li id="foot_krm_1076_03"><a href="#ref_krm_1076_03">↑</a> [[१। ‘प्रछ’ इत्येव धातुः। तत्र, ‘छे च’ (६-१-७३) इति ह्रस्वस्य तुकि, तस्य श्चुत्वेन चकारः सर्वत्र ज्ञेयः।]]</li> <li id="foot_krm_1076_04"><a href="#ref_krm_1076_04">↑</a> [[२। सन्नन्तात् ण्वुलि, ‘किरश्च पञ्चभ्यः’ (७-२-७५) इतीडागमे, ‘रुदविदमुषग्रहि- स्वपिप्रच्छः संश्च’ (१-२-८) इति सनः कित्त्वे, ‘ग्रहिज्यावयिव्यधिवष्टि- विचतिवृश्चतिपृच्छतिभृज्जतीनां ङिति च’ (६-१-१६) इति सम्प्रसारणे षत्वे च रूपम्। एवं सन्नन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_1076_05"><a href="#ref_krm_1076_05">↑</a> [[३। यङन्ते सर्वत्र यङ्निमित्तकं सम्प्रसारणं भवति। पश्चात् ‘रीगृत्वत इति वक्तव्यम्’ (वा। ७-४-९०) इति रीक् अभ्यासस्य।]]</li> <li id="foot_krm_1076_06"><a href="#ref_krm_1076_06">↑</a> [[४। तृचि, ‘व्रश्चभ्रस्जसृजमृजयजराजभ्राजच्छशां षः’ (८-२-३६) इति षत्वे, ‘ष्टुना ष्टुः’ (८-४-४१) इति ष्टुत्वे च रूपम्। एवं तव्यदादिष्वपि ज्ञेयम्।]]</li> <li id="foot_krm_1076_07"><a href="#ref_krm_1076_07">↑</a> [[५। शतरि, ‘तुदादिभ्यः--’ (३-१-७७) इति विकरणप्रत्ययः शः। तस्य सार्व- धातुकत्वेन ङिद्वद्भावात् सम्प्रसारणे रूपमेवम्। एवं शानजन्तेऽपि प्रक्रिया ज्ञेया।]]</li> <li id="foot_krm_1076_08"><a href="#ref_krm_1076_08">↑</a> [[६। स्यप्रत्यये, ‘व्रश्च--’ (८-२-३६) इत्यादिना षत्वे, ‘षढोः कः सि’ (८-२-४१) इति षकारस्य ककारे, षत्वे च रूपमेवम्।]]</li> <li id="foot_krm_1076_09"><a href="#ref_krm_1076_09">↑</a> [[७। ‘विदिप्रच्छिस्वरतीनामुपसंख्यानम्’ (वा। १-३-२९) इति वार्तिकेन सम्पूर्वकादस्मा- दात्मनेपदं, शानच् भवति।]]</li> <li id="foot_krm_1076_10"><a href="#ref_krm_1076_10">↑</a> [[८। ‘आङि नुप्रच्छ्योरुपसंख्यानम्’ (वा। १-३-२१) इति आंङ्पूर्वकादस्माच्छानच्।]]</li> <li id="foot_krm_1076_11"><a href="#ref_krm_1076_11">↑</a> [[आ। ‘कृतगुरुतरहारच्छेदमालिङ्ग्य पत्यौ परिशिथिलितगात्रे गन्तुमापृच्छमाने।’ शि। व। ११। ३८।]]</li> <li id="foot_krm_1076_12"><a href="#ref_krm_1076_12">↑</a> [[९। ‘पूर्ववत् सनः’ (१-३-६२) इति संपूर्वकात्, आङ्पूर्वकाच्च सन्नन्तेऽपि शानच्।]]</li> <li id="foot_krm_1076_13"><a href="#ref_krm_1076_13">↑</a> [पृष्ठम्०९०१+ २५]</li> <li id="foot_krm_1076_14"><a href="#ref_krm_1076_14">↑</a> [[१। ‘क्विब्वचिप्रच्छ्यायतस्तुकटप्रुजु श्रीणां दीर्घोऽसम्प्रसारणं च’ (वा। ३-२-१७८) इत्यनेन क्विपि दीर्घेऽसंप्रसारणे च विहिते सति, ‘च्छ्वोः शूडनुनासिके च’ (६-४-१९) इति क्विब्निमित्तके शकारे, तस्य षत्वे जश्त्वे चर्त्वे च रूपमेवम्।]]</li> <li id="foot_krm_1076_15"><a href="#ref_krm_1076_15">↑</a> [[२। क्तप्रत्यये सम्प्रसारणादिकं सर्वं यथायथमूह्यम्।]]</li> <li id="foot_krm_1076_16"><a href="#ref_krm_1076_16">↑</a> [[आ। ‘उक्तं पिपृच्छिषूणां वो मा स्म भूत सुषुप्सवः।।’ भ। का। ७। ९८।]]</li> <li id="foot_krm_1076_17"><a href="#ref_krm_1076_17">↑</a> [[३। भावेऽकर्तरि च कारके, ‘यजयाचयतविच्छप्रच्छरक्षो नङ्’ (३-३-९०) इति नङ्प्रत्ययः। ‘च्छ्वोः शूड्--’ (६-४-१९) इति सतुक्कस्य छकारस्य शकारः। ‘प्रश्ने चासन्नकाले’ (३-२-११७) इति सूत्रकारनिर्देशप्रामाण्यात् सम्प्रसारणं न भवति। ‘शात्’ (८-४-४४) इति निषेधात् श्चुत्वं न।]]</li> <li id="foot_krm_1076_18"><a href="#ref_krm_1076_18">↑</a> [[४। भिदादेः (३-३-१०४) आकृतिगणत्वात् अङि, सम्प्रसारणे च पृच्छा इति रूपमिति आत्रेयादीनां मतमिति मा। धा। वृत्तिः।]]</li> <li id="foot_krm_1076_19"><a href="#ref_krm_1076_19">↑</a> [[५। ल्यपि, सम्प्रसारणे रूपमेवम्। ‘च्छ्वोः शूठ्--’ (६-४-१९) इति शकारादेशो न भवति, ल्यपो बहिरङ्गत्वात्।]]</li> <li id="foot_krm_1076_20"><a href="#ref_krm_1076_20">↑</a> [पृष्ठम्०९०२+ २६]</li></ul></p>

प्रथ|प्राथकः-थिका|प्रथकः-थिका|पिप्रथिषकः-षिका|पाप्रथकः-थिका
<ul><li><sup id="ref_krm_1077_01"><a href="#foot_krm_1077_01">1</a></sup> {@“प्रथ प्रख्याने”@} <sup id="ref_krm_1077_02"><a href="#foot_krm_1077_02">2</a></sup> घटादिः षिच्च। </li> <li>‘प्रख्यानम् = प्रसिद्धिः।’ इति क्षीरस्वामी। </li> <li>‘विस्तारेऽपि’ इति धा। </li> <li>का। </li> <li><sup id="ref_krm_1077_03"><a href="#foot_krm_1077_03">3</a></sup>। </li> <li>‘प्रथते प्राथयत्येतत् प्रख्याने द्वितयं प्रथेः।’ <sup id="ref_krm_1077_04"><a href="#foot_krm_1077_04">4</a></sup> इति देवः। </li> <li>प्राथकः-थिका, <sup id="ref_krm_1077_05"><a href="#foot_krm_1077_05">5</a></sup> प्रथकः-थिका, पिप्रथिषकः-षिका, पाप्रथकः-थिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकक्रथतिवत् <sup id="ref_krm_1077_06"><a href="#foot_krm_1077_06">6</a></sup> तद्धातुविषयकप्राति- स्विकरूपाणि विना ज्ञेयानि। </li> <li><sup id="ref_krm_1077_07"><a href="#foot_krm_1077_07">7</a></sup> प्रथा, <sup id="ref_krm_1077_08"><a href="#foot_krm_1077_08">8</a></sup> पृथुः-पृथु, <sup id="ref_krm_1077_09"><a href="#foot_krm_1077_09">9</a></sup> प्रथमः, <sup id="ref_krm_1077_10"><a href="#foot_krm_1077_10">10</a></sup> पृथिवी इति रूपाण्यस्माद्भवन्तीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1077_01"><a href="#ref_krm_1077_01">↑</a> (१०६७)</li> <li id="foot_krm_1077_02"><a href="#ref_krm_1077_02">↑</a> (१-भ्वादिः-७६५। अक। सेट्। आत्म।)</li> <li id="foot_krm_1077_03"><a href="#ref_krm_1077_03">↑</a> [२। ४]</li> <li id="foot_krm_1077_04"><a href="#ref_krm_1077_04">↑</a> (श्लो। ९९)</li> <li id="foot_krm_1077_05"><a href="#ref_krm_1077_05">↑</a> [[१। ण्यन्ते सर्वत्र, ‘घटादयो मितः’ (ग। सू। भ्वादौ) इति मित्संज्ञायाम्, ‘मितां ह्रस्वः’ (६-४-९२) इति उपधाह्रस्वे रूपम्।]]</li> <li id="foot_krm_1077_06"><a href="#ref_krm_1077_06">↑</a> (२०६)</li> <li id="foot_krm_1077_07"><a href="#ref_krm_1077_07">↑</a> [[२। ‘घटादयः षितः’ (ग। सू। भ्वादौ) इति षित्त्वात्, स्त्रियाम्, ‘षिद्भिदा- दिभ्यः--’ (३-३-१०४) इत्यङि रूपमेवम्।]]</li> <li id="foot_krm_1077_08"><a href="#ref_krm_1077_08">↑</a> [[३। ‘प्रथिम्रदि--’ (द। उ। १। ११३) इति कुप्रत्यये सम्प्रसारणे च रूपमेवम्। प्रथतेऽसौ इति पृथुः = राजा, प्रथनं वा। पृथु = विस्तीर्णम्।]]</li> <li id="foot_krm_1077_09"><a href="#ref_krm_1077_09">↑</a> [[४। ‘प्रथेरट् च’ (द। उ। ७। २९) इति मन्प्रत्ययेऽडागमे च रूपम्।]]</li> <li id="foot_krm_1077_10"><a href="#ref_krm_1077_10">↑</a> [[५। ‘प्रथेः षिवन् सम्प्रसारणं च’ (द। उ। ८। १२४) इति षिवन्प्रत्यये सम्प्रसारणे च रूपम्। षित्त्वात् ङीष्।]]</li></ul></p>

प्रथ|प्राथकः-थिका|पिप्राथयिषकः-षिका
<ul><li><sup id="ref_krm_1078_01"><a href="#foot_krm_1078_01">1</a></sup> {@“प्रथ प्रख्याने”@} <sup id="ref_krm_1078_02"><a href="#foot_krm_1078_02">2</a></sup> <sup id="ref_krm_1078_03"><a href="#foot_krm_1078_03">3</a></sup> क्षीरस्वामी धातुममुं चुरादिषु न पठति। </li> <li>‘पृथ <sup id="ref_krm_1078_04"><a href="#foot_krm_1078_04">4</a></sup>’ इति तत्य पाठः।]] ‘--क्षेपे च।’ इति द्रुमे <sup id="ref_krm_1078_05"><a href="#foot_krm_1078_05">5</a></sup>। </li> <li>‘प्रथते प्राथयत्येतत् प्रख्याने द्वितर्यं प्रथेः।’ <sup id="ref_krm_1078_06"><a href="#foot_krm_1078_06">6</a></sup> इति देवः। </li> <li>प्राथकः-थिका, पिप्राथयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकक्लापयतिवत् <sup id="ref_krm_1078_07"><a href="#foot_krm_1078_07">7</a></sup> ज्ञेयानि। </li> <li>‘नान्ये मितोऽहेतौ’ <sup id="ref_krm_1078_08"><a href="#foot_krm_1078_08">8</a></sup> इति सम्भवद्धेतुमण्णिचां चुरादिणिचि मित्त्वनिषेधात् घटादिकार्यमत्र नेति ज्ञेयम्। </li> <li><sup id="ref_krm_1078_09"><a href="#foot_krm_1078_09">9</a></sup> प्राथितः। </li> <li><sup id="ref_krm_1078_10"><a href="#foot_krm_1078_10">10</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1078_01"><a href="#ref_krm_1078_01">↑</a> (१०६८)</li> <li id="foot_krm_1078_02"><a href="#ref_krm_1078_02">↑</a> (१०-चुरादिः-१५५३। अक। सेट्। उभ।)</li> <li id="foot_krm_1078_03"><a href="#ref_krm_1078_03">↑</a> [[[अ]</li> <li id="foot_krm_1078_04"><a href="#ref_krm_1078_04">↑</a> (पर्थ)</li> <li id="foot_krm_1078_05"><a href="#ref_krm_1078_05">↑</a> (श्लो। १८८)</li> <li id="foot_krm_1078_06"><a href="#ref_krm_1078_06">↑</a> (श्लो। ९९)</li> <li id="foot_krm_1078_07"><a href="#ref_krm_1078_07">↑</a> (२८२)</li> <li id="foot_krm_1078_08"><a href="#ref_krm_1078_08">↑</a> (ग। सू। भ्वादौ)</li> <li id="foot_krm_1078_09"><a href="#ref_krm_1078_09">↑</a> [[आ। ‘अप्राथितो व्रजगृहेऽपि च पर्थितोऽभूत्…।।’ धा। का। ३। १५।]]</li> <li id="foot_krm_1078_10"><a href="#ref_krm_1078_10">↑</a> [पृष्ठम्०९०३+ २३]</li></ul></p>

प्रस|प्रासकः-सिका|प्रसकः-सिका|पिप्रसिषकः-षिका|पाप्रसकः-सिका
<ul><li><sup id="ref_krm_1079_01"><a href="#foot_krm_1079_01">1</a></sup> {@“प्रस विस्तारे”@} <sup id="ref_krm_1079_02"><a href="#foot_krm_1079_02">2</a></sup> घटादिः षिच्च। </li> <li>‘--प्रसवे।’ इति क्षीरस्वामी। </li> <li>प्रासकः-सिका, प्रसकः-सिका, पिप्रसिषकः-षिका, पाप्रसकः-सिका;</li> <li>  <sup id="ref_krm_1079_03"><a href="#foot_krm_1079_03">3</a></sup> प्रसा, <sup id="ref_krm_1079_04"><a href="#foot_krm_1079_04">4</a></sup> प्रासः, इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकक्रथतिवत् <sup id="ref_krm_1079_05"><a href="#foot_krm_1079_05">5</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1079_06"><a href="#foot_krm_1079_06">6</a></sup> प्रसमानः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1079_01"><a href="#ref_krm_1079_01">↑</a> (१०६९)</li> <li id="foot_krm_1079_02"><a href="#ref_krm_1079_02">↑</a> (१-भ्वादिः-७६६। अक। सेट्। आत्म।)</li> <li id="foot_krm_1079_03"><a href="#ref_krm_1079_03">↑</a> [[१। षित्त्वात् स्त्रियां भावादावङ् इति ज्ञेयम्।]]</li> <li id="foot_krm_1079_04"><a href="#ref_krm_1079_04">↑</a> [[२। ‘हलश्च’ (३-३-१२१) इति संज्ञायां घञ्। प्रासः = शब्दचित्रम्।]]</li> <li id="foot_krm_1079_05"><a href="#ref_krm_1079_05">↑</a> (२०६)</li> <li id="foot_krm_1079_06"><a href="#ref_krm_1079_06">↑</a> [[आ। ‘गोपीघटाः प्रव्यथितास्तदानीं पृथूपतापप्रसमानचिन्ताः।’ धा। का। २। ४।]]</li></ul></p>

प्रा|प्रायकः-यिका|प्रापकः-पिका|पिप्रासकः-सिका|पाप्रायकः-यिका
<ul><li><sup id="ref_krm_1080_01"><a href="#foot_krm_1080_01">1</a></sup> {@“प्रा पूरणे”@} <sup id="ref_krm_1080_02"><a href="#foot_krm_1080_02">2</a></sup> प्रायकः-यिका, प्रापकः-पिका, पिप्रासकः-सिका, पाप्रायकः-यिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि आदादिकदाप्धातुवत् <sup id="ref_krm_1080_03"><a href="#foot_krm_1080_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1080_04"><a href="#foot_krm_1080_04">4</a></sup> प्रायः, <sup id="ref_krm_1080_05"><a href="#foot_krm_1080_05">5</a></sup> प्रान्-प्रान्तौ-प्रान्तः, <sup id="ref_krm_1080_06"><a href="#foot_krm_1080_06">6</a></sup> प्राणः <sup id="ref_krm_1080_07"><a href="#foot_krm_1080_07">7</a></sup> -प्राणवान् इति रूपाणि भवन्त्यस्येति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1080_01"><a href="#ref_krm_1080_01">↑</a> (१०७०)</li> <li id="foot_krm_1080_02"><a href="#ref_krm_1080_02">↑</a> (२-अदादिः-१०६१। सक। अनि। पर।)</li> <li id="foot_krm_1080_03"><a href="#ref_krm_1080_03">↑</a> (८३३)</li> <li id="foot_krm_1080_04"><a href="#ref_krm_1080_04">↑</a> [[३। ‘श्याऽऽद्व्यध--’ (३-१-१४१) इत्यादिना कर्तरि णप्रत्यये युगागमः।]]</li> <li id="foot_krm_1080_05"><a href="#ref_krm_1080_05">↑</a> [[४। शतरि, शपि, ‘अदिप्रभृतिभ्यः--’ (२-४-७२) इति शपो लुकि, ‘पदान्तस्य’ (८-४-३७) इति निषेधात् णत्वं नेति ज्ञेयम्।]]</li> <li id="foot_krm_1080_06"><a href="#ref_krm_1080_06">↑</a> [[५। ‘संयोगादेरातो धातोर्यण्वतः’ (८-२-४३) इति निष्ठानत्वे, णत्वे च रूपम्।]]</li> <li id="foot_krm_1080_07"><a href="#ref_krm_1080_07">↑</a> [[B। ‘ख्यान्त्यः कथाः प्राणमुदां पतीनां निर्मान्त्य इष्टानि चटुन् वचत्यः।’ धा। का। २। ५०।]]</li></ul></p>

प्रीङ्|प्रायकः-यिका|पिप्रीषकः-षिका|पेप्रीयकः-यिका
<ul><li><sup id="ref_krm_1081_01"><a href="#foot_krm_1081_01">1</a></sup> {@“प्रीङ् प्रीतौ”@} <sup id="ref_krm_1081_02"><a href="#foot_krm_1081_02">2</a></sup> ‘प्रीङ् प्रीतौ प्रीयतेऽप्रीणात् प्रीणीते तर्पणे ञितः।। </li> <li>अणौ यौ ञित्त्वसाफल्यात् प्रीणयेत् प्रयते प्रयेत्।’ <sup id="ref_krm_1081_03"><a href="#foot_krm_1081_03">3</a></sup> इति देवः। </li> <li>प्रायकः-यिका, प्रायकः-यिका, पिप्रीषकः-षिका, पेप्रीयकः-यिका;</li> <li>  <sup id="ref_krm_1081_04"><a href="#foot_krm_1081_04">4</a></sup> प्रियः-इत्यादीनि सर्वाण्यपि रूपाणि दैवादिकधीङ्धातुवत् <sup id="ref_krm_1081_05"><a href="#foot_krm_1081_05">5</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1081_06"><a href="#foot_krm_1081_06">6</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1081_01"><a href="#ref_krm_1081_01">↑</a> (१०७१)</li> <li id="foot_krm_1081_02"><a href="#ref_krm_1081_02">↑</a> (४-दिवादिः-११४४। अक। अनि। आत्म।)</li> <li id="foot_krm_1081_03"><a href="#ref_krm_1081_03">↑</a> (श्लो। १९। २०)</li> <li id="foot_krm_1081_04"><a href="#ref_krm_1081_04">↑</a> [[६। ‘इगुपधज्ञाप्रीकिरः कः’ (३-१-१३५) इति कर्तरि कप्रत्ययः। एतच्च आत्रेयादीनां मतेनोक्तम्। काशिकायां तु ‘प्रीणातीति प्रियः।’ इति कैयादिकस्यैव कप्रत्ययः प्रोक्तः।]]</li> <li id="foot_krm_1081_05"><a href="#ref_krm_1081_05">↑</a> (९०१)</li> <li id="foot_krm_1081_06"><a href="#ref_krm_1081_06">↑</a> [पृष्ठम्०९०४+ २९]</li></ul></p>

प्रीञ्|प्रायकः-यिका|प्रीणकः-णिका|पिप्रीषकः-षिका|पेप्रीयकः-यिका
<ul><li><sup id="ref_krm_1082_01"><a href="#foot_krm_1082_01">1</a></sup> {@“प्रीञ् तर्पणे कान्तौ च”@} <sup id="ref_krm_1082_02"><a href="#foot_krm_1082_02">2</a></sup> कान्तिः = कामना। </li> <li>‘प्रीङ् प्रीतौ प्रीयतेऽप्रीणात् प्रीणीते तर्पणे ञितः।। </li> <li>अणौ यौ ञित्त्वसाफल्यात् प्रीणयेत् प्रयते प्रयेत्।’ <sup id="ref_krm_1082_03"><a href="#foot_krm_1082_03">3</a></sup> इति देवः। </li> <li>प्रायकः-यिका, <sup id="ref_krm_1082_04"><a href="#foot_krm_1082_04">4</a></sup> प्रीणकः-णिका, पिप्रीषकः-षिका, पेप्रीयकः-यिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि क्रैयादिकक्रीणातिवत् <sup id="ref_krm_1082_05"><a href="#foot_krm_1082_05">5</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1082_06"><a href="#foot_krm_1082_06">6</a></sup> वत्सप्रीः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1082_01"><a href="#ref_krm_1082_01">↑</a> (१०७२)</li> <li id="foot_krm_1082_02"><a href="#ref_krm_1082_02">↑</a> (९-क्र्यादिः-१४७४। सक। अनि उभ।)</li> <li id="foot_krm_1082_03"><a href="#ref_krm_1082_03">↑</a> (श्लो। १९। २०)</li> <li id="foot_krm_1082_04"><a href="#ref_krm_1082_04">↑</a> [[१। ‘धूञ्प्रीञोर्नुग् वक्तव्यः’ (वा। ७-३-३७) इति ण्यन्ते सर्वत्र नुगागमे णत्वे च प्रीणकः, प्रीणयिता इत्यादीनि सर्वाण्यपि रूपाणि भवन्तीति यथायथमूह्यानि।]]</li> <li id="foot_krm_1082_05"><a href="#ref_krm_1082_05">↑</a> (२७४)</li> <li id="foot_krm_1082_06"><a href="#ref_krm_1082_06">↑</a> [[२। वत्सान् प्रीणातीति वत्सप्रीः। क्विपि रूपमेवम्। काशिकायां (६-४-१४८) रूपमेतदुदाहृतम्।]]</li></ul></p>

प्रीञ्|प्रीणकः-णिका|प्रायकः-यिका|पिप्रीणयिषकः-पिप्राययिषकः-षिका|पिप्रीषकः-षिका|पेप्रीयकः-यिका|प्रीणयिता-त्री|पिप्रीणयिषिता-त्री|प्रेता-त्री|पिप्रीषिता-त्री|पेप्रीयिता-त्री|प्रीणयन्-न्ती|पिप्रीणयिषन्-न्ती|प्रयन्-न्ती|पिप्रीषन्-न्ती|-प्रीणयिष्यन्-पिप्रीणयिषिष्यन्-न्ती-ती|प्रेष्यन्-न्ती-ती|पिप्रीषिष्यन्-न्ती-ती|मित्रप्रीः-मित्रप्रियौ-मित्रप्रियः|-|प्रीणितम्-तः|पिप्रीणयिषितः-तवान्|प्रीतम्-तः|पिप्रीषितः|पेप्रीयितः-तवान्|प्रीणः|पिप्रीणयिषुः|प्रियः|पिप्रीषुः|प्रेप्रियः|प्रीणयितव्यम्|पिप्रीणयिषितव्यम्|प्रेतव्यम्|पिप्रीषितव्यम्|प्रेप्रीयितव्यम्|प्रीणनीयम्|पिप्रीणयिषणीयम्|प्रयणीयम्|पिप्रीषणीयम्|पेप्रीयणीयम्|प्रीण्यम्|पिप्रीणयिष्यम्|प्रेयम्|पिप्रीष्यम्|पेप्रीय्यम्|ईषत्प्रीणः-दुष्प्रीणः-सुप्रीणः|ईषत्प्रयः-दुष्प्रयः-सुप्रयः|प्रीण्यमानः|पिप्रीणयिष्यमाणः|प्रीयमाणः|पिप्रीष्यमाणः|पेप्रीय्यमाणः|पिप्रीणयिषः|प्रयः|पिप्रीषः|पेप्रीयः|प्रीणयितुम्|पिप्रीणयिषितुम्|प्रेतुम्|पिप्रीषितुम्|पेप्रीयितुम्|प्रीणना|पिप्रीणयिषा|प्रीतिः|पिप्रीषा|पेप्रीया|प्रीणनम्|पिप्रीणयिषणम्|प्रयणम्|पिप्रीषणम्|पेप्रीयणम्|प्रीणयित्वा|पिप्रीणयिषित्वा|प्रीत्वा|पिप्रीषित्वा|पेप्रीयित्वा|विप्रीण्य|विपिप्रीणयिष्य|विप्रीय|विपिप्रीष्य|विपेप्रीय्य|प्रीणम्|पिप्रीणयिषम्|प्रायम्|पिप्रीषम्|पेप्रीयम्
<ul><li><sup id="ref_krm_1083_01"><a href="#foot_krm_1083_01">1</a></sup> {@“प्रीञ् तर्पणे”@} <sup id="ref_krm_1083_02"><a href="#foot_krm_1083_02">2</a></sup> आधृषीयः। </li> <li>‘--यौ ञित्त्वसाफल्यात् प्रीणयेत् प्रयते प्रयेत्।’ <sup id="ref_krm_1083_03"><a href="#foot_krm_1083_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_1083_04"><a href="#foot_krm_1083_04">4</a></sup> प्रीणकः-णिका, <sup id="ref_krm_1083_05"><a href="#foot_krm_1083_05">5</a></sup> प्रायकः-यिका, <sup id="ref_krm_1083_06"><a href="#foot_krm_1083_06">6</a></sup> पिप्रीणयिषकः-पिप्राययिषकः-षिका, <sup id="ref_krm_1083_07"><a href="#foot_krm_1083_07">7</a></sup> प्रायकः-यिका, <sup id="ref_krm_1083_08"><a href="#foot_krm_1083_08">8</a></sup> पिप्रीषकः-षिका, <sup id="ref_krm_1083_09"><a href="#foot_krm_1083_09">9</a></sup> पेप्रीयकः-यिका;</li> <li>  प्रीणयिता-त्री, पिप्रीणयिषिता-त्री, प्रेता-त्री, पिप्रीषिता-त्री, पेप्रीयिता-त्री;</li> <li>  प्रीणयन्-न्ती, पिप्रीणयिषन्-न्ती, <sup id="ref_krm_1083_10"><a href="#foot_krm_1083_10">10</a></sup> प्रयन् <sup id="ref_krm_1083_11"><a href="#foot_krm_1083_11">11</a></sup> -न्ती, पिप्रीषन्-न्ती;</li> <li>  -- <sup id="ref_krm_1083_12"><a href="#foot_krm_1083_12">12</a></sup> प्रीणयिष्यन्-पिप्रीणयिषिष्यन्-न्ती-ती, प्रेष्यन्-न्ती-ती, पिप्रीषिष्यन्-न्ती-ती;</li> <li>  मित्रप्रीः-मित्रप्रियौ-मित्रप्रियः;</li> <li>  -- प्रीणितम्-तः, पिप्रीणयिषितः-तवान्, प्रीतम्-तः, पिप्रीषितः, पेप्रीयितः-तवान्;</li> <li>  प्रीणः, पिप्रीणयिषुः, प्रियः, पिप्रीषुः, प्रेप्रियः;</li> <li>  प्रीणयितव्यम्, पिप्रीणयिषितव्यम्, प्रेतव्यम्, पिप्रीषितव्यम्, प्रेप्रीयितव्यम्;</li> <li>  प्रीणनीयम्, पिप्रीणयिषणीयम्, प्रयणीयम्, पिप्रीषणीयम्, पेप्रीयणीयम्;</li> <li>  प्रीण्यम्, पिप्रीणयिष्यम्, प्रेयम्, पिप्रीष्यम्, पेप्रीय्यम्;</li> <li>  ईषत्प्रीणः-दुष्प्रीणः-सुप्रीणः, ईषत्प्रयः-दुष्प्रयः-सुप्रयः;</li> <li>  -- -- प्रीण्यमानः, पिप्रीणयिष्यमाणः, प्रीयमाणः, पिप्रीष्यमाणः, पेप्रीय्यमाणः;</li> <li>  प्रीणः, पिप्रीणयिषः, <sup id="ref_krm_1083_13"><a href="#foot_krm_1083_13">13</a></sup> प्रयः, पिप्रीषः, पेप्रीयः;</li> <li>  प्रीणयितुम्, पिप्रीणयिषितुम्, प्रेतुम्, पिप्रीषितुम्, पेप्रीयितुम्;</li> <li>  प्रीणना, पिप्रीणयिषा, प्रीतिः, पिप्रीषा, पेप्रीया;</li> <li>  प्रीणनम्, पिप्रीणयिषणम्, प्रयणम्, पिप्रीषणम्, पेप्रीयणम्;</li> <li>  प्रीणयित्वा, पिप्रीणयिषित्वा, प्रीत्वा, पिप्रीषित्वा, पेप्रीयित्वा;</li> <li>  विप्रीण्य, विपिप्रीणयिष्य, विप्रीय, विपिप्रीष्य, विपेप्रीय्य;</li> <li>  प्रीणम् २, प्रीणयित्वा २, पिप्रीणयिषम् २, पिप्रीणयिषित्वा २, प्रायम् २, प्रीत्वा २, पिप्रीषम् २, पिप्रीषित्वा २, पेप्रीयम् २;</li> <li>  पेप्रीयित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1083_01"><a href="#ref_krm_1083_01">↑</a> (१०७३)</li> <li id="foot_krm_1083_02"><a href="#ref_krm_1083_02">↑</a> (१०-चुरादिः-१८३७। सक। सेट्। उभ।)</li> <li id="foot_krm_1083_03"><a href="#ref_krm_1083_03">↑</a> (श्लो। २०)</li> <li id="foot_krm_1083_04"><a href="#ref_krm_1083_04">↑</a> [[३। ‘धूञ्प्रीञोर्नुग् वक्तव्यः’ (वा। ७-३-३७) इति ण्यन्ते सर्वत्र नुगागमो भवति। एतच्चाविशेषेण ण्यन्ते सर्वत्रेति मतेन लिखितम्।]]</li> <li id="foot_krm_1083_05"><a href="#ref_krm_1083_05">↑</a> [[४। ‘धूञ्प्रीञोः--’ (वा। ७-३-३७) इति नुगागमः ‘धूञ्’ साहचर्येण क्रैयादिकस्य प्रीणातेर्णावेवेति, हरदत्तादिमते तु नुगभावात् वृद्धौ, आयादेशे च रूपमेवम्। एवमेव तृजादिष्वपि प्राययिता-त्री इत्यादीनि रूपाणि यथायथमूह्यानि।]]</li> <li id="foot_krm_1083_06"><a href="#ref_krm_1083_06">↑</a> [[५। चुरादिप्रीञोऽपि नुगागमवादिनां पक्षे ण्यन्तात् सनि रूपमेवम्। हरदत्तादिमते तु पिप्राययिषकः इत्यादीनि रूपाणीति च ज्ञेयम्।]]</li> <li id="foot_krm_1083_07"><a href="#ref_krm_1083_07">↑</a> [[६। ‘आधृषाद् वा’ (ग। सू। चुरादौ) इति वचनेन णिचो वैकल्पिकत्वात्, णिजभावपक्षे शुद्धाद्रूपमेवम्।]]</li> <li id="foot_krm_1083_08"><a href="#ref_krm_1083_08">↑</a> [[७। णिजभावपक्षे सनि, ‘एकाच उपदेशे--’ (७-२-१०) इतीण्निषेधे, सनः कित्त्वे, दीर्घे च रूपम्। धातोरस्य चुरादिपठितस्य सेट्त्वेऽपि णिजभावपक्षे भ्वादिपाठेऽनिट्त्वं शास्त्रवशादिति ज्ञेयम्।]]</li> <li id="foot_krm_1083_09"><a href="#ref_krm_1083_09">↑</a> [[८। णिजभावपक्षे शुद्धात् यङन्ते रूपमेवमिति ज्ञेयम्।]]</li> <li id="foot_krm_1083_10"><a href="#ref_krm_1083_10">↑</a> [[९। णिजभावपक्षे शुद्धात्, ‘शेषात् कतरि--’ (१-३-७८) इति शतैव।]]</li> <li id="foot_krm_1083_11"><a href="#ref_krm_1083_11">↑</a> [[आ। ‘… स्वैरं तत्र जनान् प्रयन् विगलितश्रन्थान् कचान् ग्रन्थयन्।’ धा। का। ३। ५१।]]</li> <li id="foot_krm_1083_12"><a href="#ref_krm_1083_12">↑</a> [पृष्ठम्०९०५+ २५]</li> <li id="foot_krm_1083_13"><a href="#ref_krm_1083_13">↑</a> [[१। ‘एरच्’ (३-३-५६) इति भावे घञपवादोऽप्प्रत्ययः। ‘एरजण्यन्तानाम्’ इति मतं तु भाष्या सम्मतत्वादप्रामाणिकम्। स्पष्टमिदं कैयटे (३-२-१)।]]</li></ul></p>

प्रुङ्|प्रावकः-विका|पुप्रूषकः-षिका|पोप्रूयकः-यिका|पिप्रावयिषकः-पुप्रावयिषकः-षिका
<ul><li><sup id="ref_krm_1084_01"><a href="#foot_krm_1084_01">1</a></sup> {@“प्रुङ् गतौ”@} <sup id="ref_krm_1084_02"><a href="#foot_krm_1084_02">2</a></sup> प्रावकः-विका, प्रावकः-विका, पुप्रूषकः-षिका, पोप्रूयकः-यिका, <sup id="ref_krm_1084_03"><a href="#foot_krm_1084_03">3</a></sup> पिप्रावयिषकः-पुप्रावयिषकः-षिका;</li> <li>  प्रोता-त्री, प्रावयिता-त्री, पुप्रूषिता-त्री, पोप्रूयिता-त्री, पिप्रावयिषिता- पुप्रावयिषिता-त्री, इत्यादीनि सर्वाण्यपि रूपाणि च्यवतिवत् <sup id="ref_krm_1084_04"><a href="#foot_krm_1084_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1084_05"><a href="#foot_krm_1084_05">5</a></sup> <sup id="ref_krm_1084_06"><a href="#foot_krm_1084_06">6</a></sup> कटप्रूः-कटप्रुवौ-कटप्रुवः, <sup id="ref_krm_1084_07"><a href="#foot_krm_1084_07">7</a></sup> प्रवकः, <sup id="ref_krm_1084_08"><a href="#foot_krm_1084_08">8</a></sup> प्रवणः, <sup id="ref_krm_1084_09"><a href="#foot_krm_1084_09">9</a></sup> प्रावयन्-प्रावयिष्यन्-न्ती-ती, इति इमानि रूपाणि अस्य धातोः भवन्तीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1084_01"><a href="#ref_krm_1084_01">↑</a> (१०७४)</li> <li id="foot_krm_1084_02"><a href="#ref_krm_1084_02">↑</a> (१-भ्वादिः-९५७। सक। अनि। आत्म।)</li> <li id="foot_krm_1084_03"><a href="#ref_krm_1084_03">↑</a> [[२। ‘स्रवति शृणोतिद्रवति प्रवति--’ (७-४-८१) इत्यनेन ण्यन्तात् सनि अवर्णपरे यणि च उवर्णान्तस्याभ्यासस्येकारादेशो वा भवति। इयमप्राप्तविभाषा। एवं ण्यन्तात् सनि सर्वत्र रूपद्वयं ज्ञेयम्।]]</li> <li id="foot_krm_1084_04"><a href="#ref_krm_1084_04">↑</a> (५५८)</li> <li id="foot_krm_1084_05"><a href="#ref_krm_1084_05">↑</a> [पृष्ठम्०९०६+ २८]</li> <li id="foot_krm_1084_06"><a href="#ref_krm_1084_06">↑</a> [[१। कटं प्रवते इति कटप्रूः = कामरूपी कीटश्च। ‘क्विब्वचिप्रच्छ्यायतस्तुकटप्रुजु- श्रीणां दीर्घोऽसम्प्रसारणं च’ (वा। ३-२-१७८) इत्यनेन सोपपदात् क्विपि प्रकृतेर्दीर्घः। द्विवचनादिषु उवङादेशः।]]</li> <li id="foot_krm_1084_07"><a href="#ref_krm_1084_07">↑</a> [[२। ‘प्रुसृल्वः समभिहारे वुन्’ (३-१-१४९) इति कर्तरि वुन्प्रत्ययः। अनादेशः। समभिहारः = साधुकारित्वम्।]]</li> <li id="foot_krm_1084_08"><a href="#ref_krm_1084_08">↑</a> [[३। ‘चलनशब्दार्थादकर्मकाद् युच्’ (३-२-१४८) इति तच्छीलादिषु कर्तृषु युच् प्रत्ययः। णत्वम्। अकर्मकत्वं विवक्षाभेदेनेति ज्ञेयम्।]]</li> <li id="foot_krm_1084_09"><a href="#ref_krm_1084_09">↑</a> [[४। ‘बुधयुधनशजनेङ्प्रुद्रुस्रुभ्यो णेः’ (१-३-८६) इति र्क्तृगामिन्यपि क्रियाफले ण्यन्तात् शतैव, न शानच्।]]</li></ul></p>

प्रुष|प्रोषकः-षिका|पुप्रोषिषकः-पुप्रुषिषकः-षिका|पोप्रुषकः-|षिका
<ul><li><sup id="ref_krm_1085_01"><a href="#foot_krm_1085_01">1</a></sup> {@“प्रुष स्नेहनसेवनपूरणेषु”@} <sup id="ref_krm_1085_02"><a href="#foot_krm_1085_02">2</a></sup> ‘--सेचन…’ इति क्षीरस्वामि-पुरुषकार-कविकल्पद्रुमसम्मतः पाठः। </li> <li>मैत्रेयस्तु ‘… मोचन…’ इति पपाठ। </li> <li>‘मोहनदाहनयोरप्याह शङ्करः। </li> <li>इति धा। </li> <li>का। </li> <li>व्याख्या <sup id="ref_krm_1085_03"><a href="#foot_krm_1085_03">3</a></sup>। </li> <li>अयं ‘प्रूष--’ इति दीर्घोपघ इति बालमनोरमा। </li> <li>‘--स्नेहनादिषु। </li> <li>प्रुष्णाति च, प्रोषति च दाहे--।।’ <sup id="ref_krm_1085_04"><a href="#foot_krm_1085_04">4</a></sup> इति देवः। </li> <li>प्रोषकः-षिका, प्रोषकः-षिका, पुप्रोषिषकः-पुप्रुषिषकः-षिका, पोप्रुषकः- षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकपोषतिवत् <sup id="ref_krm_1085_05"><a href="#foot_krm_1085_05">5</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1085_06"><a href="#foot_krm_1085_06">6</a></sup> विप्रुट्। </li> <li><sup id="ref_krm_1085_07"><a href="#foot_krm_1085_07">7</a></sup> प्रुष्णन् <sup id="ref_krm_1085_08"><a href="#foot_krm_1085_08">8</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1085_01"><a href="#ref_krm_1085_01">↑</a> (१०७५)</li> <li id="foot_krm_1085_02"><a href="#ref_krm_1085_02">↑</a> (९-क्र्यादिः-१५२७। सक। सेट्। पर।)</li> <li id="foot_krm_1085_03"><a href="#ref_krm_1085_03">↑</a> (३-१२)</li> <li id="foot_krm_1085_04"><a href="#ref_krm_1085_04">↑</a> (श्लो। १७२)</li> <li id="foot_krm_1085_05"><a href="#ref_krm_1085_05">↑</a> (१०२६)</li> <li id="foot_krm_1085_06"><a href="#ref_krm_1085_06">↑</a> [[५। क्विपि षकारस्य जश्त्वेन डकारः। विप्रुट् = पामा।]]</li> <li id="foot_krm_1085_07"><a href="#ref_krm_1085_07">↑</a> [[६। शतरि क्रैयादिकत्वात् श्नाप्रत्यये, ‘श्नाऽभ्यस्तयोः--’ (६-४-११२) इत्याकारलोपे णत्वे च रूपम्।]]</li> <li id="foot_krm_1085_08"><a href="#ref_krm_1085_08">↑</a> [[आ। ‘प्रुष्णन् सतां प्रियमयं प्लुषिताङ्गरागः…।’ धा। का। ३। १२।]]</li></ul></p>

प्रुषु
<ul><li><sup id="ref_krm_1086_01"><a href="#foot_krm_1086_01">1</a></sup> {@“प्रुषु दाहे”@} <sup id="ref_krm_1086_02"><a href="#foot_krm_1086_02">2</a></sup> ‘--स्नेहनादिषु। </li> <li>प्रुष्णाति च, प्रोषति च दाहे--।।’ <sup id="ref_krm_1086_03"><a href="#foot_krm_1086_03">3</a></sup> इति देवः। </li> <li>प्रोषकः-षिका, प्रोषकः, पुप्रोषिषकः-पुप्रुषिषकः-षिका, पोप्रुषकः-षिका-इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकपोषतिवत् <sup id="ref_krm_1086_04"><a href="#foot_krm_1086_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1086_05"><a href="#foot_krm_1086_05">5</a></sup> प्रोषित्वा-प्रुष्ट्वा, <sup id="ref_krm_1086_06"><a href="#foot_krm_1086_06">6</a></sup> <sup id="ref_krm_1086_07"><a href="#foot_krm_1086_07">7</a></sup> प्रुष्टम्-प्रुष्टवान् इति रूपाण्यस्माद्भवन्तीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1086_01"><a href="#ref_krm_1086_01">↑</a> (१०७६)</li> <li id="foot_krm_1086_02"><a href="#ref_krm_1086_02">↑</a> (१-भ्वादिः-७०३। सक। सेट्। पर।)</li> <li id="foot_krm_1086_03"><a href="#ref_krm_1086_03">↑</a> (श्लो। १७२)</li> <li id="foot_krm_1086_04"><a href="#ref_krm_1086_04">↑</a> (१०२६)</li> <li id="foot_krm_1086_05"><a href="#ref_krm_1086_05">↑</a> [[७। ‘उदितो वा’ (७-२-५६) इति क्त्वायामिड्विकल्पः। इट्पक्षे ‘न क्त्वा सेट्’ (१-२-१८) इति कित्त्वनिषेधात् प्रोषित्वा इति रूपम्।]]</li> <li id="foot_krm_1086_06"><a href="#ref_krm_1086_06">↑</a> [पृष्ठम्०९०७+ २६]</li> <li id="foot_krm_1086_07"><a href="#ref_krm_1086_07">↑</a> [[१। निष्ठायाम्, ‘यस्य विभाषा’ (७-२-१५) इति इण्निषेधः।]]</li></ul></p>

प्रेषृ|प्रेषकः-षिका|पिप्रेषिषकः-षिका|पेप्रेषकः-षिका
<ul><li><sup id="ref_krm_1087_01"><a href="#foot_krm_1087_01">1</a></sup> {@“प्रेषृ गतौ”@} <sup id="ref_krm_1087_02"><a href="#foot_krm_1087_02">2</a></sup> प्रेषकः-षिका, प्रेषकः-षिका, पिप्रेषिषकः-षिका, पेप्रेषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककेपतिवत् <sup id="ref_krm_1087_03"><a href="#foot_krm_1087_03">3</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1087_01"><a href="#ref_krm_1087_01">↑</a> (१०७७)</li> <li id="foot_krm_1087_02"><a href="#ref_krm_1087_02">↑</a> (१-भ्वादिः-६१९। सक। सेट्। आत्म।)</li> <li id="foot_krm_1087_03"><a href="#ref_krm_1087_03">↑</a> (२६१)</li></ul></p>

प्रैणृ
<ul><li><sup id="ref_krm_1088_01"><a href="#foot_krm_1088_01">1</a></sup> {@“प्रैणृ गतिप्रेरणश्लेषणेषु”@} <sup id="ref_krm_1088_02"><a href="#foot_krm_1088_02">2</a></sup> ‘पैणृ--’ इति धातोः पाठभेदोऽयम्। </li> <li>सर्वाण्यपि रूपाणि भौवादिककेपृधातु- वत् <sup id="ref_krm_1088_03"><a href="#foot_krm_1088_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1088_04"><a href="#foot_krm_1088_04">4</a></sup> प्रैणनम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1088_01"><a href="#ref_krm_1088_01">↑</a> (१०७८)</li> <li id="foot_krm_1088_02"><a href="#ref_krm_1088_02">↑</a> (१-भ्वादिः-४५८। सक। सेट्। पर।)</li> <li id="foot_krm_1088_03"><a href="#ref_krm_1088_03">↑</a> (२६१)</li> <li id="foot_krm_1088_04"><a href="#ref_krm_1088_04">↑</a> [[आ। ‘प्रश्लोणितान् प्रैणनविध्रणत्क्षितीन् अनुल्बणान् धेनुगणान् कनत्स्तनान्।।’ धा। का। १। ५९।]]</li></ul></p>

प्रोथृ|प्रोथकः-थिका|पुप्रोथिषकः-पुप्रुथिषकः-षिका|पोप्रुथकः-थिका
<ul><li><sup id="ref_krm_1089_01"><a href="#foot_krm_1089_01">1</a></sup> {@“प्रोथृ पर्याप्तौ”@} <sup id="ref_krm_1089_02"><a href="#foot_krm_1089_02">2</a></sup> ‘प्रोथति = सूदति’ इति ‘प्रोथदश्वो न यवसे--’ <sup id="ref_krm_1089_03"><a href="#foot_krm_1089_03">3</a></sup> इति मन्त्रव्याख्यायां व्याख्यानात्, ‘अपप्रोथ दुन्दुभे दुच्छुनाम्--’ <sup id="ref_krm_1089_04"><a href="#foot_krm_1089_04">4</a></sup> इत्यत्र, ‘अपप्रोथ = मारय--’ इति व्याख्यानाच्च भट्टभास्करमते हिंसार्थकोऽयं धातुः इति मा। </li> <li>धा। </li> <li>वृत्तिदर्शनाज्ज्ञायते। </li> <li>“--पर्याप्तिगतौ’ इत्यपि क्वचिदर्थनिर्देशः कृतः। </li> <li>‘अपप्रोथनम् = हुङ्करणम्।’ इति क्षुरे।” इत्यपि मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>‘शब्दार्थोऽपि। </li> <li>अपपूर्वस्तु मारणे हुङ्करणे वा’ इति धा। </li> <li>का। </li> <li>व्याख्याने <sup id="ref_krm_1089_05"><a href="#foot_krm_1089_05">5</a></sup>। </li> <li>भाष्यप्रदीपोद्योतात् <sup id="ref_krm_1089_06"><a href="#foot_krm_1089_06">6</a></sup> नायं धातुरिति ज्ञायते। </li> <li>प्रोथकः-थिका, प्रोथकः-थिका, पुप्रोथिषकः-पुप्रुथिषकः-षिका, पोप्रुथकः-थिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककेपतिवत् <sup id="ref_krm_1089_07"><a href="#foot_krm_1089_07">7</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1089_08"><a href="#foot_krm_1089_08">8</a></sup> प्रोथः = अश्वादीनां नासारज्जुः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1089_01"><a href="#ref_krm_1089_01">↑</a> (१०७९)</li> <li id="foot_krm_1089_02"><a href="#ref_krm_1089_02">↑</a> (१-भ्वादिः-८६७। सक। सेट्। उभ।)</li> <li id="foot_krm_1089_03"><a href="#ref_krm_1089_03">↑</a> (तैत्ति। सं। ४। ४। ३। ३)</li> <li id="foot_krm_1089_04"><a href="#ref_krm_1089_04">↑</a> (तैत्तिरीय- संहिता ४। ६। ६। ७)</li> <li id="foot_krm_1089_05"><a href="#ref_krm_1089_05">↑</a> (२। २५)</li> <li id="foot_krm_1089_06"><a href="#ref_krm_1089_06">↑</a> (१-४-५६)</li> <li id="foot_krm_1089_07"><a href="#ref_krm_1089_07">↑</a> (२६१)</li> <li id="foot_krm_1089_08"><a href="#ref_krm_1089_08">↑</a> [[२। ‘हलश्च’ (३-३-१२१) इति संज्ञायां करणे घञ्।]]</li></ul></p>

प्लिह|प्लेहकः-हिका|पिप्लिहिषकः-पिप्लेहिषकः-षिका|पेप्लिहकः-हिका
<ul><li><sup id="ref_krm_1090_01"><a href="#foot_krm_1090_01">1</a></sup> {@“प्लिह गतौ”@} <sup id="ref_krm_1090_02"><a href="#foot_krm_1090_02">2</a></sup> प्लेहकः-हिका, प्लेहकः-हिका, पिप्लिहिषकः-पिप्लेहिषकः-षिका, पेप्लिहकः-हिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि दैवादिकक्लिश्यतिवत् <sup id="ref_krm_1090_03"><a href="#foot_krm_1090_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1090_04"><a href="#foot_krm_1090_04">4</a></sup> इत्यादिना कनिन्प्रत्ययान्तो निपातितः। </li> <li>प्लीहा = कुक्षिव्याधिः, अध्वगश्च।]] प्लीहा। </li> <li><sup id="ref_krm_1090_05"><a href="#foot_krm_1090_05">5</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1090_01"><a href="#ref_krm_1090_01">↑</a> (१०८०)</li> <li id="foot_krm_1090_02"><a href="#ref_krm_1090_02">↑</a> (१-भ्वादिः-६४२। सक। सेट्। आत्म।)</li> <li id="foot_krm_1090_03"><a href="#ref_krm_1090_03">↑</a> (२८७)</li> <li id="foot_krm_1090_04"><a href="#ref_krm_1090_04">↑</a> [[३। ‘श्वन्नुक्षन्--’ [द। उ। ६। ५५।]</li> <li id="foot_krm_1090_05"><a href="#ref_krm_1090_05">↑</a> [पृष्ठम्०९०८+ २४]</li></ul></p>

