<ul><li><sup id="ref_krm_0876_01"><a href="#foot_krm_0876_01">1</a></sup> {@“दृह वृद्धौ”@} <sup id="ref_krm_0876_02"><a href="#foot_krm_0876_02">2</a></sup> दर्हकः-र्हिका, दर्हकः-र्हिका, दिदर्हिषकः-षिका, <sup id="ref_krm_0876_03"><a href="#foot_krm_0876_03">3</a></sup> दरीदृहकः-हिका;</li> <li>  दर्हिता-त्री, दर्हयिता-त्री, दिदर्हिषिता-त्री, दरीदृहिता-त्री;</li> <li>  दर्हन्-न्ती, दर्हयन्-न्ती, दिदर्हिषन्-न्ती;</li> <li>  -- दर्हिष्यन्-न्ती-ती, दर्हयिष्यन्-न्ती-ती, दिदर्हिषिष्यन्-न्ती-ती;</li> <li>  -- -- दर्हयमाणः, दर्हयिष्यमाणः, -- दरीदृह्यमाणः, दरीदृहिष्यमाणः;</li> <li>  <sup id="ref_krm_0876_04"><a href="#foot_krm_0876_04">4</a></sup> प्रदृक्-प्रदृग्-प्रदृहौ-प्रदृहः;</li> <li>  -- -- -- दृहितम्-तः-तवान्, <sup id="ref_krm_0876_05"><a href="#foot_krm_0876_05">5</a></sup> दृढः, दर्हितः, दिदर्हिषितः, दरीदृहितः-तवान्;</li> <li>  दृहः, संदर्ही, दर्हः, दिदर्हिषुः, दरीदर्हः;</li> <li>  दर्हितव्यम्, दर्हयितव्यम्, दिदर्हिषितव्यम्, दरीदृहितव्यम्;</li> <li>  दर्हणीयम्, दर्हणीयम्, दिदर्हिषणीयम्, दरीदृहणीयम्;</li> <li>  <sup id="ref_krm_0876_06"><a href="#foot_krm_0876_06">6</a></sup> दृह्यम्, दर्ह्यम्, दिदर्हिष्यम्, दरीदृह्यम्;</li> <li>  <sup id="ref_krm_0876_07"><a href="#foot_krm_0876_07">7</a></sup> ईषद्दर्हः-दुर्दर्हः-सुदर्हः;</li> <li>  -- -- -- दृह्यमाणः, दर्ह्यमाणः, दिदर्हिष्यमाणः, दरीदृह्यमाणः;</li> <li>  दर्हः, दर्हः, दिदर्हिषः, दरीदृहः;</li> <li>  दर्हितुम्, दर्हयितुम्, दिदर्हिषितुम्, दरीदृहितुम्;</li> <li>  <sup id="ref_krm_0876_08"><a href="#foot_krm_0876_08">8</a></sup> दृग्धिः, दर्हणा, दिदर्हिषा, दरीदृहा;</li> <li>  दर्हणम्, दर्हणम्, दिदर्हिषणम्, दरीदृहणम्;</li> <li>  दर्हित्वा, दर्हयित्वा, दिदर्हिषित्वा, दरीदृहित्वा;</li> <li>  प्रदृह्य, प्रदर्ह्य, प्रदिदर्हिष्य, प्रदरीदृह्य;</li> <li>  दर्हम् २, दर्हित्वा २, दर्हम् २, दर्हयित्वा २, दिदर्हिषम् २, दिदर्हिषित्वा २, दरीदृहम् २;</li> <li>  दरीदृहित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0876_01"><a href="#ref_krm_0876_01">↑</a> (८६६)</li> <li id="foot_krm_0876_02"><a href="#ref_krm_0876_02">↑</a> (१-भ्वादिः-७३३। अक। सेट्। पर।)</li> <li id="foot_krm_0876_03"><a href="#ref_krm_0876_03">↑</a> [[३। यङन्तात् ण्वुलि, ‘रीगृदुपधस्य च’ (७-४-९०) इति रीगागमः। एवं यङन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0876_04"><a href="#ref_krm_0876_04">↑</a> [[४। क्विपि, ‘दादेर्धातोर्घः’ (८-२-३२) इति घत्वे, जश्त्वचर्त्वयो रूपम्।]]</li> <li id="foot_krm_0876_05"><a href="#ref_krm_0876_05">↑</a> [[५। ‘दृढः स्थूलबलयोः’ (७-२-२०) इति, निष्ठायामिडभावहकारलोपढत्वानां निपातनात् स्थूले बले च वाच्ये रूपसिद्धिः। एतच्च ‘दृहिः प्रकृत्यन्तरमस्ति’ इति भाष्यकारवचनात् (१-१-४) ज्ञायते। वार्तिककारमते तु दृहि इति इदितो धातोरेवैतन्निपातनम्, न त्वस्येति ज्ञायते।]]</li> <li id="foot_krm_0876_06"><a href="#ref_krm_0876_06">↑</a> [[६। ‘ऋदुपधाच्च--’ (३-१-११०) इति क्यप्।]]</li> <li id="foot_krm_0876_07"><a href="#ref_krm_0876_07">↑</a> [पृष्ठम्०७६८+ २५]</li> <li id="foot_krm_0876_08"><a href="#ref_krm_0876_08">↑</a> [[१। क्तिनि, घत्वधत्वयो रूपम्।]]</li></ul></p>

दृहि|दृंहकः-हिका|दृंहकः-हिका-दिदृंहिषकः-षिका|दरीदृंहकः-हिका
<ul><li><sup id="ref_krm_0877_01"><a href="#foot_krm_0877_01">1</a></sup> {@“दृहि वृद्धौ”@} <sup id="ref_krm_0877_02"><a href="#foot_krm_0877_02">2</a></sup> दृंहकः-हिका, दृंहकः-हिका-दिदृंहिषकः-षिका, दरीदृंहकः-हिका;</li> <li>  इत्या- नीतराणि सर्वाण्यपि रूपाणि दृहधातुवत् <sup id="ref_krm_0877_03"><a href="#foot_krm_0877_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0877_04"><a href="#foot_krm_0877_04">4</a></sup> दृढः, <sup id="ref_krm_0877_05"><a href="#foot_krm_0877_05">5</a></sup> दृंहा इति निष्ठायां, स्त्रियां च रूपे अस्य धातोः भवतः। </li> <li>नुम् सर्वत्र भवतीति च विशेषः। </li> <li><sup id="ref_krm_0877_06"><a href="#foot_krm_0877_06">6</a></sup> दृंहितः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0877_01"><a href="#ref_krm_0877_01">↑</a> (८६७)</li> <li id="foot_krm_0877_02"><a href="#ref_krm_0877_02">↑</a> (१-भ्वादिः-७३४। अक। सेट्। पर।)</li> <li id="foot_krm_0877_03"><a href="#ref_krm_0877_03">↑</a> (८६६)</li> <li id="foot_krm_0877_04"><a href="#ref_krm_0877_04">↑</a> [[२। ‘दृढः स्थूलबलयोः’ (७-२-२०) इत्यनेन स्थूले बले च वाच्ये, धातोरस्य क्तप्रत्ययस्येडभावः नकारहकारलोपः, निष्ठातकारस्य ढत्वं च निपात्यते। अन्यत्र दृंहितम्-दृंहितवान् इत्येव रूपे।]]</li> <li id="foot_krm_0877_05"><a href="#ref_krm_0877_05">↑</a> [[३। स्त्रियाम्, ‘गुरोश्च हलः’ (३-३-१०३) इत्यकारप्रत्ययः।]]</li> <li id="foot_krm_0877_06"><a href="#ref_krm_0877_06">↑</a> [[आ। ‘तच्छ्रुत्वा परिद्वंहितादरमसौ नन्दो बृहद्भोजनैः--।’ धा। का। १। ९२।]]</li></ul></p>

