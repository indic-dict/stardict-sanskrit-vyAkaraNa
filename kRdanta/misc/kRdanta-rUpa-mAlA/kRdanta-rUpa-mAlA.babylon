<ul><li><sup id="ref_krm_0243_01"><a href="#foot_krm_0243_01">1</a></sup> {@“कूङ् शब्दे”@} <sup id="ref_krm_0243_02"><a href="#foot_krm_0243_02">2</a></sup> कुटादिः। </li> <li><sup id="ref_krm_0243_03"><a href="#foot_krm_0243_03">3</a></sup> ‘कुङ् शब्दे’ <sup id="ref_krm_0243_04"><a href="#foot_krm_0243_04">4</a></sup> इति धातोः कैयटहरदत्तादिमतानुसारेण पाठमेदोऽयम्।]] ‘अव्यक्तशब्दे कवते, कुवते त्वार्तशब्दने। </li> <li>कौतीति शब्दमात्रे स्यात्--’ <sup id="ref_krm_0243_05"><a href="#foot_krm_0243_05">5</a></sup> इति देवः। </li> <li>कावकः-विका, कावकः-विका, <sup id="ref_krm_0243_06"><a href="#foot_krm_0243_06">6</a></sup> चूकूषकः-षिका, चोकूयकः-यिका;</li> <li>  <sup id="ref_krm_0243_07"><a href="#foot_krm_0243_07">7</a></sup> कुविता-त्री, कावयिता-त्री, चुकूषिता-त्री, चोकूयिता-त्री;</li> <li>  -- कावयन्-न्ती, कावयिष्यन्-न्ती-ती;</li> <li>  -- <sup id="ref_krm_0243_08"><a href="#foot_krm_0243_08">8</a></sup> कुवमानः, <sup id="ref_krm_0243_09"><a href="#foot_krm_0243_09">9</a></sup> कावयमानः, चुकूषमाणः, चोकूयमानः;</li> <li>  कुविष्यमाणः, कावयिष्यमाणः, चुकूषिष्यमाणः, <sup id="ref_krm_0243_10"><a href="#foot_krm_0243_10">10</a></sup> चुकावयिषिष्यमाणः, चोकूयिष्यमाणः;</li> <li>  <sup id="ref_krm_0243_11"><a href="#foot_krm_0243_11">11</a></sup> कूः-कुवौ-कुवः;</li> <li>  -- -- -- <sup id="ref_krm_0243_12"><a href="#foot_krm_0243_12">12</a></sup> आकूतम्- <sup id="ref_krm_0243_13"><a href="#foot_krm_0243_13">13</a></sup> कूतम्-तः, कावितम्, चुकूषितः, चुकावयिषितः, चोकूयितः-तवान्;</li> <li>  कुवः, <sup id="ref_krm_0243_14"><a href="#foot_krm_0243_14">14</a></sup> कुवनः, कावः, चुकूषुः, चुकावयिषुः, चोकुवः;</li> <li>  कुवितव्यम्, कावयितव्यम्, चुकूषितव्यम्, चोकूयितव्यम्;</li> <li>  कुवनीयम्, कावनीयम्, चुकूषणीयम्, चोकूयनीयम्;</li> <li>  <sup id="ref_krm_0243_15"><a href="#foot_krm_0243_15">15</a></sup> कूयम्, <sup id="ref_krm_0243_16"><a href="#foot_krm_0243_16">16</a></sup> अवश्यकाव्यम्, काव्यम्, चुकूष्यम्, चोकूय्यम्;</li> <li>  ईषत्कुवः दुष्कुवः-सुकुवः;</li> <li>  -- -- <sup id="ref_krm_0243_17"><a href="#foot_krm_0243_17">17</a></sup> कूयमानः, काव्यमानः, चुकूष्यमाणः, चोकूय्यमानः;</li> <li>  <sup id="ref_krm_0243_18"><a href="#foot_krm_0243_18">18</a></sup> कुवः, कावः, चुकूषः, चुकावयिषः, चोकूयः;</li> <li>  कुवितुम्, कावयितुम्, चुकूषितुम्, चोकूयितुम्;</li> <li>  आकूतिः, कावना, चुकूषा, चुकावयिषा, चोकूया;</li> <li>  कुवनम्, कावनम्, चुकूषणम्, चोकूयनम्;</li> <li>  कूत्वा, कावयित्वा, चुकूषित्वा, चोकूयित्वा;</li> <li>  प्रकूय, प्रकाव्य, प्रचुकूष्य, प्रचोकूय्य;</li> <li>  कावम् २, कूत्वा २, कावम् २, कावयित्वा २, चुकूषम् २, चुकूषित्वा २, चोकूयम् २;</li> <li>  चोकूयित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0243_01"><a href="#ref_krm_0243_01">↑</a> (२३८)</li> <li id="foot_krm_0243_02"><a href="#ref_krm_0243_02">↑</a> (६-तुदादिः-१४०१। अक। सेट्। आत्म।)</li> <li id="foot_krm_0243_03"><a href="#ref_krm_0243_03">↑</a> [[[अ]</li> <li id="foot_krm_0243_04"><a href="#ref_krm_0243_04">↑</a> (१९९)</li> <li id="foot_krm_0243_05"><a href="#ref_krm_0243_05">↑</a> (श्लो-२३)</li> <li id="foot_krm_0243_06"><a href="#ref_krm_0243_06">↑</a> [[१। ‘इको झल्’ (१-२-९) इति सनः कित्त्वम्। ‘सनि ग्रहगुहोश्च’ (७-२-१२) इति इण्णिषेधः।]]</li> <li id="foot_krm_0243_07"><a href="#ref_krm_0243_07">↑</a> [[२। ‘गाङ्कुटादिभ्योऽञिणन्ङित्’ (१-२-१) इति ङित्त्वाद्गुणाभावः। ‘अचि श्नु--’ (६-४-७७) इत्युवङ्।]]</li> <li id="foot_krm_0243_08"><a href="#ref_krm_0243_08">↑</a> [[३। ‘तुदादिभ्यः शः’ (३-१-७७) इति शः। शस्य ङित्त्वादङ्गस्योवङ्।]]</li> <li id="foot_krm_0243_09"><a href="#ref_krm_0243_09">↑</a> [[आ। ‘नूत्या किं भयधूतविद्रुतगुवल्लोकं तदा तद्ध्रुव- त्कोदण्डं कुवमानमैक्षि दलितं भोजेश्वराकूतवत्।।’ धा। का। २-८२।]]</li> <li id="foot_krm_0243_10"><a href="#ref_krm_0243_10">↑</a> [[४। णिच्यच आदेशो न स्यात् द्वित्वे कर्तव्ये-- ‘पुयण्जि--’ इति शापकात्;\n\n  तस्मादभ्यासे उकारश्रवणम्।]]</li> <li id="foot_krm_0243_11"><a href="#ref_krm_0243_11">↑</a> [[५। प्रथमैकवचने सुप्रत्ययस्य रुत्वे विसर्गः।]]</li> <li id="foot_krm_0243_12"><a href="#ref_krm_0243_12">↑</a> [[आ। ‘नूत्या किं भयधूतविद्रुतगुवल्लोकं तदा तद्ध्रुव- त्कोदण्डं कुवमानमैक्षि दलितं भोजेश्वराकूतवत्।।’ धा। का। २-८२।]]</li> <li id="foot_krm_0243_13"><a href="#ref_krm_0243_13">↑</a> [[६। ‘श्रयुकः किति’ (७-२-११) इतीण्णिषेधः। एवं क्त्वायामपि। क्तिन्यप्येवमेव।]]</li> <li id="foot_krm_0243_14"><a href="#ref_krm_0243_14">↑</a> [[७। ‘चलनशब्दार्थादकर्मकाद्युच्’ (३-२-१४८) इति ताच्छीलिको युच्।]]</li> <li id="foot_krm_0243_15"><a href="#ref_krm_0243_15">↑</a> [[८। कुटादित्वप्रयुक्तङिद्वद्भावाद्गुणो न।]]</li> <li id="foot_krm_0243_16"><a href="#ref_krm_0243_16">↑</a> [[९। ‘ओरावश्यके’ (३-१-१२५) इति ण्यत्।]]</li> <li id="foot_krm_0243_17"><a href="#ref_krm_0243_17">↑</a> [पृष्ठम्०२२९+ २३]</li> <li id="foot_krm_0243_18"><a href="#ref_krm_0243_18">↑</a> [[१। ‘ॠदोरप्’ (३-३-५७) इत्यप् भावे।]]</li></ul></p>

