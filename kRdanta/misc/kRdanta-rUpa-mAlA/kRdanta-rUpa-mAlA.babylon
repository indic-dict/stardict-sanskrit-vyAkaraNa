<ul><li><sup id="ref_krm_0290_01"><a href="#foot_krm_0290_01">1</a></sup> {@“क्लमु ग्लानौ”@} <sup id="ref_krm_0290_02"><a href="#foot_krm_0290_02">2</a></sup> शमादिः। </li> <li><sup id="ref_krm_0290_03"><a href="#foot_krm_0290_03">3</a></sup> क्लमकः-मिका, <sup id="ref_krm_0290_04"><a href="#foot_krm_0290_04">4</a></sup> क्लमकः-मिका, चिक्लमिषकः-षिका, <sup id="ref_krm_0290_05"><a href="#foot_krm_0290_05">5</a></sup> चङ्क्लमकः-मिका;</li> <li>  क्लमिता-त्री, क्लमयिता-त्री, चिक्लमिषिता-त्री, चङ्क्लमिता-त्री;</li> <li>  <sup id="ref_krm_0290_06"><a href="#foot_krm_0290_06">6</a></sup> क्लाम्यन्-क्लामन्-न्ती, क्लमयन्-न्ती, चिक्लमिषन्-न्ती;</li> <li>  -- क्लमिष्यन्-न्ती-ती, क्लमयिष्यन्-न्ती-ती, चिक्लमिषिष्यन्-न्ती-ती;</li> <li>  -- <sup id="ref_krm_0290_07"><a href="#foot_krm_0290_07">7</a></sup> व्यतिक्लाममानः-व्यतिक्लाम्यमानः, क्लमयमानः, -- चङ्क्लम्यमानः;</li> <li>  व्यतिक्लमिष्यमाणः, क्लमयिष्यमाणः, -- चङ्क्लमिष्यमाणः;</li> <li>  <sup id="ref_krm_0290_08"><a href="#foot_krm_0290_08">8</a></sup> विक्लान्-विक्लामौ-विक्लामः;</li> <li>  -- -- <sup id="ref_krm_0290_09"><a href="#foot_krm_0290_09">9</a></sup> <sup id="ref_krm_0290_10"><a href="#foot_krm_0290_10">10</a></sup> क्लान्तम् <sup id="ref_krm_0290_11"><a href="#foot_krm_0290_11">11</a></sup> -क्लान्तः, क्लमितः, चिक्लमिषितः, चङ्क्लमितः-तवान्;</li> <li>  क्लमः, <sup id="ref_krm_0290_12"><a href="#foot_krm_0290_12">12</a></sup> क्लमी <sup id="ref_krm_0290_13"><a href="#foot_krm_0290_13">13</a></sup>, क्लमः, चिक्लमिषुः, चङ्क्लमः;</li> <li>  क्लमितव्यम्, क्लमयितव्यम्, चिक्लमिषितव्यम्, चङ्क्लमितव्यम्;</li> <li>  क्लमनीयम्, क्लमनीयम्, चिक्लमिषणीयम्, चङ्क्लमनीयम्;</li> <li>  <sup id="ref_krm_0290_14"><a href="#foot_krm_0290_14">14</a></sup> क्लम्यम्, <sup id="ref_krm_0290_15"><a href="#foot_krm_0290_15">15</a></sup> क्लम्यम्, चिक्लमिष्यम्, चङ्क्लम्यम्;</li> <li>  ईषत्क्लमः-दुष्क्लमः-सुक्लमः;</li> <li>  -- -- क्लम्यमानः, क्लम्यमानः, चिक्लमिष्यमाणः, चङ्क्लम्यमानः;</li> <li>  <sup id="ref_krm_0290_16"><a href="#foot_krm_0290_16">16</a></sup> क्लमः, क्लमः, चिक्लमिषः, चङ्क्लमः;</li> <li>  क्लमितुम्, क्लमयितुम्, चिक्लमिषितुम्, चङ्क्लमितुम्, <sup id="ref_krm_0290_17"><a href="#foot_krm_0290_17">17</a></sup> क्लान्तिः, क्लमना, चिक्लमिषा, चङ्क्लमा;</li> <li>  क्लमनम्, क्लमनम्, चिक्लमिषणम्, चङ्क्लमनम्;</li> <li>  <sup id="ref_krm_0290_18"><a href="#foot_krm_0290_18">18</a></sup> क्लमित्वा-क्लान्त्वा, क्लमयित्वा, चिक्लमिषित्वा, चङ्क्लमित्वा;</li> <li>  सङ्क्लम्य, <sup id="ref_krm_0290_19"><a href="#foot_krm_0290_19">19</a></sup> सङ्क्लमय्य, प्रचिक्लमिष्य, सञ्चङ्क्लम्य;</li> <li>  क्लमम् २, क्लमित्वा २-क्लान्त्वा २, <sup id="ref_krm_0290_20"><a href="#foot_krm_0290_20">20</a></sup> क्लमम् २ -क्लामम् २, क्लमयित्वा २, चिक्लमिषम् २, चिक्लमिषित्वा २, चङ्क्लमम् २;</li> <li>  चङ्क्लमित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0290_01"><a href="#ref_krm_0290_01">↑</a> (२८३)</li> <li id="foot_krm_0290_02"><a href="#ref_krm_0290_02">↑</a> (४-दिवादिः-अक। सेट्। पर।)</li> <li id="foot_krm_0290_03"><a href="#ref_krm_0290_03">↑</a> [[१। ‘नोदात्तोपदेशस्य मान्तस्यानाचमेः’ (७-३-३४) इति वृद्धिनिषेधः। एवं घञ्यपि।]]</li> <li id="foot_krm_0290_04"><a href="#ref_krm_0290_04">↑</a> [[२। ‘जनीजॄष्क्नसुरञ्जोऽमन्ताश्च’ (गणसूत्रं-घटादौ) इत्यमन्तत्वेन मित्त्वात् उपधायाः ह्रस्वो णौ।]]</li> <li id="foot_krm_0290_05"><a href="#ref_krm_0290_05">↑</a> [[३। ‘नुगतोऽनुनासिकान्तस्य’ (७-४-८५) इत्यभ्यासस्य नुक् सर्वत्र यङन्ते बोध्यम्।]]</li> <li id="foot_krm_0290_06"><a href="#ref_krm_0290_06">↑</a> [[४। ‘वा भ्राशभ्लाश--’ (३-१-७०) इत्यादिना श्यनो विकल्पः। ‘शमामष्टानां दीर्घः श्यनि’ (७-३-७४) इति दीर्घः। श्यनभावपक्षे औत्सर्गिके, ‘कर्तरि शप्’ (३-१-६८) इति शपि ‘ष्ठिवुक्लमुचमां शिति’ (७-३-७५) इति दीर्घः।]]</li> <li id="foot_krm_0290_07"><a href="#ref_krm_0290_07">↑</a> [[५। ‘कर्तरि कर्मव्यतीहारे’ (१-३-१४) इति शानच्।]]</li> <li id="foot_krm_0290_08"><a href="#ref_krm_0290_08">↑</a> [[६। ‘अनुनासिकस्य क्विझलोः--’ (६-४-१५) इति दीर्घे, ‘मो नो धातोः’ (८-२-६४) इति नकारः।]]</li> <li id="foot_krm_0290_09"><a href="#ref_krm_0290_09">↑</a> [पृष्ठम्०२९४+ २३]</li> <li id="foot_krm_0290_10"><a href="#ref_krm_0290_10">↑</a> [[१। उदित्त्वात् ‘यस्य विभाषा’ (७-२-१५) इतीण्णिषेधः। दीर्घः।]]</li> <li id="foot_krm_0290_11"><a href="#ref_krm_0290_11">↑</a> [[आ। ‘भ्राम्यामि भोः क्षाम्य ममापराधं क्लान्तं मनो माद्यति दर्शनात्ते।।’ धा। का। २। ६५।]]</li> <li id="foot_krm_0290_12"><a href="#ref_krm_0290_12">↑</a> [[२। ‘शमित्यष्टाभ्यो घिनुण्’ (३-२-१४१) इति ताच्छीलिको घिनुण्।]]</li> <li id="foot_krm_0290_13"><a href="#ref_krm_0290_13">↑</a> [[B। ‘क्लमित्वं कुरुतेऽत्यथं मेघशीकरशीतलः।।’ भ। का। ७-५।]]</li> <li id="foot_krm_0290_14"><a href="#ref_krm_0290_14">↑</a> [[३। ‘पोरदुपधात्’ (३-१-९८) इति यत्।]]</li> <li id="foot_krm_0290_15"><a href="#ref_krm_0290_15">↑</a> [[४। ण्यन्तात् ‘अचो यत्’ (३-१-९७) इति यत्।]]</li> <li id="foot_krm_0290_16"><a href="#ref_krm_0290_16">↑</a> [[C। ‘अथ क्लमादनिक्वाणा नराः क्षीणपणा इव।’ भ। का। ७-५८।]]</li> <li id="foot_krm_0290_17"><a href="#ref_krm_0290_17">↑</a> [[५। ‘तितुत्र--’ (७-२-९) इत्यादिना इण्णिषेधः। दीर्घः।]]</li> <li id="foot_krm_0290_18"><a href="#ref_krm_0290_18">↑</a> [[६। ‘उदितो वा’ (७-३-५६) इति क्त्वायाः इड् वा।]]</li> <li id="foot_krm_0290_19"><a href="#ref_krm_0290_19">↑</a> [[७। ‘ल्यपि लघुपूर्वात्’ (६-४-५६) इति णेरयादेशः।]]</li> <li id="foot_krm_0290_20"><a href="#ref_krm_0290_20">↑</a> [[८। अमन्तत्वेन मित्त्वात् ‘चिण्णमुलोर्दीर्घोऽन्यतरस्याम्’ (६-४-९३) इति दीर्घविकल्पः।]]</li></ul></p>

