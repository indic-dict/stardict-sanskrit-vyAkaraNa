्रासङ्गिक्यः <ul><li id="foot_krm_0287_01"><a href="#ref_krm_0287_01">↑</a> (२८०)</li> <li id="foot_krm_0287_02"><a href="#ref_krm_0287_02">↑</a> (१-भ्वादिः-८०२। सक। सेट्। पर।)</li> <li id="foot_krm_0287_03"><a href="#ref_krm_0287_03">↑</a> [[१। ‘घटादयो मितः’ (गणसूत्रं भ्वादौ) इति मित्त्वम्। ‘मितां ह्रस्वः’ (६-४-९२) इति णौ ह्रस्वः। एवं ण्यन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0287_04"><a href="#ref_krm_0287_04">↑</a> [[आ। ‘श्लथ्यात्मनां क्राथयताऽच्युतेन किं नाङ्गजो नः क्लथयन् अचानि। वनाम किं प्रज्वलितो हरेण सोऽद्यापि यत् विह्वलयन् अनङ्गः।।’ धा। का। २-१०।]]</li> <li id="foot_krm_0287_05"><a href="#ref_krm_0287_05">↑</a> [[२। ‘निष्ठायां सेटि’ (६-४-५२) इति णेर्लोपः।]]</li> <li id="foot_krm_0287_06"><a href="#ref_krm_0287_06">↑</a> [[३। ‘णेरनिटि’ (६-४-५१) इति णिलोपः।]]</li> <li id="foot_krm_0287_07"><a href="#ref_krm_0287_07">↑</a> [[४। ‘अचो यत्’ (३-१-९७) इति ण्यन्ताद्यत्।]]</li> <li id="foot_krm_0287_08"><a href="#ref_krm_0287_08">↑</a> [पृष्ठम्०२९२+ २५]</li> <li id="foot_krm_0287_09"><a href="#ref_krm_0287_09">↑</a> [[१। ‘ल्यपि लघुपूर्वात्’ (६-४-५६) इति णेरयादेशः।]]</li> <li id="foot_krm_0287_10"><a href="#ref_krm_0287_10">↑</a> [[२। ‘चिण्णमुलोर्दीर्घोऽन्यतरस्याम्’ (६-४-९३) इति दीर्घविकल्पः।]]</li></ul></p>

