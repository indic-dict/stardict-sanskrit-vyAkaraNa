<ul><li><sup id="ref_krm_1012_01"><a href="#foot_krm_1012_01">1</a></sup> {@“पिषॢ सञ्चूर्णने”@} <sup id="ref_krm_1012_02"><a href="#foot_krm_1012_02">2</a></sup> सञ्चूर्णनम् = धान्यादीनां चूर्णीकरणम्, हिंसा च। </li> <li>पेषकः-षिका, पेषकः-षिका, <sup id="ref_krm_1012_03"><a href="#foot_krm_1012_03">3</a></sup> पिपिक्षकः-क्षिका, पेपिषकः-षिका;</li> <li>  पेष्टा-पेष्ट्री, पेषयिता-त्री, पिपिक्षिता-त्री, पेपिषिता-त्री;</li> <li>  <sup id="ref_krm_1012_04"><a href="#foot_krm_1012_04">4</a></sup> <sup id="ref_krm_1012_05"><a href="#foot_krm_1012_05">5</a></sup> चौरस्य] पिंषन्-ती, <sup id="ref_krm_1012_06"><a href="#foot_krm_1012_06">6</a></sup> पिंषन्, पेषयन्-न्ती, पिपिक्षन्-न्ती;</li> <li>  -- <sup id="ref_krm_1012_07"><a href="#foot_krm_1012_07">7</a></sup> पेक्ष्यन्-न्ती-ती, पेषयिष्यन्-न्ती-ती, पिपिक्षिष्यन्-न्ती-ती;</li> <li>  -- -- पेषयमाणः, पेषयिष्यमाणः, -- पेपिष्यमाणः, पेपिषिष्यमाणः;</li> <li>  पिट्-पिषौ-पिषः;</li> <li>  -- -- -- पिष्टम्-ष्टः, <sup id="ref_krm_1012_08"><a href="#foot_krm_1012_08">8</a></sup> पिष्टः, पेषितः, पिपिक्षितः, पेपिषितः-तवान्;</li> <li>  पिषः, <sup id="ref_krm_1012_09"><a href="#foot_krm_1012_09">9</a></sup> पेषणः, पेषः, पिपिक्षुः, पेपिषः;</li> <li>  पेष्टव्यम्, पेषयितव्यम्, पिपिक्षितव्यम्, पेपिषितव्यम्;</li> <li>  पेषणीयम्, पेषणीयम्, पिपिक्षणीयम्, पेपिषणीयम्;</li> <li>  पेष्यम्, पेष्यम्, पिपिक्ष्यम्, पेपिष्यम्;</li> <li>  ईषत्पेषः-दुष्पेषः-सुपेषः;</li> <li>  -- -- पिष्यमाणः, पेष्यमाणः, पिपिक्ष्यमाणः, पेपिष्यमाणः;</li> <li>  पेषः, पेषः, पिपिक्षः, पेपिषः;</li> <li>  पेष्टुम्, पेषयितुम्, पिपिक्षितुम्, पेपिषितुम्;</li> <li>  पिष्टिः, <sup id="ref_krm_1012_10"><a href="#foot_krm_1012_10">10</a></sup> पिष्टिः, पेषणा, पिपिक्षा, पेपिषा;</li> <li>  पेषणम्, पेषणम्, पिपिक्षणम्, पेपिषणम्;</li> <li>  पिष्ट्वा, पेषयित्वा, पिपिक्षित्वा, पेपिषित्वा;</li> <li>  विनिष्पिष्य, प्रपेष्य, प्रपिपिक्ष्य, प्रपेपिष्य;</li> <li>  <sup id="ref_krm_1012_11"><a href="#foot_krm_1012_11">11</a></sup> शुष्कपेषम् <sup id="ref_krm_1012_12"><a href="#foot_krm_1012_12">12</a></sup>, <sup id="ref_krm_1012_13"><a href="#foot_krm_1012_13">13</a></sup> चूर्णपेषम्, रूक्षपेषं वा पिनष्टि। </li> <li><sup id="ref_krm_1012_14"><a href="#foot_krm_1012_14">14</a></sup> उरःप्रतिपेषं <sup id="ref_krm_1012_15"><a href="#foot_krm_1012_15">15</a></sup> <sup id="ref_krm_1012_16"><a href="#foot_krm_1012_16">16</a></sup> युध्यन्ते। </li> <li><sup id="ref_krm_1012_17"><a href="#foot_krm_1012_17">17</a></sup> उदपेषं पिनष्टि। </li> <li><sup id="ref_krm_1012_18"><a href="#foot_krm_1012_18">18</a></sup> मूर्धपेषम्, मूर्धानं पेषं वा युध्यन्ते। </li> <li>पेषम् २, पिष्ट्वा २, पेषम् २, पेषयित्वा २, पिपिक्षम् २, पिपिक्षित्वा २, पेपिषम् २;</li> <li>  पेपिषित्वा २;</li> <li>  <sup id="ref_krm_1012_19"><a href="#foot_krm_1012_19">19</a></sup> इति आकप्रत्यये, षकारस्य नकारः, गुणा- भावश्च निपातनात् भवति। </li> <li>पिनष्ट्यनेन शत्रून् इति पिनाकः = रुद्रधनुः, शूलं वा। </li> <li>अत्रैव गणे निपातनात् युगागमः, षकारस्य णकारः गुणाभावश्च। </li> <li>अतः पिण्याकम् इत्यपि सिद्ध्यति। </li> <li>पिण्याकम् = तिलपिष्टकल्कः।]] पिनाकः, पिण्याकम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1012_01"><a href="#ref_krm_1012_01">↑</a> (१००२)</li> <li id="foot_krm_1012_02"><a href="#ref_krm_1012_02">↑</a> (७-रुधादिः-१४५२। सक। अनि। पर।)</li> <li id="foot_krm_1012_03"><a href="#ref_krm_1012_03">↑</a> [[२। सन्नन्ताण्ण्वुलि, ‘हलन्ताच्च’ (१-२-१०) इति सनः कित्त्वे, ‘षढोः कः सि’ (८-२-४१) इति षकारस्य ककारे, ‘इण्कोः’ (८-३-५७) इति सकारस्य षत्वे च रूपमेवम्। एवं सन्नन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_1012_04"><a href="#ref_krm_1012_04">↑</a> [पृष्ठम्०८६३+ २९]</li> <li id="foot_krm_1012_05"><a href="#ref_krm_1012_05">↑</a> [[[१। ‘जासिनिप्रहणनाटक्राथपिषां हिंसायाम्’ (२-३-५६) इति कर्मणि षष्ठी। हिंसा- भिन्नार्थे तु ‘धानाः पिंषन्’ इत्यत्र न।]]</li> <li id="foot_krm_1012_06"><a href="#ref_krm_1012_06">↑</a> [धानाः]</li> <li id="foot_krm_1012_07"><a href="#ref_krm_1012_07">↑</a> [[आ। ‘… पेक्ष्यत्सु माधवमभङ्गभुजेषु तेषु।।’ धा। का। ३। २।]]</li> <li id="foot_krm_1012_08"><a href="#ref_krm_1012_08">↑</a> [[२। ‘क्तिच्क्तौ च संज्ञायाम्’ (३-३-१७४) इति संज्ञायां क्तप्रत्ययः। पिष्टः = सक्तुः।]]</li> <li id="foot_krm_1012_09"><a href="#ref_krm_1012_09">↑</a> [[३। नन्द्यादेः (३-१-१३४) आकृतिगणत्वात् कर्तरि ल्युः।]]</li> <li id="foot_krm_1012_10"><a href="#ref_krm_1012_10">↑</a> [[४। ‘क्तिच्क्तौ च संज्ञायाम्’ (३-३-१७४) इति संज्ञायां क्तिच्। पिष्टिः = सक्तुः।]]</li> <li id="foot_krm_1012_11"><a href="#ref_krm_1012_11">↑</a> [[५। ‘शुष्कचूर्णरूक्षेषु पिषः’ (३-४-३५) इति णमुल्। ‘कषादिषु यथाविध्यनुप्रयोगः’ (३-४-४६) इति णमुलन्तधातोरेवानुप्रयोगः। एवं चूर्णपेषम्, रूक्षपेषम् इत्यत्रापि ज्ञेयम्।]]</li> <li id="foot_krm_1012_12"><a href="#ref_krm_1012_12">↑</a> [[B। ‘शुष्कपेषं पिनष्म्युर्वीम् अखिन्दानः स्वतेजसा।।’ भ। का। ६। ३७।]]</li> <li id="foot_krm_1012_13"><a href="#ref_krm_1012_13">↑</a> [[C। ‘वर्म करतलयुगेन महत्तनुचूर्णपेषमपिषद् रुषा परः।।’ शि। व। १५। ७६।]]</li> <li id="foot_krm_1012_14"><a href="#ref_krm_1012_14">↑</a> [[६। ‘स्वाङ्गे--’ (३-४-५४) इत्यनुवर्तमाने, ‘परिक्लिश्यमाने च’ (३-४-५५) इति द्वितीयान्तात् णमुल्। कृत्स्नमुरः पीडयन्तो युध्यन्ते इत्यर्थः। अध्रुवार्थोऽयं योगः।]]</li> <li id="foot_krm_1012_15"><a href="#ref_krm_1012_15">↑</a> [[ड्। ‘पीडिते पुर उरःप्रतिपेषं भर्तरि स्तनयुगेन युवत्याः।’ शि। व। १०। ४६।]]</li> <li id="foot_krm_1012_16"><a href="#ref_krm_1012_16">↑</a> [पृष्ठम्०८६४+ २४]</li> <li id="foot_krm_1012_17"><a href="#ref_krm_1012_17">↑</a> [[१। ‘स्नेहने पिषः’ (३-४-३८) इति णमुल्। ‘पेषंवासवाहनधिषु च’ (६-३-५८) इति उदकशब्दस्योदादेशः। उदकेन पिनष्टीत्यर्थः।]]</li> <li id="foot_krm_1012_18"><a href="#ref_krm_1012_18">↑</a> [[आ। ‘परितः पीड्यमानेऽङ्गे ध्रुवेऽप्युपपदे णमुल्। मूर्धपेषं नियुध्यन्ते, मूर्धानं पेषमित्यपि।।’ प्र। सर्वस्वे।]]</li> <li id="foot_krm_1012_19"><a href="#ref_krm_1012_19">↑</a> [[२। ‘पिनाकादयश्च’ [द। उ। ३-३४]</li></ul></p>

पिस|पेसकः-सिका|पिपेसयिषकः-षिका
<ul><li><sup id="ref_krm_1013_01"><a href="#foot_krm_1013_01">1</a></sup> {@“पिस गतौ”@} <sup id="ref_krm_1013_02"><a href="#foot_krm_1013_02">2</a></sup> पेसकः-सिका, पिपेसयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकचोरयतिवत् <sup id="ref_krm_1013_03"><a href="#foot_krm_1013_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1013_04"><a href="#foot_krm_1013_04">4</a></sup> संपेसयन्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1013_01"><a href="#ref_krm_1013_01">↑</a> (१००३)</li> <li id="foot_krm_1013_02"><a href="#ref_krm_1013_02">↑</a> (१०-चुरादिः-१५६८। सक। सेट्। उभ।)</li> <li id="foot_krm_1013_03"><a href="#ref_krm_1013_03">↑</a> (५४६)</li> <li id="foot_krm_1013_04"><a href="#ref_krm_1013_04">↑</a> [[B। ‘आश्वाठितारिकुलतुञ्जविपिञ्जशीलः संपेसयन् गृहमसान्त्वयदेष गोपीः।’ धा। का। ३-१७।]]</li></ul></p>

पिसि|पिंसकः-सिका|पिपिंसयिषकः-षिका|पिपिंसिषकः-षिका|पेपिंसकः-सिका
<ul><li><sup id="ref_krm_1014_01"><a href="#foot_krm_1014_01">1</a></sup> {@“पिसि भाषार्थः”@} <sup id="ref_krm_1014_02"><a href="#foot_krm_1014_02">2</a></sup> आस्वदीयः। </li> <li>‘णौ पिंसयति भाषार्थे, गत्यां तु शपि पेसति।’ <sup id="ref_krm_1014_03"><a href="#foot_krm_1014_03">3</a></sup> इति देवः। </li> <li>पिंसकः-सिका, पिपिंसयिषकः-षिका, पिंसकः-सिका, पिपिंसिषकः-षिका, पेपिंसकः-सिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिककुंशयतिवत् <sup id="ref_krm_1014_04"><a href="#foot_krm_1014_04">4</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1014_01"><a href="#ref_krm_1014_01">↑</a> (१००४)</li> <li id="foot_krm_1014_02"><a href="#ref_krm_1014_02">↑</a> (१०-चुरादिः-१७६३। सक। सेट्। उभ।)</li> <li id="foot_krm_1014_03"><a href="#ref_krm_1014_03">↑</a> (श्लो। १९२)</li> <li id="foot_krm_1014_04"><a href="#ref_krm_1014_04">↑</a> (२३२)</li></ul></p>

पिसृ|पेसकः-सिका|पिपिसिषकः-पिपेसिषकः-षिका|पेपिसकः-सिका
<ul><li><sup id="ref_krm_1015_01"><a href="#foot_krm_1015_01">1</a></sup> {@“पिसृ गतौ”@} <sup id="ref_krm_1015_02"><a href="#foot_krm_1015_02">2</a></sup> ‘इह क्वचित्कोशे विसृ वेसृ--इति पठ्यते।’ इति मा। </li> <li>धा। </li> <li>वृत्तौ। </li> <li>‘णौ पिंसयति भाषार्थे, गत्यां तु शपि पेसति।’ <sup id="ref_krm_1015_03"><a href="#foot_krm_1015_03">3</a></sup> इति देवः। </li> <li>पेसकः-सिका, पेसकः-सिका, पिपिसिषकः-पिपेसिषकः-षिका, <sup id="ref_krm_1015_04"><a href="#foot_krm_1015_04">4</a></sup> पेपिसकः-सिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककिटतिवत् <sup id="ref_krm_1015_05"><a href="#foot_krm_1015_05">5</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_1015_06"><a href="#foot_krm_1015_06">6</a></sup> पेस्वरः, अनुपिसितः <sup id="ref_krm_1015_07"><a href="#foot_krm_1015_07">7</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1015_01"><a href="#ref_krm_1015_01">↑</a> (१००५)</li> <li id="foot_krm_1015_02"><a href="#ref_krm_1015_02">↑</a> (१-भ्वादिः-७१९। सक। सेट्। पर।)</li> <li id="foot_krm_1015_03"><a href="#ref_krm_1015_03">↑</a> (श्लो। १९२)</li> <li id="foot_krm_1015_04"><a href="#ref_krm_1015_04">↑</a> [पृष्ठम्०८६५+ २९]</li> <li id="foot_krm_1015_05"><a href="#ref_krm_1015_05">↑</a> (१९०)</li> <li id="foot_krm_1015_06"><a href="#ref_krm_1015_06">↑</a> [[१। ‘स्थेशभासपिस--’ (३-२-१७५) इति ताच्छीलिके वरच्प्रत्यये एवं रूपम्।]]</li> <li id="foot_krm_1015_07"><a href="#ref_krm_1015_07">↑</a> [[आ। ‘जीमूतचर्चिरवझर्झरवाद्यहृद्यं तेनैव चाऽनुपिसितो निलयं पिपेस।।’ धा। का। १। ८९।]]</li></ul></p>

पीङ्|पायकः-यिका|पिपीषकः-षिका|पेपीयकः-यिका
<ul><li><sup id="ref_krm_1016_01"><a href="#foot_krm_1016_01">1</a></sup> {@“पीङ् पाने”@} <sup id="ref_krm_1016_02"><a href="#foot_krm_1016_02">2</a></sup> स्वादिः। </li> <li>पायकः-यिका, पायकः-यिका, पिपीषकः-षिका, पेपीयकः-यिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि दैवादिकधीङ्धातुवत्, <sup id="ref_krm_1016_03"><a href="#foot_krm_1016_03">3</a></sup> ज्ञेयानि। </li> <li>पीयमानः, <sup id="ref_krm_1016_04"><a href="#foot_krm_1016_04">4</a></sup> पाययन्-न्ती, <sup id="ref_krm_1016_05"><a href="#foot_krm_1016_05">5</a></sup> पीवा, इतीमानि रूपाणि अधिकान्यत्रेति विशेषः। </li> <li>आपीय <sup id="ref_krm_1016_06"><a href="#foot_krm_1016_06">6</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1016_01"><a href="#ref_krm_1016_01">↑</a> (१००६)</li> <li id="foot_krm_1016_02"><a href="#ref_krm_1016_02">↑</a> (४-दिवादिः-११४१। सक। अनि। आत्म।)</li> <li id="foot_krm_1016_03"><a href="#ref_krm_1016_03">↑</a> (९०१)</li> <li id="foot_krm_1016_04"><a href="#ref_krm_1016_04">↑</a> [[२। ‘निगरणचलनार्थेभ्यश्च’ (१-३-८७) इति ण्यन्तात् नित्यं परस्मैपदम्।]]</li> <li id="foot_krm_1016_05"><a href="#ref_krm_1016_05">↑</a> [[३। ‘अन्येभ्योऽपि दृश्यन्ते (३-२-७५) इति वनिप्प्रत्यये एवं रूपम्।]]</li> <li id="foot_krm_1016_06"><a href="#ref_krm_1016_06">↑</a> [[B। ‘आपीय तद्गिरममाननिरीतरोषः प्रीतिं श्यतोऽस्य स करेण शिरोधिमच्छात्।’ धा। का। २। ५९।]]</li></ul></p>

पीड|पीडकः-डिका|पिपीडयिषकः-षिका
<ul><li><sup id="ref_krm_1017_01"><a href="#foot_krm_1017_01">1</a></sup> {@“पीड अवगाहने”@} <sup id="ref_krm_1017_02"><a href="#foot_krm_1017_02">2</a></sup> अवगाहनम्--बाधनम्। </li> <li>‘बाधगाहनयोः’ इति द्रुमे। </li> <li>‘--गहने’ इति क्षीरस्वामी। </li> <li>पीडकः-डिका, पिपीडयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिककीटयतिवत् <sup id="ref_krm_1017_03"><a href="#foot_krm_1017_03">3</a></sup> ज्ञेयानि। </li> <li>णमुलि-- <sup id="ref_krm_1017_04"><a href="#foot_krm_1017_04">4</a></sup> पाणावुपपीडं पाण्युपपीडं, पाणिनोपपीडं <sup id="ref_krm_1017_05"><a href="#foot_krm_1017_05">5</a></sup>। </li> <li><sup id="ref_krm_1017_06"><a href="#foot_krm_1017_06">6</a></sup> पीडा, <sup id="ref_krm_1017_07"><a href="#foot_krm_1017_07">7</a></sup> जनापीडः, <sup id="ref_krm_1017_08"><a href="#foot_krm_1017_08">8</a></sup> मुष्टिपीडम्, <sup id="ref_krm_1017_09"><a href="#foot_krm_1017_09">9</a></sup> <sup id="ref_krm_1017_10"><a href="#foot_krm_1017_10">10</a></sup> नयोपपीडम्, <sup id="ref_krm_1017_11"><a href="#foot_krm_1017_11">11</a></sup> तिलपीडकः, <sup id="ref_krm_1017_12"><a href="#foot_krm_1017_12">12</a></sup> बाहूपपीडम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1017_01"><a href="#ref_krm_1017_01">↑</a> (१००७)</li> <li id="foot_krm_1017_02"><a href="#ref_krm_1017_02">↑</a> (१०-चुरादिः-१५४४। सक। सेट्। उभ।)</li> <li id="foot_krm_1017_03"><a href="#ref_krm_1017_03">↑</a> (१९४)</li> <li id="foot_krm_1017_04"><a href="#ref_krm_1017_04">↑</a> [[४। ‘सप्तम्यां चोपपीडरुधकर्षः’ (३-४-४९) इति णमुल्। ‘तृतीयाप्रमृतीन्यन्यतरस्याम्’ (२-२-२१) इति समासविकल्पः।]]</li> <li id="foot_krm_1017_05"><a href="#ref_krm_1017_05">↑</a> [वा धारयति]</li> <li id="foot_krm_1017_06"><a href="#ref_krm_1017_06">↑</a> [[५। युचं बाधित्वा भिदादिपाठात् (३-३-१०४) अङ्।]]</li> <li id="foot_krm_1017_07"><a href="#ref_krm_1017_07">↑</a> [[६। ‘कर्मण्यण्’ (३-२-१) इति अण्प्रत्यये रूपम्। जनान्, आ = समन्तात् पीडयतीति विग्रहः।]]</li> <li id="foot_krm_1017_08"><a href="#ref_krm_1017_08">↑</a> [[C। ‘धनुररिभिरसह्यं मुष्टिपीडं दधाने।’ (भ। का। १-२६) इत्यत्र ‘उप’ इत्युप- सर्गस्याविवक्षा ज्ञेया। यथा ‘उपेयिवान्’ इत्यत्र, ‘ईयिवान्’ इति सिद्ध्यर्थं ‘उप’ इत्यस्याविवक्षा।]]</li> <li id="foot_krm_1017_09"><a href="#ref_krm_1017_09">↑</a> [पृष्ठम्०८६६+ २७]</li> <li id="foot_krm_1017_10"><a href="#ref_krm_1017_10">↑</a> [[आ। ‘सलीलमालिङ्ग्य नयोपपीडमनामयं पृच्छति वासवस्त्वाम्।’ नैषधे ६। ७८।]]</li> <li id="foot_krm_1017_11"><a href="#ref_krm_1017_11">↑</a> [[१। पीडयतीति पीडकः। तिलस्य पीडकः तिलपीडकः = तैलाविष्करणार्थो दारु- विशेषः।]]</li> <li id="foot_krm_1017_12"><a href="#ref_krm_1017_12">↑</a> [[B। ‘बाहूपपीडमाश्लिष्य जगाहे द्यां निशाचरः।।’ भ। का। ५। ९४।]]</li></ul></p>

पील|पीलकः-लिका|पिपीलिषकः-षिका|पेपीलकः-लिका
<ul><li><sup id="ref_krm_1018_01"><a href="#foot_krm_1018_01">1</a></sup> {@“पील प्रतिष्टम्भे”@} <sup id="ref_krm_1018_02"><a href="#foot_krm_1018_02">2</a></sup> प्रतिष्टम्भः = रोधनम्। </li> <li>पीलकः-लिका, पीलकः-लिका, पिपीलिषकः-षिका, पेपीलकः-लिका;</li> <li>  इत्यादीनि सर्वाणि रूपाणि भौवादिककीलतिवत् <sup id="ref_krm_1018_03"><a href="#foot_krm_1018_03">3</a></sup> बोध्यानि। </li> <li>पीलितः <sup id="ref_krm_1018_04"><a href="#foot_krm_1018_04">4</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1018_01"><a href="#ref_krm_1018_01">↑</a> (१००८)</li> <li id="foot_krm_1018_02"><a href="#ref_krm_1018_02">↑</a> (१-भ्वादिः-५२१। अक। सेट्। पर।)</li> <li id="foot_krm_1018_03"><a href="#ref_krm_1018_03">↑</a> (१९५)</li> <li id="foot_krm_1018_04"><a href="#ref_krm_1018_04">↑</a> [[C। ‘पिच्छस्रजा पीलितनीलकुन्तलं शीलेन संकीलितलोकमानसम्।।’ धा। का। १। ६७।]]</li></ul></p>

पीव|पीवकः-विका|पिपीविषकः-षिका|पेपीवकः-विका
<ul><li><sup id="ref_krm_1019_01"><a href="#foot_krm_1019_01">1</a></sup> {@“पीव स्थौल्ये”@} <sup id="ref_krm_1019_02"><a href="#foot_krm_1019_02">2</a></sup> पीवकः-विका, पीवकः-विका, पिपीविषकः-षिका, पेपीवकः-विका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककीलतिवत् <sup id="ref_krm_1019_03"><a href="#foot_krm_1019_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1019_04"><a href="#foot_krm_1019_04">4</a></sup> इति ष्वरच्प्रत्यये, वलोपोऽगुणत्वं च निपात्यते। </li> <li>पीवरः = स्थूलः।]] पीवरः, <sup id="ref_krm_1019_05"><a href="#foot_krm_1019_05">5</a></sup> पीवितः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1019_01"><a href="#ref_krm_1019_01">↑</a> (१००९)</li> <li id="foot_krm_1019_02"><a href="#ref_krm_1019_02">↑</a> (१-भ्वादिः-५६३। सक। सेट्। पर।)</li> <li id="foot_krm_1019_03"><a href="#ref_krm_1019_03">↑</a> (१९५)</li> <li id="foot_krm_1019_04"><a href="#ref_krm_1019_04">↑</a> [[२। ‘छित्वरछत्वरधीवरपीवर--’ [द। उ। ८-४९]</li> <li id="foot_krm_1019_05"><a href="#ref_krm_1019_05">↑</a> [[ड्। ‘अपीवितां नाप्यतिमीवितां श्रितं तनुं सुतीवोरुमनीवमध्यमाम्।।’ धा। का। १। ७२।]]</li></ul></p>

पुट|पोटकः-टिका|पुपुटिषकः-षिका|पोपुटकः-टिका
<ul><li><sup id="ref_krm_1020_01"><a href="#foot_krm_1020_01">1</a></sup> {@“पुट संश्लेषणे”@} <sup id="ref_krm_1020_02"><a href="#foot_krm_1020_02">2</a></sup> कुटादिः। </li> <li>‘भाषासंसर्गसंश्लेषे पोटयेत् पुटयेत् पुटेत्।।’ <sup id="ref_krm_1020_03"><a href="#foot_krm_1020_03">3</a></sup> इति देवः। </li> <li>पोटकः-टिका, पोटकः-टिका, पुपुटिषकः-षिका, पोपुटकः-टिका;</li> <li>  पुटिता-त्री, प्रपुटितम्- <sup id="ref_krm_1020_04"><a href="#foot_krm_1020_04">4</a></sup> तः-तवान्, इत्यादीनि सर्वाण्यपि रूपाणि तौदादिक- कुटतिवत् <sup id="ref_krm_1020_05"><a href="#foot_krm_1020_05">5</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1020_01"><a href="#ref_krm_1020_01">↑</a> (१०१०)</li> <li id="foot_krm_1020_02"><a href="#ref_krm_1020_02">↑</a> (६-तुदादिः-१३६७। अक। सेट्। पर।)</li> <li id="foot_krm_1020_03"><a href="#ref_krm_1020_03">↑</a> (श्लो। ७५)</li> <li id="foot_krm_1020_04"><a href="#ref_krm_1020_04">↑</a> [[E। ‘ततोऽतिकुटिलाशयैः प्रपुटितैः कुचज्जीवितैः गुजद्भिरपि सैनिकैः सुगुडितां डिपद्भिर्जनान्।’ धा। का। २। ८०।]]</li> <li id="foot_krm_1020_05"><a href="#ref_krm_1020_05">↑</a> (२०४)</li></ul></p>

पुट|अस्य|धातोरुभयपदित्वात्|शतरि|पोटयन्-|न्ती|पुपोटयिषन्|पोटयिष्यन्|पुपोटयिषिष्यन्-न्ती-ती
<ul><li><sup id="ref_krm_1021_01"><a href="#foot_krm_1021_01">1</a></sup> {@“पुट भाषार्थः”@} <sup id="ref_krm_1021_02"><a href="#foot_krm_1021_02">2</a></sup> आस्वदीयः। </li> <li>‘भाषासंसर्गसंश्लेषे पोटयेत् पुटयेत् पुटेत्।।’ <sup id="ref_krm_1021_03"><a href="#foot_krm_1021_03">3</a></sup> इति देवः। </li> <li>पोटकः-टिका, पुपोटयिषकः-षिका, इत्यादीनि सर्वाण्यपि रूपाणि चौरादिक- <sup id="ref_krm_1021_04"><a href="#foot_krm_1021_04">4</a></sup> कोटयतिवत् <sup id="ref_krm_1021_05"><a href="#foot_krm_1021_05">5</a></sup> बोध्यानि। </li> <li>अस्य धातोरुभयपदित्वात्, शतरि पोटयन्- न्ती, पुपोटयिषन्, पोटयिष्यन्, पुपोटयिषिष्यन्-न्ती-ती;</li> <li>  इति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1021_01"><a href="#ref_krm_1021_01">↑</a> (१०११)</li> <li id="foot_krm_1021_02"><a href="#ref_krm_1021_02">↑</a> (१०-चुरादिः-१७५४। सक। सेट्। उभ।)</li> <li id="foot_krm_1021_03"><a href="#ref_krm_1021_03">↑</a> (श्लो। ७५)</li> <li id="foot_krm_1021_04"><a href="#ref_krm_1021_04">↑</a> [पृष्ठम्०८६७+ २५]</li> <li id="foot_krm_1021_05"><a href="#ref_krm_1021_05">↑</a> (२०५)</li></ul></p>

पुट|पुटकः-टिका|पुपुटयिषकः-षिका
<ul><li><sup id="ref_krm_1022_01"><a href="#foot_krm_1022_01">1</a></sup> {@“पुट संसर्गे”@} <sup id="ref_krm_1022_02"><a href="#foot_krm_1022_02">2</a></sup> कथादिः, अदन्तश्च। </li> <li>‘भाषासंसर्गसंश्लेषे पोटयेत् पुटेत् पुटेत्।।’ <sup id="ref_krm_1022_03"><a href="#foot_krm_1022_03">3</a></sup> इति देवः। </li> <li>पुटकः-टिका, पुपुटयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाणि रूपाणि प्रायः चौरादिककथयतिवत् <sup id="ref_krm_1022_04"><a href="#foot_krm_1022_04">4</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_1022_05"><a href="#foot_krm_1022_05">5</a></sup> पुटयितुम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1022_01"><a href="#ref_krm_1022_01">↑</a> (१०१२)</li> <li id="foot_krm_1022_02"><a href="#ref_krm_1022_02">↑</a> (१०-चुरादिः-१९१३। सक। सेट्। उभ।)</li> <li id="foot_krm_1022_03"><a href="#ref_krm_1022_03">↑</a> (श्लो। ७५)</li> <li id="foot_krm_1022_04"><a href="#ref_krm_1022_04">↑</a> (१६२)</li> <li id="foot_krm_1022_05"><a href="#ref_krm_1022_05">↑</a> [[आ। ‘दुष्पारदुश्चरिततीरणकृद्यथेशो नो चक्षमे पुटयितुं तमकत्रितोष्मा।।’ धा। का। ३। ५९।]]</li></ul></p>

पुटि|पुण्टकः-ण्टिका|पुपुण्टयिषकः-षिका|पुपुण्टिषकः-षिका|पोपुण्टकः-ण्टिका
<ul><li><sup id="ref_krm_1023_01"><a href="#foot_krm_1023_01">1</a></sup> {@“पुटि भाषार्थः”@} <sup id="ref_krm_1023_02"><a href="#foot_krm_1023_02">2</a></sup> आस्वदीयः। </li> <li>पुण्टकः-ण्टिका, पुपुण्टयिषकः-षिका, पुण्टकः-ण्टिका, पुपुण्टिषकः-षिका, पोपुण्टकः-ण्टिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि कुण्ठयतिवत् <sup id="ref_krm_1023_03"><a href="#foot_krm_1023_03">3</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1023_01"><a href="#ref_krm_1023_01">↑</a> (१०१३)</li> <li id="foot_krm_1023_02"><a href="#ref_krm_1023_02">↑</a> (१०-चुरादिः-१७९३। सक। सेट्। उभ।)</li> <li id="foot_krm_1023_03"><a href="#ref_krm_1023_03">↑</a> (२१०)</li></ul></p>

पुट्ट|पुट्टकः-ट्टिका|पुपुट्टयिषकः-षिका|पुट्टयिता-त्री|पुपुट्टयिषिता-त्री
<ul><li><sup id="ref_krm_1024_01"><a href="#foot_krm_1024_01">1</a></sup> {@“पुट्ट अल्पीभावे”@} <sup id="ref_krm_1024_02"><a href="#foot_krm_1024_02">2</a></sup> पुट्टकः-ट्टिका, पुपुट्टयिषकः-षिका, पुट्टयिता-त्री, पुपुट्टयिषिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि विशेषरूपाणि विना चौरादिककुट्टयतिवत् <sup id="ref_krm_1024_03"><a href="#foot_krm_1024_03">3</a></sup> बोध्यानि। </li> <li>कर्तरि क्तप्रत्यये <sup id="ref_krm_1024_04"><a href="#foot_krm_1024_04">4</a></sup> प्रपुट्टितः इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1024_01"><a href="#ref_krm_1024_01">↑</a> (१०१४)</li> <li id="foot_krm_1024_02"><a href="#ref_krm_1024_02">↑</a> (१०-चुरादिः-१५५९। अक। सेट्। उभ।)</li> <li id="foot_krm_1024_03"><a href="#ref_krm_1024_03">↑</a> (२०७)</li> <li id="foot_krm_1024_04"><a href="#ref_krm_1024_04">↑</a> [[B। ‘सा पूतना च शिशुभक्षणकुट्टनोत्का जघ्ने प्रपुट्टितकृपेण विचुट्टिताघा।’ धा। का। ३। १६।]]</li></ul></p>

