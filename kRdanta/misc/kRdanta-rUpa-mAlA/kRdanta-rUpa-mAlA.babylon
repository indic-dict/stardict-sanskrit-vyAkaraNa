<ul><li><sup id="ref_krm_0006_01"><a href="#foot_krm_0006_01">1</a></sup> {@‘अङ्क पदे लक्षणे च’@} <sup id="ref_krm_0006_02"><a href="#foot_krm_0006_02">2</a></sup> अदन्तः। </li> <li>‘अङ्क लक्षण इत्यस्य भवेदङ्कयतीति णौ’ <sup id="ref_krm_0006_03"><a href="#foot_krm_0006_03">3</a></sup> इति देवः। </li> <li>^१ अङ्ककः-ङ्किका, अञ्चिकयिषकः-षिका;</li> <li>  अङ्कयिता-त्री, अञ्चिकयिषिता-त्री;</li> <li>  अङ्कयन्-न्ती, अञ्चिकयिषन्-न्ती;</li> <li>  अङ्कयिष्यन्-न्ती-ती, अञ्चिकयिषिष्यन्-ती-न्ती;</li> <li>  अङ्कयमानः, अञ्चिकयिषमाणः;</li> <li>  अङ्कयिष्यमाणः, अञ्चिकयिषिष्यमाणः;</li> <li>  अन्-अङ्कौ-अङ्कः;</li> <li>  अङ्कितम्-तः-तवान्, अञ्चिकयिसितः-तवान्;</li> <li>  अङ्कः, अञ्चिकयिषुः;</li> <li>  अङ्कयितव्यम्, अञ्चिकयिषितव्यम्;</li> <li>  अङ्कनीयम्, अञ्चिकयिषणीयम्;</li> <li>  अङ्क्यम्, अञ्चिकयिष्यम्;</li> <li>  ईषदङ्कः-दुरङ्कः-स्वङ्कः;</li> <li>  अङ्क्यमानः, अञ्चिकयिष्यमाणः;</li> <li>  अङ्कः, अञ्चिकयिषः;</li> <li>  अङ्कयितुम्, अञ्चिकयिषितुम्;</li> <li>  अङ्कना, अञ्चिकयिषा;</li> <li>  <sup id="ref_krm_0006_04"><a href="#foot_krm_0006_04">4</a></sup> अङ्कनम्, अञ्चिकयिषणम्;</li> <li>  अङ्कयित्वा, अञ्चिकयिषित्वा;</li> <li>  समङ्क्य, समञ्चिकयिष्य;</li> <li>  अङ्कम् २, अङ्कयित्वा २, अञ्चिकयिषम् २ अञ्चिकयिषित्वा २ १। धातोर्नित्यणिजन्तत्वात् णिज्रहिताद्रूपाणि न भवन्ति। </li> <li>अनेकाच्- त्वाद् यङन्तरूपाण्यपि न।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0006_01"><a href="#ref_krm_0006_01">↑</a> (७)</li> <li id="foot_krm_0006_02"><a href="#ref_krm_0006_02">↑</a> (१०-१९२७-चुरादिः सक। सेट्-उभ-)</li> <li id="foot_krm_0006_03"><a href="#ref_krm_0006_03">↑</a> (श्लो ४१)</li> <li id="foot_krm_0006_04"><a href="#ref_krm_0006_04">↑</a> [पृष्ठम्०००८+ ३७]</li></ul></p>

अङ्ग
<ul><li><sup id="ref_krm_0007_01"><a href="#foot_krm_0007_01">1</a></sup> {@‘अङ्ग पदे लक्षणे च’@} <sup id="ref_krm_0007_02"><a href="#foot_krm_0007_02">2</a></sup> अदन्तः। </li> <li>पूर्वधातुवत् <sup id="ref_krm_0007_03"><a href="#foot_krm_0007_03">3</a></sup> सर्वाणि रूपाणि ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0007_01"><a href="#ref_krm_0007_01">↑</a> (८)</li> <li id="foot_krm_0007_02"><a href="#ref_krm_0007_02">↑</a> (१०-१९२८-चुरादिः-सक। सेट्-उभ-)</li> <li id="foot_krm_0007_03"><a href="#ref_krm_0007_03">↑</a> (७)</li></ul></p>

