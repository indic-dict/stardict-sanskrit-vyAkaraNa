<ul><li><sup id="ref_krm_0938_01"><a href="#foot_krm_0938_01">1</a></sup> {@“ध्रण शब्दे”@} <sup id="ref_krm_0938_02"><a href="#foot_krm_0938_02">2</a></sup> ध्रणकः-णिका, ध्रणकः-णिका, दिध्रणिषकः-षिका, दंध्रणकः-दन्ध्रणकः-णिका;</li> <li>  इत्यादीनि सर्वाणि रूपाणि भौवादिककणतिवत् <sup id="ref_krm_0938_03"><a href="#foot_krm_0938_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0938_04"><a href="#foot_krm_0938_04">4</a></sup> विध्रणन्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0938_01"><a href="#ref_krm_0938_01">↑</a> (९२८)</li> <li id="foot_krm_0938_02"><a href="#ref_krm_0938_02">↑</a> (१-भ्वादिः-४५९। अक। सेट्। पर।)</li> <li id="foot_krm_0938_03"><a href="#ref_krm_0938_03">↑</a> (१५७)</li> <li id="foot_krm_0938_04"><a href="#ref_krm_0938_04">↑</a> [[आ। ‘प्रश्लोणितान् प्रैणनविध्रणत्क्षितीननुल्बणान् धेनुगणान् कनत्स्तनान्।।’ धा। का। १। ५९।]]</li></ul></p>

उ
<ul><li><sup id="ref_krm_0939_01"><a href="#foot_krm_0939_01">1</a></sup> {@“उ ध्रस उञ्छे”@} <sup id="ref_krm_0939_02"><a href="#foot_krm_0939_02">2</a></sup> ‘ध्रस्नाति ध्रासयत्युञ्छे पदे तु श्नि, णिचि ध्रसेः।’ <sup id="ref_krm_0939_03"><a href="#foot_krm_0939_03">3</a></sup> इति देवः। </li> <li>अुकारोऽत्र इत् इति केचित्। </li> <li>अन्ये तु धात्ववयव इति वदन्ति। </li> <li>उत्पूर्वक एवायं धातुरिति क्षीरस्वामिग्रन्थस्थात् पक्षान्तराज्ज्ञायते। </li> <li>चुरादाव- प्ययं धातुः। </li> <li>तत्राप्युकारो धात्ववयवः, इत् इति पक्षद्वयम्। </li> <li>“यद्युकारो न धात्ववयवः, तदानीम्, ‘ध्रसु’ इत्येव पठेत् ‘क्नसु’ इत्यादिवत्” इति देवा- दीनामाशयः। </li> <li><sup id="ref_krm_0939_04"><a href="#foot_krm_0939_04">4</a></sup> ध्रस्नन्-ती, इति शतरि रूपम्। </li> <li>सर्वाण्यपीतराणि रूपाणि भौवादिकग्रसुधातुवत् <sup id="ref_krm_0939_05"><a href="#foot_krm_0939_05">5</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0939_06"><a href="#foot_krm_0939_06">6</a></sup>] उध्रसितः। </li> <li>ध्रस्तः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0939_01"><a href="#ref_krm_0939_01">↑</a> (९२९)</li> <li id="foot_krm_0939_02"><a href="#ref_krm_0939_02">↑</a> (९-क्र्यादिः-१५२४। अक। सेट्। पर।)</li> <li id="foot_krm_0939_03"><a href="#ref_krm_0939_03">↑</a> (श्लो १९०)</li> <li id="foot_krm_0939_04"><a href="#ref_krm_0939_04">↑</a> [[१। शतरि, ‘क्र्यादिभ्यः--’ (३-१-८१) इति श्नाप्रत्यये, ‘श्नाऽभ्यस्तयोरातः’ (६-४-११२) इत्याकारलोपे च रूपम्।]]</li> <li id="foot_krm_0939_05"><a href="#ref_krm_0939_05">↑</a> (४४०)</li> <li id="foot_krm_0939_06"><a href="#ref_krm_0939_06">↑</a> [[B। ‘ध्रस्तं फलप्रकरमुध्रसितांश्च शालीन् प्रादद्भिरैष्यत गिरा परिविष्टपापैः।।’ धा। का। ३। ११। [अत्र ध्रस्तमिति, उदित्पक्षे क्त्वायाम्, ‘उदितो वा’ (७-२-५६) इतीड्वि- कल्पनात्, निष्ठायाम्, ‘यस्य विभाषा’ (७-२-१५) इति नित्यम् इडभावे रूपम्। इट्पक्षे तु उकारो धात्ववयव इति पक्षान्तरमवलम्ब्य रूपस्य साधुत्वं ज्ञेयम्। तेन उध्रसितान् इति श्लोकेऽत्रैव प्रयोगः कृत इति ज्ञेयम्।]]</li></ul></p>

ध्राक्षि|ध्राङ्क्षकः-|ध्राङ्क्षिका|ध्राङ्क्षकः-क्षिका|दिध्राङ्क्षिषकः-षिका|दाध्राङ्क्षकः-|क्षिका
<ul><li><sup id="ref_krm_0940_01"><a href="#foot_krm_0940_01">1</a></sup> {@“ध्राक्षि घोरवाशिते च”@} <sup id="ref_krm_0940_02"><a href="#foot_krm_0940_02">2</a></sup> चकारात् पूर्वधात्वर्थभूतः ‘काङ्क्षायाम्’ इत्यायमत्रापि सम्बध्यते। </li> <li>ध्राङ्क्षकः- ध्राङ्क्षिका, ध्राङ्क्षकः-क्षिका, दिध्राङ्क्षिषकः-षिका, दाध्राङ्क्षकः- क्षिका;</li> <li>  इत्यादीनि सर्वाणि रूपाणि भौवादिककाङ्क्षतिवत् <sup id="ref_krm_0940_03"><a href="#foot_krm_0940_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0940_04"><a href="#foot_krm_0940_04">4</a></sup> ध्राङ्क्षन्। </li> <li>स्त्रियामङि-- <sup id="ref_krm_0940_05"><a href="#foot_krm_0940_05">5</a></sup> ध्राक्षा इति रूपम्। </li> <li><sup id="ref_krm_0940_06"><a href="#foot_krm_0940_06">6</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0940_01"><a href="#ref_krm_0940_01">↑</a> (९३०)</li> <li id="foot_krm_0940_02"><a href="#ref_krm_0940_02">↑</a> (१-भ्वादिः-६७१। अक। सेट्। पर।)</li> <li id="foot_krm_0940_03"><a href="#ref_krm_0940_03">↑</a> (१८३)</li> <li id="foot_krm_0940_04"><a href="#ref_krm_0940_04">↑</a> [[C। ‘द्राक्षां जनो वाञ्छति नो फलानि ध्राङ्क्षद्बहुध्वाङ्क्षविचूषितानि।।’ धा। का। १। ८५।]]</li> <li id="foot_krm_0940_05"><a href="#ref_krm_0940_05">↑</a> [[२। यवादिषु (८-२-९) पाठसामर्थ्यात् द्राक्षा इत्यत्रेवात्रापि नुमो लोपः।]]</li> <li id="foot_krm_0940_06"><a href="#ref_krm_0940_06">↑</a> [पृष्ठम्०८२०+ २८]</li></ul></p>

ध्राखृ|ध्राखकः-खिका|दिध्राखिषकः-षिका|दाध्राखकः-खिका
<ul><li><sup id="ref_krm_0941_01"><a href="#foot_krm_0941_01">1</a></sup> {@“ध्राखृ शोषणालमर्थयोः”@} <sup id="ref_krm_0941_02"><a href="#foot_krm_0941_02">2</a></sup> ध्राखकः-खिका, ध्राखकः-खिका, दिध्राखिषकः-षिका, दाध्राखकः-खिका;</li> <li>  इत्यादीनि रूपाणि भौवादिकद्राखतिवत् <sup id="ref_krm_0941_03"><a href="#foot_krm_0941_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0941_04"><a href="#foot_krm_0941_04">4</a></sup> ध्राखी।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0941_01"><a href="#ref_krm_0941_01">↑</a> (९३१)</li> <li id="foot_krm_0941_02"><a href="#ref_krm_0941_02">↑</a> (१-भ्वादिः-१२५। सक। सेट्। पर।)</li> <li id="foot_krm_0941_03"><a href="#ref_krm_0941_03">↑</a> (८७९)</li> <li id="foot_krm_0941_04"><a href="#ref_krm_0941_04">↑</a> [[आ। ‘अराखितत्वग्भिरलाखितच्छदैः प्रद्राखिताध्राखिफलैश्च शाखिभिः।’ धा। का। १। १८।]]</li></ul></p>

ध्राडृ|ध्राडकः-डिका|दिध्राडिषकः-षिका|दाध्राडकः-डिका
<ul><li><sup id="ref_krm_0942_01"><a href="#foot_krm_0942_01">1</a></sup> {@“ध्राडृ विशरणे”@} <sup id="ref_krm_0942_02"><a href="#foot_krm_0942_02">2</a></sup> ध्राडकः-डिका, ध्राडकः-डिका, दिध्राडिषकः-षिका, दाध्राडकः-डिका;</li> <li>  इत्यादीनि सर्वाणि रूपाणि भौवादिकद्राखतिवत् <sup id="ref_krm_0942_03"><a href="#foot_krm_0942_03">3</a></sup> ज्ञेयानि। </li> <li>अस्य धातोरात्मनेपदित्वेन शानचि ध्राडमानः इत्यादीनि रूपाण्यूह्यानि। </li> <li><sup id="ref_krm_0942_04"><a href="#foot_krm_0942_04">4</a></sup> ध्राडितः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0942_01"><a href="#ref_krm_0942_01">↑</a> (९३२)</li> <li id="foot_krm_0942_02"><a href="#ref_krm_0942_02">↑</a> (१-भ्वादिः-२८८। सक। सेट्। आत्म।)</li> <li id="foot_krm_0942_03"><a href="#ref_krm_0942_03">↑</a> (८७९)</li> <li id="foot_krm_0942_04"><a href="#ref_krm_0942_04">↑</a> [[B। ‘सुपाकविद्रालिफलालिभिर्द्रुमैः स्निग्धानविध्राडितचारुशालिकान्।।’ धा। का। १। ३८।]]</li></ul></p>

ध्रु|ध्रावकः-विका|दुध्रूषकः-षिका|दोध्रूयकः-यिका
<ul><li><sup id="ref_krm_0943_01"><a href="#foot_krm_0943_01">1</a></sup> {@“ध्रु स्थैर्ये”@} <sup id="ref_krm_0943_02"><a href="#foot_krm_0943_02">2</a></sup> <sup id="ref_krm_0943_03"><a href="#foot_krm_0943_03">3</a></sup> ‘ध्रुव--इत्येव केचित् पठन्तीति ‘ध्रुवमपाये--’ <sup id="ref_krm_0943_04"><a href="#foot_krm_0943_04">4</a></sup> इति सूत्रे पदमञ्जरीकारेणोपादानाज्ज्ञायते।]] ‘स्थैर्ये ध्रवति, गत्यां तु स्थैर्ये च ध्रुवतीति शे।’ <sup id="ref_krm_0943_05"><a href="#foot_krm_0943_05">5</a></sup> इति देवः। </li> <li>ध्रावकः-विका, ध्रावकः-विका, दुध्रूषकः-षिका, दोध्रूयकः-यिका;</li> <li>  इत्यादीनि सर्वाणि रूपाणि भौवादिकद्रवतिवत् <sup id="ref_krm_0943_06"><a href="#foot_krm_0943_06">6</a></sup> ज्ञेयानि। </li> <li>द्रुधातुगतानि विशेषविधानानि तु नात्र भवन्ति। </li> <li><sup id="ref_krm_0943_07"><a href="#foot_krm_0943_07">7</a></sup> ध्रुवः <sup id="ref_krm_0943_08"><a href="#foot_krm_0943_08">8</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0943_01"><a href="#ref_krm_0943_01">↑</a> (९३३)</li> <li id="foot_krm_0943_02"><a href="#ref_krm_0943_02">↑</a> (१-भ्वादिः-९४३। अक। अनि। पर।)</li> <li id="foot_krm_0943_03"><a href="#ref_krm_0943_03">↑</a> [[[अ]</li> <li id="foot_krm_0943_04"><a href="#ref_krm_0943_04">↑</a> (१-४-२४)</li> <li id="foot_krm_0943_05"><a href="#ref_krm_0943_05">↑</a> (श्लो। २२)</li> <li id="foot_krm_0943_06"><a href="#ref_krm_0943_06">↑</a> (८८३)</li> <li id="foot_krm_0943_07"><a href="#ref_krm_0943_07">↑</a> [[C। ‘श्रुत्यन्तवाचा ध्रुवया प्रदूनं घोरद्रवच्चक्रजिताज्ञितारिम्।’ धा। का। २। ३५।]]</li> <li id="foot_krm_0943_08"><a href="#ref_krm_0943_08">↑</a> [[१। ‘ध्रुवमपायेऽपादानम्’ (१-४-२४) इति निर्देशात् बाहुलकात् कर्तरि कप्रत्यये उवङ्।]]</li></ul></p>

ध्रु|ध्रावकः-विका|दुध्रूषकः-षिका|दोध्रूयकः-यिका
<ul><li><sup id="ref_krm_0944_01"><a href="#foot_krm_0944_01">1</a></sup> {@“ध्रु गतिस्थैर्ययोः”@} <sup id="ref_krm_0944_02"><a href="#foot_krm_0944_02">2</a></sup> कुटादिः। </li> <li>‘ध्रुव--’ इति केचित् पठन्ति। </li> <li>तेषां मते <sup id="ref_krm_0944_03"><a href="#foot_krm_0944_03">3</a></sup> सेडयं धातुः। </li> <li>‘स्थैर्ये ध्रवति, गत्यां तु स्थैर्ये च ध्रुवतीति शे।’ <sup id="ref_krm_0944_04"><a href="#foot_krm_0944_04">4</a></sup> इति देवः। </li> <li>ध्रावकः-विका, ध्रावकः-विका, दुध्रूषकः-षिका, दोध्रूयकः-यिका;</li> <li>  इत्यादीनि सर्वाणि रूपाणि तौदादिकगुवतिवत् <sup id="ref_krm_0944_05"><a href="#foot_krm_0944_05">5</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0944_06"><a href="#foot_krm_0944_06">6</a></sup> ध्रुवन्-ती। </li> <li><sup id="ref_krm_0944_07"><a href="#foot_krm_0944_07">7</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0944_01"><a href="#ref_krm_0944_01">↑</a> (९३४)</li> <li id="foot_krm_0944_02"><a href="#ref_krm_0944_02">↑</a> (६-तुदादिः-१४००। अक। अनि। पर।)</li> <li id="foot_krm_0944_03"><a href="#ref_krm_0944_03">↑</a> [[२। इट्पक्षे ध्रुवितः, ध्रुवितव्यम् इत्यादीनि रूपाणि यथायथमूह्यानि। क्तिनि ध्रूतिः इति भवति। ऊठि रूपमेवम् इति विशेषः।]]</li> <li id="foot_krm_0944_04"><a href="#ref_krm_0944_04">↑</a> (श्लो। २२)</li> <li id="foot_krm_0944_05"><a href="#ref_krm_0944_05">↑</a> (३९६)</li> <li id="foot_krm_0944_06"><a href="#ref_krm_0944_06">↑</a> [[ड्। ‘नूत्या किं भयधूतविध्रुतगुवल्लोकं तदा तद्ध्रुवत्- कोदण्डं कुवमानमैक्षि दलितं भोजेश्वराकूतवत्’।। धा। का। २। ८२।]]</li> <li id="foot_krm_0944_07"><a href="#ref_krm_0944_07">↑</a> [पृष्ठम्०८२१+ २८]</li></ul></p>

ध्रेकृ|ध्रेककः-किका|दिध्रेकिषकः-|षिका|देध्रेककः-किका
<ul><li><sup id="ref_krm_0945_01"><a href="#foot_krm_0945_01">1</a></sup> {@“ध्रेकृ शब्दोत्साहयोः”@} <sup id="ref_krm_0945_02"><a href="#foot_krm_0945_02">2</a></sup> उत्साहः = वृद्धिरौद्धत्यं वा। </li> <li>‘शब्दोत्साहे’ इति केचित्। </li> <li>शब्दोत्साहः = शब्देन स्वोत्साहस्याविष्करणम्। </li> <li>ध्रेककः-किका, ध्रेककः-किका, दिध्रेकिषकः- षिका, देध्रेककः-किका;</li> <li>  <sup id="ref_krm_0945_03"><a href="#foot_krm_0945_03">3</a></sup> ध्रेकणः। </li> <li>इत्यादीनि सर्वाण्यपि रूपाणि भौवादिक- केपतिवत् <sup id="ref_krm_0945_04"><a href="#foot_krm_0945_04">4</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0945_01"><a href="#ref_krm_0945_01">↑</a> (९३५)</li> <li id="foot_krm_0945_02"><a href="#ref_krm_0945_02">↑</a> (१-भ्वादिः-७९। अक। सेट्। आत्म।)</li> <li id="foot_krm_0945_03"><a href="#ref_krm_0945_03">↑</a> [[१। ‘चलनशब्दार्थादकर्मकाद् युच्’ (३-२-१४८) इति तच्छीलादिषु कर्तृषु युच्प्रत्ययः। ‘अट्कुपु--’ (८। ४। २) इति णत्वम्।]]</li> <li id="foot_krm_0945_04"><a href="#ref_krm_0945_04">↑</a> (२६१)</li></ul></p>

ध्रै|ध्रायकः-यिका|ध्रापकः-पिका|दिध्रासकः-सिका|दाध्रायकः-यिका
<ul><li><sup id="ref_krm_0946_01"><a href="#foot_krm_0946_01">1</a></sup> {@“ध्रै तृप्तौ”@} <sup id="ref_krm_0946_02"><a href="#foot_krm_0946_02">2</a></sup> ध्रायकः-यिका, ध्रापकः-पिका, दिध्रासकः-सिका, दाध्रायकः-यिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककायतिवत् <sup id="ref_krm_0946_03"><a href="#foot_krm_0946_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0946_04"><a href="#foot_krm_0946_04">4</a></sup> ध्राणः। </li> <li>“<sup id="ref_krm_0946_05"><a href="#foot_krm_0946_05">5</a></sup> भाष्ये नत्वं नेष्यते ध्रातः।” इति क्षीरतरङ्गिणी। </li> <li>भाष्ये त्वेतादृशं वचनं नोपलभ्यते।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0946_01"><a href="#ref_krm_0946_01">↑</a> (९३६)</li> <li id="foot_krm_0946_02"><a href="#ref_krm_0946_02">↑</a> (१-भ्वादिः-९०७। अक। अनि। पर।)</li> <li id="foot_krm_0946_03"><a href="#ref_krm_0946_03">↑</a> (२६३)</li> <li id="foot_krm_0946_04"><a href="#ref_krm_0946_04">↑</a> [[आ। ‘निद्रायदिन्दीवरभाजि मज्जन्नध्राणधीस्तत्र च तं ददर्श।।’ धा। का। २। ३०।]]</li> <li id="foot_krm_0946_05"><a href="#ref_krm_0946_05">↑</a> [क्तप्रत्यये]</li></ul></p>

ध्वज|ध्वाजकः-जिका|दिध्वजिषकः-षिका|दाध्वजकः-जिका
<ul><li><sup id="ref_krm_0947_01"><a href="#foot_krm_0947_01">1</a></sup> {@“ध्वज गतौ”@} <sup id="ref_krm_0947_02"><a href="#foot_krm_0947_02">2</a></sup> ‘धर्जेद् धृञ्जेद् ध्रजेद् ध्रञ्जेद् ध्वजेद् ध्वञ्जेद् गतौ शपि।’ <sup id="ref_krm_0947_03"><a href="#foot_krm_0947_03">3</a></sup> इति देवः। </li> <li>ध्वाजकः-जिका, ध्वाजकः-जिका, दिध्वजिषकः-षिका, दाध्वजकः-जिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकध्रजतिवत् <sup id="ref_krm_0947_04"><a href="#foot_krm_0947_04">4</a></sup> ज्ञेयानि। </li> <li>पचाद्यचि-ध्वजः <sup id="ref_krm_0947_05"><a href="#foot_krm_0947_05">5</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0947_01"><a href="#ref_krm_0947_01">↑</a> (९३७)</li> <li id="foot_krm_0947_02"><a href="#ref_krm_0947_02">↑</a> (१-भ्वादिः-२२१। सक। सेट्। पर।)</li> <li id="foot_krm_0947_03"><a href="#ref_krm_0947_03">↑</a> (श्लो। ६०)</li> <li id="foot_krm_0947_04"><a href="#ref_krm_0947_04">↑</a> (९२६)</li> <li id="foot_krm_0947_05"><a href="#ref_krm_0947_05">↑</a> [[B। ‘प्रध्रज्य मोदं स दधृञ्ज तद्वनं ध्वजोद्गतेध्वञ्जितकूजदण्डजम्।’ धा। का। १। ३०।]]</li></ul></p>

ध्वजि|ध्वञ्जकः-ञ्जिका|दिध्वञ्जिषकः-षिका|दाध्वञ्जकः-ञ्जिका
<ul><li><sup id="ref_krm_0948_01"><a href="#foot_krm_0948_01">1</a></sup> {@“ध्वजि गतौ”@} <sup id="ref_krm_0948_02"><a href="#foot_krm_0948_02">2</a></sup> ‘धर्जेद् धृञ्जेद् ध्रजेद् ध्रञ्जेद् ध्वजेद् ध्वञ्जेद् गतौ शपि।’ <sup id="ref_krm_0948_03"><a href="#foot_krm_0948_03">3</a></sup> इति देवः। </li> <li>ध्वञ्जकः-ञ्जिका, ध्वञ्जकः-ञ्जिका, दिध्वञ्जिषकः-षिका, दाध्वञ्जकः-ञ्जिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकध्रजतिवत् <sup id="ref_krm_0948_04"><a href="#foot_krm_0948_04">4</a></sup> ज्ञेयानि। </li> <li>इदि- त्त्वादस्य धातोः नुम् सर्वत्र भवतीति विशेषः। </li> <li><sup id="ref_krm_0948_05"><a href="#foot_krm_0948_05">5</a></sup> ध्वञ्जितः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0948_01"><a href="#ref_krm_0948_01">↑</a> (९३८)</li> <li id="foot_krm_0948_02"><a href="#ref_krm_0948_02">↑</a> (१-भ्वादिः-२२२। सक। सेट्। पर।)</li> <li id="foot_krm_0948_03"><a href="#ref_krm_0948_03">↑</a> (श्लो। ६०)</li> <li id="foot_krm_0948_04"><a href="#ref_krm_0948_04">↑</a> (९२६)</li> <li id="foot_krm_0948_05"><a href="#ref_krm_0948_05">↑</a> [[B। ‘प्रध्रज्य मोदं स दधृञ्ज तद्वनं ध्वजोद्गतिध्वञ्जितकूजदण्डजम्।’ धा। का। १। ३०।]]</li></ul></p>

ध्वण|ध्वाणकः-णिका|दिध्वणिषकः-षिका|दन्ध्वणकः-णिका
<ul><li><sup id="ref_krm_0949_01"><a href="#foot_krm_0949_01">1</a></sup> {@“ध्वण शब्दार्थः”@} <sup id="ref_krm_0949_02"><a href="#foot_krm_0949_02">2</a></sup> ‘मूर्धन्यान्तो ध्वणिर्लोके नास्ति।’ इति क्षीरस्वामी। </li> <li>‘ध्रण--’ इति सम्मताकारपक्षे पाठः। </li> <li>‘धण--’ इति सिद्धान्तकौमुदी। </li> <li><sup id="ref_krm_0949_03"><a href="#foot_krm_0949_03">3</a></sup> ध्वाणकः-णिका, ध्वाणकः-णिका, दिध्वणिषकः-षिका, दन्ध्वणकः-णिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकक्वणतिवत् <sup id="ref_krm_0949_04"><a href="#foot_krm_0949_04">4</a></sup> ज्ञेयानि। </li> <li>शतरि-- <sup id="ref_krm_0949_05"><a href="#foot_krm_0949_05">5</a></sup> ध्वणन्-न्ती, इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0949_01"><a href="#ref_krm_0949_01">↑</a> (९३९)</li> <li id="foot_krm_0949_02"><a href="#ref_krm_0949_02">↑</a> (१-भ्वादिः-४५३। अक। सेट्। पर।)</li> <li id="foot_krm_0949_03"><a href="#ref_krm_0949_03">↑</a> [पृष्ठम्०८२२+ २३]</li> <li id="foot_krm_0949_04"><a href="#ref_krm_0949_04">↑</a> (२९३)</li> <li id="foot_krm_0949_05"><a href="#ref_krm_0949_05">↑</a> [[आ। ‘ध्वणच्छिशून् धाणसमोणिताशुभान् शोणान् पृथुश्रोणिजनो दुदोह च।’ धा। का। १। ५९।]]</li></ul></p>

ध्वन|ध्वानकः-निका|ध्वनकः-ध्वानकः-निका|दिध्वनिषकः-षिका|दन्ध्वनकः-दंध्वनकः-निका|ध्वनिता-त्री|ध्वनयिता-ध्वानयिता-त्री|दिध्वनिषिता-त्री|दन्ध्वनिता-दंध्वनिता-त्री|ध्वनन्-न्ती|ध्वनयन्-ध्वानयन्-न्ती|दिध्वनिषन्-न्ती|-|ध्वनिष्यन्-न्ती-ती|ध्वनयिष्यन्-ध्वानयिष्यन्-न्ती-ती|दिध्वनिषिष्यन्-न्ती-ती|व्यतिध्वनमानः|ध्वनयमानः-ध्वानयमानः|दन्ध्वन्यमानः|दंध्न्वन्यमानः|व्यतिध्वनिष्यमाणः|ध्वानयिष्यमाणः|दन्ध्वनिष्यमाणः-दंध्वनिष्यमाणः|सुध्वान्-सुध्वानौ-सुध्वानः|-ध्वनितम्-तः-तवान्|ध्वान्तः|ध्वनितः-ध्वानितः|दिध्वनिषितः-दन्ध्वनितः-दंध्वनितः-तवान्|ध्वनः|ध्वननः|ध्वनः-ध्वानः|दिध्वनिषुः|दन्ध्वनः|ध्वनितव्यम्|ध्वनयितव्यम्-ध्वानयितव्यम्|दिध्वनिषितव्यम्|दन्ध्वनितव्यम्-दंध्वनितव्यम्|ध्वननीयम्|ध्वननीयम्-ध्वाननीयम्|दिध्वनिषणीयम्|दन्ध्वननीयम्-दंध्वननीयम्|ध्वान्यम्|ध्वन्यम्-ध्वान्यम्|दिध्वनिष्यम्|दन्ध्वन्यम्-दंध्वन्यम्|ईषद्ध्वनः-दुर्ध्वनः-सुध्वनः|ध्वन्यमानः|ध्वन्यमानः-ध्वान्यमानः|दिध्वनिष्यमाणः|दन्ध्वन्यमानः-दंध्वन्यमानः|ध्वानः|दिध्वनिषः|दन्ध्वनः-दंध्वनः|ध्वनितुम्|ध्वनयितुम्-ध्वानयितुम्|दिध्वनिषितुम्|दन्ध्वनितुम्-दंध्वनितुम्|ध्वान्तिः|ध्वनना-ध्वानना|दिध्वनिषा|दन्ध्वना-दंध्वना|ध्वननम्|ध्वननम्-ध्वाननम्|दिध्वनिषणम्|दंन्ध्वननम्-दंध्वननम्|ध्वनित्वा|ध्वनयित्वा-ध्वानयित्वा|दिध्वनिषित्वा|दन्ध्वनित्वा-दंध्वनित्वा|प्रध्वन्य|प्रध्वनय्य-प्रध्वान्य|प्रदिध्वनिष्य|प्रदन्ध्वन्य-प्रदंध्वन्य|ध्वानम्|ध्वनम्-ध्वानम्-ध्वानम्|ध्वनयित्वा|ध्वानयित्वा|दिध्वनिषम्|दन्ध्वनम्-दंध्वनम्|दन्ध्वनित्वादंध्वनित्वा
<ul><li><sup id="ref_krm_0950_01"><a href="#foot_krm_0950_01">1</a></sup> {@“ध्वन शब्दे”@} <sup id="ref_krm_0950_02"><a href="#foot_krm_0950_02">2</a></sup> घटादिः। </li> <li>‘ध्वनयेदित्यदन्तस्य ध्वनेः शब्दे ध्वनेत् शपि।।’ <sup id="ref_krm_0950_03"><a href="#foot_krm_0950_03">3</a></sup> इति देवः। </li> <li>ध्वानकः-निका, <sup id="ref_krm_0950_04"><a href="#foot_krm_0950_04">4</a></sup> ध्वनकः-ध्वानकः-निका, दिध्वनिषकः-षिका, <sup id="ref_krm_0950_05"><a href="#foot_krm_0950_05">5</a></sup> दन्ध्वनकः-दंध्वनकः-निका;</li> <li>  ध्वनिता-त्री, ध्वनयिता-ध्वानयिता-त्री, दिध्वनिषिता-त्री, दन्ध्वनिता-दंध्वनिता-त्री;</li> <li>  ध्वनन्-न्ती, <sup id="ref_krm_0950_06"><a href="#foot_krm_0950_06">6</a></sup> ध्वनयन्-ध्वानयन्-न्ती, दिध्वनिषन्-न्ती;</li> <li>  -- ध्वनिष्यन्-न्ती-ती, ध्वनयिष्यन्-ध्वानयिष्यन्-न्ती-ती, दिध्वनिषिष्यन्-न्ती-ती;</li> <li>  <sup id="ref_krm_0950_07"><a href="#foot_krm_0950_07">7</a></sup> व्यतिध्वनमानः, <sup id="ref_krm_0950_08"><a href="#foot_krm_0950_08">8</a></sup> ध्वनयमानः-ध्वानयमानः, -- दन्ध्वन्यमानः, दंध्न्वन्यमानः;</li> <li>  व्यतिध्वनिष्यमाणः, ध्वानयिष्यमाणः, -- दन्ध्वनिष्यमाणः-दंध्वनिष्यमाणः;</li> <li>  <sup id="ref_krm_0950_09"><a href="#foot_krm_0950_09">9</a></sup> सुध्वान्-सुध्वानौ-सुध्वानः;</li> <li>  -- -- -- <sup id="ref_krm_0950_10"><a href="#foot_krm_0950_10">10</a></sup> ध्वनितम्-तः-तवान्, <sup id="ref_krm_0950_11"><a href="#foot_krm_0950_11">11</a></sup> ध्वान्तः, <sup id="ref_krm_0950_12"><a href="#foot_krm_0950_12">12</a></sup> ध्वनितः-ध्वानितः, दिध्वनिषितः-दन्ध्वनितः-दंध्वनितः-तवान्;</li> <li>  ध्वनः, <sup id="ref_krm_0950_13"><a href="#foot_krm_0950_13">13</a></sup> ध्वननः, ध्वनः-ध्वानः, दिध्वनिषुः, दन्ध्वनः;</li> <li>  ध्वनितव्यम्, ध्वनयितव्यम्-ध्वानयितव्यम्, दिध्वनिषितव्यम्, दन्ध्वनितव्यम्-दंध्वनितव्यम्;</li> <li>  ध्वननीयम्, ध्वननीयम्-ध्वाननीयम्, दिध्वनिषणीयम्, दन्ध्वननीयम्-दंध्वननीयम्;</li> <li>  ध्वान्यम्, ध्वन्यम्-ध्वान्यम्, दिध्वनिष्यम्, दन्ध्वन्यम्-दंध्वन्यम्;</li> <li>  ईषद्ध्वनः-दुर्ध्वनः-सुध्वनः;</li> <li>  -- -- -- ध्वन्यमानः, ध्वन्यमानः-ध्वान्यमानः, दिध्वनिष्यमाणः, दन्ध्वन्यमानः-दंध्वन्यमानः;</li> <li>  ध्वानः, ध्वनः-ध्वानः, दिध्वनिषः, दन्ध्वनः-दंध्वनः;</li> <li>  ध्वनितुम्, ध्वनयितुम्-ध्वानयितुम्, दिध्वनिषितुम्, दन्ध्वनितुम्-दंध्वनितुम्;</li> <li>  <sup id="ref_krm_0950_14"><a href="#foot_krm_0950_14">14</a></sup> ध्वान्तिः, ध्वनना-ध्वानना, दिध्वनिषा, दन्ध्वना-दंध्वना;</li> <li>  ध्वननम्, ध्वननम्-ध्वाननम् दिध्वनिषणम्, दंन्ध्वननम्-दंध्वननम्;</li> <li>  ध्वनित्वा, ध्वनयित्वा-ध्वानयित्वा, दिध्वनिषित्वा, दन्ध्वनित्वा-दंध्वनित्वा;</li> <li>  प्रध्वन्य, <sup id="ref_krm_0950_15"><a href="#foot_krm_0950_15">15</a></sup> प्रध्वनय्य-प्रध्वान्य, प्रदिध्वनिष्य, प्रदन्ध्वन्य-प्रदंध्वन्य;</li> <li>  ध्वानम् २, ध्वनित्वा २, <sup id="ref_krm_0950_16"><a href="#foot_krm_0950_16">16</a></sup> ध्वनम् २ -ध्वानम् २ -ध्वानम् २, ध्वनयित्वा २, ध्वानयित्वा २, दिध्वनिषम् २, दिध्वनिषित्वा २, दन्ध्वनम् २ -दंध्वनम् २;</li> <li>  दन्ध्वनित्वा २ दंध्वनित्वा २;</li> <li>  <sup id="ref_krm_0950_17"><a href="#foot_krm_0950_17">17</a></sup> ध्वनिः। </li> <li><sup id="ref_krm_0950_18"><a href="#foot_krm_0950_18">18</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0950_01"><a href="#ref_krm_0950_01">↑</a> (९४०)</li> <li id="foot_krm_0950_02"><a href="#ref_krm_0950_02">↑</a> (१-भ्वादिः-८१६। ८२८। अक। सेट्। पर।)</li> <li id="foot_krm_0950_03"><a href="#ref_krm_0950_03">↑</a> (श्लो। १२६)</li> <li id="foot_krm_0950_04"><a href="#ref_krm_0950_04">↑</a> [[१। शब्दार्थकस्यास्य धातोः घटादिषु पाठान्मित्त्वेन णौ, ‘मितां ह्रस्वः’ (६-४-९२) इति ह्रस्वः। व्यक्तध्वनिः, अव्यक्तध्वनिः इति द्विविधः शब्दः। व्यक्तध्वनिविषये घटादिरयम्। ‘ध्वनयति घण्टाम्’ स्पष्टं वादयतीत्यर्थः। ‘ध्वानयति देवदत्तः’। अस्पष्टाक्षरमुच्चारयतीत्यर्थः।]]</li> <li id="foot_krm_0950_05"><a href="#ref_krm_0950_05">↑</a> [[२। यङन्ताण्ण्वुलि, ‘नुगतोऽनुनासिकान्तस्य’ (७-४-८५) इत्यभ्यासस्य नुगागमः। ‘स च पदान्तवद्वाच्यः’ (वा। ७-४-८५) इति वचनात् परसवर्णविकल्पे दंध्वनकः इत्यादीनि रूपाणि ण्वुलादिषु यथायथं भवन्ति।]]</li> <li id="foot_krm_0950_06"><a href="#ref_krm_0950_06">↑</a> [[B। ‘दृश्येत वेणुं ध्वनयन् कदा वा स नन्दसूनुः स्वनयन् कलापम्।।’ धा। का। २। १३।]]</li> <li id="foot_krm_0950_07"><a href="#ref_krm_0950_07">↑</a> [[३। ‘कर्तरि कर्मव्यतीहारे’ (१-३-१४) इति शानच्।]]</li> <li id="foot_krm_0950_08"><a href="#ref_krm_0950_08">↑</a> [[४। ‘अणावकर्मकात् चित्तवत्कर्तृकात्’ (१-३-८८) इति ण्यन्तात् परस्मैपदमेव। यदा तु अचित्तवत्कर्तृकत्वविवक्षा, तदानीं निर्दिष्टप्रकारेण शानजपि भवतीति विशेषः।]]</li> <li id="foot_krm_0950_09"><a href="#ref_krm_0950_09">↑</a> [[५। क्विपि, ‘अनुनासिकस्य क्विझलोः क्ङिति’ (६-४-१५) इति दीर्घः।]]</li> <li id="foot_krm_0950_10"><a href="#ref_krm_0950_10">↑</a> [पृष्ठम्०८२३+ २५]</li> <li id="foot_krm_0950_11"><a href="#ref_krm_0950_11">↑</a> [[१। ‘क्षुब्धस्वान्तध्वान्तलग्नम्लिष्टविरिब्धफाण्टबाढानि मन्थमनस्तमःसक्ताविस्पष्ट- स्वरानायासभृशेषु’ (७-२-१८) इत्यनेन तमसि वाच्ये ध्वान्तम् इति भवति। ‘ध्वनितो मृदङ्गः’ इत्यत्र तु न, तमोऽर्थकत्वाभावात्।]]</li> <li id="foot_krm_0950_12"><a href="#ref_krm_0950_12">↑</a> [[आ। ‘संज्वारिणेव मनसा ध्वान्तमायासिना मया।’ भ। का। ७। ६।]]</li> <li id="foot_krm_0950_13"><a href="#ref_krm_0950_13">↑</a> [[२। ‘चलनशब्दार्थादकर्मकाद् युच्’ (३-२-१४८) इति तच्छीलादिषु कर्तृषु युच्- प्रत्ययः।]]</li> <li id="foot_krm_0950_14"><a href="#ref_krm_0950_14">↑</a> [[३। क्तिनि, ‘तितुत्रतथ--’ (७-२-९) इत्यादिना इण्निषेधे, दीर्घे च रूपम्।]]</li> <li id="foot_krm_0950_15"><a href="#ref_krm_0950_15">↑</a> [[४। मित्त्वपक्षे ण्यन्ताल्ल्यपि ह्रस्वे, ‘ल्यपि लघुपूर्वात्’ (६-४-५६) इति णेरयादेशः।]]</li> <li id="foot_krm_0950_16"><a href="#ref_krm_0950_16">↑</a> [[५। मित्त्वपक्षे, ण्यन्ताण्णमुलि, ‘चिण्णमुलोर्दीर्घोऽन्यतरस्याम्’ (६-४-९३) इति दीर्घविकल्पः।]]</li> <li id="foot_krm_0950_17"><a href="#ref_krm_0950_17">↑</a> [[६। ‘खनिकष्यज्यसिवसिवनिध्वनिग्रन्थिचलिभ्यश्च’ (द। उ। १। ६८) इत्यादिना इप्रत्यये रूपम्।]]</li> <li id="foot_krm_0950_18"><a href="#ref_krm_0950_18">↑</a> [पृष्ठम्०८२४+ २७]</li></ul></p>

ध्वन|ध्वनकः-निका|दिध्वनयिषकः-षिका
<ul><li><sup id="ref_krm_0951_01"><a href="#foot_krm_0951_01">1</a></sup> {@“ध्वन शब्दे”@} <sup id="ref_krm_0951_02"><a href="#foot_krm_0951_02">2</a></sup> ‘ध्वनयेदित्यदन्तस्य ध्वनेः शब्दे ध्वनेत् शपि।।’ <sup id="ref_krm_0951_03"><a href="#foot_krm_0951_03">3</a></sup> इति देवः। </li> <li>ध्वनकः-निका, दिध्वनयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिककृपयतिवत् <sup id="ref_krm_0951_04"><a href="#foot_krm_0951_04">4</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0951_01"><a href="#ref_krm_0951_01">↑</a> (९४१)</li> <li id="foot_krm_0951_02"><a href="#ref_krm_0951_02">↑</a> (१०-चुरादिः-१८९०। अक। सेट्। उभ। अदन्तः।)</li> <li id="foot_krm_0951_03"><a href="#ref_krm_0951_03">↑</a> (श्लो। १२६)</li> <li id="foot_krm_0951_04"><a href="#ref_krm_0951_04">↑</a> (२५१)</li></ul></p>

