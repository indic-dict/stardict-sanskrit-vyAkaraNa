<ul><li><sup id="ref_krm_0356_01"><a href="#foot_krm_0356_01">1</a></sup> {@“खिद दैन्ये”@} <sup id="ref_krm_0356_02"><a href="#foot_krm_0356_02">2</a></sup> ‘दैन्येऽर्थे खिद्यते खिन्ते, परिघाते<sup id="ref_krm_0356_03"><a href="#foot_krm_0356_03">3</a></sup> तु खिन्दति।’ <sup id="ref_krm_0356_04"><a href="#foot_krm_0356_04">4</a></sup> इति देवः। </li> <li>खेदकः-दिका, खेदकः-दिका, <sup id="ref_krm_0356_05"><a href="#foot_krm_0356_05">5</a></sup> चिखित्सकः-त्सिका, <sup id="ref_krm_0356_06"><a href="#foot_krm_0356_06">6</a></sup> चेखिदकः-दिका;</li> <li>  खेत्ता-त्त्री, खेदयिता-त्री, चिखित्सिता-त्री, चेखिदिता-त्री;</li> <li>  खेदयन्-न्ती, खेदयिष्यन्-न्ती-ती;</li> <li>  -- -- <sup id="ref_krm_0356_07"><a href="#foot_krm_0356_07">7</a></sup> खिद्यमानः, खेदयमानः, चिखित्समानः, चेखिद्यमानः;</li> <li>  खेत्स्यमानः, खेदयिष्यमाणः, चिखित्सिष्यमाणः, चेखिदिष्यमाणः;</li> <li>  खित्-खिद्-खिदौ-खिदः;</li> <li>  -- -- <sup id="ref_krm_0356_08"><a href="#foot_krm_0356_08">8</a></sup> खिन्नम्-खिन्नः-खिन्नवान्, खेदितः, चिखित्सितः, चेखिदितः-तवान्;</li> <li>  <sup id="ref_krm_0356_09"><a href="#foot_krm_0356_09">9</a></sup> खिदः, खेदनः <sup id="ref_krm_0356_10"><a href="#foot_krm_0356_10">10</a></sup>, खेदः, चिखित्सुः, चेखिदः;</li> <li>  खेत्तव्यम्, खेदयितव्यम्, चिखित्सितव्यम्, चेखिदितव्यम्;</li> <li>  खेदनीयम्, खेदनीयम्, चिखित्सनीयम्, चेखिदनीयम्;</li> <li>  खेद्यम्, खेद्यम्, चिखित्स्यम्, चेखिद्यम्;</li> <li>  ईषत्खेदः-दुष्खेदः-सुखेदः;</li> <li>  -- -- <sup id="ref_krm_0356_11"><a href="#foot_krm_0356_11">11</a></sup> खिद्यमानः, खेद्यमानः, चिखित्स्यमानः, चेखिद्यमानः;</li> <li>  <sup id="ref_krm_0356_12"><a href="#foot_krm_0356_12">12</a></sup> खेदः, खेदः, चिखित्सः, चेखिदः;</li> <li>  खेत्तुम्, खेदयितुम्, चिखित्सितुम्, चेखिदितुम्;</li> <li>  <sup id="ref_krm_0356_13"><a href="#foot_krm_0356_13">13</a></sup> खिदा, खेदना, चिखित्सा, चेखिदा;</li> <li>  खेदनम्, खेदनम्, चिखित्सनम्, चेखिदनम्;</li> <li>  खित्त्वा, खेदयित्वा, चिखित्सित्वा, चेखिदित्वा;</li> <li>  सङ्खिद्य, सङ्खेद्य, प्रचिखित्स्य, प्रचेखिद्य;</li> <li>  खेदम् २, खित्त्वा २, खेदम् २, खेदयित्वा २, चिखित्सम् २, चिखित्सित्वा २, चेखिदम् २;</li> <li>  चेखिदित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0356_01"><a href="#ref_krm_0356_01">↑</a> (३४९)</li> <li id="foot_krm_0356_02"><a href="#ref_krm_0356_02">↑</a> (४-दिवादिः-११७०। अक। अनि। आत्म।)</li> <li id="foot_krm_0356_03"><a href="#ref_krm_0356_03">↑</a> [तापे]</li> <li id="foot_krm_0356_04"><a href="#ref_krm_0356_04">↑</a> (श्लो। ११२)</li> <li id="foot_krm_0356_05"><a href="#ref_krm_0356_05">↑</a> [[१। ‘हलन्ताच्च’ (१-२-१०) इति सनः कित्त्वम्। तेनाङ्गस्य गुणो न।]]</li> <li id="foot_krm_0356_06"><a href="#ref_krm_0356_06">↑</a> [[२। ‘गुणो यङ्लुकोः’ (७-४-८२) इत्यभ्यासस्य गुणः।]]</li> <li id="foot_krm_0356_07"><a href="#ref_krm_0356_07">↑</a> [[३। ‘दिवादिभ्यः श्यन्’ (३-१-६९) इति श्यन्विकरणप्रत्ययः।]]</li> <li id="foot_krm_0356_08"><a href="#ref_krm_0356_08">↑</a> [[४। ‘रदाभ्यां निष्ठातो नः पूर्वस्य च दः’ (८-२-४२) इति धातुदकारनिष्ठातकारयोः मत्वम्।]]</li> <li id="foot_krm_0356_09"><a href="#ref_krm_0356_09">↑</a> [[५। ‘इगुषधज्ञाप्रीकिरः कः’ (३-१-१३५) इति कर्तरि कः प्रत्ययः।]]</li> <li id="foot_krm_0356_10"><a href="#ref_krm_0356_10">↑</a> [[६। ‘अनुदात्तेतश्च हलादेः’ (३-२-१४९) इति ताच्छीलिको युच्।]]</li> <li id="foot_krm_0356_11"><a href="#ref_krm_0356_11">↑</a> [पृष्ठम्०३५४+ २४]</li> <li id="foot_krm_0356_12"><a href="#ref_krm_0356_12">↑</a> [[आ। ‘तन्मृष्यमाणास्त्वथ शुच्यदङ्गकाः भृत्याः सुनद्धं बहुरक्तमंशुकम्। विसृज्य शप्यन्त इमं प्रदुद्रुवुः कृष्णः प्रपेदे वसनान्यखेदवान्।।’ धा। का। २-६१।]]</li> <li id="foot_krm_0356_13"><a href="#ref_krm_0356_13">↑</a> [[१। भिदादिपाठात् (३-३-१०४) खिदा इत्यत्राङ्।]]</li></ul></p>

खिद
<ul><li><sup id="ref_krm_0357_01"><a href="#foot_krm_0357_01">1</a></sup> {@“खिद परिघाते”@} <sup id="ref_krm_0357_02"><a href="#foot_krm_0357_02">2</a></sup> ‘परितापे’ इति क्षीरस्वामी। </li> <li>मुचादिः। </li> <li>‘दैन्येऽर्थे खिद्यते खिन्ते, परितापे <sup id="ref_krm_0357_03"><a href="#foot_krm_0357_03">3</a></sup> तु खिन्दति।’ <sup id="ref_krm_0357_04"><a href="#foot_krm_0357_04">4</a></sup> इति देवः। </li> <li><sup id="ref_krm_0357_05"><a href="#foot_krm_0357_05">5</a></sup> खिन्दन्-न्ती-ती, <sup id="ref_krm_0357_06"><a href="#foot_krm_0357_06">6</a></sup> खेत्स्यन्-न्ती-ती, <sup id="ref_krm_0357_07"><a href="#foot_krm_0357_07">7</a></sup> परिखेदितम्, इत्यादीनि रूपाण्यस्य घातोः विशेषः। </li> <li>अन्यानि सर्वाण्यपि रूपाणि दैवादिकदैन्यार्थक <sup id="ref_krm_0357_08"><a href="#foot_krm_0357_08">8</a></sup> खिद्यतिवत् ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0357_01"><a href="#ref_krm_0357_01">↑</a> (३५०)</li> <li id="foot_krm_0357_02"><a href="#ref_krm_0357_02">↑</a> (६-तुदादिः-१४३६। सक। अनि। पर।)</li> <li id="foot_krm_0357_03"><a href="#ref_krm_0357_03">↑</a> (घाते)</li> <li id="foot_krm_0357_04"><a href="#ref_krm_0357_04">↑</a> (श्लो-११२)</li> <li id="foot_krm_0357_05"><a href="#ref_krm_0357_05">↑</a> [[२। ‘तुदादिभ्यः शः’ (३-१-७७) इति शः विकरणप्रत्ययः। ‘शे मुचादीनाम्’ (७-१-५९) इति नुम्। ‘आच्छीनद्योर्नुम्’ (७-१-८०) इति नुमो वैकल्पिकत्वम्।]]</li> <li id="foot_krm_0357_06"><a href="#ref_krm_0357_06">↑</a> [[B। ‘मित्रैः संमिलमान एत्य नगरोद्यानं विमुञ्चन् भियं गोपानां भयलोपिवाग्भिरबलाविन्नानुलेपं वहन्। भुक्त्वा गोरससिक्तमन्नमजितः कंसस्य कृन्तन् मुदं तं खेत्स्यन् पिशिताशदारुणमसौ मोदेन निन्ये निशाम्।।’ धा। का। २-८५।]]</li> <li id="foot_krm_0357_07"><a href="#ref_krm_0357_07">↑</a> [[C। ‘परिखेदितविन्ध्यवीरुधः परिपीतामलनिर्झराम्भसः। दुधुवुर्मधुकाननं ततः कपिनागा मुदिताङ्गदाज्ञया।।’ भ। का। १०। २८।]]</li> <li id="foot_krm_0357_08"><a href="#ref_krm_0357_08">↑</a> (३४९)</li></ul></p>

खिद|खिन्दानः|खेत्स्यमानः|खेदः
<ul><li><sup id="ref_krm_0358_01"><a href="#foot_krm_0358_01">1</a></sup> {@“खिद दैन्ये”@} <sup id="ref_krm_0358_02"><a href="#foot_krm_0358_02">2</a></sup> ‘दैन्येऽर्थे खिद्यते खिन्ते, परितापे <sup id="ref_krm_0358_03"><a href="#foot_krm_0358_03">3</a></sup> तु खिन्दति।’ <sup id="ref_krm_0358_04"><a href="#foot_krm_0358_04">4</a></sup> इति देवः। </li> <li><sup id="ref_krm_0358_05"><a href="#foot_krm_0358_05">5</a></sup> <sup id="ref_krm_0358_06"><a href="#foot_krm_0358_06">6</a></sup> खिन्दानः, <sup id="ref_krm_0358_07"><a href="#foot_krm_0358_07">7</a></sup> खेत्स्यमानः, खेदः <sup id="ref_krm_0358_08"><a href="#foot_krm_0358_08">8</a></sup>;</li> <li>  अिति रूपाणीति विशेषः। </li> <li>अन्यानि सर्वाणि रूपाणि दैन्यार्थकदैवादिक- खिद्यतिवत् <sup id="ref_krm_0358_09"><a href="#foot_krm_0358_09">9</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0358_01"><a href="#ref_krm_0358_01">↑</a> (३५१)</li> <li id="foot_krm_0358_02"><a href="#ref_krm_0358_02">↑</a> (७-रुधादिः-१४४९। अक। अनि। आत्म।)</li> <li id="foot_krm_0358_03"><a href="#ref_krm_0358_03">↑</a> (घाते)</li> <li id="foot_krm_0358_04"><a href="#ref_krm_0358_04">↑</a> (श्लो। ११२)</li> <li id="foot_krm_0358_05"><a href="#ref_krm_0358_05">↑</a> [पृष्ठम्०३५५+ २८]</li> <li id="foot_krm_0358_06"><a href="#ref_krm_0358_06">↑</a> [[१। शानचि, ‘रुधादिभ्यः श्नम्’ (३-१-७८) इति श्नम्। ‘श्नसोरल्लोपः’ (६-४-१११) इति लोपः।]]</li> <li id="foot_krm_0358_07"><a href="#ref_krm_0358_07">↑</a> [[आ।‘यमं युनज्मि कालेन समिन्धानोऽस्त्रकौशलम्। शुष्कपेषं पिनष्म्युर्वीम् अखिन्दानः स्वतेजसा।।’ भ। का। ६। ३७।]]</li> <li id="foot_krm_0358_08"><a href="#ref_krm_0358_08">↑</a> [[B। ‘सञ्छृण्णगात्रमथ शात्रवतर्दिनस्ते चाणूरमुष्टिकमुखा वसनान्यकृन्तन्। इन्धानखेदमुदविन्त विशिष्टलोकः पेक्ष्यत्सु माधवमभङ्गभुजेषु तेषु।।’ धा। का। ३। २।]]</li> <li id="foot_krm_0358_09"><a href="#ref_krm_0358_09">↑</a> (३४९)</li></ul></p>

