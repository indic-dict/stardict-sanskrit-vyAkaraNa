<ul><li><sup id="ref_krm_0377_01"><a href="#foot_krm_0377_01">1</a></sup> {@“गड सेचने”@} <sup id="ref_krm_0377_02"><a href="#foot_krm_0377_02">2</a></sup> घटादिः। </li> <li>गाडकः-डिका, <sup id="ref_krm_0377_03"><a href="#foot_krm_0377_03">3</a></sup> गडकः-डिका, जिगडिषकः-षिका, <sup id="ref_krm_0377_04"><a href="#foot_krm_0377_04">4</a></sup> जागडकः-डिका;</li> <li>  गडिता-त्री, गडयिता-त्री, जिगडिषिता-त्री, जागडिता-त्री;</li> <li>  <sup id="ref_krm_0377_05"><a href="#foot_krm_0377_05">5</a></sup> गडन्-न्ती, गडयन्-न्ती, जिगडिषन्-न्ती;</li> <li>  -- गडिष्यन्-न्ती-ती, गडयिष्यन्-न्ती-ती, जिगडिषिष्यन्-न्ती-ती;</li> <li>  -- <sup id="ref_krm_0377_06"><a href="#foot_krm_0377_06">6</a></sup> गडयमानः, गडयिष्यमाणः, -- जागड्यमानः, जागडिष्यमाणः;</li> <li>  गट्-गड्-गडौ-गडः;</li> <li>  -- -- -- गडितम्-तः, गडितः, जिगडिषितः, जागडितः-तवान्;</li> <li>  गडः, गडः, जिगडिषुः, जागडः;</li> <li>  गडितव्यम्, गडयितव्यम्, जिगडिषितव्यम्, जागडितव्यम्;</li> <li>  गडनीयम्, <sup id="ref_krm_0377_07"><a href="#foot_krm_0377_07">7</a></sup> गडनीयम्, जिगडिषणीयम्, जागडनीयम्;</li> <li>  गाड्यम्, गड्यम्, चिगडिष्यम्, जागड्यम्;</li> <li>  ईषद्गडः-दुर्गडः-सुगडः;</li> <li>  -- -- गड्यमानः, गड्यमानः, जिगडिष्यमाणः, जागड्यमानः;</li> <li>  गाडः, गडः, जिगडिषः, जागडः;</li> <li>  गडितुम्, गडयितुम्, जिगडिषितुम्, जागडितुम्;</li> <li>  <sup id="ref_krm_0377_08"><a href="#foot_krm_0377_08">8</a></sup> गट्टिः, गडना, जिगडिषा, जागडा;</li> <li>  गडनम्, गडनम्, जिगडिषणम्, जागडनम्;</li> <li>  गडित्वा, गडयित्वा, जिगडिषित्वा, जागडित्वा;</li> <li>  सङ्गड्य, <sup id="ref_krm_0377_09"><a href="#foot_krm_0377_09">9</a></sup> सङ्गडय्य, सञ्जिगडिष्य, सञ्जागड्य;</li> <li>  गाडम् २, गडित्वा २, <sup id="ref_krm_0377_10"><a href="#foot_krm_0377_10">10</a></sup> गडम् २ -गाडम् २, गडयित्वा २, जिगडिषम् २, जिगडिषित्वा २, जागडम् २;</li> <li>  जागडित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0377_01"><a href="#ref_krm_0377_01">↑</a> (३६९)</li> <li id="foot_krm_0377_02"><a href="#ref_krm_0377_02">↑</a> (१-भ्वादिः-७७७। सक। सेट्। पर।)</li> <li id="foot_krm_0377_03"><a href="#ref_krm_0377_03">↑</a> [[२। घटादिपाठान्मित्त्वम्। णौ ‘मितां ह्रस्वः’ (६-४-९२) इति उपधाह्रस्वः। एवं ण्यन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0377_04"><a href="#ref_krm_0377_04">↑</a> [[३। ‘दीर्घोऽकितः’ (७-४-८३) इत्यभ्यासस्य दीर्घः।]]</li> <li id="foot_krm_0377_05"><a href="#ref_krm_0377_05">↑</a> [[ड्। ‘ताः संज्त्वरन्तीर्गड (ल) दश्रुधारा विमोहशक्त्या हिडयन् वियोगः। मिथो निजार्ति वटयाञ्चकार हरेश्च चेष्टा भटयाञ्चकार।।’ धा। का। २-६। डलयोरभेदात् गल इति साधुः।]]</li> <li id="foot_krm_0377_06"><a href="#ref_krm_0377_06">↑</a> [पृष्ठम्०३६४+ २७]</li> <li id="foot_krm_0377_07"><a href="#ref_krm_0377_07">↑</a> [[१। ‘णेरनिटि’ (६-४-५७) इति णिलोपः।]]</li> <li id="foot_krm_0377_08"><a href="#ref_krm_0377_08">↑</a> [[२। ‘ष्टुना ष्टुः’ (८-४-४१) इति ष्टुत्वेन टकारे, ‘खरि च’ (८-४-५५) इति चर्त्वे च रूपमेवम्।]]</li> <li id="foot_krm_0377_09"><a href="#ref_krm_0377_09">↑</a> [[३। ‘ल्यपि लघुपूर्वात्’ (६-४-५६) इति णेरयादेशः।]]</li> <li id="foot_krm_0377_10"><a href="#ref_krm_0377_10">↑</a> [[४। ‘चिण्णमुलोर्दीर्घोऽन्यतरस्याम्’ (६-४-९३) इति णमुल्परे णौ, उपधायाः दीर्घ- विकल्पः।]]</li></ul></p>

गडि|गण्डकः-ण्डिका|जिगण्डिषकः-षिका|जागण्डकः-ण्डिका
<ul><li><sup id="ref_krm_0378_01"><a href="#foot_krm_0378_01">1</a></sup> {@“गडि वदनैकदेशे”@} <sup id="ref_krm_0378_02"><a href="#foot_krm_0378_02">2</a></sup> वदनैकदेशे = वदनैकदेशक्रियायामित्यर्थः। </li> <li>गण्डकः-ण्डिका, गण्डकः-ण्डिका, जिगण्डिषकः-षिका, जागण्डकः-ण्डिका;</li> <li>  गण्डन्-न्ती, इत्यादीनि रूपाणि भौवादिककदिधातुवत् <sup id="ref_krm_0378_03"><a href="#foot_krm_0378_03">3</a></sup> सर्वत्र ज्ञेयानि। </li> <li><sup id="ref_krm_0378_04"><a href="#foot_krm_0378_04">4</a></sup> गण्डः, पचाद्यच्। </li> <li><sup id="ref_krm_0378_05"><a href="#foot_krm_0378_05">5</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0378_01"><a href="#ref_krm_0378_01">↑</a> (३७०)</li> <li id="foot_krm_0378_02"><a href="#ref_krm_0378_02">↑</a> (१-भ्वादिः-३६१। अक। सेट्। पर।)</li> <li id="foot_krm_0378_03"><a href="#ref_krm_0378_03">↑</a> (१६३)</li> <li id="foot_krm_0378_04"><a href="#ref_krm_0378_04">↑</a> [[आ। ‘मनोज्ञगण्डं तमनिन्दिताननं नन्दात्मजं शारदचन्द्रशीतलम्। पराक्रमत्रन्दनकन्दितासुरं सङ्क्रन्दनक्लन्दितमीक्षितास्महे।।’ धा। का। १-१०।]]</li> <li id="foot_krm_0378_05"><a href="#ref_krm_0378_05">↑</a> [पृष्ठम्०३६५+ २३]</li></ul></p>

