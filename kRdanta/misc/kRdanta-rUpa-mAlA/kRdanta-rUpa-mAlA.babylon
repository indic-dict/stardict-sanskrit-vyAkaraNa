<ul><li><sup id="ref_krm_0568_01"><a href="#foot_krm_0568_01">1</a></sup> {@“च्युङ् गतौ”@} <sup id="ref_krm_0568_02"><a href="#foot_krm_0568_02">2</a></sup> च्यावकः-विका, च्यावकः-विका, <sup id="ref_krm_0568_03"><a href="#foot_krm_0568_03">3</a></sup> चुच्यूषकः-षिका, <sup id="ref_krm_0568_04"><a href="#foot_krm_0568_04">4</a></sup> चोच्यूयकः-यिका, <sup id="ref_krm_0568_05"><a href="#foot_krm_0568_05">5</a></sup> चुच्यावयिषकः-चिच्यावयिषकः-षिका;</li> <li>  च्योता-त्री, च्यावयिता-त्री, चुच्यूषिता-त्री, चोच्यूयिता-त्री, चुच्यावयिषिता-चिच्यावयिषिता-त्री;</li> <li>  -- च्यावयन्-न्ती, -- चुच्यावयिषन्-चिच्यावयिषन्-न्ती;</li> <li>  -- च्यावयिष्यन्, -- चुच्यावयिषिष्यन्-चिच्यावषिष्यन्-न्ती-ती;</li> <li>  च्यवमानः, च्यावयमानः, चुच्यूषमाणः, चोच्यूयमानः, चुच्यावयिषमाणः-चिच्यावयिषमाणः;</li> <li>  च्योष्यमाणः, च्यावयिष्यमाणः, चुच्यूषिष्यमाणः, चोच्यूयिष्यमाणः, चुच्यावयिषिष्यमाणः-चिच्यावयिषिष्यमाणः;</li> <li>  <sup id="ref_krm_0568_06"><a href="#foot_krm_0568_06">6</a></sup> प्रच्युत्-प्रच्युतौ-प्रच्युतः;</li> <li>  -- -- -- च्युतम्- <sup id="ref_krm_0568_07"><a href="#foot_krm_0568_07">7</a></sup> तः-तवान्, च्यावितम्-तः, चुच्यूषितः, चोच्यूयितः, चुच्यावयिषितः-चिच्यावयिषितः-तवान्;</li> <li>  <sup id="ref_krm_0568_08"><a href="#foot_krm_0568_08">8</a></sup> <sup id="ref_krm_0568_09"><a href="#foot_krm_0568_09">9</a></sup> च्यवः, <sup id="ref_krm_0568_10"><a href="#foot_krm_0568_10">10</a></sup> च्यवनः, च्यावः, चुच्यूषुः, <sup id="ref_krm_0568_11"><a href="#foot_krm_0568_11">11</a></sup> चोच्युवः, चुच्यावयिषुः-चिच्यावयिषुः;</li> <li>  च्योतव्यम्, च्यावयितव्यम्, चुच्यूषितव्यम्, चोच्यूयितव्यम्, चुच्यावयिषितव्यम्-चिच्यावयिषितव्यम्;</li> <li>  च्यवनीयम्, च्यावनीयम्, चुच्यूषणीयम्, चोच्यूयनीयम्, चुच्यावयिष-णीयम्-चिच्यावयिषणीयम्;</li> <li>  <sup id="ref_krm_0568_12"><a href="#foot_krm_0568_12">12</a></sup> च्यव्यम्- <sup id="ref_krm_0568_13"><a href="#foot_krm_0568_13">13</a></sup> अवश्यच्याव्यम्, च्याव्यम्, चुच्यूष्यम्, चोच्यूय्यम्, चुच्यावयिष्यम्-चिच्यावयिष्यम्;</li> <li>  ईषच्च्यवः-दुश्च्यव-सुच्यवः;</li> <li>  -- -- -- <sup id="ref_krm_0568_14"><a href="#foot_krm_0568_14">14</a></sup> च्यूयमानः, च्याव्यमानः, चुच्यूष्यमाणः, चोच्यूय्यमानः, चुच्यावयिष्यमाणः-चिच्यावयिष्यमाणः;</li> <li>  <sup id="ref_krm_0568_15"><a href="#foot_krm_0568_15">15</a></sup> च्यवः, च्यावः, चुच्यूषः, चोच्यूयः, चुच्यावयिषः-चिच्यावयिषः;</li> <li>  च्योतुम्, च्यावयितुम्, चुच्यूषितुम्, चोच्यूयितुम्, चुच्यावयिषितुम्-चिच्यावयिषितुम्;</li> <li>  च्युतिः, च्यावना, चुच्यूषा, चोच्यूया, चुच्यावयिषा-चिच्यावयिषा;</li> <li>  <sup id="ref_krm_0568_16"><a href="#foot_krm_0568_16">16</a></sup> च्यवनम्, च्यावनम्, चुच्यूषणम्, चोच्यूयनम्, चुच्यावयिषणम्-चिच्यावयिषणम्;</li> <li>  च्युत्वा, च्यावयित्वा, चुच्यूषित्वा, चोच्यूयित्वा, चुच्यावयिषित्वा-चिच्यावयिषित्वा;</li> <li>  <sup id="ref_krm_0568_17"><a href="#foot_krm_0568_17">17</a></sup> प्रच्युत्य, प्रच्याव्य, प्रचुच्यूष्य, प्रचोच्यूय्य, प्रचुच्यावयिष्य-प्रचिच्यावयिष्य;</li> <li>  च्यावम् २, च्युत्वा २, च्यावम् २, च्यावयित्वा २, चुच्यूषम् २, चुच्यूषित्वा २, चोच्यूयम् २, चोच्यूयित्वा २, चुच्यावयिषम् २ -चिच्यावयिषम् २;</li> <li>  चिच्यावयिषित्वा २-चिच्यावयिषित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0568_01"><a href="#ref_krm_0568_01">↑</a> (५५८)</li> <li id="foot_krm_0568_02"><a href="#ref_krm_0568_02">↑</a> (१-भ्वादिः-९५५। सक। अनि। आत्म।)</li> <li id="foot_krm_0568_03"><a href="#ref_krm_0568_03">↑</a> [[१। ‘अज्झनगमां सनि’ (६-४-१६) इति दीर्घे, ‘इको झल्’ (१-२-९) इति सनःकित्त्वेन, ‘ङ्किति’ (१-१-५) इति गुणनिषेधः। एवं सन्नन्ते सर्वत्र प्रक्रिया बोध्या।]]</li> <li id="foot_krm_0568_04"><a href="#ref_krm_0568_04">↑</a> [[२। यङन्तात्, द्वित्वे, ‘गुणो यङ्लुकोः’ (७-४-८२) इत्यभ्यासस्य गुणे, ‘अकृत्सार्वधातु- कयोः--’ (७-४-२५) इति दीर्घः। एवं यङन्ते सर्वत्र प्रक्रिया ज्ञेया।]]</li> <li id="foot_krm_0568_05"><a href="#ref_krm_0568_05">↑</a> [[३। ण्यन्तात् सनि, ‘सन्यङोः’ (६-१-९) इति द्वित्वे, वृद्ध्यावादेशयोः अवर्णपरधात्व- क्षरपरकत्वादभ्यासघटकोकारस्य, ‘स्रवति शृणोतिद्रवतिप्रवतिप्लवतिच्यवतीनां वा’ (७-४-८१) इति पाक्षिके इकारे, रूपद्वयम्। एवं सर्वत्र ण्यन्तात् सनि प्रक्रिया बोध्या। ‘स्रवति--’ (७-४-८१) इति सूत्रसार्थक्यायैव, ण्यन्तात् सनि धातोरस्य सर्वाणि रूपाणि प्रदर्शितानि।]]</li> <li id="foot_krm_0568_06"><a href="#ref_krm_0568_06">↑</a> [[४। ‘ह्रस्वस्य--’ (६-१-७१) इति तुक्। एवं ल्यप्य पि ज्ञेयम्।]]</li> <li id="foot_krm_0568_07"><a href="#ref_krm_0568_07">↑</a> [[आ। ‘स्तोत्रावमानैर्दुतवेणुवीणैश्च्युताशुभैर्व्योमचरैर्ज्युतं ते।’ धा। का। २-३६।]]</li> <li id="foot_krm_0568_08"><a href="#ref_krm_0568_08">↑</a> [पृष्ठम्०५३२+ १६]</li> <li id="foot_krm_0568_09"><a href="#ref_krm_0568_09">↑</a> [[१। पचादित्वेन (३-१-१३४) अचि, गुणावादेशौ।]]</li> <li id="foot_krm_0568_10"><a href="#ref_krm_0568_10">↑</a> [[२। चलनार्थकत्वेन, ‘चलनशब्दार्थादकर्मकात्--’ (३-२-१४८) इति ताच्छीलिको युच्। अनादेशः।]]</li> <li id="foot_krm_0568_11"><a href="#ref_krm_0568_11">↑</a> [[३। यङन्तात् पचाद्यचि (३-१-१३४) ‘यङोऽचि च’ (२-४-७४) इति, अचो लुकि, ‘न धातुलोप--’ (१-१-४) इति गुणनिषेधे, उवङ्।]]</li> <li id="foot_krm_0568_12"><a href="#ref_krm_0568_12">↑</a> [[४। ‘अचो यत्’ (३-१-९७) इति यति, गुणावादेशौ।]]</li> <li id="foot_krm_0568_13"><a href="#ref_krm_0568_13">↑</a> [[५। ‘ओरावश्यके’ (३-१-१२५) इति ण्यत्।]]</li> <li id="foot_krm_0568_14"><a href="#ref_krm_0568_14">↑</a> [[६। ‘अकृत्सार्वधातुकयोः--’ (७-४-२५) इति दीर्घः।]]</li> <li id="foot_krm_0568_15"><a href="#ref_krm_0568_15">↑</a> [[७। ‘ॠदोरप्’ (३-३-५७) इति भावे घञपवादोऽप्प्रत्ययः।]]</li> <li id="foot_krm_0568_16"><a href="#ref_krm_0568_16">↑</a> [[आ। ‘अत्तुं महेन्द्रियं भागमैति दुश्च्यवनोऽधुना।।’ भ। का। ५-११।]]</li> <li id="foot_krm_0568_17"><a href="#ref_krm_0568_17">↑</a> [पृष्ठम्०५३३+ २१]</li></ul></p>

च्युतिर्|च्योतकः-तिका|चुच्योतिषकः-चुच्युतिषकः-षिका|चोच्युतकः-तिका
<ul><li><sup id="ref_krm_0569_01"><a href="#foot_krm_0569_01">1</a></sup> {@“च्युतिर् आसेचने”@} <sup id="ref_krm_0569_02"><a href="#foot_krm_0569_02">2</a></sup> आसेचनम् = ईषत्सेकः, आ = समन्तात् सेको वा। </li> <li>च्योतकः-तिका, च्योतकः-तिका, चुच्योतिषकः-चुच्युतिषकः-षिका, चोच्युतकः-तिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककोचतिवत् <sup id="ref_krm_0569_03"><a href="#foot_krm_0569_03">3</a></sup> ज्ञेयानि। </li> <li>शतरि-च्योतन् <sup id="ref_krm_0569_04"><a href="#foot_krm_0569_04">4</a></sup> -न्ती। </li> <li>धातोरस्येरित्त्वेऽपि, इरित्त्वप्रयुक्तकार्यस्य कृदन्ते- ष्वभावात् रूपसाम्यं भवत्येव।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0569_01"><a href="#ref_krm_0569_01">↑</a> (५५९)</li> <li id="foot_krm_0569_02"><a href="#ref_krm_0569_02">↑</a> (१-भ्वादिः-४०। सक। सेट्। पर।)</li> <li id="foot_krm_0569_03"><a href="#ref_krm_0569_03">↑</a> (२००)</li> <li id="foot_krm_0569_04"><a href="#ref_krm_0569_04">↑</a> [[आ। ‘अतेन्मुरारिर्मम चिन्मयोऽन्तिके च्योतन् दिशः प्रश्च्युतितैः स्मितामृतैः।।’ धा। का। १-६।]]</li></ul></p>

