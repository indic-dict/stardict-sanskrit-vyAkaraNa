<ul><li><sup id="ref_krm_0851_01"><a href="#foot_krm_0851_01">1</a></sup> {@“दिश अतिसर्जने”@} <sup id="ref_krm_0851_02"><a href="#foot_krm_0851_02">2</a></sup> अतिसर्जनम् = त्यागः, दानं च। </li> <li>देशकः-शिका, देशकः-शिका, <sup id="ref_krm_0851_03"><a href="#foot_krm_0851_03">3</a></sup> दिदिक्षकः-क्षिका, देदिशकः-शिका;</li> <li>  <sup id="ref_krm_0851_04"><a href="#foot_krm_0851_04">4</a></sup> उपदेष्टा-ष्ट्री, देशयिता-त्री, दिदिक्षिता-त्री, देदिशिता-त्री;</li> <li>  <sup id="ref_krm_0851_05"><a href="#foot_krm_0851_05">5</a></sup> दिशन्-ती, देशयन्-न्ती, दिदिक्षन्-न्ती;</li> <li>  -- देक्ष्यन्-न्ती-ती, देशयिष्यन्-न्ती-ती, दिदिक्षिष्यन्-न्ती-ती;</li> <li>  -- दिशमानः, देशयमानः, दिदिक्षमाणः, देदिश्यमानः;</li> <li>  देक्ष्यमाणः, देशयिष्यमाणः, दिदिक्षिष्यमाणः, देदिशिष्यमाणः;</li> <li>  <sup id="ref_krm_0851_06"><a href="#foot_krm_0851_06">6</a></sup> दिक्-दिग्-दिशौ-दिशः, दिशा;</li> <li>  -- -- -- <sup id="ref_krm_0851_07"><a href="#foot_krm_0851_07">7</a></sup> दिष्टम्-दिष्टः-दिष्टवान्, देशितः, दिदिक्षितः, देदिशितः-तवान्;</li> <li>  <sup id="ref_krm_0851_08"><a href="#foot_krm_0851_08">8</a></sup> दिशः, <sup id="ref_krm_0851_09"><a href="#foot_krm_0851_09">9</a></sup> उपदेशी, प्रादेशिनी, देशः, दिदिक्षुः, देदिशः;</li> <li>  देष्टव्यम्, देशयितव्यम्, दिदिक्षितव्यम्, देदिशितव्यम्;</li> <li>  देशनीयम्, देशनीयम्, दिदिक्षणीयम्, देदिशनीयम्;</li> <li>  देश्यम्, देश्यम्, दिदिक्ष्यम्, देदिश्यम्;</li> <li>  <sup id="ref_krm_0851_10"><a href="#foot_krm_0851_10">10</a></sup> ईषद्देशः-दुर्देशः-सुदेशः;</li> <li>  -- -- -- दिश्यमानः, देश्यमानः, दिदिक्ष्यमाणः, देदिश्यमानः;</li> <li>  <sup id="ref_krm_0851_11"><a href="#foot_krm_0851_11">11</a></sup> देशः, <sup id="ref_krm_0851_12"><a href="#foot_krm_0851_12">12</a></sup> प्रादेशः, सन्देशः, उपदेशः, देशः, दिदिक्षः, देदिशः;</li> <li>  देष्टुम्, देशयितुम्, दिदिक्षितुम्, देदिशितुम्;</li> <li>  दिष्टिः, <sup id="ref_krm_0851_13"><a href="#foot_krm_0851_13">13</a></sup> दिष्टिः, देशना, दिदिक्षा, देदिशा;</li> <li>  देशनम्, देशनम्, दिदिक्षणम्, देदिशनम्;</li> <li>  दिष्ट्वा, देशयित्वा, दिदिक्षित्वा, देदिशित्वा;</li> <li>  अतिदिश्य, उपदेश्य, प्रदिदिक्ष्य, प्रदेदिश्य;</li> <li>  <sup id="ref_krm_0851_14"><a href="#foot_krm_0851_14">14</a></sup> नाम्न्यादेशं नामादिश्य वा युध्यन्ते। </li> <li>देशम् २ देष्ट्वा २ देशम् २ देशयित्वा २ दिदिक्षम् २ दिदिक्षित्वा २ देदिशम् २;</li> <li>  देदिशित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0851_01"><a href="#ref_krm_0851_01">↑</a> (८४१)</li> <li id="foot_krm_0851_02"><a href="#ref_krm_0851_02">↑</a> (६-तुदादिः-१२८३। सक। अनि। उभ।)</li> <li id="foot_krm_0851_03"><a href="#ref_krm_0851_03">↑</a> [[१। सन्नन्तात् ण्वुलि, ‘हलन्ताच्च’ (१-२-१०) इति सनः कित्त्वे, ‘व्रश्च--’ (८-२-३६) इत्यादिना षत्वे, ‘षढोः कः सि’ (८-२-४१) इति तकारस्य ककारे च रूपमेवम्। एवं सन्नन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0851_04"><a href="#ref_krm_0851_04">↑</a> [[२। तृचि, ‘व्रश्च--’ (८-२-३६) इत्यादिना शकारस्य षकारे, तकारस्य, ‘ष्टुना ष्टुः’ (८-४-४१) इति ष्टुत्वेन टकारे च रूपम्। एवं तव्यदादिष्वपि ज्ञेयम्।]]</li> <li id="foot_krm_0851_05"><a href="#ref_krm_0851_05">↑</a> [[३। शतरि, ‘तुदादिभ्यः--’ (३-१-७७) इति शः विकरणप्रत्ययः। तस्य शित्त्वेन सार्वधातुकत्वाद् ङिद्वद्भावातिदेशाच्चाङ्गस्य गुणो न। एवं शानजन्तेऽपि ज्ञेयम्।]]</li> <li id="foot_krm_0851_06"><a href="#ref_krm_0851_06">↑</a> [[४। ‘ऋत्विग्दधृक्स्रग्दिगुष्णिग्--’ (३-२-५९) इत्यादिना क्विन्नन्तो निपातितः। तेन, ‘क्विन्प्रत्ययस्य कुः’ (८-२-६२) इति शकारस्य कुत्वम्। व्रश्चादिषत्वस्यापवादोऽयम्। चर्त्वविकल्पः। ‘आपं चैव हलन्तानां यथा वाचा निशा दिशा।।’ इति भागुरिवचनात् स्त्रियां टाब् भवति।]]</li> <li id="foot_krm_0851_07"><a href="#ref_krm_0851_07">↑</a> [[५। दिष्टं = दैवम्। ‘दैवं दिष्टं भागधेयं भाग्यं--’ इत्यमरः। ‘क्तिच्क्तौ च संज्ञायाम्’ (३-३-१७४) इति संज्ञायां क्तप्रत्ययः।]]</li> <li id="foot_krm_0851_08"><a href="#ref_krm_0851_08">↑</a> [[६। ‘इगुपधज्ञाप्रीकिरः कः’ (३-१-१३५) इति कर्तरि कप्रत्ययः।]]</li> <li id="foot_krm_0851_09"><a href="#ref_krm_0851_09">↑</a> [[७। ताच्छील्ये, साधुकारिणि वा णिनिप्रत्ययान्तोऽयम्।]]</li> <li id="foot_krm_0851_10"><a href="#ref_krm_0851_10">↑</a> [पृष्ठम्०७४७+ २४]</li> <li id="foot_krm_0851_11"><a href="#ref_krm_0851_11">↑</a> [[१। दिश्यतेऽनेनेति देशः = स्थलम्। ‘अकर्तरि च कारके संज्ञायाम्’ (३-३-१९) इति कर्मणि घञ्।]]</li> <li id="foot_krm_0851_12"><a href="#ref_krm_0851_12">↑</a> [[२। प्रदिश्यत इति प्रदेशः = अग्रभागः। ‘हलश्च’ (३-३-१२१) इति संज्ञायां घञ्। ‘उपसर्गस्य घञ्यमनुष्ये बहुलम्’ (६-३-१२२) इति दीर्घः। तत्र ‘बहुलम्’ इत्युक्तेः प्रादेशः इत्यपि साधुः।]]</li> <li id="foot_krm_0851_13"><a href="#ref_krm_0851_13">↑</a> [[३। दिष्टिः = दैवम्। ‘क्तिच्क्तौ च संज्ञायाम्’ (३-३-१७४) इति संज्ञायां क्तिच्।]]</li> <li id="foot_krm_0851_14"><a href="#ref_krm_0851_14">↑</a> [[४। द्वितीयान्ते नामनि उपपदे, आङ्पूर्वकादस्मात् णमुल् भवति ‘नाम्न्यादिशि- ग्रहोः’ (३-४-५८) इत्यनेन। ‘तृतीयाप्रभृतीन्यन्यतरस्याम्’ (२-२-२१) इति समासविकल्पः।]]</li></ul></p>

