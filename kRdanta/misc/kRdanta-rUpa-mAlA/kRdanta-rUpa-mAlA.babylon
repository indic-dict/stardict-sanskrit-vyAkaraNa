<ul><li><sup id="ref_krm_1036_01"><a href="#foot_krm_1036_01">1</a></sup> {@“पुष पुष्टौ”@} <sup id="ref_krm_1036_02"><a href="#foot_krm_1036_02">2</a></sup> ‘धारणे पोषयेत्, पुष्टौ पुष्येत् पुष्णाति पोषति। </li> <li><sup id="ref_krm_1036_03"><a href="#foot_krm_1036_03">3</a></sup> इति देवः। </li> <li>पोषकः-षिका, पोषकः-षिका, <sup id="ref_krm_1036_04"><a href="#foot_krm_1036_04">4</a></sup> पुपोषिषकः-पुपुषिषकः-षिका, पोपुषकः-षिका;</li> <li>  पोषिता-त्री, पोषयिता-त्री, पुपोषिषिता-पुपुषिषिता-त्री, पोपुषिता-त्री;</li> <li>  <sup id="ref_krm_1036_05"><a href="#foot_krm_1036_05">5</a></sup> प्रपोषन्-न्ती, पोषयन्-न्ती, पुपोषिषन्-न्ती, पुपुषिषन्-न्ती;</li> <li>  -- पोषिष्यन्-न्ती-ती, पोषयिष्यन्, पुपोषिषिष्यन्-पुपुषिषिष्यन्-न्ती-ती;</li> <li>  -- -- पोषयमाणः, पोषयिष्यमाणः, -- पोपुष्यमाणः, पोपुषिष्यमाणः;</li> <li>  प्रपुट्-प्रपुड्-पुषौ-पुषः;</li> <li>  -- -- -- <sup id="ref_krm_1036_06"><a href="#foot_krm_1036_06">6</a></sup> पोषितम्-पुषितम्-तः, पोषितः, पुपोषिषितः-पुपुषिषितः-पोपुषितः-तवान्;</li> <li>  पुषः, <sup id="ref_krm_1036_07"><a href="#foot_krm_1036_07">7</a></sup> पोषणः, <sup id="ref_krm_1036_08"><a href="#foot_krm_1036_08">8</a></sup> प्रपोषी-धनपोषी, पोषः, पुपोषिषुः-पुपुषिषुः, पोपुषः;</li> <li>  पोषितव्यम्, पोषयितव्यम्, पुपोषिषितव्यम्-पुपुषिषितव्यम्, पोपुषितव्यम्;</li> <li>  पोषणीयम्, पोषणीयम्, पुपोषिषणीयम्-पुपुषिषणीयम्, पोपुषणीयम्;</li> <li>  पोष्यम्, पोष्यम्, पुपोषिष्यम्-पुपुषिष्यम्, पोपुष्यम्;</li> <li>  ईषत्पोषः-दुष्पोषः-सुपोषः;</li> <li>  -- -- पुष्यमाणः, पोष्यमाणः, पुपोषिष्यमाणः-पुपुषिष्यमाणः, पोपुष्यमाणः;</li> <li>  पोषः, पोषः, पुपोषिषः-पुपुषिषः, पोपुषः;</li> <li>  C। </li> <li>‘स्वपोषमपुषद् युष्मान् या पक्षिमृगशावकाः।’ भ। </li> <li>का। </li> <li>६। २६। <sup id="ref_krm_1036_09"><a href="#foot_krm_1036_09">9</a></sup> पोषितुम्, पोषयितुम्, पुपोषिषितुम्-पुपुषिषितुम्, पोपुषितुम्;</li> <li>  पुष्टिः, पोषणा, पुपोषिषा-पुपुषिषा, पोपुषा;</li> <li>  पोषणम्, पोषणम्, पुपोषिषणम्-पुपुषिषणम्, पोपुषणम्;</li> <li>  पोषित्वा-पुषित्वा, पोषयित्वा, पुपोषिषित्वा-पुपुषिषित्वा, पोपुषित्वा;</li> <li>  प्रपुष्य, प्रपोष्य, प्रपुपोषिष्य-प्रपुपुषिष्य, प्रपोपुष्य;</li> <li>  <sup id="ref_krm_1036_10"><a href="#foot_krm_1036_10">10</a></sup> स्वपोषं-धनपोषं-गोपोषं-रैपोषं वा पोषति। </li> <li>पोषम् २, पुषित्वा २ -पोषित्वा २, पोषम् २, पोषयित्वा २, पुपोषिषम् २ -पुपुषिषम् २, पुपोषिषित्वा २ -पुपुषिषित्वा २, पोपुषम् २;</li> <li>  पोपुषित्वा २;</li> <li>  <sup id="ref_krm_1036_11"><a href="#foot_krm_1036_11">11</a></sup> इतीत्नुच्प्रत्ययः। </li> <li>‘अयामन्ताल्वा- य्येत्न्विष्णुषु’ <sup id="ref_krm_1036_12"><a href="#foot_krm_1036_12">12</a></sup> इति णेरयादेशः। </li> <li>पोषयित्नुः = पोषणकर्ता।]] पोषयित्नुः, <sup id="ref_krm_1036_13"><a href="#foot_krm_1036_13">13</a></sup> इति करन्प्रत्यये, तस्य कित्त्वेन, बाहुलकात् प्रत्ययादेः ककारस्येत्संज्ञाभावे च रूपम्।]] पुष्करम्, <sup id="ref_krm_1036_14"><a href="#foot_krm_1036_14">14</a></sup> इति कलन्प्रत्यये रूपम्। </li> <li>अत्रापि बाहुलकात् प्रत्ययककारस्य न लोप इति ज्ञेयम्।]] पुष्कलम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1036_01"><a href="#ref_krm_1036_01">↑</a> (१०२६)</li> <li id="foot_krm_1036_02"><a href="#ref_krm_1036_02">↑</a> (१-भ्वादिः-७००। अक। सेट्। पर।)</li> <li id="foot_krm_1036_03"><a href="#ref_krm_1036_03">↑</a> (श्लो। १७१)</li> <li id="foot_krm_1036_04"><a href="#ref_krm_1036_04">↑</a> [[१। ‘रलो व्युपधाद्धलादेः संश्च’ (१-२-२६) इति सन्नन्ते सर्वत्र कित्त्वविकल्पः। तेन रूपद्वयं बोध्यम्। एवं शुद्धात् क्त्वायामपि ज्ञेयम्।]]</li> <li id="foot_krm_1036_05"><a href="#ref_krm_1036_05">↑</a> [[B। ‘वेषैर्मेष्यतमैः प्रपोषदशुभप्रश्रेषिभिः श्लेषति प्रोष्यन्…।’ धा। का। १। ८८।]]</li> <li id="foot_krm_1036_06"><a href="#ref_krm_1036_06">↑</a> [[२। निष्ठायाम्, ‘उदुपधाद् भावादिकर्मणोरन्यतरस्याम्’ (१-२-२१) इति कित्त्व- विकल्पः। तेन रूपद्वयम्।]]</li> <li id="foot_krm_1036_07"><a href="#ref_krm_1036_07">↑</a> [[३। नन्द्यादित्वात् कर्तरि ल्युप्रत्यये ऽनादेशे च रूपम्।]]</li> <li id="foot_krm_1036_08"><a href="#ref_krm_1036_08">↑</a> [[४। ताच्छीलिके णिनिप्रत्यये गुणे च रूपम्।]]</li> <li id="foot_krm_1036_09"><a href="#ref_krm_1036_09">↑</a> [पृष्ठम्०८७३+ २४]</li> <li id="foot_krm_1036_10"><a href="#ref_krm_1036_10">↑</a> [[१। ‘स्वे पुषः’ (३-४-४०) इति णमुल्। ‘कषादिषु यथाविध्यनुप्रयोगः’ (३-४-४६) इति णमुल्प्रयोजकस्यैव धातोरनुप्रयोगः। सूत्रे ‘स्वे--’ इति अर्थग्रहणम्, स्वरूपग्रहण च। तेन रैपोषम्, गोपोषम् इत्यादिषु ‘स्व’ इत्यस्यार्थस्य सदृशार्थकेषु च णमुल् भवति।]]</li> <li id="foot_krm_1036_11"><a href="#ref_krm_1036_11">↑</a> [[२। ण्यन्तात्, ‘स्तनिहृषिपुषि--’ [द। उ। १-१४०]</li> <li id="foot_krm_1036_12"><a href="#ref_krm_1036_12">↑</a> (६-४-५५)</li> <li id="foot_krm_1036_13"><a href="#ref_krm_1036_13">↑</a> [[३। ‘पुषः कित्’ [द। उ। ८। ७१]</li> <li id="foot_krm_1036_14"><a href="#ref_krm_1036_14">↑</a> [[४। ‘पुषः कलन् किच्च’ [द। उ। ८-११८]</li></ul></p>

पुष|पोषकः-षिका|पुपुक्षकः-क्षिका|पोपुषकः-षिका
<ul><li><sup id="ref_krm_1037_01"><a href="#foot_krm_1037_01">1</a></sup> {@“पुष पुष्टौ”@} <sup id="ref_krm_1037_02"><a href="#foot_krm_1037_02">2</a></sup> <sup id="ref_krm_1037_03"><a href="#foot_krm_1037_03">3</a></sup> ‘सूर्यापाये न खलु कमलं पुष्यति स्वामभिख्याम्।’ इति <sup id="ref_krm_1037_04"><a href="#foot_krm_1037_04">4</a></sup>, ‘पुपोष लावण्यमयान् विशेषान् ज्योत्स्नान्तराणीव कलान्तराणि।।’ इति <sup id="ref_krm_1037_05"><a href="#foot_krm_1037_05">5</a></sup> च महाकविप्रयोगात् सकर्मकत्वम्। </li> <li>‘वराह इव पुष्यति--’ इत्यादिप्रयोगदर्शनादकर्मकत्वमप्यस्य धातोः संगच्छत इति ज्ञेयम्।]] ‘धारणे पोषयेत् पुष्टौ पुष्येत् पुष्णाति पोषति।’ <sup id="ref_krm_1037_06"><a href="#foot_krm_1037_06">6</a></sup> इति देवः। </li> <li>पोषकः-षिका, पोषकः-षिका, पुपुक्षकः-क्षिका, पोपुषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि दैवादिकतुष्यतिवत् <sup id="ref_krm_1037_07"><a href="#foot_krm_1037_07">7</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1037_08"><a href="#foot_krm_1037_08">8</a></sup> <sup id="ref_krm_1037_09"><a href="#foot_krm_1037_09">9</a></sup> पुष्यः, <sup id="ref_krm_1037_10"><a href="#foot_krm_1037_10">10</a></sup> <sup id="ref_krm_1037_11"><a href="#foot_krm_1037_11">11</a></sup> स्वपोषं <sup id="ref_krm_1037_12"><a href="#foot_krm_1037_12">12</a></sup> रैपोषम्, गोपोषम् धान्यपोषम् वा पुष्यति। </li> <li><sup id="ref_krm_1037_13"><a href="#foot_krm_1037_13">13</a></sup> गोपोषी।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1037_01"><a href="#ref_krm_1037_01">↑</a> (१०२७)</li> <li id="foot_krm_1037_02"><a href="#ref_krm_1037_02">↑</a> (४-दिवादिः-११८२। सक। अनि। पर।)</li> <li id="foot_krm_1037_03"><a href="#ref_krm_1037_03">↑</a> [[[अ]</li> <li id="foot_krm_1037_04"><a href="#ref_krm_1037_04">↑</a> (मेघसन्देशे ईई-१३)</li> <li id="foot_krm_1037_05"><a href="#ref_krm_1037_05">↑</a> (कुमारसम्भवे १-२५)</li> <li id="foot_krm_1037_06"><a href="#ref_krm_1037_06">↑</a> (श्लो। १७१)</li> <li id="foot_krm_1037_07"><a href="#ref_krm_1037_07">↑</a> (७५८)</li> <li id="foot_krm_1037_08"><a href="#ref_krm_1037_08">↑</a> [पृष्ठम्०८७४+ २९]</li> <li id="foot_krm_1037_09"><a href="#ref_krm_1037_09">↑</a> [[१। ‘पुष्यसिध्यौ नक्षत्रे’ (३-१-११६) इति नक्षत्रेऽभिधेये क्यप्। अन्यत्र पोष्यम् इति ण्यदेव। पुष्यन्त्यर्था अस्मिन् इति पुष्यः = नक्षत्रविशेषः।]]</li> <li id="foot_krm_1037_10"><a href="#ref_krm_1037_10">↑</a> [[आ। ‘महारथः पुष्यरथं रथाङ्गी क्षिप्रं क्षपानाथ इवाधिरूढः।।’ शि। व। ३। २२।]]</li> <li id="foot_krm_1037_11"><a href="#ref_krm_1037_11">↑</a> [[२। ‘स्वे पुषः’ (३-४-४०) इति णमुल्। ‘स्वे’ इति पर्यायाणामपि ग्रहणात् रैपोषम् इत्यादीनां साधुत्वम्। ‘कषादिषु यथाविध्यनुप्रयोगः’ (३-४-४६) इति णमुलन्तस्यैव धातोरनुप्रयोगः।]]</li> <li id="foot_krm_1037_12"><a href="#ref_krm_1037_12">↑</a> [[B। ‘प्रस्थापयत् पूगकृतान् स्वपोपं पुष्टान् प्रयत्नाद् दृढगात्रबन्धान्।’ भ। का। ३। ४।]]</li> <li id="foot_krm_1037_13"><a href="#ref_krm_1037_13">↑</a> [[३। ‘सुप्यजातौ--’ (३-२-७८) इति ताच्छील्ये णिनिः।]]</li></ul></p>

पुष|पोषकः-षिका|पुपोषिषकः-पुपुषिषकः-षिका|पोपुषकः-षिका
<ul><li><sup id="ref_krm_1038_01"><a href="#foot_krm_1038_01">1</a></sup> {@“पुष पुष्टौ”@} <sup id="ref_krm_1038_02"><a href="#foot_krm_1038_02">2</a></sup> ‘धारणे पोषयेत्, पुष्टौ पुष्येत् पुष्णाति पोषति।’ <sup id="ref_krm_1038_03"><a href="#foot_krm_1038_03">3</a></sup> इति देवः। </li> <li>पोषकः-षिका, पोषकः-षिका, पुपोषिषकः-पुपुषिषकः-षिका, पोपुषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकपोषतिवत् <sup id="ref_krm_1038_04"><a href="#foot_krm_1038_04">4</a></sup> ज्ञेयानि। </li> <li>शतरि <sup id="ref_krm_1038_05"><a href="#foot_krm_1038_05">5</a></sup> पुष्णन् <sup id="ref_krm_1038_06"><a href="#foot_krm_1038_06">6</a></sup> -ती, इति रूपमिति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1038_01"><a href="#ref_krm_1038_01">↑</a> (१०२८)</li> <li id="foot_krm_1038_02"><a href="#ref_krm_1038_02">↑</a> (९-क्र्यादिः-१५२९। अक। सेट्। पर।)</li> <li id="foot_krm_1038_03"><a href="#ref_krm_1038_03">↑</a> (श्लो। १७१)</li> <li id="foot_krm_1038_04"><a href="#ref_krm_1038_04">↑</a> (१०२६)</li> <li id="foot_krm_1038_05"><a href="#ref_krm_1038_05">↑</a> [[४। ‘क्र्यादिभ्यः--’ (३-१-८१) इति श्ना विकरणप्रत्ययः। ‘श्नाऽभ्यस्तयोरातः’ (६-४-११२) इत्याकारलोपः। णत्वम्।]]</li> <li id="foot_krm_1038_06"><a href="#ref_krm_1038_06">↑</a> [[C। ‘प्रुष्णन् सतां प्रियमयं प्लुषिताङ्गरागः पुष्णन् मुदं मृगदृशां रिपुधाम मुष्णन्।’ धा। का। ३। १२।]]</li></ul></p>

पुष|पोषकः-षिका|पुपोषयिषकः-षिका
<ul><li><sup id="ref_krm_1039_01"><a href="#foot_krm_1039_01">1</a></sup> {@“पुष धारणे”@} <sup id="ref_krm_1039_02"><a href="#foot_krm_1039_02">2</a></sup> आस्वदीयः। </li> <li>‘धारणे पोषयेत्, पुष्टौ पुष्येत् पुष्णाति पोषति।’ <sup id="ref_krm_1039_03"><a href="#foot_krm_1039_03">3</a></sup> इति देवः। </li> <li>पोषकः-षिका, पुपोषयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकतोलयतिवत् <sup id="ref_krm_1039_04"><a href="#foot_krm_1039_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1039_05"><a href="#foot_krm_1039_05">5</a></sup> प्रपोषितः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1039_01"><a href="#ref_krm_1039_01">↑</a> (१०२९)</li> <li id="foot_krm_1039_02"><a href="#ref_krm_1039_02">↑</a> (१०-चुरादिः-१७५१। सक। सेट्। उभ।)</li> <li id="foot_krm_1039_03"><a href="#ref_krm_1039_03">↑</a> (श्लो। १७१)</li> <li id="foot_krm_1039_04"><a href="#ref_krm_1039_04">↑</a> (७५७)</li> <li id="foot_krm_1039_05"><a href="#ref_krm_1039_05">↑</a> [[ड्। ‘दोर्भ्या ग्रासयतां प्रपोषितरुषां निर्दालनोद्योगिनां तेषां विक्रमणैरपाटि पटिमा शिक्षाऽष्यपोटि स्फुटम्। धा। का। ३। ४३।]]</li></ul></p>

पुष्प|पुष्पकः-ष्पिका|पुपुष्पिषकः-षिका|पोपुष्पकः-ष्पिका
<ul><li><sup id="ref_krm_1040_01"><a href="#foot_krm_1040_01">1</a></sup> {@“पुष्प विकसने”@} <sup id="ref_krm_1040_02"><a href="#foot_krm_1040_02">2</a></sup> पुष्पकः-ष्पिका, पुष्पकः-ष्पिका, पुपुष्पिषकः-षिका, पोपुष्पकः-ष्पिका;</li> <li>  पुष्पम्, इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकजल्पतिवत् <sup id="ref_krm_1040_03"><a href="#foot_krm_1040_03">3</a></sup> ज्ञेयानि। </li> <li>शतरि-- <sup id="ref_krm_1040_04"><a href="#foot_krm_1040_04">4</a></sup> पुष्यन्-न्ती, इति रूपमिति विशेषः। </li> <li><sup id="ref_krm_1040_05"><a href="#foot_krm_1040_05">5</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1040_01"><a href="#ref_krm_1040_01">↑</a> (१०३०)</li> <li id="foot_krm_1040_02"><a href="#ref_krm_1040_02">↑</a> (४-दिवादिः-११२२। अक। सेट्। पर।)</li> <li id="foot_krm_1040_03"><a href="#ref_krm_1040_03">↑</a> (५९२)</li> <li id="foot_krm_1040_04"><a href="#ref_krm_1040_04">↑</a> [[५। ‘दिवादिभ्यः--’ (३-१-६९) इति श्यन्प्रत्ययः।]]</li> <li id="foot_krm_1040_05"><a href="#ref_krm_1040_05">↑</a> [पृष्ठम्०८७५+ २८]</li></ul></p>

पुंस|पुंसकः-सिका|पुपुंसयिषकः-षिका|पुन्-पुंसौ-पुंसः
<ul><li><sup id="ref_krm_1041_01"><a href="#foot_krm_1041_01">1</a></sup> {@“पुंस अभिवर्धने”@} <sup id="ref_krm_1041_02"><a href="#foot_krm_1041_02">2</a></sup> ‘--अभिमर्दने’ इति क्षीरस्वामी। </li> <li>पुंसकः-सिका, पुपुंसयिषकः-षिका;</li> <li>  <sup id="ref_krm_1041_03"><a href="#foot_krm_1041_03">3</a></sup> पुन्-पुंसौ-पुंसः;</li> <li>  <sup id="ref_krm_1041_04"><a href="#foot_krm_1041_04">4</a></sup> पुंसना, इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकगन्धयतिवत् <sup id="ref_krm_1041_05"><a href="#foot_krm_1041_05">5</a></sup> ज्ञेयानि। </li> <li>अस्योभयपदि- त्वात् शतरि पुंसयन्-न्ती, पुंसयिष्यन्-न्ती-ती, इति रूपे अधिके इति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1041_01"><a href="#ref_krm_1041_01">↑</a> (१०३१)</li> <li id="foot_krm_1041_02"><a href="#ref_krm_1041_02">↑</a> (१०-चुरादिः-१६३८। सक। सेट्। उभ।)</li> <li id="foot_krm_1041_03"><a href="#ref_krm_1041_03">↑</a> [[१। ‘नकारजावनुस्वारपञ्चमौ झलि धातुषु। सकारजश्शकारश्चेर्षाट्टवर्गस्तवर्गजः।।’ इति अभियुक्तोक्त्याऽत्रानुस्वारो नकारस्थानिकः। तेन क्विपि संयोगान्तलोपे नकारान्तं रूपं प्रथमैकवचने बोध्यम्।]]</li> <li id="foot_krm_1041_04"><a href="#ref_krm_1041_04">↑</a> [[आ। ‘न स्फिट्टयामि किमु चुम्बभिया स्थितोऽसि किं पूलितान्नकृतपुंसनयाऽत्र पुंसाम्।।’ धा। का। ३। २६।]]</li> <li id="foot_krm_1041_05"><a href="#ref_krm_1041_05">↑</a> (३७५)</li></ul></p>

पुस्त|पुस्तकः-स्तिका|पुपुस्तयिषकः-षिका
<ul><li><sup id="ref_krm_1042_01"><a href="#foot_krm_1042_01">1</a></sup> {@“पुस्त आदरानादरयोः”@} <sup id="ref_krm_1042_02"><a href="#foot_krm_1042_02">2</a></sup> ‘--दानादरयोः’ इति धातुकाव्ये <sup id="ref_krm_1042_03"><a href="#foot_krm_1042_03">3</a></sup> पाठः। </li> <li>पुस्तकः-स्तिका, पुपुस्तयिषकः-षिका;</li> <li>  <sup id="ref_krm_1042_04"><a href="#foot_krm_1042_04">4</a></sup> पुस्तितः, <sup id="ref_krm_1042_05"><a href="#foot_krm_1042_05">5</a></sup> पुस्तकम्, इत्यादीनि सर्वाण्यपि रूपाणि चौरादिककुस्मयतिवत् <sup id="ref_krm_1042_06"><a href="#foot_krm_1042_06">6</a></sup> ज्ञेयानि। </li> <li>अस्योभयपदि- त्वात् शताऽपि भवतीति विशेषः। </li> <li>क्विपि, पुस्त्-पुस्तौ-पुस्तः इति रूपाणि इति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1042_01"><a href="#ref_krm_1042_01">↑</a> (१०३२)</li> <li id="foot_krm_1042_02"><a href="#ref_krm_1042_02">↑</a> (१०-चुरादिः-१५९०। सक। सेट्। उभ।)</li> <li id="foot_krm_1042_03"><a href="#ref_krm_1042_03">↑</a> (३-२०)</li> <li id="foot_krm_1042_04"><a href="#ref_krm_1042_04">↑</a> [[B। ‘बर्हादिमण्डितसुभण्डितविग्रहोऽसौ प्रच्छर्दितः किल बकेन च पुस्तितार्तिः।’ धा। का। ३। २०।]]</li> <li id="foot_krm_1042_05"><a href="#ref_krm_1042_05">↑</a> [[२। ‘क्वुन् शिल्पिसंज्ञयोः--’ (द। उ। ३-५) इति संज्ञायां क्वुन्।]]</li> <li id="foot_krm_1042_06"><a href="#ref_krm_1042_06">↑</a> (२३६)</li></ul></p>

पूङ्|पावकः-विका|पिपविषकः-षिका|पोपूयकः-यिका|पविता-त्री|पावयिता-त्री|पिपविषिता-त्री|पोपूयिता-त्री|-|पावयन्-न्ती|पावयिष्यन्-न्ती-ती|पवमानः|पावयमानः|पिपविषमाणः|पोपूयमानः|पविष्यमाणः|पावयिष्यमाणः|पिपविषिष्यमाणः|पोपूयिष्यमाणः|पूः-पुवौ-पुवः|-पूतम्-पवितम्-तः-तवान्|पावितः|पिपविषितः|पोपूयितः-तवान्|पवः|पवनः|पवित्रम्|पोता|पावः|पिपविषुः-पिपावयिषुः|पोपुवः|पवितव्यम्|पावयितव्यम्|पिपविषितव्यम्|पोपूयितव्यम्|प्रपवणीयम्-प्रपवनीयम्|प्रपावणीयम्-प्रपावनीयम्|पिपविषणीयम्|पोपूयनीयम्|विपूयः-पव्यम्|अवश्यपाव्यम्|पाव्यम्|पिपविष्यम्|पोपूय्यम्|पूयमानः|पाव्यमानः|पिपविष्यमाणः|पोपूय्यमानः|निष्पावः|उत्पावः|पोत्रम्|वनपोत्रः|पिपविषः|पोपूयः|पवितुम्|पावयितुम्|पिपविषितुम्|पोपूयितुम्|पूतिः|पावना|विपविषा|पिपावयिषा|पोपूया|पवनम्|पावनम्|पिपविषणम्|पोपूयनम्|पूत्वा-पवित्वा|पावयित्वा|पिपविषित्वा|पोपूयित्वा|प्रपूय|प्रपाव्य|प्रपिपविष्य|प्रपोपूय्य|पावम्पूत्वा-पवित्वापावम्|पिपविषम्|पोपूयम्
<ul><li><sup id="ref_krm_1043_01"><a href="#foot_krm_1043_01">1</a></sup> {@“पूङ् पवने”@} <sup id="ref_krm_1043_02"><a href="#foot_krm_1043_02">2</a></sup> पवनम् = शोधनम्। </li> <li>‘श्नि पुनाति पुनीते स्ताम्, पवने पवते ङितः।’ <sup id="ref_krm_1043_03"><a href="#foot_krm_1043_03">3</a></sup> इति देवः। </li> <li>पावकः-विका, पावकः-विका, <sup id="ref_krm_1043_04"><a href="#foot_krm_1043_04">4</a></sup> पिपविषकः-षिका, पोपूयकः-यिका;</li> <li>  पविता-त्री, पावयिता-त्री, पिपविषिता-त्री, पोपूयिता-त्री;</li> <li>  -- पावयन्-न्ती, पावयिष्यन्-न्ती-ती, -- -- पवमानः, पावयमानः, पिपविषमाणः, पोपूयमानः;</li> <li>  <sup id="ref_krm_1043_05"><a href="#foot_krm_1043_05">5</a></sup> पविष्यमाणः, पावयिष्यमाणः, पिपविषिष्यमाणः, पोपूयिष्यमाणः;</li> <li>  पूः-पुवौ-पुवः;</li> <li>  -- -- -- <sup id="ref_krm_1043_06"><a href="#foot_krm_1043_06">6</a></sup> पूतम्-पवितम्- <sup id="ref_krm_1043_07"><a href="#foot_krm_1043_07">7</a></sup> तः-तवान्, पावितः, पिपविषितः, पोपूयितः-तवान्;</li> <li>  पवः, <sup id="ref_krm_1043_08"><a href="#foot_krm_1043_08">8</a></sup> पवमानः, <sup id="ref_krm_1043_09"><a href="#foot_krm_1043_09">9</a></sup> पवनः, <sup id="ref_krm_1043_10"><a href="#foot_krm_1043_10">10</a></sup> पवित्रम् <sup id="ref_krm_1043_11"><a href="#foot_krm_1043_11">11</a></sup>, <sup id="ref_krm_1043_12"><a href="#foot_krm_1043_12">12</a></sup> पोता, पावः, <sup id="ref_krm_1043_13"><a href="#foot_krm_1043_13">13</a></sup> पिपविषुः- <sup id="ref_krm_1043_14"><a href="#foot_krm_1043_14">14</a></sup> पिपावयिषुः, पोपुवः;</li> <li>  पवितव्यम्, पावयितव्यम्, पिपविषितव्यम्, पोपूयितव्यम्;</li> <li>  <sup id="ref_krm_1043_15"><a href="#foot_krm_1043_15">15</a></sup> प्रपवणीयम्-प्रपवनीयम्, <sup id="ref_krm_1043_16"><a href="#foot_krm_1043_16">16</a></sup> प्रपावणीयम्-प्रपावनीयम्, पिपविषणीयम्, पोपूयनीयम्;</li> <li>  <sup id="ref_krm_1043_17"><a href="#foot_krm_1043_17">17</a></sup> <sup id="ref_krm_1043_18"><a href="#foot_krm_1043_18">18</a></sup> विपूयः <sup id="ref_krm_1043_19"><a href="#foot_krm_1043_19">19</a></sup> -पव्यम्, <sup id="ref_krm_1043_20"><a href="#foot_krm_1043_20">20</a></sup> अवश्यपाव्यम्, पाव्यम्, पिपविष्यम्, पोपूय्यम्;</li> <li>  पूयमानः, पाव्यमानः, पिपविष्यमाणः, पोपूय्यमानः;</li> <li>  <sup id="ref_krm_1043_21"><a href="#foot_krm_1043_21">21</a></sup> पवः, <sup id="ref_krm_1043_22"><a href="#foot_krm_1043_22">22</a></sup> निष्पावः, <sup id="ref_krm_1043_23"><a href="#foot_krm_1043_23">23</a></sup> उत्पावः, <sup id="ref_krm_1043_24"><a href="#foot_krm_1043_24">24</a></sup> पोत्रम्, <sup id="ref_krm_1043_25"><a href="#foot_krm_1043_25">25</a></sup> वनपोत्रः, <sup id="ref_krm_1043_26"><a href="#foot_krm_1043_26">26</a></sup> पवित्रम्, पावः, पिपविषः, पोपूयः;</li> <li>  पवितुम्, पावयितुम्, पिपविषितुम्, पोपूयितुम्;</li> <li>  पूतिः, पावना, विपविषा, पिपावयिषा, पोपूया;</li> <li>  पवनम्, पावनम्, पिपविषणम्, पोपूयनम्;</li> <li>  पूत्वा-पवित्वा, <sup id="ref_krm_1043_27"><a href="#foot_krm_1043_27">27</a></sup> पावयित्वा, पिपविषित्वा, पोपूयित्वा;</li> <li>  प्रपूय, प्रपाव्य, प्रपिपविष्य, प्रपोपूय्य;</li> <li>  पावम् २ पूत्वा २ -पवित्वा २ पावम् २, पावयित्वा २, पिपविषम् २, पिपविषित्वा २, पोपूयम् २;</li> <li>  पोपूयित्वा २। <sup id="ref_krm_1043_28"><a href="#foot_krm_1043_28">28</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1043_01"><a href="#ref_krm_1043_01">↑</a> (१०३३)</li> <li id="foot_krm_1043_02"><a href="#ref_krm_1043_02">↑</a> (१-भ्वादिः-९६६। अक। सेट्। आत्म।)</li> <li id="foot_krm_1043_03"><a href="#ref_krm_1043_03">↑</a> (श्लो। २७)</li> <li id="foot_krm_1043_04"><a href="#ref_krm_1043_04">↑</a> [[३। सन्नन्ते, उगन्तत्वेनेण्निषेधे प्राप्ते, ‘स्मिपूङ्रञ्ज्वशां सनि’ (७-२-७४) इति नित्य- मिट्। ‘ओः पुयण्ज्यपरे’ (७-४-८०) इत्यभ्यासस्य इकारः। एवं सन्नन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_1043_05"><a href="#ref_krm_1043_05">↑</a> [पृष्ठम्०८७६+ २६]</li> <li id="foot_krm_1043_06"><a href="#ref_krm_1043_06">↑</a> [[१। ‘पूङश्च’ (७-२-५१) इति निष्ठाया इड्विकल्पः। ‘पूङ्ः क्त्वा च’ (१-२-२२) इति निष्ठायाः कित्त्वनिषेधाद् गुणावादेशौ। एवं क्त्वायामपि रूपद्वयस्योपपत्तिर्ज्ञेया।]]</li> <li id="foot_krm_1043_07"><a href="#ref_krm_1043_07">↑</a> [[आ। ‘पवितोऽनुगुणैर्वातैः शीतैः पूत्वा पयोनिधौ।’ भ। का। ९-३९।]]</li> <li id="foot_krm_1043_08"><a href="#ref_krm_1043_08">↑</a> [[२। कर्तरि, ‘पूङ्यजोः शानन्’ (३-२-१२८) इति शानन्प्रत्ययः। शपि, ‘आने मुक्’ (७-२-८२) इति मुगागमः।]]</li> <li id="foot_krm_1043_09"><a href="#ref_krm_1043_09">↑</a> [[३। नन्द्यादित्वात् (३-१-१३४) कर्तरि ल्युप्रत्यये, अनादेशे च रूपम्। पवनः = वायुः।]]</li> <li id="foot_krm_1043_10"><a href="#ref_krm_1043_10">↑</a> [[४। ‘कर्तरि चर्षिदेवतयोः’ (३-२-१८६) इति कर्तरि ऋषौ, देवतायां वा अभिधेये सति इत्रप्रत्ययः। ऋषिः = अग्निः। ‘अग्निः पवित्रम्, स मा पुनातु,’ (आप। श्रौ। सू। १२-१९-६) ‘वायुः सोमः सूर्य इन्द्रः पवित्रम्, ते मा पुनन्तु।’ (आप। श्रौतसूत्रे १२-९-६) इत्यादिषु यथा। ऋषौ करणे, देवतायाम् कर्तरि चायं प्रत्ययो ज्ञेयः।]]</li> <li id="foot_krm_1043_11"><a href="#ref_krm_1043_11">↑</a> [अग्निः, देवता वा]</li> <li id="foot_krm_1043_12"><a href="#ref_krm_1043_12">↑</a> [[५। ‘तृन्’ (३-२-१३५) इति तच्छीलादिषु कर्तृषु तृन्प्रत्ययः। बाहुलकात् इडागमाभावः।]]</li> <li id="foot_krm_1043_13"><a href="#ref_krm_1043_13">↑</a> [[B। ‘जगत् पिपविषुर्वायुः कल्पान्त इव दुर्धरः।।’ भ। का। ९-५३।]]</li> <li id="foot_krm_1043_14"><a href="#ref_krm_1043_14">↑</a> [[६। ण्यन्तात् सनि, उप्रत्यये रूपम्। अत्रापि ‘ओः पुयण्ज्यपरे’ (७-४-८०) इति अभ्यासस्येकारः। तत्प्रदर्शनार्थमेवात्र रूपमेकं निदर्शितम्।]]</li> <li id="foot_krm_1043_15"><a href="#ref_krm_1043_15">↑</a> [[७। ‘न भाभूपू--’ (८-४-३४) इत्यत्र ‘पू’ इत्यनेन पूञ एव ग्रहणम्, न तु पूङः इति काशिकादिषु दृश्यते। तेनात्र णत्वं भवत्येव। क्षीरस्वामी तु अविशेषेण पूङोऽपि प्रकृतसूत्रे ग्रहणं मन्यमानः प्रपवनीयम् इति णत्वाभाव- घटितं रूपमुदाजहार।]]</li> <li id="foot_krm_1043_16"><a href="#ref_krm_1043_16">↑</a> [[८। ‘ण्यन्तभादीनामुपसंख्यानम्’ (वा। ८-४-३४) इति णत्वनिषेधोऽपि नास्य धातोरिति पक्षे रूपमेवम्। क्षीरस्वामिमते तु पूर्ववदत्रापि णत्वनिषेधः।]]</li> <li id="foot_krm_1043_17"><a href="#ref_krm_1043_17">↑</a> [पृष्ठम्०८७७+ २४]</li> <li id="foot_krm_1043_18"><a href="#ref_krm_1043_18">↑</a> [[१। ‘विपूयविनीयजित्या मुञ्जकल्कहलिषु’ (३-१-११७) इत्यनेन मुञ्जेऽभिधेये विपूर्वका- दस्मात् क्यपि रूपमेवम्। अन्यत्रार्थे तु ‘अचो यत् (३-१-९७) इति यति, अवादेशे च पव्यम् इति रूपम्।]]</li> <li id="foot_krm_1043_19"><a href="#ref_krm_1043_19">↑</a> [[आ। ‘वसानां वल्कले शुद्धे विपूयैः कृतमेखलाम्।’ भ। का। ६-६१।]]</li> <li id="foot_krm_1043_20"><a href="#ref_krm_1043_20">↑</a> [[२। ‘ओरावश्यके’ (३-१-१२५) इति ण्यत्। आवादेशः। अवश्यमो मकारस्य ‘लुम्पेदवश्यमः कृत्ये’ (काशिका। ६-३-१०९) इति लोपः।]]</li> <li id="foot_krm_1043_21"><a href="#ref_krm_1043_21">↑</a> [[३। ‘ॠदोरप्’ (३-३-५७) इति भावेऽप्प्रत्ययः। घञपवादः।]]</li> <li id="foot_krm_1043_22"><a href="#ref_krm_1043_22">↑</a> [[४। ‘निरभ्योः पूल्वोः’ (३-३-२८) इति निष्पूर्वकादस्मात् घञ्। निष्पावः = धान्य- विशेषः। ‘परिमाणाख्यायां सर्वेभ्यः’ (३-३-२०) इति घञ्यपि रूपमेवमेव। तदानीं निष्पावः = परिमाणविशेषः।]]</li> <li id="foot_krm_1043_23"><a href="#ref_krm_1043_23">↑</a> [[५। ‘उदि श्रयतियौतिपूद्रुवः’ (३-३-४९) इति घञ्।]]</li> <li id="foot_krm_1043_24"><a href="#ref_krm_1043_24">↑</a> [[६। ‘हलसूकरयोः पुवः’ (३-२-१८३) इति करणे ष्ट्रन्प्रत्यये रूपम्। पोत्रम् = सूकरस्य, हलस्य वा मुखम्।]]</li> <li id="foot_krm_1043_25"><a href="#ref_krm_1043_25">↑</a> [[B। ‘भूदार एव वनपोत्रवतामतानीत् भूदारशब्दमसहिष्णुरिवान्तमेषाम्।।’ च। भा। १। २०।]]</li> <li id="foot_krm_1043_26"><a href="#ref_krm_1043_26">↑</a> [[७। ‘पुवः संज्ञायाम्’ (३-२-१८५) इति करणे इत्रप्रत्ययः। पवित्रम् = दर्भः, चक्रायुधं च।]]</li> <li id="foot_krm_1043_27"><a href="#ref_krm_1043_27">↑</a> [[C। ‘सूतोऽपि गङ्गासलिलैः पवित्वा सहाश्वमात्मानमनल्पमन्युः।’ भ। का। ३। १८।]]</li> <li id="foot_krm_1043_28"><a href="#ref_krm_1043_28">↑</a> [पृष्ठम्०८७८+ ३०]</li></ul></p>

पूज
<ul><li><sup id="ref_krm_1044_01"><a href="#foot_krm_1044_01">1</a></sup> {@“पूज पूजने”@} <sup id="ref_krm_1044_02"><a href="#foot_krm_1044_02">2</a></sup> पूजकः-जिका, पुपूजयिषकः-षिका, इत्यादीनि सर्वाणि रूपाणि चौरादिक- कूटयतिवत् <sup id="ref_krm_1044_03"><a href="#foot_krm_1044_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1044_04"><a href="#foot_krm_1044_04">4</a></sup> पूजा, <sup id="ref_krm_1044_05"><a href="#foot_krm_1044_05">5</a></sup> पूज्यमानः, पूजयन्-न्ती, <sup id="ref_krm_1044_06"><a href="#foot_krm_1044_06">6</a></sup> <sup id="ref_krm_1044_07"><a href="#foot_krm_1044_07">7</a></sup> पूजितः, राजपूजितः, इत्यादीनि रूपाण्यस्य धातोः विशेषेण संभवन्ति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1044_01"><a href="#ref_krm_1044_01">↑</a> (१०३४)</li> <li id="foot_krm_1044_02"><a href="#ref_krm_1044_02">↑</a> (१०-चुरादिः १६४३। सक। सेट्। उभ।)</li> <li id="foot_krm_1044_03"><a href="#ref_krm_1044_03">↑</a> (२४०)</li> <li id="foot_krm_1044_04"><a href="#ref_krm_1044_04">↑</a> [[१। ‘चिन्तिपूजिकथिकुम्बिचर्चश्च’ (३-३-१०५) इति स्त्रियां भावादौ युजपवादोऽ- ङ्प्रत्ययः।]]</li> <li id="foot_krm_1044_05"><a href="#ref_krm_1044_05">↑</a> [[आ। ‘च्युतनिखिलविशङ्कः पूज्यमानो जनौघैः सकलभुवनराज्यं कारयास्मन्मतेन।।’ भ। का। ३। ५६।]]</li> <li id="foot_krm_1044_06"><a href="#ref_krm_1044_06">↑</a> [राज्ञां]</li> <li id="foot_krm_1044_07"><a href="#ref_krm_1044_07">↑</a> [[२। ‘मतिबुद्धिपूजार्थेभ्यश्च’ (३-२-१८८) इति वर्तमाने क्तः। ‘क्तस्य च वर्तमाने’ (२-३-६७) इति कर्तरि षष्ठी। ‘क्तेन च पूजायाम्’ (२-२-१२) इति समास- निषेधः। राजपूजितः इति प्रयोगस्तु राज्ञा पूजितः इति तृतीयासमासे साधुः।]]</li></ul></p>

