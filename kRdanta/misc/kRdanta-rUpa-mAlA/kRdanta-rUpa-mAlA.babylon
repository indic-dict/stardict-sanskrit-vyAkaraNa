<ul><li><sup id="ref_krm_0203_01"><a href="#foot_krm_0203_01">1</a></sup> {@“कुङ् शब्दे”@} <sup id="ref_krm_0203_02"><a href="#foot_krm_0203_02">2</a></sup> <sup id="ref_krm_0203_03"><a href="#foot_krm_0203_03">3</a></sup> “सत्यपि हि शब्दार्थत्वे भिद्यत एवैषामभिधेयम्। </li> <li>तथाहि--कवतिस्तावत्-- अव्यक्ते शब्दे वर्तते--उष्ट्रः कोकूयते इति। </li> <li>कुवतिरपि--आर्तस्वरे वर्तते-- चोकूयते वृषल इति;</li> <li>  पीडित इत्यर्थः। </li> <li>कौतिस्तु शब्दमात्रे।” इति दैवव्याख्याने पुरुषकारे उपात्तं न्यासवचनमिहानुसन्धेयम्।]] ‘अव्यक्तशब्दे कवते, कुवते त्वार्तशब्दने। </li> <li>कौतीति शब्दमात्रे स्यात्--’ <sup id="ref_krm_0203_04"><a href="#foot_krm_0203_04">4</a></sup> इति देवः। </li> <li>कावकः-विका, कावकः-विका, चुकूषकः-षिका, <sup id="ref_krm_0203_05"><a href="#foot_krm_0203_05">5</a></sup> कोकूयकः-यिका;</li> <li>  कोता-त्री, कावयिता-त्री, चुकूषिता-त्री, कोकूयिता-त्री;</li> <li>  -- कावयन्-न्ती, कावयिष्यन्-न्ती-ती;</li> <li>  -- कवमानः, कावयमानः, चुकूषमाणः, कोकूयमानः;</li> <li>  <sup id="ref_krm_0203_06"><a href="#foot_krm_0203_06">6</a></sup> कोष्यमाणः, कावयिष्यमाणः, चुकूषिष्यमाणः, कोकूयिष्यमाणः;</li> <li>  कुत्-कुतौ-कुतः;</li> <li>  -- -- -- कुतम्- <sup id="ref_krm_0203_07"><a href="#foot_krm_0203_07">7</a></sup> तः, कावितः-तम्, चुकूषितः, कोकूयितः-तवान्;</li> <li>  कवः, कावः, चुकूषुः, चुकावयिषुः, कोकुवः;</li> <li>  कोतव्यम्, कावयितव्यम्, चुकूषितव्यम्, कोकूयितव्यम्;</li> <li>  कवनीयम्, कावनीयम्, चुकूषणीयम्, कोकूयनीयम्;</li> <li>  कव्यम्, अवश्यकाव्यम्, काव्यम्, चुकूष्यम्, कोकूय्यम्;</li> <li>  ईषत्कवः-दुष्कवः-सुकवः;</li> <li>  -- -- <sup id="ref_krm_0203_08"><a href="#foot_krm_0203_08">8</a></sup> कूयमानः, काव्यमानः, चुकूष्यमाणः, कोकूय्यमानः;</li> <li>  कवः, कावः, चुकूषः, कोकूयः;</li> <li>  कोतुम्, कावयितुम्, चुकूषितुम्, कोकूयितुम्;</li> <li>  कुतिः, कावना, चुकूषा, चुकावयिषा, कोकूया;</li> <li>  कवनम्, कावनम्, चुकूषणम्, कोकूयनम्;</li> <li>  कुत्वा, कावयित्वा, चुकूषित्वा, कोकूयित्वा;</li> <li>  प्रकुत्य, संकाव्य, प्रचुकूष्य, प्रकोकूय्य;</li> <li>  कावम् २, कुत्वा २, कावम् २, कावयित्वा २, चुकूषम् २, चुकूषित्वा २, कोकूयम् २;</li> <li>  कोकूयित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0203_01"><a href="#ref_krm_0203_01">↑</a> (१९८)</li> <li id="foot_krm_0203_02"><a href="#ref_krm_0203_02">↑</a> (१-भ्वादिः-९५१। अक। अनि। आत्म।)</li> <li id="foot_krm_0203_03"><a href="#ref_krm_0203_03">↑</a> [[[अ]</li> <li id="foot_krm_0203_04"><a href="#ref_krm_0203_04">↑</a> (श्लो। २३)</li> <li id="foot_krm_0203_05"><a href="#ref_krm_0203_05">↑</a> [[४। ‘न कवतेर्यङि’ (७-४-६३) इति अभ्यासे चुत्वनिषेधः। ‘अकृत्सार्वधातुकयोः--’ (७-४-२५) इति दीर्घः। एवं यङन्ते सर्वत्र बोध्यम्।]]</li> <li id="foot_krm_0203_06"><a href="#ref_krm_0203_06">↑</a> [पृष्ठम्०१९४+ २४]</li> <li id="foot_krm_0203_07"><a href="#ref_krm_0203_07">↑</a> [[आ। ‘श्रुत्यन्तवाचा ध्रुवया प्रदूनं घोरद्रवच्चक्रजिताज्ञितारिम्। स्मितार्द्रवक्त्रं गवमानभूषं गै त्वां घुताशं कुतशङ्गघोषैः।।’ धा। का। २-३५।]]</li> <li id="foot_krm_0203_08"><a href="#ref_krm_0203_08">↑</a> [[१। ‘अकृत्सार्वधातुकयोः--’ (७-४-२५) इति दीर्घः।]]</li></ul></p>

कुङ्|कावकः-विका|चुकूषकः-षिका|चोकूयकः-यिका
<ul><li><sup id="ref_krm_0204_01"><a href="#foot_krm_0204_01">1</a></sup> {@“कुङ् <sup id="ref_krm_0204_02"><a href="#foot_krm_0204_02">2</a></sup> शब्दे”@} <sup id="ref_krm_0204_03"><a href="#foot_krm_0204_03">3</a></sup> कुटादिः। </li> <li>‘अव्यक्तशब्दे कवते, कुवते त्वार्तशब्दने। </li> <li>कौतीति शब्दमात्रे स्यात्--’ <sup id="ref_krm_0204_04"><a href="#foot_krm_0204_04">4</a></sup> इति देवः। </li> <li>कावकः-विका, कावकः-विका, चुकूषकः-षिका, चोकूयकः-यिका;</li> <li>  इत्यादिरूपाणि आदादिक <sup id="ref_krm_0204_05"><a href="#foot_krm_0204_05">5</a></sup> कुधातुवत् ण्यन्तात् सन्नन्तात् यङन्ताच्च ज्ञेयानि। </li> <li>शुद्धाद्धातोः कुटादित्वात् रूपाणि लिख्यन्ते-- <sup id="ref_krm_0204_06"><a href="#foot_krm_0204_06">6</a></sup> <sup id="ref_krm_0204_07"><a href="#foot_krm_0204_07">7</a></sup> कुता-त्री, <sup id="ref_krm_0204_08"><a href="#foot_krm_0204_08">8</a></sup> कुवमानः, <sup id="ref_krm_0204_09"><a href="#foot_krm_0204_09">9</a></sup> कुष्यमाणः, कुत्-कुतौ-कुतः, कुतम्-तः-तवान्, कुवः, कुतव्यम्, कुवनीयम्, <sup id="ref_krm_0204_10"><a href="#foot_krm_0204_10">10</a></sup> कुयम्, <sup id="ref_krm_0204_11"><a href="#foot_krm_0204_11">11</a></sup> अवश्यकाव्यम्, ईषत्कुवः-दुष्कुवः- सुकुवः, कूयमानः, कुवः, कुतुम्, कुतिः, कुवनम्, कुत्वा, अवकुत्य, कावम् २, कुत्वा २, <sup id="ref_krm_0204_12"><a href="#foot_krm_0204_12">12</a></sup> कुररः इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0204_01"><a href="#ref_krm_0204_01">↑</a> (१९९)</li> <li id="foot_krm_0204_02"><a href="#ref_krm_0204_02">↑</a> (आर्त)</li> <li id="foot_krm_0204_03"><a href="#ref_krm_0204_03">↑</a> (६-तुदादिः-१४०१। अक। अनि। आत्म।)</li> <li id="foot_krm_0204_04"><a href="#ref_krm_0204_04">↑</a> (श्लो। २३)</li> <li id="foot_krm_0204_05"><a href="#ref_krm_0204_05">↑</a> (१९६)</li> <li id="foot_krm_0204_06"><a href="#ref_krm_0204_06">↑</a> [पृष्ठम्०१९५+ २४]</li> <li id="foot_krm_0204_07"><a href="#ref_krm_0204_07">↑</a> [[१। ‘गाङ्कुटादिभ्योऽञ्णिन्ङित्’ (१-२-१) इति ङिद्वद्भावात् गुणो न।]]</li> <li id="foot_krm_0204_08"><a href="#ref_krm_0204_08">↑</a> [[२। ‘तुदादिभ्यः शः’ (३-१-७७) इति शः। उवङ्।]]</li> <li id="foot_krm_0204_09"><a href="#ref_krm_0204_09">↑</a> [[आ। ‘नूत्या किं भयधूतविद्रुतगुवल्लोकं तदा तद्ध्रुवत्- कोदण्डं कुवमानमैक्षि दलितं भोजेश्वराकूतवत्।।’ धा। का। २-८२।]]</li> <li id="foot_krm_0204_10"><a href="#ref_krm_0204_10">↑</a> [[३। ङिद्वद्भावात् यति गुणो न।]]</li> <li id="foot_krm_0204_11"><a href="#ref_krm_0204_11">↑</a> [[४। ‘ओरावश्यके’ (३-१-१२५) इति ण्यत्। णित्त्वात् ङित्त्वं न।]]</li> <li id="foot_krm_0204_12"><a href="#ref_krm_0204_12">↑</a> [[५। ‘कुवः क्ररन्’ (द। उ। ८-६३) इति क्ररन् प्रत्ययः। कुररः = पक्षिविशेषः।]]</li></ul></p>

कुच|कोचकः-चिका|चुकुचिषकः-चुकोचिषकः-षिका|चोकुचकः-चिका|कोचिता-त्री|कोचयिता-त्री|चुकुचिषिता-चुकोचिषिता-त्री|चोकुचिता-त्री|कोचन्-न्ती|कोचयन्-न्ती|चुकुचिषन्-चुकोचिषन्-न्ती|-|कोचिष्यन्-न्ती-ती|कोचयिष्यन्-न्ती-ती|चुकुचिषिष्यन्-चुकोचिषिष्यन्-न्ती-ती|कोचयमानः|कोचयिष्यमाणः|चोकुच्यमानः|चोकुचिष्यमाणः|कुचितम्-कोचितम्|कोचितः-तम्|चुकुचिषितः-चुकोचिषितः|चोकुचितः-तवान्|कुचः|कोचः|चुकुचिषुः-चुकोचिषुः|चोकुचः|कोचितव्यम्|कोचयितव्यम्|चुकुचिषितव्यम्-चुकोचिषितव्यम्|चोकुचितव्यम्|कोचनीयम्|चुकुचिषणीयम्-चुकोचिषणीयम्|चोकुचनीयम्|कोच्यम्|चुकुचिष्यम्-चुकोचिष्यम्|चोकुच्यम्|ईषत्कोचः-दुष्कोचः-सुकोचः|कुच्यमानः|कोच्यमानः|चुकुचिष्यमाणः-चुकोचिष्यमाणः|सङ्कोचः|चुकुचिषः-चुकोचिषः|कोचितुम्|कोचयितुम्|चुकुचिषितुम्-चुकोचिषितुम्|चोकुचितुम्|कुक्तिः|कोचना|चुकुचिषा-चुकोचिषा|चुकोचयिषा|चोकुचा|कोचनम्|चुकुचिषणम्|चुकोचिषणम्|चोकुचनम्|कुचित्वा|कोचित्वा|कोचयित्वा|चुकुचिषित्वा-चुकोचिषित्वा|चोकुचित्वा|सङ्कुच्य|सङ्कोच्य|सञ्चुकुचिष्य-सञ्चुकोचिष्य|सञ्चोकुच्य|कोचम्|चुकुचिषम्-चुकोचिषम्|चोकुचम्
<ul><li><sup id="ref_krm_0205_01"><a href="#foot_krm_0205_01">1</a></sup> {@“कुच शब्दे तारे”@} <sup id="ref_krm_0205_02"><a href="#foot_krm_0205_02">2</a></sup> कोचकः-चिका, कोचकः-चिका, चुकुचिषकः- <sup id="ref_krm_0205_03"><a href="#foot_krm_0205_03">3</a></sup> चुकोचिषकः-षिका, चोकुचकः-चिका;</li> <li>  कोचिता-त्री, कोचयिता-त्री, चुकुचिषिता-चुकोचिषिता-त्री, चोकुचिता-त्री;</li> <li>  कोचन्-न्ती, कोचयन्-न्ती, चुकुचिषन्-चुकोचिषन्-न्ती;</li> <li>  -- कोचिष्यन्-न्ती-ती, कोचयिष्यन्-न्ती-ती, चुकुचिषिष्यन्-चुकोचिषिष्यन्-न्ती-ती;</li> <li>  -- कोचयमानः, कोचयिष्यमाणः, चोकुच्यमानः, चोकुचिष्यमाणः;</li> <li>  <sup id="ref_krm_0205_04"><a href="#foot_krm_0205_04">4</a></sup> कुचितम्-कोचितम्, कोचितः-तम्, चुकुचिषितः-चुकोचिषितः, चोकुचितः-तवान्;</li> <li>  कुचः, कोचः, चुकुचिषुः-चुकोचिषुः, चोकुचः;</li> <li>  कोचितव्यम्, कोचयितव्यम्, चुकुचिषितव्यम्-चुकोचिषितव्यम्, चोकुचितव्यम्;</li> <li>  कोचनीयम्, कोचनीयम्, चुकुचिषणीयम्-चुकोचिषणीयम्, चोकुचनीयम्;</li> <li>  कोच्यम्, कोच्यम्, चुकुचिष्यम्-चुकोचिष्यम्, चोकुच्यम्;</li> <li>  ईषत्कोचः-दुष्कोचः-सुकोचः;</li> <li>  -- -- कुच्यमानः, कोच्यमानः, चुकुचिष्यमाणः-चुकोचिष्यमाणः, चोकुच्यमानः;</li> <li>  <sup id="ref_krm_0205_05"><a href="#foot_krm_0205_05">5</a></sup> सङ्कोचः, कोचः, चुकुचिषः-चुकोचिषः, चोकुचः;</li> <li>  कोचितुम्, कोचयितुम्, चुकुचिषितुम्-चुकोचिषितुम्, चोकुचितुम्;</li> <li>  कुक्तिः, कोचना, चुकुचिषा-चुकोचिषा, चुकोचयिषा, चोकुचा;</li> <li>  कोचनम्, कोचनम्, चुकुचिषणम् चुकोचिषणम्, चोकुचनम्;</li> <li>  <sup id="ref_krm_0205_06"><a href="#foot_krm_0205_06">6</a></sup> कुचित्वा कोचित्वा कोचयित्वा, चुकुचिषित्वा-चुकोचिषित्वा, चोकुचित्वा;</li> <li>  सङ्कुच्य, सङ्कोच्य, सञ्चुकुचिष्य-सञ्चुकोचिष्य, सञ्चोकुच्य;</li> <li>  कोचम् २, कुचित्वा २, कोचित्वा २, कोचम् २, कोचयित्वा २, चुकुचिषम् २ -चुकोचिषम् २, चुकुचिषित्वा २ -चुकोचिषित्वा २, चोकुचम् २;</li> <li>  चोकुचित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0205_01"><a href="#ref_krm_0205_01">↑</a> (२००)</li> <li id="foot_krm_0205_02"><a href="#ref_krm_0205_02">↑</a> (१-भ्वादिः-१८४। सक। सेट्। पर।)</li> <li id="foot_krm_0205_03"><a href="#ref_krm_0205_03">↑</a> [[६। ‘रलो व्युपधात्--’ (१-२-२६) इति सनः कित्त्वविकल्पः।]]</li> <li id="foot_krm_0205_04"><a href="#ref_krm_0205_04">↑</a> [[७। ‘उदुपधात्--’ (१-२-२१) इति निष्ठायाः कित्त्वविकल्पः।]]</li> <li id="foot_krm_0205_05"><a href="#ref_krm_0205_05">↑</a> [पृष्ठम्०१९६+ २६]</li> <li id="foot_krm_0205_06"><a href="#ref_krm_0205_06">↑</a> [[१। ‘रलो व्युपधात्--’ (१-२-२६) इति क्त्वायाः कित्वविकल्पनात् पक्षे गुणः।]]</li></ul></p>

कुच
<ul><li><sup id="ref_krm_0206_01"><a href="#foot_krm_0206_01">1</a></sup> {@“कुच सम्पर्चनकौटिल्यप्रतिष्टम्भविलेखनेषु”@} <sup id="ref_krm_0206_02"><a href="#foot_krm_0206_02">2</a></sup> ज्वलादिः। </li> <li>‘सङ्कोचे कुचतीति स्यात्, कोचेत् सम्पर्चनादिषु।’ <sup id="ref_krm_0206_03"><a href="#foot_krm_0206_03">3</a></sup> इति देवः। </li> <li>ज्वलादित्वात् ‘ज्वलितिकसन्तेभ्यो णः’ <sup id="ref_krm_0206_04"><a href="#foot_krm_0206_04">4</a></sup> इति कर्तरि वा णः प्रत्ययः। </li> <li><sup id="ref_krm_0206_05"><a href="#foot_krm_0206_05">5</a></sup> कोचः-कुचः। </li> <li>अनुपसृष्टादेव। </li> <li>उपसृष्टात्तु उत्कोचः। </li> <li>अन्यानि सर्वाणि रूपाणि कुचघातुवत् <sup id="ref_krm_0206_06"><a href="#foot_krm_0206_06">6</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0206_01"><a href="#ref_krm_0206_01">↑</a> (२०१)</li> <li id="foot_krm_0206_02"><a href="#ref_krm_0206_02">↑</a> (१-भ्वादिः-८५७। सक। सेट्। पर।)</li> <li id="foot_krm_0206_03"><a href="#ref_krm_0206_03">↑</a> (श्लो-५४)</li> <li id="foot_krm_0206_04"><a href="#ref_krm_0206_04">↑</a> (३-१-१४०)</li> <li id="foot_krm_0206_05"><a href="#ref_krm_0206_05">↑</a> [[आ। ‘सेहे च रामाजनखेलनं या कुचोरुसीदत्परिशद्रुतोया। क्रोशैर्जनाः कोचगलान् मरालान् बोधन्ति यत्राम्बुरुहां विकासे।।’ धा। का। २। २४।]]</li> <li id="foot_krm_0206_06"><a href="#ref_krm_0206_06">↑</a> (२००)</li></ul></p>

कुच|कोचकः-चिका|कुचिता-त्री|कुचन्-न्ती-ती|कुचिष्यन्-न्ती-ती|कुक्-कुचौ-कुचः|कुचितम्-तः-तवान्|कुचितव्यम्|कुचनीयम्|कुच्यम्|ईषत्कुचः-दुष्कुचः-सुकुचः|कुच्यमानः|सङ्कोचः|कुचितुम्|निकुचितिः|कोचनम्-सङ्कोचनम्-कुचनम्|कुचित्वा|सङ्कुच्य|कोचम्
<ul><li><sup id="ref_krm_0207_01"><a href="#foot_krm_0207_01">1</a></sup> {@“कुच सङ्कोचने”@} <sup id="ref_krm_0207_02"><a href="#foot_krm_0207_02">2</a></sup> ‘सङ्कोचे कुचतीति स्यात्, कोचेत् सम्पर्चनादिषु।’ <sup id="ref_krm_0207_03"><a href="#foot_krm_0207_03">3</a></sup> इति देवः। </li> <li>कोचकः-चिका, <sup id="ref_krm_0207_04"><a href="#foot_krm_0207_04">4</a></sup> कुचिता-त्री, <sup id="ref_krm_0207_05"><a href="#foot_krm_0207_05">5</a></sup> कुचन् <sup id="ref_krm_0207_06"><a href="#foot_krm_0207_06">6</a></sup> -न्ती-ती, कुचिष्यन्-न्ती-ती, कुक्-कुचौ-कुचः, कुचितम्-तः-तवान्, कुचितव्यम्, कुचनीयम्, कुच्यम्, <sup id="ref_krm_0207_07"><a href="#foot_krm_0207_07">7</a></sup> ईषत्कुचः-दुष्कुचः-सुकुचः, कुच्यमानः, <sup id="ref_krm_0207_08"><a href="#foot_krm_0207_08">8</a></sup> सङ्कोचः, कुचितुम्, <sup id="ref_krm_0207_09"><a href="#foot_krm_0207_09">9</a></sup> निकुचितिः, <sup id="ref_krm_0207_10"><a href="#foot_krm_0207_10">10</a></sup> कोचनम्-सङ्कोचनम्-कुचनम्, <sup id="ref_krm_0207_11"><a href="#foot_krm_0207_11">11</a></sup> कुचित्वा, सङ्कुच्य, कोचम् २, कुचित्वा २;</li> <li>  इति शुद्धाद्धातो रूपाणि। </li> <li>ण्यन्तात्-सन्नन्तात्-यङन्ताच्च पूर्वोक्त <sup id="ref_krm_0207_12"><a href="#foot_krm_0207_12">12</a></sup> कुचधातुवद्रूपाणि ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0207_01"><a href="#ref_krm_0207_01">↑</a> (२०२)</li> <li id="foot_krm_0207_02"><a href="#ref_krm_0207_02">↑</a> (६-तुदादिः-१३६८-अक। सेट्। पर। कुटादिः।)</li> <li id="foot_krm_0207_03"><a href="#ref_krm_0207_03">↑</a> (श्लो-५४)</li> <li id="foot_krm_0207_04"><a href="#ref_krm_0207_04">↑</a> [[२। ‘गाङ्कुटादिभ्योऽञ्णिन्ङित्’ (१-२-१) इति ङिद्वद्भावान्न गुणः। एवं तव्यदादि- ष्वपि ज्ञेयम्।]]</li> <li id="foot_krm_0207_05"><a href="#ref_krm_0207_05">↑</a> [[३। ‘तुदादिभ्यः--’ (३-१-७७) इति शः विकरणप्रत्ययः। तस्य ‘सार्वधातुकमपित्’ (१-२-४) इति ङिद्वद्भावान्न गुणः।]]</li> <li id="foot_krm_0207_06"><a href="#ref_krm_0207_06">↑</a> [[B। ‘ततोऽतिकुटिलाशयैः प्रपुटितैः कुचज्जीवितैः गुजद्भिरपि सैनिकैः सुगुडितां डिप- द्भिर्जनान्। सुधाच्छुरितविस्फुटस्मितरुचैव धैर्यं मुटन् धनुस्त्रुटनतो मनाक् प्रतुट- नाय शालामगात्।।’ धा। का। २-८०।]]</li> <li id="foot_krm_0207_07"><a href="#ref_krm_0207_07">↑</a> [पृष्ठम्०१९७+ २५]</li> <li id="foot_krm_0207_08"><a href="#ref_krm_0207_08">↑</a> [[१। ‘निष्ठामामनिट इति वक्तव्यम्’ (वा। ७-३-५२) इति वचनात्, अस्य निष्ठायां सेट्त्वात् ‘चजोः--’ (७-३-५२) इति कुत्वं न भवति।]]</li> <li id="foot_krm_0207_09"><a href="#ref_krm_0207_09">↑</a> [[२। ‘तितुत्रेष्वग्रहादीनामिति वक्तव्यम्’ (वा। ७-२-९) इति वचनात्, अस्य ग्रहादित्वात् इड् भवति--इति प्रक्रियासर्वस्वे।]]</li> <li id="foot_krm_0207_10"><a href="#ref_krm_0207_10">↑</a> [[३। ‘कुच सङ्कोचने’ इति निर्देशबलात् कुटादित्वेऽपि ल्युटि परं गुणो भवत्येव इति काश्यपः। ‘सम्’ इत्युपसर्गपूर्वकात् कुचधातोरेव कुटादित्वेऽपि गुणः, अन्यत्र न--इति केचित्। तेषां मते ‘कुचनम्’ इत्येव। निरुपसृष्टादपि गुण एव इत्यन्ये। तन्मते ‘कोचनम्’ इति भवति।]]</li> <li id="foot_krm_0207_11"><a href="#ref_krm_0207_11">↑</a> [[४। ‘रलो व्युपधात् हलादेः संश्च’ (१-२-२६) इति वैकल्पिककित्त्वं बाधित्वा, पूर्व- विप्रतिषेधेन ‘गाङ्कुटादिभ्यः--’ (१-२-१) इति विहितं नित्यङित्त्वमेव भवति। अत एव, ‘अनुदात्तङित आत्मनेपदम्’ (१-३-१२) इत्यत्र ‘उपदेशे’ इत्यस्य ङिदंशेऽन्वयस्य सार्थक्यं भवति।]]</li> <li id="foot_krm_0207_12"><a href="#ref_krm_0207_12">↑</a> [२००]</li></ul></p>

