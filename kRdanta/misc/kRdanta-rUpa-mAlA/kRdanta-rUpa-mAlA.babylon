<ul><li><sup id="ref_krm_0371_01"><a href="#foot_krm_0371_01">1</a></sup> {@“खेरृ गतिप्रतिघाते”@} <sup id="ref_krm_0371_02"><a href="#foot_krm_0371_02">2</a></sup> <sup id="ref_krm_0371_03"><a href="#foot_krm_0371_03">3</a></sup> ‘खोडु--’ इति केचित् पठन्ति।]] खोरकः-रिका, खोरकः-रिका, चुखोरिषकः-षिका, चोखोरकः-रिका;</li> <li>  खोरिता-त्री, खोरयिता-त्री, चुखोरिषिता-त्री, चोखोरिता-त्री;</li> <li>  खोरन्-न्ती, खोरयन्-न्ती, चुखोरिषन्-न्ती;</li> <li>  -- खोरिष्यन्-न्ती-ती, खोरयिष्यन्-न्ती-ती, चुखोरिषिष्यन्-न्ती-ती;</li> <li>  -- <sup id="ref_krm_0371_04"><a href="#foot_krm_0371_04">4</a></sup> सुखोः-सुखोरौ-सुखोरः;</li> <li>  -- -- -- खोरितम्-तः, खोरितः, चुखोरिषितः, चोखोरितः-तवान्;</li> <li>  खोरः, <sup id="ref_krm_0371_05"><a href="#foot_krm_0371_05">5</a></sup> खोरः, चुखोरिषुः, चोखोरः;</li> <li>  <sup id="ref_krm_0371_06"><a href="#foot_krm_0371_06">6</a></sup> खोरितव्यम्, खोरयितव्यम्, चुखोरिषितव्यम्, चोखोरितव्यम्;</li> <li>  खोरणीयम्, <sup id="ref_krm_0371_07"><a href="#foot_krm_0371_07">7</a></sup> खोरणीयम्, चुखोरिषणीयम्, चोखोरणीयम्;</li> <li>  खोर्यम्, खोर्यम्, चुखोरिष्यम्, चोखोर्यम्;</li> <li>  ईषत्खोरः-दुष्खोरः-सुखोरः;</li> <li>  -- -- -- खोर्यमाणः, खोर्यमाणः, चुखोरिष्यमाणः, चोखोर्यमाणः;</li> <li>  खोरः, <sup id="ref_krm_0371_08"><a href="#foot_krm_0371_08">8</a></sup> खोरः, चुखोरिषः, चोखोरः;</li> <li>  खोरितुम्, खोरयितुम्, चुखोरिषितुम्, चोखोरितुम्;</li> <li>  खोरणम्, खोरणम्, चुखोरिषणम्, चोखोरणम्;</li> <li>  <sup id="ref_krm_0371_09"><a href="#foot_krm_0371_09">9</a></sup> खोरा, खोरणा, चुखोरिषा, चोखोरा;</li> <li>  खोरित्वा, खोरयित्वा, चुखोरिषित्वा, चोखोरित्वा;</li> <li>  सङ्खोर्य, सङ्खोर्य, सञ्चुखोरिष्य, सञ्चोखोर्य;</li> <li>  खोरम् २, खोरित्वा २, खोरम् २, खोरयित्वा २, चुखोरिषम् २, चुखोरिषित्वा २, चोखोरम् २;</li> <li>  चोखोरित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0371_01"><a href="#ref_krm_0371_01">↑</a> (३६३)</li> <li id="foot_krm_0371_02"><a href="#ref_krm_0371_02">↑</a> (१-भ्वादिः-५५२। सक। सेट्। पर।)</li> <li id="foot_krm_0371_03"><a href="#ref_krm_0371_03">↑</a> [[[अ]</li> <li id="foot_krm_0371_04"><a href="#ref_krm_0371_04">↑</a> [[३। ‘खरवसानयोः--’ (८-३-१५) इति विसर्गः।]]</li> <li id="foot_krm_0371_05"><a href="#ref_krm_0371_05">↑</a> [[आ। ‘अखोरघौरत्पतगेन्द्रवाहने स्वसेविनां तित्सरिषां निराडिनम्। क्मरन् मनोदुर्गममभ्रमेचकं बभ्रद्वधूविभ्रमवृष्टिमभ्रितम्।।’ धा। का। १-७१।]]</li> <li id="foot_krm_0371_06"><a href="#ref_krm_0371_06">↑</a> [पृष्ठम्०३६०+ २६]</li> <li id="foot_krm_0371_07"><a href="#ref_krm_0371_07">↑</a> [[१। ‘णेरनिटि’ (६-४-५१) इति णिलोपः।]]</li> <li id="foot_krm_0371_08"><a href="#ref_krm_0371_08">↑</a> [खोडः]</li> <li id="foot_krm_0371_09"><a href="#ref_krm_0371_09">↑</a> [[२। ‘गुरोश्च हलः’ (३-३-१०३) इति अकारप्रत्ययः।]]</li></ul></p>

खोलृ|खोलकः-लिका|चुखोलिषकः-षिका|चोखोलकः-लिका
<ul><li><sup id="ref_krm_0372_01"><a href="#foot_krm_0372_01">1</a></sup> {@“खोलृ गतिप्रतीघाते”@} <sup id="ref_krm_0372_02"><a href="#foot_krm_0372_02">2</a></sup> खोलकः-लिका, खोलकः-लिका, चुखोलिषकः-षिका, चोखोलकः-लिका;</li> <li>  अित्यादीनि <sup id="ref_krm_0372_03"><a href="#foot_krm_0372_03">3</a></sup> खोरृधातुवत् सर्वाण्यपि रूपाणि ज्ञेयानि। </li> <li>लडयोरभेदात् <sup id="ref_krm_0372_04"><a href="#foot_krm_0372_04">4</a></sup> खोडः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0372_01"><a href="#ref_krm_0372_01">↑</a> (३६४)</li> <li id="foot_krm_0372_02"><a href="#ref_krm_0372_02">↑</a> (१-भ्वादिः-५५१। सक। सेट्। पर।)</li> <li id="foot_krm_0372_03"><a href="#ref_krm_0372_03">↑</a> (३६३)</li> <li id="foot_krm_0372_04"><a href="#ref_krm_0372_04">↑</a> [[आ। ‘सुमार्गशेलात् स्खलतां खलात्मनां गलच्छिदार्थं सलितं महीतलम्। दलत्तनुप्रश्वलितान् परान् प्रति प्रश्वल्लिताखोडसुदर्शनायुधम्।।’ धा। का। १-७०।]]</li></ul></p>

ख्या|‘सस्थानत्वम्|ख्यायकः-यिका|ख्यापकः-पिका|चिख्यासकः-सिका|चाख्यायकः-यिका|-|ख्यापयिता-त्री|चिख्यासिता-त्री|चाख्यायिता-त्री|ख्यान्-न्ती-ती|ख्यापयन्-न्ती|चिख्यासन्-न्ती|ख्यास्यन्-न्ती-ती|ख्यापयिष्यन्-न्ती-ती|चिख्यासिष्यन्-न्ती-ती|ख्यापयमानः|ख्यापयिष्यमाणः|चाख्यायमानः|चाख्यायिष्यमाणः|आख्याः-आख्यौ-आख्याः|-ख्यातम्-तः-तवान्|ख्यापितः|चिख्यासितः|चाख्यायितः-तवान्|गोप्रख्यायः|गोसंख्यः|गोख्यः|ख्यायः|गोख्यायो|ख्यापः|आचिख्यासुः|चाख्याः|ख्यातव्यम्|ख्यापयितव्यम्|चिख्यासितव्यम्|चाख्यायितव्यम्|ख्यानीयम्|ख्यापनीयम्|चिख्यासनीयम्|चाख्यायनीयम्|ख्येयम्|ख्याप्यम्|चिख्यास्यम्|चाख्याय्यम्|ईषत्ख्यानः-दुष्ख्यानः-सुख्यानः|ख्यायमानः|ख्याप्यमानः|चिख्यास्यमानः|चाख्याय्यमानः|चिख्यासः|चाख्यायः|ख्यातुम्|ख्यापयितुम्|चिख्यासितुम्|चाख्यायितुम्|ख्यातिः|आख्या|प्रख्यातिः|ख्यापना|चिख्यासा|चाख्याया|प्रख्यानम्|ख्यापनम्|चिख्यासनम्|चाख्यायनम्|ख्यात्वा|ख्यापयित्वा|चिख्यासित्वा|चाख्यायित्वा|आख्याय|आख्याप्य|प्रचिख्यास्य|प्रचाख्याय्य|ख्यायम्|ख्यापम्|चिख्यासम्|चाख्यायम्
<ul><li><sup id="ref_krm_0373_01"><a href="#foot_krm_0373_01">1</a></sup> {@“ख्या प्रकथने”@} <sup id="ref_krm_0373_02"><a href="#foot_krm_0373_02">2</a></sup> “अयं सार्वधातुकमात्रविषयः। </li> <li>‘सस्थानत्वम्;</li> <li>  नमः ख्यात्रे’ <sup id="ref_krm_0373_03"><a href="#foot_krm_0373_03">3</a></sup> इति वार्तिकम्, तद्भाष्यञ्चेह लिङ्गम्। </li> <li>सस्थानः = जिह्नामूलीयः, स नेति ख्याञादेशस्य ख्शादित्वे प्रयोजनमित्यर्थः। </li> <li>‘सम्पूर्वस्य ख्यातेः प्रयोगो न’ इति न्यासकारः।” इति सिद्धान्तकौमुदी। </li> <li>‘असति बाधके प्रमाणानां सामान्ये पक्षपातः’ इति न्यायमाश्रित्य, आर्धधातुकमात्रेऽनभिधानमङ्गी- क्रियते। </li> <li><sup id="ref_krm_0373_04"><a href="#foot_krm_0373_04">4</a></sup> वस्तुतस्तु, ‘न ध्याख्यापॄमूर्च्छिमदाम्’ <sup id="ref_krm_0373_05"><a href="#foot_krm_0373_05">5</a></sup> इति सूत्रे ख्या- ग्रहणेन, आर्धधातुकेऽपि प्रयोगोऽभ्युपगन्तव्यो भवति। </li> <li>अत एव ‘ख्याञादेशे न’ <sup id="ref_krm_0373_06"><a href="#foot_krm_0373_06">6</a></sup> इत्येवोक्तम्। </li> <li>न तु, एतत्साधारण्येन, ‘ख्याशब्दे न’ इति। </li> <li>अतः, आर्धधातुकेऽपि रूपाणि प्रदर्श्यन्ते। </li> <li>धातुरूपप्रकाशिकायामपि, आर्धधातुकविषयेऽपि रूपाण्यस्य धातोः प्रदर्शितानि। </li> <li>‘नमः ख्यात्रे’ <sup id="ref_krm_0373_07"><a href="#foot_krm_0373_07">7</a></sup> इति भाष्यवार्तिकपर्यालोचनया, तृजन्ते परमनभिधानं कल्प्यते। </li> <li><sup id="ref_krm_0373_08"><a href="#foot_krm_0373_08">8</a></sup> ख्यायकः-यिका, <sup id="ref_krm_0373_09"><a href="#foot_krm_0373_09">9</a></sup> ख्यापकः-पिका, चिख्यासकः-सिका, चाख्यायकः-यिका;</li> <li>  -- ख्यापयिता-त्री, चिख्यासिता-त्री, चाख्यायिता-त्री;</li> <li>  <sup id="ref_krm_0373_10"><a href="#foot_krm_0373_10">10</a></sup> ख्यान्-न्ती <sup id="ref_krm_0373_11"><a href="#foot_krm_0373_11">11</a></sup> -ती, ख्यापयन्-न्ती, चिख्यासन्-न्ती;</li> <li>  -- ख्यास्यन्-न्ती-ती, ख्यापयिष्यन्-न्ती-ती, चिख्यासिष्यन्-न्ती-ती;</li> <li>  -- -- ख्यापयमानः, ख्यापयिष्यमाणः, चाख्यायमानः, चाख्यायिष्यमाणः;</li> <li>  आख्याः-आख्यौ-आख्याः;</li> <li>  -- -- <sup id="ref_krm_0373_12"><a href="#foot_krm_0373_12">12</a></sup> ख्यातम्-तः-तवान्, ख्यापितः, चिख्यासितः, चाख्यायितः-तवान्;</li> <li>  <sup id="ref_krm_0373_13"><a href="#foot_krm_0373_13">13</a></sup> गोप्रख्यायः, <sup id="ref_krm_0373_14"><a href="#foot_krm_0373_14">14</a></sup> गोसंख्यः, <sup id="ref_krm_0373_15"><a href="#foot_krm_0373_15">15</a></sup> गोख्यः, <sup id="ref_krm_0373_16"><a href="#foot_krm_0373_16">16</a></sup> ख्यायः, <sup id="ref_krm_0373_17"><a href="#foot_krm_0373_17">17</a></sup> गोख्यायो <sup id="ref_krm_0373_18"><a href="#foot_krm_0373_18">18</a></sup>, ख्यापः, <sup id="ref_krm_0373_19"><a href="#foot_krm_0373_19">19</a></sup> आचिख्यासुः, <sup id="ref_krm_0373_20"><a href="#foot_krm_0373_20">20</a></sup> चाख्याः;</li> <li>  ख्यातव्यम्, ख्यापयितव्यम्, चिख्यासितव्यम्, चाख्यायितव्यम्;</li> <li>  ख्यानीयम्, ख्यापनीयम्, चिख्यासनीयम्, चाख्यायनीयम्;</li> <li>  <sup id="ref_krm_0373_21"><a href="#foot_krm_0373_21">21</a></sup> ख्येयम्, ख्याप्यम्, चिख्यास्यम्, चाख्याय्यम्;</li> <li>  <sup id="ref_krm_0373_22"><a href="#foot_krm_0373_22">22</a></sup> ईषत्ख्यानः-दुष्ख्यानः-सुख्यानः;</li> <li>  -- -- ख्यायमानः, ख्याप्यमानः, चिख्यास्यमानः, चाख्याय्यमानः;</li> <li>  ख्यायः, ख्यापः, चिख्यासः, चाख्यायः;</li> <li>  ख्यातुम्, ख्यापयितुम्, चिख्यासितुम्, चाख्यायितुम्;</li> <li>  ख्यातिः, <sup id="ref_krm_0373_23"><a href="#foot_krm_0373_23">23</a></sup> आख्या, <sup id="ref_krm_0373_24"><a href="#foot_krm_0373_24">24</a></sup> प्रख्यातिः, ख्यापना, चिख्यासा, चाख्याया;</li> <li>  <sup id="ref_krm_0373_25"><a href="#foot_krm_0373_25">25</a></sup> प्रख्यानम्, ख्यापनम्, चिख्यासनम्, चाख्यायनम्;</li> <li>  ख्यात्वा, ख्यापयित्वा;</li> <li>  चिख्यासित्वा, चाख्यायित्वा;</li> <li>  आख्याय, आख्याप्य, प्रचिख्यास्य, प्रचाख्याय्य;</li> <li>  ख्यायम् २, ख्यात्वा २, ख्यापम् २, ख्यापयित्वा २, चिख्यासम् २, चिख्यासित्वा २, चाख्यायम् २;</li> <li>  चाख्यायित्वा २;</li> <li>  <sup id="ref_krm_0373_26"><a href="#foot_krm_0373_26">26</a></sup> इत्यनेन इण्प्रत्यये, डिद्वद्भावे यलोपे च रूपम्। </li> <li>समानशब्दस्य सभावश्च। </li> <li>समानं ख्यायते इति सखा = मित्रम्।]] सखा-सखायौ-सखायः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0373_01"><a href="#ref_krm_0373_01">↑</a> (३६५)</li> <li id="foot_krm_0373_02"><a href="#ref_krm_0373_02">↑</a> (२-अदादिः-१०६०। सक। अनि। पर।)</li> <li id="foot_krm_0373_03"><a href="#ref_krm_0373_03">↑</a> (वा। २-४-५४)</li> <li id="foot_krm_0373_04"><a href="#ref_krm_0373_04">↑</a> [पृष्ठम्०३६१+ २७]</li> <li id="foot_krm_0373_05"><a href="#ref_krm_0373_05">↑</a> (८-२-५७)</li> <li id="foot_krm_0373_06"><a href="#ref_krm_0373_06">↑</a> (वा। ८-३-६)</li> <li id="foot_krm_0373_07"><a href="#ref_krm_0373_07">↑</a> (वा। २-४-५४)</li> <li id="foot_krm_0373_08"><a href="#ref_krm_0373_08">↑</a> [[१। ‘आतो युक् चिण्कृतोः’ (७-३-३३) इति युगागमः। एवं घञि णमुलि च युगागमो ज्ञेयः।]]</li> <li id="foot_krm_0373_09"><a href="#ref_krm_0373_09">↑</a> [[२। ‘अर्तिह्रीव्लीरीक्नूयीक्ष्माय्यातां पुग् णौ’ (७-३-३६) इति पुगागमः। एवं ण्यन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0373_10"><a href="#ref_krm_0373_10">↑</a> [[३। आदादिकत्वात्, ‘अदिप्रभृतिभ्यः शपः’ (२-४-७२) इति शपो लुक्। सवर्ण- दीर्घः। ‘उगिदचाम्--’ (७-१-७०) इति नुम्। स्त्रियाम्, ‘आच्छीनद्योर्नुम्’ (७-१-८०) इति नुम्विकल्पः।]]</li> <li id="foot_krm_0373_11"><a href="#ref_krm_0373_11">↑</a> [[आ। ‘ख्यान्त्यः कथाः प्राणमुदां पतीनां निर्मान्त्य इष्टानि चटून् वचत्यः। नार्यों विदित्वोपगमं मुरारेरासन् गता राजपथं सुमृष्टम्।।’ धा। का। २-५०।]]</li> <li id="foot_krm_0373_12"><a href="#ref_krm_0373_12">↑</a> [[४। ‘न ध्याख्यापॄमूर्च्छिमदाम्’ (८-२-५७) इति निष्ठानत्वनिषेधः।]]</li> <li id="foot_krm_0373_13"><a href="#ref_krm_0373_13">↑</a> [[५। ‘कर्मण्यण्’ (३-२-१) इत्यणि युगागमः।]]</li> <li id="foot_krm_0373_14"><a href="#ref_krm_0373_14">↑</a> [[६। ‘समि ख्यः’ (३-२-७) इति कर्तरि कप्रत्ययः। ‘आतो लोप इटि च’ (६-४-६४) इत्याकारलोपः।]]</li> <li id="foot_krm_0373_15"><a href="#ref_krm_0373_15">↑</a> [[७। ‘आतोऽनुपसर्गे कः’ (३-२-३) इति कर्तरि कः। आकारलोपः।]]</li> <li id="foot_krm_0373_16"><a href="#ref_krm_0373_16">↑</a> [[८। ‘श्याद्व्यधाश्रु--’ (३-१-१४१) इत्यादिना कर्तरि णप्रत्ययः। युगागमः।]]</li> <li id="foot_krm_0373_17"><a href="#ref_krm_0373_17">↑</a> [[९। ‘अण् कर्मणि च’ (३-३-१२) इति भविष्यत्यर्थे क्रियाफलकक्रियायामण्।]]</li> <li id="foot_krm_0373_18"><a href="#ref_krm_0373_18">↑</a> [व्रजति]</li> <li id="foot_krm_0373_19"><a href="#ref_krm_0373_19">↑</a> [पृष्ठम्०३६२+ २४]</li> <li id="foot_krm_0373_20"><a href="#ref_krm_0373_20">↑</a> [[१। ‘यङोऽचि च’ (२-४-७४) इति यङ्O लुकि, सवर्णदीर्घे रुत्वविसर्गौ भवतः।]]</li> <li id="foot_krm_0373_21"><a href="#ref_krm_0373_21">↑</a> [[२। ‘अचो यत्’ (३-१-९७) इति यति, ‘ईद्यति’ (६-४-६५) इति ईकारादेशे, गुणे च रूपम्।]]</li> <li id="foot_krm_0373_22"><a href="#ref_krm_0373_22">↑</a> [[३। ‘आतो युच्’ (३-३-१२८) इत्यनेन, ईषदाद्युपपदेषु खलपवादो युच्।]]</li> <li id="foot_krm_0373_23"><a href="#ref_krm_0373_23">↑</a> [[४। ‘आतश्चोपसर्गे’ (३-३-१०६) इति स्त्रियामङ्।]]</li> <li id="foot_krm_0373_24"><a href="#ref_krm_0373_24">↑</a> [[५। प्रकृष्टा च सा ख्यातिश्च = प्रख्यातिः। तेन, ‘आतश्चोपसर्गे’ (३-३-१०६) इत्यङ् न।]]</li> <li id="foot_krm_0373_25"><a href="#ref_krm_0373_25">↑</a> [[६। ‘लुब्योगाप्रख्यानात्’ (१-२-५४) इति निर्देशात्, ‘कृत्यचः’ (८-४-२९) इति णत्वं न। ‘ख्शाञः शस्य यो वा’ (वा। ८-४-४०) इति वार्तिकादपि णत्वं नेति वक्तुं शक्यम्।]]</li> <li id="foot_krm_0373_26"><a href="#ref_krm_0373_26">↑</a> [[७। ‘समाने ख्यः स चोदात्तः’ [द। उ। १-६५]</li></ul></p>

गज
<ul><li><sup id="ref_krm_0374_01"><a href="#foot_krm_0374_01">1</a></sup> {@“गज शब्दार्थः”@} <sup id="ref_krm_0374_02"><a href="#foot_krm_0374_02">2</a></sup> ‘गज मदने च’ इति श्रीकृष्णलीलाशुकः। </li> <li><sup id="ref_krm_0374_03"><a href="#foot_krm_0374_03">3</a></sup> ‘गर्जेत् गृञ्जेत् गजेत् गञ्जेत् शब्दने गाजयेण्णिचि।।’ <sup id="ref_krm_0374_04"><a href="#foot_krm_0374_04">4</a></sup> इति देवः। </li> <li>‘कख हसने’ <sup id="ref_krm_0374_05"><a href="#foot_krm_0374_05">5</a></sup> इति भौवादिकधातुवत् सर्वाणि रूपाणि ज्ञेयानि। </li> <li><sup id="ref_krm_0374_06"><a href="#foot_krm_0374_06">6</a></sup> गजः-पचाद्यच्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0374_01"><a href="#ref_krm_0374_01">↑</a> (३६६)</li> <li id="foot_krm_0374_02"><a href="#ref_krm_0374_02">↑</a> (१-भ्वादिः-२४६। अक। सेट्। पर।)</li> <li id="foot_krm_0374_03"><a href="#ref_krm_0374_03">↑</a> [पृष्ठम्०३६३+ २६]</li> <li id="foot_krm_0374_04"><a href="#ref_krm_0374_04">↑</a> (श्लो-५९)</li> <li id="foot_krm_0374_05"><a href="#ref_krm_0374_05">↑</a> (१४१)</li> <li id="foot_krm_0374_06"><a href="#ref_krm_0374_06">↑</a> [[आ। ‘जहर्ष जञ्जातुजितस्थलैरसौ वृषैरतुञ्जैर्गजगञ्जिभिर्वृतम्। गर्जत्खरं गृञ्जितधेनुमोमुजद्वत्सोत्करं मुञ्जदजं वजन् व्रजम्।।’ धा। का। १-३३।]]</li></ul></p>

गज
<ul><li><sup id="ref_krm_0375_01"><a href="#foot_krm_0375_01">1</a></sup> {@“गज शब्दार्थः”@} <sup id="ref_krm_0375_02"><a href="#foot_krm_0375_02">2</a></sup> ‘गर्जेत् गृञ्जेत् गजेत् गञ्जेद् शब्दने गाजयेण्णिचि।।’ <sup id="ref_krm_0375_03"><a href="#foot_krm_0375_03">3</a></sup> इति देवः। </li> <li>‘कण निमीलने’ <sup id="ref_krm_0375_04"><a href="#foot_krm_0375_04">4</a></sup> इति चौरादिकधातुवद्बोध्यानि। </li> <li><sup id="ref_krm_0375_05"><a href="#foot_krm_0375_05">5</a></sup> गाजितः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0375_01"><a href="#ref_krm_0375_01">↑</a> (३६७)</li> <li id="foot_krm_0375_02"><a href="#ref_krm_0375_02">↑</a> (१०-चुरादिः-१६४८। अक। सेट्। उभ।)</li> <li id="foot_krm_0375_03"><a href="#ref_krm_0375_03">↑</a> (श्लो-५९)</li> <li id="foot_krm_0375_04"><a href="#ref_krm_0375_04">↑</a> (१५९)</li> <li id="foot_krm_0375_05"><a href="#ref_krm_0375_05">↑</a> [[B। ‘इत्थं सुगाजितमृदङ्गविमार्जनानि संवार्य मर्चयति घारितशङ्कमस्मिन्। कृष्णः प्रपञ्चरहितां धृततेजितास्त्रैः वीरैः स्तुतां गिरमकीर्तदरातिवर्धी।।’ धा। का। ३-२८।]]</li></ul></p>

गजि
<ul><li><sup id="ref_krm_0376_01"><a href="#foot_krm_0376_01">1</a></sup> {@“गजि शब्दार्थः”@} <sup id="ref_krm_0376_02"><a href="#foot_krm_0376_02">2</a></sup> ‘गर्जेत् गृञ्जेत् गजेत् गञ्जेत् शब्दने गाजयेण्णिचि।।’ <sup id="ref_krm_0376_03"><a href="#foot_krm_0376_03">3</a></sup> इति देवः। </li> <li>‘कदि आह्वानरोदनयोः’ <sup id="ref_krm_0376_04"><a href="#foot_krm_0376_04">4</a></sup> इति भौवादिकधातुवत् रूपाण्यूह्यानि। </li> <li>गञ्जा <sup id="ref_krm_0376_05"><a href="#foot_krm_0376_05">5</a></sup>। </li> <li>स्त्रियां ‘गुरोश्च हलः’ <sup id="ref_krm_0376_06"><a href="#foot_krm_0376_06">6</a></sup> इति अकारप्रत्ययः। </li> <li><sup id="ref_krm_0376_07"><a href="#foot_krm_0376_07">7</a></sup> गजगञ्जी <sup id="ref_krm_0376_08"><a href="#foot_krm_0376_08">8</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0376_01"><a href="#ref_krm_0376_01">↑</a> (३६८)</li> <li id="foot_krm_0376_02"><a href="#ref_krm_0376_02">↑</a> (१-भ्वादिः-२४७। सक। सेट्। पर।)</li> <li id="foot_krm_0376_03"><a href="#ref_krm_0376_03">↑</a> (श्लो-५९)</li> <li id="foot_krm_0376_04"><a href="#ref_krm_0376_04">↑</a> (१६३)</li> <li id="foot_krm_0376_05"><a href="#ref_krm_0376_05">↑</a> (मदिरागृहम्)</li> <li id="foot_krm_0376_06"><a href="#ref_krm_0376_06">↑</a> (३-३-१०३)</li> <li id="foot_krm_0376_07"><a href="#ref_krm_0376_07">↑</a> [[C। ‘जहर्ष जञ्जातुजितस्थलैरसौ वृषैरतुञ्जैर्गजगञ्जिभिर्वृतम्। गर्जत्खरं गृञ्जितधेनुमोमुजद्वत्सोत्करं मुञ्जदजं वजन् व्रजम्।।’ धा। का। १-३३।]]</li> <li id="foot_krm_0376_08"><a href="#ref_krm_0376_08">↑</a> [[१। ‘कर्तर्युपमाने’ (३-२-७९) इति णिनिः।]]</li></ul></p>

