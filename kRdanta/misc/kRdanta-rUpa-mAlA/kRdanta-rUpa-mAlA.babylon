अठि
<ul><li><sup id="ref_krm_0013_01"><a href="#foot_krm_0013_01">1</a></sup> {@‘अठि गतौ’@} <sup id="ref_krm_0013_02"><a href="#foot_krm_0013_02">2</a></sup> ‘अकि लक्षणे’ <sup id="ref_krm_0013_03"><a href="#foot_krm_0013_03">3</a></sup> इति धातुवद्रूपाणि ज्ञेयानि। </li> <li>क्विपि अन्-इति रूपम्। </li> <li>संयोगान्तलोपः। </li> <li>न + अन् = <sup id="ref_krm_0013_04"><a href="#foot_krm_0013_04">4</a></sup> अनन्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0013_01"><a href="#ref_krm_0013_01">↑</a> (१४)</li> <li id="foot_krm_0013_02"><a href="#ref_krm_0013_02">↑</a> (१-भ्वादिः-२६१-सक। से-आ।)</li> <li id="foot_krm_0013_03"><a href="#ref_krm_0013_03">↑</a> (२।)</li> <li id="foot_krm_0013_04"><a href="#ref_krm_0013_04">↑</a> [[आ। ‘अनन् कुमार्गेषु शुभाध्वनैव वन् प्रमन् भृशोत्कण्ठितगोपिके हरौ।’ धा। का। १। ३५]]</li></ul></p>

अड
<ul><li><sup id="ref_krm_0014_01"><a href="#foot_krm_0014_01">1</a></sup> {@‘अड उद्यमने’@} <sup id="ref_krm_0014_02"><a href="#foot_krm_0014_02">2</a></sup> शतरि अडन् <sup id="ref_krm_0014_03"><a href="#foot_krm_0014_03">3</a></sup>। </li> <li>अडतीत्यडः = वृश्चिकलाङ्गूलः। </li> <li>विशिष्टोऽडः = व्यडः। </li> <li>तस्यापत्यमत इञ् व्याडिः आचार्यः। </li> <li>संग्रहनामकस्य लक्षग्रन्थपरिमितस्य व्याकरण- शास्त्रस्य कर्ता पाणिनेर्भागिनेयः। </li> <li>स्वागतादित्वात् आदिवृद्धिप्रतिषेधः। </li> <li>इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>अन्यानि सर्वाणि रूपाणि ‘अट गतौ’ <sup id="ref_krm_0014_04"><a href="#foot_krm_0014_04">4</a></sup> इतिवत् बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0014_01"><a href="#ref_krm_0014_01">↑</a> (१५)</li> <li id="foot_krm_0014_02"><a href="#ref_krm_0014_02">↑</a> (१-भ्वादिः-३५८-सक। से। पर।)</li> <li id="foot_krm_0014_03"><a href="#ref_krm_0014_03">↑</a> [[B। ‘प्ररोडकानङ्गविलोलितैर्वृतान् रतावडद्भिः ललनाजनैः खलैः।’ धा। का। १। ४६।]]</li> <li id="foot_krm_0014_04"><a href="#ref_krm_0014_04">↑</a> (११)</li></ul></p>

