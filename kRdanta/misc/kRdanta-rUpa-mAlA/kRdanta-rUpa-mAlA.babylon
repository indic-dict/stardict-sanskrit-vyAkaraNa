<ul><li><sup id="ref_krm_0305_01"><a href="#foot_krm_0305_01">1</a></sup> {@“क्षमू सहने”@} <sup id="ref_krm_0305_02"><a href="#foot_krm_0305_02">2</a></sup> ‘अषितः क्षाम्यति, क्षान्तिः क्षमूषः क्षमते क्षमा’। </li> <li><sup id="ref_krm_0305_03"><a href="#foot_krm_0305_03">3</a></sup> इति देवः। </li> <li>अषित्। </li> <li>शमादिः। </li> <li>मित्। </li> <li><sup id="ref_krm_0305_04"><a href="#foot_krm_0305_04">4</a></sup> क्षमकः-मिका, <sup id="ref_krm_0305_05"><a href="#foot_krm_0305_05">5</a></sup> क्षमकः-मिका, <sup id="ref_krm_0305_06"><a href="#foot_krm_0305_06">6</a></sup> चिक्षमिषकः-षिका, चिक्षंसकः-सिका, चङ्क्षमकः-मिका;</li> <li>  <sup id="ref_krm_0305_07"><a href="#foot_krm_0305_07">7</a></sup> <sup id="ref_krm_0305_08"><a href="#foot_krm_0305_08">8</a></sup> क्षमिता-क्षन्ता-त्री, क्षमयिता-त्री, चिक्षमिषिता-चिक्षंसिता-त्री, चङ्क्षमिता-त्री;</li> <li>  <sup id="ref_krm_0305_09"><a href="#foot_krm_0305_09">9</a></sup> क्षाम्यन्-न्ती, क्षमयन्-न्ती, चिक्षमिषन्-चिक्षंसन्-न्ती;</li> <li>  -- क्षमिष्यन्-क्षंस्यन्-न्ती-ती, क्षमयिष्यन्-न्ती-ती, चिक्षमिषिष्यन्-न्ती-ती, चिक्षंसिष्यन्-न्ती-ती;</li> <li>  <sup id="ref_krm_0305_10"><a href="#foot_krm_0305_10">10</a></sup> व्यतिक्षाम्यमाणः, क्षमयमाणः, -- चङ्क्षम्यमाणः;</li> <li>  व्यतिक्षमिष्यमाणः- व्यतिक्षंस्यमानः, क्षमयिष्यमाणः, चङ्क्षमिष्यमाणः;</li> <li>  <sup id="ref_krm_0305_11"><a href="#foot_krm_0305_11">11</a></sup> विक्षान्-विक्षामौ-विक्षामः;</li> <li>  -- -- <sup id="ref_krm_0305_12"><a href="#foot_krm_0305_12">12</a></sup> <sup id="ref_krm_0305_13"><a href="#foot_krm_0305_13">13</a></sup> क्षान्तम्-न्तः-क्षान्तवान्, क्षमितः, चिक्षमिषितः-चिक्षंसितः, चङ्क्षमितः-तवान्;</li> <li>  क्षमः, <sup id="ref_krm_0305_14"><a href="#foot_krm_0305_14">14</a></sup> क्षमी, <sup id="ref_krm_0305_15"><a href="#foot_krm_0305_15">15</a></sup> द्बन्द्वक्षमा, क्षमः, चिक्षमिषुः-चिक्षंसुः, चङ्क्षमः;</li> <li>  क्षमितव्यम्-क्षन्तव्यम्, क्षमयितव्यम्, चिक्षमिषितव्यम्-चिक्षंसितव्यम्, चङ्क्षमितव्यम्;</li> <li>  क्षमणीयम्, क्षमणीयम्, चिक्षमिषणीयम्-चिक्षंसनीयम्, चङ्क्षमणीयम्;</li> <li>  <sup id="ref_krm_0305_16"><a href="#foot_krm_0305_16">16</a></sup> क्षम्यम् <sup id="ref_krm_0305_17"><a href="#foot_krm_0305_17">17</a></sup>, क्षम्यम्, चिक्षमिष्यम्-चिक्षंस्यम्, चङ्क्षम्यम्;</li> <li>  ईषत्क्षमः-दुःक्षमः-सुक्षमः;</li> <li>  -- -- -- क्षम्यमाणः, क्षम्यमाणः, चिक्षमिष्यमाणः-चिक्षंस्यमानः, चङ्क्षम्यमाणः;</li> <li>  <sup id="ref_krm_0305_18"><a href="#foot_krm_0305_18">18</a></sup> क्षमः, क्षमः, चिक्षमिषः-चिक्षंसः, चङ्क्षमः;</li> <li>  क्षमितुम्-क्षन्तुम्, क्षमयितुम्, चिक्षमिषितुम्-चिक्षंसितुम्, चङ्क्षमितुम्;</li> <li>  <sup id="ref_krm_0305_19"><a href="#foot_krm_0305_19">19</a></sup> क्षान्तिः, क्षमणा, चिक्षमिषा-चिक्षंसा, चङ्क्षमा;</li> <li>  क्षमणम्, क्षमणम्, चिक्षमिषणम्-चिक्षंसनम्, चङ्क्षमणम्;</li> <li>  क्षमित्वा-क्षान्त्वा, क्षमयित्वा, चिक्षमिषित्वा-चिक्षंसित्वा, चङ्क्षमित्वा;</li> <li>  प्रक्षम्य, <sup id="ref_krm_0305_20"><a href="#foot_krm_0305_20">20</a></sup> प्रक्षमय्य, प्रचिक्षमिष्य-प्रचिक्षंस्य, प्रचङ्क्षम्य;</li> <li>  क्षमम् २, क्षमित्वा-क्षान्त्वा २, <sup id="ref_krm_0305_21"><a href="#foot_krm_0305_21">21</a></sup> क्षमम्-क्षामम् २, क्षमयित्वा २, चिक्षमिषम् २ -चिक्षंसम् २, चिक्षमिषित्वा- २, चिक्षंसित्वा २, चङ्क्षमम् २;</li> <li>  चङ्क्षमित्वा २। <sup id="ref_krm_0305_22"><a href="#foot_krm_0305_22">22</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0305_01"><a href="#ref_krm_0305_01">↑</a> (२९८)</li> <li id="foot_krm_0305_02"><a href="#ref_krm_0305_02">↑</a> (४-दिवादिः-१२०६। सक। वेट्। पर।)</li> <li id="foot_krm_0305_03"><a href="#ref_krm_0305_03">↑</a> (श्लो-१४६)</li> <li id="foot_krm_0305_04"><a href="#ref_krm_0305_04">↑</a> [[१। ‘नोदात्तोपदेशस्य मान्तस्यानाचमेः’ (७-३-३४) इति वृद्धिनिषेधः।]]</li> <li id="foot_krm_0305_05"><a href="#ref_krm_0305_05">↑</a> [[२। ‘अत उपधायाः’ (७-२-११६) इति णौ वृद्धिः। तस्य ‘मितां--’ (६-४-९२) इति ह्रस्वः। ‘जनीजॄष्--’ (गणसूत्रं भ्वादौ) इत्यनेन अमन्तत्वेन मित्त्वम्।]]</li> <li id="foot_krm_0305_06"><a href="#ref_krm_0305_06">↑</a> [[३। ‘स्वरतिसूतिसूयतिधूञूदितो 