<ul><li><sup id="ref_krm_0608_01"><a href="#foot_krm_0608_01">1</a></sup> {@“जागृ निद्राक्षये”@} <sup id="ref_krm_0608_02"><a href="#foot_krm_0608_02">2</a></sup> जक्षित्यादिः। </li> <li>घातोरस्यानेकाच्त्वात् ‘धातोरेकाच--’ <sup id="ref_krm_0608_03"><a href="#foot_krm_0608_03">3</a></sup> इति विहितो यङ् न भवति। </li> <li><sup id="ref_krm_0608_04"><a href="#foot_krm_0608_04">4</a></sup> जागरकः-रिका, <sup id="ref_krm_0608_05"><a href="#foot_krm_0608_05">5</a></sup> जागरकः-रिकाः, <sup id="ref_krm_0608_06"><a href="#foot_krm_0608_06">6</a></sup> जिजागरिषकः-षिका;</li> <li>  -- <sup id="ref_krm_0608_07"><a href="#foot_krm_0608_07">7</a></sup> जागरिता-त्री, जागरयिता-त्री, जिजागरिषिता-त्री;</li> <li>  <sup id="ref_krm_0608_08"><a href="#foot_krm_0608_08">8</a></sup> जाग्रत् <sup id="ref_krm_0608_09"><a href="#foot_krm_0608_09">9</a></sup> -ती, <sup id="ref_krm_0608_10"><a href="#foot_krm_0608_10">10</a></sup> जागरयन्-न्ती, जिजागरिषन्-न्ती;</li> <li>  <sup id="ref_krm_0608_11"><a href="#foot_krm_0608_11">11</a></sup> जागरिष्यन्-न्ती-ती, जागरयिष्यन्-न्ती-ती, जिजागरिषिष्यन्-न्ती-ती;</li> <li>  <sup id="ref_krm_0608_12"><a href="#foot_krm_0608_12">12</a></sup> जागः-जागरौ-जागरः, जागृत्-जागृतौ-जागृतः;</li> <li>  जागरितम्-तः, जागरितः, जिजागरिषितः-तवान्;</li> <li>  जागरः, <sup id="ref_krm_0608_13"><a href="#foot_krm_0608_13">13</a></sup> साधुजागरी, <sup id="ref_krm_0608_14"><a href="#foot_krm_0608_14">14</a></sup> जागरूकः <sup id="ref_krm_0608_15"><a href="#foot_krm_0608_15">15</a></sup>, <sup id="ref_krm_0608_16"><a href="#foot_krm_0608_16">16</a></sup> जजागर्वान्-जजागृवान्, <sup id="ref_krm_0608_17"><a href="#foot_krm_0608_17">17</a></sup> जजाग्राणः, जजागरणः, जिजागरिषुः;</li> <li>  जागरितव्यम्, जागरयितव्यम्, जिजागरिषितव्यम्;</li> <li>  जागरणीयम्, जागरणीयम्, जिजागरिषणीयम्;</li> <li>  <sup id="ref_krm_0608_18"><a href="#foot_krm_0608_18">18</a></sup> जागर्यम्, जागर्यम्, जिजागरिष्यम्;</li> <li>  ईषज्जागरः-दुर्जागरः-सुजागरः;</li> <li>  -- <sup id="ref_krm_0608_19"><a href="#foot_krm_0608_19">19</a></sup> जागर्यमाणः, जागर्यमाणः, जिजागरिष्यमाणः;</li> <li>  <sup id="ref_krm_0608_20"><a href="#foot_krm_0608_20">20</a></sup> जागरः, जागरः, जिजागरिषः;</li> <li>  जागरितुम्, जागरयितुम्, जिजागरिषितुम्;</li> <li>  जागरणम्, जागरणम्, जिजागरिषणम्;</li> <li>  <sup id="ref_krm_0608_21"><a href="#foot_krm_0608_21">21</a></sup> जागर्या-जागरा, जागरणा, जिजागरिषा;</li> <li>  जागरित्वा, जागरयित्वा, जिजागरिषित्वा;</li> <li>  सञ्जागर्य, <sup id="ref_krm_0608_22"><a href="#foot_krm_0608_22">22</a></sup> सञ्जागरय्य, सञ्जिजागरिष्य;</li> <li>  जागरम् २, जागरित्वा २, जागरम् २, जागरयित्वा २, जिजागरिषम् २;</li> <li>  जिजागरिषित्वा २;</li> <li>  <sup id="ref_krm_0608_23"><a href="#foot_krm_0608_23">23</a></sup> इति क्विन्प्तत्ययः। </li> <li>जागर्तीति जागृविः = अग्निः, राजा च। </li> <li>अत्र क्विनि इकारः प्रयोगघटकः। </li> <li>न तु उच्चारणार्थः।]] जागृविः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0608_01"><a href="#ref_krm_0608_01">↑</a> (५९८)</li> <li id="foot_krm_0608_02"><a href="#ref_krm_0608_02">↑</a> (२-अदादिः-१०७२। अक। सेट्। पर।)</li> <li id="foot_krm_0608_03"><a href="#ref_krm_0608_03">↑</a> (३-१-२२)</li> <li id="foot_krm_0608_04"><a href="#ref_krm_0608_04">↑</a> [[१। ‘जाग्रोऽविचिण्णल्ङित्सु’ (७-३-८५) इति वृद्ध्यपवादो गुणः। एवं घञन्ते णमुलन्ते च गुण एव।]]</li> <li id="foot_krm_0608_05"><a href="#ref_krm_0608_05">↑</a> [[२। वृद्ध्यपवादे ‘जाग्रोऽवि--’ (७-३-८५) इति गुणे कृते, ‘अत उपधायाः’ (७-२-११६) इति वृद्धिरपि न भवति;\n\n  गुणविधानसामर्थ्यात्। अत एव चिण्णल्प्रतिषेधः सार्थकः। एवं ण्यन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0608_06"><a href="#ref_krm_0608_06">↑</a> [[३। ‘इको झल्’ (१-२-९) इति सनः कित्त्वेऽपि, ‘जाग्रोऽविचिण्--’ (७-३-८५) इति प्रतिषेधविषयत्वाद् गुणो भवति। एवं सन्नन्ते सर्वत्र बोध्यम्।]]</li> <li id="foot_krm_0608_07"><a href="#ref_krm_0608_07">↑</a> [[४। अस्य धातोरुदात्तत्वात् ‘आर्धधातुकस्येड् वलादेः’ (७-२-३५) इतीडागमः। एवं तव्यदादिष्वपि ज्ञेयम्।]]</li> <li id="foot_krm_0608_08"><a href="#ref_krm_0608_08">↑</a> [[५। शतरि, ‘अदिप्रभृतिभ्यः शपः’ (२-४-७२) इति शपो विकरणप्रत्ययस्य लुका अपहारे, शतुः ङित्त्वेन गुणाभावे, ‘इको यणचि’ (६-१-७७) इति यणि, ‘नाभ्यस्ताच्छतुः’ (७-१-७८) इति नुमभावे च रूपम्। ‘जक्षित्यादयः षट्’ (६-१-६) इत्यभ्यस्तसंज्ञा भवति।]]</li> <li id="foot_krm_0608_09"><a href="#ref_krm_0608_09">↑</a> [[आ। ‘तं जाग्रतं दीनदरिद्रपोषे चकासतं शासतमप्रशान्तान्।’ धा। का। २५। २।]]</li> <li id="foot_krm_0608_10"><a href="#ref_krm_0608_10">↑</a> [[६। ण्यन्तात्, ‘अणावकर्मकात् चित्तवत्कर्तृकात्’ (१-३-८८) इति नित्यं परस्मैपदमेव तेन शानज् न।]]</li> <li id="foot_krm_0608_11"><a href="#ref_krm_0608_11">↑</a> [पृष्ठम्०५६५+ २७]</li> <li id="foot_krm_0608_12"><a href="#ref_krm_0608_12">↑</a> [[१। क्विपि, ‘जाग्रोऽविचिण्णल्ङित्सु’ (७-३-८५) इत्यत्र ‘वि’ शब्देन, औणादिक- क्विन्प्रत्ययस्यैव ग्रहणमिति पक्षेऽत्र गुणो भवत्येव। तदानीं गुणे, विसर्गे च ‘जागः’ इति रूपम्। ‘वि’ शब्दघटकेकारस्योच्चारणार्थत्वेन वकारादिप्रत्यये गुणनिषेधो यदीष्यते--तदानीं प्रकृते गुणाभावे, ‘ह्रस्वस्य पिति कृति--’ (६-१-७१) इति तुगागमे जागृत् इति रूपम्। न च ‘वर्णाश्रये नास्ति प्रत्ययलक्षणम्’ (परिभाषा-२१) इति प्रत्ययलक्षणनिषेधः शङ्क्यः;\n\n  तस्य वर्णप्राधान्यविषयत्वात्, अत्र च ‘अतृणेट्’ इत्यत्रेव प्रत्ययप्राधान्यात्। ‘एवं क्विप्यपि वादित्वात् अगुणे ह्रस्वतस्तुकि। जागृत् स्यात्;\n\n  गुणपक्षे तु रेफान्तं जागरित्यपि।।’ इति प्र। स।]]</li> <li id="foot_krm_0608_13"><a href="#ref_krm_0608_13">↑</a> [[२। ‘साधुकारिण्युपसंख्यानम्’ (वा। ३-२-७८) इति णिनिः, गुणः।]]</li> <li id="foot_krm_0608_14"><a href="#ref_krm_0608_14">↑</a> [[३। ‘जागुरूकः’ (३-२-१६५) इति तच्छीलादिषु कर्तृषु ऊकप्रत्ययः।]]</li> <li id="foot_krm_0608_15"><a href="#ref_krm_0608_15">↑</a> [[आ। ‘पथिकोऽपररात्रजागरूकः प्रबभाषे गिरमीदृशीं प्रसङ्गात्।।’ चम्पूभारते २। ५६।]]</li> <li id="foot_krm_0608_16"><a href="#ref_krm_0608_16">↑</a> [[४। छान्दसोऽपि क्वसुः क्वचिद्भाषायामिति पक्षे, अस्माद्धातोः लिडादेशे क्वसुप्रत्यये द्वित्वे, ‘नेड् वशि कृति’ (७-२-८) इतीण्णिषेधे, ‘जाग्रोऽवि--’ (७-३-८५ इत्यत्र क्विन् एव ग्रहणमित्यभ्युपगमे जजागर्वान् इति रूपम्। वकारादिप्रत्यये गुणनिषेधपक्षे जजागृवान् इति रूपम्।]]</li> <li id="foot_krm_0608_17"><a href="#ref_krm_0608_17">↑</a> [[५। ‘लिटः कानज् वा’ (३-२-१०६) इति कानच्। प्रयोगाल्लोकेऽपीति प्र। कौमुदी ‘जाग्रः कानचि गुणो वा’ इति केचित्।’ इति च। तेन रूपद्वयम्।]]</li> <li id="foot_krm_0608_18"><a href="#ref_krm_0608_18">↑</a> [[६। ‘ऋहलोर्ण्यत्’ (३-१-१२४) इति ण्यति गुणे रूपम्।]]</li> <li id="foot_krm_0608_19"><a href="#ref_krm_0608_19">↑</a> [[७। ‘जाग्रोऽवि--’ (७-३-८५) इति विहितो गुणः ‘रिङ् शयग्लिङ्क्षु’ (७-४-२८) इति प्राप्तं रिङादेशं पूर्वविप्रतिषेधाद् बाधते।]]</li> <li id="foot_krm_0608_20"><a href="#ref_krm_0608_20">↑</a> [पृष्ठम्०५६६+ २७]</li> <li id="foot_krm_0608_21"><a href="#ref_krm_0608_21">↑</a> [[१। ‘जागर्तेरकारो वा’ (वा। ३-३-१००) इति स्त्रियां भावादौ क्तिन्नपवादः शप्रत्ययः। शस्य सार्वधातुकत्वात् ‘सार्वधातुके यक्’ (३-१-६७) इति यकि, पूर्वविप्रतिषेधेन रिङादेशं बाधित्वा गुणे अदन्तत्वेन टापि रूपम्। पक्षे, अकार- प्रत्यये टापि जागरा इति रूपम्। ‘स्त्रियां क्तिन्’ (३-३-९४) इति क्तिन् तु ‘अनेकाज्भ्यो धातुभ्यो न’ इति ‘आद्यन्तवदेकस्मिन्’ (१-१-२१) इत्यत्र कैयटे स्पष्टम्।]]</li> <li id="foot_krm_0608_22"><a href="#ref_krm_0608_22">↑</a> [[२। ण्यन्ताल्ल्यपि गुणे ‘ल्यपि लघुपूर्वात्’ (६-४-५६) इति णेरयादेशः।]]</li> <li id="foot_krm_0608_23"><a href="#ref_krm_0608_23">↑</a> [[३। ‘जॄशॄस्तॄजागृभ्यः क्विन्’ [द। उ। १-२४]</li></ul></p>

जि|अुत्कर्षप्राप्तिराद्योऽर्थो|द्वितीयेऽर्थे|सकर्मकः।’इति|देवःजायकः-यिका|जापकः-पिका|जिगीषकः|जेजीयकः-यिका|जेता-त्री|जापयिता-त्री|जिगीषिता-त्री|जेजीयिता-त्री|जयन्-न्ती|जापयन्-न्ती|जिगीषन्-न्ती|-|जेष्यन्-न्ती-ती|जापयिष्यन्-न्ती-ती|जिगीषिष्यन्-न्ती-ती|-विजयमानः-पराजयमानः|जापयमानः|विजिगीषमाणः|पराजिगीषमाणः|जेजीयमानः|विजेष्यमाणः-पराजेष्यमाणः|जापयिष्यमाणः|विजिगीषिष्यमाणः|जेजीयिष्यमाणः|इन्द्रजित्|प्रजित्|अभिजित्|शत्रुजित्-जिद्-जितौ-जितः|जितम्-तः-जितवान्|जापितः|जिगीषितः|जेजीयितः-तवान्|जयः|जित्वरः|जित्वा-जित्वानौ-जित्वानः|कंसजित्वा|जित्वरी|जिष्णुः|धनञ्जयः|समितिञ्जयः|जयी|जयिनी|जयकः|जयमानः|जापः|जिगीषुः|विजिगीषुः|जेज्यः|जेतव्यम्|जापयितव्यम्|जिगीषितव्यम्|जेजीयितव्यम्|जयनीयम्|जापनीयम्|जिगीषणीयम्|जेजीयनीयम्|जय्यम्-जेयम्|जित्यः|जाप्यम्|जिगीष्यम्|जेजीय्यम्|सखैः|पृषत्कैः|ईषज्जयः|स्फुटमनेन|दशाननोऽपि।।’|अतर्घराघवे।।]]|ईषज्जयः-दुर्जयः-सुजयः|-जीयमानः|जाप्यमानः|जिगीष्यमाणः|जेजीय्यमानः|जिगीषः|जेजीयः|जेतुम्|जापयितुम्|जिगीषितुम्|जेजीयितुम्|जितिः|जापना|विजिगीषा|जेजीया|जयनम्|उज्जयिनी|जायनम्|जिगीषणम्|जेजीयनम्|जित्वा|जापयित्वा|जिगीषित्वा|जेजीयित्वा|विजित्य|विजाप्य|विजिगीष्य|विजेजीय्य|जायम्जित्वा|जापम्|जिगीषम्|जेजीयम्
<ul><li><sup id="ref_krm_0609_01"><a href="#foot_krm_0609_01">1</a></sup> {@“जि जये”@} <sup id="ref_krm_0609_02"><a href="#foot_krm_0609_02">2</a></sup> जयः = उत्कर्षप्राप्तिः, अभिभवश्च। </li> <li>आद्ये अकर्मकः, द्वितीये सकर्मकः। </li> <li>‘जयेज्जयाभिभवयोराद्येऽर्थेऽसावकर्मकः।। </li> <li>अुत्कर्षप्राप्तिराद्योऽर्थो द्वितीयेऽर्थे सकर्मकः।’ <sup id="ref_krm_0609_03"><a href="#foot_krm_0609_03">3</a></sup> इति देवः <sup id="ref_krm_0609_04"><a href="#foot_krm_0609_04">4</a></sup> जायकः-यिका, <sup id="ref_krm_0609_05"><a href="#foot_krm_0609_05">5</a></sup> जापकः-पिका, <sup id="ref_krm_0609_06"><a href="#foot_krm_0609_06">6</a></sup> जिगीषकः, <sup id="ref_krm_0609_07"><a href="#foot_krm_0609_07">7</a></sup> जेजीयकः-यिका;</li> <li>  <sup id="ref_krm_0609_08"><a href="#foot_krm_0609_08">8</a></sup> जेता <sup id="ref_krm_0609_09"><a href="#foot_krm_0609_09">9</a></sup> -त्री, जापयिता-त्री, जिगीषिता-त्री, जेजीयिता-त्री;</li> <li>  <sup id="ref_krm_0609_10"><a href="#foot_krm_0609_10">10</a></sup> जयन्-न्ती, जापयन्-न्ती, जिगीषन्-न्ती;</li> <li>  -- जेष्यन्-न्ती-ती, जापयिष्यन्-न्ती-ती, जिगीषिष्यन्-न्ती-ती;</li> <li>  -- <sup id="ref_krm_0609_11"><a href="#foot_krm_0609_11">11</a></sup> विजयमानः- <sup id="ref_krm_0609_12"><a href="#foot_krm_0609_12">12</a></sup> पराजयमानः, <sup id="ref_krm_0609_13"><a href="#foot_krm_0609_13">13</a></sup> जापयमानः, विजिगीषमाणः, <sup id="ref_krm_0609_14"><a href="#foot_krm_0609_14">14</a></sup>, पराजिगीषमाणः, जेजीयमानः;</li> <li>  विजेष्यमाणः-पराजेष्यमाणः, जापयिष्यमाणः, वि<sup id="ref_krm_0609_15"><a href="#foot_krm_0609_15">15</a></sup>जिगीषिष्यमाणः, जेजीयिष्यमाणः;</li> <li>  <sup id="ref_krm_0609_16"><a href="#foot_krm_0609_16">16</a></sup> इन्द्रजित् <sup id="ref_krm_0609_17"><a href="#foot_krm_0609_17">17</a></sup>, प्रजित्, अभिजित्, शत्रुजित्-जिद्-जितौ-जितः;</li> <li>  जितम्-तः-जितवान् <sup id="ref_krm_0609_18"><a href="#foot_krm_0609_18">18</a></sup>, जापितः, जिगीषितः, जेजीयितः-तवान्;</li> <li>  जयः, <sup id="ref_krm_0609_19"><a href="#foot_krm_0609_19">19</a></sup> जित्वरः, <sup id="ref_krm_0609_20"><a href="#foot_krm_0609_20">20</a></sup> <sup id="ref_krm_0609_21"><a href="#foot_krm_0609_21">21</a></sup> जित्वा-जित्वानौ-जित्वानः, कंसजित्वा, जित्वरी, <sup id="ref_krm_0609_22"><a href="#foot_krm_0609_22">22</a></sup> <sup id="ref_krm_0609_23"><a href="#foot_krm_0609_23">23</a></sup> जिष्णुः, <sup id="ref_krm_0609_24"><a href="#foot_krm_0609_24">24</a></sup> <sup id="ref_krm_0609_25"><a href="#foot_krm_0609_25">25</a></sup> धनञ्जयः, समितिञ्जयः, <sup id="ref_krm_0609_26"><a href="#foot_krm_0609_26">26</a></sup> जयी, <sup id="ref_krm_0609_27"><a href="#foot_krm_0609_27">27</a></sup> जयिनी, <sup id="ref_krm_0609_28"><a href="#foot_krm_0609_28">28</a></sup> जयकः;</li> <li>  <sup id="ref_krm_0609_29"><a href="#foot_krm_0609_29">29</a></sup> जयमानः, जापः, जिगीषुः, विजिगीषुः, <sup id="ref_krm_0609_30"><a href="#foot_krm_0609_30">30</a></sup> जेज्यः;</li> <li>  जेतव्यम्, जापयितव्यम्, जिगीषितव्यम्, जेजीयितव्यम्;</li> <li>  जयनीयम्, जापनीयम्, जिगीषणीयम्, जेजीयनीयम्;</li> <li>  <sup id="ref_krm_0609_31"><a href="#foot_krm_0609_31">31</a></sup> जय्यम्-जेयम् <sup id="ref_krm_0609_32"><a href="#foot_krm_0609_32">32</a></sup>, जित्यः <sup id="ref_krm_0609_33"><a href="#foot_krm_0609_33">33</a></sup> <sup id="ref_krm_0609_34"><a href="#foot_krm_0609_34">34</a></sup>, जाप्यम्, जिगीष्यम्, जेजीय्यम्;</li> <li>  <sup id="ref_krm_0609_35"><a href="#foot_krm_0609_35">35</a></sup> सखैः पृषत्कैः ईषज्जयः स्फुटमनेन दशाननोऽपि।।’ अतर्घराघवे ३। ३३।]] ईषज्जयः-दुर्जयः-सुजयः;</li> <li>  -- -- -- <sup id="ref_krm_0609_36"><a href="#foot_krm_0609_36">36</a></sup> जीयमानः, जाप्यमानः, जिगीष्यमाणः, जेजीय्यमानः;</li> <li>  <sup id="ref_krm_0609_37"><a href="#foot_krm_0609_37">37</a></sup> जयः, जापः, जिगीषः, जेजीयः;</li> <li>  जेतुम्, जापयितुम्, जिगीषितुम्, जेजीयितुम्;</li> <li>  जितिः, जापना, विजिगीषा, जेजीया;</li> <li>  जयनम्, <sup id="ref_krm_0609_38"><a href="#foot_krm_0609_38">38</a></sup> उज्जयिनी, जायनम्, जिगीषणम्, जेजीयनम्;</li> <li>  जित्वा, जापयित्वा, जिगीषित्वा, जेजीयित्वा;</li> <li>  <sup id="ref_krm_0609_39"><a href="#foot_krm_0609_39">39</a></sup> विजित्य, विजाप्य, विजिगीष्य, विजेजीय्य;</li> <li>  जायम् २ जित्वा २, जापम् २, जापयित्वा २, जिगीषम् २, जिगीषित्वा २, जेजीयम् २;</li> <li>  जेजीयित्वा २;</li> <li>  <sup id="ref_krm_0609_40"><a href="#foot_krm_0609_40">40</a></sup> जैत्रम्, <sup id="ref_krm_0609_41"><a href="#foot_krm_0609_41">41</a></sup> इति उण्प्रत्यये वृद्धौ, आयादेशे जायुः। </li> <li>जयति अनेन रोगानिति जायुः = औषधम्।]] जायुः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0609_01"><a href="#ref_krm_0609_01">↑</a> (५९९)</li> <li id="foot_krm_0609_02"><a href="#ref_krm_0609_02">↑</a> (१-भ्वादिः-५६१। अक। अनि। पर।)</li> <li id="foot_krm_0609_03"><a href="#ref_krm_0609_03">↑</a> (श्लो। १३-१४)</li> <li id="foot_krm_0609_04"><a href="#ref_krm_0609_04">↑</a> [[४। ‘अचो ञ्णिति’ (७-२-११५) इति वृद्धौ, आयादेशे च रूपम्। एवं णमुल्यपि।]]</li> <li id="foot_krm_0609_05"><a href="#ref_krm_0609_05">↑</a> [[५। ण्यन्ते ‘क्रीङ्जीनां णौ’ (६-१-४८) इत्यात्वे, ‘अर्तिह्रीव्लीरीक्नूयीक्ष्माय्यातां पुग् णौ’ (७-३-३६) इति पुगागमे रूपम्। एवं ण्यन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0609_06"><a href="#ref_krm_0609_06">↑</a> [[६। ‘सन्लिटोर्जेः’ (७-३-५७) इत्यभ्यासादुत्तरस्य कुत्वेन गकारः। ‘इको झल्’ (१-२-९) इति सनः कित्त्वनिषेधाद् गुणो न। एवं सन्नन्ते सर्वंत्र ज्ञेयम्।]]</li> <li id="foot_krm_0609_07"><a href="#ref_krm_0609_07">↑</a> [[७। यङि, ‘अकृत्सार्वधातुकयोः--’ (७-४-२५) इति दीर्घः। एवं यङन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0609_08"><a href="#ref_krm_0609_08">↑</a> [पृष्ठम्०५६७+ २२]</li> <li id="foot_krm_0609_09"><a href="#ref_krm_0609_09">↑</a> [[आ। ‘जेता यज्ञद्रुहां संख्ये धर्मसन्तानसूर्वने।’ भ। का। ४। २७।]]</li> <li id="foot_krm_0609_10"><a href="#ref_krm_0609_10">↑</a> [[B। ‘सञ्चारनिष्ठ्यूतनखेन्दुचन्द्रिकं लोके जयन्तं सकलैकजीवनम्।’ धा। का। १। ७२।]]</li> <li id="foot_krm_0609_11"><a href="#ref_krm_0609_11">↑</a> [[१। ‘विपराभ्यां जेः’ (१-३-१९) इति शानच्।]]</li> <li id="foot_krm_0609_12"><a href="#ref_krm_0609_12">↑</a> [[C। ‘खं पराजयमानोऽसावुन्नत्या पवनात्मजम्।’ भ। का। ८। ९।]]</li> <li id="foot_krm_0609_13"><a href="#ref_krm_0609_13">↑</a> [[२। धातोरकर्मकत्वे ‘अणावकर्मकात् चित्तवत्कर्तृकात्’ (१-३-८८) इति ण्यन्तात् परस्मै- पदमेव। सकर्मकत्वे तु ण्यन्ताच्छानजपि भवतीति ज्ञेयम्।]]</li> <li id="foot_krm_0609_14"><a href="#ref_krm_0609_14">↑</a> [[३। ‘पूर्ववत् सनः’ (१-३-६२) इति विपरापूर्वकत्वे सन्नन्तात् शानच्।]]</li> <li id="foot_krm_0609_15"><a href="#ref_krm_0609_15">↑</a> [परा]</li> <li id="foot_krm_0609_16"><a href="#ref_krm_0609_16">↑</a> [[४। ‘सत्सूद्विषद्रुहदुहयुजविदभिदच्छिदजिनीराजामुपसर्गेऽपि क्विप्’ (३-२-६१) इति उपसर्गे, अनुपसर्गे वा उपपदे क्विप्।]]</li> <li id="foot_krm_0609_17"><a href="#ref_krm_0609_17">↑</a> [[ड्। ‘इन्द्रजित्सूर्विनाशाय मारुतेः क्रोधमूर्च्छितः।।’ भ। का। ९। ३।]]</li> <li id="foot_krm_0609_18"><a href="#ref_krm_0609_18">↑</a> [[E। ‘यातयामं विजितवान् स रामं यदि किं ततः।।’ भ। का। ५-३९।]]</li> <li id="foot_krm_0609_19"><a href="#ref_krm_0609_19">↑</a> [[५। ‘इण्नशिजिसर्तिभ्यः क्वरप्’ (३-२-१६३) इति तच्छीलादिषु कर्तृषु क्वरप्। ‘ह्रस्वस्य पिति--’ (६-१-७१) इति तुक्।]]</li> <li id="foot_krm_0609_20"><a href="#ref_krm_0609_20">↑</a> [[F। ‘हस्तेकरिष्यति जगत्त्रयजित्वरोऽपि कस्तादृशीं दुहितरं जनकेश्वरस्य।’ अनर्धराघघे ३। ८।]]</li> <li id="foot_krm_0609_21"><a href="#ref_krm_0609_21">↑</a> [[६। ‘अन्येभ्योऽपि दृश्यन्ते’ (३-२-७५) इति क्वनिपि तुक्। कंसं जयति, जितवान् वा कंसजित्वा। स्त्रियां ‘वनो र च’ (४-१-७) इति ङीप् रेफश्च।]]</li> <li id="foot_krm_0609_22"><a href="#ref_krm_0609_22">↑</a> [पृष्ठम्०५६८+ २८]</li> <li id="foot_krm_0609_23"><a href="#ref_krm_0609_23">↑</a> [[१। ‘ग्लाजिस्थश्च रस्नुः’ (३-२-१३९) इति तच्छीलादिषु कर्तृषु ग्स्नुः प्रत्ययः। ‘ग्क्ङिति च’ (१-१-५) इत्यत्र गकारस्यापि प्रश्लेषात् गुणो न भवति। ‘आदेशप्रत्यययोः’ (८-३-५९) इति षत्वम्।]]</li> <li id="foot_krm_0609_24"><a href="#ref_krm_0609_24">↑</a> [[आ। ‘वसन् माल्यवति ग्लास्नू रामो जिष्णुरधृष्णुवत्।।’ भ। का। ७। ४।]]</li> <li id="foot_krm_0609_25"><a href="#ref_krm_0609_25">↑</a> [[२। ‘संज्ञायां मृतॄवृजिधारिसहितपिदमः’ (३-२-४६) इति संज्ञायां खच्- प्रत्यये, ‘खित्यनव्ययस्य’ (६-३-६६) इति पूर्वपदस्य मुमागमः। ‘विश्वंभरा, साम रथन्तराख्यं, पतिंवरा चापि, धनञ्जयश्च। शत्रुंसहः कोऽपि, वसुन्धरा च, शत्रुन्तपोऽरिन्दम एवमूह्यम्।।’ इति प्रक्रियासर्वस्वे, ‘संज्ञायां भृ--’ (३-२-४६) इति सूत्रस्य क्रमेणोदाहरणानि प्रदर्शितानि।]]</li> <li id="foot_krm_0609_26"><a href="#ref_krm_0609_26">↑</a> [[३। ‘जिदृक्षिविश्रीण्--’ (३-२-१५७) इति तच्छीलादिषु कर्तृषु इनिप्रत्ययः।]]</li> <li id="foot_krm_0609_27"><a href="#ref_krm_0609_27">↑</a> [[B। ‘वीतप्रभावतनुरप्यतनुप्रभावः प्रत्याचकाङूश्र जयिनीं भुजवीर्यलक्ष्मीम्। अस्त्रेषु भूतपतिनापहृतेषु जिष्णुर्वर्षिष्यता दिनकृतेव जलेषु लोकः।।’ किरातार्जुनीये १६। ६४।]]</li> <li id="foot_krm_0609_28"><a href="#ref_krm_0609_28">↑</a> [[४। ‘आशिषि च’ (३-१-१५०) इति वुन्। जयतात् जयकः।]]</li> <li id="foot_krm_0609_29"><a href="#ref_krm_0609_29">↑</a> [[५। ‘ताच्छील्यवयोवचनशक्तिषु चानश्’ (३-२-१२९) इति शक्तौ गम्यमानायां चानश्। मध्ये विकरणप्रत्ययः शप्। ‘सहैव चरमाणौ द्वौ वहमानौ मितं धनुः। जयमानौ च रक्षांसि राघवौ मुनिमन्वितौ।।’ इति प्र। सर्वस्वे।]]</li> <li id="foot_krm_0609_30"><a href="#ref_krm_0609_30">↑</a> [[C। ‘विजिगीषुः पुनश्चक्रे व्यूहं दुर्जयमिन्द्रजित्।।’ भ। का। ९। ७०।]]</li> <li id="foot_krm_0609_31"><a href="#ref_krm_0609_31">↑</a> [[६। ‘अचो यत्’ (३-१-९७) इति यति गुणे, ‘क्षय्यजय्यौ शक्यार्थे’ (६-१-८१) इति अयादेशो मिपातितः। जेतुं शक्यम् = जय्यम्। अन्यत्र जेयम्।]]</li> <li id="foot_krm_0609_32"><a href="#ref_krm_0609_32">↑</a> [[ड्। ‘आत्मानं वनवासं च जेयं चारिं रघूत्तमः।।’ भ। का। ६। ४७।]]</li> <li id="foot_krm_0609_33"><a href="#ref_krm_0609_33">↑</a> [[७। ‘विपूयविनीयजित्या मुञ्जकल्कहलिषु’ (३-१-११७) इति सूत्रेण हलौ = कृष्टसमी- करणार्थे स्थूलकाष्ठे वाच्ये क्यप् भवति। जित्यो हलिः = बलेन क्रष्टव्य इत्यर्थः।]]</li> <li id="foot_krm_0609_34"><a href="#ref_krm_0609_34">↑</a> [हलिः]</li> <li id="foot_krm_0609_35"><a href="#ref_krm_0609_35">↑</a> [[E। ‘यस्ताटकामकृत बाल [काल]</li> <li id="foot_krm_0609_36"><a href="#ref_krm_0609_36">↑</a> [पृष्ठम्०५६९+ २३]</li> <li id="foot_krm_0609_37"><a href="#ref_krm_0609_37">↑</a> [[१। ‘एरच्’ (३-३-५६) इति भावादौ अप्। घञपवादः।]]</li> <li id="foot_krm_0609_38"><a href="#ref_krm_0609_38">↑</a> [[२। उज्जयन्ति अस्यां वसन्तः इति उज्जयिनी। ‘करणाधिकरणयोश्च’ (३-३-११७) इति ल्युट्। स्त्रियां टित्त्वान्ङीपि उज्जयिनी इति भवति। उज्जयिनी-- नगरविशेषः।]]</li> <li id="foot_krm_0609_39"><a href="#ref_krm_0609_39">↑</a> [[३। ल्यपि ‘ह्रस्वस्य--’ (६-१-७१) इति तुक्।]]</li> <li id="foot_krm_0609_40"><a href="#ref_krm_0609_40">↑</a> [[४। ‘उणादयो बहुलम्’ (३-३-१) इति त्रण्प्रत्ययः। ‘अचो ञ्णिति’ (७-२-११५) इति वृद्धिः।]]</li> <li id="foot_krm_0609_41"><a href="#ref_krm_0609_41">↑</a> [[५। ‘कृवापाजिमि--’ [द। उ। १-८६]</li></ul></p>

जि|जायकः-यिका|जापकः-पिका|जिगीषकः-षिका|जेजीयकः-यिकाः
<ul><li><sup id="ref_krm_0610_01"><a href="#foot_krm_0610_01">1</a></sup> {@“जि अभिभवे”@} <sup id="ref_krm_0610_02"><a href="#foot_krm_0610_02">2</a></sup> अभिभवो न्यूनीकरणं न्यूनीभवनं च। </li> <li>आद्ये सकर्मकः। </li> <li>शत्रून् जयति। </li> <li>द्वितीये त्वकर्मकः। </li> <li>अध्ययनात् पराजयते। </li> <li>अध्येतुं ग्लायतीत्यर्थः। </li> <li>इति सिद्धान्तकौमुदी। </li> <li>शत्रून् जयन्- जेता वा। </li> <li>अध्ययनात् पराजेता। </li> <li>ग्लायन् इत्यर्थः। </li> <li>‘<sup id="ref_krm_0610_03"><a href="#foot_krm_0610_03">3</a></sup> जयेज्जयाभिभवयोराद्योऽर्थेऽसावकर्मकः।।’ उत्कर्षप्राप्तिराद्योऽर्थो द्वितीयेऽर्थे सकर्मकः।’ <sup id="ref_krm_0610_04"><a href="#foot_krm_0610_04">4</a></sup> इति देवः। </li> <li>एकस्मिन्नेव गणेऽर्थभेदात् पुनः पाठ इति बोध्यम्। </li> <li><sup id="ref_krm_0610_05"><a href="#foot_krm_0610_05">5</a></sup> जायकः-यिका, जापकः-पिका, जिगीषकः-षिका, जेजीयकः-यिकाः;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि अव्यवहितपूर्वलिखितजिधातुवत् <sup id="ref_krm_0610_06"><a href="#foot_krm_0610_06">6</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_0610_07"><a href="#foot_krm_0610_07">7</a></sup> जित्यः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0610_01"><a href="#ref_krm_0610_01">↑</a> (६००)</li> <li id="foot_krm_0610_02"><a href="#ref_krm_0610_02">↑</a> (१-भ्वादिः-९४६। सक। अक। अनि। पर।)</li> <li id="foot_krm_0610_03"><a href="#ref_krm_0610_03">↑</a> [जयिः]</li> <li id="foot_krm_0610_04"><a href="#ref_krm_0610_04">↑</a> (श्लो। १३-१४)</li> <li id="foot_krm_0610_05"><a href="#ref_krm_0610_05">↑</a> [पृष्ठम्०५७०+ २२]</li> <li id="foot_krm_0610_06"><a href="#ref_krm_0610_06">↑</a> (५९९)</li> <li id="foot_krm_0610_07"><a href="#ref_krm_0610_07">↑</a> [[१। ‘विपूयविनीयजित्या मुञ्जकल्कहलिषु’ (३-१-११७) इत्यनेन हलौ कृष्टसमी- करणार्थे स्थूलकाष्ठे वाच्ये क्यप् भवति। जित्यो = हलिः। बलेन क्रष्टव्य इत्यर्थः।]]</li></ul></p>

जि|जापकः-पिका|जिजापयिषकः-षिका|जापयिता-त्री|जिजापयिषिता-त्री
<ul><li><sup id="ref_krm_0611_01"><a href="#foot_krm_0611_01">1</a></sup> {@“जि भाषार्थः”@} <sup id="ref_krm_0611_02"><a href="#foot_krm_0611_02">2</a></sup> आस्वदीयः। </li> <li>जापकः-पिका, जिजापयिषकः-षिका, जापयिता-त्री, जिजापयिषिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकचिधातुवत् <sup id="ref_krm_0611_03"><a href="#foot_krm_0611_03">3</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0611_01"><a href="#ref_krm_0611_01">↑</a> (६०१)</li> <li id="foot_krm_0611_02"><a href="#ref_krm_0611_02">↑</a> (१०-चुरादिः-१७९४। अक। सेट्। उभ।)</li> <li id="foot_krm_0611_03"><a href="#ref_krm_0611_03">↑</a> (५१८)</li></ul></p>

