<ul><li><sup id="ref_krm_0690_01"><a href="#foot_krm_0690_01">1</a></sup> {@“णीङ् प्रापणे”@} <sup id="ref_krm_0690_02"><a href="#foot_krm_0690_02">2</a></sup> प्रापणम् = आसादनम्। </li> <li>नायकः- <sup id="ref_krm_0690_03"><a href="#foot_krm_0690_03">3</a></sup> परिणायकः-यिका, नायकः-यिका, <sup id="ref_krm_0690_04"><a href="#foot_krm_0690_04">4</a></sup> निनीषकः-षिका-नेनीयकः-यिका;</li> <li>  नेता-त्री, <sup id="ref_krm_0690_05"><a href="#foot_krm_0690_05">5</a></sup> दुरितापनेत्री, नाययिता-त्री, निनीषिता-त्री;</li> <li>  अनुनयन्-न्ती, <sup id="ref_krm_0690_06"><a href="#foot_krm_0690_06">6</a></sup> <sup id="ref_krm_0690_07"><a href="#foot_krm_0690_07">7</a></sup> विनयन्, नाययन्-न्ती, निनीषन्-न्ती;</li> <li>  -- नेष्यन्-न्ती-ती, नाययिष्यन्-न्ती-ती, निनीषिष्यन्-न्ती-ती;</li> <li>  <sup id="ref_krm_0690_08"><a href="#foot_krm_0690_08">8</a></sup> <sup id="ref_krm_0690_09"><a href="#foot_krm_0690_09">9</a></sup> नयमानः, <sup id="ref_krm_0690_10"><a href="#foot_krm_0690_10">10</a></sup> <sup id="ref_krm_0690_11"><a href="#foot_krm_0690_11">11</a></sup> नयमानः, <sup id="ref_krm_0690_12"><a href="#foot_krm_0690_12">12</a></sup> उन्नयमानः, <sup id="ref_krm_0690_13"><a href="#foot_krm_0690_13">13</a></sup> <sup id="ref_krm_0690_14"><a href="#foot_krm_0690_14">14</a></sup> उपनयमानः-<sup id="ref_krm_0690_15"><a href="#foot_krm_0690_15">15</a></sup> नयमानः, <sup id="ref_krm_0690_16"><a href="#foot_krm_0690_16">16</a></sup> उपनयमानः, <sup id="ref_krm_0690_17"><a href="#foot_krm_0690_17">17</a></sup> विनयमानः, <sup id="ref_krm_0690_18"><a href="#foot_krm_0690_18">18</a></sup> विनयमानः, <sup id="ref_krm_0690_19"><a href="#foot_krm_0690_19">19</a></sup> <sup id="ref_krm_0690_20"><a href="#foot_krm_0690_20">20</a></sup> विनयमानः, नाययमानः, निनीषमाणः, नेनीयमानः;</li> <li>  नेष्यमाणः, नाययिष्यमाणः, निनीषिष्यमाणः, नेनीयिष्यमाणः;</li> <li>  <sup id="ref_krm_0690_21"><a href="#foot_krm_0690_21">21</a></sup> अग्रणीः, ग्रामणीः-ग्रामण्यौ-ग्रामण्यः, <sup id="ref_krm_0690_22"><a href="#foot_krm_0690_22">22</a></sup> तिथिप्रणीः, सेनानीः <sup id="ref_krm_0690_23"><a href="#foot_krm_0690_23">23</a></sup>;</li> <li>  -- नीतः-नीतम्-नीतवान्, नायितः, निनीषितः, नेनीयितः-तवान्;</li> <li>  <sup id="ref_krm_0690_24"><a href="#foot_krm_0690_24">24</a></sup> नायः, अनुनयः-नयः, <sup id="ref_krm_0690_25"><a href="#foot_krm_0690_25">25</a></sup> उष्ट्रप्रणायः- <sup id="ref_krm_0690_26"><a href="#foot_krm_0690_26">26</a></sup> नेष्टा-नेता, <sup id="ref_krm_0690_27"><a href="#foot_krm_0690_27">27</a></sup> नेत्रम्, <sup id="ref_krm_0690_28"><a href="#foot_krm_0690_28">28</a></sup> अनुनायकः, अनुनायिका, नायः, निनीषुः, अनुनिनीषुः, <sup id="ref_krm_0690_29"><a href="#foot_krm_0690_29">29</a></sup> <sup id="ref_krm_0690_30"><a href="#foot_krm_0690_30">30</a></sup> नेन्यः;</li> <li>  नेतव्यः, नाययितव्यः, निनीषितव्यः, नेनीयितव्यः;</li> <li>  नयनीयः, नायनीयः निनीषणीयः, नेनीयनीयः;</li> <li>  <sup id="ref_krm_0690_31"><a href="#foot_krm_0690_31">31</a></sup> नेयम्- <sup id="ref_krm_0690_32"><a href="#foot_krm_0690_32">32</a></sup> विनीयः-<sup id="ref_krm_0690_33"><a href="#foot_krm_0690_33">33</a></sup> विनेयः, <sup id="ref_krm_0690_34"><a href="#foot_krm_0690_34">34</a></sup> आनाय्यः <sup id="ref_krm_0690_35"><a href="#foot_krm_0690_35">35</a></sup> आनेयः <sup id="ref_krm_0690_36"><a href="#foot_krm_0690_36">36</a></sup>, <sup id="ref_krm_0690_37"><a href="#foot_krm_0690_37">37</a></sup> प्रणाय्यः <sup id="ref_krm_0690_38"><a href="#foot_krm_0690_38">38</a></sup> <sup id="ref_krm_0690_39"><a href="#foot_krm_0690_39">39</a></sup>, प्रणेयः, <sup id="ref_krm_0690_40"><a href="#foot_krm_0690_40">40</a></sup> सान्नाय्यम् <sup id="ref_krm_0690_41"><a href="#foot_krm_0690_41">41</a></sup>, नाय्यम्, निनीष्यम्, नेनीय्यम्;</li> <li>  -- -- ईषन्नयः- <sup id="ref_krm_0690_42"><a href="#foot_krm_0690_42">42</a></sup> दुर्नयः-सुनयः;</li> <li>  -- -- -- नीयमानः, नाय्यमानः, निनीष्यमाणः, नेनीय्यमानः;</li> <li>  <sup id="ref_krm_0690_43"><a href="#foot_krm_0690_43">43</a></sup> नायः, निर्णयः-दुर्नयः-प्रणयः-सुनयः-अनुनयः-विनयः-उपनयः, <sup id="ref_krm_0690_44"><a href="#foot_krm_0690_44">44</a></sup> नयः, उन्नयः, <sup id="ref_krm_0690_45"><a href="#foot_krm_0690_45">45</a></sup> अवनायः-उन्नायः, <sup id="ref_krm_0690_46"><a href="#foot_krm_0690_46">46</a></sup> परिणायः-परिणयः, <sup id="ref_krm_0690_47"><a href="#foot_krm_0690_47">47</a></sup> आनायः <sup id="ref_krm_0690_48"><a href="#foot_krm_0690_48">48</a></sup>, नायः, निनीषः, नेनीयः;</li> <li>  नेतुम्, नाययितुम्, निनीषितुम्, नेनीयितुम्;</li> <li>  नीतिः, नायना, निनीषा, नेनीया;</li> <li>  <sup id="ref_krm_0690_49"><a href="#foot_krm_0690_49">49</a></sup> नयनम्, नायनम्, निनीषणम्, नेनीयनम्;</li> <li>  नीत्वा, नाययित्वा, निनीषित्वा, नेनीयित्वा;</li> <li>  प्रणीय, प्रणाय्य, प्रणिनीष्य, प्रणेनीय्य;</li> <li>  नायम् २, नीत्वा २, नायम् २, नाययित्वा २, निनीषम् २, निनीषित्वा २, नेनीयम् २;</li> <li>  नेनीयित्वा २। <sup id="ref_krm_0690_50"><a href="#foot_krm_0690_50">50</a></sup> इति ऋप्रत्ययः, स च डिद्वद् भवति। </li> <li>नयतीति ना = मनुष्यः।]] ना, नेमः, <sup id="ref_krm_0690_51"><a href="#foot_krm_0690_51">51</a></sup> मन्प्रत्यये गुणः। </li> <li>नेमः = अर्धम्।]] नीरम्। </li> <li><sup id="ref_krm_0690_52"><a href="#foot_krm_0690_52">52</a></sup> रक्प्रत्यये रूपम्। </li> <li>नीरम् = जलम्।]]</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0690_01"><a href="#ref_krm_0690_01">↑</a> (६८०)</li> <li id="foot_krm_0690_02"><a href="#ref_krm_0690_02">↑</a> (१-भ्वादिः-९०१। सक। अनि। उभ।)</li> <li id="foot_krm_0690_03"><a href="#ref_krm_0690_03">↑</a> [[B। ‘अनुदेहमागतवतः प्रतिमां परिणायकस्य गुरुमुद्वहता।’ शि। व। ९। ७३। ९-७३।]]</li> <li id="foot_krm_0690_04"><a href="#ref_krm_0690_04">↑</a> [[२। धातोरस्यानुदात्तत्वात्, ‘एकाच उपदेशेऽनुदात्तात्’ (७-२-१०) इतीण्णिषेधे, ‘इको झल्’ (१-२-९) इति सनः कित्त्वात् न गुणः। ‘अज्झनगमां सनि’ (६-४-१६) इति दीर्घः। एवं सन्नन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0690_05"><a href="#ref_krm_0690_05">↑</a> [[C। ‘धृतप्रमोदो दुरितापनेत्रीं स्नातुं नदीमाप स गान्दिनेयः।।’ धा। का। २। २९।]]</li> <li id="foot_krm_0690_06"><a href="#ref_krm_0690_06">↑</a> [गडुं]</li> <li id="foot_krm_0690_07"><a href="#ref_krm_0690_07">↑</a> [[३। ‘कर्तृस्थे चाशरीरे कर्मणि’ (१-३-३७) इत्यत्र शरीरावयवभिन्ने कर्मणि इति व्या- ख्यानात्, कर्तृगामिन्यपि क्रियाफले नात्मनेपदं शानज् भवति। अपि तु शतैव।]]</li> <li id="foot_krm_0690_08"><a href="#ref_krm_0690_08">↑</a> [अजां ग्रामं]</li> <li id="foot_krm_0690_09"><a href="#ref_krm_0690_09">↑</a> [[४। ‘नीङ्धातोः संयोगानुकूलव्यापारानुकूलव्यापारार्थकत्वेन ‘कर्तुरीप्सिततमं कर्म’ (१-४-४९) इत्यनेनाजायाः प्रधानकर्मत्वम्। ग्रामस्य तु अप्रधानकर्मत्वमिति द्विती- याप्रयोगः सङ्गच्छते। यद्वा, ‘अकथितं च’ (१-४-५१) इत्यनेनाधारस्य ग्रामस्य तत्त्वाविवक्षायां कर्मसंज्ञा भवति, इति वा बोध्यम्।]]</li> <li id="foot_krm_0690_10"><a href="#ref_krm_0690_10">↑</a> [शास्त्रे]</li> <li id="foot_krm_0690_11"><a href="#ref_krm_0690_11">↑</a> [[५। ‘सम्माननोत्सञ्जनाचार्यकरणज्ञानभृतिविगणनव्ययेषु नियः’ (१-३-३६) इत्यनेन क्रमेण सप्तस्वर्थेषु विषयभूतेषु आत्मनेपदं भवति--परगामिन्यपि क्रियाफले। सम्माननम् = पूजनम्। ‘शास्त्रे नयमान’ इत्यत्र शास्त्रबोध्यम् अर्थं शिष्येभ्यः प्रापयतीत्यर्थः। तेन शिष्यसम्माननं फलितम्। उत्सञ्जनम् = उत्क्षेपणम्। आचार्यकरणम् = आचार्यक्रिया। विधिना आत्मसमीपं प्रापयन् इत्यर्थः। ज्ञानम् = प्रमेयनिश्चयः। भृतिः = वेतनम्। भृतिदानेन स्वसमीपं प्रापयन् इत्यर्थः। विगणनम् = ऋणादेर्नियातनम्। राज्ञे देयं भागं परिशोधयन् इत्यर्थः। व्ययः = धर्मार्थं विनियोगः। धर्मार्थिं शतं विनियुञ्जान इत्यर्थः।]]</li> <li id="foot_krm_0690_12"><a href="#ref_krm_0690_12">↑</a> [दण्डम्]</li> <li id="foot_krm_0690_13"><a href="#ref_krm_0690_13">↑</a> [पृष्ठम्०६२९+ २८]</li> <li id="foot_krm_0690_14"><a href="#ref_krm_0690_14">↑</a> [माणवकं]</li> <li id="foot_krm_0690_15"><a href="#ref_krm_0690_15">↑</a> [तत्त्वं]</li> <li id="foot_krm_0690_16"><a href="#ref_krm_0690_16">↑</a> [कर्मकरान्]</li> <li id="foot_krm_0690_17"><a href="#ref_krm_0690_17">↑</a> [करं]</li> <li id="foot_krm_0690_18"><a href="#ref_krm_0690_18">↑</a> [शतं]</li> <li id="foot_krm_0690_19"><a href="#ref_krm_0690_19">↑</a> [क्रोधं]</li> <li id="foot_krm_0690_20"><a href="#ref_krm_0690_20">↑</a> [[१। ‘कर्तृस्थे चाशरीरे कर्मणि’ (१-३-३७) इति शानच्। क्रोधम् अपगमयन् इत्यर्थः।]]</li> <li id="foot_krm_0690_21"><a href="#ref_krm_0690_21">↑</a> [[२। ‘सत्सूद्विषद्रुहदुहयुजविदभिदच्छिदजिनीराजामुपसर्गेऽपि क्विप्’ (३-२-६१) इति क्विप्। ‘अग्रग्रामाभ्यां नयतेर्णो वाच्यः’ इति वचनेन णत्वम्। नयतेरित्युक्तेः ‘ग्रामणायः’ इति कर्मण्यण्यपि णत्वं भवति। स्पष्टमिदं ‘वाऽसरूपोऽस्त्रियाम्’ (३-१-९४) इत्यत्र भाष्ये।]]</li> <li id="foot_krm_0690_22"><a href="#ref_krm_0690_22">↑</a> [[आ। ‘सायन्तनीं तिथिप्रण्यः पङ्कजानां दिवातनीम्’। भ। का। ५। ६५।]]</li> <li id="foot_krm_0690_23"><a href="#ref_krm_0690_23">↑</a> [[B। ‘सार्धं कुमारसेनान्या शून्यश्चासीति को नयः।।’ भ। का। ५। ७।]]</li> <li id="foot_krm_0690_24"><a href="#ref_krm_0690_24">↑</a> [[३। ‘दुन्योरनुपसर्गे’ (३-१-१४२) इति कर्तरि णप्रत्ययः। उपसृष्टात्तु पचाद्यजेव। केवलात् नीधातोः कर्तरि नय इति प्रयोगस्तु बाहुलकात् बोध्यः। ‘दुन्योः--’ (३-१-१४२) इत्यत्र, ‘वेति केचित्’ इति प्रक्रियाकौमुदी।]]</li> <li id="foot_krm_0690_25"><a href="#ref_krm_0690_25">↑</a> [[४। ‘कर्मण्यण्’ (३-२-१) इति प्रपूर्वकनीधातोरणि, ‘उपसर्गादसगासे--’ (८-४-१४) इति णत्वे रूपम्।]]</li> <li id="foot_krm_0690_26"><a href="#ref_krm_0690_26">↑</a> [[५। ‘तृन्’ (३-२-१३५) इति ताच्छीलिके तृनि, ‘नयतेः षुक् च’ (वा। ३-२-१३५) इति षुगागमे च रूपम्। नेष्टा = ऋत्विग्विशेषः।]]</li> <li id="foot_krm_0690_27"><a href="#ref_krm_0690_27">↑</a> [[६। ‘दाम्नीश--’ (३-२-१८२) इत्यादिना करणे ष्ट्रन्प्रत्ययः। नेत्रम् = चक्षुरिन्द्रियम्।]]</li> <li id="foot_krm_0690_28"><a href="#ref_krm_0690_28">↑</a> [[७। ‘तुमुन्ण्वुलौ क्रियायां क्रियार्थायाम्’ (३-३-१०) इति क्रियार्थायां क्रियायां सत्यां भविष्यति ण्वुल्। स्त्रियाम्, ‘प्रत्ययस्थात्--’ (७-३-४४) इतीत्वम्।]]</li> <li id="foot_krm_0690_29"><a href="#ref_krm_0690_29">↑</a> [[C। ‘पराक्रपज्ञः प्रि{??}सन्ततिस्तं नम्रः क्षितीन्द्रोऽतुनितीषुरूचे।।’ भ। का। २। ५१।]]</li> <li id="foot_krm_0690_30"><a href="#ref_krm_0690_30">↑</a> [[८। यङन्तात् पचाद्यचि (३-१-१३४) अङ्गस्यानेकाचत्वात् ‘एरनेकाचः--’ (६-४-८२) इति यणादेशः।]]</li> <li id="foot_krm_0690_31"><a href="#ref_krm_0690_31">↑</a> [पृष्ठम्०६३०+ ३०]</li> <li id="foot_krm_0690_32"><a href="#ref_krm_0690_32">↑</a> [[१। ‘विपूयविनीयजित्या मुञ्जकल्कहलिषु’ (३-१-११७) इति सूत्रेण विपूर्वकादस्मात् क्यपि रूपं निपातितम्। विनीयः = कल्कः। ‘पिष्टौषधे पक्वान्नतैलादीना- मृजीषे, पाके च वर्तते।’ इति माधवधातुवृत्तिः।]]</li> <li id="foot_krm_0690_33"><a href="#ref_krm_0690_33">↑</a> [कल्कः]</li> <li id="foot_krm_0690_34"><a href="#ref_krm_0690_34">↑</a> [[२। ‘आनाय्योऽनित्ये’ (३-१-१२७) इत्यनेन आङ्पूर्वादस्माण्ण्यति, आयादेशो निपात्यते। आनीयते इत्यानाथ्यः = दक्षिणाग्निविशेषः। ‘स हि गार्हपत्यादा- नीयते, अनित्यश्च सततमप्रज्वलनात्। ‘आनाय्यः = गोधुक्।’ इति क्षीरस्वामी। आनेयोऽन्यः घटादिः।’ इति सिद्धान्तकौमुदी।]]</li> <li id="foot_krm_0690_35"><a href="#ref_krm_0690_35">↑</a> [दक्षिणाग्निः]</li> <li id="foot_krm_0690_36"><a href="#ref_krm_0690_36">↑</a> [घटः]</li> <li id="foot_krm_0690_37"><a href="#ref_krm_0690_37">↑</a> [[३। ‘प्रणाय्योऽसम्मतौ’ (३-१-१२८) इति प्रपूर्वकादस्मात् ण्यदायादेशौ निपात्येते असम्मतावर्थे। सम्मतिः = प्रीतिविषयीभवनम्, भोगेष्वादरश्च। तद्भिन्नोऽर्थो- ऽसम्मतिः। चोरः प्रणाथ्यः = प्रीत्यनर्हः। शिष्यः प्रणाय्यः = विरक्तः।]]</li> <li id="foot_krm_0690_38"><a href="#ref_krm_0690_38">↑</a> [[आ। ‘न प्रणाय्यो जनः कच्चिन्निकाय्यं तेऽधितिष्ठति।’ भ। का। ६। ६७।]]</li> <li id="foot_krm_0690_39"><a href="#ref_krm_0690_39">↑</a> [चोरः, विरक्तश्च]</li> <li id="foot_krm_0690_40"><a href="#ref_krm_0690_40">↑</a> [[४। ‘पाय्यसान्नाय्य--’ (३-१-१२९) इत्यादिना ण्यदायादेशयो रूपमेवम्। सान्ना- य्यम् = दधिपयसी।]]</li> <li id="foot_krm_0690_41"><a href="#ref_krm_0690_41">↑</a> [हविः]</li> <li id="foot_krm_0690_42"><a href="#ref_krm_0690_42">↑</a> [[५। माधवधातुवृत्तौ तु ‘दुर्णयः’ इति णत्वविशिष्टतया रूपमुपलभ्यते। ‘दुरः षत्वणत्वयोः--’ (वा। १-४-६०) इति वचनात् णत्वाभावविशिष्ट एव शब्दः साधुरिति प्रतिभाति।]]</li> <li id="foot_krm_0690_43"><a href="#ref_krm_0690_43">↑</a> [[६। ‘श्रिणीभुवोऽनुपसर्गे’ (३-३-२४) इति भावेऽजपवादो घञ्। उपसृष्टात्तु ‘एरच्’ (३-३-५६) इत्यजेव--निर्णयः इत्यादि।]]</li> <li id="foot_krm_0690_44"><a href="#ref_krm_0690_44">↑</a> [[७। भावे नय इति तु बाहुलकात् ज्ञेयः। एवम् उन्नय इत्यपि।]]</li> <li id="foot_krm_0690_45"><a href="#ref_krm_0690_45">↑</a> [[८। ‘अवोदोर्नियः’ (३-३-२६) इति अव-उत्पूर्वकादस्मात् घञि साधुः।]]</li> <li id="foot_krm_0690_46"><a href="#ref_krm_0690_46">↑</a> [[९। ‘परिन्योर्नीणोर्द्यूताभ्रेषयोः’ (३-३-३७) इति परौ उपसर्गे घञ् द्यूतेऽभिधेये। परिणा- येन शारान् हन्ति। परिणायः = समन्तात् द्यूतसाधनानाम् अक्षाणां नयनम्।]]</li> <li id="foot_krm_0690_47"><a href="#ref_krm_0690_47">↑</a> [[१०। ‘जालमानायः’ (३-३-१२४) इति जालेऽभिधेये आङ्पूर्वकादस्माद् घञ् संज्ञायाम्। ‘पुंसि संज्ञायां घः--’ (३-३-११८) इत्यस्यापवादः।]]</li> <li id="foot_krm_0690_48"><a href="#ref_krm_0690_48">↑</a> [जालम्]</li> <li id="foot_krm_0690_49"><a href="#ref_krm_0690_49">↑</a> [पृष्ठम्०६३१+ २५]</li> <li id="foot_krm_0690_50"><a href="#ref_krm_0690_50">↑</a> [[१। ‘नयतेर्डिच्च’ [द। उ। २। ८।]</li> <li id="foot_krm_0690_51"><a href="#ref_krm_0690_51">↑</a> [[२। औणादिके [द। उ। ७-२६।]</li> <li id="foot_krm_0690_52"><a href="#ref_krm_0690_52">↑</a> [[३। औणादिके [द। उ। ८। ३१।]</li></ul></p>

णील|नीलकः-लिका|निनीलिषकः-षिका|नेनीलकः-लिका
<ul><li><sup id="ref_krm_0691_01"><a href="#foot_krm_0691_01">1</a></sup> {@“णील वर्णे”@} <sup id="ref_krm_0691_02"><a href="#foot_krm_0691_02">2</a></sup> ‘वर्णे = वर्णोपलक्षितायां क्रियायाम्। </li> <li>यथा-- ‘श्वेतं नीलति मरकतकान्त्या’। </li> <li>इति क्षीरस्वामी। </li> <li>नीलकः-लिका, नीलकः-लिका, निनीलिषकः-षिका, नेनीलकः-लिका;</li> <li>  प्रणीलिता, नीलः <sup id="ref_krm_0691_03"><a href="#foot_krm_0691_03">3</a></sup> नीली-नीला, इत्यादीनि सर्वाण्यपि रूपाणि भौवादिक- कीलतिवत् <sup id="ref_krm_0691_04"><a href="#foot_krm_0691_04">4</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0691_01"><a href="#ref_krm_0691_01">↑</a> (६८१)</li> <li id="foot_krm_0691_02"><a href="#ref_krm_0691_02">↑</a> (१-भ्वादिः-५२२। अक। सेट्। पर।)</li> <li id="foot_krm_0691_03"><a href="#ref_krm_0691_03">↑</a> [[४। ‘इगुपध--’ (३-१-१३५) इति कर्तरि कप्रत्यये नीलः इति भवति। स्त्रियाम्, ‘जानपदकुण्डगोणस्थलभाजनागकालनील--’ (४-१-४२) इत्यनेन प्राणिनि ओषधि- विशेषे च वाच्ये अनाच्छादने विहितोऽपि ङीष्, ‘नीलादोषधौ प्राणिनि च’ (वा। ४-१-४२) इति वचनात् भवति। अन्यत्र नीला = शाटी। नील्या रक्तेति यावत्।]]</li> <li id="foot_krm_0691_04"><a href="#ref_krm_0691_04">↑</a> (१९५)</li></ul></p>

णीव|प्रणीवकः-विका|नीवकः-विका|निनीविषकः-षिका|नेनीवकः-विका
<ul><li><sup id="ref_krm_0692_01"><a href="#foot_krm_0692_01">1</a></sup> {@“णीव स्थौल्ये”@} <sup id="ref_krm_0692_02"><a href="#foot_krm_0692_02">2</a></sup> प्रणीवकः-विका, नीवकः-विका, निनीविषकः-षिका, नेनीवकः-विका;</li> <li>  नीवः, <sup id="ref_krm_0692_03"><a href="#foot_krm_0692_03">3</a></sup> इतीन् प्रत्यये, ‘कृदिकारादक्तिनः’ <sup id="ref_krm_0692_04"><a href="#foot_krm_0692_04">4</a></sup> इति ङीष्विकल्पः। </li> <li>‘स्त्रीकटीवस्त्रबन्धेऽपि नीवी परिपणेऽपि च।’ इत्यमरः।]] नीविः-नीवी, इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकजीवतिवत् <sup id="ref_krm_0692_05"><a href="#foot_krm_0692_05">5</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0692_06"><a href="#foot_krm_0692_06">6</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0692_01"><a href="#ref_krm_0692_01">↑</a> (६८२)</li> <li id="foot_krm_0692_02"><a href="#ref_krm_0692_02">↑</a> (१-भ्वादिः-५६६। अक। सेट्। पर।)</li> <li id="foot_krm_0692_03"><a href="#ref_krm_0692_03">↑</a> [[५। ‘इन्’ [द। उ। १-४६]</li> <li id="foot_krm_0692_04"><a href="#ref_krm_0692_04">↑</a> (ग। सू। ४-१-४५)</li> <li id="foot_krm_0692_05"><a href="#ref_krm_0692_05">↑</a> (६०६)</li> <li id="foot_krm_0692_06"><a href="#ref_krm_0692_06">↑</a> [पृष्ठम्०६३२+ २४]</li></ul></p>

