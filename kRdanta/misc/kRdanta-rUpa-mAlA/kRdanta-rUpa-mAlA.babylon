<ul><li><sup id="ref_krm_0449_01"><a href="#foot_krm_0449_01">1</a></sup> {@“ग्रह उपादाने”@} <sup id="ref_krm_0449_02"><a href="#foot_krm_0449_02">2</a></sup> ग्रह्यादिः। </li> <li>उपादानम् = स्वीकारः। </li> <li>‘ण्यन्तस्य ग्रहणे गृहेर्गृहयते, तत्रानदन्ताद् गृहेः भूवादेः शपि गर्हते, श्नि तु पदे गृह्णात्यगृह्णीत च। </li> <li><sup id="ref_krm_0449_03"><a href="#foot_krm_0449_03">3</a></sup> गर्हेर्वा णिचि निन्दनार्थविषये गर्हेत् तथा, गर्हयेद् भूवादेः शपि कुत्सनार्थविषये गर्हेर्भवेद् गर्हते।।’ <sup id="ref_krm_0449_04"><a href="#foot_krm_0449_04">4</a></sup> इति देवः। </li> <li>ग्राहकः-हिका, ग्राहकः-हिका, <sup id="ref_krm_0449_05"><a href="#foot_krm_0449_05">5</a></sup> जिघृक्षकः-क्षिका, <sup id="ref_krm_0449_06"><a href="#foot_krm_0449_06">6</a></sup> जरीगृहकः-हिका;</li> <li>  <sup id="ref_krm_0449_07"><a href="#foot_krm_0449_07">7</a></sup> ग्रहीता-त्री, ग्राहयिता-त्री, जिघृक्षिता-त्री, <sup id="ref_krm_0449_08"><a href="#foot_krm_0449_08">8</a></sup> जरीगृहिता-त्री;</li> <li>  <sup id="ref_krm_0449_09"><a href="#foot_krm_0449_09">9</a></sup> गृह्णन्-ती, विगृह्णन्, ग्राहयन्-न्ती, जिघृक्षन्-न्ती;</li> <li>  -- ग्रहीष्यन्-न्ती-ती, ग्राहयिष्यन्-न्ती-ती, जिघृक्षिष्यन्-न्ती-ती;</li> <li>  -- गृह्णानः, ग्राहयमाणः, जिघृक्षमाणः, जरीगृह्यमाणः;</li> <li>  ग्रहीष्यमाणः, ग्राहयिष्यमाणः, जिघृक्षिष्यमाणः, जरीगृहिष्यमाणः;</li> <li>  <sup id="ref_krm_0449_10"><a href="#foot_krm_0449_10">10</a></sup> विघृट्-विघृड्-विगृहौ-विगृहः;</li> <li>  -- -- <sup id="ref_krm_0449_11"><a href="#foot_krm_0449_11">11</a></sup> गृहीतम्-तः, <sup id="ref_krm_0449_12"><a href="#foot_krm_0449_12">12</a></sup> पाणिगृहीती-पाणिगृहीता, ग्राहितः, जिघृक्षितः, जरीगृहितः-तवान्;</li> <li>  <sup id="ref_krm_0449_13"><a href="#foot_krm_0449_13">13</a></sup> <sup id="ref_krm_0449_14"><a href="#foot_krm_0449_14">14</a></sup> ग्राही, <sup id="ref_krm_0449_15"><a href="#foot_krm_0449_15">15</a></sup> गुणग्राही, <sup id="ref_krm_0449_16"><a href="#foot_krm_0449_16">16</a></sup> ग्राहः- <sup id="ref_krm_0449_17"><a href="#foot_krm_0449_17">17</a></sup> ग्रहः, <sup id="ref_krm_0449_18"><a href="#foot_krm_0449_18">18</a></sup> गृहम्-गृहाः, <sup id="ref_krm_0449_19"><a href="#foot_krm_0449_19">19</a></sup> शक्तिग्रहः, लाङ्गलग्रहः, अङ्कुशग्रहः, यष्टिग्रहः, तोमरग्रहः, घटग्रहः, घटी ग्रहः घनुर्ग्रहः, <sup id="ref_krm_0449_20"><a href="#foot_krm_0449_20">20</a></sup> सूत्रग्रहः, <sup id="ref_krm_0449_21"><a href="#foot_krm_0449_21">21</a></sup> फलेग्रहिः <sup id="ref_krm_0449_22"><a href="#foot_krm_0449_22">22</a></sup>, ग्राहः, <sup id="ref_krm_0449_23"><a href="#foot_krm_0449_23">23</a></sup> जिघृक्षुः, <sup id="ref_krm_0449_24"><a href="#foot_krm_0449_24">24</a></sup> विजिग्राहयिषुः, जरीगृहः;</li> <li>  ग्रहीतव्यम्, ग्राहयितव्यम्, जिघृक्षितव्यम्, जरीगृहितव्यम्;</li> <li>  ग्रहणीयम्, ग्राहणीयम्, जिघृक्षणीयम्, जरीगृहणीयम्;</li> <li>  ग्राह्यम्, <sup id="ref_krm_0449_25"><a href="#foot_krm_0449_25">25</a></sup> प्रतिगृह्यम्-अपिगृह्यम्, <sup id="ref_krm_0449_26"><a href="#foot_krm_0449_26">26</a></sup> प्रगृह्यम् <sup id="ref_krm_0449_27"><a href="#foot_krm_0449_27">27</a></sup> <sup id="ref_krm_0449_28"><a href="#foot_krm_0449_28">28</a></sup>, गृह्यकाः <sup id="ref_krm_0449_29"><a href="#foot_krm_0449_29">29</a></sup> <sup id="ref_krm_0449_30"><a href="#foot_krm_0449_30">30</a></sup>, अगृह्या, ग्रामगृह्या नगरगृह्या, <sup id="ref_krm_0449_31"><a href="#foot_krm_0449_31">31</a></sup>, ग्रामग्राह्यः, वासुदेवगृह्या, अर्जुनगृह्या-देवगृह्या, <sup id="ref_krm_0449_32"><a href="#foot_krm_0449_32">32</a></sup>, ग्राह्यम्, जिघृक्ष्यम्, जरीगृह्यम्;</li> <li>  ईषद्-ग्रहः-दुर्ग्रहः-सुग्रहः;</li> <li>  -- -- गृह्यमाणः, ग्राह्यमाणः, जिघृक्ष्यमाणः, जरीगृह्यमाणः;</li> <li>  <sup id="ref_krm_0449_33"><a href="#foot_krm_0449_33">33</a></sup> ग्रहः, <sup id="ref_krm_0449_34"><a href="#foot_krm_0449_34">34</a></sup> उद्ग्राहः <sup id="ref_krm_0449_35"><a href="#foot_krm_0449_35">35</a></sup>, <sup id="ref_krm_0449_36"><a href="#foot_krm_0449_36">36</a></sup> सङ्ग्राहः <sup id="ref_krm_0449_37"><a href="#foot_krm_0449_37">37</a></sup>, सङ्ग्रहः, <sup id="ref_krm_0449_38"><a href="#foot_krm_0449_38">38</a></sup> अवग्राहः-निग्राहः, अवग्रहः <sup id="ref_krm_0449_39"><a href="#foot_krm_0449_39">39</a></sup>, निग्रहः <sup id="ref_krm_0449_40"><a href="#foot_krm_0449_40">40</a></sup>, <sup id="ref_krm_0449_41"><a href="#foot_krm_0449_41">41</a></sup> प्रग्राहः, <sup id="ref_krm_0449_42"><a href="#foot_krm_0449_42">42</a></sup> परिग्राहः, परिग्रहः <sup id="ref_krm_0449_43"><a href="#foot_krm_0449_43">43</a></sup>, <sup id="ref_krm_0449_44"><a href="#foot_krm_0449_44">44</a></sup> अवग्राहः-अवग्रहः, <sup id="ref_krm_0449_45"><a href="#foot_krm_0449_45">45</a></sup> <sup id="ref_krm_0449_46"><a href="#foot_krm_0449_46">46</a></sup> तुलाप्रग्राहः- <sup id="ref_krm_0449_47"><a href="#foot_krm_0449_47">47</a></sup> तुलाप्रग्रहः, <sup id="ref_krm_0449_48"><a href="#foot_krm_0449_48">48</a></sup> <sup id="ref_krm_0449_49"><a href="#foot_krm_0449_49">49</a></sup> प्रग्राहः-प्रग्रहो वा, <sup id="ref_krm_0449_50"><a href="#foot_krm_0449_50">50</a></sup> <sup id="ref_krm_0449_51"><a href="#foot_krm_0449_51">51</a></sup> ग्लहः, <sup id="ref_krm_0449_52"><a href="#foot_krm_0449_52">52</a></sup> ग्राहः, जिघृक्षः, जरीगृहः;</li> <li>  <sup id="ref_krm_0449_53"><a href="#foot_krm_0449_53">53</a></sup> ग्रहीतुम्, ग्राहयितुम्, जिघृक्षितुम्, जरीगृहितुम्;</li> <li>  <sup id="ref_krm_0449_54"><a href="#foot_krm_0449_54">54</a></sup> निगृहीतिः, ग्राहणा, जिघृक्षा, जरीगृहा;</li> <li>  ग्रहणम्, ग्राहणम्, जिघृक्षणम्, जरीगृहणम्;</li> <li>  <sup id="ref_krm_0449_55"><a href="#foot_krm_0449_55">55</a></sup> गृहीत्वा, ग्राहयित्वा, जिघृक्षित्वा, जरीगृहित्वा;</li> <li>  विगृह्य, विग्राह्य, विजिघृक्ष्य, विजरीगृह्य;</li> <li>  <sup id="ref_krm_0449_56"><a href="#foot_krm_0449_56">56</a></sup> जीवग्राहं, <sup id="ref_krm_0449_57"><a href="#foot_krm_0449_57">57</a></sup> <sup id="ref_krm_0449_58"><a href="#foot_krm_0449_58">58</a></sup>, <sup id="ref_krm_0449_59"><a href="#foot_krm_0449_59">59</a></sup> नामग्राहं, <sup id="ref_krm_0449_60"><a href="#foot_krm_0449_60">60</a></sup> <sup id="ref_krm_0449_61"><a href="#foot_krm_0449_61">61</a></sup>;</li> <li>  <sup id="ref_krm_0449_62"><a href="#foot_krm_0449_62">62</a></sup> हस्तग्राहं, <sup id="ref_krm_0449_63"><a href="#foot_krm_0449_63">63</a></sup>, <sup id="ref_krm_0449_64"><a href="#foot_krm_0449_64">64</a></sup> यष्टिग्राहं <sup id="ref_krm_0449_65"><a href="#foot_krm_0449_65">65</a></sup>, <sup id="ref_krm_0449_66"><a href="#foot_krm_0449_66">66</a></sup> केशग्राहं युध्यन्ति;</li> <li>  ग्राहम् २, गृहीत्वा २, ग्राहम् २, जिघृक्षम् २, जरीगृहम् २;</li> <li>  ग्राहयित्वा २, जिघृक्षित्वा २, जरीग्र्हित्वा २। <sup id="ref_krm_0449_67"><a href="#foot_krm_0449_67">67</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0449_01"><a href="#ref_krm_0449_01">↑</a> (४४१)</li> <li id="foot_krm_0449_02"><a href="#ref_krm_0449_02">↑</a> (९-क्र्यादिः-१५३३। सक। सेट्। उभ।)</li> <li id="foot_krm_0449_03"><a href="#ref_krm_0449_03">↑</a> [पृष्ठम्०४३६+ २५]</li> <li id="foot_krm_0449_04"><a href="#ref_krm_0449_04">↑</a> (श्लो। १९४)</li> <li id="foot_krm_0449_05"><a href="#ref_krm_0449_05">↑</a> [[१। ‘सन्यङोः’ (६-१-९) इति द्वित्वे, अभ्यासकार्ये, ‘सनि ग्रहगुहोश्च’ (७-२-१२) इतीण्णिषेधः। ‘रुदविदमुषग्रहिस्वपिप्रच्छः संश्च’ (१-२-८) इति कित्त्वे ‘ग्रहि- ज्या--’ (६-१-१६) इति सम्प्रसारणे, उत्तरखण्डे हकारस्य ढत्वे, भष्भावे च कृते, ‘षढोः कः सि’ (८-२-४१) इति कत्वे षत्वे च रूपम्। एवं सन्नन्ते सर्वत्र प्रक्रिया बोध्या।]]</li> <li id="foot_krm_0449_06"><a href="#ref_krm_0449_06">↑</a> [[२। यङ्निमित्तके सम्प्रसारणे द्वित्वे, अभ्यासस्य ‘रीगृत्वत इति वक्तव्यम्’ (वा। ७-४-९०) इति रीगागमे यलोपाल्लोपयोः रूपम्। एवं यङन्ते सर्वत्रापि ज्ञेयम्।]]</li> <li id="foot_krm_0449_07"><a href="#ref_krm_0449_07">↑</a> [[३। ‘ग्रहोऽलिटि दीर्घः’ (७-२-३७) इतीटो दीर्घः। एवं इडागमे सर्वत्र दीर्घो बोध्यः।]]</li> <li id="foot_krm_0449_08"><a href="#ref_krm_0449_08">↑</a> [[४। ‘ग्रहोऽलिटि दीर्घः’ (७-२-३७) इति दीर्घः नात्र प्रवर्तते। अल्लोपस्य स्थानिवद्भा- वात्। एवं सर्वत्र यङन्तस्थले बोध्यम्।]]</li> <li id="foot_krm_0449_09"><a href="#ref_krm_0449_09">↑</a> [[५। ‘क्र्यादिभ्यः--’ (३-१-८१) इति श्नाप्रत्यये, ‘सार्वधातुकमपित्’ (१-२-४) इत्यनेन श्नाप्रत्ययस्य ङिद्वद्भावात् ‘ग्रहिज्यावयि--’ (६-१-१६) इत्यादिना सम्प्र- सारणे, ‘श्नाऽभ्यस्तयोरातः’ (६-४-११२) इत्याकारलोपे, ‘ऋवर्णान्नस्य--’ (वा। ८-४-१) इति णत्वे च रूपम्। एवं शानजन्तेऽपि ज्ञेयम्।]]</li> <li id="foot_krm_0449_10"><a href="#ref_krm_0449_10">↑</a> [[६। क्विपि, ‘ग्रहिज्या--’ (६-१-१६) इत्यादिना सम्प्रसारणे पूर्वरूपे च, हस्य ढत्वे भष्भावे, चर्त्वविकल्पे च रूपम्।]]</li> <li id="foot_krm_0449_11"><a href="#ref_krm_0449_11">↑</a> [[७। सम्प्रसारणे पूर्वरूपे, इटो दीर्घे चं रूपम्।]]</li> <li id="foot_krm_0449_12"><a href="#ref_krm_0449_12">↑</a> [[८। ‘पाणिगृहीती भार्यायाम्’ (वा। ४-१-५२) इति ङीषन्तो निपात्यते। भार्याया अन्यत्र पाणिगृहीता।]]</li> <li id="foot_krm_0449_13"><a href="#ref_krm_0449_13">↑</a> [पृष्ठम्०४३७+ ३४]</li> <li id="foot_krm_0449_14"><a href="#ref_krm_0449_14">↑</a> [[१। ‘नन्दिग्रहिपचादिभ्यो ल्युणिन्यचः’ (३-१-१३४) इत्यनेन ग्रह्यादित्वात् णिनिः।]]</li> <li id="foot_krm_0449_15"><a href="#ref_krm_0449_15">↑</a> [[२। ‘सुप्यजातौ--’ (३-२-७८) इति ताच्छील्ये णिनिः।]]</li> <li id="foot_krm_0449_16"><a href="#ref_krm_0449_16">↑</a> [[३। ‘विभाषा ग्रहः’ (३-१-१४३) इति कर्तरि णो वा। पक्षे पचाद्यच् (३-१-१३४)। अत्र व्यवस्थितविभाषाश्रयणात् जलचरे जन्तौ ग्राहः इत्येव। ज्योतिषि बाच्ये ग्रहः इति बोध्यम्। ‘देवत्रातो गलो ग्राह इतियोगे च सद्विधिः। मिथस्ते न विभाष्यन्ते गवाक्षः संशितव्रतः।।’ (भाष्यम्-७-४-४१) इति व्यवस्थितविभाषा।]]</li> <li id="foot_krm_0449_17"><a href="#ref_krm_0449_17">↑</a> [[आ। ‘समाविष्टं ग्रहेणेव ग्राहेणेवोत्तमार्णवे। दृष्ट्वा गृहान् स्मरस्येव वनान्तान्मम मानसम्।।’ भ। का। ६-८३।]]</li> <li id="foot_krm_0449_18"><a href="#ref_krm_0449_18">↑</a> [[४। ‘गेहे कः’ (३-१-१४४) इति कर्तरि कः। कित्त्वात् सम्प्रसारणम्। गृहाः = गृहिणी। तात्स्थ्यात् ताच्छब्द्यम्।’ गृहाः पुंसि च भूम्न्येव--’ इत्यमरः।]]</li> <li id="foot_krm_0449_19"><a href="#ref_krm_0449_19">↑</a> [[५। ‘शक्तिलाङ्गलाङ्कुशयष्टितोमरघटधटीधनुःषु ग्रहेरुपसंख्यानम्’ (वा। ३-२-९) इति कर्मण्युपपदेऽच् प्रत्ययः। कर्मण्यणोऽपवादः।]]</li> <li id="foot_krm_0449_20"><a href="#ref_krm_0449_20">↑</a> [[६। ‘सूत्रे च धार्येऽर्थे’ (वा। ३-२-९) इति अच्। कर्मण्यणोऽपवादः।]]</li> <li id="foot_krm_0449_21"><a href="#ref_krm_0449_21">↑</a> [[७। ‘फलेग्रहिरात्मम्भरिश्च’ (३-२-२६) इति इन्प्रत्ययान्तो निपात्यते। उपपदस्य एदन्तत्वं निपातनाद्भवति। फलानि गृह्णातीति फलेग्रहिः ‘रजोग्रहिः मलग्राहिरिति केचित्।’ इति प्रक्रियाकौमुदी।]]</li> <li id="foot_krm_0449_22"><a href="#ref_krm_0449_22">↑</a> [[B। ‘आत्मम्भरिस्त्वं पिशितैर्नराणां फलेग्रहीन् हंसि वनस्पतीनाम्। शौवस्तिकत्वं विभवा न येषां व्रजन्ति तेषां दयसे न कस्मात्।।’ भ। का। २-३३।]]</li> <li id="foot_krm_0449_23"><a href="#ref_krm_0449_23">↑</a> [[C। ‘विदित्वा शक्तिमात्मीयां रावणं विजिघृक्षवः। उक्तं पिपृच्छिषूणां वो मा स्म भूत सुषुप्सवः।।’ भ। का। ७-९८।]]</li> <li id="foot_krm_0449_24"><a href="#ref_krm_0449_24">↑</a> [[ड्। ‘खरदूषणयोर्भ्रात्रोः पर्यदेविष्ट सा पुरः। विजिग्राहयिषू रामं दण्डकारण्यवासिनोः।।’ भ। का। ४-३४।]]</li> <li id="foot_krm_0449_25"><a href="#ref_krm_0449_25">↑</a> [[८। ‘प्रत्यपिभ्यां ग्रहेः’ (३-१-११८) इति क्यपू। ‘छन्दसीति वक्तव्यम्’ (वा। ३-१-११८) इति वचनात् छन्दसि विषये प्रतिगृह्यम्-अपिगृह्यम् इति रूपे ज्ञेये। ‘भाषायां वा’ इति केचित् -- इति प्रक्रियाकौमुदी।]]</li> <li id="foot_krm_0449_26"><a href="#ref_krm_0449_26">↑</a> [[९। ‘पदास्वैरिबाह्यापक्ष्येषु च’ (३-१-११९) इति क्यपू। ‘बाह्या’ इति स्त्रीलिङ्ग- निर्देशात् लिङ्गान्तरे मा भूदिति, तेन ‘ग्रामग्राह्यश्चण्डालः’ इत्यत्र ण्यदेव भवतीति मा। धा। वृत्तिः।]]</li> <li id="foot_krm_0449_27"><a href="#ref_krm_0449_27">↑</a> [[E। ‘प्रगृह्यपदवत् साध्वीं स्पष्टरूपामविक्रियाम्। अगृह्यां वीतकामत्वात् देवगृह्यामनिन्दिताम्।।’ भ। का। ६-६१।]]</li> <li id="foot_krm_0449_28"><a href="#ref_krm_0449_28">↑</a> [पदम्]</li> <li id="foot_krm_0449_29"><a href="#ref_krm_0449_29">↑</a> [पृष्ठम्०४३८+ ३०]</li> <li id="foot_krm_0449_30"><a href="#ref_krm_0449_30">↑</a> (परतन्त्राः शुकाः)</li> <li id="foot_krm_0449_31"><a href="#ref_krm_0449_31">↑</a> [ग्रामात् नगराद्वा बाह्या सेना]</li> <li id="foot_krm_0449_32"><a href="#ref_krm_0449_32">↑</a> [तत्पक्षाश्रिता]</li> <li id="foot_krm_0449_33"><a href="#ref_krm_0449_33">↑</a> [[१। ‘ग्रहवृदृनिश्चिगमश्च’ (३-३-५८) इत्यप्। घञ्पवादः।]]</li> <li id="foot_krm_0449_34"><a href="#ref_krm_0449_34">↑</a> [[२। ‘उदि ग्रहः’ (३-३-३५) इति घञ्। अबपवादः।]]</li> <li id="foot_krm_0449_35"><a href="#ref_krm_0449_35">↑</a> [मल्लस्य]</li> <li id="foot_krm_0449_36"><a href="#ref_krm_0449_36">↑</a> [[३। ‘समि मुष्टौ’ (३-३-३६) इति घञ्। अबपवादः। अन्यत्र ‘द्रव्यस्य सङ्ग्रहः’ इत्येव।]]</li> <li id="foot_krm_0449_37"><a href="#ref_krm_0449_37">↑</a> [द्रव्यस्य]</li> <li id="foot_krm_0449_38"><a href="#ref_krm_0449_38">↑</a> [[४। ‘आक्रोशेऽवन्योर्ग्रहः’ (३-३-४५) इति घञ्। आक्रोशादन्यत्र, ‘अवग्रहः पदस्य, निग्रहः चोरस्य’ इत्यत्र अबेव।]]</li> <li id="foot_krm_0449_39"><a href="#ref_krm_0449_39">↑</a> [पदस्य]</li> <li id="foot_krm_0449_40"><a href="#ref_krm_0449_40">↑</a> [चोरस्य]</li> <li id="foot_krm_0449_41"><a href="#ref_krm_0449_41">↑</a> [[५। ‘प्रे लिप्सायाम्’ (३-३-४६) इति घञ्। ‘पात्रप्रग्राहेण चरति भिक्षुः’ इत्यत्र लिप्सा गम्यते।]]</li> <li id="foot_krm_0449_42"><a href="#ref_krm_0449_42">↑</a> [[६। ‘परौ यज्ञे’ (३-३-४७) इति घञ्। ‘उत्तरं परिग्राहं परिगृह्णाति’ इति श्रुतिः। यज्ञविषयादन्यत्र परिग्रहः इत्येव। ‘पत्नीपरिजनादानमूलशापाः परिग्रहाः।’ इति अमरः।]]</li> <li id="foot_krm_0449_43"><a href="#ref_krm_0449_43">↑</a> [धान्यस्य]</li> <li id="foot_krm_0449_44"><a href="#ref_krm_0449_44">↑</a> [[७। ‘अवे ग्रहो वर्षप्रतिबन्धे’ (३-३-५१) इति वा घञ्। पक्षेऽप्।]]</li> <li id="foot_krm_0449_45"><a href="#ref_krm_0449_45">↑</a> [[आ। ‘रावणावग्रहक्लान्तम् इति वागमृतेन सः। अभिवृष्य मरुत्सस्यं कृष्णमेघस्तिरोदधे।।’ रघुवंशे १०-४८।]]</li> <li id="foot_krm_0449_46"><a href="#ref_krm_0449_46">↑</a> [[८। ‘प्रे वणिजाम्’ (३-३-५२) इति वा घञ्। तुलाप्रग्राहेण चरति वणिक्।]]</li> <li id="foot_krm_0449_47"><a href="#ref_krm_0449_47">↑</a> [[B। ‘वणिक् प्रग्राहवान् यद्वत् काले चरति सिद्धये। देशापेक्षास्तथा यूयं यातादायाङ्गुलीयकम्।।’ भ। का। ७-४९।]]</li> <li id="foot_krm_0449_48"><a href="#ref_krm_0449_48">↑</a> [अश्वस्य]</li> <li id="foot_krm_0449_49"><a href="#ref_krm_0449_49">↑</a> [[९। ‘रश्मौ च’ (३-३-५३) इति वा घञ्। ‘प्रग्राहः = खलीसूत्रम्।’ इति प्रक्रियाकौमुदीव्याख्यायाम्।]]</li> <li id="foot_krm_0449_50"><a href="#ref_krm_0449_50">↑</a> [अक्षः]</li> <li id="foot_krm_0449_51"><a href="#ref_krm_0449_51">↑</a> [[१०। ‘अक्षेषु ग्लहः’ (३-३-७०) इत्यनेन ग्रहेः अप्प्रत्ययसन्नियोगेन रेफस्य लत्वं निपात्यते। यत् पणरूपेण ग्राह्यं तत् ग्लहः इति बोध्यम्।]]</li> <li id="foot_krm_0449_52"><a href="#ref_krm_0449_52">↑</a> [[C। ‘मुग्धत्वादविदितकैतवप्रयोगा गच्छन्त्यः सपदि पराजयं तरुण्यः। ताः कान्तैः सह करपुष्करेरिताम्बु व्यात्युक्षीमभिसरणग्लहामदीव्यन्।।’ शिशुपालवधे ८-३२।]]</li> <li id="foot_krm_0449_53"><a href="#ref_krm_0449_53">↑</a> [पृष्ठम्०४३९+ २२]</li> <li id="foot_krm_0449_54"><a href="#ref_krm_0449_54">↑</a> [[१। ‘तितुत्रेष्वग्रहादीनामिति वक्तव्यम्’ (वा। ७-२-९) इति वचनात् इण्णिषेधो न। दीर्घः, सम्प्रसारणम्।]]</li> <li id="foot_krm_0449_55"><a href="#ref_krm_0449_55">↑</a> [[२। ‘रुदविदमुषग्रहिस्वपिप्रच्छः संश्च’ (१-२-८) इति कित्त्वम्। ‘न क्त्वा सेट्’ (१-२-१८) इत्यस्यापवादः। सम्प्रसारणादिकं ज्ञेयम्।]]</li> <li id="foot_krm_0449_56"><a href="#ref_krm_0449_56">↑</a> [[३। ‘समूलाकृतजीवेषु हङ्कृञ्ग्रहः’ (३-४-३६) इति णमुल्। ‘कषादिषु यथा- विधि--’ (३-४-४६) इत्यनुप्रयोगः। जीवन्तं गृह्णातीत्यर्थः।]]</li> <li id="foot_krm_0449_57"><a href="#ref_krm_0449_57">↑</a> [[आ। ‘भिन्नानस्त्रैर्मोहभाजोऽभिजातान् हन्तुं लोलं वारयन्तः स्ववर्गम्। जीवग्राहं ग्राहयामासुरन्ये योग्येनार्थः कस्य न स्याज्जनेन।।’ शिशुपालवधै १८-६६।]]</li> <li id="foot_krm_0449_58"><a href="#ref_krm_0449_58">↑</a> [गृह्णाति]</li> <li id="foot_krm_0449_59"><a href="#ref_krm_0449_59">↑</a> [[४। ‘नाम्न्यादिशिग्रहोः’ (३-४-५८) इति द्वितीयान्ते उपपदे णमुल्।]]</li> <li id="foot_krm_0449_60"><a href="#ref_krm_0449_60">↑</a> [[B। ‘सम्प्राप्य राक्षससभं चक्रन्द क्रोधविह्वला। नामग्राहमरोदीत् सा भ्रातरौ रावणान्तिके।।’ भ। का। ५-५।]]</li> <li id="foot_krm_0449_61"><a href="#ref_krm_0449_61">↑</a> [आह्वयति]</li> <li id="foot_krm_0449_62"><a href="#ref_krm_0449_62">↑</a> [[५। ‘हस्ते वर्तिग्रहोः’ (३-४-३९) इति करणे उपपदे णमुल्। हस्तेन गृह्णातीत्यर्थः। हस्तशब्दः अर्थग्रहणार्थः। तेन करग्राहं गृह्णातीत्यपि उदाहार्यम्। कषादित्वात् (३-४-४६) पूर्ववत् यथाविध्यनुप्रयोगः।]]</li> <li id="foot_krm_0449_63"><a href="#ref_krm_0449_63">↑</a> [गृह्णाति]</li> <li id="foot_krm_0449_64"><a href="#ref_krm_0449_64">↑</a> [[६। ‘द्वितीयायां च’ (३-४-५३) इति परीप्सायां गम्यमानायां णमुल्। एवं नाम त्वरन्ते, यदायुधग्रहणमपि नाद्रियन्ते, यष्ट्यादिकं यत्किञ्चिदासन्नं तद्गृहीत्वा युष्यन्तीत्यर्थः।]]</li> <li id="foot_krm_0449_65"><a href="#ref_krm_0449_65">↑</a> [युध्यन्ति]</li> <li id="foot_krm_0449_66"><a href="#ref_krm_0449_66">↑</a> [[७। ‘समासत्तौ’ (३-४-५०) इति सप्तम्यां तृतीयायां चोपपदे समासत्तौ गम्यमानायां णमुल्।]]</li> <li id="foot_krm_0449_67"><a href="#ref_krm_0449_67">↑</a> [पृष्ठम्०४४०+ २५]</li></ul></p>

