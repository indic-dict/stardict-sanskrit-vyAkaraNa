<ul><li><sup id="ref_krm_0661_01"><a href="#foot_krm_0661_01">1</a></sup> {@“डीङ्विहायसा गतौ”@} <sup id="ref_krm_0661_02"><a href="#foot_krm_0661_02">2</a></sup> <sup id="ref_krm_0661_03"><a href="#foot_krm_0661_03">3</a></sup> ‘विहायसां गतौ’ इति देवसम्मतं पाठमनूद्य, ‘विहायसां = विहगानाम्’ इति पुरुषकारे व्याख्यातम्। </li> <li>‘आकाशगतौ’ इति, ‘विहायसि गतौ’ इति च केचिदर्थं वर्णयन्ति।]] ‘विहायसां गतौ डीङो डयते डीयते पदे।।’ <sup id="ref_krm_0661_04"><a href="#foot_krm_0661_04">4</a></sup> इति देवः। </li> <li><sup id="ref_krm_0661_05"><a href="#foot_krm_0661_05">5</a></sup> डायकः-यिका, डायकः-यिका, <sup id="ref_krm_0661_06"><a href="#foot_krm_0661_06">6</a></sup> डिडयिषकः-षिका, डेडीयकः-यिका;</li> <li>  डयिता-त्री, डाययिता-त्री, डिडयिषिता-त्री, डेडीयिता-त्री;</li> <li>  -- डाययन्-न्ती, डाययिष्यन्-न्ती-ती;</li> <li>  -- -- <sup id="ref_krm_0661_07"><a href="#foot_krm_0661_07">7</a></sup> डयमानः, डाययमानः, डिडयिषमाणः, डेडीयमानः;</li> <li>  डयिष्यमाणः, डाययिष्यमाणः, डिडयिषिष्यमाणः, डेडीयिष्यमाणः;</li> <li>  उड्डीः- <sup id="ref_krm_0661_08"><a href="#foot_krm_0661_08">8</a></sup> उड्ड्यौ-उड्ड्यः;</li> <li>  -- -- <sup id="ref_krm_0661_09"><a href="#foot_krm_0661_09">9</a></sup> डयितः-डियितः-तम्, डायितः, डिडयिषितः, डेडीयितः-तवान्;</li> <li>  डयः, डायः, डिडयिषुः, <sup id="ref_krm_0661_10"><a href="#foot_krm_0661_10">10</a></sup> डेड्यः;</li> <li>  डयितव्यम्, डाययितव्यम्, डिडयिषितव्यम्, डेडीयितव्यम्;</li> <li>  डयनीयम्, डायनीयम्, डिडयिषणीयम्, डेडीयनीयम्;</li> <li>  डेयम्, डाय्यम्, डिडयिष्यम्, डेडीय्यम्;</li> <li>  ईषड्डयः-दुर्डयः-सुडयः;</li> <li>  -- -- -- डीयमानः, डाय्यमानः, डिडयिष्यमाणः, डेडीय्यमानः;</li> <li>  <sup id="ref_krm_0661_11"><a href="#foot_krm_0661_11">11</a></sup> डयः, डायः, डिडयिषः, डेडीयः;</li> <li>  डयितुम्, डाययितुम्, डिडयिषितुम्, डेडीयितुम्;</li> <li>  <sup id="ref_krm_0661_12"><a href="#foot_krm_0661_12">12</a></sup> डीतिः <sup id="ref_krm_0661_13"><a href="#foot_krm_0661_13">13</a></sup> सुडीतिः, डायना, डिडयिषा, डेडीया;</li> <li>  डयनम्, डायनम्, डिडयिषणम्, डेडीयनम्;</li> <li>  डयित्वा, डाययित्वा, डिडयिषित्वा, डेडीयित्वा;</li> <li>  उड्डीय, उड्डाय्य, उड्डिडयिष्य, उड्डेडीय्य;</li> <li>  डायम् २, डयित्वा २, डायम् २, डाययित्वा २, डिडयिषम् २, डिडयिषित्वा २, डेडीयम् २;</li> <li>  डेडीयित्वा २। <sup id="ref_krm_0661_14"><a href="#foot_krm_0661_14">14</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0661_01"><a href="#ref_krm_0661_01">↑</a> (६५१)</li> <li id="foot_krm_0661_02"><a href="#ref_krm_0661_02">↑</a> (१-भ्वादिः-९६८-अक। सेट्। आत्म।)</li> <li id="foot_krm_0661_03"><a href="#ref_krm_0661_03">↑</a> [[[आ]</li> <li id="foot_krm_0661_04"><a href="#ref_krm_0661_04">↑</a> (श्लो। २०)</li> <li id="foot_krm_0661_05"><a href="#ref_krm_0661_05">↑</a> [[१। ‘अचो ञ्णिति’ (७-२-११५) इति वृद्धौ, आयादेशः।]]</li> <li id="foot_krm_0661_06"><a href="#ref_krm_0661_06">↑</a> [[२। अस्य धातोरुदात्तत्वात् सन इडागमो भवति। उत्तरखण्डे गुणायादेशौ। एवं सन्नन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0661_07"><a href="#ref_krm_0661_07">↑</a> [पृष्ठम्०६०७+ २४]</li> <li id="foot_krm_0661_08"><a href="#ref_krm_0661_08">↑</a> [[१। क्विपि, द्विवचने, ‘एरनेकाचः--’ (६-४-८२) इति यणादेशः।]]</li> <li id="foot_krm_0661_09"><a href="#ref_krm_0661_09">↑</a> [[२। ‘निष्ठा शीङ्--’ (१-२-१९) इत्यत्र ‘निष्ठा’ इति योगविभागमभ्युपगम्य, अन्यत्रापि क्वचित् सेटो निष्ठायाः कित्त्वनिषेधात् गुणायादेशयोः सतोः डयितः- डयितवान् इति रूपं पारायणिकाः साधयन्ति। योगविभागानभ्युपगमे, ‘अचि श्नुधातु--’ (६-४-७७) इतीयाङादेशे डियितः-डियितवान् इति रूपमिति केचिद्वर्णयन्ति।]]</li> <li id="foot_krm_0661_10"><a href="#ref_krm_0661_10">↑</a> [[३। यङन्तात् पचाद्यचि, यङो लुकि, ‘एरनेकाचः--’ (६-४-८२) इति यणादेशः।]]</li> <li id="foot_krm_0661_11"><a href="#ref_krm_0661_11">↑</a> [[४। ‘एरच्’ (३-३-५६) इति भावे घञपवादोऽच्प्रत्ययः।]]</li> <li id="foot_krm_0661_12"><a href="#ref_krm_0661_12">↑</a> [[५। ‘तितुत्र--’ (७-२-९) इतीण्णिषेधः।]]</li> <li id="foot_krm_0661_13"><a href="#ref_krm_0661_13">↑</a> [[आ। ‘पूताखिलं मूतबलिं सुडीतौ तार्क्ष्ये स्थितं प्राप्य तरामि मायाम्।।’ धा। का। २। ३७।]]</li> <li id="foot_krm_0661_14"><a href="#ref_krm_0661_14">↑</a> [पृष्ठम्०६०८+ २८]</li></ul></p>

डीङ्|डायकः-यिका|डिडयिषकः-षिका|डेडीयकः-यिका|डयिता-त्री|डाययिता-त्री|डिडयिषिता-त्री|डेडीयिता-त्री|निष्ठायाम्-डीनः|डीनवान्
<ul><li><sup id="ref_krm_0662_01"><a href="#foot_krm_0662_01">1</a></sup> {@“डीङ् विहायसा गतौ”@} <sup id="ref_krm_0662_02"><a href="#foot_krm_0662_02">2</a></sup> स्वादिः। </li> <li>“विहायसां गतौ डीङो डयते डीयते पदे।।” <sup id="ref_krm_0662_03"><a href="#foot_krm_0662_03">3</a></sup> इति देवः। </li> <li>डायकः-यिका, डायकः-यिका, डिडयिषकः-षिका, डेडीयकः-यिका;</li> <li>  डयिता-त्री, डाययिता-त्री, डिडयिषिता-त्री, डेडीयिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकडीङ् <sup id="ref_krm_0662_04"><a href="#foot_krm_0662_04">4</a></sup> धातुवत् बोध्यानि। </li> <li>अस्य दिवादौ पाठात् डीयमानः इति शानचि श्यन् भवति। </li> <li>निष्ठायाम्- <sup id="ref_krm_0662_05"><a href="#foot_krm_0662_05">5</a></sup> डीनः, डीनवान्;</li> <li>  इति रूपे भवतः। </li> <li>अस्य स्वादिषु पाठसामर्थ्यात् ‘स्वादय ओदितः’ <sup id="ref_krm_0662_06"><a href="#foot_krm_0662_06">6</a></sup> इति ओदित्त्वातिदेशात् ‘ओदितश्च’ <sup id="ref_krm_0662_07"><a href="#foot_krm_0662_07">7</a></sup> इति निष्ठानत्वं भवति। </li> <li>अस्य धातोः उदात्तत्वेऽपि स्वादिषु पाठसामर्थ्यात् निष्ठायाम् इडभावो बोध्यः। </li> <li>यदि इडागमः स्यात् तेन व्यवधानान्नत्वं न भवेत्। </li> <li>ततश्च स्वादिपाठो विफलः स्यात्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0662_01"><a href="#ref_krm_0662_01">↑</a> (६५२)</li> <li id="foot_krm_0662_02"><a href="#ref_krm_0662_02">↑</a> (४-दिवादिः-११३५। अक। सेट्। आत्म।)</li> <li id="foot_krm_0662_03"><a href="#ref_krm_0662_03">↑</a> (श्लो। २०)</li> <li id="foot_krm_0662_04"><a href="#ref_krm_0662_04">↑</a> (६५१)</li> <li id="foot_krm_0662_05"><a href="#ref_krm_0662_05">↑</a> [[आ। ‘किं सूयसे गिरमदून नितान्तदीना- मुड्डीनकाकसम भूपतिधीनमेतत्।’ धा। का। २। ५८।]]</li> <li id="foot_krm_0662_06"><a href="#ref_krm_0662_06">↑</a> (ग। सू। दिवादिः)</li> <li id="foot_krm_0662_07"><a href="#ref_krm_0662_07">↑</a> (८-२-४५)</li></ul></p>

