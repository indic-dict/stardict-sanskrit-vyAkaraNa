<ul><li><sup id="ref_krm_0181_01"><a href="#foot_krm_0181_01">1</a></sup> {@“कल गतौ संख्याने च”@} <sup id="ref_krm_0181_02"><a href="#foot_krm_0181_02">2</a></sup> इति देवः। </li> <li><sup id="ref_krm_0181_03"><a href="#foot_krm_0181_03">3</a></sup> कलकः-लिका, <sup id="ref_krm_0181_04"><a href="#foot_krm_0181_04">4</a></sup> चिकलयिषकः-षिका;</li> <li>  कलयिता-त्री, चिकलयिषिता-त्री;</li> <li>  कलयन्-न्ती, चिकलयिषन्-न्ती;</li> <li>  कलयिष्यन्-न्ती-ती, चिकलयिषिष्यन्-न्ती-ती;</li> <li>  कलयमानः, चिकलयिषमाणः;</li> <li>  कलयिष्यमाणः, चिकलयिषिष्यमाणः;</li> <li>  कल्-कलौ-कलः;</li> <li>  -- कलितम्-तः, चिकलयिषितः-तवान्;</li> <li>  कलः, चिकलयिषुः;</li> <li>  कलयितव्यम्, चिकलयिषितव्यम्;</li> <li>  कलनीयम्, चिकलयिषणीयम्;</li> <li>  ईषत्कलः-दुष्कलः-सुकलः;</li> <li>  -- कल्यम्, चिकलयिष्यम्;</li> <li>  कल्यमानः, चिकलयिष्यमाणः;</li> <li>  कलः, चिकलयिषः;</li> <li>  कलयितुम्, चिकलयिषितुम्;</li> <li>  कलना, चिकलयिषा;</li> <li>  सङ्कलनम्, चिकलयिषणम्;</li> <li>  <sup id="ref_krm_0181_05"><a href="#foot_krm_0181_05">5</a></sup> कलयित्वा, चिकलयिषित्वा;</li> <li>  <sup id="ref_krm_0181_06"><a href="#foot_krm_0181_06">6</a></sup> सङ्कलय्य, प्रचिकलयिष्य;</li> <li>  कलम् २, कलयित्वा २, चिकलयिषम् २;</li> <li>  चिकलयिषित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0181_01"><a href="#ref_krm_0181_01">↑</a> (१७६)</li> <li id="foot_krm_0181_02"><a href="#ref_krm_0181_02">↑</a> (१०-चुरादिः-१८६६। सक। सेट्। उभ। अदन्तः। ‘कलेः कालयति क्षेपे, गतिसंख्यानयोर्द्वयोः। कलयेत्, शब्दसंख्यानविषये कलते शपि।।’ (श्लो। १५५)</li> <li id="foot_krm_0181_03"><a href="#ref_krm_0181_03">↑</a> [[१। अत्र सर्वत्र अल्लोपस्य स्थानिवत्त्वात् उपधावृद्धिर्न।]]</li> <li id="foot_krm_0181_04"><a href="#ref_krm_0181_04">↑</a> [[१। अत्र सर्वत्र अल्लोपस्य स्थानिवत्त्वात् उपधावृद्धिर्न।]]</li> <li id="foot_krm_0181_05"><a href="#ref_krm_0181_05">↑</a> [पृष्ठम्०१७३+ २५]</li> <li id="foot_krm_0181_06"><a href="#ref_krm_0181_06">↑</a> [[१। ‘ल्यपि लघुपूर्वात्’ (६-४-५६) इति णेरयादेशः।]]</li></ul></p>

कल्ल
<ul><li><sup id="ref_krm_0182_01"><a href="#foot_krm_0182_01">1</a></sup> {@“कल्ल अव्यक्ते शब्दे”@} <sup id="ref_krm_0182_02"><a href="#foot_krm_0182_02">2</a></sup> ‘कत्थ श्लाघायाम्’ <sup id="ref_krm_0182_03"><a href="#foot_krm_0182_03">3</a></sup> इति भौवादिकधातुवत् सर्वाणि रूपाणि ज्ञेयानि। </li> <li>‘कल्ल अशब्दे’ इति धातुममुं क्षीरस्वाम्यादयः पठन्ति। </li> <li>‘अशब्दः = तूष्णीम्भावः’ इति च विवृण्वन्ति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0182_01"><a href="#ref_krm_0182_01">↑</a> (१७७)</li> <li id="foot_krm_0182_02"><a href="#ref_krm_0182_02">↑</a> (१-भ्वादिः-४९८। अक। सेट्। आत्म।)</li> <li id="foot_krm_0182_03"><a href="#ref_krm_0182_03">↑</a> (१६०)</li></ul></p>

