<ul><li><sup id="ref_krm_1155_01"><a href="#foot_krm_1155_01">1</a></sup> {@“भन्जो आमर्दने”@} <sup id="ref_krm_1155_02"><a href="#foot_krm_1155_02">2</a></sup> ‘--आमर्दे तु भनक्ति…।।’ <sup id="ref_krm_1155_03"><a href="#foot_krm_1155_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_1155_04"><a href="#foot_krm_1155_04">4</a></sup> भञ्जकः-ञ्जिका, भञ्जकः-ञ्जिका, <sup id="ref_krm_1155_05"><a href="#foot_krm_1155_05">5</a></sup> बिभङ्क्षकः-क्षिका, <sup id="ref_krm_1155_06"><a href="#foot_krm_1155_06">6</a></sup> बम्भजकः-बंभजकः-जिका;</li> <li>  <sup id="ref_krm_1155_07"><a href="#foot_krm_1155_07">7</a></sup> भङ्क्ता-भङ्क्त्री, भञ्जयिता-त्री, बिभङ्क्षिता-त्री, बम्भजिता-त्री;</li> <li>  <sup id="ref_krm_1155_08"><a href="#foot_krm_1155_08">8</a></sup> भञ्जन्-भञ्जती, भञ्जयन्-न्ती, बिभङ्क्षन्-न्ती;</li> <li>  -- भङ्क्ष्यन्-न्ती-ती, भञ्जयिष्यन्-न्ती-ती, बिभङ्क्षिष्यन्-न्ती-ती;</li> <li>  -- -- भञ्जयमानः, -- बम्भज्यमानः;</li> <li>  -- भञ्जयिष्यमाणः, -- बम्भजिष्यमाणः;</li> <li>  <sup id="ref_krm_1155_09"><a href="#foot_krm_1155_09">9</a></sup> विभक्-विभग्-विभजौ-विभजः;</li> <li>  -- -- <sup id="ref_krm_1155_10"><a href="#foot_krm_1155_10">10</a></sup> भग्नम्-भग्नः-भग्नवान्, भञ्जितः, बिभङ्क्षितः, बम्भजितः-तवान्;</li> <li>  भञ्जः, <sup id="ref_krm_1155_11"><a href="#foot_krm_1155_11">11</a></sup> प्रभञ्जनः, <sup id="ref_krm_1155_12"><a href="#foot_krm_1155_12">12</a></sup> <sup id="ref_krm_1155_13"><a href="#foot_krm_1155_13">13</a></sup> भङ्गुरः, <sup id="ref_krm_1155_14"><a href="#foot_krm_1155_14">14</a></sup> <sup id="ref_krm_1155_15"><a href="#foot_krm_1155_15">15</a></sup> <sup id="ref_krm_1155_16"><a href="#foot_krm_1155_16">16</a></sup> भञ्जानः, भञ्जः, बिभङ्क्षुः, <sup id="ref_krm_1155_17"><a href="#foot_krm_1155_17">17</a></sup> बम्भञ्जः;</li> <li>  भङ्क्तव्यम्, भञ्जयितव्यम्, बिभङ्क्षितव्यम्, बम्भजितव्यम्;</li> <li>  भञ्जनीयम्, <sup id="ref_krm_1155_18"><a href="#foot_krm_1155_18">18</a></sup> भजेलिमाः <sup id="ref_krm_1155_19"><a href="#foot_krm_1155_19">19</a></sup>, भञ्जनीयम्, बिभङ्क्षणीयम्, बम्भजनीयम्;</li> <li>  <sup id="ref_krm_1155_20"><a href="#foot_krm_1155_20">20</a></sup> भङ्ग्यम्, भञ्ज्यम्, बिभङ्क्ष्यम्, बम्भज्यम्;</li> <li>  <sup id="ref_krm_1155_21"><a href="#foot_krm_1155_21">21</a></sup> ईषद्भञ्जः-दुर्भञ्जः-सुभञ्जः;</li> <li>  -- -- भज्यमानः, भञ्ज्यमानः, बिभङ्क्ष्यमाणः, बम्भज्यमानः;</li> <li>  <sup id="ref_krm_1155_22"><a href="#foot_krm_1155_22">22</a></sup> भङ्गः-भङ्गा, भञ्जः, बिभङ्क्षः, बम्भजः;</li> <li>  भङ्क्तुम्, भञ्जयितुम्, बिभङ्क्षितुम्, बम्भजितुम्;</li> <li>  भक्तिः, <sup id="ref_krm_1155_23"><a href="#foot_krm_1155_23">23</a></sup> सालभञ्जिका, <sup id="ref_krm_1155_24"><a href="#foot_krm_1155_24">24</a></sup> उद्दालकपुष्पभञ्जिका, भञ्जना, बिभङ्क्षा, बम्भजा;</li> <li>  भञ्जनम्, भञ्जनम्, बिभङ्क्षणम्, बम्भजनम्;</li> <li>  <sup id="ref_krm_1155_25"><a href="#foot_krm_1155_25">25</a></sup> भङ्क्त्वा <sup id="ref_krm_1155_26"><a href="#foot_krm_1155_26">26</a></sup> -भक्त्वा, भञ्जयित्वा, बिभङ्क्षित्वा, बम्भजित्वा;</li> <li>  विभज्य, विभञ्ज्य, विबिभङ्क्ष्य, विबम्भज्य;</li> <li>  <sup id="ref_krm_1155_27"><a href="#foot_krm_1155_27">27</a></sup> इक्षुभञ्जं, गजभञ्जं, <sup id="ref_krm_1155_28"><a href="#foot_krm_1155_28">28</a></sup> वल्लीभञ्जं <sup id="ref_krm_1155_29"><a href="#foot_krm_1155_29">29</a></sup> भञ्जम् २, भङ्क्त्वा २, भक्त्वा २, भञ्जम् २, भञ्जयित्वा २, बिभङ्क्षम् २, बिभङ्क्षित्वा २, बम्भजम् २;</li> <li>  बम्भजित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1155_01"><a href="#ref_krm_1155_01">↑</a> (११४५)</li> <li id="foot_krm_1155_02"><a href="#ref_krm_1155_02">↑</a> (७-रुधादिः-१४५३। सक। अनि। पर।)</li> <li id="foot_krm_1155_03"><a href="#ref_krm_1155_03">↑</a> (श्लो। ६५)</li> <li id="foot_krm_1155_04"><a href="#ref_krm_1155_04">↑</a> [[७। ‘नकारजावनुस्वारपञ्चमौ झलि धातुषु।’ इति अभियुक्तवचनात् उपदेशे नोप- धोऽयं धातुः। नकारस्य ‘नश्चापदान्तस्य झलि’ (८-३-२४) इत्यनुस्वारे परसवर्णे च रूपमेवम्। एवमेवोत्तरत्र तृजादिष्वपि रूपनिष्पत्तिर्ज्ञेया।]]</li> <li id="foot_krm_1155_05"><a href="#ref_krm_1155_05">↑</a> [[८। सन्नन्ताण्ण्वुलि धातुजकारस्य कुत्वे, सनः षत्वे च रूपमेवम्। एवं सन्नन्ते सर्वत्र प्रक्रिया ज्ञेया।]]</li> <li id="foot_krm_1155_06"><a href="#ref_krm_1155_06">↑</a> [[९। यङन्ताण्ण्वुलि, द्विर्वचनादिकेषु ‘जपजभदहदशभञ्जपशां च’ (७-४-८६) इति अभ्यासे नुगागमः। नुकः पदान्तवद्भाववचनात् परसवर्णविकल्पः। तेन रूपद्वयम्।]]</li> <li id="foot_krm_1155_07"><a href="#ref_krm_1155_07">↑</a> [पृष्ठम्०९४२+ २८]</li> <li id="foot_krm_1155_08"><a href="#ref_krm_1155_08">↑</a> [[१। शतरि, ‘रुधादिभ्यः--’ (३-१-७८) इति श्नमि, ‘श्नान्नलोपः’ (६-४-२३) इति धातुनकारलोपे, ‘श्नसोरल्लोपः’ (६-४-१११) इति श्नमोऽकारस्य लोपे च रूपमेवम्।]]</li> <li id="foot_krm_1155_09"><a href="#ref_krm_1155_09">↑</a> [[२। विशेषेण भनक्तीति विभक्। क्विपि नकारलोपे कुत्वे च रूपम्।]]</li> <li id="foot_krm_1155_10"><a href="#ref_krm_1155_10">↑</a> [[३। ‘ओदितश्च’ (८-२-४५) इति निष्ठानत्वे, तस्यासिद्धत्वात् पूर्वमेव ‘चोः कुः’ (८-२-३०) इति कुत्वे च रूपमेवम्।]]</li> <li id="foot_krm_1155_11"><a href="#ref_krm_1155_11">↑</a> [[४। प्रभञ्जयतीति प्रभञ्जनः = वायुः। नन्द्यादित्वात् (३-१-१३४) ण्यन्तात् कर्तरि ल्युः।]]</li> <li id="foot_krm_1155_12"><a href="#ref_krm_1155_12">↑</a> [[आ। ‘व्यत्यगच्छन् न च गतं प्रचण्डोऽपि प्रभञ्जनः।।’ भ। का। ८। ४।]]</li> <li id="foot_krm_1155_13"><a href="#ref_krm_1155_13">↑</a> [[५। ‘भञ्जभासमिदो घुरच्’ (३-२-१६१) इति तच्छीलादिषु कर्तृषु घुरच्प्रत्यये, घित्त्वेन ‘चजोः कु घिण्ण्यतोः’ (७-३-५२) इति कुत्वे च रूपमेवम्। प्रक्रियाकौमुदीव्याख्याने तु “भञ्जेः कर्मकर्तरि (प्रत्ययः) तथोक्तम् पाणिनीयमतदर्पणे-- ‘कर्मकर्तारमेवास्मादभिधत्ते स्वभावतः। न कर्ममात्रमित्येष प्रत्ययः कर्मकर्तरि।।’ इति।” इत्युक्तम्।]]</li> <li id="foot_krm_1155_14"><a href="#ref_krm_1155_14">↑</a> [[B। ‘सृपरोऽभङ्गरप्रज्ञो गृहीत्वा भासुरं धनुः।’ भ। का। ७। २२।]]</li> <li id="foot_krm_1155_15"><a href="#ref_krm_1155_15">↑</a> [शत्रुं]</li> <li id="foot_krm_1155_16"><a href="#ref_krm_1155_16">↑</a> [[६। ‘ताच्छील्यवयोवचनशक्तिषु--’ (३-२-१२९) इति चानश्प्रत्यये रूपमेवम्। न तु शानच्प्रत्ययः। अत्र ताच्छील्ये शक्तौ वा चानश्।]]</li> <li id="foot_krm_1155_17"><a href="#ref_krm_1155_17">↑</a> [[७। यङन्तात् पचाद्यचि यङो लुकि उपधानकारलोपस्य निमित्ताभावात् तस्यानुस्वारपर- सवर्णयो रूपमेवम्।]]</li> <li id="foot_krm_1155_18"><a href="#ref_krm_1155_18">↑</a> [[८। ‘केलिमर उपसंख्यानम्’ (वा। ३-१-९६) इति केलिमर्प्रत्यये, तस्य कित्त्वेनोपधान- कारलोपे च रूपमेवम्। कर्मकर्तर्ययं प्रत्यय इति वृत्तिः। भाष्ये तु कर्मंण्येवायं प्रत्यय इति ज्ञायते।]]</li> <li id="foot_krm_1155_19"><a href="#ref_krm_1155_19">↑</a> [शालयः]</li> <li id="foot_krm_1155_20"><a href="#ref_krm_1155_20">↑</a> [[९। ण्यति, ‘चजोः--’ (७-३-५२) इति कुत्वम्।]]</li> <li id="foot_krm_1155_21"><a href="#ref_krm_1155_21">↑</a> [पृष्ठम्०९४३+ २४]</li> <li id="foot_krm_1155_22"><a href="#ref_krm_1155_22">↑</a> [[१। कर्मणि घञि कुत्वे च रूपमेवम्। स्त्रियां टाप्। भङ्गा = कुसुम्भम्।]]</li> <li id="foot_krm_1155_23"><a href="#ref_krm_1155_23">↑</a> [[२। ‘संज्ञायाम्’ (३-३-१०९) इति स्त्रियामधिकरणे भावादौ ण्वुल्। एवमेव उद्दालक- पुष्पभञ्जिका इत्यत्रापि ण्वुल्। उद्दालकपुष्पाणि = श्लेष्मातकपुष्पाणि भज्यन्ते यस्यां क्रियायां सेति विवरणम्। ‘नित्यं क्रीडाजीविकयोः’ (२-२-१७) इति समासः।]]</li> <li id="foot_krm_1155_24"><a href="#ref_krm_1155_24">↑</a> [[आ। ‘धिक् सालभञ्जिकाप्रख्यान् विषयान् कल्पनारुचीन्।।’ भ। का। ७। ७४।]]</li> <li id="foot_krm_1155_25"><a href="#ref_krm_1155_25">↑</a> [[३। क्त्वायाम्, ‘जान्तनशां विभाषा’ (६-४-३२) इत्यनुनासिकलोपविकल्पः, तेन रूपद्वयम्।]]</li> <li id="foot_krm_1155_26"><a href="#ref_krm_1155_26">↑</a> [[B। ‘भङ्क्त्वा भुजौ विराधाख्यं तं तौ भुवि निचख्नतुः।।’ भ। का। ४। ३।]]</li> <li id="foot_krm_1155_27"><a href="#ref_krm_1155_27">↑</a> [[४। ‘उपमाने कर्मणि च’ (३-४-४५) इति कर्मणि, कर्तरि च णमुल्। ‘कषादिषु यथाविध्यनुप्रयोगः’ (३-४-४६) इति णमुल्प्रयोजकधातोरेव अनुप्रयोगः। ‘इक्षुभञ्जं बभञ्जासौ गजभञ्जं बभञ्ज तम्। अत्र हीक्षुमिवेत्यर्थस्तथा गज इवेत्यपि।।’ इति। प्र। सर्वस्वे।]]</li> <li id="foot_krm_1155_28"><a href="#ref_krm_1155_28">↑</a> [[C। ‘अधिशयितवानब्धिं नाथो ममन्थ बबन्ध तं हरधनुरसौ वल्लीभञ्जं बभञ्ज च मैथिलि।’ श्रीगुणरत्नकोशे ५४।]]</li> <li id="foot_krm_1155_29"><a href="#ref_krm_1155_29">↑</a> [वा बभञ्ज।]</li></ul></p>

भर्त्स|भर्त्सकः-र्त्सिका|बिभर्त्सयिषकः-षिका
<ul><li><sup id="ref_krm_1156_01"><a href="#foot_krm_1156_01">1</a></sup> {@“भर्त्स तर्जने”@} <sup id="ref_krm_1156_02"><a href="#foot_krm_1156_02">2</a></sup> आकुस्मीयः। </li> <li>भर्त्सकः-र्त्सिका, बिभर्त्सयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादि- <sup id="ref_krm_1156_03"><a href="#foot_krm_1156_03">3</a></sup> ककुत्सयतिवत् <sup id="ref_krm_1156_04"><a href="#foot_krm_1156_04">4</a></sup> ज्ञेयानि। </li> <li>ण्यति- <sup id="ref_krm_1156_05"><a href="#foot_krm_1156_05">5</a></sup> प्रभर्त्स्यः इति। </li> <li><sup id="ref_krm_1156_06"><a href="#foot_krm_1156_06">6</a></sup> भर्त्सयमानः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1156_01"><a href="#ref_krm_1156_01">↑</a> (११४६)</li> <li id="foot_krm_1156_02"><a href="#ref_krm_1156_02">↑</a> (१०-चुरादिः-१६८३। सक। सेट्। आत्म।)</li> <li id="foot_krm_1156_03"><a href="#ref_krm_1156_03">↑</a> [पृष्ठम्०९४४+ २७]</li> <li id="foot_krm_1156_04"><a href="#ref_krm_1156_04">↑</a> (२१७)</li> <li id="foot_krm_1156_05"><a href="#ref_krm_1156_05">↑</a> [[आ। ‘प्रस्पाश्य मुष्टिमभितर्जयते प्रभर्त्स्यो मल्लो बिबस्तयिषुरेनमगन्धनीयम्।’ धा। का। ३। ३४।]]</li> <li id="foot_krm_1156_06"><a href="#ref_krm_1156_06">↑</a> [[१। ‘आकुस्मादात्मनेपदिनः’ (ग। सू। चुरादौ) इति ण्यन्तेऽत्रात्मनेपदमेव;\n\n  तेन शानच्। क्षीरस्वामी तु ‘लक्ष्ये भर्त्सयति… इति दृश्यते।’ इत्याह। तेनास्य धातोः परस्मैपदमपि भवतीति ज्ञेयम्।]]</li></ul></p>

भर्व|भर्वकः-र्विका|बिभर्विषकः-षिका|बाभर्वकः-र्विका
<ul><li><sup id="ref_krm_1157_01"><a href="#foot_krm_1157_01">1</a></sup> {@“भर्व हिंसायाम्”@} <sup id="ref_krm_1157_02"><a href="#foot_krm_1157_02">2</a></sup> अयमीदिदपि क्वचित् पठ्यते इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li><sup id="ref_krm_1157_03"><a href="#foot_krm_1157_03">3</a></sup> भर्वकः-र्विका, भर्वकः-र्विका, बिभर्विषकः-षिका, बाभर्वकः-र्विका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककर्वतिवत् <sup id="ref_krm_1157_04"><a href="#foot_krm_1157_04">4</a></sup> बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1157_01"><a href="#ref_krm_1157_01">↑</a> (११४७)</li> <li id="foot_krm_1157_02"><a href="#ref_krm_1157_02">↑</a> (१-भ्वादिः-५८०। सक। सेट्। पर।)</li> <li id="foot_krm_1157_03"><a href="#ref_krm_1157_03">↑</a> [[B। ‘अफर्विताकाङ्क्षितमर्वकं सतां मांसादिसंचर्वकदुष्टभर्वकम्।’ धा। का। १। ७४।]]</li> <li id="foot_krm_1157_04"><a href="#ref_krm_1157_04">↑</a> (१७३-आ)</li></ul></p>

भल|भालकः-लिका|बिभलिषकः-षिका|बाभलकः-लिका
<ul><li><sup id="ref_krm_1158_01"><a href="#foot_krm_1158_01">1</a></sup> {@“भल परिभाषणहिंसादानेषु”@} <sup id="ref_krm_1158_02"><a href="#foot_krm_1158_02">2</a></sup> भालकः-लिका, भालकः-लिका, बिभलिषकः-षिका, बाभलकः-लिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि विशेषरूपाणि विना भौवादिककलतिवत् <sup id="ref_krm_1158_03"><a href="#foot_krm_1158_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1158_04"><a href="#foot_krm_1158_04">4</a></sup> भालः, ण्यति- <sup id="ref_krm_1158_05"><a href="#foot_krm_1158_05">5</a></sup> आभाल्यः इति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1158_01"><a href="#ref_krm_1158_01">↑</a> (११४८)</li> <li id="foot_krm_1158_02"><a href="#ref_krm_1158_02">↑</a> (१-भ्वादिः-४९५। सक। सेट्। आत्म।)</li> <li id="foot_krm_1158_03"><a href="#ref_krm_1158_03">↑</a> (१७४)</li> <li id="foot_krm_1158_04"><a href="#ref_krm_1158_04">↑</a> [[२। ‘अकर्तरि च कारके संज्ञायाम्’ (३-३-१९) इति संज्ञायां घञ्। भालः = ललाटः।]]</li> <li id="foot_krm_1158_05"><a href="#ref_krm_1158_05">↑</a> [[C। ‘मामल्यमानं स्मितमल्लिकावलीमाभाल्यदैत्याधिपभल्लनोद्घुरम्।’ धा। का। १। ६४।]]</li></ul></p>

भल|भालकः-लिका|बिभालयिषकः-षिका|भालयिता-त्री|बिभालयिषिता-त्री
<ul><li><sup id="ref_krm_1159_01"><a href="#foot_krm_1159_01">1</a></sup> {@“भल आभण्डने”@} <sup id="ref_krm_1159_02"><a href="#foot_krm_1159_02">2</a></sup> आकुस्मीयः। </li> <li>आभण्डनम् = निरूपणम्। </li> <li>‘मार्जनम्’ इति धा। </li> <li>का। </li> <li><sup id="ref_krm_1159_03"><a href="#foot_krm_1159_03">3</a></sup>। </li> <li>भालकः-लिका, बिभालयिषकः-षिका, भालयिता-त्री, बिभालयिषिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकगालयतिवत् <sup id="ref_krm_1159_04"><a href="#foot_krm_1159_04">4</a></sup> ज्ञेयानि। </li> <li>ल्युटि- <sup id="ref_krm_1159_05"><a href="#foot_krm_1159_05">5</a></sup> भालनम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1159_01"><a href="#ref_krm_1159_01">↑</a> (११४९)</li> <li id="foot_krm_1159_02"><a href="#ref_krm_1159_02">↑</a> (१०-चुरादिः-१७०१। अक। सेट्। आत्म।)</li> <li id="foot_krm_1159_03"><a href="#ref_krm_1159_03">↑</a> (३-३६)</li> <li id="foot_krm_1159_04"><a href="#ref_krm_1159_04">↑</a> (३८८)</li> <li id="foot_krm_1159_05"><a href="#ref_krm_1159_05">↑</a> [[ड्। ‘… दुष्कीर्तिभालनपराः खलु कूटवृत्त्या।’ धा। का। ३। ३६।]]</li></ul></p>

भल्ल|भल्लकः-ल्लिका|बिभल्लिषकः-षिका|बाभल्लकः-ल्लिका
<ul><li><sup id="ref_krm_1160_01"><a href="#foot_krm_1160_01">1</a></sup> {@“भल्ल परिभाषणहिंसादानेषु”@} <sup id="ref_krm_1160_02"><a href="#foot_krm_1160_02">2</a></sup> भल्लकः-ल्लिका, भल्लकः-ल्लिका, बिभल्लिषकः-षिका, बाभल्लकः-ल्लिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककड्डतिवत् <sup id="ref_krm_1160_03"><a href="#foot_krm_1160_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1160_04"><a href="#foot_krm_1160_04">4</a></sup> <sup id="ref_krm_1160_05"><a href="#foot_krm_1160_05">5</a></sup> भल्लः-भल्ली, <sup id="ref_krm_1160_06"><a href="#foot_krm_1160_06">6</a></sup> भल्लूकः, <sup id="ref_krm_1160_07"><a href="#foot_krm_1160_07">7</a></sup> भल्लनः, <sup id="ref_krm_1160_08"><a href="#foot_krm_1160_08">8</a></sup> भल्लटः, इमानि रूपाण्यधिकान्यत्रेति विशेषः। </li> <li>ल्युटि- <sup id="ref_krm_1160_09"><a href="#foot_krm_1160_09">9</a></sup> भल्लनम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1160_01"><a href="#ref_krm_1160_01">↑</a> (११५०)</li> <li id="foot_krm_1160_02"><a href="#ref_krm_1160_02">↑</a> (१-भ्वादिः-४९६। सक। सेट्। आत्म।)</li> <li id="foot_krm_1160_03"><a href="#ref_krm_1160_03">↑</a> (१५६)</li> <li id="foot_krm_1160_04"><a href="#ref_krm_1160_04">↑</a> [पृष्ठम्०९४५+ २८]</li> <li id="foot_krm_1160_05"><a href="#ref_krm_1160_05">↑</a> [[१। भल्यते हिंस्यतेऽनेनेति, ‘पुंसि संज्ञायाम्--’ (३-३-११८) इति घः। ‘हलश्च’ (३-३-१२१) इति वा घञ् प्रत्यये रूपमेवम्। भल्लः = आयुधविशेषः। ‘जातेरस्त्री- विषयादयोपधात्’ (४-१-६३) इति स्त्रियां ङीष्प्रत्यये भल्ली इति रूपम्।]]</li> <li id="foot_krm_1160_06"><a href="#ref_krm_1160_06">↑</a> [[२। ‘उलूकादयश्च’ (द। उ। ३-१६) इति ऊकप्रत्यये रूपमेवम्। भल्लूकः = ऋक्षः।]]</li> <li id="foot_krm_1160_07"><a href="#ref_krm_1160_07">↑</a> [[३। ‘अनुदात्तेतश्च हलादेः’ (३-२-१४९) इति ताच्छीलिको युच्प्रत्ययः।]]</li> <li id="foot_krm_1160_08"><a href="#ref_krm_1160_08">↑</a> [[४। बाहुलकादौणादिके अटप्रत्यये रूपमेवम्। भल्लते = परितो भाषतेऽयमिति भल्लटः = कविविशेषः।]]</li> <li id="foot_krm_1160_09"><a href="#ref_krm_1160_09">↑</a> [[आ। ‘मामल्यमानं स्मितमल्लिकावलीमाभाल्यदैत्याधि{??} भल्लनोद्धुरम्।’ धा। का। १। ६४]]</li></ul></p>

भष|द्रुमेभाषकः-षिका|भाषकः-षिका|बिभषिषकः-षिका|बाभषकः-षिका
<ul><li><sup id="ref_krm_1161_01"><a href="#foot_krm_1161_01">1</a></sup> {@“भष भर्त्सने”@} <sup id="ref_krm_1161_02"><a href="#foot_krm_1161_02">2</a></sup> ‘भर्त्सनम् = श्वरवः, यतस्तत्रैवायं <sup id="ref_krm_1161_03"><a href="#foot_krm_1161_03">3</a></sup> प्रसिद्धः।’ इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>क्षीरस्वामी तु कुत्सितशब्दकरणार्थकत्वमस्याह। </li> <li>‘भष् बुक्के पिशुनोक्तौ…।।’ क। </li> <li>क। </li> <li>द्रुमे <sup id="ref_krm_1161_04"><a href="#foot_krm_1161_04">4</a></sup> भाषकः-षिका, भाषकः-षिका, बिभषिषकः-षिका;</li> <li>  बाभषकः-षिका;</li> <li>  इत्यादीनि सर्वाणि रूपाणि भौवादिककषतिवत्, <sup id="ref_krm_1161_05"><a href="#foot_krm_1161_05">5</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1161_06"><a href="#foot_krm_1161_06">6</a></sup> भषः-भषी, <sup id="ref_krm_1161_07"><a href="#foot_krm_1161_07">7</a></sup> भषकः-भषिका, इमानि रूपाण्यधिकान्यत्रेति विशेषः। </li> <li><sup id="ref_krm_1161_08"><a href="#foot_krm_1161_08">8</a></sup> भषन्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1161_01"><a href="#ref_krm_1161_01">↑</a> (११५१)</li> <li id="foot_krm_1161_02"><a href="#ref_krm_1161_02">↑</a> (१-भ्वादिः-६९५। अक। सेट्। पर।)</li> <li id="foot_krm_1161_03"><a href="#ref_krm_1161_03">↑</a> (धातुः)</li> <li id="foot_krm_1161_04"><a href="#ref_krm_1161_04">↑</a> (श्लो। ३२०)</li> <li id="foot_krm_1161_05"><a href="#ref_krm_1161_05">↑</a> (१७९)</li> <li id="foot_krm_1161_06"><a href="#ref_krm_1161_06">↑</a> [[५। पचादिषु (३-१-१३४) भषट् इति पाठात् टित्त्वेन स्त्रियां ‘टिड्ढाणञ्--’ (४-१-१५) इति ङीपि भषी इति रूपम्।]]</li> <li id="foot_krm_1161_07"><a href="#ref_krm_1161_07">↑</a> [[६। ‘क्वुन् शिल्पिसंज्ञयोः--’ (द। उ। ३-५) इति क्वुन्। स्त्रियां टापि ‘प्रत्ययस्थात्--’ (७-३-४४) इतीत्वम्।]]</li> <li id="foot_krm_1161_08"><a href="#ref_krm_1161_08">↑</a> [[B। ‘… रेषोऽन्यान् भषतो नमोऽस्तु कमलाकोष्णस्तनं जोषते।।’ धा। का। १। ८७।]]</li></ul></p>

भस|परं|तु|निरुक्तेइत्युक्तत्वात्|तथा|इत्यत्र|यास्केन’|इत्येवात्रधातुस्वरूपोपादानाच्चइत्येव|पाठः|प्रामाणिक]]भासकः-सिका|भासकः-सिका|बिभसिषकः-षिका|बाभसकः-सिका|भसिता-त्री|भासयिता-त्री|बिभसिषिता-त्री|बाभसिता-त्री|बप्सत्-बप्सतौ-बप्सतः|भासयन्-न्ती-ती|बिभसिषन्-न्ती-ती|-|भसिष्यन्-न्ती-ती|भासयिष्यन्-न्ती-ती|बिभसिषिष्यन्-न्ती-ती
<ul><li><sup id="ref_krm_1162_01"><a href="#foot_krm_1162_01">1</a></sup> {@“भस भर्त्सनदीप्त्योः”@} <sup id="ref_krm_1162_02"><a href="#foot_krm_1162_02">2</a></sup> छान्दसः। </li> <li><sup id="ref_krm_1162_03"><a href="#foot_krm_1162_03">3</a></sup> धातुपाठेषु सर्वत्र ‘--भर्त्सनदीप्त्योः’ इत्येवास्य धातोरर्थनिर्देशो दृश्यते। </li> <li>परं तु निरुक्ते <sup id="ref_krm_1162_04"><a href="#foot_krm_1162_04">4</a></sup> ‘बभस्तिरत्तिकर्मा।’ इत्युक्तत्वात्;</li> <li>  तथा, ‘हरी इवान्धांसि बप्सता।’ <sup id="ref_krm_1162_05"><a href="#foot_krm_1162_05">5</a></sup> इत्यत्र यास्केन ‘हरी इवान्नानि भुञ्जाने।’ इति व्याख्यानात्, सायणभाष्येऽपि ‘भस भक्षणदीप्त्योः।’ इत्येवात्र <sup id="ref_krm_1162_06"><a href="#foot_krm_1162_06">6</a></sup> धातुस्वरूपोपादानाच्च ‘भक्षणदीप्त्योः’ इत्येव पाठः प्रामाणिक इति, भर्त्सन-भक्षणशब्दयोः प्रायस्तुल्यश्रुत्या पाठभेद इति वा प्रतिभाति।]] <sup id="ref_krm_1162_07"><a href="#foot_krm_1162_07">7</a></sup> भासकः-सिका, भासकः-सिका, बिभसिषकः-षिका, बाभसकः-सिका;</li> <li>  भसिता-त्री, भासयिता-त्री, बिभसिषिता-त्री, बाभसिता-त्री;</li> <li>  <sup id="ref_krm_1162_08"><a href="#foot_krm_1162_08">8</a></sup> बप्सत्-बप्सतौ-बप्सतः, <sup id="ref_krm_1162_09"><a href="#foot_krm_1162_09">9</a></sup> भासयन्-न्ती-ती, बिभसिषन्-न्ती-ती;</li> <li>  -- भसिष्यन्-न्ती-ती, भासयिष्यन्-न्ती-ती, बिभसिषिष्यन्-न्ती-ती;</li> <li>  -- इत्यादीनि सर्वाण्यपि रूपाणि आदादिककशतिवत् <sup id="ref_krm_1162_10"><a href="#foot_krm_1162_10">10</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1162_11"><a href="#foot_krm_1162_11">11</a></sup> नभः, <sup id="ref_krm_1162_12"><a href="#foot_krm_1162_12">12</a></sup> भस्म, <sup id="ref_krm_1162_13"><a href="#foot_krm_1162_13">13</a></sup> भस्त्रम्, <sup id="ref_krm_1162_14"><a href="#foot_krm_1162_14">14</a></sup> भसत् इतीमानि रूपाण्यस्माद् भवन्तीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1162_01"><a href="#ref_krm_1162_01">↑</a> (११५२)</li> <li id="foot_krm_1162_02"><a href="#ref_krm_1162_02">↑</a> (३-जुहोत्यादिः-११००। अक। सेट्। पर।)</li> <li id="foot_krm_1162_03"><a href="#ref_krm_1162_03">↑</a> [[[अ]</li> <li id="foot_krm_1162_04"><a href="#ref_krm_1162_04">↑</a> (५-४६)</li> <li id="foot_krm_1162_05"><a href="#ref_krm_1162_05">↑</a> (ऋ। वे। १-६-२८-७)</li> <li id="foot_krm_1162_06"><a href="#ref_krm_1162_06">↑</a> (ऋ। वे। १-६-२८-७)</li> <li id="foot_krm_1162_07"><a href="#ref_krm_1162_07">↑</a> [पृष्ठम्०९४६+ २६]</li> <li id="foot_krm_1162_08"><a href="#ref_krm_1162_08">↑</a> [[१। शतरि, शपि, तस्य ‘जुहोत्यादिभ्यः--’ (२-४-७५) इति श्लुः। ‘श्लौ’ (६-१-१०) इति द्विर्वचनम्। ‘घसिभसोर्हलि च’ (६-४-१००) इति उपधा- ऽकारलोपः। ‘खरि च’ (८-४-५५) इति भकारस्य चर्त्वेन पकारः। अभ्यासे हलादिशेषजश्त्वादिकम्।]]</li> <li id="foot_krm_1162_09"><a href="#ref_krm_1162_09">↑</a> [[२। भक्षणार्थकत्वे, ‘निगरणचलनार्थेभ्यः--’ (१-३-८७) इति ण्यन्तात् कर्तृगामिन्यपि क्रियाफले परस्मैपदमेव। दीप्त्याद्यर्थकत्वे, छान्दसत्वात् दृष्टानुविध्याश्रयणे वा शानजन्तेऽपि भासयमानः इति रूपं साध्वेवेत्यपि बोध्यम्।]]</li> <li id="foot_krm_1162_10"><a href="#ref_krm_1162_10">↑</a> (१७८)</li> <li id="foot_krm_1162_11"><a href="#ref_krm_1162_11">↑</a> [[३। न बभस्ति इति नभः = आकाशः। नञ्पूर्वादस्मात् ‘अन्येभ्योऽपि दृश्यते’ (३-२-१७८) इति क्विपि सकारस्य रुत्वे विसर्गे च रूपमिति आत्रेयादयः साधयन्तीति माधवधातुवृत्तौ दृश्यते। अत्र बाहुलकात् नञ्समासे नलोपाभाव इति बोध्यम्।]]</li> <li id="foot_krm_1162_12"><a href="#ref_krm_1162_12">↑</a> [[४। भाषायामपि, ‘अन्येभ्योऽपि दृश्यन्ते’ (३-२-७५) इति मनिन्प्रत्यये ‘नेड् वशि कृति’ (७-२-८) इतीण्निषेधे रूपमेवम्। ‘भूतेऽपि दृश्यन्ते’ (३-३-२) इति भूते- ऽयं प्रत्ययः। भसितम् = भस्म।]]</li> <li id="foot_krm_1162_13"><a href="#ref_krm_1162_13">↑</a> [[५। ‘हुयामाश्रुभसिभ्यस्त्रन्’ (द। उ। ८-८४) इति त्रन्प्रत्यये रूपमेवम्। ‘तितुत्रत--’ (७-२-९) इतीण्निषेधः। बभस्तीति भस्त्रम् = चर्म, उदरं च।]]</li> <li id="foot_krm_1162_14"><a href="#ref_krm_1162_14">↑</a> [[६। ‘शॄदॄभसोऽदिः’ (द। उ। ६-४२) इत्यदिप्रत्यये रूपमेवम्। बभस्ति, भस्यते वा तस्मिन् आहार इति भसत् = आमाशयस्थानम्।]]</li></ul></p>

