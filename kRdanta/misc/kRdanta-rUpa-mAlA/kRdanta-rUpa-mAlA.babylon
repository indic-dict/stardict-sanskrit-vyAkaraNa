<ul><li><sup id="ref_krm_0077_01"><a href="#foot_krm_0077_01">1</a></sup> {@“इष इच्छायाम्”@} <sup id="ref_krm_0077_02"><a href="#foot_krm_0077_02">2</a></sup> <sup id="ref_krm_0077_03"><a href="#foot_krm_0077_03">3</a></sup> ‘इष्णात्याभीक्ष्ण्ये, इच्छायां इच्छेद्, गत्यर्थ इष्यति।’ <sup id="ref_krm_0077_04"><a href="#foot_krm_0077_04">4</a></sup> इति देवः। </li> <li>एषकः-षिका, <sup id="ref_krm_0077_05"><a href="#foot_krm_0077_05">5</a></sup> एषिषिषकः-षिका;</li> <li>  एष्टव्यम्;</li> <li>  <sup id="ref_krm_0077_06"><a href="#foot_krm_0077_06">6</a></sup> एष्टा-ष्ट्री, <sup id="ref_krm_0077_07"><a href="#foot_krm_0077_07">7</a></sup> एषिता-त्री;</li> <li>  एषितव्यम्;</li> <li>  <sup id="ref_krm_0077_08"><a href="#foot_krm_0077_08">8</a></sup> इच्छन्- <sup id="ref_krm_0077_09"><a href="#foot_krm_0077_09">9</a></sup> न्ती-ती;</li> <li>  एषणीयम्;</li> <li>  एषिष्यन्-न्ती-ती;</li> <li>  एष्यम्;</li> <li>  <sup id="ref_krm_0077_10"><a href="#foot_krm_0077_10">10</a></sup> इट्-इड्-इषौ-इषः;</li> <li>  ईषदेषः-दुरेषः-स्वेषः;</li> <li>  <sup id="ref_krm_0077_11"><a href="#foot_krm_0077_11">11</a></sup> इष्टः-ष्टम्-ष्टवान्;</li> <li>  इष्यमाणः;</li> <li>  इषः, एषः, एषिषिषुः, <sup id="ref_krm_0077_12"><a href="#foot_krm_0077_12">12</a></sup> इच्छुः <sup id="ref_krm_0077_13"><a href="#foot_krm_0077_13">13</a></sup>;</li> <li>  <sup id="ref_krm_0077_14"><a href="#foot_krm_0077_14">14</a></sup> शरणैषी <sup id="ref_krm_0077_15"><a href="#foot_krm_0077_15">15</a></sup> एषः;</li> <li>  एष्टुम्--एषितुम्;</li> <li>  <sup id="ref_krm_0077_16"><a href="#foot_krm_0077_16">16</a></sup> इष्टि <sup id="ref_krm_0077_17"><a href="#foot_krm_0077_17">17</a></sup>ः, <sup id="ref_krm_0077_18"><a href="#foot_krm_0077_18">18</a></sup> इच्छा <sup id="ref_krm_0077_19"><a href="#foot_krm_0077_19">19</a></sup>;</li> <li>  प्रेष्य;</li> <li>  एषणम्, एषणी <sup id="ref_krm_0077_20"><a href="#foot_krm_0077_20">20</a></sup>;</li> <li>  एषम् २, एषित्वा २, इष्ट्वा २, एषित्वा;</li> <li>  इष्ट्वा;</li> <li>  इष्टका <sup id="ref_krm_0077_21"><a href="#foot_krm_0077_21">21</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0077_01"><a href="#ref_krm_0077_01">↑</a> (७५)</li> <li id="foot_krm_0077_02"><a href="#ref_krm_0077_02">↑</a> (६-तुदादिः-१३५१-सक। सेट्। पर।)</li> <li id="foot_krm_0077_03"><a href="#ref_krm_0077_03">↑</a> [[(अ) केचिदमुं धातुमुदितं पठन्ति। तत्फलं तु क्त्वायामिड्विकल्प इति वक्तव्यम्। ‘इषेस्तकारे श्यन्प्रत्ययात् प्रतिषेधो वक्तव्य’ इति भाष्यात् तकारादावार्धधातुके इड्विवकल्पः सिद्ध एवेत्यत उदित्त्वस्य फलं न।]]</li> <li id="foot_krm_0077_04"><a href="#ref_krm_0077_04">↑</a> (१६८ श्लो)</li> <li id="foot_krm_0077_05"><a href="#ref_krm_0077_05">↑</a> [[२। सनि, णौ च पूर्वोक्तेषि (७४) धातुवद्रूपाणि ज्ञेयानि।]]</li> <li id="foot_krm_0077_06"><a href="#ref_krm_0077_06">↑</a> [[३। ‘तीषसह--’ (७-२-४८) इति तादेरार्धधातुकस्य इड्विकल्पः।]]</li> <li id="foot_krm_0077_07"><a href="#ref_krm_0077_07">↑</a> [[आ। ‘एष्टारमेषिता संख्ये सोढारं सहिता भृशम्।’ भ। का। ९-३१।]]</li> <li id="foot_krm_0077_08"><a href="#ref_krm_0077_08">↑</a> [[४। ‘इषगमियमां छः’ (७-३-७७) इति शे परे छकार आदेशः।]]</li> <li id="foot_krm_0077_09"><a href="#ref_krm_0077_09">↑</a> [[B। “मुरादिबन्धुः क्षुरघोरचेताः पुरन् खलानां जनजीवबर्ही। कंसः स्थितो यत्र ततर्ह लोकं स्तृढामरस्तृंहकरानभीच्छन्।।” धा। का। २-७७।]]</li> <li id="foot_krm_0077_10"><a href="#ref_krm_0077_10">↑</a> [[५। ‘झलां जशोऽन्ते’ (८-२-३९) इति जश्त्वम्। चर्त्वविकल्पः।]]</li> <li id="foot_krm_0077_11"><a href="#ref_krm_0077_11">↑</a> [[६। ‘यस्य विभाषा’ (७-२-१५) इतीण्णिषेधः।]]</li> <li id="foot_krm_0077_12"><a href="#ref_krm_0077_12">↑</a> [[७। ‘विन्दुरिच्छुः’ (३-२-१६९) इति तच्छीलादिषु उप्रत्ययः छकारश्च निपातितः।]]</li> <li id="foot_krm_0077_13"><a href="#ref_krm_0077_13">↑</a> [[C। ‘इच्छुः प्रसादं प्रणमन् सुग्रीवः प्रावदन् नृपम्।।’ भ। का। ७-२४।]]</li> <li id="foot_krm_0077_14"><a href="#ref_krm_0077_14">↑</a> [[८। ‘सुप्यजातौ--’ (३-२-७८) इति णिनिः।]]</li> <li id="foot_krm_0077_15"><a href="#ref_krm_0077_15">↑</a> [[ड्। ‘अध्यासितं श्रिया ब्राह्म्या शरण्यं शरणैषिणाम्।।’ भ। का। ४-४।]]</li> <li id="foot_krm_0077_16"><a href="#ref_krm_0077_16">↑</a> [पृष्ठम्००७८+ ३३]</li> <li id="foot_krm_0077_17"><a href="#ref_krm_0077_17">↑</a> [[१। ‘श्रुयजीषिस्तुभ्यः करणे’ (वा। ३-३-९४) इति क्तिन्। बाहुलकाद्भावेऽपीष्टिरिति।]]</li> <li id="foot_krm_0077_18"><a href="#ref_krm_0077_18">↑</a> [[आ। ‘निरचिकमदिच्छातः वानरांंश्चङ्क्रमावतः।।’ भ। का। ७-७०।]]</li> <li id="foot_krm_0077_19"><a href="#ref_krm_0077_19">↑</a> [[२। ‘इच्छा’ (३-३-१०१) इति भावे शे यगभावो निपात्यते।]]</li> <li id="foot_krm_0077_20"><a href="#ref_krm_0077_20">↑</a> [[३। करणे ल्युटि स्त्रियां ङीप्। तुलना।]]</li> <li id="foot_krm_0077_21"><a href="#ref_krm_0077_21">↑</a> [[४। ‘इष्यशिभ्यां तकन्’ (द। उ। ३। ३०) इति तकन् प्रत्ययः। इष्यते श्रेयोऽर्थिभि- रिति विग्रहः।]]</li></ul></p>

इष
<ul><li><sup id="ref_krm_0078_01"><a href="#foot_krm_0078_01">1</a></sup> {@“इष आभीक्ष्ण्ये”@} <sup id="ref_krm_0078_02"><a href="#foot_krm_0078_02">2</a></sup> ‘इष्णात्याभीक्ष्ण्ये, इच्छायां इच्छेद्, गत्यर्थ इष्यति।’ <sup id="ref_krm_0078_03"><a href="#foot_krm_0078_03">3</a></sup> इति देवः। </li> <li>‘इषेस्तकारे श्यन्प्रत्ययात् प्रतिषेधो वक्तव्य’ <sup id="ref_krm_0078_04"><a href="#foot_krm_0078_04">4</a></sup> इति वचनान् अस्यापि धातोः तादेरार्द्धधातुकस्य इड्विकल्पः। </li> <li>तदानीं शुद्धाद्धातोः <sup id="ref_krm_0078_05"><a href="#foot_krm_0078_05">5</a></sup> इच्छार्थकधातुवत्, ण्यन्तात् सन्नन्ताच्च <sup id="ref_krm_0078_06"><a href="#foot_krm_0078_06">6</a></sup> इषधातुवच्च रूपाणि ज्ञेयानि। </li> <li>शतरि परं--इष्णन्-ती <sup id="ref_krm_0078_07"><a href="#foot_krm_0078_07">7</a></sup> इति श्नाप्रत्ययः। </li> <li>‘श्नाभ्यस्तयोरातः’ <sup id="ref_krm_0078_08"><a href="#foot_krm_0078_08">8</a></sup> इति आकारलोपे रूपम्) इति विशेषः। </li> <li>आभीक्ष्ण्यं = पौनःपुन्यम्, भृशार्थो वा। </li> <li>तद्विषयायां क्रियायामित्यर्थः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0078_01"><a href="#ref_krm_0078_01">↑</a> (७६)</li> <li id="foot_krm_0078_02"><a href="#ref_krm_0078_02">↑</a> (९-क्र्यादिः-१५२५। सक। सेट्। पर।)</li> <li id="foot_krm_0078_03"><a href="#ref_krm_0078_03">↑</a> (श्लो। १६८)</li> <li id="foot_krm_0078_04"><a href="#ref_krm_0078_04">↑</a> (वा। ७-२-४८)</li> <li id="foot_krm_0078_05"><a href="#ref_krm_0078_05">↑</a> (७५)</li> <li id="foot_krm_0078_06"><a href="#ref_krm_0078_06">↑</a> (७४)</li> <li id="foot_krm_0078_07"><a href="#ref_krm_0078_07">↑</a> (‘क्र्यादिभ्यः श्ना’ (३-१-८१)</li> <li id="foot_krm_0078_08"><a href="#ref_krm_0078_08">↑</a> (६-४-११२)</li></ul></p>

ई|आयकः-यिका|ईषिषकः-षिका|एता-त्री|आययिता-त्री|ईषिषिता-त्री|इयन्-ती|आययन्-न्ती|ईषिषन्-न्ती|एष्यन्-न्ती-ती|आययिष्यन्-न्ती-ती|ईषिषिष्यन्-न्ती-ती|-|आययमानः|आययिष्यमाणः|ईः-इयौ-इयः|-ईतः-तम्-तवान्|आयितम्-तः|ईषिषितः-तवान्|अयः|आयः|ईषिषिषुः|आयिययिषुः|एतव्यम्|आययितव्यम्|ईषिषितव्यम्|अयनीयम्|आयनीयम्|ईषिषणीयम्|एयम्|उपेयम्|आय्यम्|ईषिष्यम्|ईषदयः|दुरयः|स्वयः|ईयमानः|आय्यमानः|ईषिष्यमाणः|ईषिषः|एतुम्|आययितुम्|ईषिषितुम्|ईतिः|आयना|ईषिषिषा|आयिययिषा|अयनम्|आयनम्|ईषिषणम्|ईत्वा|आययित्वा|ईषिषित्वा|समीय-प्रतीय|समाय्य|समीषिष्य|आयम्|ईषिषम्
<ul><li><sup id="ref_krm_0079_01"><a href="#foot_krm_0079_01">1</a></sup> {@“ई <sup id="ref_krm_0079_02"><a href="#foot_krm_0079_02">2</a></sup> गतिव्याप्तिप्रजनकान्त्यसनखादनेषु”@} <sup id="ref_krm_0079_03"><a href="#foot_krm_0079_03">3</a></sup> ‘अयत्येतीयते गत्यां, अधीतेऽध्येति चेङिकोः।’ <sup id="ref_krm_0079_04"><a href="#foot_krm_0079_04">4</a></sup> इति देवः। </li> <li>प्रजनम् = गर्भग्रहणम्। </li> <li>‘वी गति--’ <sup id="ref_krm_0079_05"><a href="#foot_krm_0079_05">5</a></sup> इति धातौ प्रश्लिष्टोऽयं धातुः। </li> <li>आयकः-यिका, आयकः-यिका, <sup id="ref_krm_0079_06"><a href="#foot_krm_0079_06">6</a></sup> ईषिषकः-षिका;</li> <li>  एता-त्री, आययिता-त्री, ईषिषिता-त्री;</li> <li>  <sup id="ref_krm_0079_07"><a href="#foot_krm_0079_07">7</a></sup> इयन् <sup id="ref_krm_0079_08"><a href="#foot_krm_0079_08">8</a></sup> -ती, आययन्-न्ती, ईषिषन्-न्ती;</li> <li>  <sup id="ref_krm_0079_09"><a href="#foot_krm_0079_09">9</a></sup> एष्यन्-न्ती-ती, आययिष्यन्-न्ती-ती, ईषिषिष्यन्-न्ती-ती;</li> <li>  -- आययमानः, आययिष्यमाणः;</li> <li>  ईः--इयौ-इयः;</li> <li>  -- -- <sup id="ref_krm_0079_10"><a href="#foot_krm_0079_10">10</a></sup> ईतः-तम्-तवान्, आयितम्-तः, ईषिषितः-तवान्;</li> <li>  अयः, आयः, ईषिषिषुः, आयिययिषुः;</li> <li>  एतव्यम्, आययितव्यम्, ईषिषितव्यम्;</li> <li>  अयनीयम्, आयनीयम्, ईषिषणीयम्;</li> <li>  एयम्, उपेयम् <sup id="ref_krm_0079_11"><a href="#foot_krm_0079_11">11</a></sup>, आय्यम्, ईषिष्यम्;</li> <li>  ईषदयः, दुरयः, स्वयः;</li> <li>  -- -- ईयमानः, आय्यमानः, ईषिष्यमाणः;</li> <li>  अयः, आयः, ईषिषः;</li> <li>  एतुम्, आययितुम्, ईषिषितुम्;</li> <li>  ईतिः, आयना, ईषिषिषा;</li> <li>  आयिययिषा;</li> <li>  अयनम्, आयनम्, ईषिषणम्;</li> <li>  ईत्वा, आययित्वा, ईषिषित्वा;</li> <li>  समीय-प्रतीय, <sup id="ref_krm_0079_12"><a href="#foot_krm_0079_12">12</a></sup> समाय्य, समीषिष्य;</li> <li>  आयम् २, ईत्वा २, आयम् २, आययित्वा २, ईषिषम् २;</li> <li>  ईषिषित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0079_01"><a href="#ref_krm_0079_01">↑</a> (७७)</li> <li id="foot_krm_0079_02"><a href="#ref_krm_0079_02">↑</a> (वी)</li> <li id="foot_krm_0079_03"><a href="#ref_krm_0079_03">↑</a> (२-अदादिः-१०४८-स। अनि। पर।)</li> <li id="foot_krm_0079_04"><a href="#ref_krm_0079_04">↑</a> (श्लो १४)</li> <li id="foot_krm_0079_05"><a href="#ref_krm_0079_05">↑</a> (ईई-१०४८। सक। अनि। पर।)</li> <li id="foot_krm_0079_06"><a href="#ref_krm_0079_06">↑</a> [[५। ‘इको झल्’ (१-२-९) इति सनः कित्त्वम्। ‘पर्जन्यवल्लक्षणं प्रवर्तते’ (भाष्यम्) इति न्यायात् ‘अज्झनगमां सनि’ (६-४-१६) इति दीर्घः।]]</li> <li id="foot_krm_0079_07"><a href="#ref_krm_0079_07">↑</a> [[६। ‘अचि श्नुधातु--’ (६-४-७७) इतीयङ्।]]</li> <li id="foot_krm_0079_08"><a href="#ref_krm_0079_08">↑</a> [[B। ‘इयञ्जनं राजपथं समायात् वाताकुलोद्भातपताकमीशः।।’ धा। का। २-४८।]]</li> <li id="foot_krm_0079_09"><a href="#ref_krm_0079_09">↑</a> [पृष्ठम्००७९+ २७]</li> <li id="foot_krm_0079_10"><a href="#ref_krm_0079_10">↑</a> [[आ। ‘इदं वचोऽनुच्चरमाण ईते तस्मिन् स्वमादाय शिशुं निकाय्यम्।’ वासुदेवविजये --२-२०। ईते इति क्तान्तात् सप्तमी।]]</li> <li id="foot_krm_0079_11"><a href="#ref_krm_0079_11">↑</a> [[B। ‘ई गताविति धातोर्यत्, तस्मादेयमिति स्थिते। ‘एङी’ ति पररूपे स्यादुपेय- मिति न त्विणः।।’ इति प्रक्रियासर्वस्वे (पु। ८०)।]]</li> <li id="foot_krm_0079_12"><a href="#ref_krm_0079_12">↑</a> [[C। ‘प्रतीय सा पूर्ददृशे जनेन द्यौर्भानुशीतांशुविनाकृतेव। राजन्यनक्षत्रसमन्विताऽपि शोकान्धकारक्षतसर्वचेष्टा।।’ भ। का। ३-१९।]]</li></ul></p>

