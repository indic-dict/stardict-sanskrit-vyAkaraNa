<ul><li><sup id="ref_krm_1536_01"><a href="#foot_krm_1536_01">1</a></sup> {@“लोल चलने”@} <sup id="ref_krm_1536_02"><a href="#foot_krm_1536_02">2</a></sup> लोलकः-लिका, लोलकः-लिका, लुलोलिषकः-षिका, लोलोलकः-लिका;</li> <li>  लोलिता-त्री, लोलयिता-त्री, लुलोलिषिता-त्री, लोलोलिता-त्री;</li> <li>  लोलन् <sup id="ref_krm_1536_03"><a href="#foot_krm_1536_03">3</a></sup> -न्ती, लोलयन्-न्ती, लुलोलिषन्-न्ती;</li> <li>  -- <sup id="ref_krm_1536_04"><a href="#foot_krm_1536_04">4</a></sup> लोलिष्यन्-न्ती-ती, लोलयिष्यन्-न्ती-ती, लुलोलिषिष्यन्-न्ती-ती;</li> <li>  -- <sup id="ref_krm_1536_05"><a href="#foot_krm_1536_05">5</a></sup> लोलमानः, <sup id="ref_krm_1536_06"><a href="#foot_krm_1536_06">6</a></sup> लोलयमानः, लुलोलिषमाणः;</li> <li>  -- इत्यादीनि रूपाणि सर्वाणि भौवादिकखोरतिवत् <sup id="ref_krm_1536_07"><a href="#foot_krm_1536_07">7</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1536_01"><a href="#ref_krm_1536_01">↑</a> (१५२५)</li> <li id="foot_krm_1536_02"><a href="#ref_krm_1536_02">↑</a> (१-भ्वादिः- …अक। सेट्। पर।)</li> <li id="foot_krm_1536_03"><a href="#ref_krm_1536_03">↑</a> [[C। ‘आश्लिष्टभूमिं रसितारमुच्चैर्लोलद्भुजाकारबृहत्तरङ्गम्।’ शि। व। ३। ७२।]]</li> <li id="foot_krm_1536_04"><a href="#ref_krm_1536_04">↑</a> [पृष्ठम्११८१+ २७]</li> <li id="foot_krm_1536_05"><a href="#ref_krm_1536_05">↑</a> [[१। “‘ताच्छील्यवयोवचनशक्तिषु चानश्’ (३-२-१२९) इति चानश्प्रत्ययः। न तु शानच्;\n\n  लोलतेः परस्मैपदित्वात्। अत एव ‘लोलमानादयश्चानशि’ इति वामनः” (५-२-८) इति माघव्याख्याने (१०-५९) उपात्तत्वात्, शतरि प्रयोगे दृष्टत्वाच्च ‘लोल--’ इति कश्चन धातुः पूर्वं दृष्ट इति केचित्। ‘लोलद्- भुजाकारबृहत्तरङ्गम्’ (माघः ३-७२) ‘श्रीराजीवाक्षवक्षस्स्थलनिलयरमाहस्तवास्तव्य- लोलल्लीलाब्जात् निस्सरन्ती मधुरमधुझरी--’ (विश्वगुणादर्शचम्पूः श्लो १) इत्यादयः प्रयोगाः शत्रन्ता इहानुसन्धेयाः।]]</li> <li id="foot_krm_1536_06"><a href="#ref_krm_1536_06">↑</a> [[आ। ‘आमृशद्भिरभितो वलिवीचीर्लोलमानवितताङ्गुलिहस्तैः।’ शि। व। १०-५९।]]</li> <li id="foot_krm_1536_07"><a href="#ref_krm_1536_07">↑</a> (३६३)</li></ul></p>

लोष्ट|लोष्टकः-ष्टिका|लुलोष्टिषकः-षिका|लोलोष्टकः-ष्टिका|लोष्टिता-त्री|लोष्टयिता-त्री|लुलोष्टिषिता-त्री|लोलोष्टिता-त्री
<ul><li><sup id="ref_krm_1537_01"><a href="#foot_krm_1537_01">1</a></sup> {@“लोष्ट संघाते”@} <sup id="ref_krm_1537_02"><a href="#foot_krm_1537_02">2</a></sup> लोष्टकः-ष्टिका, लोष्टकः-ष्टिका, लुलोष्टिषकः-षिका, लोलोष्टकः-ष्टिका;</li> <li>  लोष्टिता-त्री, लोष्टयिता-त्री, लुलोष्टिषिता-त्री, लोलोष्टिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि भौवादिकगोष्टतिवत् <sup id="ref_krm_1537_03"><a href="#foot_krm_1537_03">3</a></sup> ज्ञेयानि। </li> <li>लोष्टः = मृत्पिण्डः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1537_01"><a href="#ref_krm_1537_01">↑</a> (१५२६)</li> <li id="foot_krm_1537_02"><a href="#ref_krm_1537_02">↑</a> (१-भ्वादिः-२५८। सक। सेट्। आत्म।)</li> <li id="foot_krm_1537_03"><a href="#ref_krm_1537_03">↑</a> (४३४)</li></ul></p>

वकि|वङ्ककः-ङ्किका|विवङ्किषकः-षिका|वावङ्ककः-ङ्किका|वङ्किता-त्री|वङ्कयिता-त्री|विवङ्किषिता-त्री|वावङ्किता-त्री
<ul><li><sup id="ref_krm_1538_01"><a href="#foot_krm_1538_01">1</a></sup> {@“वकि कौटिल्ये”@} <sup id="ref_krm_1538_02"><a href="#foot_krm_1538_02">2</a></sup> वङ्ककः-ङ्किका, वङ्ककः-ङ्किका, विवङ्किषकः-षिका, वावङ्ककः-ङ्किका;</li> <li>  वङ्किता-त्री, वङ्कयिता-त्री, विवङ्किषिता-त्री, वावङ्किता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि भौवादिककङ्कतिवत् <sup id="ref_krm_1538_03"><a href="#foot_krm_1538_03">3</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_1538_04"><a href="#foot_krm_1538_04">4</a></sup> वङ्कितम्- तः, ल्युटि- <sup id="ref_krm_1538_05"><a href="#foot_krm_1538_05">5</a></sup> प्रवङ्कनम्। </li> <li>औणादिके <sup id="ref_krm_1538_06"><a href="#foot_krm_1538_06">6</a></sup> क्रिन्प्रत्यये वङ्क्रिः इति रूपम्। </li> <li>वङ्क्रिः-शरीराङ्गम्, शल्यम् च।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1538_01"><a href="#ref_krm_1538_01">↑</a> (१५२७)</li> <li id="foot_krm_1538_02"><a href="#ref_krm_1538_02">↑</a> (१-भ्वादिः-८८। अक। सेट्। आत्म।)</li> <li id="foot_krm_1538_03"><a href="#ref_krm_1538_03">↑</a> (१४०)</li> <li id="foot_krm_1538_04"><a href="#ref_krm_1538_04">↑</a> [[B। ‘फलाङ्कितान् वङ्कितमल्लिमङ्कितान् वनप्रदेशानुरुकाककोकिलान्।’ धा। का। १-१३।]]</li> <li id="foot_krm_1538_05"><a href="#ref_krm_1538_05">↑</a> [[२। अत्र ‘कृत्यचः’ (८-४-२९) इति णत्वम् ‘इजादेः सनुमः’ (८-४-३२) इति नियमान्न भवति।]]</li> <li id="foot_krm_1538_06"><a href="#ref_krm_1538_06">↑</a> [१-३५]</li></ul></p>

वकि|वङ्ककः-ङ्किका|विवङ्किषकः-षिका|वावङ्ककः-ङ्किका|वङ्किता-त्री|वङ्कयिता-त्री|विवङ्किषिता-त्री|वावङ्किता-त्री
<ul><li><sup id="ref_krm_1539_01"><a href="#foot_krm_1539_01">1</a></sup> {@“वकि गत्यर्थः”@} <sup id="ref_krm_1539_02"><a href="#foot_krm_1539_02">2</a></sup> क्षीरस्वामी अमुं धातुं पठति। </li> <li>अर्थभेदः पुनःपाठे प्रयोजनम् इति ज्ञायते। </li> <li>वङ्ककः-ङ्किका, वङ्ककः-ङ्किका, विवङ्किषकः-षिका, वावङ्ककः-ङ्किका;</li> <li>  <sup id="ref_krm_1539_03"><a href="#foot_krm_1539_03">3</a></sup> वङ्किता-त्री, वङ्कयिता-त्री, विवङ्किषिता-त्री, वावङ्किता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाणि भौवादिकगत्यर्थककङ्कतिवत् <sup id="ref_krm_1539_04"><a href="#foot_krm_1539_04">4</a></sup> ऊह्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1539_01"><a href="#ref_krm_1539_01">↑</a> (१५२८)</li> <li id="foot_krm_1539_02"><a href="#ref_krm_1539_02">↑</a> (१-भ्वादिः-९५। सक। सेट्। आत्म।)</li> <li id="foot_krm_1539_03"><a href="#ref_krm_1539_03">↑</a> [पृष्ठम्११८२+ २५]</li> <li id="foot_krm_1539_04"><a href="#ref_krm_1539_04">↑</a> (१४०)</li></ul></p>

वक्ष|वक्षकः-क्षिका|विवक्षिषकः-षिका|वावक्षकः-क्षिका|वक्षिता-त्री|वक्षयिता-त्री|विवक्षिषिता-त्री|वावक्षिता-त्री
<ul><li><sup id="ref_krm_1540_01"><a href="#foot_krm_1540_01">1</a></sup> {@“वक्ष रोषे”@} <sup id="ref_krm_1540_02"><a href="#foot_krm_1540_02">2</a></sup> ‘-- संघाते’ इति क्षीरस्वामी। </li> <li>‘--रोषसंहत्योः’ इति वोपदेवः। </li> <li>‘-- पालने’ इति पठित्वा वक्षते इति आत्मनेपदिनः इति काशकृत्स्नः। </li> <li>इतः पूर्वं भ्वादौ ‘--रोषे’ <sup id="ref_krm_1540_03"><a href="#foot_krm_1540_03">3</a></sup> इति च तत्र पठ्यते। </li> <li>वक्षकः-क्षिका, वक्षकः-क्षिका, विवक्षिषकः-षिका, वावक्षकः-क्षिका;</li> <li>  वक्षिता-त्री, वक्षयिता-त्री, विवक्षिषिता-त्री, वावक्षिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाणि भौवादिकतक्षतिवत् <sup id="ref_krm_1540_04"><a href="#foot_krm_1540_04">4</a></sup> बोध्यानि। </li> <li>असुन्- प्रत्यये--वक्षः इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1540_01"><a href="#ref_krm_1540_01">↑</a> (१५२९)</li> <li id="foot_krm_1540_02"><a href="#ref_krm_1540_02">↑</a> (१-भ्वादिः-६६३। अक। सेट्। पर।)</li> <li id="foot_krm_1540_03"><a href="#ref_krm_1540_03">↑</a> (परस्मैपदिनः)</li> <li id="foot_krm_1540_04"><a href="#ref_krm_1540_04">↑</a> (६९१)</li></ul></p>

वख|वाखकः-खिका|विवखिषकः-षिका|वावखकः-खिका|वखिता-त्री|वखयिता|त्री|विवखिषिता-त्री|वावखिता-त्री
<ul><li><sup id="ref_krm_1541_01"><a href="#foot_krm_1541_01">1</a></sup> {@“वख गत्यर्थः”@} <sup id="ref_krm_1541_02"><a href="#foot_krm_1541_02">2</a></sup> वाखकः-खिका, वाखकः-खिका, विवखिषकः-षिका, वावखकः-खिका;</li> <li>  वखिता-त्री, वखयिता त्री, विवखिषिता-त्री, वावखिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि भौवादिककखतिवत् <sup id="ref_krm_1541_03"><a href="#foot_krm_1541_03">3</a></sup> ऊह्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1541_01"><a href="#ref_krm_1541_01">↑</a> (१५३०)</li> <li id="foot_krm_1541_02"><a href="#ref_krm_1541_02">↑</a> (१-भ्वादिः-१३०। सक। सेट्। पर।)</li> <li id="foot_krm_1541_03"><a href="#ref_krm_1541_03">↑</a> (१४१)</li></ul></p>

वखि|वङ्खकः-ङ्खिका|विवङ्खिषकः-षिका|वावङ्खकः-ङ्खिका|वङ्खिता-त्री|वङ्खयिता-त्री|विवङ्खिषिता-त्री|वावङ्खिता-त्री
<ul><li><sup id="ref_krm_1542_01"><a href="#foot_krm_1542_01">1</a></sup> {@“वखि गत्यर्थः”@} <sup id="ref_krm_1542_02"><a href="#foot_krm_1542_02">2</a></sup> वङ्खकः-ङ्खिका, वङ्खकः-ङ्खिका, विवङ्खिषकः-षिका, वावङ्खकः-ङ्खिका;</li> <li>  वङ्खिता-त्री, वङ्खयिता-त्री, विवङ्खिषिता-त्री, वावङ्खिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाणि भौवादिककखतिवत् <sup id="ref_krm_1542_03"><a href="#foot_krm_1542_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1542_04"><a href="#foot_krm_1542_04">4</a></sup> प्रवङ्खनम्-ल्युटि एवं रूपमिति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1542_01"><a href="#ref_krm_1542_01">↑</a> (१५३१)</li> <li id="foot_krm_1542_02"><a href="#ref_krm_1542_02">↑</a> (१-भ्वादिः-१३१। सक। सेट्। पर।)</li> <li id="foot_krm_1542_03"><a href="#ref_krm_1542_03">↑</a> (१४१)</li> <li id="foot_krm_1542_04"><a href="#ref_krm_1542_04">↑</a> [[१। ‘इजादेः सनुमः’ (८-४-३२) इति नियमान्न णत्वम्।]]</li></ul></p>

वगि|“वङ्गिः|गतिवैकल्ये|रूढः|वङ्गकः-ङ्गिका|विवङ्गिषकः-षिका|वावङ्गकः-ङ्गिका|वङ्गिता-त्री|वङ्गयिता-त्री|विवङ्गिषिता-त्री|वावङ्गिता-त्री
<ul><li><sup id="ref_krm_1543_01"><a href="#foot_krm_1543_01">1</a></sup> {@“वगि गत्यर्थः”@} <sup id="ref_krm_1543_02"><a href="#foot_krm_1543_02">2</a></sup> “वङ्गिः गतिवैकल्ये रूढः;</li> <li>  वङ्गति, वङ्गः” इति क्षीरतरङ्गिण्याम्। </li> <li>वङ्गकः-ङ्गिका, वङ्गकः-ङ्गिका, विवङ्गिषकः-षिका, वावङ्गकः-ङ्गिका;</li> <li>  वङ्गिता-त्री, वङ्गयिता-त्री, विवङ्गिषिता-त्री, वावङ्गिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककङ्कतिवत् <sup id="ref_krm_1543_03"><a href="#foot_krm_1543_03">3</a></sup> ऊह्यानि। </li> <li>अस्य धातोः परस्मैपदित्वात् शुद्धे शानच्प्रत्ययो न भवति। </li> <li><sup id="ref_krm_1543_04"><a href="#foot_krm_1543_04">4</a></sup> ण्यन्ते--वङ्गयमानः इति। </li> <li><sup id="ref_krm_1543_05"><a href="#foot_krm_1543_05">5</a></sup> वङ्गः। </li> <li>वङ्गुरिः-भूषणभेदः। </li> <li>वङ्गितः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1543_01"><a href="#ref_krm_1543_01">↑</a> (१५३२)</li> <li id="foot_krm_1543_02"><a href="#ref_krm_1543_02">↑</a> (१-भ्वादिः-१४७। सक। सेट्। पर।)</li> <li id="foot_krm_1543_03"><a href="#ref_krm_1543_03">↑</a> (१४०)</li> <li id="foot_krm_1543_04"><a href="#ref_krm_1543_04">↑</a> [पृष्ठम्११८३+ २८]</li> <li id="foot_krm_1543_05"><a href="#ref_krm_1543_05">↑</a> [[१। वङ्गतीति वङ्गः = जनपदः। ‘हलश्च’ (३-३-१२१) इति संज्ञायामधिकरणे घञ्प्रत्यये रूपमेवम्।]]</li></ul></p>

वघि|वङ्घकः-ङ्घिका|विवङ्घिषकः-षिका|वावङ्घकः-ङ्घिका|वङ्घिता-त्री|वङ्घयिता-त्री|विवङ्घिषिता-त्री|वावङ्घिता-त्री
<ul><li><sup id="ref_krm_1544_01"><a href="#foot_krm_1544_01">1</a></sup> {@“वघि गत्याक्षेपे”@} <sup id="ref_krm_1544_02"><a href="#foot_krm_1544_02">2</a></sup> “आक्षेपो-निन्दा, गतौ गमनारम्भे चेति स्वामी” इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>‘गत्याक्षेपो वेगगतिः गमनारम्भो वा’ इति क्षीरस्वामी। </li> <li>वङ्घकः-ङ्घिका, वङ्घकः-ङ्घिका, विवङ्घिषकः-षिका, वावङ्घकः-ङ्घिका;</li> <li>  वङ्घिता-त्री, वङ्घयिता-त्री, विवङ्घिषिता-त्री, वावङ्घिता-त्री;</li> <li>  इत्यादिकानि रूपाणि सर्वाण्यपि भौवादिककङ्कतिवत् <sup id="ref_krm_1544_03"><a href="#foot_krm_1544_03">3</a></sup> बोध्यानि। </li> <li>शानचि- <sup id="ref_krm_1544_04"><a href="#foot_krm_1544_04">4</a></sup> वङ्घमानः इति ज्ञेयम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1544_01"><a href="#ref_krm_1544_01">↑</a> (१५३३)</li> <li id="foot_krm_1544_02"><a href="#ref_krm_1544_02">↑</a> (१-भ्वादिः-११०। सक। सेट्। आत्म।)</li> <li id="foot_krm_1544_03"><a href="#ref_krm_1544_03">↑</a> (१४०)</li> <li id="foot_krm_1544_04"><a href="#ref_krm_1544_04">↑</a> [[आ। ‘प्रवङ्घमानस्य च तस्य सत्वरं विमङ्घनस्याधिकराघितात्मनः।’ धा। का। १-१६।]]</li></ul></p>

वच|वाचकः-चिका|विवक्षकः-क्षिका|वावचकः-चिका|वक्ता-वक्त्री|वाचयिता-त्री|विवक्षिता-त्री|वावचिता-त्री|वचन्-ती|वाचयन्-न्ती|विवक्षन्-न्ती|-|वक्ष्यन्-न्ती-ती|वाचयिष्यन्-न्ती-ती|विवक्षिष्यन्-न्ती-ती|वाचयमानः|वाचयिष्यमाणः|विवक्षमाणः|विवक्षिष्यमाणः
<ul><li><sup id="ref_krm_1545_01"><a href="#foot_krm_1545_01">1</a></sup> {@“वच परिभाषणे”@} <sup id="ref_krm_1545_02"><a href="#foot_krm_1545_02">2</a></sup> ‘वक्तीति भाषणे वा णौ वाचयेत् वचतीति वा।’ <sup id="ref_krm_1545_03"><a href="#foot_krm_1545_03">3</a></sup> इति देवः। </li> <li>‘-- भाषणे’ इति क्षीरस्वामि-मैत्रेय-चन्द्र-शाकटायन-हेमचन्द्रादयः। </li> <li>‘पारायणिकैर्नाधीतोऽयम्’ इति तरङ्गिण्यामुक्तम्। </li> <li>वाचकः-चिका, वाचकः-चिका, विवक्षकः-क्षिका, वावचकः-चिका;</li> <li>  वक्ता-वक्त्री, वाचयिता-त्री, विवक्षिता-त्री, वावचिता-त्री;</li> <li>  वचन्-ती, वाचयन्-न्ती, विवक्षन्-न्ती;</li> <li>  -- वक्ष्यन्-न्ती-ती, वाचयिष्यन्-न्ती-ती, विवक्षिष्यन्-न्ती-ती;</li> <li>  -- -- वाचयमानः, वाचयिष्यमाणः, विवक्षमाणः, विवक्षिष्यमाणः;</li> <li>  -- इत्यादीनि सर्वाण्यपि रूपाणि आदादिकब्रूञ्धातुवत् <sup id="ref_krm_1545_04"><a href="#foot_krm_1545_04">4</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1545_01"><a href="#ref_krm_1545_01">↑</a> (१५३४)</li> <li id="foot_krm_1545_02"><a href="#ref_krm_1545_02">↑</a> (२-अदादिः-१०६३। सक। अनिट्। पर।)</li> <li id="foot_krm_1545_03"><a href="#ref_krm_1545_03">↑</a> (श्लो। ५१)</li> <li id="foot_krm_1545_04"><a href="#ref_krm_1545_04">↑</a> (११३२)</li></ul></p>

वच|वाचकः-चिका|विवाचयिषकः-षिका|विवक्षकः-क्षिका|वावचकः-चिका|वाचयिता-त्री|विवाचयिषिता-त्री|वक्ता-वक्त्री|विवक्षिता-त्री|वावचिता-त्री|णिच्पक्षे|इमानि|रूपाणि|-|वाचयन्-न्ती|विवाचयिषन्-न्ती|वाचयिष्यन्-न्ती-ती|विवाचयिषिष्यन्-न्ती-ती|वाचयमानः|विवाचयिषमाणः|वाचयिष्यमाणः|विवाचयिषिष्यमाणः|विवाचयिट्-ड्-यिषौ-यिषः|वाचितम्-तः|विवाचयिषितम्-तः-तवान्|वाचः|विवाचयिषुः|वाचयितव्यम्|विवाचयिषितव्यम्|वाचनीयम्|विवाचयिषणीयम्|वाच्यम्|विवाचयिष्यम्|ईषद्विवाचयिषः-दुर्विवाचयिषः-सुविवाचयिषः|वाच्यमानः|विवाचयिष्यमाणः|विवाचयिषः|वाचयितुम्|विवाच-|यिषितुम्|वाचना|विवाचयिषा|वाचनम्|विवाचयिषणम्|वाचयित्वा|विवाचयिषित्वा|प्रवाच्य|प्रविवाचयिष्य|वाचम्
<ul><li><sup id="ref_krm_1546_01"><a href="#foot_krm_1546_01">1</a></sup> {@“वच परिभाषणे”@} <sup id="ref_krm_1546_02"><a href="#foot_krm_1546_02">2</a></sup> <sup id="ref_krm_1546_03"><a href="#foot_krm_1546_03">3</a></sup> णिजभावपक्षे शतरि वचन् इत्यस्य प्रयोगो दृश्यते <sup id="ref_krm_1546_04"><a href="#foot_krm_1546_04">4</a></sup>। </li> <li>‘-- भाषणे’ इति क्षीरस्वामिमैत्रेयादयः। </li> <li>“पचिं वचिम्” <sup id="ref_krm_1546_05"><a href="#foot_krm_1546_05">5</a></sup> इति पाठादनिट्त्वम्। </li> <li>‘पारायणिकैः धातुरयं नाधीयते’ इति मा। </li> <li>धा। </li> <li>वृत्तिः।]] ‘-- सन्देशने च’ इति कातन्त्र-हेरम्बादयः। </li> <li><sup id="ref_krm_1546_06"><a href="#foot_krm_1546_06">6</a></sup> ‘वक्तीति भाषणे वा णौ वाचयेत् वचतीति वा।’ <sup id="ref_krm_1546_07"><a href="#foot_krm_1546_07">7</a></sup> इति देवः। </li> <li>वाचकः-चिका, विवाचयिषकः-षिका, वाचकः-चिका, विवक्षकः-क्षिका, वावचकः-चिका;</li> <li>  वाचयिता-त्री, विवाचयिषिता-त्री, वक्ता-वक्त्री, विवक्षिता-त्री, वावचिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाणि ण्यन्तप्रकृतिकसन्नन्तं विना पूर्वोक्तवचतिवत् <sup id="ref_krm_1546_08"><a href="#foot_krm_1546_08">8</a></sup> ऊह्यानि। </li> <li>आधृषीयत्वाद् णिज्विकल्पः। </li> <li>णिच्पक्षे इमानि रूपाणि -- वाचयन्-न्ती, विवाचयिषन्-न्ती;</li> <li>  वाचयिष्यन्-न्ती-ती, विवाचयिषिष्यन्-न्ती-ती;</li> <li>  वाचयमानः, विवाचयिषमाणः;</li> <li>  वाचयिष्यमाणः;</li> <li>  विवाचयिषिष्यमाणः;</li> <li>  विवाचयिट्-ड्-यिषौ-यिषः;</li> <li>  वाचितम्-तः, विवाचयिषितम्-तः-तवान्;</li> <li>  वाचः, विवाचयिषुः;</li> <li>  वाचयितव्यम्;</li> <li>  विवाचयिषितव्यम्;</li> <li>  वाचनीयम्, विवाचयिषणीयम्;</li> <li>  वाच्यम्, विवाचयिष्यम्, ईषद्विवाचयिषः-दुर्विवाचयिषः-सुविवाचयिषः;</li> <li>  वाच्यमानः, विवाचयिष्यमाणः;</li> <li>  वाचः, विवाचयिषः;</li> <li>  वाचयितुम्, विवाच- यिषितुम्;</li> <li>  वाचना, विवाचयिषा;</li> <li>  वाचनम्, विवाचयिषणम्;</li> <li>  वाचयित्वा, विवाचयिषित्वा;</li> <li>  प्रवाच्य, प्रविवाचयिष्य, वाचम् २, वाचयित्वा २;</li> <li>  विवाचयिषम् २, विवाचयिषित्वा २। इति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1546_01"><a href="#ref_krm_1546_01">↑</a> (१५३५)</li> <li id="foot_krm_1546_02"><a href="#ref_krm_1546_02">↑</a> (१०-चुरादिः-१८४३। सक। सेट्। उभ।)</li> <li id="foot_krm_1546_03"><a href="#ref_krm_1546_03">↑</a> [[[अ]</li> <li id="foot_krm_1546_04"><a href="#ref_krm_1546_04">↑</a> (धा। का। ३-५२)</li> <li id="foot_krm_1546_05"><a href="#ref_krm_1546_05">↑</a> (७-२-१०। व्याघ्रभूतिकारिका)</li> <li id="foot_krm_1546_06"><a href="#ref_krm_1546_06">↑</a> [आधृषीयः। [पृष्ठम्११८४+ २६]</li> <li id="foot_krm_1546_07"><a href="#ref_krm_1546_07">↑</a> (श्लो। ५१)</li> <li id="foot_krm_1546_08"><a href="#ref_krm_1546_08">↑</a> (१५३४)</li></ul></p>

वज|वाजकः-जिका|विवजिषकः-षिका|वावजकः-जिका|वजिता-त्री|वाजयिता-त्री|विवजिषिता-त्री|वावजिता-त्री
<ul><li><sup id="ref_krm_1547_01"><a href="#foot_krm_1547_01">1</a></sup> {@“वज गतौ”@} <sup id="ref_krm_1547_02"><a href="#foot_krm_1547_02">2</a></sup> ‘-- गतौ वजति वाजयेत्।’ <sup id="ref_krm_1547_03"><a href="#foot_krm_1547_03">3</a></sup> इति देवः। </li> <li>वाजकः-जिका, वाजकः-जिका, विवजिषकः-षिका, वावजकः-जिका;</li> <li>  वजिता-त्री, वाजयिता-त्री, विवजिषिता-त्री, वावजिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि भौवादिकबन्धनार्थककचतिवत् <sup id="ref_krm_1547_04"><a href="#foot_krm_1547_04">4</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_1547_05"><a href="#foot_krm_1547_05">5</a></sup> वाज्यम्, शतरि-वजन् इति च विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1547_01"><a href="#ref_krm_1547_01">↑</a> (१५३६)</li> <li id="foot_krm_1547_02"><a href="#ref_krm_1547_02">↑</a> (१-भ्वादिः-२५२। सक। सेट्। पर।)</li> <li id="foot_krm_1547_03"><a href="#ref_krm_1547_03">↑</a> (श्लो। ५८)</li> <li id="foot_krm_1547_04"><a href="#ref_krm_1547_04">↑</a> (१४४)</li> <li id="foot_krm_1547_05"><a href="#ref_krm_1547_05">↑</a> [[१। ण्यति प्रत्यये ‘अजिव्रज्योश्च’ (७-३-६०) इत्यत्र चकारात् अत्रापि कुत्वं नेति माधवः। वस्तुतस्तु ‘चजोः--’ (७-३-५२) इत्यत्र ‘निष्ठायामनिट इति वक्तव्यम्’ (वा। ७-३-५२) इति वार्तिकेन विषयविभागस्य कृतत्वेन यथोत्तरं मुनीनां प्रामाण्यात् अत्र प्रकृतस्थले कुत्वप्रसक्तिरेव नेति भाष्यादिसम्मतः पन्थाः।]]</li></ul></p>

वज|वाजकः-जिका|विवाजयिषकः-षिका|वाजयिता-त्री|विवाजयिषिता-त्री
<ul><li><sup id="ref_krm_1548_01"><a href="#foot_krm_1548_01">1</a></sup> {@“वज मार्गसंस्कारगत्योः”@} <sup id="ref_krm_1548_02"><a href="#foot_krm_1548_02">2</a></sup> ‘… गतौ वजति वाचयेत्।’ <sup id="ref_krm_1548_03"><a href="#foot_krm_1548_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_1548_04"><a href="#foot_krm_1548_04">4</a></sup> ‘व्रज--’ इति मा। </li> <li>धा। </li> <li>वृत्तिः, चन्द्रोऽपि। </li> <li>क्षीरस्वामी तु वजिं पठित्वा मार्गेति द्वितीयं धातुमाह। </li> <li>‘मार्गगतौ संस्कारगतौ च’ इत्येके। </li> <li>‘वज’ ‘मार्ग’ द्वौ धातू इति सि। </li> <li>कौमुद्याम्। </li> <li>एवमेव पुरुषकारेऽपि <sup id="ref_krm_1548_05"><a href="#foot_krm_1548_05">5</a></sup>। </li> <li>‘वज मार्गणसंस्कारे’ इति दुर्गः। </li> <li>‘--गतौ संस्कृतौ च’ इति वोपदेवः। </li> <li>वाजकः-जिका, विवाजयिषकः-षिका;</li> <li>  वाजयिता-त्री, विवाजयिषिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि चौरादिककाणयतिवत् <sup id="ref_krm_1548_06"><a href="#foot_krm_1548_06">6</a></sup> ऊह्यानि। </li> <li>ण्यति- <sup id="ref_krm_1548_07"><a href="#foot_krm_1548_07">7</a></sup> अवाज्यम् इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1548_01"><a href="#ref_krm_1548_01">↑</a> (१५३७)</li> <li id="foot_krm_1548_02"><a href="#ref_krm_1548_02">↑</a> (१०-चुरादिः-१६१७। सक। सेट्। उभ।)</li> <li id="foot_krm_1548_03"><a href="#ref_krm_1548_03">↑</a> (श्लो। ५८)</li> <li id="foot_krm_1548_04"><a href="#ref_krm_1548_04">↑</a> [पृष्ठम्११८५+ २६]</li> <li id="foot_krm_1548_05"><a href="#ref_krm_1548_05">↑</a> (दैवश्लोके ५८)</li> <li id="foot_krm_1548_06"><a href="#ref_krm_1548_06">↑</a> (१५९)</li> <li id="foot_krm_1548_07"><a href="#ref_krm_1548_07">↑</a> [[आ। ‘इत्यादिवादिषु जनेषु विमोटितारिः पापप्रपण्डिपदपांसुरवाज्यधामा।’ धा। का। ३-२३।]]</li></ul></p>

वट|वाटकः-टिका|विवटिषकः-षिका|वावटकः-टिका|वटिता-त्री|वाटयिता-त्री|विवटिषिता-त्री|वावटिता-त्री
<ul><li><sup id="ref_krm_1549_01"><a href="#foot_krm_1549_01">1</a></sup> {@“वट वेष्टने”@} <sup id="ref_krm_1549_02"><a href="#foot_krm_1549_02">2</a></sup> “णावदन्ताद्वटेर्ग्रन्थे वटयेद् वेष्टने वटेत्।।’ <sup id="ref_krm_1549_03"><a href="#foot_krm_1549_03">3</a></sup> इति देवः। </li> <li>‘बटेत्यपि बहुषु कोशेषु दृश्यते’ इति पुरुषकारः <sup id="ref_krm_1549_04"><a href="#foot_krm_1549_04">4</a></sup>। </li> <li>वाटकः-टिका, वाटकः-टिका, विवटिषकः-षिका, वावटकः-टिका;</li> <li>  वटिता-त्री, वाटयिता-त्री, विवटिषिता-त्री, वावटिता-त्री;</li> <li>  इत्यादिकानि रूपाणि सर्वाण्यपि भौवादिककटतिवत् <sup id="ref_krm_1549_05"><a href="#foot_krm_1549_05">5</a></sup> ज्ञेयानि। </li> <li>वटः, <sup id="ref_krm_1549_06"><a href="#foot_krm_1549_06">6</a></sup> वटिः, वटकः-वटका, वटकिनी, वटिभः, वाटः-वाटी, <sup id="ref_krm_1549_07"><a href="#foot_krm_1549_07">7</a></sup> वटुः, इत्यादीनि रूपाणि अस्य धातोः विशेषेण भवन्तीति ज्ञेयम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1549_01"><a href="#ref_krm_1549_01">↑</a> (१५३८)</li> <li id="foot_krm_1549_02"><a href="#ref_krm_1549_02">↑</a> (१-भ्वादिः-३००। सक। सेट्। पर।)</li> <li id="foot_krm_1549_03"><a href="#ref_krm_1549_03">↑</a> (श्लो। ७७)</li> <li id="foot_krm_1549_04"><a href="#ref_krm_1549_04">↑</a> (श्लो। ७७)</li> <li id="foot_krm_1549_05"><a href="#ref_krm_1549_05">↑</a> (१४८)</li> <li id="foot_krm_1549_06"><a href="#ref_krm_1549_06">↑</a> [[१। औणादिके (द। उ। १-४६) इन्प्रत्यये रूपमेवम्। वटिः = तन्तुः।]]</li> <li id="foot_krm_1549_07"><a href="#ref_krm_1549_07">↑</a> [[२। औणादिके उप्रत्यये रूपमेवम्। वटुः = ब्रह्मचारी, समर्थश्च।]]</li></ul></p>

वट|वाटकः-टिका|वटकः-टिका|विवटिषकः-षिका|वावटकः-टिका|वटिता-त्री|वटयिता-त्री|विवटिषिता-त्री|वावटिता-त्री|वटन्-न्ती|वटयन्-न्ती|विवटिषन्-न्ती
<ul><li><sup id="ref_krm_1550_01"><a href="#foot_krm_1550_01">1</a></sup> {@“वट परिभाषणे”@} <sup id="ref_krm_1550_02"><a href="#foot_krm_1550_02">2</a></sup> घटादिः। </li> <li>‘-- अवयवे’ इति काशकृत्स्नः। </li> <li>वाटकः-टिका, वटकः-टिका, विवटिषकः-षिका, वावटकः-टिका;</li> <li>  वटिता-त्री, वटयिता-त्री, विवटिषिता-त्री, वावटिता-त्री;</li> <li>  वटन्-न्ती, वटयन्-न्ती, विवटिषन्-न्ती;</li> <li>  -- इत्यादिकानि रूपाणि ण्यन्तं विना सर्वाण्यपि भौवादिककखतिवत् <sup id="ref_krm_1550_03"><a href="#foot_krm_1550_03">3</a></sup> ऊह्यानि। </li> <li>अस्य धातोः घटादिपाठात् ण्यन्ते परं ‘घटादयो मितः’ <sup id="ref_krm_1550_04"><a href="#foot_krm_1550_04">4</a></sup> इति मित्त्वे ‘मितां ह्रस्वः’ <sup id="ref_krm_1550_05"><a href="#foot_krm_1550_05">5</a></sup> इति ह्रस्वे वटयन्-वटयिष्यन्-न्ती-ती, <sup id="ref_krm_1550_06"><a href="#foot_krm_1550_06">6</a></sup> वटयमानः, वटयिष्यमाणः, इत्यादिकानि ह्रस्वघटितानि रूपाणि भौवादिक- कखतिवत् <sup id="ref_krm_1550_07"><a href="#foot_krm_1550_07">7</a></sup> बोध्यानि। </li> <li>णमुलि- <sup id="ref_krm_1550_08"><a href="#foot_krm_1550_08">8</a></sup> वटम् २-वाटम् २, वटयित्वा २। इति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1550_01"><a href="#ref_krm_1550_01">↑</a> (१५३९)</li> <li id="foot_krm_1550_02"><a href="#ref_krm_1550_02">↑</a> (१-भ्वादिः-७७९। सक। सेट्। पर।)</li> <li id="foot_krm_1550_03"><a href="#ref_krm_1550_03">↑</a> (१४२)</li> <li id="foot_krm_1550_04"><a href="#ref_krm_1550_04">↑</a> (गणसूत्रं भ्वादौ)</li> <li id="foot_krm_1550_05"><a href="#ref_krm_1550_05">↑</a> (६-४-९२)</li> <li id="foot_krm_1550_06"><a href="#ref_krm_1550_06">↑</a> [पृष्ठम्११८६+ २७]</li> <li id="foot_krm_1550_07"><a href="#ref_krm_1550_07">↑</a> (१४१)</li> <li id="foot_krm_1550_08"><a href="#ref_krm_1550_08">↑</a> [[१। ‘चिण्णमुलोः--’ (६-४-९३) इति णौ परतः विकल्पेन दीर्घः। तेन रूपद्वयम्।]]</li></ul></p>

वट|वटकः-टिका|विवटयिषकः-षिका|वटयिता-त्री|विवटयिषिता-त्री
<ul><li><sup id="ref_krm_1551_01"><a href="#foot_krm_1551_01">1</a></sup> {@“वट ग्रन्थे”@} <sup id="ref_krm_1551_02"><a href="#foot_krm_1551_02">2</a></sup> अदन्तः। </li> <li>‘णावदन्ताद्वटेर्ग्रन्थे वटयेद् वेष्टने वटेत्।।’ <sup id="ref_krm_1551_03"><a href="#foot_krm_1551_03">3</a></sup> इति देवः। </li> <li>‘-- वेष्टे भागे च’ इति वोपदेवः। </li> <li>‘--वेष्टने इत्येके’ इति धा। </li> <li>का। </li> <li>व्याख्याने <sup id="ref_krm_1551_04"><a href="#foot_krm_1551_04">4</a></sup>। </li> <li>‘--वेष्टने’ इति क्षीरस्वामी इति मा। </li> <li>धा। </li> <li>वृत्तौ उक्तम्। </li> <li>क्षीरतरङ्गिण्यां तु “वट ग्रन्थे। </li> <li>ग्रन्थो = वेष्टनम्” इत्येव दृश्यते। </li> <li><sup id="ref_krm_1551_05"><a href="#foot_krm_1551_05">5</a></sup> वटकः-टिका, विवटयिषकः-षिका;</li> <li>  वटयिता-त्री, विवटयिषिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि चौरादिककलयतिवत् <sup id="ref_krm_1551_06"><a href="#foot_krm_1551_06">6</a></sup> ऊह्यानि। </li> <li>ल्युटि वटनम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1551_01"><a href="#ref_krm_1551_01">↑</a> (१५४०)</li> <li id="foot_krm_1551_02"><a href="#ref_krm_1551_02">↑</a> (१०-चुरादिः-१८५८। सक। सेट्। उभ।)</li> <li id="foot_krm_1551_03"><a href="#ref_krm_1551_03">↑</a> (श्लो। ७७)</li> <li id="foot_krm_1551_04"><a href="#ref_krm_1551_04">↑</a> (३-५४)</li> <li id="foot_krm_1551_05"><a href="#ref_krm_1551_05">↑</a> [[२। अदन्तपाठसामर्थ्यात् अत्र सर्वत्र अल्लोपस्य स्थानिवत्त्वात् उपधावृद्धिः न भवति।]]</li> <li id="foot_krm_1551_06"><a href="#ref_krm_1551_06">↑</a> (१७६)</li></ul></p>

वट|वटकः-टिका|विवटयिषकःषिका|वटयिता-त्री|विवटयिषिता-त्री|इदित्पाठपक्षे-वण्टकः-ण्टिका|विवण्टयिषकः-षिका|वण्टयिता-त्री|विवण्टयि-|षिता-त्री
<ul><li><sup id="ref_krm_1552_01"><a href="#foot_krm_1552_01">1</a></sup> {@“वट विभाजने”@} <sup id="ref_krm_1552_02"><a href="#foot_krm_1552_02">2</a></sup> अदन्तः। </li> <li>मा। </li> <li>धातुवृत्ति, सि। </li> <li>कौमुद्याद्यनुसारेण अयं पाठो लिखितः। </li> <li>‘णावदन्ताद्वटेर्ग्रन्थे वटयेद् वेष्टने वटेत्।।’ <sup id="ref_krm_1552_03"><a href="#foot_krm_1552_03">3</a></sup> इति देवः। </li> <li>अत्र क्षीरस्वामिना ‘वटि विभाजने’ इत्येव उक्तम्। </li> <li>किंच तत्र “<sup id="ref_krm_1552_04"><a href="#foot_krm_1552_04">4</a></sup> नन्दिमते वण्टति” इति दृश्यते। </li> <li>मैत्रेयोऽपि एवमेव इति मा। </li> <li>धा। </li> <li>वृत्ति- दर्शनाज्ज्ञायते। </li> <li>सि। </li> <li>कौमुद्यां तु ‘वट--’ इति पठित्वा वटि--’ इत्येके’ इति। </li> <li>वटेः पुनःपाठोऽर्थभेदात् इति ज्ञेयम्। </li> <li>अयं धातुः कथाद्यन्तर्गणः इति शाकटायनमतम्। </li> <li>वटकः-टिका, विवटयिषकःषिका;</li> <li>  वटयिता-त्री, विवटयिषिता-त्री;</li> <li>  इत्यादिकानि रूपाणि सर्वाणि चौरादिककलयतिवत् <sup id="ref_krm_1552_05"><a href="#foot_krm_1552_05">5</a></sup> ज्ञेयानि। </li> <li>शतरि--वटयन्। </li> <li>इदित्पाठपक्षे-वण्टकः-ण्टिका, विवण्टयिषकः-षिका;</li> <li>  वण्टयिता-त्री, विवण्टयि- षिता-त्री;</li> <li>  इत्यादीनि रूपाणि ऊह्यानि। </li> <li><sup id="ref_krm_1552_06"><a href="#foot_krm_1552_06">6</a></sup> वण्टापयकः-यिका, इति अस्य घातोः विशेषः। </li> <li>इदित्त्वाण्णिज्विकल्पः इत्यपि ज्ञेयम्। </li> <li><sup id="ref_krm_1552_07"><a href="#foot_krm_1552_07">7</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1552_01"><a href="#ref_krm_1552_01">↑</a> (१५४१)</li> <li id="foot_krm_1552_02"><a href="#ref_krm_1552_02">↑</a> (१०-चुरादिः-१९१९। सक। सेट्। उभ।)</li> <li id="foot_krm_1552_03"><a href="#ref_krm_1552_03">↑</a> (श्लो। ७७)</li> <li id="foot_krm_1552_04"><a href="#ref_krm_1552_04">↑</a> (भ्वादौ)</li> <li id="foot_krm_1552_05"><a href="#ref_krm_1552_05">↑</a> (१७६)</li> <li id="foot_krm_1552_06"><a href="#ref_krm_1552_06">↑</a> [[३। ‘कथादिपातिस्फायो पुग्लुग्वत्वम्’ इति शाकटायनसूत्रात् कथादीनां धातूनां णौ परतः पुगागमे, वृद्धौ च एवं रूपम्। इति माधवः (चुरादौ लजधातुप्रकरणे)।]]</li> <li id="foot_krm_1552_07"><a href="#ref_krm_1552_07">↑</a> [पृष्ठम्११८७+ २६]</li></ul></p>

वटि|वण्टकः-ण्टिका|विवण्टयिषकः-षिका|विवण्टिषकः-षिका|वावण्टकः-ण्टिका|वण्टयिता-त्री|विवण्टयिषिता-त्री|वण्टिता-त्री|विवण्टिषिता-त्री|वावण्टिता-त्री|वण्टयन्-न्ती|विवण्टयिषन्-न्ती|वण्टन्-न्ती|विवण्टिषन्-न्ती|तृतीयान्तमितिपक्षे|वण्डकः|विवण्डयिषकः|वण्डयिता-त्री|विवण्डयिषिता-त्री
<ul><li><sup id="ref_krm_1553_01"><a href="#foot_krm_1553_01">1</a></sup> {@“वटि विभाजने”@} <sup id="ref_krm_1553_02"><a href="#foot_krm_1553_02">2</a></sup> इदित्त्वात् णिज्विकल्पः। </li> <li>क्षीरस्वामी ‘वडि--’ इति पठित्वा ‘टान्त इत्येके’ इत्युक्तवान्। </li> <li><sup id="ref_krm_1553_03"><a href="#foot_krm_1553_03">3</a></sup> भ्वादौ ‘वटि विभाजने’ इत्यत्र ‘चुरादौ <sup id="ref_krm_1553_04"><a href="#foot_krm_1553_04">4</a></sup> वण्टयति’ इति क्षीरस्वामिना उक्तत्वात् ‘वटि’ इति प्रथमान्तमेवेति तस्याभिप्रायो ज्ञायते। </li> <li>‘वडीति शाकटायनः’ इति। </li> <li>मा। </li> <li>धा। </li> <li>वृत्तौ। </li> <li>‘वण्टयेद् वण्टतीत्येते णिशपोः स्तां विभाजने।’ <sup id="ref_krm_1553_05"><a href="#foot_krm_1553_05">5</a></sup> इति देवः। </li> <li>‘वण्टापयेत् इति तु शाकटायनः’ इति पुरुषकारः। </li> <li>वण्टकः-ण्टिका, विवण्टयिषकः-षिका, वण्टकः-ण्टिका, विवण्टिषकः-षिका, वावण्टकः-ण्टिका;</li> <li>  वण्टयिता-त्री, विवण्टयिषिता-त्री, वण्टिता-त्री, विवण्टिषिता-त्री, वावण्टिता-त्री;</li> <li>  वण्टयन्-न्ती, विवण्टयिषन्-न्ती, वण्टन्-न्ती, विवण्टिषन्-न्ती;</li> <li>  इत्यादिकानि रूपाणि सर्वाणि ण्यन्तात् सन्नन्तं विना भौवादिककण्ठतिवत् <sup id="ref_krm_1553_06"><a href="#foot_krm_1553_06">6</a></sup> ज्ञेयानि। </li> <li>ण्यन्तात् सनि तु सर्वाणि रूपाणि चौरादिकशोकार्थककण्ठ- यतिवत् <sup id="ref_krm_1553_07"><a href="#foot_krm_1553_07">7</a></sup> बोध्यानि। </li> <li>तृतीयान्तमिति <sup id="ref_krm_1553_08"><a href="#foot_krm_1553_08">8</a></sup> पक्षे वण्डकः, विवण्डयिषकः;</li> <li>  वण्डयिता-त्री, विवण्डयिषिता-त्री;</li> <li>  इत्येवमूह्यम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1553_01"><a href="#ref_krm_1553_01">↑</a> (१५४२)</li> <li id="foot_krm_1553_02"><a href="#ref_krm_1553_02">↑</a> (१०-चुरादिः-१५८६। सक। सेट्। उभ।)</li> <li id="foot_krm_1553_03"><a href="#ref_krm_1553_03">↑</a> [[१। क्षीरतरङ्गिण्यां भ्वादौ ‘वटि विभाजने’ इति दृश्यते। अन्यत्र कोशेषु भ्वादौ न दृश्यते।]]</li> <li id="foot_krm_1553_04"><a href="#ref_krm_1553_04">↑</a> (१०-४३)</li> <li id="foot_krm_1553_05"><a href="#ref_krm_1553_05">↑</a> (श्लो। ७७)</li> <li id="foot_krm_1553_06"><a href="#ref_krm_1553_06">↑</a> (१४९)</li> <li id="foot_krm_1553_07"><a href="#ref_krm_1553_07">↑</a> (१५०)</li> <li id="foot_krm_1553_08"><a href="#ref_krm_1553_08">↑</a> (वडि)</li></ul></p>

वठ|वाठकः-ठिका|विवठिषकः-षिका|वावठकः-ठिका|वठिता-त्री|वाठयिता-त्री|विवठिषिता-त्री|वावठिता-त्री|वठन्-न्ती
<ul><li><sup id="ref_krm_1554_01"><a href="#foot_krm_1554_01">1</a></sup> {@“वठ स्थौल्ये”@} <sup id="ref_krm_1554_02"><a href="#foot_krm_1554_02">2</a></sup> ‘वण्ठते त्वेकचर्यायां स्थौल्ये शपि वठेदिति।’ <sup id="ref_krm_1554_03"><a href="#foot_krm_1554_03">3</a></sup> इति देवः। </li> <li>वाठकः-ठिका, वाठकः-ठिका, विवठिषकः-षिका, वावठकः-ठिका;</li> <li>  वठिता-त्री, वाठयिता-त्री, विवठिषिता-त्री, वावठिता-त्री;</li> <li>  वठन्-न्ती;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि भौवादिककठतिवत् <sup id="ref_krm_1554_04"><a href="#foot_krm_1554_04">4</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1554_01"><a href="#ref_krm_1554_01">↑</a> (१५४३)</li> <li id="foot_krm_1554_02"><a href="#ref_krm_1554_02">↑</a> (१-भ्वादिः-३३१। अक। सेट्। पर।)</li> <li id="foot_krm_1554_03"><a href="#ref_krm_1554_03">↑</a> (श्लो। ८३)</li> <li id="foot_krm_1554_04"><a href="#ref_krm_1554_04">↑</a> (१४८)</li></ul></p>

वठि|वण्ठकः-ण्ठिका|विवण्ठिषकः-षिका|वावण्ठकः-ण्ठिका|वण्ठिता-त्री|वण्ठयिता-त्री|विवण्ठिषिता-त्री|वावण्ठिता-त्री
<ul><li><sup id="ref_krm_1555_01"><a href="#foot_krm_1555_01">1</a></sup> {@“वठि एकचर्यायाम्”@} <sup id="ref_krm_1555_02"><a href="#foot_krm_1555_02">2</a></sup> ‘वण्ठते त्वेकचर्यायां स्थौल्ये शपि वठेदिति।’ <sup id="ref_krm_1555_03"><a href="#foot_krm_1555_03">3</a></sup> इति देवः। </li> <li>‘एकस्य चर्या = एकचर्या = सहायत्वेनागमनम्’ इति क्षीरतरङ्गिण्याम्। </li> <li>‘-- असहायगमनम्’ इति धा। </li> <li>का। </li> <li>व्याख्यायाम् <sup id="ref_krm_1555_04"><a href="#foot_krm_1555_04">4</a></sup>। </li> <li>बालमनो- रमायामपि एवमेव। </li> <li><sup id="ref_krm_1555_05"><a href="#foot_krm_1555_05">5</a></sup> वण्ठकः-ण्ठिका, वण्ठकः-ण्ठिका, विवण्ठिषकः-षिका, वावण्ठकः-ण्ठिका;</li> <li>  वण्ठिता-त्री, वण्ठयिता-त्री, विवण्ठिषिता-त्री, वावण्ठिता-त्री;</li> <li>  इत्यादीनि रूपाणि सर्वाण्यपि भौवादिककण्ठतिवत् <sup id="ref_krm_1555_06"><a href="#foot_krm_1555_06">6</a></sup> ऊह्यानि। </li> <li>घञि वण्ठः = ‘वण्ठरण्डाकल्पः’ इति महाभाष्यं <sup id="ref_krm_1555_07"><a href="#foot_krm_1555_07">7</a></sup> ‘--मृतभार्य’ इति नागोजिभट्टो व्याचख्यौ। </li> <li>‘-- दत्तद्रव्यो योद्धा’ इति क्षीरस्वामी। </li> <li>क्विपि-प्रवन्-प्रवण्ठौ-प्रवण्ठः इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1555_01"><a href="#ref_krm_1555_01">↑</a> (१५४४)</li> <li id="foot_krm_1555_02"><a href="#ref_krm_1555_02">↑</a> (१-भ्वादिः-२६२। सक। सेट्। आत्म।)</li> <li id="foot_krm_1555_03"><a href="#ref_krm_1555_03">↑</a> (श्लो। ८३)</li> <li id="foot_krm_1555_04"><a href="#ref_krm_1555_04">↑</a> (१-३५)</li> <li id="foot_krm_1555_05"><a href="#ref_krm_1555_05">↑</a> [पृष्ठम्११८८+ २४]</li> <li id="foot_krm_1555_06"><a href="#ref_krm_1555_06">↑</a> (१४९)</li> <li id="foot_krm_1555_07"><a href="#ref_krm_1555_07">↑</a> (३-३-२०)</li></ul></p>

वडि|वण्डकः-ण्डिका|विवण्डिषकः-षिका|वावण्डकः-ण्डिका|वण्डिता-त्री|वण्डयिता-त्री|विवण्डिषिता-त्री|वावण्डिता-त्री
<ul><li><sup id="ref_krm_1556_01"><a href="#foot_krm_1556_01">1</a></sup> {@“वडि विभाजने”@} <sup id="ref_krm_1556_02"><a href="#foot_krm_1556_02">2</a></sup> ‘विभाजनम् = भागीकरणम्, चर्माभावश्च। </li> <li>‘चुरादौ <sup id="ref_krm_1556_03"><a href="#foot_krm_1556_03">3</a></sup> इत्येवमेव।]] वण्डयति’ इति क्षीरस्वामी। </li> <li>चर्माभावो नाम शिपिविष्टता <sup id="ref_krm_1556_04"><a href="#foot_krm_1556_04">4</a></sup>--वागीशः। </li> <li>‘-- वेष्टने’ इति मैत्रेयः। </li> <li>“नन्दी तु वटि विभाजने, वडि वेष्टने इति भङ्ग्या पठति” इति क्षीरस्वामिवचनमिहानुसन्धेयम्। </li> <li>“काशकृत्स्न- धातुपाठकन्नडटीकायां ‘वडि वेष्टने’ इति पाठः। </li> <li>वाहीक <sup id="ref_krm_1556_05"><a href="#foot_krm_1556_05">5</a></sup> देशीय- भाषायां विभाजनार्थिका ‘वण्डना’ क्रिया प्रयुज्यते। </li> <li>तेन ‘विभाजने’ इत्यप्यर्थः प्रामाणिक एव” इति तत्र टिप्पन्यामुक्तं युधिष्ठिरमीमांसकेन। </li> <li>वण्डकः-ण्डिका, वण्डकः-ण्डिका, विवण्डिषकः-षिका, वावण्डकः-ण्डिका;</li> <li>  वण्डिता-त्री, वण्डयिता-त्री, विवण्डिषिता-त्री, वावण्डिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककम्पतिवत् <sup id="ref_krm_1556_06"><a href="#foot_krm_1556_06">6</a></sup> ज्ञेयानि। </li> <li>धा। </li> <li>का। </li> <li>व्याख्यायाम् <sup id="ref_krm_1556_07"><a href="#foot_krm_1556_07">7</a></sup> ‘वेष्टनेऽपीत्येके’ इत्युक्तम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1556_01"><a href="#ref_krm_1556_01">↑</a> (१५४५)</li> <li id="foot_krm_1556_02"><a href="#ref_krm_1556_02">↑</a> (१-भ्वादिः-२७१। सक। सेट्। आत्म।)</li> <li id="foot_krm_1556_03"><a href="#ref_krm_1556_03">↑</a> [[१। ‘वडि विभाजने’ इति (चुरादौ) पठित्वा, ‘टान्त इत्येके’ इति क्षीरतरङ्गिण्यां दृश्यते। शाकटायनस्तु [वडि]</li> <li id="foot_krm_1556_04"><a href="#ref_krm_1556_04">↑</a> (द्विनग्नता)</li> <li id="foot_krm_1556_05"><a href="#ref_krm_1556_05">↑</a> (पञ्जाब्)</li> <li id="foot_krm_1556_06"><a href="#ref_krm_1556_06">↑</a> (१६६)</li> <li id="foot_krm_1556_07"><a href="#ref_krm_1556_07">↑</a> (१-३६)</li></ul></p>

वण|वाणकः-णिका|विवणिषकः-षिका|वंवणकः-णिका|वणिता-त्री|वाणयिता-त्री|विवणिषिता-त्री|वंवणिता-त्री
<ul><li><sup id="ref_krm_1557_01"><a href="#foot_krm_1557_01">1</a></sup> {@“वण शब्दार्थः”@} <sup id="ref_krm_1557_02"><a href="#foot_krm_1557_02">2</a></sup> ‘व्रण--’ इति धा। </li> <li>का। </li> <li>व्याख्यायाम् <sup id="ref_krm_1557_03"><a href="#foot_krm_1557_03">3</a></sup>। </li> <li>वाणकः-णिका, वाणकः-णिका, विवणिषकः-षिका, वंवणकः-णिका;</li> <li>  वणिता-त्री, वाणयिता-त्री, विवणिषिता-त्री, वंवणिता-त्री;</li> <li>  <sup id="ref_krm_1557_04"><a href="#foot_krm_1557_04">4</a></sup> इत्यादिकानि रूपाणि सर्वाण्यपि भौवादिककणतिवत् <sup id="ref_krm_1557_05"><a href="#foot_krm_1557_05">5</a></sup> ज्ञेयानि। </li> <li>उद्वणः, उल्बणः, <sup id="ref_krm_1557_06"><a href="#foot_krm_1557_06">6</a></sup> वाणः, <sup id="ref_krm_1557_07"><a href="#foot_krm_1557_07">7</a></sup> बाणः, वाणी <sup id="ref_krm_1557_08"><a href="#foot_krm_1557_08">8</a></sup>, <sup id="ref_krm_1557_09"><a href="#foot_krm_1557_09">9</a></sup> वाणिः, अन्तर्वाणिः वाणिनी <sup id="ref_krm_1557_10"><a href="#foot_krm_1557_10">10</a></sup>, इत्यादीनि रूपाणि अस्य धातोः विशेषेण भवन्तीति ज्ञेयम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1557_01"><a href="#ref_krm_1557_01">↑</a> (१५४६)</li> <li id="foot_krm_1557_02"><a href="#ref_krm_1557_02">↑</a> (१-भ्वादिः-४४६। अक। सेट्। पर।)</li> <li id="foot_krm_1557_03"><a href="#ref_krm_1557_03">↑</a> (१-५८।)</li> <li id="foot_krm_1557_04"><a href="#ref_krm_1557_04">↑</a> [पृष्ठम्११८९+ २५]</li> <li id="foot_krm_1557_05"><a href="#ref_krm_1557_05">↑</a> (१५७)</li> <li id="foot_krm_1557_06"><a href="#ref_krm_1557_06">↑</a> [[१। ‘हलश्च’ (३-३-१२१) इति संज्ञायां घञ्प्रत्यये रूपमेवम्।]]</li> <li id="foot_krm_1557_07"><a href="#ref_krm_1557_07">↑</a> [[२। ‘बणत्यस्मिन् ज्या इति-बाणः’ इति क्षीरतरङ्गिण्यामुपात्तत्वात् केचित् अस्य ‘वण’ इत्यस्य ‘बण’ इति अभिप्रयन्ति इति ज्ञायते।]]</li> <li id="foot_krm_1557_08"><a href="#ref_krm_1557_08">↑</a> [[३। ‘इञ् वपादिभ्यः’ (वा। ३-३-१०८) इति इञन्तात् ‘सर्वतोऽक्तिन्नर्थादित्येके’ (ग। सू। ४-१-४५) इति ङीन् भवति इति मा। धा। वृत्तिः। वस्तुतस्तु ‘कृदिकारादक्तिनः’ (गणसूत्रम् ४-१-४५) इति ङीष्प्रत्ययेऽपि रूपमेवम्। ‘--गीर्वाक् वाणी सरस्वती’ इत्यमरः।]]</li> <li id="foot_krm_1557_09"><a href="#ref_krm_1557_09">↑</a> [[४। ‘इण् अजादिभ्यः’ (वा। ३-३-१०८) इति भावे इण्प्रत्यये वाणिः इति। वाणिः = वाक् इत्यमरः। ‘वाणिः स्याद् दूतिभारत्योर्वाणिः मूल्ये बलाहके’ इति विश्वः। ‘बलीवर्दपङ्क्तिरिव समाधुर्या वाणी मनोहरति’ इति दमयन्ती- श्लेषाद्दीर्घान्तोऽपि वाणीशब्दः।]]</li> <li id="foot_krm_1557_10"><a href="#ref_krm_1557_10">↑</a> [[५। अवश्यं वणतीति व्युत्पत्त्यां ‘आवश्यकाधमर्ण्ययोर्णिनिः’ (३-३-१७०) इति आवश्य- कार्थे णिनिप्रत्यये तदन्तात् ङीपि रूपमेवम्। वाणिनी = विदग्धस्त्री।]]</li></ul></p>

