<ul><li><sup id="ref_krm_0253_01"><a href="#foot_krm_0253_01">1</a></sup> {@“कृती छेदने”@} <sup id="ref_krm_0253_02"><a href="#foot_krm_0253_02">2</a></sup> मुचादिः। </li> <li>‘कृणत्ति कृन्ततीत्येते वेष्टने च्छेदने क्रमात्। </li> <li>कीर्तयेदिति संशब्दे--’ <sup id="ref_krm_0253_03"><a href="#foot_krm_0253_03">3</a></sup> इति देवः। </li> <li>कर्तकः-र्तिका, कर्तकः-र्तिका, <sup id="ref_krm_0253_04"><a href="#foot_krm_0253_04">4</a></sup> चिकृत्सकः- <sup id="ref_krm_0253_05"><a href="#foot_krm_0253_05">5</a></sup> चिकर्तिषकः, <sup id="ref_krm_0253_06"><a href="#foot_krm_0253_06">6</a></sup> चरीकृतकः-तिका;</li> <li>  कर्तिता-त्री, कर्तयिता-त्री, चिकृत्सिता-त्री, चिकर्तिषिता-त्री, चरीकृतिता-त्री;</li> <li>  <sup id="ref_krm_0253_07"><a href="#foot_krm_0253_07">7</a></sup> कृन्तन् <sup id="ref_krm_0253_08"><a href="#foot_krm_0253_08">8</a></sup> - <sup id="ref_krm_0253_09"><a href="#foot_krm_0253_09">9</a></sup> न्ती-ती, कर्तयन्-न्ती, चिकृत्सन्-चिकर्तिषन्-न्ती;</li> <li>  -- <sup id="ref_krm_0253_10"><a href="#foot_krm_0253_10">10</a></sup> कर्तिष्यन् <sup id="ref_krm_0253_11"><a href="#foot_krm_0253_11">11</a></sup> -कर्त्स्यन्-न्ती-ती, कर्तयिष्यन्-न्ती-ती, चिकृत्सिष्यन्-चिकर्तिषि-ष्यन्-न्ती-ती;</li> <li>  <sup id="ref_krm_0253_12"><a href="#foot_krm_0253_12">12</a></sup> <sup id="ref_krm_0253_13"><a href="#foot_krm_0253_13">13</a></sup> व्यतिकृन्तमानः, कर्तयमानः, -- चरीकृत्यमानः;</li> <li>  व्यतिकर्तिष्यमाणः-व्यतिकर्त्स्यमानः, कर्तयिष्यमाणः, <sup id="ref_krm_0253_14"><a href="#foot_krm_0253_14">14</a></sup> चरीकृतिष्यमाणः;</li> <li>  काष्ठकृत्-कृतौ-कृतः;</li> <li>  -- -- -- <sup id="ref_krm_0253_15"><a href="#foot_krm_0253_15">15</a></sup> कृत्तम् <sup id="ref_krm_0253_16"><a href="#foot_krm_0253_16">16</a></sup> -त्तः, कर्तितः, चिकृत्सितः-चिकर्तिषितः, चरीकृतितः-तवान्;</li> <li>  <sup id="ref_krm_0253_17"><a href="#foot_krm_0253_17">17</a></sup> कृतः, <sup id="ref_krm_0253_18"><a href="#foot_krm_0253_18">18</a></sup> विकर्तनः, कर्तः, चिकृत्सुः-चिकर्तिषुः, चरीकृतः;</li> <li>  कर्तितव्यम्, कर्तयितव्यम्, चिकृत्सितव्यम्-चिकर्तिषितव्यम्, चरीकृतितव्यम्;</li> <li>  कर्तनीयम्, कर्तनीयम्, चिकृत्सनीयम्-चिकर्तिषणीयम्, चरीकृतनीयम्;</li> <li>  <sup id="ref_krm_0253_19"><a href="#foot_krm_0253_19">19</a></sup> कृत्यम्, कर्त्यम्, चिकृत्स्यम्-चिकर्तिष्यम्, चरीकृत्यम्;</li> <li>  ईषत्कर्तः-दुष्कर्तः-सुकर्तः;</li> <li>  -- -- -- कृत्यमानः, कर्त्यमानः, चिकृत्यमानः-चिकर्तिष्यमाणः, चरीकृत्यमानः;</li> <li>  कर्तः, कर्तः, चिकृत्सः-चिकर्तिषः, चरीकृतः;</li> <li>  कर्तितुम्, कर्तयितुम्, चिकृत्सितुम्-चिकर्तिषितुम्, चरीकृतितुम्;</li> <li>  कृतिः, कर्तना-चिकृत्सा, चिकर्तिषा-चरीकृता;</li> <li>  कर्तनम्, कर्तनम्, चिकृत्सनम्-चिकर्तिषणम्, चरीकृतनम्;</li> <li>  <sup id="ref_krm_0253_20"><a href="#foot_krm_0253_20">20</a></sup> कर्तित्वा, कर्तयित्वा, चिकृत्सित्वा-चिकर्तिषित्वा, चरीकृतित्वा;</li> <li>  विकृत्य, विकर्त्य, विचिकृत्स्य-विचिकर्तिष्य, प्रचरीकृत्य;</li> <li>  -- कर्तम् २, कर्तित्वा २, कर्तम् २, कर्तयित्वा २, चिकृत्सम् २, चिकृत्सित्वा २, चिकर्तिषम् २, चिकर्तिषित्वा २, चरीकृतम् २;</li> <li>  चरीकृतित्वा २। <sup id="ref_krm_0253_21"><a href="#foot_krm_0253_21">21</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0253_01"><a href="#ref_krm_0253_01">↑</a> (२४८)</li> <li id="foot_krm_0253_02"><a href="#ref_krm_0253_02">↑</a> (६-तुदादिः-१४३५। सक। सेट्। पर।)</li> <li id="foot_krm_0253_03"><a href="#ref_krm_0253_03">↑</a> (श्लो-९५)</li> <li id="foot_krm_0253_04"><a href="#ref_krm_0253_04">↑</a> [[३। ‘हलन्ताच्च’ (१-२-१०) इति सनः कित्त्वाद्गुणाभावः।]]</li> <li id="foot_krm_0253_05"><a href="#ref_krm_0253_05">↑</a> [[४। ‘सेऽसिचि कृतचृतछृदतृदनृतः’ (७-२-५७) इति सनः इड्विकल्पः। इटि गुणः।]]</li> <li id="foot_krm_0253_06"><a href="#ref_krm_0253_06">↑</a> [[५। ‘रीगृदुपधस्य च’ (७-४-९०) इत्यभ्यासस्य रीगागमः।]]</li> <li id="foot_krm_0253_07"><a href="#ref_krm_0253_07">↑</a> [[६। ‘शे मुचादीनाम्’ (७-१-५९) इति नुम्।]]</li> <li id="foot_krm_0253_08"><a href="#ref_krm_0253_08">↑</a> [[आ। ‘भुक्त्वा गोरससिक्तमन्नमजितः कंसस्य कृन्तन् मुदं तं खेत्स्यन् पिशिताशदारुणमसौ मोदेन निन्येनिशाम्।।’ धा। का। २-८४।]]</li> <li id="foot_krm_0253_09"><a href="#ref_krm_0253_09">↑</a> [[७। ‘आच्छीनद्योर्नुम्’ (७-१-८०) इति नुम् वा।]]</li> <li id="foot_krm_0253_10"><a href="#ref_krm_0253_10">↑</a> [[८। ‘सेऽसिचि--’ (७-२-५७) इति सादेरार्धधातुकस्य इड् वा।]]</li> <li id="foot_krm_0253_11"><a href="#ref_krm_0253_11">↑</a> [[B। ‘वनं चचार कर्तिष्थन् नर्त्स्यन्निव निरङ्कुशः।।’ भ। का। ९-४२।]]</li> <li id="foot_krm_0253_12"><a href="#ref_krm_0253_12">↑</a> [पृष्ठम्०२४६+ २२]</li> <li id="foot_krm_0253_13"><a href="#ref_krm_0253_13">↑</a> [[१। ‘कर्तरि कर्मव्यतीहारे’ (१-३-१४) इति शानच्।]]</li> <li id="foot_krm_0253_14"><a href="#ref_krm_0253_14">↑</a> [[२। यङः, अल्लोपस्य स्थानिवद्भावात् गुणो न।]]</li> <li id="foot_krm_0253_15"><a href="#ref_krm_0253_15">↑</a> [[३। ‘श्वीदितो निष्ठायाम्’ (७-२-१४) इति इण्णिषेधः।]]</li> <li id="foot_krm_0253_16"><a href="#ref_krm_0253_16">↑</a> [[आ। ‘निकृत्तमत्तद्विपकुम्भमांसैः संपृक्तमुक्तैर्हरयोऽग्रपादैः।’ भ। का। ११-४२।]]</li> <li id="foot_krm_0253_17"><a href="#ref_krm_0253_17">↑</a> [[४। ‘इगुपध--’ (३-१-१३५) इति कर्तरि कः प्रत्ययः।]]</li> <li id="foot_krm_0253_18"><a href="#ref_krm_0253_18">↑</a> [[५। नन्द्यादिपाठात् ‘नन्दिग्रहि--’ (३-१-१३४) इति कर्तरि ल्युः। विशेषेण कर्तयति भक्तानां रोगादिकमिति घिकर्तनः = सूर्यः। ‘आरोग्यं भास्करादिच्छेत्--’ इति स्मरणात्।]]</li> <li id="foot_krm_0253_19"><a href="#ref_krm_0253_19">↑</a> [[६। ‘ऋदुपधाच्चाकॢपि--’ (३-१-११०) इति क्यप्।]]</li> <li id="foot_krm_0253_20"><a href="#ref_krm_0253_20">↑</a> [[७। ‘न क्त्वा सेट्’ (१-२-१८) इति कित्त्वनिषेधात् गुणः।]]</li> <li id="foot_krm_0253_21"><a href="#ref_krm_0253_21">↑</a> [पृष्ठम्०२४७+ २५]</li></ul></p>

कृती|कर्तकः-र्तिका|चिकृत्सकः-चिकर्तिषकः-षिका|चरीकृतकः-|तिका
<ul><li><sup id="ref_krm_0254_01"><a href="#foot_krm_0254_01">1</a></sup> {@“कृती वेष्टने”@} <sup id="ref_krm_0254_02"><a href="#foot_krm_0254_02">2</a></sup> ‘कृणत्ति कृन्ततीत्येते वेष्टने च्छेदने क्रमात्। </li> <li>कीर्तयेदिति संशब्दे--’ <sup id="ref_krm_0254_03"><a href="#foot_krm_0254_03">3</a></sup> इति देवः। </li> <li>कर्तकः-र्तिका, कर्तकः-र्तिका, चिकृत्सकः-चिकर्तिषकः-षिका, चरीकृतकः- तिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि तौदादिककृतीधातुवत् <sup id="ref_krm_0254_04"><a href="#foot_krm_0254_04">4</a></sup> ज्ञेयानि। </li> <li>शतरि कृन्तन्-ती, ‘रुधादिभ्यः श्नम्’ <sup id="ref_krm_0254_05"><a href="#foot_krm_0254_05">5</a></sup> इति श्नमि, ‘श्नसोरल्लोपः’ <sup id="ref_krm_0254_06"><a href="#foot_krm_0254_06">6</a></sup> इत्यल्लोपः, इति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0254_01"><a href="#ref_krm_0254_01">↑</a> (२४९)</li> <li id="foot_krm_0254_02"><a href="#ref_krm_0254_02">↑</a> (७-रुधादिः-१४४७। सक। सेट्। पर।)</li> <li id="foot_krm_0254_03"><a href="#ref_krm_0254_03">↑</a> (श्लो। ९५)</li> <li id="foot_krm_0254_04"><a href="#ref_krm_0254_04">↑</a> (२४८)</li> <li id="foot_krm_0254_05"><a href="#ref_krm_0254_05">↑</a> (३-१-७८)</li> <li id="foot_krm_0254_06"><a href="#ref_krm_0254_06">↑</a> (६-४-१११)</li></ul></p>

