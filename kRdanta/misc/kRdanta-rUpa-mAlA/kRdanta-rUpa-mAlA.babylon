<ul><li><sup id="ref_krm_0491_01"><a href="#foot_krm_0491_01">1</a></sup> {@“ङुङ् शब्दे”@} <sup id="ref_krm_0491_02"><a href="#foot_krm_0491_02">2</a></sup> ङावकः-विका, ङावकः-विका, <sup id="ref_krm_0491_03"><a href="#foot_krm_0491_03">3</a></sup> ञुङूषकः-षिका, ञोङूयकः-यिका;</li> <li>  ङोता-त्री, ङावयिता-त्री, ञुङूषिता-त्री, ञोङूयिता-त्री;</li> <li>  अित्यादीनि सर्वाण्यपि रूपाणि भौवादिकशब्दार्थक-कवति <sup id="ref_krm_0491_04"><a href="#foot_krm_0491_04">4</a></sup> वद्- बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0491_01"><a href="#ref_krm_0491_01">↑</a> (४८२)</li> <li id="foot_krm_0491_02"><a href="#ref_krm_0491_02">↑</a> (१-भ्वादिः-९५४। अक। अनि। आत्म।)</li> <li id="foot_krm_0491_03"><a href="#ref_krm_0491_03">↑</a> [[५। सन्नन्ते यङन्ते चाभ्यासे ‘कुहोश्चुः’ (७-४-६२) इत्यनेन च{??}र्गवञ्चमो ञकरो भवति]]</li> <li id="foot_krm_0491_04"><a href="#ref_krm_0491_04">↑</a> (१९८)</li></ul></p>

चक|चाककः-किका|चिचकिषकः-षिका|चाचककः-किका|चकिता-त्री|चकयिता-त्री|चिचकिषिता-त्री|चाचकिता-त्री|-|चाकयन्-न्ती|चाकयिष्यन्-न्ती-ती|-चकमानः|चाकयमानः|चिचकिषमाणः|चाचक्यमानः|चकिष्यमाणः|चाकयिष्यमाणः|चिचकिषिष्यमाणः|चाचकिष्यमाणः|चक्-चग्-चकौ-चकः
<ul><li><sup id="ref_krm_0492_01"><a href="#foot_krm_0492_01">1</a></sup> {@“चक तृप्तौ प्रतीघाते च”@} <sup id="ref_krm_0492_02"><a href="#foot_krm_0492_02">2</a></sup> “प्रतीघाते च तृप्तौ च चकते, चकतीति तु। </li> <li>तृप्तिमात्रे चकेरस्य मित्त्वात् चकयतीति णौ।।” <sup id="ref_krm_0492_03"><a href="#foot_krm_0492_03">3</a></sup> इति देवः। </li> <li>चाककः-किका, चाककः-किका, चिचकिषकः-षिका, चाचककः-किका;</li> <li>  चकिता-त्री, चकयिता-त्री, चिचकिषिता-त्री, चाचकिता-त्री;</li> <li>  -- चाकयन्-न्ती, चाकयिष्यन्-न्ती-ती;</li> <li>  -- -- <sup id="ref_krm_0492_04"><a href="#foot_krm_0492_04">4</a></sup> चकमानः, चाकयमानः, चिचकिषमाणः, चाचक्यमानः;</li> <li>  चकिष्यमाणः, चाकयिष्यमाणः, चिचकिषिष्यमाणः, चाचकिष्यमाणः;</li> <li>  चक्-चग्-चकौ-चकः;</li> <li>  -- -- इत्यादीनि सर्वाण्यपि रूपाणि ककधातुवत् <sup id="ref_krm_0492_05"><a href="#foot_krm_0492_05">5</a></sup> बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0492_01"><a href="#ref_krm_0492_01">↑</a> (४८३)</li> <li id="foot_krm_0492_02"><a href="#ref_krm_0492_02">↑</a> (१-भ्वादिः-९३। अक। सेट्। आत्म।)</li> <li id="foot_krm_0492_03"><a href="#ref_krm_0492_03">↑</a> (श्लो। ४०)</li> <li id="foot_krm_0492_04"><a href="#ref_krm_0492_04">↑</a> [पृष्ठम्०४६७+ २७]</li> <li id="foot_krm_0492_05"><a href="#ref_krm_0492_05">↑</a> (१३९)</li></ul></p>

चक|अतः|चकन्-न्ती|चकिष्यन्-न्ती-ती|चिचकिषन्-न्ती|चिचकिषिष्यन्-न्ती-ती
<ul><li><sup id="ref_krm_0493_01"><a href="#foot_krm_0493_01">1</a></sup> {@“चक तृप्तौ”@} <sup id="ref_krm_0493_02"><a href="#foot_krm_0493_02">2</a></sup> घटादिः। </li> <li>“प्रतीघाते च तृप्तौ च चकते, चकतीति तु। </li> <li>तृप्तिमात्रे चकेरस्य मित्त्वात् चकयतीति णौ।।” <sup id="ref_krm_0493_03"><a href="#foot_krm_0493_03">3</a></sup> इति देवः। </li> <li>पूर्वम् अनुदात्तेत्सु पठितस्यास्य धातोः तृप्तिरूपेऽर्थे मित्त्वार्थ परस्मैपदिनां मध्ये पुनः पाठः कृतः। </li> <li>अतः चकन्-न्ती, चकिष्यन्-न्ती-ती, चिचकिषन्-न्ती, चिचकिषिष्यन्-न्ती-ती;</li> <li>  इत्यादीनि रूपाणि अस्य धातोः भवन्ति। </li> <li>णौ परतः ‘मितां ह्रस्वः’ <sup id="ref_krm_0493_04"><a href="#foot_krm_0493_04">4</a></sup> इति उपधायाः ह्रस्वविधानात् चककः-किका, चकयिता-त्री, चकयमानः, चकयिष्यमाणः, इत्यादीनि रूपाणि बोध्यानि। </li> <li>णमुलि-- ‘चिण्णमुलोर्दीर्घोऽन्यतरस्याम्’ <sup id="ref_krm_0493_05"><a href="#foot_krm_0493_05">5</a></sup> इति उपधायाः दीर्घविकल्पेन चकम् २--चाकम् २, चकयित्वा २, इति रूपाणीति विशेषः। </li> <li>अन्यानि सर्वाण्यपि रूपाणि ककधातुवत् <sup id="ref_krm_0493_06"><a href="#foot_krm_0493_06">6</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0493_07"><a href="#foot_krm_0493_07">7</a></sup> इत्योरप्रत्ययः। </li> <li>चकतीति चकोरः = ज्यो- त्स्नापायिपक्षी।]] चकोरः <sup id="ref_krm_0493_08"><a href="#foot_krm_0493_08">8</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0493_01"><a href="#ref_krm_0493_01">↑</a> (४८४)</li> <li id="foot_krm_0493_02"><a href="#ref_krm_0493_02">↑</a> (१-भ्वादिः-७८३ अक। सेट्। पर।)</li> <li id="foot_krm_0493_03"><a href="#ref_krm_0493_03">↑</a> (श्लो। ४०)</li> <li id="foot_krm_0493_04"><a href="#ref_krm_0493_04">↑</a> (६-४-९२)</li> <li id="foot_krm_0493_05"><a href="#ref_krm_0493_05">↑</a> (६-४-९३)</li> <li id="foot_krm_0493_06"><a href="#ref_krm_0493_06">↑</a> (१३९)</li> <li id="foot_krm_0493_07"><a href="#ref_krm_0493_07">↑</a> [[१। ‘कठिचकिभ्यामोरः’ [द। उ। ८-२९]</li> <li id="foot_krm_0493_08"><a href="#ref_krm_0493_08">↑</a> [[आ। ‘वृकावृतान् मुग्धचकोरकूजितानुड्डीनकङ्कानयमत्यवङ्कत।।’ धा। का। १। १३।]]</li></ul></p>

चकासृ|चकासकः-सिका|चिचकासिषकः-षिका|चकासिता-त्री|चकासयिता-त्री|चिचकासिषिता-त्री|चकासत्-चकासतौ-चकासतः-ती|चकासयन्-न्ती|चिचकासिषन्-न्ती|चकासिष्यन्-न्ती-ती|चकासयिष्यन्-न्ती-ती|चिचकासिषिष्यन्-न्ती-ती|-|चकासयमानः|चकासयिष्यमाणः|-विचकात्-विचकाद्-विचकासौ-विचकासः|-चकासितम्-तः|चकासितः|चिचकासिषितः-तवान्|चकासः|चिचकासिषुः|चकासितव्यम्|चकासयितव्यम्|चिचकासिषितव्यम्|चकासनीयम्|चिचकासिषणीयम्|चकास्यम्|चिचकासिष्यम्|ईषच्चकासः-दुश्चकासः-सुचकासः|चकास्यमानः|चिचकासिष्यमाणः|चिचकासिषः|चकासितुम्|चकासयितुम्|चिचकासिषितुम्|चकासा|चकासना|चिचकासिषा|चकासनम्|चिचकासिषणम्|चकासित्वा|चकासयित्वा|चिचकासिषित्वा|विचकास्य|विचिचकासिष्य|चकासम्|चिचकासिषम्
<ul><li><sup id="ref_krm_0494_01"><a href="#foot_krm_0494_01">1</a></sup> {@“चकासृ दीप्तौ”@} <sup id="ref_krm_0494_02"><a href="#foot_krm_0494_02">2</a></sup> <sup id="ref_krm_0494_03"><a href="#foot_krm_0494_03">3</a></sup> अस्य धातोरनेकाच्त्वात्, ‘धातोरेकाचो हलादेः क्रियासमभिहारे यङ्’ <sup id="ref_krm_0494_04"><a href="#foot_krm_0494_04">4</a></sup> इति विहितो यङ्न भवति।]] जक्षित्यादिः। </li> <li>चकासकः-सिका, चकासकः-सिका, चिचकासिषकः-षिका;</li> <li>  चकासिता-त्री, चकासयिता-त्री, चिचकासिषिता-त्री;</li> <li>  <sup id="ref_krm_0494_05"><a href="#foot_krm_0494_05">5</a></sup> चकासत् <sup id="ref_krm_0494_06"><a href="#foot_krm_0494_06">6</a></sup> -चकासतौ-चकासतः-ती, चकासयन्-न्ती, चिचकासिषन्-न्ती;</li> <li>  <sup id="ref_krm_0494_07"><a href="#foot_krm_0494_07">7</a></sup> चकासिष्यन्-न्ती-ती, चकासयिष्यन्-न्ती-ती, चिचकासिषिष्यन्-न्ती-ती;</li> <li>  -- चकासयमानः, चकासयिष्यमाणः;</li> <li>  -- <sup id="ref_krm_0494_08"><a href="#foot_krm_0494_08">8</a></sup> विचकात्-विचकाद्-विचकासौ-विचकासः;</li> <li>  -- <sup id="ref_krm_0494_09"><a href="#foot_krm_0494_09">9</a></sup> चकासितम्-तः, चकासितः, चिचकासिषितः-तवान्;</li> <li>  चकासः, चकासः, चिचकासिषुः;</li> <li>  चकासितव्यम्, चकासयितव्यम्, चिचकासिषितव्यम्;</li> <li>  चकासनीयम्, चकासनीयम्, चिचकासिषणीयम्;</li> <li>  चकास्यम्, चकास्यम्, चिचकासिष्यम्;</li> <li>  ईषच्चकासः-दुश्चकासः-सुचकासः;</li> <li>  -- चकास्यमानः, चकास्यमानः, चिचकासिष्यमाणः;</li> <li>  चकासः, चकासः, चिचकासिषः;</li> <li>  चकासितुम्, चकासयितुम्, चिचकासिषितुम्;</li> <li>  <sup id="ref_krm_0494_10"><a href="#foot_krm_0494_10">10</a></sup> चकासा, चकासना, चिचकासिषा;</li> <li>  चकासनम्, चकासनम्, चिचकासिषणम्;</li> <li>  चकासित्वा, चकासयित्वा, चिचकासिषित्वा;</li> <li>  विचकास्य, विचकास्य, विचिचकासिष्य;</li> <li>  चकासम् २, चकासित्वा २, चकासम् २, चकासयित्वा २, चिचकासिषम् २;</li> <li>  चिचकासिषित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0494_01"><a href="#ref_krm_0494_01">↑</a> (४८५)</li> <li id="foot_krm_0494_02"><a href="#ref_krm_0494_02">↑</a> (२-अदादिः-१०७४। अक। सेट्। पर।)</li> <li id="foot_krm_0494_03"><a href="#ref_krm_0494_03">↑</a> [[[अ]</li> <li id="foot_krm_0494_04"><a href="#ref_krm_0494_04">↑</a> (३-१-२२)</li> <li id="foot_krm_0494_05"><a href="#ref_krm_0494_05">↑</a> [[२। ‘जक्षित्यादयः षट्’ (६-१-६) इत्यभ्यस्तसंज्ञायाम्, ‘नाभ्यस्ताच्छतुः’ (७-१-७८) इति नुम्निषेधः। स्त्रियामुगित्त्वा ङीष्।]]</li> <li id="foot_krm_0494_06"><a href="#ref_krm_0494_06">↑</a> [[B। ‘तं जाग्रतं दीनदरिद्रपोषे चकासतं शासतमप्रशान्तान्। देवं स्फुरद्दीधितिमम्बुजाक्ष्यो वेव्यानमालोक्य विमोहमापुः।।’ धा। का। २। ५२।]]</li> <li id="foot_krm_0494_07"><a href="#ref_krm_0494_07">↑</a> [पृष्ठम्०४६८+ २४]</li> <li id="foot_krm_0494_08"><a href="#ref_krm_0494_08">↑</a> [[१। ‘झलां जशोऽन्ते’ (८-२-३९) इत्यनेन पदान्ते जश्त्वम्। ‘वाऽवसाने’ (८-४-५६) इति चर्त्वविकल्पः।]]</li> <li id="foot_krm_0494_09"><a href="#ref_krm_0494_09">↑</a> [[२। दीप्तयर्थकत्वात् ‘गत्यर्थाकर्मक--’ (३-४-७२) इत्त्यादिना कर्तरि अधिकरणे च क्तप्रत्ययो ज्ञेयः।]]</li> <li id="foot_krm_0494_10"><a href="#ref_krm_0494_10">↑</a> [[३। ‘गुरोश्च हलः’ (३-३-१०३) इति अकारप्रत्ययः।]]</li></ul></p>

चक्क|चक्ककः-क्किका|चिचक्कयिषकः-षिका|चक्कयिता-त्री|चिचक्कयिषिता-त्री|क्विपिचक्-चक्कौ-चक्कः
<ul><li><sup id="ref_krm_0495_01"><a href="#foot_krm_0495_01">1</a></sup> {@“चक्क व्यथने”@} <sup id="ref_krm_0495_02"><a href="#foot_krm_0495_02">2</a></sup> चक्ककः-क्किका, चिचक्कयिषकः-षिका, चक्कयिता-त्री, चिचक्कयिषिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिक-कुट्टधातुवत् <sup id="ref_krm_0495_03"><a href="#foot_krm_0495_03">3</a></sup> बोध्यानि। </li> <li>क्विपि <sup id="ref_krm_0495_04"><a href="#foot_krm_0495_04">4</a></sup> चक्-चक्कौ-चक्कः;</li> <li>  इति रूपम्। </li> <li><sup id="ref_krm_0495_05"><a href="#foot_krm_0495_05">5</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0495_01"><a href="#ref_krm_0495_01">↑</a> (४८६)</li> <li id="foot_krm_0495_02"><a href="#ref_krm_0495_02">↑</a> (१०-चुरादिः-१५९५। सक। सेट्। उभ।)</li> <li id="foot_krm_0495_03"><a href="#ref_krm_0495_03">↑</a> (२०७)</li> <li id="foot_krm_0495_04"><a href="#ref_krm_0495_04">↑</a> [[आ। ‘दुर्दान्तचक् पशुपचुक्कनमप्यरौत्सीत् प्रक्षालितक्षितितलातुलवर्षरोधी।’ धा। का। ३-२१।]]</li> <li id="foot_krm_0495_05"><a href="#ref_krm_0495_05">↑</a> [पृष्ठम्०४६९+ २४]</li></ul></p>

