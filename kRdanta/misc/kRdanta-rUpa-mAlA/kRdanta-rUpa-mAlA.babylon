<ul><li><sup id="ref_krm_0916_01"><a href="#foot_krm_0916_01">1</a></sup> {@“धूञ् कम्पने”@} <sup id="ref_krm_0916_02"><a href="#foot_krm_0916_02">2</a></sup> ‘धूनयति धवति धवते, धुनोति धुनुते, धुनाति च धुनीते। </li> <li>धूनोति धूनुते स्युः पदानि कम्पे, विधूनने धुवति।।’ <sup id="ref_krm_0916_03"><a href="#foot_krm_0916_03">3</a></sup> इति देवः। </li> <li>धावकः-विका, <sup id="ref_krm_0916_04"><a href="#foot_krm_0916_04">4</a></sup> धूनकः-निका, <sup id="ref_krm_0916_05"><a href="#foot_krm_0916_05">5</a></sup> दुधूषकः-षिका, दोधूयकः-यिका;</li> <li>  <sup id="ref_krm_0916_06"><a href="#foot_krm_0916_06">6</a></sup> धोता-धविता-त्री, धूनयिता-त्री, दुधूषिता-त्री, दोधूयिता-त्री;</li> <li>  <sup id="ref_krm_0916_07"><a href="#foot_krm_0916_07">7</a></sup> धून्वन्-ती, <sup id="ref_krm_0916_08"><a href="#foot_krm_0916_08">8</a></sup> धूनयन्-न्ती, दुधूषन्-न्ती;</li> <li>  -- धोष्यन्-धविष्यन्-न्ती-ती, दुधूषिष्यन्-न्ती-ती;</li> <li>  -- धून्वानः, -- दुधूषमाणः, <sup id="ref_krm_0916_09"><a href="#foot_krm_0916_09">9</a></sup> दोधूयमानः;</li> <li>  धोष्यमाणः-धविष्यमाणः, -- दुधूषिष्यमाणः, दोधूयिष्यमाणः;</li> <li>  प्रधूः-प्रध्वौ-प्रध्वः;</li> <li>  -- -- <sup id="ref_krm_0916_10"><a href="#foot_krm_0916_10">10</a></sup> धूतम्- <sup id="ref_krm_0916_11"><a href="#foot_krm_0916_11">11</a></sup> धूतः-धूतवान्, धूनितः, दुधूषितः, दोधूयितः-तवान्;</li> <li>  <sup id="ref_krm_0916_12"><a href="#foot_krm_0916_12">12</a></sup> धवः, <sup id="ref_krm_0916_13"><a href="#foot_krm_0916_13">13</a></sup> धवनः, <sup id="ref_krm_0916_14"><a href="#foot_krm_0916_14">14</a></sup> परिधावी, धूनः, दुधूषुः, दोधुवः;</li> <li>  धोतव्यम्-धवितव्यम्, धूनयितव्यम्, दुधूषितव्यम्, दोधूयितव्यम्;</li> <li>  <sup id="ref_krm_0916_15"><a href="#foot_krm_0916_15">15</a></sup> धवनीयम्, धूननीयम्, दुधूषणीयम्, दोधूयनीयम्;</li> <li>  धव्यम्-अवश्यधाव्यम्, धून्यम्, दुधूष्यम्, दोधूय्यम्;</li> <li>  ईषद्धवः-दुर्धवः-सुधवः;</li> <li>  -- -- धूयमानः, धून्यमानः, दुधूष्यमाणः, दोधूय्यमानः;</li> <li>  <sup id="ref_krm_0916_16"><a href="#foot_krm_0916_16">16</a></sup> धवः, धूनः, दुधूषः, दोधूयः;</li> <li>  धोतुम्- <sup id="ref_krm_0916_17"><a href="#foot_krm_0916_17">17</a></sup> विधवितुम्, दुधूषितुम्, दोधूयितुम्;</li> <li>  धूतिः, धूनना, दुधूषा, दोधूया;</li> <li>  धवनम्, धूननम्, दुधूषणम्, दोधूयनम्;</li> <li>  धूत्वा, धूनयित्वा, दुधूषित्वा, दोधूयित्वा;</li> <li>  विधूय, विधून्य, विदुधूष्य, विदोधूय्य;</li> <li>  धावम् २, धूत्वा २, धूनम् २, धूनयित्वा २, दुधूषम् २, दुधूषित्वा २, दोधूयम् २;</li> <li>  दोधूयित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0916_01"><a href="#ref_krm_0916_01">↑</a> (९०६)</li> <li id="foot_krm_0916_02"><a href="#ref_krm_0916_02">↑</a> (५-स्वादिः-१२५५। अक। वेट्। उभ।)</li> <li id="foot_krm_0916_03"><a href="#ref_krm_0916_03">↑</a> (श्लो। २६)</li> <li id="foot_krm_0916_04"><a href="#ref_krm_0916_04">↑</a> [[१। ‘धूञ्प्रीञोर्नुग्वक्तव्यः’ (वा। ७-३-३७) इति ण्यन्ते सर्वत्र नुगागमः। लघूपधत्वा- भावान्न गुणः।]]</li> <li id="foot_krm_0916_05"><a href="#ref_krm_0916_05">↑</a> [[२। पुरस्तात् प्रतिषेधकाण्डारम्भसामर्थ्यात्’ ‘सनि ग्रहगुहोश्च’ (७-२-१२) इतीण्नि- षेधः। ‘इको झल्’ (१-२-९) इति सनः कित्त्वान्न गुणः। एवं सन्नन्ते सवत्र ज्ञेयम्।]]</li> <li id="foot_krm_0916_06"><a href="#ref_krm_0916_06">↑</a> [[३। ‘स्वरतिसूतिसूयतिधूञूदितो वा’ (७-२-४४) इति वलादेरार्धधातुकस्येड्विकल्पः। एवं तव्यदादिष्वपि ज्ञेयम्।]]</li> <li id="foot_krm_0916_07"><a href="#ref_krm_0916_07">↑</a> [[४। शतरि, ‘स्वादिभ्यः--’ (३-१-७३) इति श्नुप्रत्ययः। ‘हुश्नुवोः सार्वधातुके’ (६-४-८७) इति यण्। एवं धून्वानः इत्यत्रापि प्रक्रिया ज्ञेया।]]</li> <li id="foot_krm_0916_08"><a href="#ref_krm_0916_08">↑</a> [[५। ण्यन्तात् ‘निगरणचलनार्थेभ्यः--’ (१-३-८७) इति नित्यं शतैव। न शानच्।]]</li> <li id="foot_krm_0916_09"><a href="#ref_krm_0916_09">↑</a> [[आ। ‘दोधूयमानं विविधोर्मियोगात् छायागरुत्मन्तमवेक्ष्य भीताः।’ या। अ। १८। ९६।]]</li> <li id="foot_krm_0916_10"><a href="#ref_krm_0916_10">↑</a> [[६। निष्ठायाम्, ‘श्रयुकः क्किति’ (७-२-११) इति नित्यमिण्निषेधः।]]</li> <li id="foot_krm_0916_11"><a href="#ref_krm_0916_11">↑</a> [[B। ‘कुब्जा कृतारिबलमैक्षत वृण्वती सा पात्रं समीरधुतसौरभधूतभृङ्गम्।।’ धा। का। २। ६८।]]</li> <li id="foot_krm_0916_12"><a href="#ref_krm_0916_12">↑</a> [[७। धूनयति = कप्पयतीत्यर्थेऽन्तर्भावितण्यन्तादस्मात् कर्तरि पचाद्यचि रूपमेवम्।]]</li> <li id="foot_krm_0916_13"><a href="#ref_krm_0916_13">↑</a> [[८। निमित्तभेदेनास्य धातोरकर्मकत्वे, ‘चलनशब्दार्थादकर्मकाद् युच्’ (३-२-१४८) इति तच्छीलादिषु कर्तृषु युच्प्रत्ययः।]]</li> <li id="foot_krm_0916_14"><a href="#ref_krm_0916_14">↑</a> [[९। ताच्छील्ये णिनिप्रत्यये रूपमेवम्।]]</li> <li id="foot_krm_0916_15"><a href="#ref_krm_0916_15">↑</a> [पृष्ठम्०८०२+ २४]</li> <li id="foot_krm_0916_16"><a href="#ref_krm_0916_16">↑</a> [[१। भावे, ‘ॠदोरप्’ (३-३-५७) इत्यप्प्रत्ययः।]]</li> <li id="foot_krm_0916_17"><a href="#ref_krm_0916_17">↑</a> [[आ। ‘स मायानामगात् सोता कपेर्विधवितुं द्युतिम्।।’ भ। का। ९। २८।]]</li></ul></p>

धूञ्|घाबकः-विका|धूनकः-निका|दुधूषकः-षिका|दोधूयकः-यिका
<ul><li><sup id="ref_krm_0917_01"><a href="#foot_krm_0917_01">1</a></sup> {@“धूञ् कम्पने”@} <sup id="ref_krm_0917_02"><a href="#foot_krm_0917_02">2</a></sup> प्वादिः ल्वादिश्च। </li> <li>‘धूनयति धवति धवते, धुनोति धुनुते, धुनाति च धुनीते। </li> <li>धूनोति धूनुते स्युः पदानि कम्पे, विधूनने धुवति।।’ <sup id="ref_krm_0917_03"><a href="#foot_krm_0917_03">3</a></sup> इति देवः। </li> <li>घाबकः-विका, धूनकः-निका, दुधूषकः-षिका, दोधूयकः-यिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि पूर्वोक्तधूञ्धातुवत् <sup id="ref_krm_0917_04"><a href="#foot_krm_0917_04">4</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_0917_05"><a href="#foot_krm_0917_05">5</a></sup> धुनन्-ती, <sup id="ref_krm_0917_06"><a href="#foot_krm_0917_06">6</a></sup> धुनानः, धूनः, <sup id="ref_krm_0917_07"><a href="#foot_krm_0917_07">7</a></sup> धूनिः, इमानि रूपाणि अस्य धातोः भवन्तीति विशेषः। </li> <li><sup id="ref_krm_0917_08"><a href="#foot_krm_0917_08">8</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0917_01"><a href="#ref_krm_0917_01">↑</a> (९०७)</li> <li id="foot_krm_0917_02"><a href="#ref_krm_0917_02">↑</a> (९-क्र्यादिः-१४८७। सक। वेट्। उभ।)</li> <li id="foot_krm_0917_03"><a href="#ref_krm_0917_03">↑</a> (श्लो। २६)</li> <li id="foot_krm_0917_04"><a href="#ref_krm_0917_04">↑</a> (९०६)</li> <li id="foot_krm_0917_05"><a href="#ref_krm_0917_05">↑</a> [[२। शतरि, ‘क्र्यादिभ्यः--’ (३-१-८१) इति श्नाप्रत्यये, ‘प्वादीनां ह्रस्वः’ (७-३-८०) इति ह्रस्वे च रूपम्। एवं शानजन्तेऽपि प्रक्रिया ज्ञेया।]]</li> <li id="foot_krm_0917_06"><a href="#ref_krm_0917_06">↑</a> [[B। ‘नागं ददर्श पटपूर्णमुखं धुनानं कर्णों शृणन्तमखिलानभिपूर्तरोषम्।।’ धा। का। ३। ६।]]</li> <li id="foot_krm_0917_07"><a href="#ref_krm_0917_07">↑</a> [[३। ‘ॠल्वादिभ्यः क्तिन् निष्ठावद् वक्तव्यः’ (वा। ८-२-४४) इति क्तिनस्तकारस्य नकारः।]]</li> <li id="foot_krm_0917_08"><a href="#ref_krm_0917_08">↑</a> [पृष्ठम्०८०३+ २५]</li></ul></p>

धूञ्|धूनकः-निका|धावकः-विका|दुधूनयिषकः-षिका|धूनयिता-त्री|दुधूनयिषिता-त्री|धूनयन्-न्ती|दुधूनयिषन्-न्ती|धूनयिष्यन्-न्ती-ती|दुधूनयिषिष्यन्-न्ती-ती|धूनयमानः|दुधूनयिषयमाणः|धूनयिष्यमाणः|दुधूनयि-|षिष्यमाणः|धूनितम्-धावितम्-तः-तवान्|दुधूनयिषितः-तवान्|धूनः|दुधूनयिषुः|धूनयितव्यम्|दुधूनयिषितव्यम्|धूननीयम्|दुधूनयिषणीयम्|धून्यम्|दुधूनयिष्यम्|ईषद्धूनः-दुर्धूनः-सुधूनः|धून्यमानः|दुधूनयिष्यमाणः|दुधूनयिषः|धूनयितुम्|दुधूनयिषितुम्|धूनना|दुधूनयिषा|धूननम्|दुधूनयिषणम्|धूनयित्वा|दुधूनयिषित्वा|प्रधून्य|प्रदुधूनयिष्य|धूनम्-धूनयित्वा|दुधूनयिषम्
<ul><li><sup id="ref_krm_0918_01"><a href="#foot_krm_0918_01">1</a></sup> {@“धूञ् कम्पने”@} <sup id="ref_krm_0918_02"><a href="#foot_krm_0918_02">2</a></sup> आधृषीयः। </li> <li>‘धूनयति धवति धवते, धुनोति धुनुते, धुनाति च धुनीते। </li> <li>धूनोति धूनुते स्युः पदानि कम्पे, विधूनने धुवति।।’ <sup id="ref_krm_0918_03"><a href="#foot_krm_0918_03">3</a></sup> इति देवः। </li> <li>धूनकः-निका, <sup id="ref_krm_0918_04"><a href="#foot_krm_0918_04">4</a></sup> धावकः-विका, दुधूनयिषकः-षिका;</li> <li>  धूनयिता-त्री, दुधूनयिषिता-त्री, धूनयन्-न्ती, दुधूनयिषन्-न्ती;</li> <li>  धूनयिष्यन्-न्ती-ती, दुधूनयिषिष्यन्-न्ती-ती;</li> <li>  धूनयमानः, दुधूनयिषयमाणः, धूनयिष्यमाणः, दुधूनयि- षिष्यमाणः, धूनितम्-धावितम् <sup id="ref_krm_0918_05"><a href="#foot_krm_0918_05">5</a></sup> -तः-तवान्, दुधूनयिषितः-तवान्;</li> <li>  धूनः, दुधूनयिषुः;</li> <li>  धूनयितव्यम्, दुधूनयिषितव्यम्;</li> <li>  धूननीयम्, दुधूनयिषणीयम्, धून्यम्, दुधूनयिष्यम्;</li> <li>  ईषद्धूनः-दुर्धूनः-सुधूनः;</li> <li>  धून्यमानः, दुधूनयिष्यमाणः;</li> <li>  धूनः, दुधूनयिषः;</li> <li>  धूनयितुम्, दुधूनयिषितुम्;</li> <li>  धूनना, दुधूनयिषा;</li> <li>  धूननम्, दुधूनयिषणम्, धूनयित्वा, दुधूनयिषित्वा, प्रधून्य, प्रदुधूनयिष्य, धूनम् २ -धूनयित्वा २, दुधूनयिषम् २;</li> <li>  दुधूनयिषित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0918_01"><a href="#ref_krm_0918_01">↑</a> (९०८)</li> <li id="foot_krm_0918_02"><a href="#ref_krm_0918_02">↑</a> (१०-चुरादिः-१८३६। अक। सेट्। उभ।)</li> <li id="foot_krm_0918_03"><a href="#ref_krm_0918_03">↑</a> (श्लो। २६)</li> <li id="foot_krm_0918_04"><a href="#ref_krm_0918_04">↑</a> [[१। ‘धूञ्प्रीञोर्नुग् वक्तव्यः’ (वा। ७-३-३७) इत्यत्र प्रीञा साहचर्यात् क्र्यादेरेव ग्रहणमिति पक्षे, ‘हेतुमण्ण्यन्तादेव नुगागमः, न तु स्वार्थण्यन्तात्’ इति पर्यव- सानात्, अस्य धातोः स्वार्थण्यन्तत्वात् नुगभावे रूपमेवम्। एवमेव तृजादिष्वपि। अत्र पक्षे धावयिता-त्री, इत्यादीनि रूपाणि ज्ञेयानि।]]</li> <li id="foot_krm_0918_05"><a href="#ref_krm_0918_05">↑</a> [[आ। ‘कूटाद्येषु हतेषु धावितमतिष्वन्येषु धावत्सु च स्वैरं तत्र जनान् प्रयन् विगलितश्रन्थान् कचान् ग्रन्थयन्।।’ धा। का। ३। ५१।]]</li></ul></p>

