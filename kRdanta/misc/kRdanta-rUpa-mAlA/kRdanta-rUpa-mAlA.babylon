<ul><li><sup id="ref_krm_0535_01"><a href="#foot_krm_0535_01">1</a></sup> {@“चित्र चित्रीकरणे”@} <sup id="ref_krm_0535_02"><a href="#foot_krm_0535_02">2</a></sup> चित्रीकरणम् = आलेख्यकरणम्। </li> <li>कदाचित् दर्शने। </li> <li>‘चित्र’ इत्यय मद्भुतदर्शने णिचं लभते--इति सिद्धान्तकौमुदी। </li> <li>चित्रकः-त्रिका, चिचित्रयिषकः-षिका;</li> <li>  चित्रयिता-त्री, चिचित्रयिषिता-त्री;</li> <li>  <sup id="ref_krm_0535_03"><a href="#foot_krm_0535_03">3</a></sup> <sup id="ref_krm_0535_04"><a href="#foot_krm_0535_04">4</a></sup> चित्रयन्-न्ती, चिचित्रयिषन्-न्ती;</li> <li>  चित्रयिष्यन्-न्ती-ती, चिचित्रयिषिष्यन्-न्ती-ती;</li> <li>  चित्रयमाणः, चिचित्रयिषमाणः;</li> <li>  चित्रयिष्यमाणः, चिचित्रयिषिष्यमाणः;</li> <li>  <sup id="ref_krm_0535_05"><a href="#foot_krm_0535_05">5</a></sup> चित्-चित्रौ-चित्रः;</li> <li>  -- चित्रितम्-तः, चिचित्रयिषितः-तवान्, चित्रः, चिचित्रयिषुः;</li> <li>  चित्रयितव्यम्, चिचित्रयिषितव्यम्;</li> <li>  चित्रणीयम्, चिचित्रयिषणीयम्;</li> <li>  चित्र्यम्, चिचित्रयिष्यम्;</li> <li>  ईषच्चित्रः-दुश्चित्रः-सुचिम्रः;</li> <li>  -- चित्र्यमाणः, चिचित्रयिष्यमाणः;</li> <li>  चित्रः, चिचित्रयिषः;</li> <li>  चित्रयितुम्, चिचित्रयिषितुम्;</li> <li>  चित्रणा, चिचित्रयिषा;</li> <li>  चित्रणम्, चिचित्रयिषणम्;</li> <li>  चित्रयित्वा, चिचित्रयिषित्वा;</li> <li>  चित्रम् २, चित्रयित्वा २, चिचित्रयिषम् २, चिचित्रयिषित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0535_01"><a href="#ref_krm_0535_01">↑</a> (५२५)</li> <li id="foot_krm_0535_02"><a href="#ref_krm_0535_02">↑</a> (१०-चुरादिः-१९१७। सक। सेट्। उभ। अदन्तः।)</li> <li id="foot_krm_0535_03"><a href="#ref_krm_0535_03">↑</a> [पृष्ठम्०५११+ २३]</li> <li id="foot_krm_0535_04"><a href="#ref_krm_0535_04">↑</a> [[आ। ‘लोके बष्कयतीह चित्रितमहामञ्चे स्वयं चित्रयन् दोष्णा खड्गमुदंस्य तस्य वटयन् हस्तादगृह्णादमुम्।’ धा। का। ३। ६१।]]</li> <li id="foot_krm_0535_05"><a href="#ref_krm_0535_05">↑</a> [[१। रेफस्य ‘संयोगान्तस्य--’ (८-२-२३) इति लोपः।]]</li></ul></p>

चिरि|चिरायकः-यिका|चिचिरयिषकः-षिका|चिरयिता-त्री|चिराययिता-त्री|चिचिरयिषिता-त्री|चिर्णिवन्-ती|चिराययन्-न्ती|चिचिरयिषन्-न्ती|चिरयिष्यन्-न्ती-ती|चिराययिषिष्यन्-न्ती-ती|चिचिरयिषिष्यन्-न्ती-ती|-|चिराययमाणः|चिराययिषिष्यमाणः|-चिरित्-चिरितौ-चिरितः|-चिरीतम्-तः|चिरायितम्-तः|चिचिरयिषितः-तवान्|चिरयः|चिरायः|चिचिरयिषुः|चिरयितव्यम्|चिराययितव्यम्|चिचिरयिषितव्यम्|चिरयणीयम्|चिरायणीयम्|चिचिरयिषणीयम्|चिरेयम्|चिराय्यम्|चिचिरयिष्यम्|ईषच्चिरयः-दुश्चिरयः-सुचिरयः|-चिरीयमाणः|चिराय्यमाणः|चिचिरयिष्यमाणः|चिचिरयिषः|चिरयितुम्|चिराययितुम्|चिचिरयिषितुम्|चिरितिः|चिरायणा|चिचिरयिषा|चिरयणम्|चिरायणम्|चिचिरयिषणम्|चिरयित्वा|चिराययित्वा|चिचिरयिषित्वा|विचिरित्य|विचिराय्य|विचिचिरयिष्य|चिरायम्|चिचिरयिषम्
<ul><li><sup id="ref_krm_0536_01"><a href="#foot_krm_0536_01">1</a></sup> {@“चिरि हिंसायाम्”@} <sup id="ref_krm_0536_02"><a href="#foot_krm_0536_02">2</a></sup> अयं धातुश्छान्दसः। </li> <li>भाषायामपीत्येके। </li> <li>द्व्यच्कोऽयं धातुः। </li> <li>इकारः न इत्संज्ञकः। </li> <li>अत एव, ‘दरिद्राजागृदीधीङामनेकाच्त्वं चिरेर्जिरेः। </li> <li>अदन्तोर्णोतिवेवीङां स्मर्यते णेस्तथोलडेः।।’ इत्यभियुक्तोक्तिः सङ्गच्छते। </li> <li>अनेकाच्त्वाद् यङ् न। </li> <li><sup id="ref_krm_0536_03"><a href="#foot_krm_0536_03">3</a></sup> चिरायकः-यिका, चिरायकः-यिका, <sup id="ref_krm_0536_04"><a href="#foot_krm_0536_04">4</a></sup> चिचिरयिषकः-षिका;</li> <li>  <sup id="ref_krm_0536_05"><a href="#foot_krm_0536_05">5</a></sup> <sup id="ref_krm_0536_06"><a href="#foot_krm_0536_06">6</a></sup> चिरयिता-त्री, चिराययिता-त्री, चिचिरयिषिता-त्री;</li> <li>  <sup id="ref_krm_0536_07"><a href="#foot_krm_0536_07">7</a></sup> चिर्णिवन्-ती, चिराययन्-न्ती, चिचिरयिषन्-न्ती;</li> <li>  चिरयिष्यन्-न्ती-ती, चिराययिषिष्यन्-न्ती-ती, चिचिरयिषिष्यन्-न्ती-ती;</li> <li>  -- चिराययमाणः, चिराययिषिष्यमाणः;</li> <li>  -- <sup id="ref_krm_0536_08"><a href="#foot_krm_0536_08">8</a></sup> चिरित्-चिरितौ-चिरितः;</li> <li>  -- -- <sup id="ref_krm_0536_09"><a href="#foot_krm_0536_09">9</a></sup> चिरीतम्-तः, <sup id="ref_krm_0536_10"><a href="#foot_krm_0536_10">10</a></sup> चिरायितम्-तः, चिचिरयिषितः-तवान्;</li> <li>  चिरयः, चिरायः, चिचिरयिषुः;</li> <li>  चिरयितव्यम्, चिराययितव्यम्, चिचिरयिषितव्यम्;</li> <li>  चिरयणीयम्, चिरायणीयम्, चिचिरयिषणीयम्;</li> <li>  <sup id="ref_krm_0536_11"><a href="#foot_krm_0536_11">11</a></sup> चिरेयम्, चिराय्यम्, चिचिरयिष्यम्;</li> <li>  ईषच्चिरयः-दुश्चिरयः-सुचिरयः;</li> <li>  -- -- <sup id="ref_krm_0536_12"><a href="#foot_krm_0536_12">12</a></sup> चिरीयमाणः, चिराय्यमाणः;</li> <li>  चिचिरयिष्यमाणः;</li> <li>  <sup id="ref_krm_0536_13"><a href="#foot_krm_0536_13">13</a></sup> चिरयः, चिरायः, चिचिरयिषः;</li> <li>  चिरयितुम्, चिराययितुम्, चिचिरयिषितुम्;</li> <li>  <sup id="ref_krm_0536_14"><a href="#foot_krm_0536_14">14</a></sup> चिरितिः, चिरायणा, चिचिरयिषा;</li> <li>  <sup id="ref_krm_0536_15"><a href="#foot_krm_0536_15">15</a></sup> चिरयणम्, चिरायणम्, चिचिरयिषणम्;</li> <li>  <sup id="ref_krm_0536_16"><a href="#foot_krm_0536_16">16</a></sup> चिरयित्वा, चिराययित्वा, चिचिरयिषित्वा;</li> <li>  <sup id="ref_krm_0536_17"><a href="#foot_krm_0536_17">17</a></sup> विचिरित्य, विचिराय्य, विचिचिरयिष्य;</li> <li>  चिरायम् २, चिरयित्वा २, चिरायम् २, चिराययित्वा २, चिचिरयिषम् २;</li> <li>  चिचिरयिषित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0536_01"><a href="#ref_krm_0536_01">↑</a> (५२६)</li> <li id="foot_krm_0536_02"><a href="#ref_krm_0536_02">↑</a> (५-स्वादिः-१२७७। सक। सेट्। पर।)</li> <li id="foot_krm_0536_03"><a href="#ref_krm_0536_03">↑</a> [[२। ण्वुलि परतः, ‘अचो ञ्णिति’ (७-२-११५) इति वृद्धौ, आयादेशः। एवं णमुल्यपि ज्ञेयम्।]]</li> <li id="foot_krm_0536_04"><a href="#ref_krm_0536_04">↑</a> [[३। धातोरुदात्तत्वेन सन इडागमे, द्वित्वे, अङ्गस्य गुणायादेशयोः सतोः ‘चिचिर- यिषकः’ इति रूपम्। एवं सन्नन्ते सर्वत्र बोद्ध्यम्।]]</li> <li id="foot_krm_0536_05"><a href="#ref_krm_0536_05">↑</a> [पृष्ठम्०५१२+ २१]</li> <li id="foot_krm_0536_06"><a href="#ref_krm_0536_06">↑</a> [[१। ‘सार्वधातुकार्धधातुकयोः’ (७-३-८४) इति गुणे, अयादेशे च रूपम्। एवं तव्यानीयरादिषु च बोध्यम्।]]</li> <li id="foot_krm_0536_07"><a href="#ref_krm_0536_07">↑</a> [[२। ‘स्वादिभ्यः--’ (३-१-६३) इति श्नुः विकरणप्रत्ययः, ‘हुश्नुवोः सार्वधातुके’ (६-४-८७) इति यणादेशे, ‘अट्कुप्वाङ्नुम्--’ (८-४-२) इति णत्वे च रूपम्।]]</li> <li id="foot_krm_0536_08"><a href="#ref_krm_0536_08">↑</a> [[३। क्विपि, ‘ह्रस्वस्य पिति कृति--’ (६-१-७१) इति तुक्।]]</li> <li id="foot_krm_0536_09"><a href="#ref_krm_0536_09">↑</a> [[४। निष्ठायामिडागमे, अङ्गस्य-इटश्च, ‘अकः सवर्णे-’ (६-१-१०१) इति दीर्घः।]]</li> <li id="foot_krm_0536_10"><a href="#ref_krm_0536_10">↑</a> [[५। ‘निष्ठायां सेटि’ (६-४-५२) इति णेर्लोपः।]]</li> <li id="foot_krm_0536_11"><a href="#ref_krm_0536_11">↑</a> [[६। ‘अचो यत्’ (३-१-९७) इति यति गुणः।]]</li> <li id="foot_krm_0536_12"><a href="#ref_krm_0536_12">↑</a> [[७। यकि, ‘अकृत्सार्वधातुकयोः--’ (७-४-२५) इति दीर्घः।]]</li> <li id="foot_krm_0536_13"><a href="#ref_krm_0536_13">↑</a> [[८। भावे ‘एरच्’ (३-३-५६) इति अच्। घञपवादः।]]</li> <li id="foot_krm_0536_14"><a href="#ref_krm_0536_14">↑</a> [[९। क्तिनि, ‘तितुत्र--’ (७-२-९) इतीण्णिषेधः।]]</li> <li id="foot_krm_0536_15"><a href="#ref_krm_0536_15">↑</a> [[आ। ‘क्ष्मां दघ्नुवन् मखचमिव्यसनानि रिण्वन् ऋक्षिण्वतां चिरयणैरपथं जिरिण्वन्।’ धा। का। २ ७१।]]</li> <li id="foot_krm_0536_16"><a href="#ref_krm_0536_16">↑</a> [[१०। ‘न क्त्वा सेट्’ (१-२-१८) इति क्त्वायाः कित्त्वनिषेधाद् गुणायादेशयो रूपम्।]]</li> <li id="foot_krm_0536_17"><a href="#ref_krm_0536_17">↑</a> [पृष्ठम्०५१३+ २४]</li></ul></p>

चिल|चेलकः-लिका|चिचेलिषकः-चिचिलिषकः-षिका|चेचिलकः-लिका
<ul><li><sup id="ref_krm_0537_01"><a href="#foot_krm_0537_01">1</a></sup> {@“चिल वसने”@} <sup id="ref_krm_0537_02"><a href="#foot_krm_0537_02">2</a></sup> चेलकः-लिका, चेलकः-लिका, चिचेलिषकः-चिचिलिषकः-षिका;</li> <li>  चेचिलकः-लिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि तौदादिककिलतिवत् <sup id="ref_krm_0537_03"><a href="#foot_krm_0537_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0537_04"><a href="#foot_krm_0537_04">4</a></sup> चेलः--वस्त्रम्। </li> <li>गर्हिता ब्राह्मणी = <sup id="ref_krm_0537_05"><a href="#foot_krm_0537_05">5</a></sup> ब्राह्मणिचेली। </li> <li><sup id="ref_krm_0537_06"><a href="#foot_krm_0537_06">6</a></sup> चिलितः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0537_01"><a href="#ref_krm_0537_01">↑</a> (५२७)</li> <li id="foot_krm_0537_02"><a href="#ref_krm_0537_02">↑</a> (६-तुदादिः-१३५५। सक। सेट् पर।)</li> <li id="foot_krm_0537_03"><a href="#ref_krm_0537_03">↑</a> (१९३)</li> <li id="foot_krm_0537_04"><a href="#ref_krm_0537_04">↑</a> [[१। पचादिषु (३-१-१३४) ‘चेलट्’ इति पाठेन, इगुपधलक्षणं कं बाधित्वा, अच्। टित्त्वात् स्त्रियां ङीप्।]]</li> <li id="foot_krm_0537_05"><a href="#ref_krm_0537_05">↑</a> [[२। ‘घरूपकल्पप्चेलड्ब्रुव--’ (६-३-४३) इति पूर्वपदस्य ह्रस्वः। चेलडादयः वृत्तिविषये निन्दाद्योतकाः।]]</li> <li id="foot_krm_0537_06"><a href="#ref_krm_0537_06">↑</a> [[आ। ‘चिलितपीतपटेन चलन् इलन् अविलितोरुकृपां परितो दृशम्।।’ धा। का। २। ७८।]]</li></ul></p>

