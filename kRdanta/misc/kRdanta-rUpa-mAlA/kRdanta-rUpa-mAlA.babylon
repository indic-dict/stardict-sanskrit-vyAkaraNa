<ul><li><sup id="ref_krm_0862_01"><a href="#foot_krm_0862_01">1</a></sup> {@“दुष वैकृत्ये”@} <sup id="ref_krm_0862_02"><a href="#foot_krm_0862_02">2</a></sup> ‘वैकृत्यम् = रूपभङ्कः।’ इति क्षीरस्वामी। </li> <li>दोषकः-षिका, <sup id="ref_krm_0862_03"><a href="#foot_krm_0862_03">3</a></sup> दूषकः, <sup id="ref_krm_0862_04"><a href="#foot_krm_0862_04">4</a></sup> दोषकः-दूषकः-षिका, <sup id="ref_krm_0862_05"><a href="#foot_krm_0862_05">5</a></sup> दुदुक्षकः-क्षिका, दोदुषकः-षिका;</li> <li>  <sup id="ref_krm_0862_06"><a href="#foot_krm_0862_06">6</a></sup> दोष्टा-दोष्ट्री, दूषयिता-दोषयिता-त्री, दुदुक्षिता-त्री, दोदुषिता-त्री;</li> <li>  <sup id="ref_krm_0862_07"><a href="#foot_krm_0862_07">7</a></sup> दुष्यन्-न्ती, दूषयन्-दोषयन्-न्ती, दुदुक्षन्-न्ती;</li> <li>  -- दोक्ष्यन्-न्ती, दूषयिष्यन्-दोषयिष्यन्-न्ती-ती, दुदुक्षिष्यन्-न्ती-ती;</li> <li>  -- <sup id="ref_krm_0862_08"><a href="#foot_krm_0862_08">8</a></sup> व्यतिदुष्यमाण;</li> <li>  दूषयमाणः-दोषयमाणः, <sup id="ref_krm_0862_09"><a href="#foot_krm_0862_09">9</a></sup> व्यतिदुदुक्षमाणः, दोदुष्यमाणः;</li> <li>  व्यतिदोक्ष्यमाणः, दूषयिष्यमाणः-दोषयिष्यमाणः;</li> <li>  व्यतिदुदुक्षिष्यमाणः, दोदुषिष्यमाणः;</li> <li>  <sup id="ref_krm_0862_10"><a href="#foot_krm_0862_10">10</a></sup> <sup id="ref_krm_0862_11"><a href="#foot_krm_0862_11">11</a></sup> प्रदुट्-प्रदुड्-प्रदुषौ-प्रदुषः;</li> <li>  -- -- दुष्टम्-दुष्टः-दुष्टवान्, दूषितम्-तः, दोषितः, दुदुक्षितः, दोदुषितः-तवान्;</li> <li>  दोषः, दुषः, <sup id="ref_krm_0862_12"><a href="#foot_krm_0862_12">12</a></sup> दोषी, <sup id="ref_krm_0862_13"><a href="#foot_krm_0862_13">13</a></sup> दूषणः, दुदुक्षुः, दोदोषः;</li> <li>  दोष्टव्यम्, दूषयितव्यम्-दोषयितव्यम्, दुदुक्षितव्यम्, दोदुषितव्यम्;</li> <li>  दोषणीयम्, दूषणीयम्-दोषणीयम्, दुदुक्षणीयम्, दोदुषणीयम्;</li> <li>  दोष्यम्, दूष्यम्-दोष्यम्, दुदुक्ष्यम्, दोदुष्यम्;</li> <li>  ईषद्दोषः-दुर्दोषः-सुदोषः;</li> <li>  -- -- दुष्यमाणः, दूष्यमाणः-दोष्यमाणः, दुदुक्ष्यमाणः, दोदुष्यमाणः;</li> <li>  दोषः, <sup id="ref_krm_0862_14"><a href="#foot_krm_0862_14">14</a></sup> प्रदोषः, दूषः-दोषः, दुदुक्षः, दोदुषः;</li> <li>  दोष्टुम्, दूषयितुम्-दोषयितुम्, दुदुक्षितुम्, दोदुषितुम्;</li> <li>  दुष्टिः, दूषणा-दोषणा, दुदुक्षा, दोदुषा;</li> <li>  दोषणम्, दूषणम्-दोषणम्, दुदुक्षणम्, दोदुषणम्;</li> <li>  दुष्ट्वा, दूषयित्वा-दोषयित्वा, दुदुक्षित्वा, दोदुषित्वा;</li> <li>  प्रदुष्य, प्रदूष्य-प्रदोष्य, प्रदुदुक्ष्य, प्रदोदुष्य;</li> <li>  दोषम् २, दुष्ट्वा २, दूषम् २-दोषम् २, दूषयित्वा २-दोषयित्वा २, दुदुक्षम् २, दुदुक्षित्वा २, दोदुषम् २;</li> <li>  दोदुषित्वा २;</li> <li>  <sup id="ref_krm_0862_15"><a href="#foot_krm_0862_15">15</a></sup> इति ण्यन्तादस्मादीकन्प्रत्यये रूपम्। </li> <li>दूषयति नेत्रमिति दूषीका = नेत्रमलसंघातः।]] दूषीका।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0862_01"><a href="#ref_krm_0862_01">↑</a> (८५२)</li> <li id="foot_krm_0862_02"><a href="#ref_krm_0862_02">↑</a> (४-दिवादिः-११८५। अक। अनि। पर।)</li> <li id="foot_krm_0862_03"><a href="#ref_krm_0862_03">↑</a> [[३। ‘दोषो णौ’ (६-४-९०) इति ण्यन्ते सर्वत्र उपधाया ऊदादेशः।]]</li> <li id="foot_krm_0862_04"><a href="#ref_krm_0862_04">↑</a> [[४। ‘वा चित्तविरागे’ (६-४-९१) इति चित्तस्याप्रीततायां गम्यमानायां तु ऊदादेश- विकल्पनात्, ऊदादेशाभावे, लघूषधगुणे दोषकः-षिका इत्यादीनि रूपाणि ण्यन्त एव सर्वत्र भवन्ति।]]</li> <li id="foot_krm_0862_05"><a href="#ref_krm_0862_05">↑</a> [[५। सन्नन्तान्ण्वुलि, धातोरनिट्त्वात् ‘इको झल्’ (१-२-९) इति सनः कित्त्वाद् गुण- निषेधे, ‘षढोः कः सि’ (८-२-४१) इति धातुषकारस्य ककारे, षत्वे च रूपमेवम्। एवं सन्नन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0862_06"><a href="#ref_krm_0862_06">↑</a> [[६। तृचि, ‘ष्टुना ष्टुः’ (८-४-४१) इति तकारस्य ष्टुत्वेन टकारे रूपमेवम्। तव्यदा- दिष्वप्येवमेव प्रक्रिया ज्ञेया।]]</li> <li id="foot_krm_0862_07"><a href="#ref_krm_0862_07">↑</a> [[७। शतरि ‘दिवादिभ्यः--’ (३-१-६९) इति श्यन् विकरणप्रत्ययः। तस्य ङिद्वद्भावे- नाङ्गस्य गुणो न भवति।]]</li> <li id="foot_krm_0862_08"><a href="#ref_krm_0862_08">↑</a> [[८। ‘कर्तरि कर्मव्यतीहारे (१-३-१४) इति शानचि रूपमेवम्।]]</li> <li id="foot_krm_0862_09"><a href="#ref_krm_0862_09">↑</a> [[७। शतरि ‘दिवादिभ्यः--’ (३-१-६९) इति श्यन् विकरणप्रत्ययः। तस्य ङिद्वद्भावे- नाङ्गस्य गुणो न भवति।]]</li> <li id="foot_krm_0862_10"><a href="#ref_krm_0862_10">↑</a> [पृष्ठम्०७५८+ २६]</li> <li id="foot_krm_0862_11"><a href="#ref_krm_0862_11">↑</a> [[१। क्विपि, पदान्तनिमित्तके जश्त्वे, चर्त्वे च रूपम्।]]</li> <li id="foot_krm_0862_12"><a href="#ref_krm_0862_12">↑</a> [[२। ‘सम्पृचानुरुधाङ्यमाङ्यसपरिसृसंसृजपरिदेविसंज्वरपरिक्षिपपरिरटपरिवदपरिदह- परिमुहदुष--’ (३-२-१४२) इत्यादिना तच्छीलादिषु कर्तृषु घिनुण्प्रत्यये रूपम्।]]</li> <li id="foot_krm_0862_13"><a href="#ref_krm_0862_13">↑</a> [[३। नन्द्यादित्वात् (३-१-१३४) ण्यन्तादस्मात् कर्तरि ल्युप्रत्ययेऽनादेशे च दूषणः इति रूपम्।]]</li> <li id="foot_krm_0862_14"><a href="#ref_krm_0862_14">↑</a> [[४। ‘हलश्च’ (३-३-१२१) इति संज्ञायां घञ्। नात्रावयवार्थादरः। प्रदोषः = रजनीमुखम्।]]</li> <li id="foot_krm_0862_15"><a href="#ref_krm_0862_15">↑</a> [[५। ‘कषिदूषिभ्यामीकन्’ [द। उ। ३-३५]</li></ul></p>

दुह|दोहकः-हिका|दुधुक्षकः-क्षिका|दोदुहकः-हिका|दुह्यम्-दोह्यम्|गोधुक्-प्रधुक्-प्रदुहौ-प्रदुहः|कामदुधा|दोही|दुहानः|गोदोहनी|ईषद्दोहनः-दुर्दोहनः-सुदोहनः
<ul><li><sup id="ref_krm_0863_01"><a href="#foot_krm_0863_01">1</a></sup> {@“दुह प्रपूरणे”@} <sup id="ref_krm_0863_02"><a href="#foot_krm_0863_02">2</a></sup> “प्रपूरणम् = पूरणाभावः, उपसर्गोऽत्र धात्वर्थं बाधते प्रस्थानवत्।” इति क्षीरस्वामी। </li> <li><sup id="ref_krm_0863_03"><a href="#foot_krm_0863_03">3</a></sup> ‘प्रपूरणे दोग्धि दुग्धे, दोहतीत्यर्दने दुहेः।।’ <sup id="ref_krm_0863_04"><a href="#foot_krm_0863_04">4</a></sup> इति देवः। </li> <li>दोहकः-हिका, दोहकः-हिका, दुधुक्षकः-क्षिका, दोदुहकः-हिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि आदादिकदेग्धिवत् <sup id="ref_krm_0863_05"><a href="#foot_krm_0863_05">5</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0863_06"><a href="#foot_krm_0863_06">6</a></sup> दुह्यम्-दोह्यम्, <sup id="ref_krm_0863_07"><a href="#foot_krm_0863_07">7</a></sup> गोधुक्-प्रधुक्-प्रदुहौ-प्रदुहः, <sup id="ref_krm_0863_08"><a href="#foot_krm_0863_08">8</a></sup> कामदुधा <sup id="ref_krm_0863_09"><a href="#foot_krm_0863_09">9</a></sup> <sup id="ref_krm_0863_10"><a href="#foot_krm_0863_10">10</a></sup>, <sup id="ref_krm_0863_11"><a href="#foot_krm_0863_11">11</a></sup> दोही, <sup id="ref_krm_0863_12"><a href="#foot_krm_0863_12">12</a></sup> <sup id="ref_krm_0863_13"><a href="#foot_krm_0863_13">13</a></sup> दुहानः, <sup id="ref_krm_0863_14"><a href="#foot_krm_0863_14">14</a></sup> <sup id="ref_krm_0863_15"><a href="#foot_krm_0863_15">15</a></sup> गोदोहनी, <sup id="ref_krm_0863_16"><a href="#foot_krm_0863_16">16</a></sup> ईषद्दोहनः-दुर्दोहनः-सुदोहनः;</li> <li>  <sup id="ref_krm_0863_17"><a href="#foot_krm_0863_17">17</a></sup> इत्यादिना तृन्प्रत्यये इडागमे, गुणनिषेधे च निपातितः। </li> <li>दुहिता = स्त्र्यपत्यम्।]] दुहिता, इत्यस्माद्धातोस्तत्तत्प्रत्ययेषु यथासम्भवं रूपाणि भवन्तीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0863_01"><a href="#ref_krm_0863_01">↑</a> (८५३)</li> <li id="foot_krm_0863_02"><a href="#ref_krm_0863_02">↑</a> (२-अदादिः-१०१४। सक। अनि। उभ।)</li> <li id="foot_krm_0863_03"><a href="#ref_krm_0863_03">↑</a> [पृष्ठम्०७५९+ ३१]</li> <li id="foot_krm_0863_04"><a href="#ref_krm_0863_04">↑</a> (श्लो। १९३)</li> <li id="foot_krm_0863_05"><a href="#ref_krm_0863_05">↑</a> (८४२)</li> <li id="foot_krm_0863_06"><a href="#ref_krm_0863_06">↑</a> [[१। ‘शंसिदुहिगुहिभ्यो वा’ (काशिका वा। ३-१-१०९) इति क्यप् वा भवति। क्यपि गुणनिषेधे दुह्यम् इति, औत्सर्गिके ण्यति दोह्यम् इति च रूपे भवतः।]]</li> <li id="foot_krm_0863_07"><a href="#ref_krm_0863_07">↑</a> [[२। ‘सत्सूद्विषद्रुहदुहयुजविदभिदच्छिदजिनीराजामुपसर्गेऽपि क्विप्’ (३-२-६१) इत्यनेन क्विपि, ‘दादेर्धातोर्घः’ (८-२-३२) इति घत्वे पदान्तनिमित्तकेषु चर्त्वभष्भाव- जश्त्वादिकेषु रूपम्। ‘उपसर्गेऽपि’ इत्युक्तत्वात् उपसर्गभिन्नेषु सुबन्तेषु उप- पदेष्वपि कर्मभूतेषु क्विप् भवति, तेन गोधुक् इति सिद्धम्।]]</li> <li id="foot_krm_0863_08"><a href="#ref_krm_0863_08">↑</a> [[३। ‘दुहः कब् घश्च’ (३-२-७०) इत्यनेन सुप्युपपदे कप्प्रत्ययः, धात्वन्त्यवर्णस्य घकारादेशश्च विहितः।]]</li> <li id="foot_krm_0863_09"><a href="#ref_krm_0863_09">↑</a> [[आ। ‘आराधय सपत्नीकः प्रीता कामदुघा हि सा।’ रघुवंशे १। ८१।]]</li> <li id="foot_krm_0863_10"><a href="#ref_krm_0863_10">↑</a> [गौः]</li> <li id="foot_krm_0863_11"><a href="#ref_krm_0863_11">↑</a> [[४। ‘सम्पृचानुरुधाङ्यमाङ्यसपरिसृसंसृजपरिदेविसंज्वरपरिक्षिपपरिरटपरिवदपरिदहपरि- मुहदुषद्विषद्रुहदुह--’ (३-२-१४२) इत्यादिना तच्छीलादिषु कर्तृषु घिनुण्प्रत्यये रूपम्।]]</li> <li id="foot_krm_0863_12"><a href="#ref_krm_0863_12">↑</a> [गां पयो]</li> <li id="foot_krm_0863_13"><a href="#ref_krm_0863_13">↑</a> [[५। शानचि, शपोलुकि, रूपमेवम्। ‘दुहियाचि--’ (भाष्यम् १-४-५१) इत्यादिना द्विकर्मकत्वम्।]]</li> <li id="foot_krm_0863_14"><a href="#ref_krm_0863_14">↑</a> [[B। ‘अदन् मधुघ्नो द्विषते विसृज्य श्ववल्कजं विश्वमुदं दुहानः।’ धा। का। २। ४४।]]</li> <li id="foot_krm_0863_15"><a href="#ref_krm_0863_15">↑</a> [[६। गावः दुह्यन्तेऽत्रेति अधिकरणे ‘करणाधिकरणयोश्च’ (३-३-११७) इति ल्युट्। गोदोहनी = स्थलविशेषो गोष्ठादिः।]]</li> <li id="foot_krm_0863_16"><a href="#ref_krm_0863_16">↑</a> [[७। ‘अन्येभ्योऽपि दृश्यते’ (३-३-१३०) इति ईषदाद्युपपदेषु खलपवादो युच्प्रत्ययः। क्षीरस्वामिमतेनेदमुक्तम्। अन्ये तु बाहुलकादाहुः।]]</li> <li id="foot_krm_0863_17"><a href="#ref_krm_0863_17">↑</a> [[८। ‘नप्तृनेष्ट्ट--’ [द। उ। २-३]</li></ul></p>

दुहिर्|दोहकः-हिका|दुदोहिषकः-दुदुहिषकः-षिका|दोदुहकः-हिका
<ul><li><sup id="ref_krm_0864_01"><a href="#foot_krm_0864_01">1</a></sup> {@“दुहिर् अर्दने”@} <sup id="ref_krm_0864_02"><a href="#foot_krm_0864_02">2</a></sup> ‘प्रपूरणे दोग्धि दुग्धे, दोहतीत्यर्दने दुहेः।।’ <sup id="ref_krm_0864_03"><a href="#foot_krm_0864_03">3</a></sup> इति देवः। </li> <li>दोहकः-हिका, दोहकः-हिका, <sup id="ref_krm_0864_04"><a href="#foot_krm_0864_04">4</a></sup> दुदोहिषकः-दुदुहिषकः-षिका, दोदुहकः- <sup id="ref_krm_0864_05"><a href="#foot_krm_0864_05">5</a></sup> हिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकतोहतिवत् <sup id="ref_krm_0864_06"><a href="#foot_krm_0864_06">6</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0864_07"><a href="#foot_krm_0864_07">7</a></sup> जगद्दोही <sup id="ref_krm_0864_08"><a href="#foot_krm_0864_08">8</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0864_01"><a href="#ref_krm_0864_01">↑</a> (८५४)</li> <li id="foot_krm_0864_02"><a href="#ref_krm_0864_02">↑</a> (१-भ्वादिः-७३८। सक। सेट्। पर।)</li> <li id="foot_krm_0864_03"><a href="#ref_krm_0864_03">↑</a> (श्लो। १९३)</li> <li id="foot_krm_0864_04"><a href="#ref_krm_0864_04">↑</a> [[९। ‘दिहिर्दुहिर्मेहतिरोहती--’ (व्याघ्रभूतिकारिका ७-२-१०) इत्यत्र नास्य धातोर्ग्रहणम्;\n\n  अपि तु, आदादिकस्यैवेति, अत्र इड् भवत्येव। सन्नन्ते ण्वुलि, ‘रलोव्युपधात्--’ (१-२-२६) इति कित्त्वविकल्पे, रूपद्वयं बोध्यम्।]]</li> <li id="foot_krm_0864_05"><a href="#ref_krm_0864_05">↑</a> [पृष्ठम्०७६०+ २६]</li> <li id="foot_krm_0864_06"><a href="#ref_krm_0864_06">↑</a> (७६०)</li> <li id="foot_krm_0864_07"><a href="#ref_krm_0864_07">↑</a> [[१। कर्मण्युपपदे, ‘सुप्यजातौ--’ (३-२-७८) इति णिनिः।]]</li> <li id="foot_krm_0864_08"><a href="#ref_krm_0864_08">↑</a> [[आ। ‘गोविन्दस्तुहिनांशुरम्यवदनः कंसं जगद्दोहिनं…।।’ धा। का। १। ९२।]]</li></ul></p>

दूङ्|ण्यन्ते|सन्नन्ते|यङन्ते|च|क्रमेण|दावकः-विका|दुदूषकः-षिका|दोदूयकः-|यिका|यथा-दावकः-विका|दविता-त्री|दूयमानः|दविष्यमाणः|प्रदूः-प्रदुवौ-प्रदुवः|दूनम्-दूनः-दूनवान्|दवः|दवितव्यम्|दवनीयम्|दव्यम्-अवश्यदाव्यम्|ईषद्दवः-दुर्दवः-सुदवः|दवितुम्|दूतिः|दवनम्|दूत्वा|प्रदूय|दावम्-दूत्वा
<ul><li><sup id="ref_krm_0865_01"><a href="#foot_krm_0865_01">1</a></sup> {@“दूङ् परितापे”@} <sup id="ref_krm_0865_02"><a href="#foot_krm_0865_02">2</a></sup> स्वादिः। </li> <li>परितापः = खेदः। </li> <li>‘दुनोति दूयते तापे, दवतीति गतौ पदम्।।’ <sup id="ref_krm_0865_03"><a href="#foot_krm_0865_03">3</a></sup> इति देवः। </li> <li>ण्यन्ते, सन्नन्ते, यङन्ते च क्रमेण, दावकः-विका, दुदूषकः-षिका, दोदूयकः- यिका;</li> <li>  इत्यादीनि रूपाणि तौदादिककूङ्धातुवत् <sup id="ref_krm_0865_04"><a href="#foot_krm_0865_04">4</a></sup> ज्ञेयानि। </li> <li>शुद्धात् तु इमानि रूपाणि भवन्तीति विशेषः। </li> <li>यथा-दावकः-विका, दविता-त्री, दूयमानः, दविष्यमाणः, प्रदूः-प्रदुवौ-प्रदुवः, <sup id="ref_krm_0865_05"><a href="#foot_krm_0865_05">5</a></sup> दूनम् <sup id="ref_krm_0865_06"><a href="#foot_krm_0865_06">6</a></sup> -दूनः-दूनवान्, दवः, दवितव्यम्, दवनीयम्, दव्यम्- <sup id="ref_krm_0865_07"><a href="#foot_krm_0865_07">7</a></sup> अवश्यदाव्यम्, ईषद्दवः-दुर्दवः-सुदवः, दूयमानः, दवः, दवितुम्, दूतिः, दवनम्, दूत्वा, प्रदूय, दावम् २-दूत्वा २;</li> <li> --इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0865_01"><a href="#ref_krm_0865_01">↑</a> (८५५)</li> <li id="foot_krm_0865_02"><a href="#ref_krm_0865_02">↑</a> (४-दिवादिः-११३३। अक। सेट्। आत्म।)</li> <li id="foot_krm_0865_03"><a href="#ref_krm_0865_03">↑</a> (श्लो। २२)</li> <li id="foot_krm_0865_04"><a href="#ref_krm_0865_04">↑</a> (२३८)</li> <li id="foot_krm_0865_05"><a href="#ref_krm_0865_05">↑</a> [[२। धातोरस्य सेट्त्वेऽपि, ‘श्रयुकः क्किति’ (७-२-११) इति क्ङिति प्रत्यये परतः गुणनिषेधः। तेन निष्ठा, क्तिन्, क्त्वा प्रत्ययेषु इण्णिषेधो ज्ञेयः। अत्र, ‘स्वादय ओदितः’ (ग। सू। दिवादौ) इत्यनेन ओदित्त्वस्यातिदेशात्, ‘ओदितश्च’ (८-२-४५) इति निष्ठानत्वम्।]]</li> <li id="foot_krm_0865_06"><a href="#ref_krm_0865_06">↑</a> [[B। ‘किं सूयसे गिरमदून नितान्तदीनामुड्डीनकाकसम भूपतिधीनमेतत्।’ धा। का। २। ५८।]]</li> <li id="foot_krm_0865_07"><a href="#ref_krm_0865_07">↑</a> [[३। ‘ओरावश्यके’ (३-१-१२५) इति ण्यति, गुणावादेशयो रूपमेवम्।]]</li></ul></p>

दृ|दारकः-रिका|दिदीर्षकः-र्षिका|देद्रीयकः-यिका
<ul><li><sup id="ref_krm_0866_01"><a href="#foot_krm_0866_01">1</a></sup> {@“दृ हिंसायाम्”@} <sup id="ref_krm_0866_02"><a href="#foot_krm_0866_02">2</a></sup> दारकः-रिका, दारकः-रिका, दिदीर्षकः-र्षिका, देद्रीयकः-यिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि सौवादिककृणोतिवत् <sup id="ref_krm_0866_03"><a href="#foot_krm_0866_03">3</a></sup> ज्ञेयानि। </li> <li>अस्य धातोः परस्मैपदित्वात् दृण्वन्-ती इति शतैव भवति, न तु शानजपीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0866_01"><a href="#ref_krm_0866_01">↑</a> (८५६)</li> <li id="foot_krm_0866_02"><a href="#ref_krm_0866_02">↑</a> (५-स्वादिः-१२८०। सक। अनि। पर। छान्दसः)</li> <li id="foot_krm_0866_03"><a href="#ref_krm_0866_03">↑</a> (२४५)</li></ul></p>

दृङ्|दारकः-रिका|दारकः-रिकादिदरिषकः-षिका|देद्रीयकः-यिका|आदर्ता-दर्त्री|दारयिता-त्री|दिदरिषिता-त्री|देद्रीयिता-त्री|-|दारयन्-न्ती|दारयिष्यन्-न्ती-ती|-आद्रियमाणः|दारयमाणः|दिदरिषमाणः|देद्रीयमाणः|आदरिष्यमाणः|दारयिष्यमाणः|देद्रीयिष्यमाणः|आदृत्-आदृतौ-आदृतः|आदृतम्-आदृतः-आदृतवात्|दारितः|दिदरिषितः|देद्रीयितः-तवान्|दरः|आदरी|दारः|दिदरिषुः|देद्रियः|आदर्तव्यम्|दारयितव्यम्|दिदरिषितव्यम्|देद्रीयितव्यम्|आदरणीयम्|दारणीयम्|दिदरिषणीयम्|देद्रीयणीयम्|आदृत्यः|दार्यम्|दिदरिष्यम्|देद्रीय्यम्|ईषद्दरः-दुर्दरः-सुदरः|द्रियमाणः|दार्यमाणः|दिदरिष्यमाणः|देद्रीय्यमाणः|आदरः|दिदरिषः|देद्रीयः|आदर्तुम्|दारयितुम्|दिदरिषितुम्|देद्रीयितुम्|आदृतिः|दृतिः|दारणा|दिदरिषा|देद्रीया|दरणम्|दारणम्|दिदरिषणम्|देद्रीयणम्|दृत्वा|दारयित्वा|दिदरिषित्वा|देद्रीयित्वा|आदृत्य|आदार्यं|आदिदरिष्य|आदेद्रीय्य|दारम्|दिदरिषम्|देद्रीयम्
<ul><li><sup id="ref_krm_0867_01"><a href="#foot_krm_0867_01">1</a></sup> {@“दृङ् आदरे”@} <sup id="ref_krm_0867_02"><a href="#foot_krm_0867_02">2</a></sup> प्रायेणायमाङ्पूर्वकः। </li> <li>‘दरेद् दृणाति द्रियते क्रमाद् भीदारणादरे।’ <sup id="ref_krm_0867_03"><a href="#foot_krm_0867_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_0867_04"><a href="#foot_krm_0867_04">4</a></sup> दारकः-रिका, दारकः-रिका <sup id="ref_krm_0867_05"><a href="#foot_krm_0867_05">5</a></sup> दिदरिषकः-षिका, <sup id="ref_krm_0867_06"><a href="#foot_krm_0867_06">6</a></sup> देद्रीयकः-यिका;</li> <li>  आदर्ता-दर्त्री, दारयिता-त्री, दिदरिषिता-त्री, देद्रीयिता-त्री;</li> <li>  -- दारयन्-न्ती, दारयिष्यन्-न्ती-ती;</li> <li>  -- <sup id="ref_krm_0867_07"><a href="#foot_krm_0867_07">7</a></sup> आद्रियमाणः, दारयमाणः, दिदरिषमाणः, देद्रीयमाणः;</li> <li>  <sup id="ref_krm_0867_08"><a href="#foot_krm_0867_08">8</a></sup> आदरिष्यमाणः, दारयिष्यमाणः, दिदरिषमाणः, देद्रीयिष्यमाणः;</li> <li>  <sup id="ref_krm_0867_09"><a href="#foot_krm_0867_09">9</a></sup> आदृत्-आदृतौ-आदृतः;</li> <li>  -- -- -- आदृतम्-आदृतः-आदृतवात्, दारितः, दिदरिषितः, देद्रीयितः-तवान्;</li> <li>  दरः, <sup id="ref_krm_0867_10"><a href="#foot_krm_0867_10">10</a></sup> आदरी, <sup id="ref_krm_0867_11"><a href="#foot_krm_0867_11">11</a></sup> दारः, दिदरिषुः, देद्रियः;</li> <li>  आदर्तव्यम्, दारयितव्यम् दिदरिषितव्यम्, देद्रीयितव्यम्;</li> <li>  आदरणीयम्, दारणीयम्, दिदरिषणीयम्, देद्रीयणीयम्;</li> <li>  <sup id="ref_krm_0867_12"><a href="#foot_krm_0867_12">12</a></sup> आदृत्यः, <sup id="ref_krm_0867_13"><a href="#foot_krm_0867_13">13</a></sup> दार्यम्, दिदरिष्यम्, देद्रीय्यम्;</li> <li>  ईषद्दरः-दुर्दरः-सुदरः;</li> <li>  -- -- द्रियमाणः, दार्यमाणः दिदरिष्यमाणः देद्रीय्यमाणः;</li> <li>  <sup id="ref_krm_0867_14"><a href="#foot_krm_0867_14">14</a></sup> आदरः, <sup id="ref_krm_0867_15"><a href="#foot_krm_0867_15">15</a></sup> दारः, दिदरिषः देद्रीयः;</li> <li>  आदर्तुम्, दारयितुम्, दिदरिषितुम्, देद्रीयितुम्;</li> <li>  आदृतिः, <sup id="ref_krm_0867_16"><a href="#foot_krm_0867_16">16</a></sup> दृतिः, दारणा, दिदरिषा, देद्रीया;</li> <li>  <sup id="ref_krm_0867_17"><a href="#foot_krm_0867_17">17</a></sup> दरणम्, दारणम्, दिदरिषणम्, देद्रीयणम्;</li> <li>  दृत्वा, दारयित्वा, दिदरिषित्वा, देद्रीयित्वा;</li> <li>  आदृत्य, आदार्यं आदिदरिष्य, आदेद्रीय्य;</li> <li>  दारम् २, दृत्वा २, दारम् २, दारयित्वा २, दिदरिषम् २, दिदरिषित्वा २, देद्रीयम् २;</li> <li>  देद्रीयित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0867_01"><a href="#ref_krm_0867_01">↑</a> (८५७)</li> <li id="foot_krm_0867_02"><a href="#ref_krm_0867_02">↑</a> (६-तुदादिः-१४११। सक। अनि। आत्म। किरादिः)</li> <li id="foot_krm_0867_03"><a href="#ref_krm_0867_03">↑</a> (श्लो। ३६)</li> <li id="foot_krm_0867_04"><a href="#ref_krm_0867_04">↑</a> [पृष्ठम्०७६१+ २६]</li> <li id="foot_krm_0867_05"><a href="#ref_krm_0867_05">↑</a> [[१। ‘किरश्च पञ्चभ्यः’ (७-२-७५) इति सनि इडागमः। द्वित्वादिकम्। एवं सन्नन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0867_06"><a href="#ref_krm_0867_06">↑</a> [[२। ‘रीङ् ऋतः’ (७-४-२७) इति यङन्ते रीङागमः। एवं यङन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0867_07"><a href="#ref_krm_0867_07">↑</a> [[३। ‘तुदादिभ्यः--’ (३-१-७७) इति शप्रत्यये, ‘रिङ् शयग्लिङ्क्षु’ (७-४-२८) इति रिङादेशे, इयङादेशे च रूपम्।]]</li> <li id="foot_krm_0867_08"><a href="#ref_krm_0867_08">↑</a> [[४। ‘ऋद्धनोः स्ये’ (७-२-७०) इति स्यप्रत्ययस्येडागमः।]]</li> <li id="foot_krm_0867_09"><a href="#ref_krm_0867_09">↑</a> [[५। क्विपि, तुगागमे रूपम्। एवं ल्यप्यपि तुगागमो ज्ञेयः।]]</li> <li id="foot_krm_0867_10"><a href="#ref_krm_0867_10">↑</a> [[६। तच्छीलादिषु कर्तृषु ‘जिदृक्षि--’ (३-२-१५७) इत्यादिना इनिप्रत्यये रूपमेवम्।]]</li> <li id="foot_krm_0867_11"><a href="#ref_krm_0867_11">↑</a> [[आ। ‘शैले विश्रयिणं क्षिप्रमनादरिणमभ्यमी।’ भ। का। ७। २०।]]</li> <li id="foot_krm_0867_12"><a href="#ref_krm_0867_12">↑</a> [[७। ‘एतिस्तुशास्वृदृजुषः--’ (३-१-१०९) इति क्यपि, तुगागमे च रूपम्।]]</li> <li id="foot_krm_0867_13"><a href="#ref_krm_0867_13">↑</a> [[B। ‘आदृत्यस्तेन वृत्येन स्तुत्यो जुष्येण संगतः।’ भ। का। ६। ५६।]]</li> <li id="foot_krm_0867_14"><a href="#ref_krm_0867_14">↑</a> [[८। ‘ग्रहवृदृनिश्चिगमश्च’ (३-३-५८) इति घञपवादोऽप् प्रस्ययः।]]</li> <li id="foot_krm_0867_15"><a href="#ref_krm_0867_15">↑</a> [[C। ‘आदरेण गमं चक्रुर्विषमेष्वप्यसंघसाः।’ भ। का। ७। ५६।]]</li> <li id="foot_krm_0867_16"><a href="#ref_krm_0867_16">↑</a> [[९। ‘क्तिच्क्तौ च संज्ञायाम्’ (३-३-१७४) इति संज्ञायां क्तिच्। दृतिः = चर्मनिर्मित- भस्त्रिका।]]</li> <li id="foot_krm_0867_17"><a href="#ref_krm_0867_17">↑</a> [पृष्ठम्०७६२+ २६]</li></ul></p>

दृम्फ|दृम्फकः-म्फिका|दिदृम्फिषकः-षिका|दरीदृफकः-फिका
<ul><li><sup id="ref_krm_0868_01"><a href="#foot_krm_0868_01">1</a></sup> {@“दृम्फ उत्क्लेशे”@} <sup id="ref_krm_0868_02"><a href="#foot_krm_0868_02">2</a></sup> तृम्फादिः। </li> <li>दृम्फकः-म्फिका, दृम्फकः-म्फिका, दिदृम्फिषकः-षिका, दरीदृफकः-फिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि तौदादिकतृम्फतिवत् <sup id="ref_krm_0868_03"><a href="#foot_krm_0868_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0868_04"><a href="#foot_krm_0868_04">4</a></sup> दृफितः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0868_01"><a href="#ref_krm_0868_01">↑</a> (८५८)</li> <li id="foot_krm_0868_02"><a href="#ref_krm_0868_02">↑</a> (६-तुदादिः-१३१४। अक। सेट्। पर।)</li> <li id="foot_krm_0868_03"><a href="#ref_krm_0868_03">↑</a> (७६८)</li> <li id="foot_krm_0868_04"><a href="#ref_krm_0868_04">↑</a> [[आ। ‘युद्धेषूद्दृपिता हितेष्वदृफिता यस्मिन् ऋफन्ती सुरान् ऋम्फार्हा पृतना स्थिता सुगुफितैर्माल्यैः कचान् गुम्फती।।’ धा। का। २। ७४।]]</li></ul></p>

दृप|दर्पकः-र्पिका|दिदर्पिषकः-षिका-दिदृप्सकः-प्सिका|दरीदृपकः-पिका
<ul><li><sup id="ref_krm_0869_01"><a href="#foot_krm_0869_01">1</a></sup> {@“दृप हर्षमोहनयोः”@} <sup id="ref_krm_0869_02"><a href="#foot_krm_0869_02">2</a></sup> रधादिः। </li> <li>‘हर्षमोचनयोः’ इति मैत्रेयः। </li> <li>‘मोहनम् = गर्वः’ इति स्वामी। </li> <li>धातोरस्यानुदात्तत्वेऽपि नात्मनेपदित्वम्, न वा इण्णिषेधः। </li> <li>किं तु ‘अनु- दात्तस्य च ऋदुपधस्य--’ <sup id="ref_krm_0869_03"><a href="#foot_krm_0869_03">3</a></sup> इत्यत्र ग्रहणार्थमेवानुदात्तत्वम्। </li> <li>‘रधादिभ्यश्च’ <sup id="ref_krm_0869_04"><a href="#foot_krm_0869_04">4</a></sup> इत्यनेन, तेनेड्विकल्पः। </li> <li>‘रधादित्वादिमौ- वेट्कावमर्थमनुदात्तता।’ इति वचनमिह स्मर्तव्यम्। </li> <li>दर्पकः-र्पिका, दर्पकः-र्पिका, दिदर्पिषकः-षिका-दिदृप्सकः-प्सिका, दरीदृपकः-पिका;</li> <li>  दर्पिता-द्रप्ता-दर्प्ता-त्रीं, इत्यादीनि सर्वाण्यपि रूपाणि दैवादिकतृप्यतिवत् <sup id="ref_krm_0869_05"><a href="#foot_krm_0869_05">5</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0869_06"><a href="#foot_krm_0869_06">6</a></sup> दर्पणः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0869_01"><a href="#ref_krm_0869_01">↑</a> (८५९)</li> <li id="foot_krm_0869_02"><a href="#ref_krm_0869_02">↑</a> (४-दिवादिः-११९६। अक। वेट्। पर।)</li> <li id="foot_krm_0869_03"><a href="#ref_krm_0869_03">↑</a> (६-१-५९)</li> <li id="foot_krm_0869_04"><a href="#ref_krm_0869_04">↑</a> (७-२-४५)</li> <li id="foot_krm_0869_05"><a href="#ref_krm_0869_05">↑</a> (७७०)</li> <li id="foot_krm_0869_06"><a href="#ref_krm_0869_06">↑</a> [[१। दर्पयति = हर्षयतीत्यर्थे ण्यन्तादस्मात् नन्द्यादित्वात् (३-१-१३४) कर्तरि ल्युप्रत्यये, अनादेशे च रूपमेवम्। दर्पणः = आदर्शः।]]</li></ul></p>

दृप|दर्पकः-र्पिका|दिदर्पिषकः-षिका|दरीदृपकः-पिका
<ul><li><sup id="ref_krm_0870_01"><a href="#foot_krm_0870_01">1</a></sup> {@“दृप उत्क्लेशे”@} <sup id="ref_krm_0870_02"><a href="#foot_krm_0870_02">2</a></sup> ‘दृफ’ इति द्वितीयान्तोऽयमित्येके। </li> <li>दर्पकः-र्पिका, दर्पकः-र्पिका, दिदर्पिषकः-षिका, दरीदृपकः-पिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि तौदादिकतृपतिवत् <sup id="ref_krm_0870_03"><a href="#foot_krm_0870_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0870_04"><a href="#foot_krm_0870_04">4</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0870_01"><a href="#ref_krm_0870_01">↑</a> (८६०)</li> <li id="foot_krm_0870_02"><a href="#ref_krm_0870_02">↑</a> (६-तुदादिः-१३१३। अक। सेट्। पर।)</li> <li id="foot_krm_0870_03"><a href="#ref_krm_0870_03">↑</a> (७७२)</li> <li id="foot_krm_0870_04"><a href="#ref_krm_0870_04">↑</a> [पृष्ठम्०७६३+ २७]</li></ul></p>

दृप|दर्पकः-र्पिका|दिदर्पयिषकः-|षिका|दिदर्पिषकः-षिका|दरीदृपकः-पिका
<ul><li><sup id="ref_krm_0871_01"><a href="#foot_krm_0871_01">1</a></sup> {@“दृप सन्दीपने”@} <sup id="ref_krm_0871_02"><a href="#foot_krm_0871_02">2</a></sup> ‘तृप तृप्तौ’ <sup id="ref_krm_0871_03"><a href="#foot_krm_0871_03">3</a></sup> इत्यस्य पाठान्तरोऽयम्। </li> <li>दर्पकः-र्पिका, दिदर्पयिषकः- षिका;</li> <li>  दर्पकः-र्पिका, दिदर्पिषकः-षिका, दरीदृपकः-पिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकचर्पयतिवत् <sup id="ref_krm_0871_04"><a href="#foot_krm_0871_04">4</a></sup> बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0871_01"><a href="#ref_krm_0871_01">↑</a> (८६१)</li> <li id="foot_krm_0871_02"><a href="#ref_krm_0871_02">↑</a> (१०-चुरादिः-१८२१। सक। सेट्। उभ। आधृषीयः।)</li> <li id="foot_krm_0871_03"><a href="#ref_krm_0871_03">↑</a> (७७३)</li> <li id="foot_krm_0871_04"><a href="#ref_krm_0871_04">↑</a> (५५४)</li></ul></p>

