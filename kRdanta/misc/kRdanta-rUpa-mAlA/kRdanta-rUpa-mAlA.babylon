<ul><li><sup id="ref_krm_0020_01"><a href="#foot_krm_0020_01">1</a></sup> {@“अद भक्षणे”@} <sup id="ref_krm_0020_02"><a href="#foot_krm_0020_02">2</a></sup> आदकः-दिका, आदकः-दिका, <sup id="ref_krm_0020_03"><a href="#foot_krm_0020_03">3</a></sup> जिघत्सकः-त्सिका;</li> <li>  <sup id="ref_krm_0020_04"><a href="#foot_krm_0020_04">4</a></sup> अत्ता-त्री, आदयिता-त्री, जिघत्सिता, त्री;</li> <li>  <sup id="ref_krm_0020_05"><a href="#foot_krm_0020_05">5</a></sup> अदन्-ती, आदयन्-न्ती, जिघत्सन्-न्ती;</li> <li>  अत्स्यन्-ती-न्ती, आदयिष्यन्-ती-न्ती, जिघत्सिष्यन्-ती-न्ती;</li> <li>  <sup id="ref_krm_0020_06"><a href="#foot_krm_0020_06">6</a></sup> आ <sup id="ref_krm_0020_07"><a href="#foot_krm_0020_07">7</a></sup> दयमानः, आदयिष्यमाणः;</li> <li>  सस्या <sup id="ref_krm_0020_08"><a href="#foot_krm_0020_08">8</a></sup> त्, आमात्, क्रव्यात् <sup id="ref_krm_0020_09"><a href="#foot_krm_0020_09">9</a></sup> <sup id="ref_krm_0020_10"><a href="#foot_krm_0020_10">10</a></sup>, क्रव्या <sup id="ref_krm_0020_11"><a href="#foot_krm_0020_11">11</a></sup> दः, प्रा <sup id="ref_krm_0020_12"><a href="#foot_krm_0020_12">12</a></sup> णात्, आमिषा <sup id="ref_krm_0020_13"><a href="#foot_krm_0020_13">13</a></sup> दः;</li> <li>  <sup id="ref_krm_0020_14"><a href="#foot_krm_0020_14">14</a></sup> जग्धम्-ग्धः-ग्धवान्, <sup id="ref_krm_0020_15"><a href="#foot_krm_0020_15">15</a></sup> अन्नम्-न्नवान्;</li> <li>  आदितम्-तः, जिघत्सितम्-तः-तवान्, <sup id="ref_krm_0020_16"><a href="#foot_krm_0020_16">16</a></sup> घसः, अन्ना <sup id="ref_krm_0020_17"><a href="#foot_krm_0020_17">17</a></sup> दी, पुत्रादिनी, आदिवान्, जक्षि <sup id="ref_krm_0020_18"><a href="#foot_krm_0020_18">18</a></sup> वान्, अद् <sup id="ref_krm_0020_19"><a href="#foot_krm_0020_19">19</a></sup> मरः, जिघत् <sup id="ref_krm_0020_20"><a href="#foot_krm_0020_20">20</a></sup> सुः, अत्तव्यम्, आदयितव्यम्, जिघत्सितव्यम्;</li> <li>  अदनीयम्, आदनीयम्, जिघत्सनीयम्;</li> <li>  आद्यम्, आद्यम्, जिघत्स्यम्;</li> <li>  ईषददः-दुरदः-स्वदः;</li> <li>  अद्यमानः, आद्यमानः, जिघत्स्यमानः;</li> <li>  <sup id="ref_krm_0020_21"><a href="#foot_krm_0020_21">21</a></sup> घासः, घसः, <sup id="ref_krm_0020_22"><a href="#foot_krm_0020_22">22</a></sup> न्यादः <sup id="ref_krm_0020_23"><a href="#foot_krm_0020_23">23</a></sup>, निघसः, आदः, <sup id="ref_krm_0020_24"><a href="#foot_krm_0020_24">24</a></sup> संघसः <sup id="ref_krm_0020_25"><a href="#foot_krm_0020_25">25</a></sup>, प्रघसः, जिघत्सः;</li> <li>  <sup id="ref_krm_0020_26"><a href="#foot_krm_0020_26">26</a></sup> अत्तुम्-आदको <sup id="ref_krm_0020_27"><a href="#foot_krm_0020_27">27</a></sup>, आदयितुम्, जिघत्सितुम्;</li> <li>  <sup id="ref_krm_0020_28"><a href="#foot_krm_0020_28">28</a></sup> अदनम्, आदनम्, जिघत्सनम्;</li> <li>  जग्धिः, आदना, जिघत्सा, जिघत्सयिषा;</li> <li>  जग्ध्वा, आदयित्वा, जिघत्सित्वा;</li> <li>  प्रजग्ध्य, समाद्य, प्रजिघत्स्य, आदम् २, जग्ध्वा २, आदम् २, आदयित्वा २, जिघत्सम् २;</li> <li>  जिघत्सित्वा २ <sup id="ref_krm_0020_29"><a href="#foot_krm_0020_29">29</a></sup> अत्त्रिः, <sup id="ref_krm_0020_30"><a href="#foot_krm_0020_30">30</a></sup> अद्रिः;</li> <li> </li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0020_01"><a href="#ref_krm_0020_01">↑</a> (२१)</li> <li id="foot_krm_0020_02"><a href="#ref_krm_0020_02">↑</a> (२-अदादिः-१०११-सक-अनि। पर।)</li> <li id="foot_krm_0020_03"><a href="#ref_krm_0020_03">↑</a> [[५। ‘लुङ्सनोर्घसॢ’ (२-४-३७) इति घसॢ। ‘सस्स्यार्धधातुके’ (७-४-४९) इति सकारस्य तकारः।]]</li> <li id="foot_krm_0020_04"><a href="#ref_krm_0020_04">↑</a> [[६। ‘एकाच उपदेशे--’ (७-२-१०) इतीण्णिषेधः।]]</li> <li id="foot_krm_0020_05"><a href="#ref_krm_0020_05">↑</a> [[आ। ‘अदन् मधुघ्नो द्विषते विसृज्य श्ववल्कजं विश्वमुदं दुहानः’ धा। का। २। ४४।]]</li> <li id="foot_krm_0020_06"><a href="#ref_krm_0020_06">↑</a> [पृष्ठम्००२०+ ४१]</li> <li id="foot_krm_0020_07"><a href="#ref_krm_0020_07">↑</a> [[१। ‘अदेः प्रतिषेधः’ (वा-१-३-८७) इति अस्य भक्षणार्थत्वेऽपि आत्मनेप- दित्वमेव।]]</li> <li id="foot_krm_0020_08"><a href="#ref_krm_0020_08">↑</a> [[२। ‘अदोऽनन्ने’ (३-२-६८) इति विट्।]]</li> <li id="foot_krm_0020_09"><a href="#ref_krm_0020_09">↑</a> [[B। ‘व्याप्तं गुहाशयैः क्रूरैः क्रव्याद्भिस्स निशाचरैः’ भ। का। ६-९४।]]</li> <li id="foot_krm_0020_10"><a href="#ref_krm_0020_10">↑</a> [[३। ‘क्रव्ये च’ (३-२-६९) इति विट्।]]</li> <li id="foot_krm_0020_11"><a href="#ref_krm_0020_11">↑</a> [[४। ‘वाऽसरूपो--’ (३-१-९४) इति न्याये- नाणपि।]]</li> <li id="foot_krm_0020_12"><a href="#ref_krm_0020_12">↑</a> [[C। ‘वालितो दूरभाग् रामः बाणं प्राणादमत्यजत्’ भ। का। ६। १२३।]]</li> <li id="foot_krm_0020_13"><a href="#ref_krm_0020_13">↑</a> [[ड्। ‘तव विदितविषादो दृष्टकृत्स्नामिषादः’ भ। का। १०-१७।]]</li> <li id="foot_krm_0020_14"><a href="#ref_krm_0020_14">↑</a> [[५। ‘अदो जग्धिर्ल्यप् ति किति’ (२-४-३६) इति जग्ध्यादेशः।]]</li> <li id="foot_krm_0020_15"><a href="#ref_krm_0020_15">↑</a> [[६। ‘बहुलं तणि, अन्नवधक--’ (२-४-५४) इति वार्तिकात् प्रयोगोऽयमपि साधुः। ‘अन्नाण्णः’ (४-४-८५) इति निर्देशाच्च।]]</li> <li id="foot_krm_0020_16"><a href="#ref_krm_0020_16">↑</a> [[७। ‘अच्युपसंख्यानम्-’ (वा। २-४-३७) इति घसॢ।]]</li> <li id="foot_krm_0020_17"><a href="#ref_krm_0020_17">↑</a> [[८। ‘सुप्यजातौ--’ (३-२-७८) इति णिनिः।]]</li> <li id="foot_krm_0020_18"><a href="#ref_krm_0020_18">↑</a> [[९। ‘लिट्यन्यतरस्याम्’ (२-४-४०) इति घसॢ विकल्पेन। ‘वस्वेकाज्--’ (७-२-६७) इति इट्।]]</li> <li id="foot_krm_0020_19"><a href="#ref_krm_0020_19">↑</a> [[१०। ‘सृघस्यदः क्मरच्’ (३-२-१६०) इति तच्छीलादिषु कर्तृषु क्मरच् प्रत्ययः।]]</li> <li id="foot_krm_0020_20"><a href="#ref_krm_0020_20">↑</a> [[E। ‘जिघत्सोः नूनमापादि ध्वंसोऽयं तां निशाचरात्’ भ-का ६-३१।]]</li> <li id="foot_krm_0020_21"><a href="#ref_krm_0020_21">↑</a> [[११। ‘घञपोश्च’ (२-४-३८) इति घसॢ।]]</li> <li id="foot_krm_0020_22"><a href="#ref_krm_0020_22">↑</a> [[१२। ‘नौ ण च’ (३-३-६०) इति वा अप्।]]</li> <li id="foot_krm_0020_23"><a href="#ref_krm_0020_23">↑</a> [[F। ‘व्याप्नुवन्तो दिशोऽन्यादान् कुर्वन्तस्सव्यधान् हरीन्’ भ। का। ७-५६। अविद्यमानः न्यादः = आहारः येषां तान् इत्यर्थः।]]</li> <li id="foot_krm_0020_24"><a href="#ref_krm_0020_24">↑</a> [[ङ्। ‘आदरेण गमं चक्रुर्विषमेष्वप्यसंघसाः’ भ। का। ७-५६।]]</li> <li id="foot_krm_0020_25"><a href="#ref_krm_0020_25">↑</a> [[१३। ‘उपसर्गेऽदः’ (३-३-५९) इत्यप्।]]</li> <li id="foot_krm_0020_26"><a href="#ref_krm_0020_26">↑</a> [[१४। ‘तुमुन्ण्वुलौ क्रियायां क्रियार्थायाम्’ (३-३-१०) इति तुमुण्ण्वुलौ।]]</li> <li id="foot_krm_0020_27"><a href="#ref_krm_0020_27">↑</a> (वा याति)</li> <li id="foot_krm_0020_28"><a href="#ref_krm_0020_28">↑</a> [पृष्ठम्००२१+ ३४]</li> <li id="foot_krm_0020_29"><a href="#ref_krm_0020_29">↑</a> [[१। औणादिकः त्रिन् प्रत्ययः (द। उ। १। ३७।)। ॠषिः।]]</li> <li id="foot_krm_0020_30"><a href="#ref_krm_0020_30">↑</a> [[२। औणादिकः (द। उ। १-३४।) क्रिन् प्रत्ययः।]]</li></ul></p>

अदि
<ul><li><sup id="ref_krm_0021_01"><a href="#foot_krm_0021_01">1</a></sup> {@‘अदि बन्धने’@} <sup id="ref_krm_0021_02"><a href="#foot_krm_0021_02">2</a></sup> धातोरस्य पूर्वलिखितान्ततिवत् <sup id="ref_krm_0021_03"><a href="#foot_krm_0021_03">3</a></sup> सर्वाणि रूपाणि बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0021_01"><a href="#ref_krm_0021_01">↑</a> (२२)</li> <li id="foot_krm_0021_02"><a href="#ref_krm_0021_02">↑</a> (१-भ्वादिः-६२-सक। से। पर-)</li> <li id="foot_krm_0021_03"><a href="#ref_krm_0021_03">↑</a> (२०)</li></ul></p>

