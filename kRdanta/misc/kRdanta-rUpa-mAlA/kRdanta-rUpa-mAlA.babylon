<ul><li><sup id="ref_krm_0954_01"><a href="#foot_krm_0954_01">1</a></sup> {@“ध्वृ हूर्च्छने”@} <sup id="ref_krm_0954_02"><a href="#foot_krm_0954_02">2</a></sup> “हूर्च्छनम् = कौटिल्यम्। </li> <li>‘भ्रातृव्यमेव तदपध्वरति।’ इत्यादौ हिंसायामपि दृश्यते।” इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>ध्वारकः-रिका, ध्वारकः-रिका, <sup id="ref_krm_0954_03"><a href="#foot_krm_0954_03">3</a></sup> दुध्वूर्षकः-र्षिका, <sup id="ref_krm_0954_04"><a href="#foot_krm_0954_04">4</a></sup> दाध्वरकः-रिका;</li> <li>  ध्वर्ता-ध्वर्त्री, ध्वारयिता-त्री, दुध्वूर्षिता-त्री, दाध्वरिता-त्री;</li> <li>  ध्वरन्-न्ती, ध्वारयन्-न्ती, दुध्वूर्षन्-न्ती;</li> <li>  -- <sup id="ref_krm_0954_05"><a href="#foot_krm_0954_05">5</a></sup> ध्वरिष्यन्-न्ती-ती, ध्वारयिष्यन्-न्ती-ती, दुध्वूर्षिष्यन्-न्ती-ती;</li> <li>  -- <sup id="ref_krm_0954_06"><a href="#foot_krm_0954_06">6</a></sup> -- ध्वारयमाणः, ध्वारयिष्यमाणः, -- दाध्वर्यमाणः, दाध्वरिष्यमाणः;</li> <li>  <sup id="ref_krm_0954_07"><a href="#foot_krm_0954_07">7</a></sup> प्रध्वृत्-प्रध्वृद्-प्रध्वृतौ-प्रध्वृतः;</li> <li>  -- -- ध्वृतम्- <sup id="ref_krm_0954_08"><a href="#foot_krm_0954_08">8</a></sup> विध्वृतः, ध्वारितः, दुध्वूर्षितः, दाध्वरितः-तवान्;</li> <li>  <sup id="ref_krm_0954_09"><a href="#foot_krm_0954_09">9</a></sup> ध्वरः, <sup id="ref_krm_0954_10"><a href="#foot_krm_0954_10">10</a></sup> दध्वरिवान्, ध्वारः, दुध्वूर्षुः, दाध्वरः;</li> <li>  ध्वर्तव्यम्, ध्वारयितव्यम्, दुध्वूर्षितव्यम्, दाध्वरितव्यम्;</li> <li>  ध्वरणीयम्, ध्वारणीयम्, दुध्वूर्षणीयम्, दाध्वरणीयम्;</li> <li>  ध्वार्यम्, <sup id="ref_krm_0954_11"><a href="#foot_krm_0954_11">11</a></sup> ध्वर्यः, ध्वार्यम्, दुध्वूर्ष्यम्, दाध्वर्यम्;</li> <li>  ईषद्ध्वरः-दुर्ध्वरः-सुध्वरः;</li> <li>  -- -- <sup id="ref_krm_0954_12"><a href="#foot_krm_0954_12">12</a></sup> ध्वर्यमाणः, ध्वार्यमाणः, दुध्वूर्ष्यमाणः, दाध्वर्यमाणः;</li> <li>  ध्वारः, ध्वारः, दुध्वूर्षः, दाध्वरः;</li> <li>  ध्वर्तुम्, ध्वारयितुम्, दुध्वूर्षितुम्, दाध्वरितुम्;</li> <li>  ध्वृतिः, ध्वारणा, दुध्वूर्षा, दाध्वरा;</li> <li>  ध्वरणम्, ध्वारणम्, दुध्वूर्षणम्, दाध्वरणम्;</li> <li>  ध्वृत्वा, ध्वारयित्वा, दुध्वूर्षित्वा, दाध्वरित्वा;</li> <li>  प्रध्वृत्य, प्रध्वार्य, प्रदुध्वूर्ष्य, प्रदाध्वर्य;</li> <li>  ध्वारम् २, ध्वृत्वा २, ध्वारम् २, ध्वारयित्वा २, दुध्वूर्षम् २, दुध्वूर्षित्वा २, दाध्वरम् २;</li> <li>  दाध्वरित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0954_01"><a href="#ref_krm_0954_01">↑</a> (९४४)</li> <li id="foot_krm_0954_02"><a href="#ref_krm_0954_02">↑</a> (१-भ्वादिः-९३९। सक। अनि। पर।)</li> <li id="foot_krm_0954_03"><a href="#ref_krm_0954_03">↑</a> [[३। सनि, ‘अज्झनगमां सनि’ (६-४-१६) इति दीर्घे, ‘उदोष्ठ्यपूर्वस्य’ (७-१-१०२) इत्युत्त्वे, रपरत्वे, ‘हलि च’ (८-२-७७) इति दीर्घः।]]</li> <li id="foot_krm_0954_04"><a href="#ref_krm_0954_04">↑</a> [[४। संयोगादित्वात्, ‘यङि च’ (७-४-३०) इति गुणः। अभ्यासकार्यम्। ‘दीर्घोऽ- कितः’ (७-४-८३) इत्यभ्यासस्य दीर्घः।]]</li> <li id="foot_krm_0954_05"><a href="#ref_krm_0954_05">↑</a> [[५। स्यप्रत्यये, ‘ऋद्धनोः स्ये’ (७-२-७०) इतीडागमः।]]</li> <li id="foot_krm_0954_06"><a href="#ref_krm_0954_06">↑</a> [पृष्ठम्०८२६+ २६]</li> <li id="foot_krm_0954_07"><a href="#ref_krm_0954_07">↑</a> [[१। क्विपि, तुगागमः। एवं ल्यप्यपि ज्ञेयम्।]]</li> <li id="foot_krm_0954_08"><a href="#ref_krm_0954_08">↑</a> [[आ। ‘घृणाऽस्तु ते विध्वृतश्रदैत्यस्रुतास्रसिक्तायुधविश्वसोतः।।’ धा। का। २। ३४।]]</li> <li id="foot_krm_0954_09"><a href="#ref_krm_0954_09">↑</a> [[२। पचाद्यचि रूपमेवम्। न ध्वरः = हिंसा कौटिल्यं वा यत्रेति अध्वरः = यज्ञः।]]</li> <li id="foot_krm_0954_10"><a href="#ref_krm_0954_10">↑</a> [[३। क्वसुप्रत्यये, ‘वस्वेकाजाद्घसाम्’ (७-२-६७) इतीडागमे च रूपमेवम्।]]</li> <li id="foot_krm_0954_11"><a href="#ref_krm_0954_11">↑</a> [[४। ‘छन्दसि निष्टर्क्यदेवहूयप्रणीयोन्नीयोच्छिष्यमर्यस्तर्याध्वर्य--’ (३-१-१२३) इति निपातनात् यत्प्रत्यये रूपम्। छन्दस्येवायम्।]]</li> <li id="foot_krm_0954_12"><a href="#ref_krm_0954_12">↑</a> [[५। ‘गुणोऽर्तिसंयोगाद्योः’ (७-४-२९) इति यकि गुणः।]]</li></ul></p>

नक्क
<ul><li><sup id="ref_krm_0955_01"><a href="#foot_krm_0955_01">1</a></sup> {@“नक्क नाशने”@} <sup id="ref_krm_0955_02"><a href="#foot_krm_0955_02">2</a></sup> ‘णक्क--’ इति णोपदेशममुं धातुं क्षीरस्वामी पपाठ। </li> <li>णोपदेशधातुषु अस्य पर्युदासात् णोपदेशकार्यं नेति ज्ञेयम्। </li> <li>नक्ककः-क्किका, निनक्कयिषकः-षिका, <sup id="ref_krm_0955_03"><a href="#foot_krm_0955_03">3</a></sup> प्रनक्कयिता-त्री, इत्यादीनि सर्वाण्यपि <sup id="ref_krm_0955_04"><a href="#foot_krm_0955_04">4</a></sup> रूपाणि चौरादिककुट्टयतिवत् <sup id="ref_krm_0955_05"><a href="#foot_krm_0955_05">5</a></sup> ज्ञेयानि। </li> <li>दोपधोऽयं धातुः। </li> <li>दकारस्य सन्धिवशात् ककारः। </li> <li>दोपधफलं तु नद्-नत्-नक्कौ-नक्कः, इति क्विपि द्रष्टव्यम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0955_01"><a href="#ref_krm_0955_01">↑</a> (९४५)</li> <li id="foot_krm_0955_02"><a href="#ref_krm_0955_02">↑</a> (१०-चुरादिः-१५९३। सक। सेट्। उभ।)</li> <li id="foot_krm_0955_03"><a href="#ref_krm_0955_03">↑</a> [[६। नकारादित्वात्, णोपदेशाभावादस्य धातोः ‘उपसर्गादसमासेऽपि णोपदेशस्य’ (८-४-१४) इति विहितं णत्वं न।]]</li> <li id="foot_krm_0955_04"><a href="#ref_krm_0955_04">↑</a> [पृष्ठम्०८२७+ २९]</li> <li id="foot_krm_0955_05"><a href="#ref_krm_0955_05">↑</a> (२०७)</li></ul></p>

नट
<ul><li><sup id="ref_krm_0956_01"><a href="#foot_krm_0956_01">1</a></sup> {@“नट अवस्पन्दने”@} <sup id="ref_krm_0956_02"><a href="#foot_krm_0956_02">2</a></sup> अयं धातुः पूर्वम् <sup id="ref_krm_0956_03"><a href="#foot_krm_0956_03">3</a></sup> प्रसङ्गाल्लिखितः। </li> <li>तत्रैव द्रष्टव्यश्च।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0956_01"><a href="#ref_krm_0956_01">↑</a> (९४६)</li> <li id="foot_krm_0956_02"><a href="#ref_krm_0956_02">↑</a> (१०-चुरादिः-१५४५। अक। सेट्। उभ।)</li> <li id="foot_krm_0956_03"><a href="#ref_krm_0956_03">↑</a> (६५८ संख्याकधातौ)</li></ul></p>

नट|नाटकः-टिका|निनाटयिषकः-षिका
<ul><li><sup id="ref_krm_0957_01"><a href="#foot_krm_0957_01">1</a></sup> {@“नट भाषार्थः”@} <sup id="ref_krm_0957_02"><a href="#foot_krm_0957_02">2</a></sup> आस्वदीयः। </li> <li>‘नल--’ इति ‘नड--’ इति च केचित्। </li> <li>‘नृतौ नटत्यवस्पन्दे चुरादेर्णिचि नाटयेत्।’ <sup id="ref_krm_0957_03"><a href="#foot_krm_0957_03">3</a></sup> इति देवः। </li> <li>नाटकः-टिका, निनाटयिषकः-षिका;</li> <li>  इत्यादीनि रूपाणि चौरादिक- नाटयतिवत् <sup id="ref_krm_0957_04"><a href="#foot_krm_0957_04">4</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0957_01"><a href="#ref_krm_0957_01">↑</a> (९४७)</li> <li id="foot_krm_0957_02"><a href="#ref_krm_0957_02">↑</a> (१०-चुरादिः-१७९२। अक। सेट्। उभ।)</li> <li id="foot_krm_0957_03"><a href="#ref_krm_0957_03">↑</a> (श्लो। ७६)</li> <li id="foot_krm_0957_04"><a href="#ref_krm_0957_04">↑</a> (६५९)</li></ul></p>

टु|नन्दकः-न्दिका|निनन्दिषकः-षिका|नानन्दकः-न्दिका
<ul><li><sup id="ref_krm_0958_01"><a href="#foot_krm_0958_01">1</a></sup> {@“टु नदि समृद्धौ”@} <sup id="ref_krm_0958_02"><a href="#foot_krm_0958_02">2</a></sup> नन्दकः-न्दिका, नन्दकः-न्दिका, निनन्दिषकः-षिका, नानन्दकः-न्दिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककन्दतिवत् <sup id="ref_krm_0958_03"><a href="#foot_krm_0958_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0958_04"><a href="#foot_krm_0958_04">4</a></sup> नन्दः, <sup id="ref_krm_0958_05"><a href="#foot_krm_0958_05">5</a></sup> <sup id="ref_krm_0958_06"><a href="#foot_krm_0958_06">6</a></sup> नन्दनः, <sup id="ref_krm_0958_07"><a href="#foot_krm_0958_07">7</a></sup> नन्दकः, <sup id="ref_krm_0958_08"><a href="#foot_krm_0958_08">8</a></sup> <sup id="ref_krm_0958_09"><a href="#foot_krm_0958_09">9</a></sup> रघुनन्दनः, <sup id="ref_krm_0958_10"><a href="#foot_krm_0958_10">10</a></sup> <sup id="ref_krm_0958_11"><a href="#foot_krm_0958_11">11</a></sup> हरिनन्दी, परिनन्दनम्, <sup id="ref_krm_0958_12"><a href="#foot_krm_0958_12">12</a></sup> नन्दथुः, <sup id="ref_krm_0958_13"><a href="#foot_krm_0958_13">13</a></sup> <sup id="ref_krm_0958_14"><a href="#foot_krm_0958_14">14</a></sup> इत्नुच्प्रत्ययो ण्यन्तात् भवति। </li> <li>नन्दयतीति नन्दयित्नुः आनन्दः, प्रमुदितश्च। </li> <li>‘अयामन्ताल्वाय्येत्न्विष्णिषु’ <sup id="ref_krm_0958_15"><a href="#foot_krm_0958_15">15</a></sup> इति णेरयादेशः।]] नन्दयित्नुः, <sup id="ref_krm_0958_16"><a href="#foot_krm_0958_16">16</a></sup> <sup id="ref_krm_0958_17"><a href="#foot_krm_0958_17">17</a></sup> इति ऋन्प्रत्ययः वृद्धिश्च। </li> <li>न नन्दतीति ननान्दा = पत्युर्भगिनी।]] ननान्दा, <sup id="ref_krm_0958_18"><a href="#foot_krm_0958_18">18</a></sup> इत्यादिना आशिषि झच्प्रत्ययः षिच्च। </li> <li>नन्द्यात् इत्याशीरर्थे नन्दयन्तः इति रूपम् आनन्द इत्यर्थः।]] नन्दयन्तः इत्यादीन्यस्य धातोरधिकतया विशेषरूपाणि सम्भवन्तीति ज्ञेयम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0958_01"><a href="#ref_krm_0958_01">↑</a> (९४८)</li> <li id="foot_krm_0958_02"><a href="#ref_krm_0958_02">↑</a> (१-भ्वादिः-६७। अक। सेट्। पर।)</li> <li id="foot_krm_0958_03"><a href="#ref_krm_0958_03">↑</a> (१६३)</li> <li id="foot_krm_0958_04"><a href="#ref_krm_0958_04">↑</a> [[१। पचाद्यचि (३-१-१३४) रूपमेवम्। नन्दतीति नन्दः। नन्द एव नान्दः प्रज्ञादि त्वात् (५-४-३८) स्वार्थेऽण्। अणन्तात् ङीपि नान्दी = मङ्गलध्वनिः।]]</li> <li id="foot_krm_0958_05"><a href="#ref_krm_0958_05">↑</a> [[आ। ‘मनोज्ञगण्डं तमनिन्दिताननं नन्दात्मजं शारदचन्द्रशीतलम्।’ धा। का। १। १०]]</li> <li id="foot_krm_0958_06"><a href="#ref_krm_0958_06">↑</a> [[२। ण्यन्तात् नन्दयतीति नन्दनः। ‘नन्दिग्रहि--’ (३-१-१३४) इति कर्तरि ल्युप्रत्ययः। कर्मण्यणोऽपवादः।]]</li> <li id="foot_krm_0958_07"><a href="#ref_krm_0958_07">↑</a> [[३। नन्दतात् इति नन्दकः ‘आशिषि च’ (३-१-१५०) इति वुन्। ‘आशिषि च’ (वा। ७-३-४५) इति निषेधात् स्त्रियाम् इत्वं न, तेन नन्दका इत्येव।]]</li> <li id="foot_krm_0958_08"><a href="#ref_krm_0958_08">↑</a> [[B। ‘अत्यर्थमुद्वेजयिता परेषां नाम्नाऽपि तस्यैव स नन्दकोऽभूत्।।’ शि। पा। ३। १९]]</li> <li id="foot_krm_0958_09"><a href="#ref_krm_0958_09">↑</a> [[४। रघूणां नन्दयिता रघुनन्दनः। क्ष्नुभ्नादित्वात् (८-४-३९) णत्वं न।]]</li> <li id="foot_krm_0958_10"><a href="#ref_krm_0958_10">↑</a> [[C। ‘तृणाय मत्वा रघुनन्दनोऽथ बाणेन रक्षः प्रधनान्निरास्थत्।।’ भ। का। २। ३६।]]</li> <li id="foot_krm_0958_11"><a href="#ref_krm_0958_11">↑</a> [[५। हरिं नन्दतीति हरिन्दन्दी, ‘सुप्यजातौ--’ (३-२-७८) इति ताच्छील्ये णिनिः। अत्र, परिनन्दनम् इत्यत्र च क्ष्नुभ्नादित्वादेव (८-४-३९) णत्वं न।]]</li> <li id="foot_krm_0958_12"><a href="#ref_krm_0958_12">↑</a> [[६। ‘ट्वितोऽथुच्’ (३-३-८९) इति भावादावथुच्प्रत्ययः।]]</li> <li id="foot_krm_0958_13"><a href="#ref_krm_0958_13">↑</a> [[ड्। ‘सारोऽसाविन्द्रियार्थानां यस्यासौ तस्य नन्दथुः।’ भ। का। ५। २०।]]</li> <li id="foot_krm_0958_14"><a href="#ref_krm_0958_14">↑</a> [[७। औणादिकः [द। उ। १-१४०]</li> <li id="foot_krm_0958_15"><a href="#ref_krm_0958_15">↑</a> (६-४-५५)</li> <li id="foot_krm_0958_16"><a href="#ref_krm_0958_16">↑</a> [पृष्ठम्०८२८+ २५]</li> <li id="foot_krm_0958_17"><a href="#ref_krm_0958_17">↑</a> [[१। ‘नञि च नन्देः’ [द। उ। २। ६।]</li> <li id="foot_krm_0958_18"><a href="#ref_krm_0958_18">↑</a> [[२। ‘तॄभूवहि--’ [द। उ। ६। १९]</li></ul></p>

नर्द|नर्दकः-र्दिका|निनर्दिषकः-षिका|नानर्दकः-र्दिका
<ul><li><sup id="ref_krm_0959_01"><a href="#foot_krm_0959_01">1</a></sup> {@“नर्द शब्दे”@} <sup id="ref_krm_0959_02"><a href="#foot_krm_0959_02">2</a></sup> नर्दकः-र्दिका, नर्दकः-र्दिका, निनर्दिषकः-षिका, नानर्दकः-र्दिका;</li> <li>  अित्यादीनि रूपाणि भौवादिककर्जतिवत् <sup id="ref_krm_0959_03"><a href="#foot_krm_0959_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0959_04"><a href="#foot_krm_0959_04">4</a></sup> गेहेनर्दी, <sup id="ref_krm_0959_05"><a href="#foot_krm_0959_05">5</a></sup> सिंहनदीं, <sup id="ref_krm_0959_06"><a href="#foot_krm_0959_06">6</a></sup> विनर्दन् <sup id="ref_krm_0959_07"><a href="#foot_krm_0959_07">7</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0959_01"><a href="#ref_krm_0959_01">↑</a> (९४९)</li> <li id="foot_krm_0959_02"><a href="#ref_krm_0959_02">↑</a> (१-भ्वादिः-५६। अक। सेट्। पर।)</li> <li id="foot_krm_0959_03"><a href="#ref_krm_0959_03">↑</a> (१६९)</li> <li id="foot_krm_0959_04"><a href="#ref_krm_0959_04">↑</a> [[३। ‘सुप्यजातौ णिनिस्ताच्छील्ये’ (३-२-७८) इति ताच्छील्ये णिनिः। ‘पात्रेसमिता- दयश्च’ (२-१-४८) इत्यत्र निपातनात् क्षेपार्थे तत्पुरुषसमासः सप्तम्या अलुक् च।]]</li> <li id="foot_krm_0959_05"><a href="#ref_krm_0959_05">↑</a> [[४। ‘कर्तर्युपमाने’ (३-२-७९) इति उपमानवाचकोपपदात् णिनिप्रत्ययः।]]</li> <li id="foot_krm_0959_06"><a href="#ref_krm_0959_06">↑</a> [[आ। ‘शूरम्मन्यो रणाच्चाहं निरस्तः सिंहनर्दिना।।’ भ। का। ५। ३४।]]</li> <li id="foot_krm_0959_07"><a href="#ref_krm_0959_07">↑</a> [[B। ‘कष्टं विनर्दतः क्रूरान् शस्त्रघुष्टकरान् कपिः।।’ भ। का। ९। १८।]]</li></ul></p>

नाथृ|नाथकः-थिका|निनाथिषकः-षिका|नानाथकः-थिका|नाथिता-त्री|नाथयिता-त्री|निनाथिषिता-त्री|नानाथिता-त्री|नाथन्-न्ती|नाथयन्-न्ती|निनाथिषन्-न्ती|-|नाथिष्यन्-न्ती-ती|नाथयिष्यन्-न्ती-ती|निनाथिषिष्यन्-न्ती-ती|-नाथमानः|नाथयमानः|निनाथिषमाणः|नानाथ्यमानः
<ul><li><sup id="ref_krm_0960_01"><a href="#foot_krm_0960_01">1</a></sup> {@“नाथृ याच्ञोपतापैश्वर्याशीःषु”@} <sup id="ref_krm_0960_02"><a href="#foot_krm_0960_02">2</a></sup> अुपतापः = ज्वरप्रयुक्ता पीडा। </li> <li>ऐश्वर्यम् = सम्पत्तिः। </li> <li>आशीः = आशासनम्। </li> <li>आशीरथ एव आत्मनेपदम्। </li> <li>अन्येष्वर्थेषु परस्मैपदमेव। </li> <li>द्विकर्मकोऽयं याच्ञार्थे। </li> <li><sup id="ref_krm_0960_03"><a href="#foot_krm_0960_03">3</a></sup> नाथकः-थिका, नाथकः-थिका, निनाथिषकः-षिका, नानाथकः-थिका;</li> <li>  नाथिता-त्री, नाथयिता-त्री, निनाथिषिता-त्री, नानाथिता-त्री;</li> <li>  <sup id="ref_krm_0960_04"><a href="#foot_krm_0960_04">4</a></sup> नाथन्-न्ती, नाथयन्-न्ती, निनाथिषन्-न्ती;</li> <li>  -- नाथिष्यन्-न्ती-ती, नाथयिष्यन्-न्ती-ती, निनाथिषिष्यन्-न्ती-ती;</li> <li>  -- <sup id="ref_krm_0960_05"><a href="#foot_krm_0960_05">5</a></sup> <sup id="ref_krm_0960_06"><a href="#foot_krm_0960_06">6</a></sup> नाथमानः, नाथयमानः, निनाथिषमाणः, नानाथ्यमानः;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकगाधतिवत् <sup id="ref_krm_0960_07"><a href="#foot_krm_0960_07">7</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0960_08"><a href="#foot_krm_0960_08">8</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0960_01"><a href="#ref_krm_0960_01">↑</a> (९५०)</li> <li id="foot_krm_0960_02"><a href="#ref_krm_0960_02">↑</a> (१-भ्वादिः-६। सक। सेट्। आत्म।)</li> <li id="foot_krm_0960_03"><a href="#ref_krm_0960_03">↑</a> [[C। ‘द्रक्ष्यन् हरिं नाधितलोकनाथकं देधे मुदास्कुन्दितमन्तरिन्द्रियम्।।’ धा। का। १। २।]]</li> <li id="foot_krm_0960_04"><a href="#ref_krm_0960_04">↑</a> [[५। याच्ञाभिन्नार्थे ‘शेषात् कर्तरि परस्मैपदम्’ (१-३-७८) इति परस्मैपदं, शता।]]</li> <li id="foot_krm_0960_05"><a href="#ref_krm_0960_05">↑</a> [[६। ‘आशिषि नाथः’ (वा। १-३-२१) इत्यात्मनेपदम्, ‘आशिषि नाथः’ (२-३-५५) इति कर्मणि षष्ठी।]]</li> <li id="foot_krm_0960_06"><a href="#ref_krm_0960_06">↑</a> [सर्पिषो]</li> <li id="foot_krm_0960_07"><a href="#ref_krm_0960_07">↑</a> (३९१)</li> <li id="foot_krm_0960_08"><a href="#ref_krm_0960_08">↑</a> [पृष्ठम्०८२९+ २७]</li></ul></p>

नाधृ|नाधकः-धिका|निनाधिषकः-षिका|नानाधकः-धिका
<ul><li><sup id="ref_krm_0961_01"><a href="#foot_krm_0961_01">1</a></sup> {@“नाधृ याच्ञोपतापैश्वर्याशीःषु”@} <sup id="ref_krm_0961_02"><a href="#foot_krm_0961_02">2</a></sup> नाधकः-धिका, नाधकः-धिका, निनाधिषकः-षिका, नानाधकः-धिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकगाधतिवत् <sup id="ref_krm_0961_03"><a href="#foot_krm_0961_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0961_04"><a href="#foot_krm_0961_04">4</a></sup> नाधितः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0961_01"><a href="#ref_krm_0961_01">↑</a> (९५१)</li> <li id="foot_krm_0961_02"><a href="#ref_krm_0961_02">↑</a> (१-भ्वादिः-७-अक। सेट्। आत्म।)</li> <li id="foot_krm_0961_03"><a href="#ref_krm_0961_03">↑</a> (३९४)</li> <li id="foot_krm_0961_04"><a href="#ref_krm_0961_04">↑</a> [[आ। ‘द्रक्ष्यन् हरिं नाधितलोकनाथकं देधे मुदास्कुन्दितमन्तरिन्द्रियम्।।’ धा। का। १। २।]]</li></ul></p>

निवास|अत|एवाडागम-|योग्येषु|लकारेष्वपि|अनिवासयिष्यत्|इत्याद्येव|रूपम्।]]|निवासकः-सिका|निनिवासयिषकः-षिका|निवासयिता-त्री|निनिवासयिषिता-त्री|निवासयन्-न्ती|निनिवासयिषन्-न्ती|निवासयिष्यन्-न्ती-ती|निनिवासयिषिष्यन्-न्ती-ती|निवासयमानः|निनिवासयिषमाणः|निवासयिष्यमाणः|निनिवासयिषिष्यमाणः|सुनिवासू-सुनिवासौ-सुनिवासः|-|-निवासितम्-तः|निनिवासयिषितः-तवान्|निवासः|निनिवासयिषुः|निवासयितव्यम्|निनिवासयिषितव्यम्|निवासनीयम्|निनिवासयिष-|णीयम्|निवास्यम्|निनिवासयिष्यम्|ईषन्निवासः-दुर्निवासः-सुनिवासः|निनिवासयिषः|निवासयितुम्|निनिवासयिषितुम्|निवासना|निनिवासयिषा|निवासनम्|निनिवासयिषणम्|निवासयित्वा|निनिवासयिषित्वा|प्रणिवास्य|प्रणिनिवासयिष्य|निवासम्|निनिवासयिषम्
<ul><li><sup id="ref_krm_0962_01"><a href="#foot_krm_0962_01">1</a></sup> {@“निवास आच्छादने”@} <sup id="ref_krm_0962_02"><a href="#foot_krm_0962_02">2</a></sup> अदन्तः। </li> <li><sup id="ref_krm_0962_03"><a href="#foot_krm_0962_03">3</a></sup> अत्र धातौ ‘नि’ इत्युपसर्गविशिष्टस्यैव धातुत्वम्, इति क्षीरस्वामिमतम्। </li> <li>‘पूर्वं धातुरुपसर्गेण युज्यते’ इति भाष्यमतेनैवमुक्तम्। </li> <li>तन्मते निवासयित्वा इत्यत्र क्त्वाप्रत्ययस्योपपत्तिश्चिन्त्या। </li> <li>वस्तुतस्तु ‘सङ्ग्राम, व्यय, वीर’ इत्यादिषु ‘सम्, वि’ इत्युपसर्गयोरिव अत्रापि ‘नि’ इत्युपसर्गविशिष्टस्यैव धातुत्वम्। </li> <li>अत्र प्रकृतिप्रत्ययोपसर्गादिविभागरहितः ‘निवास’ इत्यानुपूर्वीक एव धातुरिति तत्त्वम्। </li> <li>अन्यथा, ‘पूर्वं धातुः साधनेन युज्यते’ इति ‘सुट् कात् पूर्वः’ <sup id="ref_krm_0962_04"><a href="#foot_krm_0962_04">4</a></sup> इति सूत्रभाष्ये सिद्धान्तितस्य विरोधस्स्यात्। </li> <li>अत एवाडागम- योग्येषु लकारेष्वपि अनिवासयिष्यत् इत्याद्येव रूपम्।]] निवासकः-सिका, निनिवासयिषकः-षिका;</li> <li>  निवासयिता-त्री, निनिवासयिषिता-त्री;</li> <li>  निवासयन्-न्ती, निनिवासयिषन्-न्ती;</li> <li>  निवासयिष्यन्-न्ती-ती, निनिवासयिषिष्यन्-न्ती-ती;</li> <li>  निवासयमानः, निनिवासयिषमाणः, निवासयिष्यमाणः, निनिवासयिषिष्यमाणः;</li> <li>  <sup id="ref_krm_0962_05"><a href="#foot_krm_0962_05">5</a></sup> सुनिवासू-सुनिवासौ-सुनिवासः;</li> <li>  -- -- <sup id="ref_krm_0962_06"><a href="#foot_krm_0962_06">6</a></sup> निवासितम्-तः, निनिवासयिषितः-तवान्;</li> <li>  निवासः, निनिवासयिषुः;</li> <li>  निवासयितव्यम्, निनिवासयिषितव्यम्;</li> <li>  निवासनीयम्, निनिवासयिष- णीयम्;</li> <li>  निवास्यम्, निनिवासयिष्यम्;</li> <li>  निवासयमानः, निनिवासयिषमाणः;</li> <li>  ईषन्निवासः-दुर्निवासः-सुनिवासः;</li> <li>  -- -- निवासः, निनिवासयिषः;</li> <li>  निवासयितुम्, निनिवासयिषितुम्;</li> <li>  निवासना, निनिवासयिषा;</li> <li>  निवासनम्, निनिवासयिषणम्;</li> <li>  निवासयित्वा, निनिवासयिषित्वा;</li> <li>  प्रणिवास्य, प्रणिनिवासयिष्य;</li> <li>  <sup id="ref_krm_0962_07"><a href="#foot_krm_0962_07">7</a></sup> निवासम् २, निवासयित्वा २, निनिवासयिषम् २;</li> <li>  निनिवासयिषित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0962_01"><a href="#ref_krm_0962_01">↑</a> (९५२)</li> <li id="foot_krm_0962_02"><a href="#ref_krm_0962_02">↑</a> (१०-चुरादिः-१८८६। सक। सेट्। उभ।)</li> <li id="foot_krm_0962_03"><a href="#ref_krm_0962_03">↑</a> [[[अ]</li> <li id="foot_krm_0962_04"><a href="#ref_krm_0962_04">↑</a> (६-१-१३५)</li> <li id="foot_krm_0962_05"><a href="#ref_krm_0962_05">↑</a> [[१। क्विपि, अदन्तत्वादस्य धातोरल्लोपस्य स्थानिवद्भावात् सकारस्य रुत्वविसर्गौ न भवतः।]]</li> <li id="foot_krm_0962_06"><a href="#ref_krm_0962_06">↑</a> [[B। ‘छिद्रं गवेषयितुमेव तु वासयन्ते ये ते निवासितधियो ह्यसुभिर्विभाज्याः।।’ धा। का। ३। ५६।]]</li> <li id="foot_krm_0962_07"><a href="#ref_krm_0962_07">↑</a> [पृष्ठम्०८३०+ २९]</li></ul></p>

निष्क|निष्ककः-ष्किका|निनिष्कयिषकः-षिका
<ul><li><sup id="ref_krm_0963_01"><a href="#foot_krm_0963_01">1</a></sup> {@“निष्क परिमाणे”@} <sup id="ref_krm_0963_02"><a href="#foot_krm_0963_02">2</a></sup> आकुस्मीयः। </li> <li>निष्ककः-ष्किका, निनिष्कयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकचित्रयतिवत् <sup id="ref_krm_0963_03"><a href="#foot_krm_0963_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0963_04"><a href="#foot_krm_0963_04">4</a></sup> निष्कितम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0963_01"><a href="#ref_krm_0963_01">↑</a> (९५३)</li> <li id="foot_krm_0963_02"><a href="#ref_krm_0963_02">↑</a> (१०-चुरादिः-१६८७। सक। सेट्। आत्म।)</li> <li id="foot_krm_0963_03"><a href="#ref_krm_0963_03">↑</a> (५२५)</li> <li id="foot_krm_0963_04"><a href="#ref_krm_0963_04">↑</a> [[आ। ‘किष्क्येत निष्कृपमनिष्कितकान्तिरेष बालोऽमुना नृपतिलालनयाऽद्य कष्टम्।।’ धा। का। ३। ३४।]]</li></ul></p>

नृती|नर्तकः-र्तिका|निनृत्सकः-निनर्तिषकः-षिका|नरीनृतकः-तिका
<ul><li><sup id="ref_krm_0964_01"><a href="#foot_krm_0964_01">1</a></sup> {@“नृती गात्रविक्षेपे”@} <sup id="ref_krm_0964_02"><a href="#foot_krm_0964_02">2</a></sup> नर्तकः-र्तिका, नर्तकः-र्तिका, निनृत्सकः-निनर्तिषकः-षिका, <sup id="ref_krm_0964_03"><a href="#foot_krm_0964_03">3</a></sup> नरीनृतकः-तिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि तौदादिककृन्ततिवत् <sup id="ref_krm_0964_04"><a href="#foot_krm_0964_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0964_05"><a href="#foot_krm_0964_05">5</a></sup> नृत्यन्-न्ती, <sup id="ref_krm_0964_06"><a href="#foot_krm_0964_06">6</a></sup> नर्त्स्यन्-न्ती-ती, <sup id="ref_krm_0964_07"><a href="#foot_krm_0964_07">7</a></sup> नर्तकः- <sup id="ref_krm_0964_08"><a href="#foot_krm_0964_08">8</a></sup> नर्तकी, <sup id="ref_krm_0964_09"><a href="#foot_krm_0964_09">9</a></sup> नर्तयमानः, <sup id="ref_krm_0964_10"><a href="#foot_krm_0964_10">10</a></sup> <sup id="ref_krm_0964_11"><a href="#foot_krm_0964_11">11</a></sup> नर्तनः, <sup id="ref_krm_0964_12"><a href="#foot_krm_0964_12">12</a></sup> इति कूप्रत्यये रूपम्। </li> <li>नृतूः = दीर्घाकृतिः, नर्तकः, क्रिमिविशेषो वा।]] नृतूः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0964_01"><a href="#ref_krm_0964_01">↑</a> (९५४)</li> <li id="foot_krm_0964_02"><a href="#ref_krm_0964_02">↑</a> (४-दिवादिः-१११६। अक। सेट्। पर।)</li> <li id="foot_krm_0964_03"><a href="#ref_krm_0964_03">↑</a> [[१। क्षुभ्नादिषु (८-४-३९) ‘नृत्यतेर्यङि’ (ग। सू।) इति पाठात् णत्वनिषेधः।]]</li> <li id="foot_krm_0964_04"><a href="#ref_krm_0964_04">↑</a> (२४८)</li> <li id="foot_krm_0964_05"><a href="#ref_krm_0964_05">↑</a> [[२। शतरि, ‘दिवादिभ्यः’ (३-१-६९) इति श्यन्प्रत्यये रूपम्।]]</li> <li id="foot_krm_0964_06"><a href="#ref_krm_0964_06">↑</a> [[B। ‘वनं चचार कर्तिष्यन् नर्त्स्यन् इव निरङ्कुशः।।’ भ। का। ९। ४२।]]</li> <li id="foot_krm_0964_07"><a href="#ref_krm_0964_07">↑</a> [[३। ‘शिल्पिनि ष्वुन्’ (३-१-१४५) इत्यत्र ‘नृतिखनिरञ्जिभ्य एव’ (वा। ३-१-१४५) इति परिगणनादस्मात् ष्वुन्प्रत्यये रूपम्। षित्त्वात् स्त्रियां ङीप्।]]</li> <li id="foot_krm_0964_08"><a href="#ref_krm_0964_08">↑</a> [[C। ‘नर्तकीरभिनयातिलङ्घिनीः पार्श्ववर्तिषु गुरुष्वलज्जयत्।।’ रघु। १९। १४।]]</li> <li id="foot_krm_0964_09"><a href="#ref_krm_0964_09">↑</a> [[४। अस्य धातोः चलनार्थत्वात्, अणावकर्मकत्वाच्च, ण्यन्तात् क्रमेण ‘निगरणचल- नार्थेभ्यः--’ (१-३-८७) इति, ‘अणावकर्मकाच्चित्तवत्कर्तृकात्’ (१-३-८८) इति च यत् परस्मैपदं कर्त्रभिप्राये क्रियाफले प्राप्तम्, तत् ‘न पादम्याङ्यमाङ्यस- परिमुहरुचिनृतिवदवसः’ (१-३-८९) इति निषिध्यते। तेन शता न भवति। परगामिनि क्रियाफले तु ‘णिचश्च’ (१-३-७४) इति, ‘शेषात् कर्तरि--’ (१-३-७८) इति च उभयपदं भवत्येव। तेन नर्तयन् इत्यपि साधुः।]]</li> <li id="foot_krm_0964_10"><a href="#ref_krm_0964_10">↑</a> [[ड्। ‘अवाद् वायुः शनैर्यस्यां लतां नर्तयमानवत्।’ भ। का। ८। ६१।]]</li> <li id="foot_krm_0964_11"><a href="#ref_krm_0964_11">↑</a> [[५। ‘चलनशब्दार्थादकर्मकात्--’ (३-२-१४८) इति तच्छीलादिषु कर्तृषु युच् भवति।]]</li> <li id="foot_krm_0964_12"><a href="#ref_krm_0964_12">↑</a> [[६। ‘नृतिशृध्योः कूः’ [द। उ। १-१७४]</li></ul></p>

