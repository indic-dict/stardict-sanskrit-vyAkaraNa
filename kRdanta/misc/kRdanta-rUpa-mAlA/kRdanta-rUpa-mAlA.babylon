<ul><li><sup id="ref_krm_0827_01"><a href="#foot_krm_0827_01">1</a></sup> {@“दन्श दशने”@} <sup id="ref_krm_0827_02"><a href="#foot_krm_0827_02">2</a></sup> “दशनम् = दंष्ट्राव्यापारः। </li> <li>हनुमूलगताः स्थूलदन्ताः दंष्ट्राः। </li> <li>तद्व्यापारः क्षत- क्रियादिरूप इत्यर्थः।” इति बालमनोरमा। </li> <li>“दंशने दशतीति स्यात् तत्र दंशयते णिचि।। </li> <li>भाषणे दंशयेत् … … …।” <sup id="ref_krm_0827_03"><a href="#foot_krm_0827_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_0827_04"><a href="#foot_krm_0827_04">4</a></sup> दंशकः-शिका, दंशकः-शिका, <sup id="ref_krm_0827_05"><a href="#foot_krm_0827_05">5</a></sup> दिदङ्क्षकः-क्षिका, <sup id="ref_krm_0827_06"><a href="#foot_krm_0827_06">6</a></sup> दन्दशकः-दंदशकः-शिका;</li> <li>  <sup id="ref_krm_0827_07"><a href="#foot_krm_0827_07">7</a></sup> दंष्टा-दंष्ट्री, दंशयिता-त्री, दिदङ्क्षिता-त्री, दन्दशिता-दंदशिता-त्री;</li> <li>  <sup id="ref_krm_0827_08"><a href="#foot_krm_0827_08">8</a></sup> दशन्-न्ती, दंशयन्-न्ती, दिदङ्क्षन्-न्ती;</li> <li>  -- दङ्क्ष्यन्-न्ती-ती, दंशयिष्यन्-न्ती-ती, दिदङ्क्षिष्यन्-न्ती-ती;</li> <li>  -- -- दंशयमानः, दंशयिष्यमाणः, -- दन्दश्यमानः, दन्दशिष्यमाणः;</li> <li>  <sup id="ref_krm_0827_09"><a href="#foot_krm_0827_09">9</a></sup> प्रधट्-प्रधड्-प्रदशौ-प्रदशः;</li> <li>  -- -- दष्टम्-दष्टः-दष्टवान्, दंशितः, दिदङ्क्षितः, दन्दशितः-तवान्;</li> <li>  <sup id="ref_krm_0827_10"><a href="#foot_krm_0827_10">10</a></sup> दंशः, <sup id="ref_krm_0827_11"><a href="#foot_krm_0827_11">11</a></sup> दशनः, <sup id="ref_krm_0827_12"><a href="#foot_krm_0827_12">12</a></sup> वृषदंशः, दंशः, दिदङ्क्षुः, <sup id="ref_krm_0827_13"><a href="#foot_krm_0827_13">13</a></sup> दन्दंशः, <sup id="ref_krm_0827_14"><a href="#foot_krm_0827_14">14</a></sup> दन्दशूकः <sup id="ref_krm_0827_15"><a href="#foot_krm_0827_15">15</a></sup>;</li> <li>  दंष्टव्यम्, दंशयितव्यम्, दिदङ्क्षितव्यम्, दन्दशितव्यम्;</li> <li>  दंशनीयम्, दंशनीयम्, दिदङ्क्षणीयम्, दन्दशनीयम्;</li> <li>  दंश्यम्, दंश्यम्, दिदङ्क्ष्यम्, दन्दश्यम्;</li> <li>  <sup id="ref_krm_0827_16"><a href="#foot_krm_0827_16">16</a></sup> ईषद्दंशः-दुर्दंशः-सुदंशः;</li> <li>  -- -- दश्यमानः, दंश्यमानः, दिदङ्क्ष्यमाणः, दन्दश्यमानः;</li> <li>  दंशः, दंशः, दिदङ्क्षः, दन्दशः;</li> <li>  दंष्टुम्, दंशयितुम्, दिदङ्क्षितुम्, दन्दशितुम्;</li> <li>  <sup id="ref_krm_0827_17"><a href="#foot_krm_0827_17">17</a></sup> दशा-दष्टिः, दंशना, दिदङ्क्षा, दन्दशा;</li> <li>  दंशनम्- <sup id="ref_krm_0827_18"><a href="#foot_krm_0827_18">18</a></sup> दशनम् <sup id="ref_krm_0827_19"><a href="#foot_krm_0827_19">19</a></sup>, <sup id="ref_krm_0827_20"><a href="#foot_krm_0827_20">20</a></sup> दंष्ट्रः-दंष्ट्रा, दंशनम्, दिदङ्क्षणम्, दन्दशनम्;</li> <li>  <sup id="ref_krm_0827_21"><a href="#foot_krm_0827_21">21</a></sup> दष्ट्वा, दंशयित्वा, दिदङ्क्षित्वा, दन्दशित्वा;</li> <li>  विदश्य, विदंश्य, विदिदङ्क्ष्य, प्रदन्दश्य;</li> <li>  <sup id="ref_krm_0827_22"><a href="#foot_krm_0827_22">22</a></sup> मूलकोपदंशम्, मूलकेनोपदंशम्, मूलकेनोपदश्य वा भुङ्क्ते। </li> <li><sup id="ref_krm_0827_23"><a href="#foot_krm_0827_23">23</a></sup> कालखण्डोपदंशम्। </li> <li>दंशम् २ दष्ट्वा २ दंशम् २ दंशयित्वा २ दिदङ्क्षम् २ दिदङ्क्षित्वा २ दन्दशम् २;</li> <li>  दन्दशित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0827_01"><a href="#ref_krm_0827_01">↑</a> (८१७)</li> <li id="foot_krm_0827_02"><a href="#ref_krm_0827_02">↑</a> (१-भ्वादिः-९८९। सक। अनि। पर।)</li> <li id="foot_krm_0827_03"><a href="#ref_krm_0827_03">↑</a> (श्लो। १६४-१६५)</li> <li id="foot_krm_0827_04"><a href="#ref_krm_0827_04">↑</a> [[१। ‘नकारजावनुस्वारपञ्चमौ झलि धातुषु।’ इति वचनात् नोपधोऽयं धातुः। नका- रस्य ‘नश्चापदान्तस्य झलि’ (८-३-२४) इत्यनुस्वारः। एवं सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0827_05"><a href="#ref_krm_0827_05">↑</a> [[२। सनि, ‘व्रश्चंभ्रस्ज--’ (८-२-३६) इत्यादिना शकारस्य षकारे, ‘षढोः कः सि’ (८-२-४१) इति षकारस्य ककारे, षत्वे, अनुस्वारे च रूपमेवम्। एवं सन्नन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0827_06"><a href="#ref_krm_0827_06">↑</a> [[३। ‘लुपसदचरजपजभदहदशगॄभ्यो भावगर्हायाम्’ (३-१-२४) इति भावगर्हायां यङ्। ‘अनिदिताम्--’ (६-४-२४) इति नकारलोपः। ‘जपजभदहदशभञ्जपशां च’ (७-४-८६) इति अभ्यासस्य नुगागमः। ‘स च पदान्तवद्वाच्यः’ (वा। ७-४-८५) इत्यनेन पदान्तवद्भावः। ‘वा पदान्तस्य’ (८-४-५९) इति परसवर्णविकल्पः। एवं यङन्ते सर्वत्र रूपद्वयं ज्ञेयम्।]]</li> <li id="foot_krm_0827_07"><a href="#ref_krm_0827_07">↑</a> [[४। तृचि, शकारस्य ‘व्रश्च--’ (८-२-३६) इत्यादिना षत्वे नकारस्यानुस्वारे, ष्टुत्वे च रूपम्। एवं तव्यदादिष्वपि ज्ञेयम्।]]</li> <li id="foot_krm_0827_08"><a href="#ref_krm_0827_08">↑</a> [[५। शपि, ‘दंशसञ्जस्वञ्जां शपि’ (६-४-२५) इत्युपधानकारस्य लोपः।]]</li> <li id="foot_krm_0827_09"><a href="#ref_krm_0827_09">↑</a> [[६। क्विपि, नकारलोपे, षत्वधत्वजश्त्वचर्त्वविकल्पेषु रूपमेवं भवति।]]</li> <li id="foot_krm_0827_10"><a href="#ref_krm_0827_10">↑</a> [पृष्ठम्०७१९+ ३१]</li> <li id="foot_krm_0827_11"><a href="#ref_krm_0827_11">↑</a> [[१। ‘कृत्यल्युटो बहुलम्’ (३-३-११३) इति बाहुलकात् कर्तरि ल्युट्। यद्वा, नन्द्या- देराकृतिगणत्वात् (३-१-१३४) कर्तरि ल्युः। ‘दंशदशने’ इति धातुपाठनिर्देशात्, ‘दाम्नीशस--’ (३-२-१८२) इत्यत्र दश इति नकारलोपघटितत्वेन च निर्देशाद्वा क्ङिद्भिन्नप्रत्ययेऽपि क्वचिन्नलोपो भवतीति ज्ञायते। अतः पृषोदरादित्वात् (६-३-११०) नकारलोपो भवति।]]</li> <li id="foot_krm_0827_12"><a href="#ref_krm_0827_12">↑</a> [[२। वृषं दशतीति वृषदंशः = मार्जारः। ‘कर्मण्यण्’ (३-२-१) इत्यण्।]]</li> <li id="foot_krm_0827_13"><a href="#ref_krm_0827_13">↑</a> [[३। यङ्न्तात् पचाद्यचि, यङो लुकि, उपधानकारलोपाभावे रूपमेवम्।]]</li> <li id="foot_krm_0827_14"><a href="#ref_krm_0827_14">↑</a> [[४। ‘वाऽसरूपोऽस्त्रियाम्’ (३-१-९४) इत्यनेन असरूपापवादप्रत्ययत्वात् उत्सर्गस्य वा बाधकः, यङन्तात् ‘यजजपदशां यङः’ (३-२-१६६) इत्यूकप्रत्ययः। दन्द- शूकः = सर्पः।]]</li> <li id="foot_krm_0827_15"><a href="#ref_krm_0827_15">↑</a> [[आ। ‘भयविह्वलमाशु दन्दशूकैर्विवशैराविविशे स्वमेव धाम।।’ शि। व। २०। ५८।]]</li> <li id="foot_krm_0827_16"><a href="#ref_krm_0827_16">↑</a> [[५। ‘ईषद्दुःसुषु कृच्छ्राकृच्छ्रार्थेषु खल्’ (३-३-१२६) इति खल्। ‘इह सामान्योक्तावपि योग्यताबलादयं विषयविभागो लभ्यते--कृच्छ्रार्थे दुरि, अकृच्छ्रे इतरयोः इति।’ इति बृहच्छब्देन्दुशेखरे।]]</li> <li id="foot_krm_0827_17"><a href="#ref_krm_0827_17">↑</a> [[६। भिदादेराकृतिगणत्वेन, तत्र (३-३-१०४) पाठादङि, उपधानकारलोपे दशा इति क्षीरतरङ्गिणी। दशा = वर्तिरवस्था वस्त्रान्तावयवश्च। भिदादिष्वस्यादर्शनात् क्तिनि--दष्टिरिति रूपमिति बोध्यम्।]]</li> <li id="foot_krm_0827_18"><a href="#ref_krm_0827_18">↑</a> [[७। करणे ल्युटि, ‘दंश दशने’ इति धातुपाठबलात् नकारलोपे रूपमेवम्। ‘दंशेः करणे ल्युटि नलोपो वाच्यः’ इति नलोपः।’ इति धा। का। व्याख्याने (२-४०) दृश्यते। तादृशं वचनं तु भाष्यादौ न दृश्यते।]]</li> <li id="foot_krm_0827_19"><a href="#ref_krm_0827_19">↑</a> [[B। ‘कृत्वा स कृत्यं दशनांशुगौरं कृष्णं ययौ दैत्यनिदाघमेघम्।।’ धा। का। २। ४०।]]</li> <li id="foot_krm_0827_20"><a href="#ref_krm_0827_20">↑</a> [[८। ‘दाम्नीशसयुयुजस्तुतुदसिसिचमिहपतदशनहः करणे’ (३-२-१८२) इति करणे ष्ट्रन् प्रत्ययः। प्रत्ययस्य षित्त्वेऽपि अजादिषु (४-१-४) पाठात् टाबेव। न ङीष्।]]</li> <li id="foot_krm_0827_21"><a href="#ref_krm_0827_21">↑</a> [पृष्ठम्०७२०+ २३]</li> <li id="foot_krm_0827_22"><a href="#ref_krm_0827_22">↑</a> [[१। ‘उपदंशस्तृतीयायाम्’ (३-४-४७) इति णमुल्। ‘तृतीयाप्रभृतीन्यन्यतरस्याम्’ (२-२-२१) इति समासविकल्पः। वाऽसरूपन्यायेन क्त्वाऽपि भवति। तेन मूल- केनोपदश्य इत्यपि साधुः।]]</li> <li id="foot_krm_0827_23"><a href="#ref_krm_0827_23">↑</a> [[आ। ‘स्वादुङ्कारं कालखण्डोपदंशं क्रोष्टा डिम्भं व्यष्त्रणद् व्यस्वनच्च।।’ शि। व। १८। ७७।]]</li></ul></p>

दभ|दाभकः-भिका|दिदभिषकः-षिका|दादभकः-भिका
<ul><li><sup id="ref_krm_0828_01"><a href="#foot_krm_0828_01">1</a></sup> {@“दभ हिंसायाम्”@} <sup id="ref_krm_0828_02"><a href="#foot_krm_0828_02">2</a></sup> अयं धातुपाठेष्वपठितोऽपि ‘लपिदभिभ्यां च’ <sup id="ref_krm_0828_03"><a href="#foot_krm_0828_03">3</a></sup> इति वार्तिकबलात्, <sup id="ref_krm_0828_04"><a href="#foot_krm_0828_04">4</a></sup> इति वचनात् अवधीरयत्यादिवत्) बोध्यः। </li> <li>अदुपधत्वेन पवर्गान्तत्वेन च ‘पोरदुपधात्’ <sup id="ref_krm_0828_05"><a href="#foot_krm_0828_05">5</a></sup> इति प्राप्तं यत्प्रत्ययं बाधित्वा ‘लपिदभिभ्यां च’ <sup id="ref_krm_0828_06"><a href="#foot_krm_0828_06">6</a></sup> इति वचनात् ण्यत्। </li> <li>अवदाभ्यः = हिंस्य इत्यर्थः। </li> <li>‘विष्णुर्गोपा अदाभ्यः’ <sup id="ref_krm_0828_07"><a href="#foot_krm_0828_07">7</a></sup> ‘न ता नशन्ति न दभाति तस्करः’ <sup id="ref_krm_0828_08"><a href="#foot_krm_0828_08">8</a></sup> इत्यादिप्रयोगा इहानुसन्धेयाः। </li> <li>‘न दभाती’त्यत्र, ‘न हिनस्ति’ इति सायणभाष्ये विवृतम्। </li> <li>अत एव धातोर्हिंसार्थकत्वमपि प्रतीयते। </li> <li>दभातीति शपू। </li> <li>‘अन्येषामपि दृश्यते’ <sup id="ref_krm_0828_09"><a href="#foot_krm_0828_09">9</a></sup> इति दीर्घः। </li> <li>‘शेषात् कर्तरि--’ <sup id="ref_krm_0828_10"><a href="#foot_krm_0828_10">10</a></sup> इति परस्मैपदम्। </li> <li>हिंसार्थकत्वात् सकर्मकत्वम्। </li> <li>‘दभिः सौत्रो धातुः वञ्चने हिंसायां च’ इति प्रक्रियासर्वस्वे। </li> <li>अंशुः, अदाभ्यः इति सोमरसग्रहपात्रे। </li> <li>‘अदाभ्यं गृह्णीत’ इति वचनमत्र ध्येयम्। </li> <li>दाभकः-भिका, दाभकः-भिका, दिदभिषकः-षिका, दादभकः-भिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककखतिवत् <sup id="ref_krm_0828_11"><a href="#foot_krm_0828_11">11</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0828_12"><a href="#foot_krm_0828_12">12</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0828_01"><a href="#ref_krm_0828_01">↑</a> (८१८)</li> <li id="foot_krm_0828_02"><a href="#ref_krm_0828_02">↑</a> (१-भ्वादिः। सक। सेट्। पर।)</li> <li id="foot_krm_0828_03"><a href="#ref_krm_0828_03">↑</a> (वा। ३-१-१२४)</li> <li id="foot_krm_0828_04"><a href="#ref_krm_0828_04">↑</a> (चुरादिषु ‘बहुलम्, एतन्निदर्शनम्’ (गणसूत्रम्)</li> <li id="foot_krm_0828_05"><a href="#ref_krm_0828_05">↑</a> (३-१-९८)</li> <li id="foot_krm_0828_06"><a href="#ref_krm_0828_06">↑</a> (वा। ३-१-१२४)</li> <li id="foot_krm_0828_07"><a href="#ref_krm_0828_07">↑</a> (ऋग्वेदे विष्णुसूक्ते)</li> <li id="foot_krm_0828_08"><a href="#ref_krm_0828_08">↑</a> (ऋग्वेदे ६-२८-३)</li> <li id="foot_krm_0828_09"><a href="#ref_krm_0828_09">↑</a> (६-३-१३७)</li> <li id="foot_krm_0828_10"><a href="#ref_krm_0828_10">↑</a> (१-३-७८)</li> <li id="foot_krm_0828_11"><a href="#ref_krm_0828_11">↑</a> (१४१)</li> <li id="foot_krm_0828_12"><a href="#ref_krm_0828_12">↑</a> [पृष्ठम्०७२१+ ३०]</li></ul></p>

