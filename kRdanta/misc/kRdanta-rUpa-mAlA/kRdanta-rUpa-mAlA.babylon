<ul><li><sup id="ref_krm_0294_01"><a href="#foot_krm_0294_01">1</a></sup> {@“क्लिश उपतापे”@} <sup id="ref_krm_0294_02"><a href="#foot_krm_0294_02">2</a></sup> ‘व्यक्तोक्तौ क्लेशते क्लेशेः, क्लिश्नाति तु विबाधने। </li> <li>दिवादेरुपतापेऽर्थे तङि स्यात् क्लिश्यते पदम्।।’ <sup id="ref_krm_0294_03"><a href="#foot_krm_0294_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_0294_04"><a href="#foot_krm_0294_04">4</a></sup> क्लेशकः-शिका, क्लेशकः-शिका, <sup id="ref_krm_0294_05"><a href="#foot_krm_0294_05">5</a></sup> चिक्लिशिषकः-चिक्लेशिषकः-षिका, चेक्लिशकः-शिका;</li> <li>  क्लेशिता-त्री, क्लेशयिता-त्री, चिक्लिशिषिता-चिक्लेशिषिता-त्री, चेक्लिशिता-त्री;</li> <li>  -- क्लेशयन्-न्ती, क्लेशयिष्यन्-न्ती-ती;</li> <li>  -- -- <sup id="ref_krm_0294_06"><a href="#foot_krm_0294_06">6</a></sup> क्लिश्यमानः, क्लेशयमानः, चिक्लिशिषमाणः-चिक्लेशिषमाणः, चेक्लिश्यमानः;</li> <li>  क्लेशिष्यमाणः, क्लेशयिष्यमाणः, चिक्लिशिषिष्यमाणः-चिक्लेशिषिष्यमाणः, चेक्लिशिष्यमाणः;</li> <li>  <sup id="ref_krm_0294_07"><a href="#foot_krm_0294_07">7</a></sup> क्लिट्-क्लिशौ-क्लिशः;</li> <li>  -- -- -- <sup id="ref_krm_0294_08"><a href="#foot_krm_0294_08">8</a></sup> क्लिशितः- <sup id="ref_krm_0294_09"><a href="#foot_krm_0294_09">9</a></sup> तम्-तवान्, क्लिष्टम्-ष्टः-ष्टवान्, क्लेशितः-तम्, चिक्लिशिषितः-चिक्लेशिषितः, चेक्लिशितः-तवान्;</li> <li>  क्लिशः, <sup id="ref_krm_0294_10"><a href="#foot_krm_0294_10">10</a></sup> क्लेशनः, <sup id="ref_krm_0294_11"><a href="#foot_krm_0294_11">11</a></sup> क्लेशकः, क्लेशः, चिक्लिशिषुः-चिक्लेशिषुः, चेक्लिशः;</li> <li>  क्लेशितव्यम्, क्लेशयितव्यम्, चिक्लिशिषितव्यम्-चिक्लेशिषितव्यम्, चेक्लिशितव्यम्;</li> <li>  क्लेशनीयम्, क्लेशनीयम्, चिक्लिशिषणीयम्-चिक्लेशिषणीयम्, चेक्लिशनीयम्;</li> <li>  <sup id="ref_krm_0294_12"><a href="#foot_krm_0294_12">12</a></sup> क्लेश्यम्, क्लेश्यम्, चिक्लिशिष्यम्-चिक्लेशिष्यम्, चेक्लिश्यम्;</li> <li>  ईषत्क्लेशः-दुष्क्लेशः-सुक्लेशः;</li> <li>  -- -- -- क्लिश्यमानः, क्लेश्यमानः, चिक्लिशिष्यमाणः-चिक्लेशिष्यमाणः, चेक्लिश्यमानः;</li> <li>  <sup id="ref_krm_0294_13"><a href="#foot_krm_0294_13">13</a></sup> क्लेशः, क्लेशः, चिक्लिशिषः-चिक्लेशिषः, चेक्लिशः;</li> <li>  क्लेशितुम्, क्लेशयितुम्, चिक्लिशिषितुम्-चिक्लेशिषितुम्, चेक्लिशितुम्। </li> <li><sup id="ref_krm_0294_14"><a href="#foot_krm_0294_14">14</a></sup> क्लिष्टिः, केशना, चिक्लिशिषा-चिक्लेशिषा, चेक्लिशा;</li> <li>  <sup id="ref_krm_0294_15"><a href="#foot_krm_0294_15">15</a></sup> क्लिशित्वा <sup id="ref_krm_0294_16"><a href="#foot_krm_0294_16">16</a></sup> -क्लिष्ट्वा, क्लेशयित्वा, चिक्लिशिषित्वा-चिक्लेशिषित्वा, चेक्लिशित्वा;</li> <li>  विक्लिश्य, विक्लेश्य, विचिक्लिशिष्य-विचिक्लेशिष्य, विचेक्लिश्य;</li> <li>  क्लेशम् २, क्लिशित्वा२-क्लिष्ट्वा २, क्लेशम् २, क्लेशयित्वा २, चिक्लिशिषम् २- चिक्लेशिषम् २, चिक्लिशिषित्वा २- चिक्लेशिषित्वा २, चेक्लिशम् २;</li> <li>  चेक्लिशित्वा २। <sup id="ref_krm_0294_17"><a href="#foot_krm_0294_17">17</a></sup> कीनाशः,</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0294_01"><a href="#ref_krm_0294_01">↑</a> (२८७)</li> <li id="foot_krm_0294_02"><a href="#ref_krm_0294_02">↑</a> (४-दिवादिः-११६१। अक। सेट्। आत्म।)</li> <li id="foot_krm_0294_03"><a href="#ref_krm_0294_03">↑</a> (श्लो। १६३-४)</li> <li id="foot_krm_0294_04"><a href="#ref_krm_0294_04">↑</a> [पृष्ठम्०२९८+ २०]</li> <li id="foot_krm_0294_05"><a href="#ref_krm_0294_05">↑</a> [[१। ‘रलो व्युपधाद्धलादेस्संश्च’ (१-२-२६) इति सनः कित्त्वविकल्पाद्रूपद्वयम्।]]</li> <li id="foot_krm_0294_06"><a href="#ref_krm_0294_06">↑</a> [[२। ‘दिवादिभ्यः श्यन्’ (३-१-६९) इति श्यन्। श्यनो ङिद्वद्भावादङ्गस्य गुणो न।]]</li> <li id="foot_krm_0294_07"><a href="#ref_krm_0294_07">↑</a> [[३। ‘व्रश्च भ्रस्ज--’ (८-२-३६) इत्यादिना षत्वे, चश्त्वे चर्त्वम्।]]</li> <li id="foot_krm_0294_08"><a href="#ref_krm_0294_08">↑</a> [[४। ‘क्लिशः क्त्वानिष्ठयोः’ (७-२-५०) इति इड्विकल्पः।]]</li> <li id="foot_krm_0294_09"><a href="#ref_krm_0294_09">↑</a> [[आ। ‘मायाभिस्सुचिरं क्लिष्टवा राक्षसोऽक्लिशितक्रियम्।’ भ। का। ९। ३८।]]</li> <li id="foot_krm_0294_10"><a href="#ref_krm_0294_10">↑</a> [[५। ‘अनुदात्तेतश्च हलादेः’ (३-२-१४९) इति युचू ताच्छीलिकः।]]</li> <li id="foot_krm_0294_11"><a href="#ref_krm_0294_11">↑</a> [[६। ‘निन्दहिंसक्लिशखाद--’ (३-२-१४६) इत्यादिना वुञ् ताच्छीलिकः।]]</li> <li id="foot_krm_0294_12"><a href="#ref_krm_0294_12">↑</a> [[B। ‘अक्लेश्यमसिनाऽग्न्यन्तं कबन्धवधमभ्यधुः।’ भ। का। ७-७८।]]</li> <li id="foot_krm_0294_13"><a href="#ref_krm_0294_13">↑</a> [[C। ‘देवौघस्य तपन् भुवं च पतिता वावृत्तभूमाऽप्यसौ वृत्तक्लेशलबैरकाश्यत समं संवाश्यमानैस्स्वकैः।।’ धा। का। २-६०।]]</li> <li id="foot_krm_0294_14"><a href="#ref_krm_0294_14">↑</a> [पृष्ठम्०२९९+ २२]</li> <li id="foot_krm_0294_15"><a href="#ref_krm_0294_15">↑</a> [[आ। ‘अमृडित्वा सहस्राक्षं क्लिशित्वा कौशलैर्निजैः।’ भ। का। ७। ९६।]]</li> <li id="foot_krm_0294_16"><a href="#ref_krm_0294_16">↑</a> [[१। ‘क्लिशः क्त्वानिष्ठयोः’ (७-२-५०) इति वेट्। इट्पक्षे ‘मृडमृद--’ (१-२-७) इत्यादिना नित्यकित्त्वम्।]]</li> <li id="foot_krm_0294_17"><a href="#ref_krm_0294_17">↑</a> [[२। ‘क्लिशेरीच्चोपधायाः कन् लोपश्च लोनाम्’ (द। उ। ९। १।) इति कन्प्रत्यये कीनाशः = कदर्यो जनः।]]</li></ul></p>

