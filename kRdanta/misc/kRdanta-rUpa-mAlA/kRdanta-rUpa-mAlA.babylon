<ul><li><sup id="ref_krm_1065_01"><a href="#foot_krm_1065_01">1</a></sup> {@“पॄ पालनपूरणयोः”@} <sup id="ref_krm_1065_02"><a href="#foot_krm_1065_02">2</a></sup> ‘पृणाति पूरणे, श्लौ तु पिपर्ति, णिचि पारयेत्।।’ <sup id="ref_krm_1065_03"><a href="#foot_krm_1065_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_1065_04"><a href="#foot_krm_1065_04">4</a></sup> <sup id="ref_krm_1065_05"><a href="#foot_krm_1065_05">5</a></sup> पारकः-रिका, पारकः-रिका, <sup id="ref_krm_1065_06"><a href="#foot_krm_1065_06">6</a></sup> पुपूर्षकः-पिपरिषकः-पिपरीषकः-षिका, <sup id="ref_krm_1065_07"><a href="#foot_krm_1065_07">7</a></sup> पोपुरकः-रिका;</li> <li>  परिता-परीता-त्री, पारयिता-त्री, पुपूर्षिता-पिपरिषिता-पिपरीषिता-त्री, पोपुरिता-त्री;</li> <li>  <sup id="ref_krm_1065_08"><a href="#foot_krm_1065_08">8</a></sup> पिपुरत्-पिपुरतौ-पिपुरतः, पारयन्-न्ती, पुपूर्षन्-पिपरिषन्-पिपरीषन्-न्ती;</li> <li>  -- परिष्यन्-परीष्यन्-न्ती-ती, पारयिष्यन्-न्ती-ती, पुपूर्षिष्यन्-पिपरिषिष्यन्- पिपरीषिष्यन्-न्ती-ती;</li> <li>  -- -- पारयमाणः, -- पोपूर्यमाणः;</li> <li>  -- पारयिष्यमाणः, -- पोपुरिष्यमाणः;</li> <li>  पूः-पुरौ-पुरः;</li> <li>  -- -- -- <sup id="ref_krm_1065_09"><a href="#foot_krm_1065_09">9</a></sup> पूर्तम्-पूर्तवान्, पारितः, पुपूर्षितः-पिपरिषितः-पिपरीषितः, पोपुरितः-तवान्;</li> <li>  परः- <sup id="ref_krm_1065_10"><a href="#foot_krm_1065_10">10</a></sup> पूः <sup id="ref_krm_1065_11"><a href="#foot_krm_1065_11">11</a></sup> <sup id="ref_krm_1065_12"><a href="#foot_krm_1065_12">12</a></sup> पारयः, <sup id="ref_krm_1065_13"><a href="#foot_krm_1065_13">13</a></sup> पारयिष्णुः, पुपूर्षुः-पिपरिषुः-पिपरीषुः, पोपुरः;</li> <li>  <sup id="ref_krm_1065_14"><a href="#foot_krm_1065_14">14</a></sup> परितव्यम्-परीतव्यम्, पारयितव्यम्, पुपूर्षितव्यम्-पिपरिषितव्यम्-पिपरीषितव्यम्, पोपुरितव्यम्;</li> <li>  परणीयम्, पारणीयम्, पुपूर्षणीयम्, पिपरिषणीयम्-पिपरीषणीयम्, पोपुरणीयम्;</li> <li>  पार्यम्, पार्यम्, पुपूर्ष्यम्-पिपरिष्यम्-पिपरीष्यम्, पोपूर्यम्;</li> <li>  ईषत्परः-दुष्परः-सुपरः;</li> <li>  -- -- <sup id="ref_krm_1065_15"><a href="#foot_krm_1065_15">15</a></sup> पूर्यमाणः, पार्यमाणः, पुपूर्ष्यमाणः-पिपरिष्यमाणः-पिपरीष्यमाणः, पोपूर्यमाणः;</li> <li>  परः, पारः, पुपूर्षः-पिपरिषः-पिपरीषः, पोपुरः;</li> <li>  परितुम्-परीतुम्, पारयितुम्, पुपूर्षितुम्-पिपरिषितुम्-पिपरीषितुम्, पोपुरितुम्;</li> <li>  पूर्तिः- <sup id="ref_krm_1065_16"><a href="#foot_krm_1065_16">16</a></sup> पूर्णिः, पारणा, पुपूर्षा-पिपरिषा-पिपरीषा, पोपुरा;</li> <li>  परणम्, पारणम्, पुपूर्षणम्-पिपरिषणम्-पिपरीषणम्, पोपुरणम्;</li> <li>  पूर्त्वा, पारयित्वा, पुपूर्षित्वा-पिपरिषित्वा-पिपरीषित्वा, पोपुरित्वा;</li> <li>  प्रपूर्य, प्रपार्य, प्रपुपूर्ष्य-प्रपिपरिष्य प्रपिपरीष्य, प्रपोपूर्य;</li> <li>  पारम् २, पूर्त्वा २, पारम् २, पारयित्वा २, पुपूर्षम् २ -पिपरिषम् २ -पिपरीषम् २, पुपूर्षित्वा २ -पिपरिषित्वा २ -पिपरीषित्वा २, पोपुरम् २;</li> <li>  पोपुरित्वा २;</li> <li>  <sup id="ref_krm_1065_17"><a href="#foot_krm_1065_17">17</a></sup> पुरुः, <sup id="ref_krm_1065_18"><a href="#foot_krm_1065_18">18</a></sup> पर्व, <sup id="ref_krm_1065_19"><a href="#foot_krm_1065_19">19</a></sup> पुरीषम्, <sup id="ref_krm_1065_20"><a href="#foot_krm_1065_20">20</a></sup> पुरुषः, <sup id="ref_krm_1065_21"><a href="#foot_krm_1065_21">21</a></sup> परुषः, <sup id="ref_krm_1065_22"><a href="#foot_krm_1065_22">22</a></sup> परुः। </li> <li><sup id="ref_krm_1065_23"><a href="#foot_krm_1065_23">23</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1065_01"><a href="#ref_krm_1065_01">↑</a> (१०५५)</li> <li id="foot_krm_1065_02"><a href="#ref_krm_1065_02">↑</a> (३-जुहोत्यादिः-१०८६। सक। सेट्। पर।)</li> <li id="foot_krm_1065_03"><a href="#ref_krm_1065_03">↑</a> (श्लो। ३६)</li> <li id="foot_krm_1065_04"><a href="#ref_krm_1065_04">↑</a> [पृष्ठम्०८९१+ २८]</li> <li id="foot_krm_1065_05"><a href="#ref_krm_1065_05">↑</a> [[१। ‘इत्वोत्वाभ्यां गुणवृद्धी भवतो विप्रतिषेधेन’ (वा। ७-१-१०२) इति वचनेन वृद्धिरत्र ज्ञेया। एवं तव्यदादिषु गुणोऽपि ज्ञेयः।]]</li> <li id="foot_krm_1065_06"><a href="#ref_krm_1065_06">↑</a> [[२। सन्नन्ते सर्वत्र, ‘इको झल्’ (१-२-९) इति सनः कित्त्वे, ‘श्र्युकः क्किति’ (७-२-११) इति प्राप्तमिण्निषेधं बाधित्वा, ‘इट् सनि वा’ (७-२-४१) इतीड्विकल्पः। इट्पक्षे ‘उदोष्ठ्यपूर्वस्य’ (७-१-१०२) इत्युत्त्वे रपरत्वे, ‘हलि च’ (८-२-७७) इति दीर्घे च रूपमेवम्। इडभावपक्षे ‘वॄतो वा’ (७-२-३८) इति इटो दीर्घविकल्पे रूपद्वयम्। तत्र सनः कित्त्वाभावाद् गुणः, अभ्यासे इकारश्चेति ज्ञेयम्। आहत्य रूपत्रयमिति बोध्यम्।]]</li> <li id="foot_krm_1065_07"><a href="#ref_krm_1065_07">↑</a> [[३। यङन्ते सर्वत्र, उत्वरपरत्वाल्लोपयलोपेषु अभ्यासे, ‘गुणो यङ्लुकोः’ (७-४-८२) इति गुणो ज्ञेयः।]]</li> <li id="foot_krm_1065_08"><a href="#ref_krm_1065_08">↑</a> [[४। शतरि, ‘जुहोत्यादिभ्यः--’ (२-४-७५) इति शपः श्लौ, ‘श्लौ’ (६-१-१०) इति द्विर्वचने, श्लोः शित्त्वेन सार्वधातुकत्वात् धातोरुत्वे रपरत्वे, ‘अर्ति- पिपर्त्योश्च’ (७-४-७७) इत्यभ्यासेकारः।]]</li> <li id="foot_krm_1065_09"><a href="#ref_krm_1065_09">↑</a> [[५। ‘श्र्युकः क्किति’ (७-२-११) इति इण्निषेधे, उत्वादिकम्।]]</li> <li id="foot_krm_1065_10"><a href="#ref_krm_1065_10">↑</a> [[६। तच्छीलादिषु कर्तृषु ‘भ्राजभासधुर्विद्युतोर्जिपॄ--’ (३-२-१७७) इति क्विपि उत्वादिषु प्रवृत्तेषु रेफस्य विसर्गे रूपम्।]]</li> <li id="foot_krm_1065_11"><a href="#ref_krm_1065_11">↑</a> [[आ। ‘रथस्य तस्यां पुरि दत्तचक्षुः विद्वान् विदामास शनैर्न यातम्।।’ शि। व। ३। ३२।]]</li> <li id="foot_krm_1065_12"><a href="#ref_krm_1065_12">↑</a> [[७। ण्यन्तादस्मात् ‘अनुपसर्गाल्लिम्पविन्दधारिपारि--’ (३-१-१३८) इति कर्तरि शप्रत्यये तस्य शित्त्वेन सार्वधातुकत्वात् शपि, पररूपे, अयादेशे च रूपम्।]]</li> <li id="foot_krm_1065_13"><a href="#ref_krm_1065_13">↑</a> [[८। ‘णेश्छन्दसि’ (३-२-१३७) इति इष्णुच्प्रत्यये, ‘अयामन्ताल्वाय्येत्न्विष्णुषु’ (६-४-५५) इति णेरयादेशः।]]</li> <li id="foot_krm_1065_14"><a href="#ref_krm_1065_14">↑</a> [पृष्ठम्०८९२+ २४]</li> <li id="foot_krm_1065_15"><a href="#ref_krm_1065_15">↑</a> [[१। यकः कित्त्वेन उत्वरपरत्वादिकं ज्ञेयम्।]]</li> <li id="foot_krm_1065_16"><a href="#ref_krm_1065_16">↑</a> [[२। ‘ॠल्वादिभ्यः क्तिन् निष्ठावद् वाच्यः’ (वा। ८-२-४४) इति नकारे, णत्वम्। एतच्च पाक्षिकमिति केचित्।]]</li> <li id="foot_krm_1065_17"><a href="#ref_krm_1065_17">↑</a> [[३। ‘पॄभि--’ (द। उ। १-१०८) इति कुप्रत्ययः। पृणाति, पूर्यते वा इति पुरुः = विस्तीर्णः, लोकश्च।]]</li> <li id="foot_krm_1065_18"><a href="#ref_krm_1065_18">↑</a> [[४। ‘स्नामदिपद्यर्तिपॄ--’ (द। उ। ६-६८) इति वनिप्प्रत्ययः। पृणाति, पिपर्ति पूर्यते वा इति पर्व = अङ्गुल्यग्रम्, पुण्यतिथिश्च।]]</li> <li id="foot_krm_1065_19"><a href="#ref_krm_1065_19">↑</a> [[५। ‘शॄपॄभ्यां कित्’ (द। उ। ९-१०) इतीषन्प्रत्ययः, तस्य कित्त्वं च। पृणाति, पूर्यते वा तेनोदरमिति पुरीषम्।]]</li> <li id="foot_krm_1065_20"><a href="#ref_krm_1065_20">↑</a> [[६। ‘पुरः कुषन्’ (द। उ। ९-१४) इत्यनेन कुषन्प्रत्यये, उत्वादिकम्।]]</li> <li id="foot_krm_1065_21"><a href="#ref_krm_1065_21">↑</a> [[७। ‘पॄकलिभ्यामुषच्’ (द। उ। ९-१५) इत्युषच्प्रत्ययः। पृणाति, पिपर्ति इति वा परुषः = अमृदुः।]]</li> <li id="foot_krm_1065_22"><a href="#ref_krm_1065_22">↑</a> [[८। ‘अर्तिपॄवपि--’ (द। उ। ९-३९) इत्युसिप्रत्ययः। परुः = समुद्रः, राजा च।]]</li> <li id="foot_krm_1065_23"><a href="#ref_krm_1065_23">↑</a> [पृष्ठम्०८९३+ २९]</li></ul></p>

पॄ|पारकः-रिका|पुपूर्षकः-र्षिका|पिपरीषकः-पिपरिषकः-षिका|पोपुरकः-रिका
<ul><li><sup id="ref_krm_1066_01"><a href="#foot_krm_1066_01">1</a></sup> {@“पॄ पालनपूरणयोः”@} <sup id="ref_krm_1066_02"><a href="#foot_krm_1066_02">2</a></sup> प्वादिः, ल्वादिश्च। </li> <li>‘पृणाति पूरणे श्लौ तु पिपर्ति, णिचि पारयेत्।।’ <sup id="ref_krm_1066_03"><a href="#foot_krm_1066_03">3</a></sup> इति देवः। </li> <li>पारकः-रिका, पारकः-रिका, पुपूर्षकः-र्षिका, पिपरीषकः-पिपरिषकः-षिका, पोपुरकः-रिका;</li> <li>  <sup id="ref_krm_1066_04"><a href="#foot_krm_1066_04">4</a></sup> पारयः <sup id="ref_krm_1066_05"><a href="#foot_krm_1066_05">5</a></sup> , <sup id="ref_krm_1066_06"><a href="#foot_krm_1066_06">6</a></sup> पृणन्-ती, इत्यादीनि सर्वाण्यपि रूपाणि जौहोत्यादिकपिपर्तिवत् <sup id="ref_krm_1066_07"><a href="#foot_krm_1066_07">7</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1066_08"><a href="#foot_krm_1066_08">8</a></sup> पूर्तम् <sup id="ref_krm_1066_09"><a href="#foot_krm_1066_09">9</a></sup> -पूर्तः-पूर्तवान्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1066_01"><a href="#ref_krm_1066_01">↑</a> (१०५६)</li> <li id="foot_krm_1066_02"><a href="#ref_krm_1066_02">↑</a> (९-क्र्यादिः-१४८९। सक। सेट्। पर।)</li> <li id="foot_krm_1066_03"><a href="#ref_krm_1066_03">↑</a> (श्लो। ३६)</li> <li id="foot_krm_1066_04"><a href="#ref_krm_1066_04">↑</a> [[१। ‘अनुपसर्गाल्लिम्पविन्दधारिपारि--’ (३-१-१३८) इति ण्यन्तादस्मात् कर्तरि शप्रत्यये, शपि, पररूपे, णेरयादेशे च रूपम्।]]</li> <li id="foot_krm_1066_05"><a href="#ref_krm_1066_05">↑</a> [[आ। ‘धारयैः कुसुमोर्मीणां पारयैः बाधितुं जनान्।’ भ। का। ६। ७९।]]</li> <li id="foot_krm_1066_06"><a href="#ref_krm_1066_06">↑</a> [[२। शतरि, ‘क्र्यादिभ्यः-- (३-१-८१) इति श्ना विकरणप्रत्ययः। ‘प्वादीनां ह्रस्वः’ (७-३-८०) इति शिति परे ह्रस्वः। ‘ऋवर्णान्नस्य णत्वं वाच्यम्’ (वा। ८-४-१) इति णत्वम्।]]</li> <li id="foot_krm_1066_07"><a href="#ref_krm_1066_07">↑</a> (१०५५)</li> <li id="foot_krm_1066_08"><a href="#ref_krm_1066_08">↑</a> [[३। ‘न ध्याख्यापॄमूर्च्छिमदाम्’ (८-२-५७) इति निष्ठानत्वनिषेधः।]]</li> <li id="foot_krm_1066_09"><a href="#ref_krm_1066_09">↑</a> [[B। ‘नागं ददर्श पटबूर्णमुखं धुनानं कर्णौ शृणन्तमखिलान् अभिपूर्तरोषम्।।’ धा। का। ३। ६।]]</li></ul></p>

पॄ|पारकः-रिका|पिपारयिषकः-षिका|पुपूर्षकः-र्षिका|पिपरीषकः-पिपरिषकः-षिका|पोपुरकः-रिका|ण्यन्तात्|सनि-पिपारयिषिता-त्री|पिपारयिषन्-न्ती|पिपारयिषिष्यन्-|न्ती-ती
<ul><li><sup id="ref_krm_1067_01"><a href="#foot_krm_1067_01">1</a></sup> {@“पॄ पूरणे”@} <sup id="ref_krm_1067_02"><a href="#foot_krm_1067_02">2</a></sup> ‘पृणाति पूरणे, श्लौ तु पिपर्त्ति, णिचि पारयेत्।।’ <sup id="ref_krm_1067_03"><a href="#foot_krm_1067_03">3</a></sup> इति देवः। </li> <li>पारकः-रिका, पिपारयिषकः-षिका, पारकः-रिका, पुपूर्षकः-र्षिका, पिपरीषकः-पिपरिषकः-षिका, पोपुरकः-रिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि ण्यन्तात्, ण्यन्तप्रकृतिकसन्नन्तात् शुद्धात् तदुपरि सन्नन्तात् यङन्ताच्च यथायथं जौहोत्यादिकपृधातुवत् <sup id="ref_krm_1067_04"><a href="#foot_krm_1067_04">4</a></sup> बोध्यानि। </li> <li>ण्यन्तात् सनि--पिपारयिषिता-त्री, पिपारयिषन्-न्ती, पिपारयिषिष्यन्- न्ती-ती;</li> <li>  पिपारयिषमाणः, पिपारयिषिष्यमाणः, पिपारयिट्-यिषौ-यिषः, पिपारयिषितम्-तः-तवान्, पिपारयिषुः, पिपारयिषितव्यम्, पिपारयिषणीयम्, पिपारयिष्यम्, ईषत्पिपारयिषः-दुष्पिपारयिषः-सुपिपारयिषः, पिपारयिष्यमाणः, पिपारयिषः, पिपारयिषितुम्, पिपारयिषा, पिपारयिषणम्, पिपारयिषित्वा, प्रपिपारयिष्य, पिपारयिषम् २-पिपारयिषित्वा २, इतीमानि रूपाणीति विशेषः। </li> <li>णिजभावपक्षे शुद्धात् शतरि-परन्-न्ती, परिष्यन्-न्ती-ती इति रूपाणीति विशेषः। </li> <li><sup id="ref_krm_1067_05"><a href="#foot_krm_1067_05">5</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1067_01"><a href="#ref_krm_1067_01">↑</a> (१०५७)</li> <li id="foot_krm_1067_02"><a href="#ref_krm_1067_02">↑</a> (१०-चुरादिः-१५४८। सक। सेट्। उभ।)</li> <li id="foot_krm_1067_03"><a href="#ref_krm_1067_03">↑</a> (श्लो। ३६)</li> <li id="foot_krm_1067_04"><a href="#ref_krm_1067_04">↑</a> (१०५२)</li> <li id="foot_krm_1067_05"><a href="#ref_krm_1067_05">↑</a> [पृष्ठम्०८९४+ २७]</li></ul></p>

पेलृ|पेलकः-लिका|पिपेलिषकः-षिका|पेपेलकः-लिका
<ul><li><sup id="ref_krm_1068_01"><a href="#foot_krm_1068_01">1</a></sup> {@“पेलृ गतौ”@} <sup id="ref_krm_1068_02"><a href="#foot_krm_1068_02">2</a></sup> पेलकः-लिका, पेलकः-लिका, पिपेलिषकः-षिका, पेपेलकः-लिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककेलतिवत् <sup id="ref_krm_1068_03"><a href="#foot_krm_1068_03">3</a></sup> ज्ञेयानि। </li> <li>पेला भुक्तसमुञ्झितम्। </li> <li>पेलकः = त्वग्गन्धः। </li> <li>पेलवम् = तनु। </li> <li>औणादिकोऽयम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1068_01"><a href="#ref_krm_1068_01">↑</a> (१०५८)</li> <li id="foot_krm_1068_02"><a href="#ref_krm_1068_02">↑</a> (१-भ्वादिः-५४१। सक। सेट्। आत्म।)</li> <li id="foot_krm_1068_03"><a href="#ref_krm_1068_03">↑</a> (२६२)</li></ul></p>

पेवृ|पेवकः-विका|पिपेविषकः-षिका|पेपेवकः-विका
<ul><li><sup id="ref_krm_1069_01"><a href="#foot_krm_1069_01">1</a></sup> {@“पेवृ सेवने”@} <sup id="ref_krm_1069_02"><a href="#foot_krm_1069_02">2</a></sup> ‘--सेचने’ इति मैत्रेयः। </li> <li>क्षीरस्वामिमैत्रेयादीनां मतेनास्य पाठः। </li> <li>पेवकः-विका, पेवकः-विका, पिपेविषकः-षिका, पेपेवकः-विका;</li> <li>  इत्यादीनि सर्वाणि रूपाणि भौवादिककेलतिवत् <sup id="ref_krm_1069_03"><a href="#foot_krm_1069_03">3</a></sup> ज्ञेयानि। </li> <li>अस्य धातोः आत्मने- पदित्वात् शानचि-पेवमानः, पेविष्यमाणः, पिपेविषमाणः, पिपेविषिष्यमाणः, इतीमान्यधिकानीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1069_01"><a href="#ref_krm_1069_01">↑</a> (१०५९)</li> <li id="foot_krm_1069_02"><a href="#ref_krm_1069_02">↑</a> (१-भ्वादिः-५०४। सक। सेट्। आत्म।)</li> <li id="foot_krm_1069_03"><a href="#ref_krm_1069_03">↑</a> (२६२)</li></ul></p>

पेषृ|पेषकः-षिका|पिपेषिषकः-षिका|पेपेषकः-षिका
<ul><li><sup id="ref_krm_1070_01"><a href="#foot_krm_1070_01">1</a></sup> {@“पेषृ प्रयत्ने”@} <sup id="ref_krm_1070_02"><a href="#foot_krm_1070_02">2</a></sup> ‘एषृ--’ इति धातोः पाठान्तरमिदम्। </li> <li>पेषकः-षिका, पेषकः-षिका, पिपेषिषकः-षिका, पेपेषकः-षिका;</li> <li>  इत्यादीनि रूपाणि भौवादिकगेपतिवत् <sup id="ref_krm_1070_03"><a href="#foot_krm_1070_03">3</a></sup> ज्ञेयानि। </li> <li>क्विपि तु <sup id="ref_krm_1070_04"><a href="#foot_krm_1070_04">4</a></sup> पेट्-पेङ्-पेषौ- पेषः इति रूपम्। </li> <li>कर्तरि क्तप्रत्यये अपेषितम् <sup id="ref_krm_1070_05"><a href="#foot_krm_1070_05">5</a></sup> इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1070_01"><a href="#ref_krm_1070_01">↑</a> (१०६०)</li> <li id="foot_krm_1070_02"><a href="#ref_krm_1070_02">↑</a> (१-भ्वादिः-६१५। अक। सेट्। आत्म।)</li> <li id="foot_krm_1070_03"><a href="#ref_krm_1070_03">↑</a> (४२९)</li> <li id="foot_krm_1070_04"><a href="#ref_krm_1070_04">↑</a> [[१। ‘झलां जशोऽन्ते’ (८-२-३९) इति जश्त्वे चर्त्वविकल्पे च रूपमेवम्।]]</li> <li id="foot_krm_1070_05"><a href="#ref_krm_1070_05">↑</a> [[आ। ‘येषणाप्तहरिजेषसंभ्रमान्नेषितस्मृतिरपेषितो रथात्।।’ धा। का। १। ७८।]]</li></ul></p>

