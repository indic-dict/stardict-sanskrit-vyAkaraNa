<ul><li><sup id="ref_krm_1165_01"><a href="#foot_krm_1165_01">1</a></sup> {@“भाम क्रोधे”@} <sup id="ref_krm_1165_02"><a href="#foot_krm_1165_02">2</a></sup> ‘भामेर्भामयति क्रोधे तत्रैव शपि भामते।।’ <sup id="ref_krm_1165_03"><a href="#foot_krm_1165_03">3</a></sup> इति देवः। </li> <li>भामकः-मिका, भामकः-मिका, विभामिषकः-षिका, बाभामकः-मिका;</li> <li>  भामिता-त्री, भामयिता-त्री, बिभामिषिता-त्री, बाभामिता-त्री;</li> <li>  <sup id="ref_krm_1165_04"><a href="#foot_krm_1165_04">4</a></sup> <sup id="ref_krm_1165_05"><a href="#foot_krm_1165_05">5</a></sup> भामयन्-न्ती, भामयिष्यन्-न्ती-ती;</li> <li>  -- <sup id="ref_krm_1165_06"><a href="#foot_krm_1165_06">6</a></sup> देवदत्ताय भाममानः, -- बिभामिषमाणः, बाभाम्यमानः;</li> <li>  भामिष्यमाणः, -- बिभामिषिष्यमाणः, बाभामिष्यमाणः;</li> <li>  <sup id="ref_krm_1165_07"><a href="#foot_krm_1165_07">7</a></sup> भान्-भामौ-भामः;</li> <li>  -- -- -- भामितम्-तः, भामितः, बिभामिषितः, बाभामितः-तवान्;</li> <li>  भामः, <sup id="ref_krm_1165_08"><a href="#foot_krm_1165_08">8</a></sup> भामनः, भामः, बिभामिषुः, बाभाम;</li> <li>  भामितव्यम्, भामयितव्यम्, बिभामिषितव्यम्, बाभामितव्यम्;</li> <li>  भामनीयम्, भामनीयम्, बिभामिषणीयम्, बाभामनीयम्;</li> <li>  भाम्यम्, भाम्यम्, बिभामिष्यम्, बाभाम्यम्;</li> <li>  ईषद्भामः-दुर्भामः-सुभामः;</li> <li>  -- -- भाम्यमानः, भाम्यमानः, बिभामिष्यमाणः, बाभाम्यमानः;</li> <li>  भामः, <sup id="ref_krm_1165_09"><a href="#foot_krm_1165_09">9</a></sup> भामिनी <sup id="ref_krm_1165_10"><a href="#foot_krm_1165_10">10</a></sup>, भामः;</li> <li>  बिभामिषः, बाभामः;</li> <li>  भामितुम्, भामयितुम्, बिभामिषितुम्, बाभामितुम्;</li> <li>  भामा, भामना, बिभामिषा, बाभामा;</li> <li>  भामनम्, भामनम्, बिभामिषणम्, बाभामनम्;</li> <li>  भामित्वा, भामयित्वा, बिभामिषित्वा, बाभामित्वा;</li> <li>  प्रभाम्य, प्रभाम्य, प्रबिभामिष्य, प्रबाभाम्य;</li> <li>  भामम् २, भामित्वा २, भामम् २, भामयित्वा २, बिभामिषम् २, बिभामिषित्वा २, बाभामम् २;</li> <li>  बाभामित्वा २। <sup id="ref_krm_1165_11"><a href="#foot_krm_1165_11">11</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1165_01"><a href="#ref_krm_1165_01">↑</a> (११५५)</li> <li id="foot_krm_1165_02"><a href="#ref_krm_1165_02">↑</a> (१-भ्वादिः-४४१। अक। सेट्। आत्म।)</li> <li id="foot_krm_1165_03"><a href="#ref_krm_1165_03">↑</a> (श्लो। १४९)</li> <li id="foot_krm_1165_04"><a href="#ref_krm_1165_04">↑</a> [पृष्ठम्०९४९+ २३]</li> <li id="foot_krm_1165_05"><a href="#ref_krm_1165_05">↑</a> [[१। ‘अणावकर्मकात् चित्तवत्कर्तृकात्’ (१-३-८८) इति ण्यन्तात् परस्मैपदमेव।]]</li> <li id="foot_krm_1165_06"><a href="#ref_krm_1165_06">↑</a> [[२। ‘क्रुधद्रुहेर्ष्यासूयार्थानां यं प्रति कोपः’ (१-४-३७) इति देवदत्तस्य सम्प्रदानता।]]</li> <li id="foot_krm_1165_07"><a href="#ref_krm_1165_07">↑</a> [[३। ‘मो नो धातोः’ (८-२-६४) इति पदान्ते नकारादेशो भवति। नत्वस्यासिद्धत्वात् नलोपो न।]]</li> <li id="foot_krm_1165_08"><a href="#ref_krm_1165_08">↑</a> [[४। तच्छीलादिषु कर्तृषु ‘अनुदात्तेतश्च हलादेः’ (३-२-१४९) इति युच्।]]</li> <li id="foot_krm_1165_09"><a href="#ref_krm_1165_09">↑</a> [[५। भामः = क्रोधः। सोऽस्याऽस्तीति भामिनी = स्त्री। मत्वर्थीय इनिप्रत्यये, ‘ऋन्नेभ्यः--’ (४-१-५) इति ङीपि रूपमेवम्।]]</li> <li id="foot_krm_1165_10"><a href="#ref_krm_1165_10">↑</a> [[आ। ‘पणाय्यरूपाः पनिताकृतीन्ययुः भामिन्य एवाक्षमया स्वकामुकान्।।’ धा। का। १। ५७।]]</li> <li id="foot_krm_1165_11"><a href="#ref_krm_1165_11">↑</a> [पृष्ठम्०९५०+ २५]</li></ul></p>

भाम|भामकः-मिका|बिभामयिषकः-षिका|भामयिता-त्री|बिभामयिषिता-|त्री
<ul><li><sup id="ref_krm_1166_01"><a href="#foot_krm_1166_01">1</a></sup> {@“भाम क्रोधे”@} <sup id="ref_krm_1166_02"><a href="#foot_krm_1166_02">2</a></sup> अदन्तः। </li> <li>‘भामेर्भामयति क्रोधे तत्रैव शपि भामते।।’ <sup id="ref_krm_1166_03"><a href="#foot_krm_1166_03">3</a></sup> इति देवः। </li> <li>भामकः-मिका, बिभामयिषकः-षिका;</li> <li>  भामयिता-त्री, बिभामयिषिता- त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिककालयतिवत् <sup id="ref_krm_1166_04"><a href="#foot_krm_1166_04">4</a></sup> ज्ञेयानि। </li> <li>कर्तरि क्तप्रत्यये- <sup id="ref_krm_1166_05"><a href="#foot_krm_1166_05">5</a></sup> भामितः इति रूपम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1166_01"><a href="#ref_krm_1166_01">↑</a> (११५६)</li> <li id="foot_krm_1166_02"><a href="#ref_krm_1166_02">↑</a> (१०-चुरादिः-१८७३। अक। सेट्। उभ।)</li> <li id="foot_krm_1166_03"><a href="#ref_krm_1166_03">↑</a> (श्लो। १४९)</li> <li id="foot_krm_1166_04"><a href="#ref_krm_1166_04">↑</a> (१८५)</li> <li id="foot_krm_1166_05"><a href="#ref_krm_1166_05">↑</a> [[आ। ‘यो मत्क्षयं स्पृहयते मयि भामितेऽपि संसूचयत्यरिगुणांश्च मदन्नखेटी।’ धा। का। ३। ५५।]]</li></ul></p>

भाष|भाषकः-षिका|बिभाषिषकः-षिका|बाभाषकः-षिका|भाषिता-त्री|भाषयिता-त्री|बिभाषिषिता-त्री|बाभाषिता-त्री
<ul><li><sup id="ref_krm_1167_01"><a href="#foot_krm_1167_01">1</a></sup> {@“भाष व्यक्तायां वाचि”@} <sup id="ref_krm_1167_02"><a href="#foot_krm_1167_02">2</a></sup>। </li> <li>भाषकः-षिका, भाषकः-षिका, बिभाषिषकः-षिका, बाभाषकः-षिका;</li> <li>  भाषिता-त्री, भाषयिता-त्री, बिभाषिषिता-त्री, बाभाषिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकभामतिवत् <sup id="ref_krm_1167_03"><a href="#foot_krm_1167_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1167_04"><a href="#foot_krm_1167_04">4</a></sup> व्याभाषकः, <sup id="ref_krm_1167_05"><a href="#foot_krm_1167_05">5</a></sup> सुभाषी, सुभाषितम्, भाषा, <sup id="ref_krm_1167_06"><a href="#foot_krm_1167_06">6</a></sup> आत्मनेभाषा-परस्मैभाषा, भाष्यम् इतीमानि रूपाणि अस्य धातोः भवन्तीति विशेषः। </li> <li><sup id="ref_krm_1167_07"><a href="#foot_krm_1167_07">7</a></sup> भाषितुम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1167_01"><a href="#ref_krm_1167_01">↑</a> (११५७)</li> <li id="foot_krm_1167_02"><a href="#ref_krm_1167_02">↑</a> (१-भ्वादिः-६१२। सक। सेट्। आत्म।)</li> <li id="foot_krm_1167_03"><a href="#ref_krm_1167_03">↑</a> (११५५)</li> <li id="foot_krm_1167_04"><a href="#ref_krm_1167_04">↑</a> [[१। ‘निन्दहिंसक्लिशखादविनाशपरिक्षिपपरिरटपरिवादिव्याभाषासूयो वुञ्’ (३-२-१४६) इत्यादिना तच्छीलादिषु कर्तृषु वुञ् प्रत्यये रूपमेवम्।]]</li> <li id="foot_krm_1167_05"><a href="#ref_krm_1167_05">↑</a> [[२। ‘सुप्यजातौ--’ (३-२-७८) इति ताच्छील्ये णिनिः।]]</li> <li id="foot_krm_1167_06"><a href="#ref_krm_1167_06">↑</a> [[३। स्त्रियाम् ‘गुरोश्च हलः’ (३-३-१०३) इत्यकारप्रत्यये भाषा इति सिद्ध्यति। आत्मनेभाषा, परस्मैभाषा इत्यत्र ‘वैयाकरणाख्यायां चतुर्थ्याः’ (६-३-७) ‘परस्य च’ (६-३-८) इत्यलुक्। आत्मनेभाषा = आत्मनेपदम्। परस्मैभाषा = परस्मैपदम्। धातुपाठेषु वैयाकरणाख्यायामेते प्रसिद्धे। भाष्ये तु (६-३-७) प्रकृतस्थले आत्मनेभाषः, पस्मैभाषः इति घञन्त एव प्रयुक्तो लक्ष्यते।]]</li> <li id="foot_krm_1167_07"><a href="#ref_krm_1167_07">↑</a> [[B। ‘भाषितुं स खलु हर्षवर्षितो गेषितुं समुचितं च नाशकत्।’ धा। का। १। ७८।]]</li></ul></p>

भासृ|भासकः-सिका|बिभासिषकः-षिका|बाभासकः-सिका
<ul><li><sup id="ref_krm_1168_01"><a href="#foot_krm_1168_01">1</a></sup> {@“भासृ दीप्तौ”@} <sup id="ref_krm_1168_02"><a href="#foot_krm_1168_02">2</a></sup> भासकः-सिका, भासकः-सिका, बिभासिषकः-षिका, बाभासकः-सिका;</li> <li>  इत्यादीनि सर्वाणि रूपाणि भौवादिककासतिवत् <sup id="ref_krm_1168_03"><a href="#foot_krm_1168_03">3</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_1168_04"><a href="#foot_krm_1168_04">4</a></sup> <sup id="ref_krm_1168_05"><a href="#foot_krm_1168_05">5</a></sup> भासुरः <sup id="ref_krm_1168_06"><a href="#foot_krm_1168_06">6</a></sup>, <sup id="ref_krm_1168_07"><a href="#foot_krm_1168_07">7</a></sup> भास्वरः <sup id="ref_krm_1168_08"><a href="#foot_krm_1168_08">8</a></sup>, <sup id="ref_krm_1168_09"><a href="#foot_krm_1168_09">9</a></sup> भाः-भासौ-भासः, <sup id="ref_krm_1168_10"><a href="#foot_krm_1168_10">10</a></sup> भासा, ण्यन्तात् शतरि <sup id="ref_krm_1168_11"><a href="#foot_krm_1168_11">11</a></sup> उद्भासयन्, <sup id="ref_krm_1168_12"><a href="#foot_krm_1168_12">12</a></sup> उद्भासी, इमानि रूपाण्यधिकान्यत्रेति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1168_01"><a href="#ref_krm_1168_01">↑</a> (११५८)</li> <li id="foot_krm_1168_02"><a href="#ref_krm_1168_02">↑</a> (१-भ्वादिः-६२४। अक। सेट्। आत्म।)</li> <li id="foot_krm_1168_03"><a href="#ref_krm_1168_03">↑</a> (१८८)</li> <li id="foot_krm_1168_04"><a href="#ref_krm_1168_04">↑</a> [पृष्ठम्०९५१+ ३१]</li> <li id="foot_krm_1168_05"><a href="#ref_krm_1168_05">↑</a> [[१। ‘भञ्जभास--’ (३-२-१६१) इति घुरच्प्रत्ययः तच्छीलादिषु कर्तृषु भवति।]]</li> <li id="foot_krm_1168_06"><a href="#ref_krm_1168_06">↑</a> [[आ। ‘सृमरोभङ्गुरप्रज्ञो गृहीत्वा भासुरं धनुः।’ भ। का। ७। २२।]]</li> <li id="foot_krm_1168_07"><a href="#ref_krm_1168_07">↑</a> [[२। ‘स्थेशभास--’ (३-२-१७५) इति तच्छीलादिषु कर्तृषु वरच्प्रत्ययः। ‘अनुदात्तेतश्च हलादेः’ (३-२-१४९) इति प्राप्तस्य युचोऽपवादोऽयम्। ‘नेड् वशि- कृति’ (७-२-८) इतीण्निषेधः।]]</li> <li id="foot_krm_1168_08"><a href="#ref_krm_1168_08">↑</a> [[B। ‘अभीरुरवसं स्त्रीभिर्भास्वराभिरिहेश्वरः।।’ भ। का। ७। २५।]]</li> <li id="foot_krm_1168_09"><a href="#ref_krm_1168_09">↑</a> [[३। तच्छीलादिषु कर्तृषु ‘भ्राजभास--’ (३-२-१७७) इत्यादिना क्विप्प्रत्ययः। ‘ताच्छीलिकेषु ताच्छीलिकाः वाऽसरूपेण न भवन्ति, (भाष्यम्। ३-२-१५०) इति न्यायेनात्र क्विप्प्रत्ययोऽप्यस्य धातोः ताच्छीलिकेष्वेवार्थेषु भवतीति बोध्यम्।]]</li> <li id="foot_krm_1168_10"><a href="#ref_krm_1168_10">↑</a> [[४। ‘गुरोश्च हलः’ (३-३-१०३) इति स्त्रियामकारप्रत्यये रूपमेवम्।]]</li> <li id="foot_krm_1168_11"><a href="#ref_krm_1168_11">↑</a> [[C। ‘कला दधानः सकलाः स्वभाभिः उद्भासयन् सौधसिताभिराशाः।’ शि। व। ३। ६०।]]</li> <li id="foot_krm_1168_12"><a href="#ref_krm_1168_12">↑</a> [[५। ग्रह्यादित्वात् (३-१-१३४) णिनिप्रत्यये रूपमेवम्।]]</li></ul></p>

भिक्ष|भिक्षकः-क्षिका|बिभिक्षिषकः-षिका|बेभिक्षकः-क्षिका
<ul><li><sup id="ref_krm_1169_01"><a href="#foot_krm_1169_01">1</a></sup> {@“भिक्ष भिक्षायाम् अलाभे लाभे च”@} <sup id="ref_krm_1169_02"><a href="#foot_krm_1169_02">2</a></sup> <sup id="ref_krm_1169_03"><a href="#foot_krm_1169_03">3</a></sup> क्षीरस्वामी तु ‘भिक्ष याच्ञायाम्, अलाभे लाभे च, क्लेशे च, व्यक्तायां वाचि’ इत्युपादाय, ‘तत्तद्देशादिप्रसिद्धार्थानां पृथङ्निर्देशः।’ इति तत्रोपपत्तिमप्याह। </li> <li>प्रसिद्धेषु धातुपाठकोशेषु क्लेशधातुः पृथगेव पठ्यते, न तु भिक्ष- धातोरर्थत्वेन। </li> <li>स्पष्टमिदं माधवधातुवृत्त्यादिषु प्रकृतस्थले। </li> <li>अतोऽत्रास्मा- भिरपि क्लेशार्थकत्वमस्य नोपक्षिप्तमिति ज्ञेयम्।]] ‘--याच्ञायाम्…’ इति सर्वेषु कोशेषु दृष्टः पाठः। </li> <li>भिक्षकः-क्षिका, भिक्षकः-क्षिका, बिभिक्षिषकः-षिका, बेभिक्षकः-क्षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकधिक्षतिवत् <sup id="ref_krm_1169_04"><a href="#foot_krm_1169_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1169_05"><a href="#foot_krm_1169_05">5</a></sup> भिक्षाकः, <sup id="ref_krm_1169_06"><a href="#foot_krm_1169_06">6</a></sup> भिक्षुः <sup id="ref_krm_1169_07"><a href="#foot_krm_1169_07">7</a></sup>, <sup id="ref_krm_1169_08"><a href="#foot_krm_1169_08">8</a></sup> तण्डुलभिक्षः, इत्यादीनि रूपाणि अस्य धातोः <sup id="ref_krm_1169_09"><a href="#foot_krm_1169_09">9</a></sup> <sup id="ref_krm_1169_10"><a href="#foot_krm_1169_10">10</a></sup> विशेषेण भवन्तीति विशेषः। </li> <li><sup id="ref_krm_1169_11"><a href="#foot_krm_1169_11">11</a></sup> भिक्षमाणः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1169_01"><a href="#ref_krm_1169_01">↑</a> (११५९)</li> <li id="foot_krm_1169_02"><a href="#ref_krm_1169_02">↑</a> (१-भ्वादिः-६०६। सक। सेट्। आत्म।)</li> <li id="foot_krm_1169_03"><a href="#ref_krm_1169_03">↑</a> [[[अ]</li> <li id="foot_krm_1169_04"><a href="#ref_krm_1169_04">↑</a> (८९८)</li> <li id="foot_krm_1169_05"><a href="#ref_krm_1169_05">↑</a> [[६। ‘जल्पभिक्ष--’ (३-२-१५५) इत्यनेन तच्छीलादिषु कर्तृषु षाकन्प्रत्यये रूपमेवम्। षित्त्वात् स्त्रियां ङीषि भिक्षाकी इति भवति। ‘अनुदात्तेतश्च--’ (३-२-१४९) इति प्राप्तस्य युचोऽपवादोऽयम्।]]</li> <li id="foot_krm_1169_06"><a href="#ref_krm_1169_06">↑</a> [[७। तच्छीलादिषु कर्तृषु ‘सनाशंस भक्ष उः’ (३-२-१६८) इति उप्रत्ययः। ताच्छी लिकेषु वाऽसरूपविधिर्नास्ति।’ इति, अत्रैव सूत्रे (३-२-१६८) भिक्षधातोः ‘ताच्छी- लिकप्रत्ययविधायकस्थले पुनरुपादानात् ज्ञाप्यते इति बोध्यम्।]]</li> <li id="foot_krm_1169_07"><a href="#ref_krm_1169_07">↑</a> [[E। ‘… संवृक्ष्यवेदमतशिक्षकभिक्षुगम्यम्।’ धा। का। १। ७७।]]</li> <li id="foot_krm_1169_08"><a href="#ref_krm_1169_08">↑</a> [[८। ‘कर्मण्यण्’ (३-२-१) इति कर्मण्युपपदे अण्प्रत्ययः।]]</li> <li id="foot_krm_1169_09"><a href="#ref_krm_1169_09">↑</a> [[ड्। ‘वज्रप्रभोद्भासिसुरायुधश्रीः या देवसेनेव परैरलङ्घ्या।।’ शि। व। ३। ६४।]]</li> <li id="foot_krm_1169_10"><a href="#ref_krm_1169_10">↑</a> [पृष्ठम्०९५२+ २५]</li> <li id="foot_krm_1169_11"><a href="#ref_krm_1169_11">↑</a> [[आ। ‘संदृश्य शरणं शून्यं भिक्षमाणो वनं प्रियाम्।’ भ। का। ६। ९।]]</li></ul></p>

