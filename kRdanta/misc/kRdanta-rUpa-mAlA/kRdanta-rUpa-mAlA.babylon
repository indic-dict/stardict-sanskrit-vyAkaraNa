<ul><li><sup id="ref_krm_0275_01"><a href="#foot_krm_0275_01">1</a></sup> {@“क्रथ हिंसायाम्”@} <sup id="ref_krm_0275_02"><a href="#foot_krm_0275_02">2</a></sup> <sup id="ref_krm_0275_03"><a href="#foot_krm_0275_03">3</a></sup> अनेन हिंसायां क्रथ--इति चुरादौ पठ्यते इति देवस्याशय इति ज्ञायते। </li> <li>पुरुषकारस्तु चुरादिपाठं नानुमन्यते।]] ‘क्रथत्ययौ, यौ हिंसायाम् क्राथयेत् क्रथते क्रथेत्।’ <sup id="ref_krm_0275_04"><a href="#foot_krm_0275_04">4</a></sup> इति देवः। </li> <li>क्राथकः-थिका, <sup id="ref_krm_0275_05"><a href="#foot_krm_0275_05">5</a></sup> क्राथकः-थिका, चिक्रथिषकः-षिका, चाक्रथकः-थिका;</li> <li>  क्रथिता-त्री, क्राथयिता-त्री, चिक्रथिषिता-त्री, चाक्रथिता-त्री;</li> <li>  <sup id="ref_krm_0275_06"><a href="#foot_krm_0275_06">6</a></sup> क्रथन्-न्ती, <sup id="ref_krm_0275_07"><a href="#foot_krm_0275_07">7</a></sup> क्राथयन्-न्ती, चिक्रथिषन्-न्ती;</li> <li>  -- क्रथिष्यन्-न्ती-ती, क्राथयिष्यन्-न्ती-ती, चिक्रथिषिष्यन्-न्ती-ती;</li> <li>  -- क्राथयमानः, क्राथयिष्यमाणः, चाक्रथ्यमानः, चाक्रथिष्यमाणः;</li> <li>  कथ्-क्रत्-क्रथौ-क्रथः;</li> <li>  -- -- -- क्रथितम्-तः, क्राथितः, चिक्रथिषितः, चाक्रथितः-तवान्;</li> <li>  कथः, <sup id="ref_krm_0275_08"><a href="#foot_krm_0275_08">8</a></sup> प्रक्राथी, क्राथः, चिक्रथिषुः, चाक्रथः;</li> <li>  क्रथितव्यम्, क्राथयितव्यम्, चिक्रथिषितव्यम्, चाक्रथितव्यम्;</li> <li>  क्रथनीयम्, क्राथनीयम्, चिक्रथिषणीयम्, चाक्रथनीयम्;</li> <li>  क्राथ्यम्, क्राथ्यम्, चिक्रथिष्यम्, चाक्रथ्यम्;</li> <li>  ईषत्क्रथः-दुष्क्रथः-सुक्रथः;</li> <li>  -- -- कथ्यमानः, क्राथ्यमानः, चिक्रथिष्यमाणः, चाक्रथ्यमानः;</li> <li>  क्राथः, क्राथः;</li> <li>  चिक्रथिषः, चाक्रथः;</li> <li>  क्रथितुम्, क्राथयितुम्, चिक्रथिषितुम्, चाक्रथितुम्;</li> <li>  <sup id="ref_krm_0275_09"><a href="#foot_krm_0275_09">9</a></sup> क्रत्तिः, क्राथना, चिक्रथिषा, चाक्रथा;</li> <li>  क्रथनम्, क्राथनम्, चिक्रथिषणम्, चाक्रथनम्;</li> <li>  क्रथित्वा, क्राथयित्वा, चिक्रथिषित्वा, चाक्रथित्वा;</li> <li>  प्रक्रथ्य, प्रक्राथ्य, प्रचिक्रथिष्य, प्रचाक्रथ्य;</li> <li>  क्राथम् २, क्रथित्वा २, <sup id="ref_krm_0275_10"><a href="#foot_krm_0275_10">10</a></sup> क्रथम् २, क्राथम् २, क्राथयित्वा २, चिक्रथिषम् २, चिक्रथित्वा २, चाक्रथम् २;</li> <li>  चाक्रथित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0275_01"><a href="#ref_krm_0275_01">↑</a> (२६९)</li> <li id="foot_krm_0275_02"><a href="#ref_krm_0275_02">↑</a> (१-भ्वादिः-८०१। सक। सेट्। पर। घटादिः।)</li> <li id="foot_krm_0275_03"><a href="#ref_krm_0275_03">↑</a> [[[अ]</li> <li id="foot_krm_0275_04"><a href="#ref_krm_0275_04">↑</a> (श्लो। १००)</li> <li id="foot_krm_0275_05"><a href="#ref_krm_0275_05">↑</a> [[२। ‘जासिनिप्रहणनाटक्राथपिषां--’ (२-३-५६) इति सूत्रे ‘क्राथ’ इति निपातनात् मित्त्वप्रयुक्तः ह्रस्वो बाध्यते। एवं ण्यन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0275_06"><a href="#ref_krm_0275_06">↑</a> [पृष्ठम्०२७५+ २७]</li> <li id="foot_krm_0275_07"><a href="#ref_krm_0275_07">↑</a> [[आ। ‘श्लथ्यात्मनां क्राथयताऽच्युतेन किं नाङ्गजो नः क्लथयन् अच{??}नि।’ धा। का। २-१०।]]</li> <li id="foot_krm_0275_08"><a href="#ref_krm_0275_08">↑</a> [[१। ‘सुप्यजातौ णिनिस्ताच्छील्ये’ (३-२-७८) इति णिनिः।]]</li> <li id="foot_krm_0275_09"><a href="#ref_krm_0275_09">↑</a> [[२। ‘खरि च’ (८-४-५५) इति चर्त्त्वम्।]]</li> <li id="foot_krm_0275_10"><a href="#ref_krm_0275_10">↑</a> [[३। ‘जासिनिप्रहणनाटक्राथ--’ (२-३-५६) इति सूत्रे ‘क्राथ’ इति निपातनात् ‘मितां ह्रस्वः’ (६-४-९२) इति ह्रस्व एव बाध्यते, न तु व्यवहितः ‘चिण्णमुलोः’ इति दीर्घविकल्पः। तेन, ‘चिण्णमुलोर्दीर्घोऽन्यतरस्याम्’ (६-४-९३) इति ण्यन्तात् णमुलि दीर्घविकल्पः।]]</li></ul></p>

क्रदि
<ul><li><sup id="ref_krm_0276_01"><a href="#foot_krm_0276_01">1</a></sup> {@“क्रदि वैक्लब्ये”@} <sup id="ref_krm_0276_02"><a href="#foot_krm_0276_02">2</a></sup> घटादिः। </li> <li>‘वैकल्ये-वैक्लव्ये’ इत्येके। </li> <li>वैक्लव्यार्थककन्दतिवत् <sup id="ref_krm_0276_03"><a href="#foot_krm_0276_03">3</a></sup> सर्वाणि रूपाणि ज्ञेयानि। </li> <li>‘क्रद’ इति मैत्रेयः। </li> <li><sup id="ref_krm_0276_04"><a href="#foot_krm_0276_04">4</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0276_01"><a href="#ref_krm_0276_01">↑</a> (२६९-आ)</li> <li id="foot_krm_0276_02"><a href="#ref_krm_0276_02">↑</a> (१-भ्वादिः-७७३। अक। सेट्। आत्म।)</li> <li id="foot_krm_0276_03"><a href="#ref_krm_0276_03">↑</a> (१६४)</li> <li id="foot_krm_0276_04"><a href="#ref_krm_0276_04">↑</a> [पृष्ठम्०२७६+ २७]</li></ul></p>

क्रदि|क्रन्दकः-न्दिका|चिक्रन्दिषकः-षिका|चाक्रन्दकः-न्दिका|क्रन्दिता-त्री|क्रन्दयिता-त्री|चिक्रन्दिषिता-त्री|चाक्रन्दिता-त्री|क्रन्दन्-न्ती|क्रन्दयन्-न्ती|चिक्रन्दिषन्-न्ती|-|क्रन्दिष्यन्-न्ती-ती|क्रन्दयिष्यन्-न्ती-ती|चिक्रन्दिषिष्यन्-न्ती-ती|क्रन्दमानः|क्रन्दयमानः|चिक्रन्दिषमाणः|चाक्रन्द्यमानः|क्रन्दिष्यमाणः|क्रन्दयिष्यमाणः|चिक्रन्दिषिष्यमाणः|चाक्रन्दिष्यमाणः|क्रन्-क्रन्दौ-क्रन्दः|क्रन्दितम्-तः|क्रन्दितः|चिक्रन्दिषितः|चाक्रन्दितः-तवान्|क्रन्दः|सङ्क्रन्दनः|क्रन्दनः|चिक्रन्दिषुः|चाक्रन्दः|क्रन्दितव्यम्|क्रन्दयितव्यम्|चिक्रन्दिषितव्यम्|चाक्रन्दितव्यम्|क्रन्दनीयम्|चिक्रन्दिषणीयम्|चाक्रन्दनीयम्|क्रन्द्यम्|चिक्रन्दिष्यम्|चाक्रन्द्यम्|ईषत्क्रन्दः-दुष्क्रन्दः-सुकन्दः|-क्रन्द्यमानः|क्रन्द्यमानः|चिक्रन्दिष्यमाणः|आक्रन्दः|चिक्रन्दिषः|क्रन्दितुम्|क्रन्दयितुम्|चिक्रन्दिषितुम्|चाक्रन्दितुम्|क्रन्दा|क्रन्दना|चिक्रन्दिषा|चाक्रन्दा|क्रन्दनम्|चिक्रन्दिषणम्|चाक्रन्दनम्|क्रन्दित्वा|क्रन्दयित्वा|चिक्रन्दिषित्वा|चाक्रन्दित्वा|सङ्क्रन्द्य|सङ्कन्द्य|प्रचिक्रन्दिष्य|प्रचाक्रन्द्य|क्रन्दम्|क्रन्दम्-क्रान्दम्|चिक्रन्दिषम्|चाक्रन्दम्
<ul><li><sup id="ref_krm_0277_01"><a href="#foot_krm_0277_01">1</a></sup> {@“क्रदि आह्वाने रोदने च”@} <sup id="ref_krm_0277_02"><a href="#foot_krm_0277_02">2</a></sup> अर्थविशेषे--घटादिः। </li> <li>षित्। </li> <li>आह्वाने सकर्मकः, रोदनेऽकर्मकः। </li> <li>‘रक्षणे च’ इत्येके। </li> <li>“आह्वाने रोदने क्रन्देः कन्देः क्रन्दति कन्दति। </li> <li>वैक्लब्ये तु तयोर्धात्वोः क्रन्दते कन्दते मितोः।। </li> <li>मित्त्वार्थपाठसामर्थ्यात् तयोर्दीर्थविकल्पनम्। </li> <li>भवेच्चिण्णमुलोस्तस्मात् अक्रान्द्यक्रन्दि सिद्ध्यतः’।। </li> <li><sup id="ref_krm_0277_03"><a href="#foot_krm_0277_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_0277_04"><a href="#foot_krm_0277_04">4</a></sup> क्रन्दकः-न्दिका, <sup id="ref_krm_0277_05"><a href="#foot_krm_0277_05">5</a></sup> क्रन्दकः-न्दिका, चिक्रन्दिषकः-षिका, चाक्रन्दकः-न्दिका;</li> <li>  क्रन्दिता-त्री, क्रन्दयिता-त्री, चिक्रन्दिषिता-त्री, चाक्रन्दिता-त्री;</li> <li>  क्रन्दन्-न्ती, क्रन्दयन्-न्ती, चिक्रन्दिषन्-न्ती;</li> <li>  -- क्रन्दिष्यन्-न्ती-ती, क्रन्दयिष्यन्-न्ती-ती, चिक्रन्दिषिष्यन्-न्ती-ती;</li> <li>  <sup id="ref_krm_0277_06"><a href="#foot_krm_0277_06">6</a></sup> क्रन्दमानः, क्रन्दयमानः, <sup id="ref_krm_0277_07"><a href="#foot_krm_0277_07">7</a></sup> चिक्रन्दिषमाणः, चाक्रन्द्यमानः;</li> <li>  क्रन्दिष्यमाणः, क्रन्दयिष्यमाणः, चिक्रन्दिषिष्यमाणः, चाक्रन्दिष्यमाणः;</li> <li>  <sup id="ref_krm_0277_08"><a href="#foot_krm_0277_08">8</a></sup> क्रन्-क्रन्दौ-क्रन्दः;</li> <li>  -- -- -- क्रन्दितम्-तः, क्रन्दितः, चिक्रन्दिषितः, चाक्रन्दितः-तवान्;</li> <li>  क्रन्दः, <sup id="ref_krm_0277_09"><a href="#foot_krm_0277_09">9</a></sup> सङ्क्रन्दनः <sup id="ref_krm_0277_10"><a href="#foot_krm_0277_10">10</a></sup>, <sup id="ref_krm_0277_11"><a href="#foot_krm_0277_11">11</a></sup> क्रन्दनः, चिक्रन्दिषुः, चाक्रन्दः;</li> <li>  क्रन्दितव्यम्, क्रन्दयितव्यम्, चिक्रन्दिषितव्यम्, चाक्रन्दितव्यम्;</li> <li>  क्रन्दनीयम्, क्रन्दनीयम्, चिक्रन्दिषणीयम्, चाक्रन्दनीयम्;</li> <li>  क्रन्द्यम्, क्रन्द्यम्, चिक्रन्दिष्यम्, चाक्रन्द्यम्;</li> <li>  ईषत्क्रन्दः-दुष्क्रन्दः-सुकन्दः;</li> <li>  -- -- <sup id="ref_krm_0277_12"><a href="#foot_krm_0277_12">12</a></sup> क्रन्द्यमानः, क्रन्द्यमानः, चिक्रन्दिष्यमाणः, चाक्रन्द्यमानः;</li> <li>  क्रन्दः, <sup id="ref_krm_0277_13"><a href="#foot_krm_0277_13">13</a></sup> आक्रन्दः, क्रन्दः, चिक्रन्दिषः, चाक्रन्दः;</li> <li>  क्रन्दितुम्, क्रन्दयितुम्, चिक्रन्दिषितुम्, चाक्रन्दितुम्;</li> <li>  <sup id="ref_krm_0277_14"><a href="#foot_krm_0277_14">14</a></sup> क्रन्दा, क्रन्दना, चिक्रन्दिषा, चाक्रन्दा;</li> <li>  क्रन्दनम्, क्रन्दनम्, चिक्रन्दिषणम्, चाक्रन्दनम्;</li> <li>  क्रन्दित्वा, क्रन्दयित्वा, चिक्रन्दिषित्वा, चाक्रन्दित्वा;</li> <li>  सङ्क्रन्द्य, सङ्कन्द्य, प्रचिक्रन्दिष्य, प्रचाक्रन्द्य;</li> <li>  क्रन्दम् २, क्रन्दित्वा २, <sup id="ref_krm_0277_15"><a href="#foot_krm_0277_15">15</a></sup> क्रन्दम् २ -क्रान्दम् २, क्रन्दयित्वा २, चिक्रन्दिषम् २, चिक्रन्दिषित्वा २, चाक्रन्दम् २;</li> <li>  चाक्रन्दित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0277_01"><a href="#ref_krm_0277_01">↑</a> (२७०)</li> <li id="foot_krm_0277_02"><a href="#ref_krm_0277_02">↑</a> (१-भ्वादिः-७१-[७७३] सक। सेट्। पर।)</li> <li id="foot_krm_0277_03"><a href="#ref_krm_0277_03">↑</a> (श्लो-१०५-१०६)</li> <li id="foot_krm_0277_04"><a href="#ref_krm_0277_04">↑</a> [[१। ‘इदितो नुम् धातोः’ (७-१-५८) इति नुम्।]]</li> <li id="foot_krm_0277_05"><a href="#ref_krm_0277_05">↑</a> [[२। अर्थविशेषे घटादिपाठः--तदानीमपि रूपं तुल्यमेव। मित्त्वफलं तु णमुलि।]]</li> <li id="foot_krm_0277_06"><a href="#ref_krm_0277_06">↑</a> [[३। धातोरस्यैव वैक्लब्ये वैकल्ये वाऽर्थे सति घटादौ पाठः। स च तदानीमात्मनेपदी। तदा शानच्।]]</li> <li id="foot_krm_0277_07"><a href="#ref_krm_0277_07">↑</a> [[४। यदा घटादिपाठः, तदानीमात्मनेपदित्वात् सन्नन्तात् ‘पूर्ववत् सनः’ (१-३-६२) इत्यात्मनेपदम्--शानच्।]]</li> <li id="foot_krm_0277_08"><a href="#ref_krm_0277_08">↑</a> [[५। ‘संयोगान्तस्य--’ (८-२-२३) इति दकारस्य लोपः।]]</li> <li id="foot_krm_0277_09"><a href="#ref_krm_0277_09">↑</a> [[६। सम्यक् परान् क्रन्दयतीत्यर्थे ण्यन्तात् नन्द्यादिपाठात् (३-१-१३४) कर्तरि ल्युः।]]</li> <li id="foot_krm_0277_10"><a href="#ref_krm_0277_10">↑</a> [[आ। ‘पराक्रमत्रन्दनकन्दितासुरं संक्रन्दनक्लन्दितमीक्षितास्महे।।’ धा। का। १-१०।]]</li> <li id="foot_krm_0277_11"><a href="#ref_krm_0277_11">↑</a> [[७। घटादिपाठात् आत्मनेपदे ‘अनुदात्तेतश्च हलादेः’ (३-२-१४९) इति युच्।]]</li> <li id="foot_krm_0277_12"><a href="#ref_krm_0277_12">↑</a> [पृष्ठम्०२७७+ २३]</li> <li id="foot_krm_0277_13"><a href="#ref_krm_0277_13">↑</a> [[१। आक्रन्द्यतेऽत्रेति अधिकरणे घञ्। दुःखिनां रोदनस्थानमभिधीयते। यद्वा आक्र- न्द्यते = रक्ष्यते इति ‘करणाधिकरणयोश्च’ (३-३-११७) इति करणे घञ्। आवासस्थानमुच्यते।]]</li> <li id="foot_krm_0277_14"><a href="#ref_krm_0277_14">↑</a> [[२। ‘गुरोश्च हलः’ (३-३-१०३) इत्यः प्रत्ययः। वैक्लव्यार्थे तु घटादिपाठेन षित्त्वात् ‘षिद्भिदादिभ्योऽङ्’ (३-३-१०४) इत्यङ्।]]</li> <li id="foot_krm_0277_15"><a href="#ref_krm_0277_15">↑</a> [[३। घटादिपाठसामर्थ्यादनुपधात्वेऽपि ‘चिण्णमुलोः--’ (६-१-९३) इति दीर्घो वा।]]</li></ul></p>

आङः|आक्रन्दकः-न्दिका|आचिक्रन्दयिषकः-षिका|आक्रन्दयिता-त्री|आचिक्रन्दयिषिता-त्री|आकन्दयन्-न्ती|आचिक्रन्दयिषन्-न्ती|आक्रन्दयिष्यन्-न्ती-ती|आचिक्रन्दयिषिष्यन्-न्ती-ती|आक्रन्दयमानः|आचिक्रन्दयिषमाणः|आकन्दयिष्यमाणः|आचिक्रन्दयिषिष्यमाणः|आक्रन्द्-आक्रन्दौ-आक्रन्दः|-|आक्रन्दितम्-तः|आचिक्रन्दयिषितः-तवान्|आक्रन्दः|आचिक्रन्दयिषुः|आक्रन्दयितव्यम्|आचिक्रन्दयिषितव्यम्|आक्रन्दनीयम्|आचिक्रन्दयिषणीयम्|आक्रन्द्यम्|आचिक्रन्दयिष्यम्|ईषदाक्रन्दः-दुराक्रन्दः-स्वाक्रन्दः|आक्रन्द्यमानः|आचिक्रन्दयिष्यमाणः|आचिक्रन्दयिषः|आक्रन्दयितुम्|आचिक्रन्दयिषितुम्|आक्रन्दना|आचिक्रन्दयिषा|आक्रन्दनम्|आचिक्रन्दयिषणम्|समाक्रन्द्य|समाचिक्रन्दयिष्य
<ul><li><sup id="ref_krm_0278_01"><a href="#foot_krm_0278_01">1</a></sup> {@“आङः क्रन्दस्सातत्ये”@} <sup id="ref_krm_0278_02"><a href="#foot_krm_0278_02">2</a></sup> ‘आङः क्रन्दः सातत्ये’ इति पाठे, आङः परः क्रन्दतिः सतताह्वाने, सततरोदने, चार्थे गम्यमाने णिचं लभते--इत्यर्थः। </li> <li>‘आङः क्रन्दसातत्ये’ इति पाठे तु, धातुपाठे चुरादौ पूर्वं पठितस्य घुषेः अत्रानुवृत्त्या आङ्पूर्वकात् तस्मात् सततक्रन्दने णिजुत्पत्तिः ज्ञेया। </li> <li>इति द्वेधा व्याख्या। </li> <li>आक्रन्दकः-न्दिका, आचिक्रन्दयिषकः-षिका;</li> <li>  आक्रन्दयिता-त्री, आचिक्रन्दयिषिता-त्री;</li> <li>  <sup id="ref_krm_0278_03"><a href="#foot_krm_0278_03">3</a></sup> आकन्दयन्-न्ती, आचिक्रन्दयिषन्-न्ती;</li> <li>  आक्रन्दयिष्यन्-न्ती-ती, आचिक्रन्दयिषिष्यन्-न्ती-ती;</li> <li>  आक्रन्दयमानः, आचिक्रन्दयिषमाणः;</li> <li>  <sup id="ref_krm_0278_04"><a href="#foot_krm_0278_04">4</a></sup> आकन्दयिष्यमाणः, आचिक्रन्दयिषिष्यमाणः;</li> <li>  आक्रन्द्-आक्रन्दौ-आक्रन्दः;</li> <li>  -- आक्रन्दितम्-तः, आचिक्रन्दयिषितः-तवान्;</li> <li>  आक्रन्दः, आचिक्रन्दयिषुः;</li> <li>  आक्रन्दयितव्यम्, आचिक्रन्दयिषितव्यम्;</li> <li>  आक्रन्दनीयम्, आचिक्रन्दयिषणीयम्;</li> <li>  आक्रन्द्यम्, आचिक्रन्दयिष्यम्;</li> <li>  ईषदाक्रन्दः-दुराक्रन्दः-स्वाक्रन्दः;</li> <li>  -- आक्रन्द्यमानः, आचिक्रन्दयिष्यमाणः;</li> <li>  आक्रन्दः, आचिक्रन्दयिषः;</li> <li>  आक्रन्दयितुम्, आचिक्रन्दयिषितुम्;</li> <li>  आक्रन्दना, आचिक्रन्दयिषा;</li> <li>  आक्रन्दनम्, आचिक्रन्दयिषणम्;</li> <li>  <sup id="ref_krm_0278_05"><a href="#foot_krm_0278_05">5</a></sup> समाक्रन्द्य, समाचिक्रन्दयिष्य;</li> <li>  आक्रन्दम् २, आचिक्रन्दयिषम् २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0278_01"><a href="#ref_krm_0278_01">↑</a> (२७१)</li> <li id="foot_krm_0278_02"><a href="#ref_krm_0278_02">↑</a> (१०-चुरादिः-१७२८। अक। सेट्। उभ।)</li> <li id="foot_krm_0278_03"><a href="#ref_krm_0278_03">↑</a> [[आ। ‘आक्रन्दयत्सु निभृतं नृषु लासिताशेषोत्तंसभूषणविमोक्षणयार्हिताभौ।’ धा। का। ३-४०।]]</li> <li id="foot_krm_0278_04"><a href="#ref_krm_0278_04">↑</a> [पृष्ठम्०२७८+ २७]</li> <li id="foot_krm_0278_05"><a href="#ref_krm_0278_05">↑</a> [[१। नित्यमाङ्पूर्वकत्वादस्य धातोः क्त्वाप्रत्ययो न। ल्यबेव।]]</li></ul></p>

