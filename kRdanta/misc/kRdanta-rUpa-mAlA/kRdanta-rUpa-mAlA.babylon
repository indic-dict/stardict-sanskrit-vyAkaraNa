<ul><li><sup id="ref_krm_0269_01"><a href="#foot_krm_0269_01">1</a></sup> {@“कै शब्दे”@} <sup id="ref_krm_0269_02"><a href="#foot_krm_0269_02">2</a></sup> ‘शब्दे’ इति सामान्यत उक्तावपि शब्दविशेषे प्रयुज्यते। </li> <li><sup id="ref_krm_0269_03"><a href="#foot_krm_0269_03">3</a></sup> कायकः-यिका, <sup id="ref_krm_0269_04"><a href="#foot_krm_0269_04">4</a></sup> कापकः-पिका, <sup id="ref_krm_0269_05"><a href="#foot_krm_0269_05">5</a></sup> चिकासकः-सिका, <sup id="ref_krm_0269_06"><a href="#foot_krm_0269_06">6</a></sup> चाकायकः-यिका;</li> <li>  काता-त्री, कापयिता-त्री, चिकासिता-त्री, चाकायिता-त्री;</li> <li>  <sup id="ref_krm_0269_07"><a href="#foot_krm_0269_07">7</a></sup> कायन्-न्ती, कापयन्-न्ती, चिकासन्-न्ती;</li> <li>  -- कास्यन्-न्ती-ती, कापयिष्यन्-न्ती-ती, चिकासिष्यन्-न्ती-ती;</li> <li>  -- <sup id="ref_krm_0269_08"><a href="#foot_krm_0269_08">8</a></sup> व्यतिकायमानः, कापयमानः, -- चाकायमानः;</li> <li>  व्यतिकास्यमानः, कापयिष्यमाणः, -- चाकायिष्यमाणः;</li> <li>  <sup id="ref_krm_0269_09"><a href="#foot_krm_0269_09">9</a></sup> काः-कौ-काः;</li> <li>  -- -- -- कातम्-कातः-कातवान्, कापितः, चिकासितः, चाकायितः-तवान्;</li> <li>  <sup id="ref_krm_0269_10"><a href="#foot_krm_0269_10">10</a></sup> प्रकः, <sup id="ref_krm_0269_11"><a href="#foot_krm_0269_11">11</a></sup> कायः, <sup id="ref_krm_0269_12"><a href="#foot_krm_0269_12">12</a></sup> नरकः-नरिका, <sup id="ref_krm_0269_13"><a href="#foot_krm_0269_13">13</a></sup> कानः, <sup id="ref_krm_0269_14"><a href="#foot_krm_0269_14">14</a></sup> ध्वाङ्क्षकायी, कापः, चिकासुः, <sup id="ref_krm_0269_15"><a href="#foot_krm_0269_15">15</a></sup> चाकः;</li> <li>  <sup id="ref_krm_0269_16"><a href="#foot_krm_0269_16">16</a></sup> कातव्यम्, कापयितव्यम्, चिकासितव्यम्, चाकायितव्यम्;</li> <li>  कानीयम्- <sup id="ref_krm_0269_17"><a href="#foot_krm_0269_17">17</a></sup> प्रकाणीयम्, कापनीयम्, चिकासनीयम्, चाकायनीयम्;</li> <li>  <sup id="ref_krm_0269_18"><a href="#foot_krm_0269_18">18</a></sup> केयम्, काप्यम्, चिकास्यम्, चाकाय्यम्;</li> <li>  <sup id="ref_krm_0269_19"><a href="#foot_krm_0269_19">19</a></sup> ईषत्कानः-दुष्कानः-सुकानः;</li> <li>  -- -- कायमानः, काप्यमानः, चिकास्यमानः, चाकाय्यमानः;</li> <li>  कायः, कापः, चिकासः, चाकायः;</li> <li>  कातुम्, कापयितुम्, चिकासितुम्, चाकायितुम्;</li> <li>  कातिः- <sup id="ref_krm_0269_20"><a href="#foot_krm_0269_20">20</a></sup> प्रका, कापना, चिकासा, चाकाया;</li> <li>  <sup id="ref_krm_0269_21"><a href="#foot_krm_0269_21">21</a></sup> प्रनिकानम्, कापनम्, चिकासनम्, चाकायनम्;</li> <li>  कात्वा, कापयित्वा, चिकासित्वा, चाकायित्वा;</li> <li>  प्रकाय, प्रकाप्य, प्रचिकास्य, प्रचाकाय्य;</li> <li>  कायम् २, कात्वा २, कापम् २, कापयित्वा २, चिकासम् २, चिकासित्वा २, चाकायम् २;</li> <li>  चाकायित्वा २;</li> <li>  <sup id="ref_krm_0269_22"><a href="#foot_krm_0269_22">22</a></sup> इत्यादिना कन् प्रत्ययः। </li> <li>काकः = वायसः।]] काकः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0269_01"><a href="#ref_krm_0269_01">↑</a> (२६३)</li> <li id="foot_krm_0269_02"><a href="#ref_krm_0269_02">↑</a> (१-भ्वादिः-९१६। अक। अनि। पर।)</li> <li id="foot_krm_0269_03"><a href="#ref_krm_0269_03">↑</a> [[१। ‘आदेच उपदेशेऽशिति’ (६-१-४५) इत्यनैमित्तिक आत्वे, ‘आतो युक् चिण्कृतोः’ (७-३-३३) इति युगागमः।]]</li> <li id="foot_krm_0269_04"><a href="#ref_krm_0269_04">↑</a> [[२। ‘अर्तिह्रीव्लीरीक्नूयीक्ष्माय्यातां पुग् णौ’ (७-३-३६) इति पुक्। एवं ण्यन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0269_05"><a href="#ref_krm_0269_05">↑</a> [[३। ‘सन्यङोः’ (६-१-९) इति द्वित्वे, ‘सन्यतः’ (७-४-७९) इत्यभ्यासस्य इत्वम्। एवं सर्वत्र सन्नन्ते बोध्यम्। धातोरनुदात्तत्वात् सन इडागमो न।]]</li> <li id="foot_krm_0269_06"><a href="#ref_krm_0269_06">↑</a> [[४। ‘दीर्घोऽकितः’ (७-४-८३) इत्यभ्यासस्य दीर्घः। एवं यङन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0269_07"><a href="#ref_krm_0269_07">↑</a> [[५। ‘आदेच उपदेशेऽशिति’ (६-१-४५) इत्यत्र ‘अशिति’ इति प्रतिषेधात् आत्वं न। ‘एचोऽयवायावः’ (६-१-७८) इत्यायादेशः।]]</li> <li id="foot_krm_0269_08"><a href="#ref_krm_0269_08">↑</a> [[६। ‘कर्तरि कर्मव्यतीहारे’ (१-३-१४) इत्यात्मनेपदम्, शानच्।]]</li> <li id="foot_krm_0269_09"><a href="#ref_krm_0269_09">↑</a> [[७। आत्वे, सोः रुत्वविसर्गयोः रूपम्।]]</li> <li id="foot_krm_0269_10"><a href="#ref_krm_0269_10">↑</a> [[८। ‘आतश्चोपसर्गे’ (३-१-१३६) इति कर्तरि कः। ‘आतो लोप इटि च’ (६-४-६४) इत्याकारलोपः।]]</li> <li id="foot_krm_0269_11"><a href="#ref_krm_0269_11">↑</a> [[९। ‘इयाऽऽद्व्यधाश्रु--’ (३-१-१४१) इत्यादिना आदन्तलक्षणो णः प्रत्ययः। युगागमः।]]</li> <li id="foot_krm_0269_12"><a href="#ref_krm_0269_12">↑</a> [[१०। ‘आतोऽनुपसर्गे कः’ (३-२-३) इति कर्मण्युपपदेऽणपवादः कः प्रत्ययः। नरान् काय- तीति नरकः। स्त्रियां, ‘मामकनरकयोरुपसंख्यानम्’ (वा। ७-३-४४) इति इत्वम्।]]</li> <li id="foot_krm_0269_13"><a href="#ref_krm_0269_13">↑</a> [[११। ‘चलनशब्दार्थादकर्मकात्--’ (३-२-१४८) इति तच्छीलादिषु कर्तृषु युच्।]]</li> <li id="foot_krm_0269_14"><a href="#ref_krm_0269_14">↑</a> [[१२। ‘कर्तर्युपमाने’ (३-२-७९) इति णिनिः। युक्। ध्वाङ्क्ष इव कायतीति ध्वाङ्- क्षकायी।]]</li> <li id="foot_krm_0269_15"><a href="#ref_krm_0269_15">↑</a> [[१३। यङन्तादचि, ‘न धातुलोप आर्धधातुके’ (१-१-४) इति सूत्रस्य प्रत्याख्यानात् पृथगल्लोपे, यङो लुकि, ‘आतो लोप इटि च’ (६-४-६४) इत्याकारलोपे च रूपम्।]]</li> <li id="foot_krm_0269_16"><a href="#ref_krm_0269_16">↑</a> [पृष्ठम्०२६८+ २४]</li> <li id="foot_krm_0269_17"><a href="#ref_krm_0269_17">↑</a> [[१। ‘कृत्यचः’ (८-४-२९) इति णत्वम्।]]</li> <li id="foot_krm_0269_18"><a href="#ref_krm_0269_18">↑</a> [[२। ‘अचो यत्’ (३-१-९७) इति यति, ‘ईद्यति’ (६-४-६५) इति धात्वाकारस्य ईकारे च गुणः।]]</li> <li id="foot_krm_0269_19"><a href="#ref_krm_0269_19">↑</a> [[३। ‘आतो युच्’ (३-३-१२८) इतीषदादिषूपपदेषु खलपवादो युच्।]]</li> <li id="foot_krm_0269_20"><a href="#ref_krm_0269_20">↑</a> [[४। ‘आतश्चोपसर्गे’ (३-३-१०६) इति स्त्रियामङ्।]]</li> <li id="foot_krm_0269_21"><a href="#ref_krm_0269_21">↑</a> [[५। ‘शेषे विभाषाऽकखादावषान्त उपदेशे’ (८-४-१८) इति पर्युदासाण्णत्वं न।]]</li> <li id="foot_krm_0269_22"><a href="#ref_krm_0269_22">↑</a> [[६। ‘इण्भीकापा--’ [द। उ। ३-२१]</li></ul></p>

