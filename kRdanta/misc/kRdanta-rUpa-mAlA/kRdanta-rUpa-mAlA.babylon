<ul><li><sup id="ref_krm_0642_01"><a href="#foot_krm_0642_01">1</a></sup> {@“ज्वल दीप्तौ”@} <sup id="ref_krm_0642_02"><a href="#foot_krm_0642_02">2</a></sup> घटादिः, ज्वलादिश्च। </li> <li>ज्वालकः-लिका, <sup id="ref_krm_0642_03"><a href="#foot_krm_0642_03">3</a></sup> ज्वलकः-ज्वालकः, <sup id="ref_krm_0642_04"><a href="#foot_krm_0642_04">4</a></sup> प्रज्वलकः-लिका, जिज्वलिषकः-षिका, जाज्वलकः-लिका;</li> <li>  ज्वलिता-त्री, ज्वलयिता-ज्वालयिता-प्रज्वलयिता-त्री, जिज्वलिषिता-त्री, जाज्वलिता-त्री;</li> <li>  ज्वलन्-न्ती, ज्वलयन्-ज्वालयन्-प्रज्वलयन्-न्ती, जिज्वलिषन्-न्ती;</li> <li>  -- ज्वलिष्यन्-न्ती-ती, ज्वलयिष्यन्-ज्वालयिष्यन्-प्रज्वलयिष्यन्-न्ती-ती, जिज्वलिषिष्यन्-न्ती-ती;</li> <li>  -- -- ज्वलयमानः-ज्वालयमानः-प्रज्वलयमानः, -- <sup id="ref_krm_0642_05"><a href="#foot_krm_0642_05">5</a></sup> जाज्वल्यमानः;</li> <li>  <sup id="ref_krm_0642_06"><a href="#foot_krm_0642_06">6</a></sup> -- ज्वलयिष्यमाणः-ज्वालयिष्यमाणः-प्रज्वलयिष्यमाणः, -- जाज्वलिष्यमाणः;</li> <li>  <sup id="ref_krm_0642_07"><a href="#foot_krm_0642_07">7</a></sup> ज्वल्-ज्वलौ-ज्वलः;</li> <li>  -- -- -- ज्वलितम्-तः, ज्वलितः-ज्वालितः- <sup id="ref_krm_0642_08"><a href="#foot_krm_0642_08">8</a></sup> प्रज्वलितः, जिज्वलिषितः, जाज्वलितः-तवान्;</li> <li>  <sup id="ref_krm_0642_09"><a href="#foot_krm_0642_09">9</a></sup> ज्वालः- <sup id="ref_krm_0642_10"><a href="#foot_krm_0642_10">10</a></sup> ज्वाला, ज्वलः, <sup id="ref_krm_0642_11"><a href="#foot_krm_0642_11">11</a></sup> <sup id="ref_krm_0642_12"><a href="#foot_krm_0642_12">12</a></sup> ज्वलनः, <sup id="ref_krm_0642_13"><a href="#foot_krm_0642_13">13</a></sup> प्रज्वाली, ज्वलः-ज्वालः, जिज्वलिषुः, जाज्वलः;</li> <li>  ज्वलितव्यम्, ज्वलयितव्यम्-ज्वालयितव्यम्-प्रज्वलयितव्यम्, जिज्वलिषितव्यम्, जाज्वलितव्यम्;</li> <li>  ज्वलनीयम्, ज्वलनीयम्-ज्वालनीयम्-प्रज्वलनीयम्, जिज्वलिषणीयम्, जाज्वलनीयम्;</li> <li>  ज्वाल्यम्, ज्वल्यम्-ज्वाल्यम्-प्रज्वल्यम्, जिज्वलिष्यम्, जाज्वल्यम्;</li> <li>  ईषज्ज्वलः-दुर्ज्वलः-सुज्वलः;</li> <li>  -- -- -- ज्वल्यमानः, ज्वल्यमानः-ज्वाल्यमानः-प्रज्वल्यमानः, जिज्वलिष्यमाणः, जाज्वल्यमानः;</li> <li>  ज्वालः, ज्वलः-ज्वालः-प्रज्वलः, जिज्वलिषः, जाज्वलः;</li> <li>  ज्वलितुम्, ज्वलयितुम्-ज्वालयितुम्-प्रज्वलयितुम्, जिज्वलिषितुम्, जाज्वलितुम्;</li> <li>  <sup id="ref_krm_0642_14"><a href="#foot_krm_0642_14">14</a></sup> ज्वलितिः, ज्वलना-ज्वालना-प्रज्वलना, जिज्वलिषा, जाज्वला;</li> <li>  <sup id="ref_krm_0642_15"><a href="#foot_krm_0642_15">15</a></sup> ज्वलनम्, ज्वलनम्-ज्वालनम्-प्रज्वलनम्, जिज्वलिषणम्, जाज्वलनम्;</li> <li>  ज्वलित्वा, ज्वलयित्वा-ज्वालयित्वा, जिज्वलिषित्वा, जाज्वलित्वा;</li> <li>  प्रज्वल्य, <sup id="ref_krm_0642_16"><a href="#foot_krm_0642_16">16</a></sup> संज्वलय्य-प्रज्वलय्य, प्रजिज्वलिष्य, प्रजाज्वल्य;</li> <li>  ज्वालम् २, ज्वलित्वा २, <sup id="ref_krm_0642_17"><a href="#foot_krm_0642_17">17</a></sup> ज्वलम् २-ज्वालम् २, प्रज्वलम् २, ज्वलयित्वा २-ज्वालयित्वा २, जिज्वलिषम् २, जिज्वलिषित्वा २, जाज्वलम् २;</li> <li>  जाज्वलित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0642_01"><a href="#ref_krm_0642_01">↑</a> (६३२)</li> <li id="foot_krm_0642_02"><a href="#ref_krm_0642_02">↑</a> (१-भ्वादिः-८३१-८०४। अक। सेट्। पर।)</li> <li id="foot_krm_0642_03"><a href="#ref_krm_0642_03">↑</a> [[५। ‘ज्वलह्वलह्मलनमामनुपसर्गाद्वा’ (गणसूत्रं घटादौ) इति अनुपसृष्टे मित्संज्ञा विकल्पिता। मित्त्वपक्षे, ‘मितां ह्रस्वः’ (६-४-९२) इति ह्रस्वः। मित्त्वाभावपक्षे, उपधावृद्धिः। एवम् अनुपसृष्टे ण्यन्ते सर्वत्र रूपत्रयं ज्ञेयम्।]]</li> <li id="foot_krm_0642_04"><a href="#ref_krm_0642_04">↑</a> [[६। उपसर्गसमभिव्याहारे तु घटादिषु पाठान्नित्यं मित्संज्ञा। तदानीं प्रज्वलकः, सञ्ज्वलकः इत्यादीनि रूपाणि ण्यन्ताद्भवन्ति। एवं सोपसर्गाण्ण्यन्ते सर्वत्र मित्कार्यं ज्ञेयम्।]]</li> <li id="foot_krm_0642_05"><a href="#ref_krm_0642_05">↑</a> [[B। ‘जाज्वल्यमाना जगतः शान्तये समुपेयुषी।’ शिशुपालवधे २। ३।]]</li> <li id="foot_krm_0642_06"><a href="#ref_krm_0642_06">↑</a> [पृष्ठम्०६०१+ २२]</li> <li id="foot_krm_0642_07"><a href="#ref_krm_0642_07">↑</a> [[१। ‘न पदान्ताः परेऽणः सन्ति’ इति पक्षो भाष्यासम्मतः। अतोऽत्र पदान्ते लकारश्रवणं न दोषाय।]]</li> <li id="foot_krm_0642_08"><a href="#ref_krm_0642_08">↑</a> [[आ। ‘वनाम किं प्रज्वलितो हरेण सोऽद्यापि यद्विह्वलयन्ननङ्गः।।’ धा। का। २। १०।]]</li> <li id="foot_krm_0642_09"><a href="#ref_krm_0642_09">↑</a> [[२। ‘ज्वलितिकसन्तेभ्यो णः’ (३-१-१४०) इति कर्तरि वा णप्रत्ययो भवति। स्त्रियां ‘अजाद्यतष्टाप्’ (४-१-४) इति टाप्। णप्रत्ययाभावपक्षे तु पचाद्यचि (३-१-१३४), ज्वलः इत्यपि भवति।]]</li> <li id="foot_krm_0642_10"><a href="#ref_krm_0642_10">↑</a> [[B। ‘ज्वालेन तापेन चला जडाङ्गीरटालशोकट्वलितप्रतापाः।।’ धा। का। २। २१।]]</li> <li id="foot_krm_0642_11"><a href="#ref_krm_0642_11">↑</a> [[C। ‘लिम्पैरिव तनोर्वातैश्चेतयः स्याज्ज्वलो न कः।।’ भ। का। ६। ८०।]]</li> <li id="foot_krm_0642_12"><a href="#ref_krm_0642_12">↑</a> [[३। ‘जुचङ्क्रम्यदन्द्रम्यसृगृधिज्वलशुचलषपतपदः’ (३-२-१५०) इति ताच्छीलिको युच्। अनादेशः। ज्वलनः = अग्निः।]]</li> <li id="foot_krm_0642_13"><a href="#ref_krm_0642_13">↑</a> [[४। ‘सुप्यजातौ--’ (३-२-७८) इति ताच्छील्ये णिनिः।]]</li> <li id="foot_krm_0642_14"><a href="#ref_krm_0642_14">↑</a> [[५। ‘तितुत्रेष्वग्रहादीनामिति वक्तव्यम्’ (वा। ७-२-९) इति पर्युदासात् भणितिः इत्यत्रेव इडागमो भवति।]]</li> <li id="foot_krm_0642_15"><a href="#ref_krm_0642_15">↑</a> [पृष्ठम्०६०२+ २३]</li> <li id="foot_krm_0642_16"><a href="#ref_krm_0642_16">↑</a> [[१। ‘ल्यपि लघुपूर्वात्’ (६-४-५६) इति णेरयादेशः।]]</li> <li id="foot_krm_0642_17"><a href="#ref_krm_0642_17">↑</a> [[२। ‘चिण्णमुलोः--’ (६-४-९३) इति णमुल्परे णौ दीर्घविकल्पः।]]</li></ul></p>

झट|झाटकः-टिका|जिझटिषकः-षिका|जाझटकः-टिका
<ul><li><sup id="ref_krm_0643_01"><a href="#foot_krm_0643_01">1</a></sup> {@“झट सङ्घाते”@} <sup id="ref_krm_0643_02"><a href="#foot_krm_0643_02">2</a></sup> सङ्घातः = संहननम्, मिश्रीकरणं च। </li> <li>झाटकः-टिका, झाटकः-टिका, जिझटिषकः-षिका, जाझटकः-टिका;</li> <li>  <sup id="ref_krm_0643_03"><a href="#foot_krm_0643_03">3</a></sup> झाटः, इत्यादीनि सर्वाण्यपि रूपणि भौवादिककठतिवत् <sup id="ref_krm_0643_04"><a href="#foot_krm_0643_04">4</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0643_01"><a href="#ref_krm_0643_01">↑</a> (६३३)</li> <li id="foot_krm_0643_02"><a href="#ref_krm_0643_02">↑</a> (१-भ्वादिः-३०६। अक। सेट्। पर।)</li> <li id="foot_krm_0643_03"><a href="#ref_krm_0643_03">↑</a> [[आ। ‘अशेटनीयैः सुधियामसेटकैर्युतान् जटाझाटधरैश्च कैश्चन।।’ धा। का। १। ४०।]]</li> <li id="foot_krm_0643_04"><a href="#ref_krm_0643_04">↑</a> (१४८)</li></ul></p>

झमु|झमकः-मिका|जिझमिषकः-षिका|जञ्झमकः-मिका|झमिता-त्री|झमयिता-त्री|जिझमिषिता-त्री|जञ्झमिता-त्री
<ul><li><sup id="ref_krm_0644_01"><a href="#foot_krm_0644_01">1</a></sup> {@“झमु अदने”@} <sup id="ref_krm_0644_02"><a href="#foot_krm_0644_02">2</a></sup> मित्। </li> <li>झमकः-मिका, झमकः-मिका, <sup id="ref_krm_0644_03"><a href="#foot_krm_0644_03">3</a></sup> जिझमिषकः-षिका, जञ्झमकः-मिका;</li> <li>  झमिता-त्री, झमयिता-त्री, जिझमिषिता-त्री, जञ्झमिता-त्री;</li> <li>  <sup id="ref_krm_0644_04"><a href="#foot_krm_0644_04">4</a></sup> झमन्-न्ती, इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकछमतिवत् <sup id="ref_krm_0644_05"><a href="#foot_krm_0644_05">5</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0644_01"><a href="#ref_krm_0644_01">↑</a> (६३४)</li> <li id="foot_krm_0644_02"><a href="#ref_krm_0644_02">↑</a> (१-भ्वादिः-४७२। सक। सेट्। पर।)</li> <li id="foot_krm_0644_03"><a href="#ref_krm_0644_03">↑</a> [[३। सनि, ‘छे च’ (६-१-७३) इति तुक् नात्र प्रवर्तते, इति छमुधातोः, अस्य च विशेषः।]]</li> <li id="foot_krm_0644_04"><a href="#ref_krm_0644_04">↑</a> [[B। ‘चान्तामिषश्छान्तजलः फलावलीं जान्त्वा झमञ्जेमनमक्रमीद् गुहाम्।।’ धा। का। १। ६०।]]</li> <li id="foot_krm_0644_05"><a href="#ref_krm_0644_05">↑</a> (५६४)</li></ul></p>

झर्झ|झर्झकः-र्झिका|जिझर्झिषकः-षिका|जाझर्झकः-र्झिका
<ul><li><sup id="ref_krm_0645_01"><a href="#foot_krm_0645_01">1</a></sup> {@“झर्झ परिभाषणहिंसातर्जनेषु”@} <sup id="ref_krm_0645_02"><a href="#foot_krm_0645_02">2</a></sup> झर्झकः-र्झिका, झर्झकः-र्झिका, जिझर्झिषकः-षिका, जाझर्झकः-र्झिका;</li> <li>  झर्झन्-न्ती, <sup id="ref_krm_0645_03"><a href="#foot_krm_0645_03">3</a></sup> झर्झरः <sup id="ref_krm_0645_04"><a href="#foot_krm_0645_04">4</a></sup>, इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकचर्चतिवत् <sup id="ref_krm_0645_05"><a href="#foot_krm_0645_05">5</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0645_06"><a href="#foot_krm_0645_06">6</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0645_01"><a href="#ref_krm_0645_01">↑</a> (६३५)</li> <li id="foot_krm_0645_02"><a href="#ref_krm_0645_02">↑</a> (१-भ्वादिः-७१८। सक। सेट्। पर।)</li> <li id="foot_krm_0645_03"><a href="#ref_krm_0645_03">↑</a> [[४। बाहुलकात् अरः = झर्झरः = वाद्यविशेषः।]]</li> <li id="foot_krm_0645_04"><a href="#ref_krm_0645_04">↑</a> [[C। ‘जीमूतचर्चिरवझर्झरवाद्यहृद्यं तेनैव चानुपिसितो निलयं पिपेस।।’ धा। का। १। ८९।]]</li> <li id="foot_krm_0645_05"><a href="#ref_krm_0645_05">↑</a> (५०५)</li> <li id="foot_krm_0645_06"><a href="#ref_krm_0645_06">↑</a> [पृष्ठम्०६०३+ २७]</li></ul></p>

झर्झ
<ul><li><sup id="ref_krm_0646_01"><a href="#foot_krm_0646_01">1</a></sup> {@“झर्झ परिभाषणभर्त्सनयोः”@} <sup id="ref_krm_0646_02"><a href="#foot_krm_0646_02">2</a></sup> शत्रन्तात् स्त्रियां परं झर्झन्ती- <sup id="ref_krm_0646_03"><a href="#foot_krm_0646_03">3</a></sup> झर्झती, इति रूपम्। </li> <li>अन्यानि सर्वाण्यपि रूपाणि भौवादिकचर्चतिवत् <sup id="ref_krm_0646_04"><a href="#foot_krm_0646_04">4</a></sup> बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0646_01"><a href="#ref_krm_0646_01">↑</a> (६३६)</li> <li id="foot_krm_0646_02"><a href="#ref_krm_0646_02">↑</a> (६-तुदादिः-१३००। सक। सेट्। पर।)</li> <li id="foot_krm_0646_03"><a href="#ref_krm_0646_03">↑</a> [[आ। ‘चर्चन्ती कटु झर्झती बुधजनं दोषं त्वचि त्वर्चती नित्यं भूपतिमुब्जनोज्झितमना यत्रास्त खल्या सुखम्।।’ धा। का। २। ७३।]]</li> <li id="foot_krm_0646_04"><a href="#ref_krm_0646_04">↑</a> (५०५)</li></ul></p>

झष|झाषकः-षिका|जिझषिषकः-षिका|जाझषकः-षिका
<ul><li><sup id="ref_krm_0647_01"><a href="#foot_krm_0647_01">1</a></sup> {@“झष हिंसार्थः”@} <sup id="ref_krm_0647_02"><a href="#foot_krm_0647_02">2</a></sup> ‘झषेज्झषेत संवृत्यामादाने, हिंसने झषेत्।’ <sup id="ref_krm_0647_03"><a href="#foot_krm_0647_03">3</a></sup> इति देवः। </li> <li>झाषकः-षिका, झाषकः-षिका, जिझषिषकः-षिका, जाझषकः-षिका;</li> <li>  <sup id="ref_krm_0647_04"><a href="#foot_krm_0647_04">4</a></sup> झषः, इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकखषतिवत् <sup id="ref_krm_0647_05"><a href="#foot_krm_0647_05">5</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0647_01"><a href="#ref_krm_0647_01">↑</a> (६३७)</li> <li id="foot_krm_0647_02"><a href="#ref_krm_0647_02">↑</a> (१-भ्वादिः-६८९। सक। सेट्। पर।)</li> <li id="foot_krm_0647_03"><a href="#ref_krm_0647_03">↑</a> (श्लो। १६८)</li> <li id="foot_krm_0647_04"><a href="#ref_krm_0647_04">↑</a> [[B। ‘इत्युक्तः सुरकाषिखाषिणमसावूचे जगच्छेषकान् नित्यं ते जषते झषा दिवपुषे रक्षश्चमूशाषिणे।’ धा। का। १। ८७।]]</li> <li id="foot_krm_0647_05"><a href="#ref_krm_0647_05">↑</a> (३४६)</li></ul></p>

झष|झाषकः-षिका|जिझषिषकः-षिका|जाझषकः-षिका
<ul><li><sup id="ref_krm_0648_01"><a href="#foot_krm_0648_01">1</a></sup> {@“झष आदानसंवरणयोः”@} <sup id="ref_krm_0648_02"><a href="#foot_krm_0648_02">2</a></sup> ‘झषेज्झषेत संवृत्यामादाने, हिंसने झषेत्।’ <sup id="ref_krm_0648_03"><a href="#foot_krm_0648_03">3</a></sup> इति देवः। </li> <li>झाषकः-षिका, झाषकः-षिका, जिझषिषकः-षिका, जाझषकः-षिका;</li> <li>  झषन्-न्ती, झषमाणः, <sup id="ref_krm_0648_04"><a href="#foot_krm_0648_04">4</a></sup> झषित्वा, इत्यादीनि सर्वाण्यपि रूपाणि भौवादिक- चषतिवत् <sup id="ref_krm_0648_05"><a href="#foot_krm_0648_05">5</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0648_01"><a href="#ref_krm_0648_01">↑</a> (६३८)</li> <li id="foot_krm_0648_02"><a href="#ref_krm_0648_02">↑</a> (१-भ्वादिः-८९१। सक। सेट्। उभ।)</li> <li id="foot_krm_0648_03"><a href="#ref_krm_0648_03">↑</a> (श्लो। १६८)</li> <li id="foot_krm_0648_04"><a href="#ref_krm_0648_04">↑</a> [[C। ‘लाषेण चाषांश्छषितान् झषित्वा प्रभ्लक्ष्य भक्षन्ति यदम्बु नीचाः।’ धा। का। २। २८।]]</li> <li id="foot_krm_0648_05"><a href="#ref_krm_0648_05">↑</a> (५१३)</li></ul></p>

झॄ|झारकः-रिका|जिझरीषकः-जिझरिषकः-जिझीर्षकः-षिका|जेझिरकः-रिका
<ul><li><sup id="ref_krm_0649_01"><a href="#foot_krm_0649_01">1</a></sup> {@“झॄ वयोहानौ”@} <sup id="ref_krm_0649_02"><a href="#foot_krm_0649_02">2</a></sup> प्वादिः, ल्वादिश्च। </li> <li>‘जॄ वयोहानौ’ <sup id="ref_krm_0649_03"><a href="#foot_krm_0649_03">3</a></sup> इत्यस्य पाठभेदोऽयम्। </li> <li>झारकः-रिका, झारकः-रिका, जिझरीषकः-जिझरिषकः-जिझीर्षकः-षिका, जेझिरकः-रिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि क्रैयादिकजृणातिवत् <sup id="ref_krm_0649_04"><a href="#foot_krm_0649_04">4</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0649_01"><a href="#ref_krm_0649_01">↑</a> (६३९)</li> <li id="foot_krm_0649_02"><a href="#ref_krm_0649_02">↑</a> (९-क्र्यादिः-१४९४। अक। सेट्। पर।)</li> <li id="foot_krm_0649_03"><a href="#ref_krm_0649_03">↑</a> (६१८)</li> <li id="foot_krm_0649_04"><a href="#ref_krm_0649_04">↑</a> (६१८)</li></ul></p>

झॄष्|झारकः-रिका|जिझरीषकः-जिझरिषकः-जिझीर्षकः-र्षिका|जेझिरकः-रिका
<ul><li><sup id="ref_krm_0650_01"><a href="#foot_krm_0650_01">1</a></sup> {@“झॄष् वयोहानौ”@} <sup id="ref_krm_0650_02"><a href="#foot_krm_0650_02">2</a></sup> झारकः-रिका, झारकः-रिका, जिझरीषकः-जिझरिषकः-जिझीर्षकः-र्षिका, जेझिरकः-रिका;</li> <li>  <sup id="ref_krm_0650_03"><a href="#foot_krm_0650_03">3</a></sup> अझीर्णम्, इत्यादीनि रूपाणि दैवादिकजीर्यतिवत् <sup id="ref_krm_0650_04"><a href="#foot_krm_0650_04">4</a></sup> <sup id="ref_krm_0650_05"><a href="#foot_krm_0650_05">5</a></sup> ज्ञेयानि। </li> <li>जीर्यतेर्मित्त्वाण्णौ मितां ह्रस्वो भवति, अस्य तु नेति विशेषः। </li> <li><sup id="ref_krm_0650_06"><a href="#foot_krm_0650_06">6</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0650_01"><a href="#ref_krm_0650_01">↑</a> (६४०)</li> <li id="foot_krm_0650_02"><a href="#ref_krm_0650_02">↑</a> (४-दिवादिः-११३१। अक। सेट्। पर।)</li> <li id="foot_krm_0650_03"><a href="#ref_krm_0650_03">↑</a> [[ड्। ‘देहि प्रभोः प्रैष्य सुसोहनाय मे जीर्णांशुकायः त्वमझीर्णमंशुकम्।।’ धा। का। २। ५७।]]</li> <li id="foot_krm_0650_04"><a href="#ref_krm_0650_04">↑</a> (६२०)</li> <li id="foot_krm_0650_05"><a href="#ref_krm_0650_05">↑</a> (‘जॄष्’ इति धातुस्वरूपोपादानेन विहितानि कार्याणि विना)</li> <li id="foot_krm_0650_06"><a href="#ref_krm_0650_06">↑</a> [पृष्ठम्०६०४+ २७]</li></ul></p>

टकि|टङ्ककः-ङ्किका|टिटङ्कयिषकः-षिका|टिटङ्किषकः-षिका|टाटङ्ककः-ङ्किका
<ul><li><sup id="ref_krm_0651_01"><a href="#foot_krm_0651_01">1</a></sup> {@“टकि बन्धने”@} <sup id="ref_krm_0651_02"><a href="#foot_krm_0651_02">2</a></sup> टङ्ककः-ङ्किका, टिटङ्कयिषकः-षिका, <sup id="ref_krm_0651_03"><a href="#foot_krm_0651_03">3</a></sup> टङ्ककः-ङ्किका, टिटङ्किषकः-षिका, टाटङ्ककः-ङ्किका;</li> <li>  <sup id="ref_krm_0651_04"><a href="#foot_krm_0651_04">4</a></sup> विटङ्कः, <sup id="ref_krm_0651_05"><a href="#foot_krm_0651_05">5</a></sup> <sup id="ref_krm_0651_06"><a href="#foot_krm_0651_06">6</a></sup> टङ्कः, इत्यादीनि सर्वाण्यपि रूपाणि चौरादि- कचम्पयतिवत् <sup id="ref_krm_0651_07"><a href="#foot_krm_0651_07">7</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0651_01"><a href="#ref_krm_0651_01">↑</a> (६४१)</li> <li id="foot_krm_0651_02"><a href="#ref_krm_0651_02">↑</a> (१०-चुरादिः-१६३९। सक। सेट्। उभ।)</li> <li id="foot_krm_0651_03"><a href="#ref_krm_0651_03">↑</a> [[१। इदित्करणाण्णिचो विकल्पः। तेन णिजभावपक्षे क्रमेण शुद्धात् सन्नन्तात् यङन्ताच्च रूपाणि।]]</li> <li id="foot_krm_0651_04"><a href="#ref_krm_0651_04">↑</a> [[२। वीन् = पक्षिणः टङ्कयति = बध्नातीति विटङ्कः = कपोतपालिका। ‘कर्मण्यण्’ (३-२-१) इत्यण्। ‘कपोतपालिकायां तु विटङ्कं पुन्नपुंसकम्।’ इत्यमरः।]]</li> <li id="foot_krm_0651_05"><a href="#ref_krm_0651_05">↑</a> [[आ। ‘सौधे विटङ्कजुषि पश्यति धूसितोऽयं राजारिकीटबलचूर्णनयाऽतिपूज्यः।’ धा। का। ३। २७।]]</li> <li id="foot_krm_0651_06"><a href="#ref_krm_0651_06">↑</a> [[३। टङ्कयन्त्यनेनेति टङ्कः = आयुधविशेषः। संज्ञायां घः।]]</li> <li id="foot_krm_0651_07"><a href="#ref_krm_0651_07">↑</a> (४९९)</li></ul></p>

टल|टालकः-लिका|टिटलिषकः-षिका|टाटलकः-लिका
<ul><li><sup id="ref_krm_0652_01"><a href="#foot_krm_0652_01">1</a></sup> {@“टल वैक्लब्ये”@} <sup id="ref_krm_0652_02"><a href="#foot_krm_0652_02">2</a></sup> ‘--वैप्लव्ये’, विप्लव एव वैप्लव्यम्’ इति क्षीरस्वामी। </li> <li>‘वैकल्ये’ इति धातुकाव्ये <sup id="ref_krm_0652_03"><a href="#foot_krm_0652_03">3</a></sup>। </li> <li>टालकः-लिका, टालकः-लिका, टिटलिषकः-षिका, टाटलकः-लिका;</li> <li>  <sup id="ref_krm_0652_04"><a href="#foot_krm_0652_04">4</a></sup> टालः-टलः, इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकचलधातुवत् <sup id="ref_krm_0652_05"><a href="#foot_krm_0652_05">5</a></sup> ज्ञेयानि। </li> <li>घटादिकार्यं तु नास्य भवतीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0652_01"><a href="#ref_krm_0652_01">↑</a> (६४२)</li> <li id="foot_krm_0652_02"><a href="#ref_krm_0652_02">↑</a> (१-भ्वादिः-८३४। अक। सेट्। पर। ज्वलादिः।)</li> <li id="foot_krm_0652_03"><a href="#ref_krm_0652_03">↑</a> (२-२१)</li> <li id="foot_krm_0652_04"><a href="#ref_krm_0652_04">↑</a> [[B। ‘ज्वालेन तापेन चला जडाङ्गीरटालशोकट्वलितप्रतापाः।।’ धा। का। २। २१।]]</li> <li id="foot_krm_0652_05"><a href="#ref_krm_0652_05">↑</a> (५१०)</li></ul></p>

टिकृ|टेककः-किका|टिटेकिषकः-टिटिकिषकः-षिका|टेटिककः-किका
<ul><li><sup id="ref_krm_0653_01"><a href="#foot_krm_0653_01">1</a></sup> {@“टिकृ गतौ”@} <sup id="ref_krm_0653_02"><a href="#foot_krm_0653_02">2</a></sup> टेककः-किका, टेककः-किका, टिटेकिषकः-टिटिकिषकः-षिका, टेटिककः-किका;</li> <li>  इत्यादीनि सर्बाण्यपि रूपाणि भौवादिककिटघातुवत् <sup id="ref_krm_0653_03"><a href="#foot_krm_0653_03">3</a></sup> ज्ञेयानि। </li> <li>अस्य घातोरात्मनेपदित्वात् टेकमानः, इति शानचि रूपमिति तस्मादस्य विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0653_01"><a href="#ref_krm_0653_01">↑</a> (६४३)</li> <li id="foot_krm_0653_02"><a href="#ref_krm_0653_02">↑</a> (१-भ्वादिः-१०३। सक। सेट्। आत्म।)</li> <li id="foot_krm_0653_03"><a href="#ref_krm_0653_03">↑</a> (१९०)</li></ul></p>

टीकृ|टीककः-किका|टिटीकिषकः-षिका|टेटीककः-किका|टीका
<ul><li><sup id="ref_krm_0654_01"><a href="#foot_krm_0654_01">1</a></sup> {@“टीकृ गतौ”@} <sup id="ref_krm_0654_02"><a href="#foot_krm_0654_02">2</a></sup> टीककः-किका, टीककः-किका, टिटीकिषकः-षिका, टेटीककः-किका, <sup id="ref_krm_0654_03"><a href="#foot_krm_0654_03">3</a></sup> टीका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकचीभतिवत् <sup id="ref_krm_0654_04"><a href="#foot_krm_0654_04">4</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0654_01"><a href="#ref_krm_0654_01">↑</a> (६४४)</li> <li id="foot_krm_0654_02"><a href="#ref_krm_0654_02">↑</a> (१-भ्वादिः-१०४। सक। सेट्। आत्म।)</li> <li id="foot_krm_0654_03"><a href="#ref_krm_0654_03">↑</a> [[४। ‘गुरोश्च हलः’ (३-३-१०३) इति स्त्रियामकारप्रत्ययः। टीका = व्याख्या।]]</li> <li id="foot_krm_0654_04"><a href="#ref_krm_0654_04">↑</a> (५३०)</li></ul></p>

ट्वल|ट्वालकः-लिका|टिट्वलिषकः-षिका|टाट्वलकः-लिका
<ul><li><sup id="ref_krm_0655_01"><a href="#foot_krm_0655_01">1</a></sup> {@“ट्वल वैक्लब्ये”@} <sup id="ref_krm_0655_02"><a href="#foot_krm_0655_02">2</a></sup> ज्वलादिः। </li> <li>ट्वालकः-लिका, ट्वालकः-लिका, टिट्वलिषकः-षिका, टाट्वलकः-लिका;</li> <li>  <sup id="ref_krm_0655_03"><a href="#foot_krm_0655_03">3</a></sup> <sup id="ref_krm_0655_04"><a href="#foot_krm_0655_04">4</a></sup> ट्वलितः, इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकचलतिवत् <sup id="ref_krm_0655_05"><a href="#foot_krm_0655_05">5</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0655_01"><a href="#ref_krm_0655_01">↑</a> (६४५)</li> <li id="foot_krm_0655_02"><a href="#ref_krm_0655_02">↑</a> (१-भ्वादिः-८३५। अक। सेट्। पर।)</li> <li id="foot_krm_0655_03"><a href="#ref_krm_0655_03">↑</a> [पृष्ठम्०६०५+ २४]</li> <li id="foot_krm_0655_04"><a href="#ref_krm_0655_04">↑</a> [[आ। ‘ज्वालेन तापेन चला जडाङ्गीरटालशोकट्वलितप्रतापाः।।’ धा। का। २। २१।]]</li> <li id="foot_krm_0655_05"><a href="#ref_krm_0655_05">↑</a> (५१०)</li></ul></p>

डप
<ul><li><sup id="ref_krm_0656_01"><a href="#foot_krm_0656_01">1</a></sup> {@“डप सङ्घाते”@} <sup id="ref_krm_0656_02"><a href="#foot_krm_0656_02">2</a></sup> डापकः-पिका, डिडापयिषकः-षिका, डापयमानः, इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकगालयतिवत् <sup id="ref_krm_0656_03"><a href="#foot_krm_0656_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0656_04"><a href="#foot_krm_0656_04">4</a></sup> संडापितः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0656_01"><a href="#ref_krm_0656_01">↑</a> (६४६)</li> <li id="foot_krm_0656_02"><a href="#ref_krm_0656_02">↑</a> (१०-चुरादिः-१६७७। अक। सेट्। आत्म। आकुस्मीयः)</li> <li id="foot_krm_0656_03"><a href="#ref_krm_0656_03">↑</a> (३८८)</li> <li id="foot_krm_0656_04"><a href="#ref_krm_0656_04">↑</a> [[B। ‘संडापितः सदसि डेपितवृष्णिवीरे भोजेन्द्रतन्त्रणविनिन्द्यममन्त्रतैवम्।।’ धा। का। ३। ३३।]]</li></ul></p>

डिप|डेपकः-पिका|डिडेपिषकः-डिडिपिषकः-षिका|डेडिपकः-पिका
<ul><li><sup id="ref_krm_0657_01"><a href="#foot_krm_0657_01">1</a></sup> {@“डिप क्षेपे”@} <sup id="ref_krm_0657_02"><a href="#foot_krm_0657_02">2</a></sup> ‘सङ्घाते डेपयेतेति, क्षेपे डिपति डिप्यति।’ <sup id="ref_krm_0657_03"><a href="#foot_krm_0657_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_0657_04"><a href="#foot_krm_0657_04">4</a></sup> डेपकः-पिका, डेपकः-पिका, डिडेपिषकः-डिडिपिषकः-षिका, डेडिपकः-पिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि दैवादिककुप्यतिवत् <sup id="ref_krm_0657_05"><a href="#foot_krm_0657_05">5</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0657_01"><a href="#ref_krm_0657_01">↑</a> (६४७)</li> <li id="foot_krm_0657_02"><a href="#ref_krm_0657_02">↑</a> (४-दिवादिः-१२३२। सक। सेट्। पर।)</li> <li id="foot_krm_0657_03"><a href="#ref_krm_0657_03">↑</a> (श्लो० १३४)</li> <li id="foot_krm_0657_04"><a href="#ref_krm_0657_04">↑</a> [[C। ‘रुष्यद्रिष्यदरातिडेपक विभो कोपादिगोपो न ते किञ्चायोप्यविरोपिलोपक न वा लोभादिसंक्षोभिता।’ धा। का। २। ६७।]]</li> <li id="foot_krm_0657_05"><a href="#ref_krm_0657_05">↑</a> (२२४)</li></ul></p>

डिप|डेपकः-पिका|डिडिपिषकः-षिका|डेडिपकः-पिका
<ul><li><sup id="ref_krm_0658_01"><a href="#foot_krm_0658_01">1</a></sup> {@“डिप क्षेपे”@} <sup id="ref_krm_0658_02"><a href="#foot_krm_0658_02">2</a></sup> डेपकः-पिका, डेपकः-पिका, डिडिपिषकः-षिका, डेडिपकः-पिका;</li> <li>  <sup id="ref_krm_0658_03"><a href="#foot_krm_0658_03">3</a></sup> डिपन्-न्ती-ती, डिपित्वा, इत्यादीनि सर्वाण्यपि रूपाणि तौदादिककुटतिवत् <sup id="ref_krm_0658_04"><a href="#foot_krm_0658_04">4</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0658_01"><a href="#ref_krm_0658_01">↑</a> (६४८)</li> <li id="foot_krm_0658_02"><a href="#ref_krm_0658_02">↑</a> (६-तुदादिः-१३७१। सक। सेट्। पर। कुटादिः।)</li> <li id="foot_krm_0658_03"><a href="#ref_krm_0658_03">↑</a> [[ड्। ‘ततोऽतिकुटिलाशयैः प्रपुटितैः कुचज्जीवितै- र्गुजद्भिरपि सैनिकैः सुगुडितां डिपद्भिर्जनान्।’ धा। का। २-८०।]]</li> <li id="foot_krm_0658_04"><a href="#ref_krm_0658_04">↑</a> (२०४)</li></ul></p>

डिप|डेपकः-पिका|डिडेपयिषकः-षिका|डेपयिता-त्री|डिडेपयिषिता-त्री|डेपयन्-न्ती|डिडेपयिषन्-न्ती|डेपयिष्यन्-न्ती-ती|डिडेपयिषिष्यन्-न्ती-ती|डेपयमानः|डिडेपयिषमाणः|डेपयिष्यमाणः|डिडेपयिषिष्यमाणः|डेप्-|डेपौ-डेपः|डेपितम्-तः|डिडेपयिषितः-तवान्|डेपः|प्रतिमल्लडेपी|डिडेपयिषुः|डेपयितव्यम्|डिडेपयिषितव्यम्|डेपनीयम्|डिडेपयिषणीयम्|डेप्यम्|डिडेपयिष्यम्|ईषड्डेपः-दुर्डेपः-सुडेपः|डेप्यमानः|डिडेपयिष्यमाणः|डिडेपयिषः|डेपयितुम्|डिडेपयिषितुम्|डेपना|डिडेपयिषा|डेपनम्|डिडेपयिषणम्|डेपयित्वा|डिडेपयिषित्वा|प्रडेप्य|प्रडिडेपयिष्य|डेपम्|डिडेपयिषम्
<ul><li><sup id="ref_krm_0659_01"><a href="#foot_krm_0659_01">1</a></sup> {@“डिप क्षेपे”@} <sup id="ref_krm_0659_02"><a href="#foot_krm_0659_02">2</a></sup> ‘डेपयेदिति चत्वारि णिचि शे श्यनि णौ डिपेः।।’ <sup id="ref_krm_0659_03"><a href="#foot_krm_0659_03">3</a></sup> इति देवः। </li> <li>डेपकः-पिका, डिडेपयिषकः-षिका;</li> <li>  डेपयिता-त्री, डिडेपयिषिता-त्री;</li> <li>  डेपयन्-न्ती, डिडेपयिषन्-न्ती;</li> <li>  डेपयिष्यन्-न्ती-ती, डिडेपयिषिष्यन्-न्ती-ती;</li> <li>  डेपयमानः, डिडेपयिषमाणः;</li> <li>  डेपयिष्यमाणः, डिडेपयिषिष्यमाणः;</li> <li>  डेप्- डेपौ-डेपः;</li> <li>  डेपितम्-तः, डिडेपयिषितः-तवान्;</li> <li>  डेपः, <sup id="ref_krm_0659_04"><a href="#foot_krm_0659_04">4</a></sup> प्रतिमल्लडेपी, <sup id="ref_krm_0659_05"><a href="#foot_krm_0659_05">5</a></sup> <sup id="ref_krm_0659_06"><a href="#foot_krm_0659_06">6</a></sup> डिडेपयिषुः;</li> <li>  डेपयितव्यम्, डिडेपयिषितव्यम्;</li> <li>  डेपनीयम्, डिडेपयिषणीयम्;</li> <li>  डेप्यम्, डिडेपयिष्यम्;</li> <li>  ईषड्डेपः-दुर्डेपः-सुडेपः;</li> <li>  डेप्यमानः, डिडेपयिष्यमाणः;</li> <li>  डेपः, डिडेपयिषः;</li> <li>  डेपयितुम्, डिडेपयिषितुम्;</li> <li>  डेपना, डिडेपयिषा;</li> <li>  डेपनम्, डिडेपयिषणम्;</li> <li>  डेपयित्वा, डिडेपयिषित्वा;</li> <li>  प्रडेप्य, प्रडिडेपयिष्य;</li> <li>  डेपम् २, डेपयित्वा २, डिडेपयिषम् २;</li> <li>  डिडेपयिषित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0659_01"><a href="#ref_krm_0659_01">↑</a> (६४९)</li> <li id="foot_krm_0659_02"><a href="#ref_krm_0659_02">↑</a> (१०-चुरादिः-१६७२। सक। सेट्। उभ।)</li> <li id="foot_krm_0659_03"><a href="#ref_krm_0659_03">↑</a> (श्लो। १३४)</li> <li id="foot_krm_0659_04"><a href="#ref_krm_0659_04">↑</a> [[१। ‘सुप्यजातौ--’ (३-२-७८) इति ताच्छील्ये णिनिः।]]</li> <li id="foot_krm_0659_05"><a href="#ref_krm_0659_05">↑</a> [[E। ‘इत्थं वदत्यसुरजासिनि पिण्डितायः- स्थेमाऽथ रोषितमतिः प्रतिमल्लडेपी।’ धा। का। ३-३२।]]</li> <li id="foot_krm_0659_06"><a href="#ref_krm_0659_06">↑</a> [पृष्ठम्०६०६+ २७]</li></ul></p>

डिप
<ul><li><sup id="ref_krm_0660_01"><a href="#foot_krm_0660_01">1</a></sup> {@“डिप सङ्घाते”@} <sup id="ref_krm_0660_02"><a href="#foot_krm_0660_02">2</a></sup> आकुस्मीयः। </li> <li><sup id="ref_krm_0660_03"><a href="#foot_krm_0660_03">3</a></sup> “डबि डिबि’ इति चन्द्रः। </li> <li>विडम्बयति। </li> <li>आडम्बरः। </li> <li>डिम्बयति। </li> <li>डिम्बम् = शस्त्रकलहः।” इति क्षीरस्वामी। </li> <li>प्रदर्शितप्रयोगानुसारेण डबि- डिबिधात्वोरपि पाठः समीचीन इति प्रतिभाति।]] ‘सङ्घाते डेपयेतेति, क्षेपे डिपति डिप्यति। </li> <li>डेपयेदिति चत्वारि णिचि शे श्यनि णौ डिपेः।।’ <sup id="ref_krm_0660_04"><a href="#foot_krm_0660_04">4</a></sup> इति देवः। </li> <li>डेपकः-पिका, डिडेपयिषकः-षिका, डेपयमानः, डेपितः, <sup id="ref_krm_0660_05"><a href="#foot_krm_0660_05">5</a></sup> इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकडेपयतिवत् <sup id="ref_krm_0660_06"><a href="#foot_krm_0660_06">6</a></sup> ज्ञेयानि। </li> <li>अस्य धातोरा- कुस्मीयत्वात् ‘आकुस्मादात्मनेपदिनः’ <sup id="ref_krm_0660_07"><a href="#foot_krm_0660_07">7</a></sup> इति आत्मनेपद- मेव। </li> <li>तेन शत्रादेशषटितानि रूपाण्यस्य धातोर्नेति तस्मादस्य विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0660_01"><a href="#ref_krm_0660_01">↑</a> (६५०)</li> <li id="foot_krm_0660_02"><a href="#ref_krm_0660_02">↑</a> (१०-चुरादिः-१६७८। अक। सेट्। आत्म।)</li> <li id="foot_krm_0660_03"><a href="#ref_krm_0660_03">↑</a> [[[अ]</li> <li id="foot_krm_0660_04"><a href="#ref_krm_0660_04">↑</a> (श्लो। १३४)</li> <li id="foot_krm_0660_05"><a href="#ref_krm_0660_05">↑</a> [[आ। ‘संडापितः सदसि डेपितवृष्णिवीरे भोजेन्द्रतन्त्रणविनिन्द्यममन्त्रतैवम्।।’ धा। का। ३-३३।]]</li> <li id="foot_krm_0660_06"><a href="#ref_krm_0660_06">↑</a> (६४९)</li> <li id="foot_krm_0660_07"><a href="#ref_krm_0660_07">↑</a> (ग। सू। चुरादौ)</li></ul></p>

