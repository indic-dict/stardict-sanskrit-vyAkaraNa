<ul><li><sup id="ref_krm_1031_01"><a href="#foot_krm_1031_01">1</a></sup> {@“पुर अग्रगतने”@} <sup id="ref_krm_1031_02"><a href="#foot_krm_1031_02">2</a></sup> पोरकः-रिका, पोरकः-रिका, पुपुरिषकः-पुपोरिषकः-षिका, पोपुरकः-रिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि तौदादिककुरतिवद् <sup id="ref_krm_1031_03"><a href="#foot_krm_1031_03">3</a></sup> ऊह्यानि। </li> <li>शतरि- <sup id="ref_krm_1031_04"><a href="#foot_krm_1031_04">4</a></sup> पुरन्-न्ती-ती, इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1031_01"><a href="#ref_krm_1031_01">↑</a> (१०२१)</li> <li id="foot_krm_1031_02"><a href="#ref_krm_1031_02">↑</a> (६-तुदादिः-१३४६। सक। सेट्। पर।)</li> <li id="foot_krm_1031_03"><a href="#ref_krm_1031_03">↑</a> (२२९)</li> <li id="foot_krm_1031_04"><a href="#ref_krm_1031_04">↑</a> [[B। ‘मुरादिबन्धुः क्षुरघोरचेताः पुरन् खलानां जनजीवबर्ही।’ धा। का। २। ७७।]]</li></ul></p>

पुर्व|पूर्वकः-र्विका|पुपूर्विषकः-षिका|पोपूर्वकः-र्विका|पूर्विता-त्री|पूर्वयिता-त्री|पुपूर्विषिता-त्री|पोपूर्विता-त्री|पूर्वितम्-तः-तवान्
<ul><li><sup id="ref_krm_1032_01"><a href="#foot_krm_1032_01">1</a></sup> {@“पुर्व पूरणे”@} <sup id="ref_krm_1032_02"><a href="#foot_krm_1032_02">2</a></sup> ‘पूर्व--’ इति क्षीरस्वामी। </li> <li>‘पूरणे पूर्वतीति स्यात्, पूर्वयेण्णौ निकेतने।।’ <sup id="ref_krm_1032_03"><a href="#foot_krm_1032_03">3</a></sup> इति देवः। </li> <li>पूर्वकः-र्विका, पूर्वकः-र्विका, पुपूर्विषकः-षिका, पोपूर्वकः-र्विका;</li> <li>  पूर्विता-त्री, पूर्वयिता-त्री, पुपूर्विषिता-त्री, पोपूर्विता-त्री;</li> <li>  <sup id="ref_krm_1032_04"><a href="#foot_krm_1032_04">4</a></sup> पूर्वितम्-तः-तवान्;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकगूर्वतिवत् <sup id="ref_krm_1032_05"><a href="#foot_krm_1032_05">5</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_1032_06"><a href="#foot_krm_1032_06">6</a></sup> पूर्तिः इति क्तिनि रूपम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1032_01"><a href="#ref_krm_1032_01">↑</a> (१०२२)</li> <li id="foot_krm_1032_02"><a href="#ref_krm_1032_02">↑</a> (१-भ्वादिः-५७६। सक। सेट्। पर।)</li> <li id="foot_krm_1032_03"><a href="#ref_krm_1032_03">↑</a> (श्लो। १६२)</li> <li id="foot_krm_1032_04"><a href="#ref_krm_1032_04">↑</a> [[C। ‘दुदूर्विषून् धूर्वितुमेव गूर्वणं मूर्वन्तमापूर्वितपर्वताध्वरम्।।’ धा। का। १। ७३।]]</li> <li id="foot_krm_1032_05"><a href="#ref_krm_1032_05">↑</a> (४१६)</li> <li id="foot_krm_1032_06"><a href="#ref_krm_1032_06">↑</a> [[२। ‘राल्लोपः’ (६-४-२१) इति झलादौ किति ङिति च प्रत्यये परतः वकारस्य लोपः।]]</li></ul></p>

पुर्व|पूर्वकः-र्विका|पुपूर्वयिषकः-षिका|पूर्वयिता-त्री|पुपूर्वयिषिता-त्री|पूर्वयन्-न्ती|पुपूर्वयिषन्-न्ती-ती|पूर्वयिष्यन्-न्ती-ती|पुपूर्वयिषिष्यन्-न्ती-ती|पूर्वयमाणः|पुपूर्वयिषमाणः|पूर्वयिष्यमाणः|पुपूर्वयिषिष्यमाणः|पूर्वितम्-तः|पुपूर्वयिषितः-तवान्|पूर्वयिटू-यिषौ-यिषः|पूर्वः|पुपूर्वयिषुः|पूर्वयितव्यम्|पुपूर्वयिषितव्यम्|पूर्वणीयम्|पुपूर्वयिषणीयम्|पूर्व्यम्|पुपूर्वयिष्यम्|ईषत्पूर्वः-दुष्पूर्वः-सुपूर्वः|पूर्व्यमाणः|पुपूर्वयिष्यमाणः
<ul><li><sup id="ref_krm_1033_01"><a href="#foot_krm_1033_01">1</a></sup> {@“पुर्व निकेतने”@} <sup id="ref_krm_1033_02"><a href="#foot_krm_1033_02">2</a></sup> ‘पूरणे पूर्वतीति स्यात् पूर्वयेत् णौ निकेतने।।’ <sup id="ref_krm_1033_03"><a href="#foot_krm_1033_03">3</a></sup> इति देवः। </li> <li>‘पूर्व निकेतने’ इति मैत्रेयः। </li> <li>अत्र क्षीरस्वामी-- “पूर्वनिकेतनम् = आद्यनिवासः। </li> <li>पारायणे-द्वौ धातू” इति। </li> <li><sup id="ref_krm_1033_04"><a href="#foot_krm_1033_04">4</a></sup> <sup id="ref_krm_1033_05"><a href="#foot_krm_1033_05">5</a></sup> पूर्वकः-र्विका, पुपूर्वयिषकः-षिका, पूर्वयिता-त्री, पुपूर्वयिषिता-त्री;</li> <li>  पूर्वयन्-न्ती, पुपूर्वयिषन्-न्ती-ती;</li> <li>  पूर्वयिष्यन्-न्ती-ती, पुपूर्वयिषिष्यन्-न्ती-ती;</li> <li>  पूर्वयमाणः, पुपूर्वयिषमाणः, पूर्वयिष्यमाणः, पुपूर्वयिषिष्यमाणः, <sup id="ref_krm_1033_06"><a href="#foot_krm_1033_06">6</a></sup> पूर्वितम्-तः, पुपूर्वयिषितः-तवान्;</li> <li>  पूर्वयिटू-यिषौ-यिषः;</li> <li>  पूर्वः, पुपूर्वयिषुः, पूर्वयितव्यम्, पुपूर्वयिषितव्यम्, पूर्वणीयम्, पुपूर्वयिषणीयम्, पूर्व्यम्, पुपूर्वयिष्यम्, ईषत्पूर्वः-दुष्पूर्वः-सुपूर्वः, पूर्व्यमाणः, पुपूर्वयिष्यमाणः;</li> <li>  पूर्वः, पुपूर्वयिषः, पूर्वयितुम्, पुपूर्वयिषितुम्, पूर्वणा, पुपूर्वयिषा, पूर्वणम्, पुपूर्वयिषणम्, पूर्वयित्वा, पुपूर्वयिषित्वा, प्रपूर्व्य, प्रपुपूर्वयिष्य, पूर्वम् २, पूर्वयित्वा २, पुपूर्वयिषम् २, पुपूर्वयिषित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1033_01"><a href="#ref_krm_1033_01">↑</a> (१०२३)</li> <li id="foot_krm_1033_02"><a href="#ref_krm_1033_02">↑</a> (१०-चुरादिः-१६६६। अक। सेट्। उभ।)</li> <li id="foot_krm_1033_03"><a href="#ref_krm_1033_03">↑</a> (श्लो। १६२)</li> <li id="foot_krm_1033_04"><a href="#ref_krm_1033_04">↑</a> [पृष्ठम्०८७१+ २८]</li> <li id="foot_krm_1033_05"><a href="#ref_krm_1033_05">↑</a> [[१। ‘उपधायां च’ (८-२-७८) इति सर्वत्र दीर्घः।]]</li> <li id="foot_krm_1033_06"><a href="#ref_krm_1033_06">↑</a> [[आ। ‘मञ्चाग्रपूर्वितनृपे शिशुना रणं वः स्यादेव मानपरिजंसकमीड्यधाम्नाम्।।’ धा। का। ३। ३१।]]</li></ul></p>

पुल|पोलकः-लिका|पुपुलिषकः-पुपोलिषकः-षिका|पोपुलकः-लिका
<ul><li><sup id="ref_krm_1034_01"><a href="#foot_krm_1034_01">1</a></sup> {@“पुल महत्त्वे”@} <sup id="ref_krm_1034_02"><a href="#foot_krm_1034_02">2</a></sup> ज्वलादिः। </li> <li>‘महत्त्वे पोलति पुलेर्णौ तु तत्रैव पोलयेत्।’ <sup id="ref_krm_1034_03"><a href="#foot_krm_1034_03">3</a></sup> इति देवः। </li> <li>पोलकः-लिका, पोलकः-लिका, पुपुलिषकः-पुपोलिषकः-षिका, पोपुलकः-लिका;</li> <li>  इत्यादीनि सर्वाणि रूपाणि कोलतिवत् <sup id="ref_krm_1034_04"><a href="#foot_krm_1034_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1034_05"><a href="#foot_krm_1034_05">5</a></sup> पुलिः, <sup id="ref_krm_1034_06"><a href="#foot_krm_1034_06">6</a></sup> पुलकः, <sup id="ref_krm_1034_07"><a href="#foot_krm_1034_07">7</a></sup> पुलिनम्, <sup id="ref_krm_1034_08"><a href="#foot_krm_1034_08">8</a></sup> पुलाकः, <sup id="ref_krm_1034_09"><a href="#foot_krm_1034_09">9</a></sup> पुलिन्दः, इमानि रूपाणि अस्य धातोर्भवन्तीति विशेषः। </li> <li><sup id="ref_krm_1034_10"><a href="#foot_krm_1034_10">10</a></sup> प्रपोलः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1034_01"><a href="#ref_krm_1034_01">↑</a> (१०२४)</li> <li id="foot_krm_1034_02"><a href="#ref_krm_1034_02">↑</a> (१-भ्वादिः-८४१। अक। सेट्। पर।)</li> <li id="foot_krm_1034_03"><a href="#ref_krm_1034_03">↑</a> (श्लो। १५६)</li> <li id="foot_krm_1034_04"><a href="#ref_krm_1034_04">↑</a> (२३१)</li> <li id="foot_krm_1034_05"><a href="#ref_krm_1034_05">↑</a> [[२। ‘इक् कृष्यादिभ्यः (वा। ३-३-९४) इति स्त्रियां भावादौ इक्प्रत्ययः।]]</li> <li id="foot_krm_1034_06"><a href="#ref_krm_1034_06">↑</a> [[३। ‘क्वुन् शिल्पिसंज्ञयोः--’ (द। उ। ३-५) इति क्वुन्।]]</li> <li id="foot_krm_1034_07"><a href="#ref_krm_1034_07">↑</a> [[४। बाहुलकादौणादिके किनन्प्रत्यये रूपम्। पुलिनम् = सैकतम्।]]</li> <li id="foot_krm_1034_08"><a href="#ref_krm_1034_08">↑</a> [[५। ‘पिनाकादयश्च’ (द। उ। ३-३४।) इत्यस्याकृतिगणत्वात् आकप्रत्यये रूपमेवम्। पुलाकः = पक्वान्नलेशः।]]</li> <li id="foot_krm_1034_09"><a href="#ref_krm_1034_09">↑</a> [[६। ‘कुणिपुल्योः किन्दच्’ (द। उ। ६। ४६।) इति किन्दच्प्रत्ययः। पुलिन्दः = म्लेच्छजातिविशेषः।]]</li> <li id="foot_krm_1034_10"><a href="#ref_krm_1034_10">↑</a> [[B। ‘स्थलीर्हली सन्नलिनीश्च तीर्त्वा पलन् हरिश्चात्मबलप्रपोलः।’ धा। का। २२। २।]]</li></ul></p>

पुल
<ul><li><sup id="ref_krm_1035_01"><a href="#foot_krm_1035_01">1</a></sup> {@“पुल महत्त्वे”@} <sup id="ref_krm_1035_02"><a href="#foot_krm_1035_02">2</a></sup> ‘महत्त्वे पोलति पुलेर्णौ तु तत्रैव पोलयेत्।’ <sup id="ref_krm_1035_03"><a href="#foot_krm_1035_03">3</a></sup> इति देवः। </li> <li>‘--समुच्छ्राये’ इति क्षीरस्वामी। </li> <li><sup id="ref_krm_1035_04"><a href="#foot_krm_1035_04">4</a></sup> पोलकः-लिका, पुपोलयिषकः-षिका, इत्यादीनि सर्वाण्यपि रूपाणि तोलयतिवत् <sup id="ref_krm_1035_05"><a href="#foot_krm_1035_05">5</a></sup> ज्ञेयानि। </li> <li>कर्तरि क्तप्रत्यये <sup id="ref_krm_1035_06"><a href="#foot_krm_1035_06">6</a></sup> पोलितम् इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1035_01"><a href="#ref_krm_1035_01">↑</a> (१०२५)</li> <li id="foot_krm_1035_02"><a href="#ref_krm_1035_02">↑</a> (१०-चुरादिः-१६०१। अक। सेट्। उभ।)</li> <li id="foot_krm_1035_03"><a href="#ref_krm_1035_03">↑</a> (श्लो। १५६)</li> <li id="foot_krm_1035_04"><a href="#ref_krm_1035_04">↑</a> [पृष्ठम्०८७२+ २६]</li> <li id="foot_krm_1035_05"><a href="#ref_krm_1035_05">↑</a> (७५७)</li> <li id="foot_krm_1035_06"><a href="#ref_krm_1035_06">↑</a> [[आ। ‘संदोलयन् अधिकपोलितमद्रिराजं संचोलितं सुबहुमूलितशाखिबृन्दैः।।’ धा। का। ३। २१।]]</li></ul></p>

