<ul><li><sup id="ref_krm_0002_01"><a href="#foot_krm_0002_01">1</a></sup> {@“अक्षू व्याप्तौ”@} <sup id="ref_krm_0002_02"><a href="#foot_krm_0002_02">2</a></sup> ‘संघाते च’ इति क्षीरस्वामी। </li> <li>अक्षकः-क्षिका, अक्षकः-क्षिका, अचिक्षिषकः-षिका;</li> <li>  <sup id="ref_krm_0002_03"><a href="#foot_krm_0002_03">3</a></sup> अक्षिता-त्री, अष्टा-ष्ट्री, अक्षयिता-त्री, अचिक्षिषिता-त्री;</li> <li>  अक्षन्-न्ती, अक्षयन्-न्ती, अचिक्षिषन्-न्ती;</li> <li>  <sup id="ref_krm_0002_04"><a href="#foot_krm_0002_04">4</a></sup> अक्ष्णुवन्-वती, अक्षिष्यन्-अक्ष्यन्-ती-न्ती, अक्षयिष्यन्-ती-न्ती, अचिक्षिषिष्यन्-ती-न्ती;</li> <li>  अक्षयमाणः, अक्षयिष्यमाणः;</li> <li>  अट् <sup id="ref_krm_0002_05"><a href="#foot_krm_0002_05">5</a></sup> -अक्षौ-अक्षः, अक् <sup id="ref_krm_0002_06"><a href="#foot_krm_0002_06">6</a></sup> अक्षौ-अक्षः, <sup id="ref_krm_0002_07"><a href="#foot_krm_0002_07">7</a></sup> अष्टः-ष्टम्-ष्टवान्, अक्षितः, अचिक्षिषितम्-तः-तवान्;</li> <li>  <sup id="ref_krm_0002_08"><a href="#foot_krm_0002_08">8</a></sup> अक्षः, अक्षः, <sup id="ref_krm_0002_09"><a href="#foot_krm_0002_09">9</a></sup> काष्ठाक्षः <sup id="ref_krm_0002_10"><a href="#foot_krm_0002_10">10</a></sup>, अचिक्षिषुः, अचिक्षयिषुः;</li> <li>  अक्षितव्यम् अष्टव्यम् अक्षयितव्यम्, अचिक्षिषितव्यम्;</li> <li>  अक्षणीयम्, अक्षणीयम्, अचिक्षिषणीयम्;</li> <li>  अक्ष्यम्, अक्ष्यम्, अचिक्षिष्यम्;</li> <li>  ईषदक्षः-दुरक्षः-स्वक्षः;</li> <li>  अक्ष्यमाणः, अक्ष्यमाणः, अचिक्षिष्यमाणः;</li> <li>  अक्षः, अक्षः, अचिक्षिषः;</li> <li>  अक्षितुम्-अष्टुम्, अक्षयितुम्, अचिक्षिषितुम्;</li> <li>  अष्टिः, अक्षणा, अचिक्षिषा, अचिक्षयिषा;</li> <li>  अक्षणम्, अक्षणम्, अचिक्षिषणम्;</li> <li>  अक्षित्वा, अष्ट्वा, अक्षयित्वा, अचिक्षिषित्वा;</li> <li>  समक्ष्य, समक्ष्य, समचिक्षिष्य;</li> <li>  अक्षम् २, अक्षित्वा २, अष्ट्वा २ अक्षम् २, अक्षयित्वा २, अचिक्षिषम् २, अचिक्षिषित्वा २, अक्षि <sup id="ref_krm_0002_11"><a href="#foot_krm_0002_11">11</a></sup>।।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0002_01"><a href="#ref_krm_0002_01">↑</a> (३)</li> <li id="foot_krm_0002_02"><a href="#ref_krm_0002_02">↑</a> (भ्वादिः-१-६५४। सक-वेट्-पर।)</li> <li id="foot_krm_0002_03"><a href="#ref_krm_0002_03">↑</a> [[५। ‘स्वरतिसूति--’ (७-२-४४) इतीड्विकल्पः।]]</li> <li id="foot_krm_0002_04"><a href="#ref_krm_0002_04">↑</a> [[६। ‘अक्षोऽन्यतरस्याम्’ (३-१-७५) इति वा श्नुः। उवङ्।]]</li> <li id="foot_krm_0002_05"><a href="#ref_krm_0002_05">↑</a> [[७। ‘स्कोः--’ (८-२-२९) इति कलोपः।]]</li> <li id="foot_krm_0002_06"><a href="#ref_krm_0002_06">↑</a> [[८। ‘संयोगान्तस्य लोपः’ (८-२-२३)।]]</li> <li id="foot_krm_0002_07"><a href="#ref_krm_0002_07">↑</a> [[९। ऊदित्त्वात्, ‘यस्य विभाषा’ (७-२-१५) इतीण्णिषेधः। ककारलोपः।]]</li> <li id="foot_krm_0002_08"><a href="#ref_krm_0002_08">↑</a> [पृष्ठम्०००६+ २४]</li> <li id="foot_krm_0002_09"><a href="#ref_krm_0002_09">↑</a> [[१। ‘कर्मण्यण्’ (३-२-१) इत्यण्।]]</li> <li id="foot_krm_0002_10"><a href="#ref_krm_0002_10">↑</a> (ज्वलनः)</li> <li id="foot_krm_0002_11"><a href="#ref_krm_0002_11">↑</a> [[२। औणादिक इन् प्रत्ययः।]]</li></ul></p>

अग|आगकः-गिका|अगकः-गिका|अजिगिषकः-षिका
<ul><li><sup id="ref_krm_0003_01"><a href="#foot_krm_0003_01">1</a></sup> {@“अग कुटिलायां गतौ”@} <sup id="ref_krm_0003_02"><a href="#foot_krm_0003_02">2</a></sup> घटादिः। </li> <li>आगकः-गिका, अगकः-गिका, अजिगिषकः-षिका;</li> <li>  इत्यादि सर्वं अक <sup id="ref_krm_0003_03"><a href="#foot_krm_0003_03">3</a></sup> घातुवत् बोद्धव्यम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0003_01"><a href="#ref_krm_0003_01">↑</a> (४)</li> <li id="foot_krm_0003_02"><a href="#ref_krm_0003_02">↑</a> (भ्वादिः-१-७९३-सक। से। पर।)</li> <li id="foot_krm_0003_03"><a href="#ref_krm_0003_03">↑</a> (१।)</li></ul></p>

अगि|अङ्गन्-न्ती|अङ्गिष्यन्-न्ती-ती|अङ्गयन्-न्ती|अङ्गयिष्यन्-न्ती-ती
<ul><li><sup id="ref_krm_0004_01"><a href="#foot_krm_0004_01">1</a></sup> {@“अगि गतौ”@} <sup id="ref_krm_0004_02"><a href="#foot_krm_0004_02">2</a></sup> अङ्गन्-न्ती, अङ्गिष्यन्-न्ती-ती, अङ्गयन्-न्ती, अङ्गयिष्यन्-न्ती-ती;</li> <li>  अञ्जिगिषन्-न्ती इत्यादिरूपाणि विना, अवशिष्टानि अकि <sup id="ref_krm_0004_03"><a href="#foot_krm_0004_03">3</a></sup> धातुवत् बोद्धव्यानि। </li> <li>अस्य धातोरौणादिके निप्रत्यये नलोपे <sup id="ref_krm_0004_04"><a href="#foot_krm_0004_04">4</a></sup> अग्निः।। </li> <li><sup id="ref_krm_0004_05"><a href="#foot_krm_0004_05">5</a></sup> संज्ञायां घः = अङ्गम्। </li> <li>प्रशस्तानि अङ्गानि यस्याः सा = अङ्गना। </li> <li>‘अङ्गात् कल्याणे’ <sup id="ref_krm_0004_06"><a href="#foot_krm_0004_06">6</a></sup> इति पामादित्वात् नः प्रत्ययः। </li> <li>‘विल- ङ्गदेणं शबराङ्गनाजनप्रवङ्गितं मङ्गलधेनुतङ्गितम्’ धा-का। </li> <li>१-२०।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0004_01"><a href="#ref_krm_0004_01">↑</a> (५)</li> <li id="foot_krm_0004_02"><a href="#ref_krm_0004_02">↑</a> (भ्वादिः-१-१४६-सक। से। पर।)</li> <li id="foot_krm_0004_03"><a href="#ref_krm_0004_03">↑</a> (२।)</li> <li id="foot_krm_0004_04"><a href="#ref_krm_0004_04">↑</a> (अङ्गति = ज्वालारूपेणोद्र्ध्वं गच्छति इत्यर्थे)</li> <li id="foot_krm_0004_05"><a href="#ref_krm_0004_05">↑</a> [पृष्ठम्०००७+ २७]</li> <li id="foot_krm_0004_06"><a href="#ref_krm_0004_06">↑</a> (ग। सू, -५-२-१००)</li></ul></p>

अघि
<ul><li><sup id="ref_krm_0005_01"><a href="#foot_krm_0005_01">1</a></sup> {@‘अघि गत्याक्षेपे’@} <sup id="ref_krm_0005_02"><a href="#foot_krm_0005_02">2</a></sup> गत्याक्षेपो = निन्दा <sup id="ref_krm_0005_03"><a href="#foot_krm_0005_03">3</a></sup>। </li> <li>अङ्घकः-ङ्घिका, अञ्जिघिषकः-षिका, इत्यादिरूपाणि ‘अकि लक्षणे’ <sup id="ref_krm_0005_04"><a href="#foot_krm_0005_04">4</a></sup> इति धातुवद् बोध्यानि। </li> <li>अङ्घितम् = भावे क्तः ‘अरङ्कि कोलैर्लघु तद्रथस्वनात् प्रबुद्ध्य सिंहैः पुनरङ्घितं सदा’ धा। </li> <li>का-१-१५।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0005_01"><a href="#ref_krm_0005_01">↑</a> (६)</li> <li id="foot_krm_0005_02"><a href="#ref_krm_0005_02">↑</a> (भ्वादिः-१-१०९-सक। सेट्-आ।)</li> <li id="foot_krm_0005_03"><a href="#ref_krm_0005_03">↑</a> (गतौ-गत्यारम्भे च)</li> <li id="foot_krm_0005_04"><a href="#ref_krm_0005_04">↑</a> (२।)</li></ul></p>

