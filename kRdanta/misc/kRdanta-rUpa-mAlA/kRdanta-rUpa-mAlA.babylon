<ul><li><sup id="ref_krm_0455_01"><a href="#foot_krm_0455_01">1</a></sup> {@“ग्लुन्चु गतौ”@} <sup id="ref_krm_0455_02"><a href="#foot_krm_0455_02">2</a></sup> ग्लुञ्चकः-ञ्चिका, ग्लुञ्चकः-ञ्चिका, जुग्लुञ्चिषकः-षिका, <sup id="ref_krm_0455_03"><a href="#foot_krm_0455_03">3</a></sup> जोग्लुचकः-चिका;</li> <li>  ग्लुञ्चिता-त्री, ग्लुञ्चयिता-त्री, जुग्लुञ्चिषिता-त्री, जोग्लुचिता-त्री;</li> <li>  <sup id="ref_krm_0455_04"><a href="#foot_krm_0455_04">4</a></sup> ग्लुञ्चन्-न्ती, ग्लुञ्चयन्-न्ती, जुग्लुञ्चिषन्-न्ती;</li> <li>  -- ग्लुञ्चिष्यन्-न्ती-ती ग्लुञ्चयिष्यन्-न्ती-ती, जुग्लुञ्चिषिष्यन्-न्ती-ती;</li> <li>  -- -- ग्लुञ्चयमानः, ग्लुञ्चयिष्यमाणः, जोग्लुच्यमानः, जोग्लुचिष्यमाणः;</li> <li>  <sup id="ref_krm_0455_05"><a href="#foot_krm_0455_05">5</a></sup> ग्लुक्-ग्लुग्-ग्लुचौ-ग्लुचः;</li> <li>  -- -- <sup id="ref_krm_0455_06"><a href="#foot_krm_0455_06">6</a></sup> ग्लुक्तम्-तः, ग्लुञ्चितः, जुग्लुञ्चिषितः, जोग्लुचितः-तवान्;</li> <li>  ग्लुञ्चः, ग्लुञ्चः, जुग्लुञ्चिषुः, जोग्लुञ्चः;</li> <li>  ग्लुञ्चितव्यम्, ग्लुञ्चयितव्यम्, जुग्लुञ्चिषितव्यम्, जोग्लुचितव्यम्;</li> <li>  ग्लुञ्चनीयम्, ग्लुञ्चनीयम्, जुग्लुञ्चिषणीयम्, जोग्लुचनीयम्;</li> <li>  <sup id="ref_krm_0455_07"><a href="#foot_krm_0455_07">7</a></sup> ग्लुङ्क्यम्, ग्लुञ्च्यम्, जुग्लुञ्चिष्यम्, जोग्लुच्यम्;</li> <li>  ईषद्ग्लुञ्चः-दुर्ग्लुञ्चः-सुग्लुञ्चः;</li> <li>  -- -- <sup id="ref_krm_0455_08"><a href="#foot_krm_0455_08">8</a></sup> ग्लुच्यमानः, <sup id="ref_krm_0455_09"><a href="#foot_krm_0455_09">9</a></sup> ग्लुञ्च्यमानः, जुग्लुञ्चिष्यमाणः, जोग्लुच्यमानः;</li> <li>  ग्लुञ्चः, ग्लुञ्चः, जुग्लुञ्चिषः, जोग्लुचः;</li> <li>  ग्लुञ्चितुम्, ग्लुञ्चयितुम्, जुग्लुञ्चिषितुम्, जोग्लुचितुम्;</li> <li>  <sup id="ref_krm_0455_10"><a href="#foot_krm_0455_10">10</a></sup> ग्लुञ्चा, ग्लुञ्चना, जुग्लुञ्चिषा, जोग्लुचा;</li> <li>  ग्लुञ्चनम्, ग्लुञ्चनम्, जुग्लुञ्चिषणम्, जोग्लुचनम्;</li> <li>  <sup id="ref_krm_0455_11"><a href="#foot_krm_0455_11">11</a></sup> ग्लुञ्चित्वा-ग्लुक्त्वा, ग्लुञ्चयित्वा, जुग्लुञ्चिषित्वा, जोग्लुचित्वा;</li> <li>  परिग्लुच्य, परिग्लुञ्च्य, परिजुग्लुञ्चिष्य, परिजोग्लुच्य;</li> <li>  ग्लुञ्चम् २, ग्लुञ्चित्वा २, ग्लुक्त्वा २, ग्लुञ्चम् २, ग्लुञ्चयित्वा २, जुग्लुञ्चिषम् २, जुग्लुञ्चिषित्वा २, जोग्लुचम् २;</li> <li>  जोग्लुचित्वा २;</li> <li>  <sup id="ref_krm_0455_12"><a href="#foot_krm_0455_12">12</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0455_01"><a href="#ref_krm_0455_01">↑</a> (४४७)</li> <li id="foot_krm_0455_02"><a href="#ref_krm_0455_02">↑</a> (१-भ्वादिः-२०१। अक। सेट्। पर।)</li> <li id="foot_krm_0455_03"><a href="#ref_krm_0455_03">↑</a> [[३। अन्तरङ्गत्वात् यङ्निमित्तकः, ‘अनिदिताम्--’ (६-४-२४) इति नलोपो भवति। एवं यङन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0455_04"><a href="#ref_krm_0455_04">↑</a> [पृष्ठम्०४४४+ २२]</li> <li id="foot_krm_0455_05"><a href="#ref_krm_0455_05">↑</a> [[१। ‘अनिदिताम्--’ (६-४-२४) इति नलोपे चर्त्वविकल्पः।]]</li> <li id="foot_krm_0455_06"><a href="#ref_krm_0455_06">↑</a> [[२। उदित्त्वेन क्त्वायामिड्विकल्पनात्, निष्ठायाम्, ‘यस्य विभाषा’ (७-२-१५) इती- ण्णिषेधः। उपधानकारलोपः।]]</li> <li id="foot_krm_0455_07"><a href="#ref_krm_0455_07">↑</a> [[३। कुत्वविधायके सूत्रे ‘निष्ठायामनिट इति वक्तव्यम्’ (वा। ७-३-५२) इति वार्तिकात् कुत्वं भवति। एवं घञ्यपि।]]</li> <li id="foot_krm_0455_08"><a href="#ref_krm_0455_08">↑</a> [[४। ‘अनिदिताम्--’ (६-४-२४) इति नकारलोपः।]]</li> <li id="foot_krm_0455_09"><a href="#ref_krm_0455_09">↑</a> [[५। णिचा व्यवधानात् कित्परकत्वाभावात् नलोपो न।]]</li> <li id="foot_krm_0455_10"><a href="#ref_krm_0455_10">↑</a> [[६। ‘गुरोश्च हलः’ (३-३-१०३) इति स्त्रियामकारप्रत्ययः।]]</li> <li id="foot_krm_0455_11"><a href="#ref_krm_0455_11">↑</a> [[७। ‘उदितो वा’ (७-२-५६) इति क्त्वायामिड्विकल्पः। कित्त्वपक्षे नलोपः। कित्त्वा- भावपक्षे नलोपाभावः।]]</li> <li id="foot_krm_0455_12"><a href="#ref_krm_0455_12">↑</a> [पृष्ठम्०४४५+ २७]</li></ul></p>

ग्लेपृ|ग्लेपकः-पिका|जिग्लेपिषकः-षिका|जेग्लेपकः-पिका
<ul><li><sup id="ref_krm_0456_01"><a href="#foot_krm_0456_01">1</a></sup> {@“ग्लेपृ दैन्ये”@} <sup id="ref_krm_0456_02"><a href="#foot_krm_0456_02">2</a></sup> ग्लेपकः-पिका, ग्लेपकः-पिका, जिग्लेपिषकः-षिका, जेग्लेपकः-पिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि ‘गेपृ कम्पने’ इति भौवादिकधातुवत् <sup id="ref_krm_0456_03"><a href="#foot_krm_0456_03">3</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0456_01"><a href="#ref_krm_0456_01">↑</a> (४४८)</li> <li id="foot_krm_0456_02"><a href="#ref_krm_0456_02">↑</a> (१-भ्वादिः-३६६। अक। सेट्। आत्म।)</li> <li id="foot_krm_0456_03"><a href="#ref_krm_0456_03">↑</a> (४२९)</li></ul></p>

ग्लेपृ
<ul><li><sup id="ref_krm_0457_01"><a href="#foot_krm_0457_01">1</a></sup> {@“ग्लेपृ च”@} <sup id="ref_krm_0457_02"><a href="#foot_krm_0457_02">2</a></sup> चात्कम्पने गतौ च। </li> <li>अस्यापि धातोः सर्वाण्यपि रूपाणि ‘गेपृ कम्पने’ इति भौवादिकधातुवत् <sup id="ref_krm_0457_03"><a href="#foot_krm_0457_03">3</a></sup> बोध्यानि। </li> <li>अर्थभेदात् पुनः पाठोऽस्य।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0457_01"><a href="#ref_krm_0457_01">↑</a> (४४९)</li> <li id="foot_krm_0457_02"><a href="#ref_krm_0457_02">↑</a> (१-भ्वादिः-३७०। अक। सेट्। आत्म।)</li> <li id="foot_krm_0457_03"><a href="#ref_krm_0457_03">↑</a> (४२९)</li></ul></p>

ग्लेवृ|ग्लेवकः-विका|जिग्लेविषकः-षिका|जेग्लेवकः-विका
<ul><li><sup id="ref_krm_0458_01"><a href="#foot_krm_0458_01">1</a></sup> {@“ग्लेवृ सेवने”@} <sup id="ref_krm_0458_02"><a href="#foot_krm_0458_02">2</a></sup> ग्लेवकः-विका, ग्लेवकः-विका, जिग्लेविषकः-षिका, जेग्लेवकः-विका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि कम्पनार्थकगेपृ धातुवत् <sup id="ref_krm_0458_03"><a href="#foot_krm_0458_03">3</a></sup> ज्ञेयानि। </li> <li>ण्यति-ग्लेव्यम् <sup id="ref_krm_0458_04"><a href="#foot_krm_0458_04">4</a></sup>। </li> <li>क्विपि ऊठि वृद्धौ च ग्लौः इति रूपमिति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0458_01"><a href="#ref_krm_0458_01">↑</a> (४५०)</li> <li id="foot_krm_0458_02"><a href="#ref_krm_0458_02">↑</a> (१-भ्वादिः-५०३। सक। सेट्। आत्म।)</li> <li id="foot_krm_0458_03"><a href="#ref_krm_0458_03">↑</a> (४२९)</li> <li id="foot_krm_0458_04"><a href="#ref_krm_0458_04">↑</a> [[आ। ‘सेव्यं सतां शङ्करगेव्यमब्जभूग्लेव्यं सुरैः पेव्यममेव्यमुन्मदैः।’ धा। का। १-६५।]]</li></ul></p>

ग्लेषृ
<ul><li><sup id="ref_krm_0459_01"><a href="#foot_krm_0459_01">1</a></sup> {@“ग्लेषृ अन्विच्छायाम्”@} <sup id="ref_krm_0459_02"><a href="#foot_krm_0459_02">2</a></sup> अन्विच्छा = अन्वेषणम्। </li> <li>‘गेषृ अन्विच्छायाम्’ इत्यस्य पाठान्त- रमिदम्। </li> <li>अस्यापि घातोः सर्वाणि रूपाणि भौवादिकगेपृधातुवत् <sup id="ref_krm_0459_03"><a href="#foot_krm_0459_03">3</a></sup> बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0459_01"><a href="#ref_krm_0459_01">↑</a> (४५१)</li> <li id="foot_krm_0459_02"><a href="#ref_krm_0459_02">↑</a> (१-भ्वादिः-६१४। सक। सेट्। आत्म।)</li> <li id="foot_krm_0459_03"><a href="#ref_krm_0459_03">↑</a> (४२९)</li></ul></p>

