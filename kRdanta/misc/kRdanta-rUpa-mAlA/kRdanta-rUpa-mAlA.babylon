<ul><li><sup id="ref_krm_1108_01"><a href="#foot_krm_1108_01">1</a></sup> {@“बन्ध बन्धने”@} <sup id="ref_krm_1108_02"><a href="#foot_krm_1108_02">2</a></sup> ‘बध्नाति बन्धने बन्धेर्बाधयेदिति संयमे।’ <sup id="ref_krm_1108_03"><a href="#foot_krm_1108_03">3</a></sup> इति देवः। </li> <li>बन्धकः-न्धिका, बन्धकः-न्धिका, <sup id="ref_krm_1108_04"><a href="#foot_krm_1108_04">4</a></sup> बिभन्त्सकः-त्सिका, <sup id="ref_krm_1108_05"><a href="#foot_krm_1108_05">5</a></sup> बाबधकः-धिका;</li> <li>  <sup id="ref_krm_1108_06"><a href="#foot_krm_1108_06">6</a></sup> बन्द्धा-बन्द्ध्री, बन्धयिता-त्री, बिभन्त्सिता-त्री, बाबधिता-त्री;</li> <li>  <sup id="ref_krm_1108_07"><a href="#foot_krm_1108_07">7</a></sup> <sup id="ref_krm_1108_08"><a href="#foot_krm_1108_08">8</a></sup> बध्नन्-ती, <sup id="ref_krm_1108_09"><a href="#foot_krm_1108_09">9</a></sup> बन्धयन्-न्ती, बिभन्त्सन्-न्ती;</li> <li>  -- <sup id="ref_krm_1108_10"><a href="#foot_krm_1108_10">10</a></sup> भन्त्स्यन्-न्ती-ती, बन्धयिषयन्-न्ती-ती, बिभन्त्सिष्यन्-न्ती-ती;</li> <li>  -- -- बन्धयमानः, बन्धयिष्यमाणः, -- बाबध्यमानः, बाबधिष्यमाणः;</li> <li>  <sup id="ref_krm_1108_11"><a href="#foot_krm_1108_11">11</a></sup> भत्-भध्-बधौ-बधः;</li> <li>  -- -- -- बद्धः-बद्धम्-बद्धवान्, <sup id="ref_krm_1108_12"><a href="#foot_krm_1108_12">12</a></sup> चक्रबद्धः-दृषद्बद्धः, बन्धितः, बिभन्त्सितः, बाबधितः-तवान्;</li> <li>  बन्धः, <sup id="ref_krm_1108_13"><a href="#foot_krm_1108_13">13</a></sup> सुतानुबन्धः, <sup id="ref_krm_1108_14"><a href="#foot_krm_1108_14">14</a></sup> बन्धः, बिभन्त्सुः, बाबन्धः;</li> <li>  बन्द्धव्यम्, बन्धयितव्यम्, बिभन्त्सितव्यम्, बाबधितव्यम्;</li> <li>  बन्धनीयम्, बन्धनीयम्, बिभन्त्सनीयम्, बाबधनीयम्, बन्ध्यम्, बन्ध्यम्, बिभन्त्स्यम्, बाबध्यम्;</li> <li>  ईषद्बन्धः-दुर्बन्धः-सुबन्धः;</li> <li>  -- -- बध्यमानः, बन्ध्यमानः, बिभन्त्स्यमानः, बाबध्यमानः;</li> <li>  बन्धः, <sup id="ref_krm_1108_15"><a href="#foot_krm_1108_15">15</a></sup> पर्यङ्कबन्धः, चक्रबन्धः, दृषद्बन्धः, <sup id="ref_krm_1108_16"><a href="#foot_krm_1108_16">16</a></sup> अनूबन्धः, बन्धः, बिभन्त्सः, बाबधः;</li> <li>  बन्द्धुम्, बन्धयितुम्, बिभन्त्सितुम्, बाबधितुम्;</li> <li>  <sup id="ref_krm_1108_17"><a href="#foot_krm_1108_17">17</a></sup> <sup id="ref_krm_1108_18"><a href="#foot_krm_1108_18">18</a></sup> बन्धा, बद्धिः, बन्धना, बिभन्त्सा, बाबधा;</li> <li>  बन्धनम्, बन्धनम्, बिभन्त्सनम्, बाबधनम्;</li> <li>  बद्ध्वा, बन्धयित्वा, बिभन्त्सित्वा, बाबधित्वा;</li> <li>  अनुबध्य, प्रबन्ध्य, प्रबिभन्त्स्य, प्रबाबध्य;</li> <li>  <sup id="ref_krm_1108_19"><a href="#foot_krm_1108_19">19</a></sup> चक्रबन्धं बद्धः, <sup id="ref_krm_1108_20"><a href="#foot_krm_1108_20">20</a></sup> अट्टालिकाबन्धं बद्धः;</li> <li>  बन्धम् २, बद्ध्वा २, बन्धम् २, बन्धयित्वा २, बिभन्त्सम् २, बिभन्त्सित्वा २, बाबधम् २;</li> <li>  बाबधित्वा २;</li> <li>  <sup id="ref_krm_1108_21"><a href="#foot_krm_1108_21">21</a></sup> उप्रत्यये रूपमेवम्।]] बन्धुः, <sup id="ref_krm_1108_22"><a href="#foot_krm_1108_22">22</a></sup> किरच्प्रत्यये, प्रत्ययस्य कित्त्वेनोपधानकारलोपे च रूपमेवम्। </li> <li>बद्धमस्य श्रवणेन्द्रियमिति बधिरः = श्रोत्रेन्द्रियहीनः।]] बधिरः, <sup id="ref_krm_1108_23"><a href="#foot_krm_1108_23">23</a></sup> ब्रध्नः-बुध्नः, <sup id="ref_krm_1108_24"><a href="#foot_krm_1108_24">24</a></sup> बन्धुरः, <sup id="ref_krm_1108_25"><a href="#foot_krm_1108_25">25</a></sup> बन्धूकः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1108_01"><a href="#ref_krm_1108_01">↑</a> (१०९८)</li> <li id="foot_krm_1108_02"><a href="#ref_krm_1108_02">↑</a> (९-क्र्यादिः-१५०८। अक। अनि। पर।)</li> <li id="foot_krm_1108_03"><a href="#ref_krm_1108_03">↑</a> (श्लो। १२०)</li> <li id="foot_krm_1108_04"><a href="#ref_krm_1108_04">↑</a> [[१। सन्नन्ताण्ण्वुलि, भष्भावचर्त्वादिकेषु रूपमेवम्। सर्वत्र सन्नन्तेषु एवमेव प्रक्रियेति ज्ञेयम्।]]</li> <li id="foot_krm_1108_05"><a href="#ref_krm_1108_05">↑</a> [[२। यङन्ते सर्वत्र यङ्निमित्तके नकारलोपे, अभ्यासदीर्घे च रूपनिष्पत्तिरिति ज्ञेयम्।]]</li> <li id="foot_krm_1108_06"><a href="#ref_krm_1108_06">↑</a> [[३। तृचि, ‘झषस्तधोः--’ (८-२-४०) इति धत्वम्। ‘झलां जश् झशि’ (८-४-५३) इति धातुधकारस्य दकारः। तस्य, ‘झरो झरि--’ (८-४-६५) इति पाक्षिको लोपः। एवं तव्यदादिष्वपि प्रक्रिया ज्ञेया।]]</li> <li id="foot_krm_1108_07"><a href="#ref_krm_1108_07">↑</a> [पृष्ठम्०९१८+ २७]</li> <li id="foot_krm_1108_08"><a href="#ref_krm_1108_08">↑</a> [[१। शतरि, क्र्यादित्वात् श्नाप्रत्यये, ‘अनिदिताम्--’ (६-४-२४) इति धातुनकारलोपे, ‘श्नाऽभ्यस्तयोः--’ (६-४-११२) इत्याकारलोपे च रूपमेवम्।]]</li> <li id="foot_krm_1108_09"><a href="#ref_krm_1108_09">↑</a> [[२। चित्तवत्कर्तृकत्वविवक्षायाम् ण्यन्तेऽत्र परस्मैपदमेव। अचित्तवत्कर्तृकत्वविवक्षायां तु आत्मनेपदमपि भवतीति ज्ञेयम्।]]</li> <li id="foot_krm_1108_10"><a href="#ref_krm_1108_10">↑</a> [[३। स्यप्रत्ययेऽपि भष्भावचर्त्वादिकं यथायथमूह्यम्।]]</li> <li id="foot_krm_1108_11"><a href="#ref_krm_1108_11">↑</a> [[४। क्विपि, उपधानकारलोपे, भष्भावचर्त्वविकल्पयो रूपम्।]]</li> <li id="foot_krm_1108_12"><a href="#ref_krm_1108_12">↑</a> [[५। क्तप्रत्ययान्तात्, ‘सप्तमी--’ (२-३-३६) इति योगविभागात् समासः।]]</li> <li id="foot_krm_1108_13"><a href="#ref_krm_1108_13">↑</a> [[६। सुतमनुबध्नातीति सुतानुबन्धः। ‘कर्मण्यण्’ (३-२-१) इत्यण्।]]</li> <li id="foot_krm_1108_14"><a href="#ref_krm_1108_14">↑</a> [[आ। ‘ज्ञाताशयस्तस्य ततो व्यतानीत् स कर्मठः कर्म सुतानुबन्धम्।।’ भ। का। १। ११। (अत्र कर्मण्यणि सुतानुबन्धम् इति नपुंसकलिङ्गश्रवणासम्भवात् व्याख्यातृभिः सुतानुबन्धि इति पाठमाश्रित्य, तस्य च सुतमनुबन्धुं शीलमस्येति व्युत्पत्त्या ताच्छील्येऽर्थे णिनिप्रत्ययान्तत्वमिति समर्थितम्। तदेव च साध्विति प्रतिभाति।]]</li> <li id="foot_krm_1108_15"><a href="#ref_krm_1108_15">↑</a> [[७। पर्यङ्के बन्धः पर्यङ्कबन्धः। ‘सिद्धशुष्कपक्वबन्धैश्च’ (२-१-४१) इति सप्तमीतत्पुरुषः। ‘तत्पुरुषे कृति--’ (६-३-१४) इति प्राप्तस्यालुकः ‘नेन्सिद्धबद्ध्नातिषु च’ (६-३-१९) इति निषेधः।]]</li> <li id="foot_krm_1108_16"><a href="#ref_krm_1108_16">↑</a> [[८। अनु बध्यते इत्यनूबन्धः = प्रत्ययगतः कित्त्वङित्त्वादिर्विशेषः। ‘उपसर्गस्य घञ्यमनुष्ये बहुलम्’ (६-३-१२२) इति दीर्घः।]]</li> <li id="foot_krm_1108_17"><a href="#ref_krm_1108_17">↑</a> [पृष्ठम्०९१९+ २७]</li> <li id="foot_krm_1108_18"><a href="#ref_krm_1108_18">↑</a> [[१। धातोः संयोगान्तत्वेन गुरुत्वात्, ‘गुरोश्च हलः’ (३-३-१०३) इत्यकारप्रत्यये रूप- मेवम्। क्तिनि विवक्षिते तु कित्त्वेनोपधानकारलोपे बद्धिः इत्यपि साधुरिति ज्ञेयम्।]]</li> <li id="foot_krm_1108_19"><a href="#ref_krm_1108_19">↑</a> [[२। ‘अधिकरणे बन्धः’ (३-४-४१) इति णमुल्। चक्रे बद्ध इत्यर्थः। कषादित्वात् यथाविध्यनुप्रयोगः।]]</li> <li id="foot_krm_1108_20"><a href="#ref_krm_1108_20">↑</a> [[३। ‘संज्ञायाम्’ (३-४-४२) इति णमुल्। अट्टालिकाबन्ध इति बन्धविशेषस्य संज्ञा। एवं क्रौञ्चबन्धं बद्धः, पद्मबन्धं बद्धः, शरबन्धं बद्धः, इत्यादिषु सर्वत्र णमुलुपपत्तिर्ज्ञेया। अत्र सर्बत्र बन्धः इत्यनेन व्यूहविशेषस्य, काव्यगतस्य बन्ध- विशेषस्य च तन्त्रेण ग्रहणमिति ज्ञेयम्।]]</li> <li id="foot_krm_1108_21"><a href="#ref_krm_1108_21">↑</a> [[४। औणादिके [द। उ। १। ९५]</li> <li id="foot_krm_1108_22"><a href="#ref_krm_1108_22">↑</a> [[५। औणादिके [द। उ। ८। २६]</li> <li id="foot_krm_1108_23"><a href="#ref_krm_1108_23">↑</a> [[६। ‘बन्धेर्ब्रधिबुधि च’ (द। उ। ५-३८) इति नक्प्रत्यये ब्रधि-बुधि-इत्यादेशयोश्च रूपे सिद्ध्यतः। कित्त्वादुपधानकारलोपः। ब्रध्नः = सूर्यः। बुध्नः = सङ्कल्पो मनः, देवो वा।]]</li> <li id="foot_krm_1108_24"><a href="#ref_krm_1108_24">↑</a> [[७। बाहुलकादौणादिके उरच्प्रत्यये रूपम्। ‘बन्धूर बन्धुरौ स्यातां नम्रसुन्दरयोस्त्रिषु।’ इति रन्तिदेववचनाद् दीर्घमध्यमोऽप्यस्तीति विज्ञायते।]]</li> <li id="foot_krm_1108_25"><a href="#ref_krm_1108_25">↑</a> [[८। औणादिके (द। उ। ३-४६) ऊकप्रत्यये रूपम्। बन्धूकम् = पुष्पविशेषः।]]</li></ul></p>

बर्ब|बर्बकः-र्बिका|बिबर्बिषकः-षिका|बाबर्बकः-र्बिका
<ul><li><sup id="ref_krm_1109_01"><a href="#foot_krm_1109_01">1</a></sup> {@“बर्ब गतौ”@} <sup id="ref_krm_1109_02"><a href="#foot_krm_1109_02">2</a></sup> ‘अयं बन्ब इति नोपधः। </li> <li>इति कौशिकः।’ इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>बर्बकः-र्बिका, बर्बकः-र्बिका, बिबर्बिषकः-षिका, बाबर्बकः-र्बिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककर्बतिवत् <sup id="ref_krm_1109_03"><a href="#foot_krm_1109_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1109_04"><a href="#foot_krm_1109_04">4</a></sup> बर्बरः-बर्बरी, <sup id="ref_krm_1109_05"><a href="#foot_krm_1109_05">5</a></sup> प्रबर्ब्य। </li> <li><sup id="ref_krm_1109_06"><a href="#foot_krm_1109_06">6</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1109_01"><a href="#ref_krm_1109_01">↑</a> (१०९९)</li> <li id="foot_krm_1109_02"><a href="#ref_krm_1109_02">↑</a> (१-भ्वादिः-४१८। सक। सेट्। पर।)</li> <li id="foot_krm_1109_03"><a href="#ref_krm_1109_03">↑</a> (१७३)</li> <li id="foot_krm_1109_04"><a href="#ref_krm_1109_04">↑</a> [[९। बाहुलकादौणादिकेऽरप्रत्यये रूपम्। बर्बरः = शिथिलः, प्राणिविशेषश्च। स्त्रियां ङीषि बर्बरी इति।]]</li> <li id="foot_krm_1109_05"><a href="#ref_krm_1109_05">↑</a> [[आ। ‘प्रबर्ब्य शैलानुपमर्ब्य पद्मिनीं प्रकर्व्य चाशाः श्रमशोणितैरिव।।’ धा। का। १। ५४।]]</li> <li id="foot_krm_1109_06"><a href="#ref_krm_1109_06">↑</a> [पृष्ठम्०९२०+ २६]</li></ul></p>

बर्ह|बर्हकः-र्हिका|बिबर्हिषकः-षिका|बाबर्हकः-र्हिका
<ul><li><sup id="ref_krm_1110_01"><a href="#foot_krm_1110_01">1</a></sup> {@“बर्ह प्राधान्ये”@} <sup id="ref_krm_1110_02"><a href="#foot_krm_1110_02">2</a></sup> बर्हकः-र्हिका, बर्हकः-र्हिका, बिबर्हिषकः-षिका, बाबर्हकः-र्हिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकगर्हतिवत् <sup id="ref_krm_1110_03"><a href="#foot_krm_1110_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1110_04"><a href="#foot_krm_1110_04">4</a></sup> बर्हः, <sup id="ref_krm_1110_05"><a href="#foot_krm_1110_05">5</a></sup> बर्हिणः, <sup id="ref_krm_1110_06"><a href="#foot_krm_1110_06">6</a></sup> बर्हकः इमानि रूपाण्यधिकान्यत्रेति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1110_01"><a href="#ref_krm_1110_01">↑</a> (११००)</li> <li id="foot_krm_1110_02"><a href="#ref_krm_1110_02">↑</a> (१-भ्वादिः-६३८। सक। सेट्। आत्म।)</li> <li id="foot_krm_1110_03"><a href="#ref_krm_1110_03">↑</a> (३८५)</li> <li id="foot_krm_1110_04"><a href="#ref_krm_1110_04">↑</a> [[१। बर्हते = प्राधान्येन सर्वेष्ववयवेषु वर्तते इति बर्हः = मयूरादीनां शिखण्डकः। पचाद्यचि रूपमेवम्।]]</li> <li id="foot_krm_1110_05"><a href="#ref_krm_1110_05">↑</a> [[२। ‘फलबर्हाभ्यामिनच् वक्तव्यः’ (वा। ५-२-१२२) इति मत्वर्थीय इनच्प्रत्ययः। बर्हिणः = मयूरः।]]</li> <li id="foot_krm_1110_06"><a href="#ref_krm_1110_06">↑</a> [[३। आशिषि गम्यमानायाम् ‘आशिषि च’ (३-१-१५०) इति वुन्। बर्हताम् इत्याशिषि गम्यमानायामयं प्रत्ययो भवतीति ज्ञेयम्।]]</li></ul></p>

बर्ह|बर्हकः-र्हिका|बिबर्हयिषकः-षिका|बर्हयिता-त्री|बिबर्हयिषिता-त्री|क्विपिबट्-बड्-बर्हौ-बर्हः
<ul><li><sup id="ref_krm_1111_01"><a href="#foot_krm_1111_01">1</a></sup> {@“बर्ह हिंसायाम्”@} <sup id="ref_krm_1111_02"><a href="#foot_krm_1111_02">2</a></sup> बर्हकः-र्हिका, बिबर्हयिषकः-षिका, बर्हयिता-त्री, बिबर्हयिषिता-त्री;</li> <li>  इत्यादीनि सर्वाणि रूपाणि चौरादिकगर्जयतिवत् <sup id="ref_krm_1111_03"><a href="#foot_krm_1111_03">3</a></sup> बोध्यानि। </li> <li>क्विपि <sup id="ref_krm_1111_04"><a href="#foot_krm_1111_04">4</a></sup> बट्-बड्-बर्हौ-बर्हः;</li> <li>  <sup id="ref_krm_1111_05"><a href="#foot_krm_1111_05">5</a></sup> अनिबर्हणीयम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1111_01"><a href="#ref_krm_1111_01">↑</a> (११०१)</li> <li id="foot_krm_1111_02"><a href="#ref_krm_1111_02">↑</a> (१०-चुरादिः-१६६५। सक। सेट्। उभ।)</li> <li id="foot_krm_1111_03"><a href="#ref_krm_1111_03">↑</a> (३७८)</li> <li id="foot_krm_1111_04"><a href="#ref_krm_1111_04">↑</a> [[४। ‘रात् सस्य’ (८-२-२४) इति नियमात् हकारस्य संयोगान्तलोपो न। हकारस्य पदान्तनिमित्तके ढत्वे, चर्त्वविकल्पे च रूपमेवम्।]]</li> <li id="foot_krm_1111_05"><a href="#ref_krm_1111_05">↑</a> [[आ। ‘अम्लेच्छलोकसहिते सदसीह तस्मात् को ब्रूसयिष्यति शिशूननिबर्हणीयम्।।’ धा। का। ३। ३०।]]</li></ul></p>

बर्ह|बर्हकः-र्हिका|बिबर्हयिषकः-षिका|बर्हयिता-त्री|बिबर्हयिषिता-त्री
<ul><li><sup id="ref_krm_1112_01"><a href="#foot_krm_1112_01">1</a></sup> {@“बर्ह भाषार्थः”@} <sup id="ref_krm_1112_02"><a href="#foot_krm_1112_02">2</a></sup> आस्वदीयः। </li> <li>‘वृद्धौ भाषार्थविषये बृंहयेद् बर्हयेदिति।।’ <sup id="ref_krm_1112_03"><a href="#foot_krm_1112_03">3</a></sup> इति देवः। </li> <li>बर्हकः-र्हिका, बिबर्हयिषकः-षिका, बर्हयिता-त्री, बिबर्हयिषिता-त्री;</li> <li>  इत्यादीनि सर्वाणि रूपाणि चौरादिकग्रासयतिवत् <sup id="ref_krm_1112_04"><a href="#foot_krm_1112_04">4</a></sup> बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1112_01"><a href="#ref_krm_1112_01">↑</a> (११०२)</li> <li id="foot_krm_1112_02"><a href="#ref_krm_1112_02">↑</a> (१०-चुरादिः-१७७०। सक। सेट्। उभ।)</li> <li id="foot_krm_1112_03"><a href="#ref_krm_1112_03">↑</a> (श्लो। १९८)</li> <li id="foot_krm_1112_04"><a href="#ref_krm_1112_04">↑</a> (४३९)</li></ul></p>

बल|बालकः-लिका|बिबलिषकः-षिका|बाबलकः-लिका
<ul><li><sup id="ref_krm_1113_01"><a href="#foot_krm_1113_01">1</a></sup> {@“बल प्राणने धान्यावरोधने च”@} <sup id="ref_krm_1113_02"><a href="#foot_krm_1113_02">2</a></sup> ज्वलादिः। </li> <li>प्राणनम् = जीवनम्। </li> <li>धान्यावरोधनम् = कुसूलादिव्यापारः। </li> <li>प्राणनेऽकर्मकः, धान्यावरोधने सकर्मकः। </li> <li>बालकः-लिका, बालकः-लिका, बिबलिषकः-षिका, बाबलकः-लिका;</li> <li>  <sup id="ref_krm_1113_03"><a href="#foot_krm_1113_03">3</a></sup> इत्यादीनि सर्वाण्यपि रूपाणि तद्धातूपात्तविशेषरूपाणि विना भौवादिक- कलतिवत् <sup id="ref_krm_1113_04"><a href="#foot_krm_1113_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1113_05"><a href="#foot_krm_1113_05">5</a></sup> बालः-बलः, <sup id="ref_krm_1113_06"><a href="#foot_krm_1113_06">6</a></sup> बाला, <sup id="ref_krm_1113_07"><a href="#foot_krm_1113_07">7</a></sup> बाहुबली-ऊरुबली, सर्वबली, <sup id="ref_krm_1113_08"><a href="#foot_krm_1113_08">8</a></sup> इतीन्प्रत्यये रूपम्।]] बलिः, <sup id="ref_krm_1113_09"><a href="#foot_krm_1113_09">9</a></sup> बलवान्-बली, <sup id="ref_krm_1113_10"><a href="#foot_krm_1113_10">10</a></sup> बलूलः, इमानि रूपाण्यधिकान्यत्रेति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1113_01"><a href="#ref_krm_1113_01">↑</a> (११०३)</li> <li id="foot_krm_1113_02"><a href="#ref_krm_1113_02">↑</a> (१-भ्वादिः-८४०। सक। सेट्। पर।)</li> <li id="foot_krm_1113_03"><a href="#ref_krm_1113_03">↑</a> [पृष्ठम्०९२१+ ३०]</li> <li id="foot_krm_1113_04"><a href="#ref_krm_1113_04">↑</a> (१७४)</li> <li id="foot_krm_1113_05"><a href="#ref_krm_1113_05">↑</a> [[१। ‘ज्वलितिकसन्तेभ्यो णः’ (३-१-१४०) इति कर्तरि वा णप्रत्ययः। तदभावपक्षे पचाद्यचि बलः इति रूपम्।]]</li> <li id="foot_krm_1113_06"><a href="#ref_krm_1113_06">↑</a> [[२। बालशब्दस्याजादिषु (४-१-४) पाठात् ‘वयसि प्रथमे’ (४-१-२०) इति ङीष् न, टाबेव भवति।]]</li> <li id="foot_krm_1113_07"><a href="#ref_krm_1113_07">↑</a> [[३। ‘बलाद् बाहूरुपूर्वपदात्, सर्वादेश्च’ (वा। ५-२-१३५) इति वचनात् मत्वर्थीय इनिप्रत्यये रूपाण्येतानि साधूनि।]]</li> <li id="foot_krm_1113_08"><a href="#ref_krm_1113_08">↑</a> [[४। ‘इन्’ [द। उ। १-४६]</li> <li id="foot_krm_1113_09"><a href="#ref_krm_1113_09">↑</a> [[५। मत्वर्थीये इनिप्रत्यये, मतुपि मतोर्वकारे च एते रूपे भवतः।]]</li> <li id="foot_krm_1113_10"><a href="#ref_krm_1113_10">↑</a> [[६। ‘वातदन्तबलललाटानामूङ् च’ (ग। सू। ५-२-९७) इति सिध्मादिषु पाठात् मत्वर्थीये लच्प्रत्यये ऊङागमे च रूपमेवम्।]]</li></ul></p>

बल|बलकः-लिका|बिबलयिषकः-षिका
<ul><li><sup id="ref_krm_1114_01"><a href="#foot_krm_1114_01">1</a></sup> {@“बल प्राणने”@} <sup id="ref_krm_1114_02"><a href="#foot_krm_1114_02">2</a></sup> ज्ञपादिः। </li> <li>बलकः-लिका, बिबलयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकचहयतिवत् <sup id="ref_krm_1114_03"><a href="#foot_krm_1114_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1114_04"><a href="#foot_krm_1114_04">4</a></sup> बलयन्-न्ती।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1114_01"><a href="#ref_krm_1114_01">↑</a> (११०४)</li> <li id="foot_krm_1114_02"><a href="#ref_krm_1114_02">↑</a> (१०-चुरादिः-१६२९। सक। सेट्। उभ।)</li> <li id="foot_krm_1114_03"><a href="#ref_krm_1114_03">↑</a> (५१५)</li> <li id="foot_krm_1114_04"><a href="#ref_krm_1114_04">↑</a> [[आ। ‘युध्यस्व भीतिरहितो बलयन् खलु त्वं कीर्तिं चयस्व चपयापि नृपप्रसादम्।।’ धा। का। ३। २५।]]</li></ul></p>

बल्ह|बल्हकः-ल्हिका|बिबल्हिषकः-षिका|बाबल्हकः-ल्हिका
<ul><li><sup id="ref_krm_1115_01"><a href="#foot_krm_1115_01">1</a></sup> {@“बल्ह प्राधान्ये”@} <sup id="ref_krm_1115_02"><a href="#foot_krm_1115_02">2</a></sup> बल्हकः-ल्हिका, बल्हकः-ल्हिका, बिबल्हिषकः-षिका, बाबल्हकः-ल्हिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकगर्हतिवत् <sup id="ref_krm_1115_03"><a href="#foot_krm_1115_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1115_04"><a href="#foot_krm_1115_04">4</a></sup> प्रबल्हः, <sup id="ref_krm_1115_05"><a href="#foot_krm_1115_05">5</a></sup> बाहीकः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1115_01"><a href="#ref_krm_1115_01">↑</a> (११०५)</li> <li id="foot_krm_1115_02"><a href="#ref_krm_1115_02">↑</a> (१-भ्वादिः-६३९। अक। सेट्। आत्म।)</li> <li id="foot_krm_1115_03"><a href="#ref_krm_1115_03">↑</a> (३८५)</li> <li id="foot_krm_1115_04"><a href="#ref_krm_1115_04">↑</a> [[B। ‘बर्हप्रबल्हसमलङ्कृतिरालिलिङ्ग प्रोत्थाप्य वर्हकनिवल्हदुतं तमीशः।’ धा। का। १। ८१।]]</li> <li id="foot_krm_1115_05"><a href="#ref_krm_1115_05">↑</a> [[७। ‘ईकक् च’ (वा। ४-१-८५) इत्यनेन बहिस्-बहिल्शब्दाभ्यामीकक्प्रत्यये टिलोपे च बाहीकः इति रूपसिद्धिः। वेदबाह्यदेशजात इत्यर्थः। ‘गौर्वाहीकः’ इत्यादिषु बाहीकः इत्येव ओष्ठ्यादिः प्रयोगः साधुः, न तु दन्त्योष्ठ्यादिरिति बोध्यम्।]]</li></ul></p>

बल्ह|बल्हकः-ल्हिका|बिबल्हयिषकः-षिका
<ul><li><sup id="ref_krm_1116_01"><a href="#foot_krm_1116_01">1</a></sup> {@“बल्ह भाषार्थः”@} <sup id="ref_krm_1116_02"><a href="#foot_krm_1116_02">2</a></sup> आस्वदीयः। </li> <li>बल्हकः-ल्हिका, बिबल्हयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि <sup id="ref_krm_1116_03"><a href="#foot_krm_1116_03">3</a></sup> चौरादिकग्रासयतिवत् <sup id="ref_krm_1116_04"><a href="#foot_krm_1116_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1116_05"><a href="#foot_krm_1116_05">5</a></sup> अबल्ह्यः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1116_01"><a href="#ref_krm_1116_01">↑</a> (११०६)</li> <li id="foot_krm_1116_02"><a href="#ref_krm_1116_02">↑</a> (१०-चुरादिः-१७७१। सक। सेट्। उभ।)</li> <li id="foot_krm_1116_03"><a href="#ref_krm_1116_03">↑</a> [पृष्ठम्०९२२+ ३१]</li> <li id="foot_krm_1116_04"><a href="#ref_krm_1116_04">↑</a> (४३९)</li> <li id="foot_krm_1116_05"><a href="#ref_krm_1116_05">↑</a> [[आ। ‘नाहं बर्हयितास्म्यबल्ह्यमपि भोः सर्वैरिदं गोप्यते…।।’ धा। का। ३। ४४।]]</li></ul></p>

बष्क|इत्यत्र|बष्कयणीशब्दस्योपादानात्|माधव-धातुकाव्यकारप्रभृतिभिरुपादाना-|च्चास्माभिः|बष्क]]|बष्ककः-ष्किका|बिबष्कयिषकः-षिका
<ul><li><sup id="ref_krm_1117_01"><a href="#foot_krm_1117_01">1</a></sup> {@“बष्क दर्शने”@} <sup id="ref_krm_1117_02"><a href="#foot_krm_1117_02">2</a></sup> <sup id="ref_krm_1117_03"><a href="#foot_krm_1117_03">3</a></sup> ‘कर्तृकरणाद् धात्वर्थे <sup id="ref_krm_1117_04"><a href="#foot_krm_1117_04">4</a></sup> इत्यत्र तद्गणसूत्रनिदर्शनार्थमुपात्तेषु धातुष्वयमेकः। </li> <li>क्वचित् ‘बल्क दर्शने’ इत्युपात्तम्। </li> <li>‘पोटायुवतिस्तोककतिपय- गृष्टिधेनुवशावेहद्बष्कयणीप्रवक्तृश्रोत्रियाध्यापकधूर्तैर्जातिः’ <sup id="ref_krm_1117_05"><a href="#foot_krm_1117_05">5</a></sup> इत्यत्र बष्कयणीशब्दस्योपादानात्, माधव-धातुकाव्यकारप्रभृतिभिरुपादाना- च्चास्माभिः बष्क इति पाठमादृत्यैवमत्र लिखितम्।]] बष्ककः-ष्किका, बिबष्कयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकगन्धयतिवत् <sup id="ref_krm_1117_06"><a href="#foot_krm_1117_06">6</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1117_07"><a href="#foot_krm_1117_07">7</a></sup> बष्कयन्, <sup id="ref_krm_1117_08"><a href="#foot_krm_1117_08">8</a></sup> बष्कयणी।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1117_01"><a href="#ref_krm_1117_01">↑</a> (११०७)</li> <li id="foot_krm_1117_02"><a href="#ref_krm_1117_02">↑</a> (१०-चुरादिः-१९१६। सक। सेट्। उभ।)</li> <li id="foot_krm_1117_03"><a href="#ref_krm_1117_03">↑</a> [[[अ]</li> <li id="foot_krm_1117_04"><a href="#ref_krm_1117_04">↑</a> (ग। सू। चुरादिः)</li> <li id="foot_krm_1117_05"><a href="#ref_krm_1117_05">↑</a> (२-१-६५)</li> <li id="foot_krm_1117_06"><a href="#ref_krm_1117_06">↑</a> (३७५)</li> <li id="foot_krm_1117_07"><a href="#ref_krm_1117_07">↑</a> [[B। ‘लोके बष्कयतीह चित्रितमहामञ्चे स्वयं चित्रयन् दोष्णा खङ्गमुदंस्य तस्य वटयन् हस्तादगृह्णादमुम्।’ धा। का। ३। ६१।]]</li> <li id="foot_krm_1117_08"><a href="#ref_krm_1117_08">↑</a> [[१। बाहुलकात् औणादिकेऽयप्रत्यये बष्कयः = तरुणवत्सः। सोऽस्य अस्तीति पामादित्वात् (५-२-१००) नप्रत्यये णत्वे ङीषि च बष्कयणी = चिरप्रसूता गौः।]]</li></ul></p>

बस्त|वस्तकः-स्तिका|बिबस्तयिषकः-षिका|बस्तयिता-त्री|बिबस्तयिषिता-त्री|यथा-बस्तकः-स्तिका|बिबस्तिषकः-षिका|बाबस्तकः-स्तिका
<ul><li><sup id="ref_krm_1118_01"><a href="#foot_krm_1118_01">1</a></sup> {@“बस्त अर्दने”@} <sup id="ref_krm_1118_02"><a href="#foot_krm_1118_02">2</a></sup> आकुस्मीयः। </li> <li>‘बस्तु--’ इति मैत्रेयः। </li> <li>तस्य मते उदित्त्वाण्णिचो वैकल्पिकत्वम्। </li> <li>‘वस्त--’ इति केचिद् दन्तोष्ठ्यादिं पठन्ति। </li> <li>वस्तकः-स्तिका, बिबस्तयिषकः-षिका, बस्तयिता-त्री, बिबस्तयिषिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकगन्धयतिवत् <sup id="ref_krm_1118_03"><a href="#foot_krm_1118_03">3</a></sup> ज्ञेयानि। </li> <li>णिचो वैकल्पिकत्वात् पक्षे शुद्धात्, शुद्धप्रकृतिकसन्नन्तात्, यङन्ताच्च इमानि रूपाणीति विशेषः। </li> <li>यथा--बस्तकः-स्तिका, बिबस्तिषकः-षिका, बाबस्तकः-स्तिका;</li> <li>  इति यथायथमूह्यानि। </li> <li><sup id="ref_krm_1118_04"><a href="#foot_krm_1118_04">4</a></sup> बिबस्तयिषुः, <sup id="ref_krm_1118_05"><a href="#foot_krm_1118_05">5</a></sup> बस्तिः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1118_01"><a href="#ref_krm_1118_01">↑</a> (११०८)</li> <li id="foot_krm_1118_02"><a href="#ref_krm_1118_02">↑</a> (१०-चुरादिः-१६८३। सक। सेट्। आत्म।)</li> <li id="foot_krm_1118_03"><a href="#ref_krm_1118_03">↑</a> (३७५)</li> <li id="foot_krm_1118_04"><a href="#ref_krm_1118_04">↑</a> [[C। ‘प्रस्पाश्य मुष्टिमभितर्जयते प्रभर्त्स्यो मल्लो बिबस्तयिषुरेनमगन्धनीयम्।’ धा। का। ३। ३४।]]</li> <li id="foot_krm_1118_05"><a href="#ref_krm_1118_05">↑</a> [[२। ‘इक् कृष्यादिभ्यः’ (वा। ३-३-१०८) इति णिजभावपक्षे इक्प्रत्यये रूपम्। बस्तिः = मूत्रकोशः।]]</li></ul></p>

बहि|अनतिप्रयोजनकत्वात्|बहुत्र|तस्यानुपलम्भात्|वहिधातोः|बहि]]बंहकः-हिका|बंहकः-हिका|बिबंहिषकः-षिका|बाबंहकः-हिका
<ul><li><sup id="ref_krm_1119_01"><a href="#foot_krm_1119_01">1</a></sup> {@“बहि वृद्धौ”@} <sup id="ref_krm_1119_02"><a href="#foot_krm_1119_02">2</a></sup> <sup id="ref_krm_1119_03"><a href="#foot_krm_1119_03">3</a></sup> क्षीरस्वामी चुरादिषु <sup id="ref_krm_1119_04"><a href="#foot_krm_1119_04">4</a></sup> भाषार्थकदण्डकेऽपि बहिधातुं पठित्वा बंहयतीत्युदाहृतवान्। </li> <li>अन्ये केऽपि नामुं धातुं पठन्ति। </li> <li>अनतिप्रयोजनकत्वात् बहुत्र तस्यानुपलम्भात् वहिधातोः बहि इति मुद्रणसम्भवाच्चास्माभिरयं परित्यक्तः।]] <sup id="ref_krm_1119_05"><a href="#foot_krm_1119_05">5</a></sup> बंहकः-हिका, बंहकः-हिका, बिबंहिषकः-षिका, बाबंहकः-हिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककण्ठतिवत् <sup id="ref_krm_1119_06"><a href="#foot_krm_1119_06">6</a></sup> ज्ञेयानि <sup id="ref_krm_1119_07"><a href="#foot_krm_1119_07">7</a></sup> बहु। </li> <li>शानचि-बंहमानः इति रूपमस्येति ज्ञेयम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1119_01"><a href="#ref_krm_1119_01">↑</a> (११०९)</li> <li id="foot_krm_1119_02"><a href="#ref_krm_1119_02">↑</a> (१-भ्वादिः-६३३। अक। सेट्। आत्म।)</li> <li id="foot_krm_1119_03"><a href="#ref_krm_1119_03">↑</a> [[[आ]</li> <li id="foot_krm_1119_04"><a href="#ref_krm_1119_04">↑</a> (आस्वदीयेषु)</li> <li id="foot_krm_1119_05"><a href="#ref_krm_1119_05">↑</a> [पृष्ठम्०९२३+ २९]</li> <li id="foot_krm_1119_06"><a href="#ref_krm_1119_06">↑</a> (१४९)</li> <li id="foot_krm_1119_07"><a href="#ref_krm_1119_07">↑</a> [[१। ‘लङ्घिबंह्योर्नलोपश्च’ (द। उ। १-११४) इति कुप्रत्यये नकारलोपे च बहु इति रूपम्।]]</li></ul></p>

बाडृ|बाडकः-डिका|बिबाडिषकः-षिका|बाबाडकः-डिका
<ul><li><sup id="ref_krm_1120_01"><a href="#foot_krm_1120_01">1</a></sup> {@“बाडृ आप्लाव्ये”@} <sup id="ref_krm_1120_02"><a href="#foot_krm_1120_02">2</a></sup> आप्लाव्यम् = वेगेनोत्क्षिप्य गमनम्। </li> <li>ओष्ठ्यादिरयं धातुः। </li> <li>औत्तराः सर्वेऽपि ग्रन्थकाराः वबयोः प्रयोगं बहुघा विपर्यस्य कुर्वन्ति। </li> <li>बाडकः-डिका, बाडकः-डिका, बिबाडिषकः-षिका, बाबाडकः-डिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकगाधतिवत् <sup id="ref_krm_1120_03"><a href="#foot_krm_1120_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1120_04"><a href="#foot_krm_1120_04">4</a></sup> बाडितम्, <sup id="ref_krm_1120_05"><a href="#foot_krm_1120_05">5</a></sup> बाडः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1120_01"><a href="#ref_krm_1120_01">↑</a> (१११०)</li> <li id="foot_krm_1120_02"><a href="#ref_krm_1120_02">↑</a> (१-भ्वादिः-२८६। सक। सेट्। आत्म।)</li> <li id="foot_krm_1120_03"><a href="#ref_krm_1120_03">↑</a> (३९४)</li> <li id="foot_krm_1120_04"><a href="#ref_krm_1120_04">↑</a> [[आ। ‘अहोडनीयान् पशुपालयानसौ अपश्यदानन्दपयोधिबाडितः।’ धा। का। १। ३८।]]</li> <li id="foot_krm_1120_05"><a href="#ref_krm_1120_05">↑</a> [[२। बाडते = वेगेनोत्क्षिप्य गच्छतीति बाडः = अश्वः। पचाद्यचि रूपम्।]]</li></ul></p>

बाधृ|बाधकः-धिका|बिबाधिषकः-षिका|बाबाधकः-धिका
<ul><li><sup id="ref_krm_1121_01"><a href="#foot_krm_1121_01">1</a></sup> {@“बाधृ लोडने”@} <sup id="ref_krm_1121_02"><a href="#foot_krm_1121_02">2</a></sup> ‘--रोटने। </li> <li>रोटनम् = प्रतिघातः।’ इति क्षीरस्वामी। </li> <li>लोडनम् = हिंसनमिति यावत्। </li> <li>बाधकः-धिका, बाधकः-धिका, बिबाधिषकः-षिका, बाबाधकः-धिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकगाधतिवत् <sup id="ref_krm_1121_03"><a href="#foot_krm_1121_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1121_04"><a href="#foot_krm_1121_04">4</a></sup> कार्यबाधी <sup id="ref_krm_1121_05"><a href="#foot_krm_1121_05">5</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1121_01"><a href="#ref_krm_1121_01">↑</a> (११११)</li> <li id="foot_krm_1121_02"><a href="#ref_krm_1121_02">↑</a> (१-भ्वादिः-५। सक। सेट्। आत्म।)</li> <li id="foot_krm_1121_03"><a href="#ref_krm_1121_03">↑</a> (३९४)</li> <li id="foot_krm_1121_04"><a href="#ref_krm_1121_04">↑</a> [[३। ‘सुप्यजातौ णिनिस्ताच्छील्ये’ (३-२-७८) इति णिनिप्रत्ययः।]]</li> <li id="foot_krm_1121_05"><a href="#ref_krm_1121_05">↑</a> [[B। ‘स गान्दिनीभूरथ गोकुलैधितं स्पर्धालुधीगाधितकार्यबाधिनम्।’ धा। का। १। २।]]</li></ul></p>

बाहृ|बाहकः-हिका|बिबाहिषकः-षिका|बाबाहकः-हिका
<ul><li><sup id="ref_krm_1122_01"><a href="#foot_krm_1122_01">1</a></sup> {@“बाहृ प्रयत्ने”@} <sup id="ref_krm_1122_02"><a href="#foot_krm_1122_02">2</a></sup> बाहकः-हिका, बाहकः-हिका, बिबाहिषकः-षिका, बाबाहकः-हिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकद्राखतिवत् <sup id="ref_krm_1122_03"><a href="#foot_krm_1122_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1122_04"><a href="#foot_krm_1122_04">4</a></sup> बाहः- <sup id="ref_krm_1122_05"><a href="#foot_krm_1122_05">5</a></sup> बाहा, <sup id="ref_krm_1122_06"><a href="#foot_krm_1122_06">6</a></sup> बाढम् <sup id="ref_krm_1122_07"><a href="#foot_krm_1122_07">7</a></sup> -बाहितम्, <sup id="ref_krm_1122_08"><a href="#foot_krm_1122_08">8</a></sup> बाहुः। </li> <li><sup id="ref_krm_1122_09"><a href="#foot_krm_1122_09">9</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1122_01"><a href="#ref_krm_1122_01">↑</a> (१११२)</li> <li id="foot_krm_1122_02"><a href="#ref_krm_1122_02">↑</a> (१-भ्वादिः-६४५। अक। सेट्। आत्म।)</li> <li id="foot_krm_1122_03"><a href="#ref_krm_1122_03">↑</a> (८७९)</li> <li id="foot_krm_1122_04"><a href="#ref_krm_1122_04">↑</a> [[४। पचाद्यचि, रूपमेवम्। स्त्रियामजादिपाठात् टाप्।]]</li> <li id="foot_krm_1122_05"><a href="#ref_krm_1122_05">↑</a> [[C। ‘{??}लीहायितासुरभरक्षतिवेहितोर्वीभैषज्यजेहपरया निजबाहयैव।।’ धा। का। १। ८१।]]</li> <li id="foot_krm_1122_06"><a href="#ref_krm_1122_06">↑</a> [[५। ‘क्षुब्धस्वान्तध्वान्तलग्नम्लिष्टविरिब्धफाण्टबाढानि मन्थमनस्तमस्सक्ताविस्पष्टस्वरा- नायासभृशेषु’ (७-२-१८) इत्यनेनास्माद् धातोर्निष्ठायां भृशार्थे इडभाव- निपातनात्, धातुहकारस्य ढत्वे धत्व-ष्टुत्व-ढलोप-दीर्घेषु च बाढम् इति रूपम्। अन्यत्र बाहितम् इत्येव।]]</li> <li id="foot_krm_1122_07"><a href="#ref_krm_1122_07">↑</a> [[ड्। ‘प्रमेदिताः सपुत्रास्ते सुस्वान्ता बाढविक्रमाः।’ भ। का। ९। १७।]]</li> <li id="foot_krm_1122_08"><a href="#ref_krm_1122_08">↑</a> [[६। बाहते = प्रयतते इति बाहुः = करः। औणादिके उप्रत्यये रूपमेवम्।]]</li> <li id="foot_krm_1122_09"><a href="#ref_krm_1122_09">↑</a> [पृष्ठम्०९२४+ २८]</li></ul></p>

बिट|बेटकः-टिका|बिबेटिषकः-बिबिटिषकः-षिका|बेबिटकः-|टिका
<ul><li><sup id="ref_krm_1123_01"><a href="#foot_krm_1123_01">1</a></sup> {@“बिट आक्रोशे”@} <sup id="ref_krm_1123_02"><a href="#foot_krm_1123_02">2</a></sup> ‘विट--’ इति क्षीरस्वामी पपाठ। </li> <li>‘बिड--’ इति नन्दी। </li> <li>‘पिट--’ इति मल्लः। </li> <li><sup id="ref_krm_1123_03"><a href="#foot_krm_1123_03">3</a></sup> बेटकः-टिका, बेटकः-टिका, बिबेटिषकः-बिबिटिषकः-षिका, बेबिटकः- टिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककिटतिवत् <sup id="ref_krm_1123_04"><a href="#foot_krm_1123_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1123_05"><a href="#foot_krm_1123_05">5</a></sup> इत्यादिना कालच्प्रत्यये पृषोदरादित्वात् टकारस्य डकारे च रूपमेवम्। </li> <li>दशपाद्युणादिवृत्तावत्र ‘विड--’ इति सौत्रो धातुर्ण्यन्तः।’ इति प्रोक्तम्। </li> <li>तच्चिन्त्यम्। </li> <li>तादृशस्य धातोः सूत्रेष्वनुपलम्भात्। </li> <li>दन्त्यौष्ठ्यादिं बशन्तं च येऽपि पठन्ति, तेषामपि वबयोरभेदोच्चारणमेव निदानमिति ज्ञेयम्।]] बिडालः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1123_01"><a href="#ref_krm_1123_01">↑</a> (१११३)</li> <li id="foot_krm_1123_02"><a href="#ref_krm_1123_02">↑</a> (१-भ्वादिः-३१७। अक। सेट्। पर।)</li> <li id="foot_krm_1123_03"><a href="#ref_krm_1123_03">↑</a> [[आ। ‘चेटैर्विटैश्चानुगतानबेटकैरेटत्पशूत्केटिरजः कटन् मलान्।’ धा। का। १। ४२।]]</li> <li id="foot_krm_1123_04"><a href="#ref_krm_1123_04">↑</a> (१९०)</li> <li id="foot_krm_1123_05"><a href="#ref_krm_1123_05">↑</a> [[१। ‘तमिबिडि--’ [द। उ। ८। ११५।]</li></ul></p>

बिदि|बिन्दकः-न्दिका|बिबिन्दिषकः-षिका|बेबिन्दकः-न्दिका
<ul><li><sup id="ref_krm_1124_01"><a href="#foot_krm_1124_01">1</a></sup> {@“बिदि अवयवे”@} <sup id="ref_krm_1124_02"><a href="#foot_krm_1124_02">2</a></sup> ‘अवयवे = एकदेशगतक्रियायाम्।’ इति क्षीरस्वामी। </li> <li>‘भिदि--’ इति सम्मताकारः। </li> <li>बिन्दकः-न्दिका, बिन्दकः-न्दिका, बिबिन्दिषकः-षिका, बेबिन्दकः-न्दिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककन्दतिवत् <sup id="ref_krm_1124_03"><a href="#foot_krm_1124_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1124_04"><a href="#foot_krm_1124_04">4</a></sup> बिन्दुः <sup id="ref_krm_1124_05"><a href="#foot_krm_1124_05">5</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1124_01"><a href="#ref_krm_1124_01">↑</a> (१११४)</li> <li id="foot_krm_1124_02"><a href="#ref_krm_1124_02">↑</a> (१-भ्वादिः-६४। अक। सेट्। पर।)</li> <li id="foot_krm_1124_03"><a href="#ref_krm_1124_03">↑</a> (१६३)</li> <li id="foot_krm_1124_04"><a href="#ref_krm_1124_04">↑</a> [[२। बाहुलकादौणादिके उप्रत्यये रूपम्। मैत्रेयस्तु ‘बिन्दुरिच्छुः’ (३-२-१६९) इति सूत्रे निपातनादुकारप्रत्ययान्तत्वं मेने। तदप्रामाणिकम्। यतः, काशिकादिषु “वेत्तेर्नुमि उप्रत्यये निपातनम् विन्दुः वेदनशीलः” इत्युक्तत्वात्। एतेन, ‘यद्यभिधानमस्ति--भिन्दुरिति दृश्यते।’ इति भिदिधातुमत्रावयवार्थे पठन्, तस्योप्रत्ययान्ते भिन्दुरिति साधयंश्च सम्मताकारोऽपि प्रतिबोधित इति ज्ञेयम्।]]</li> <li id="foot_krm_1124_05"><a href="#ref_krm_1124_05">↑</a> [[B। ‘श्रुतान्दुकैश्चित्तगजेन्द्ररोधिनस्तुष्यन्तु सन्तो गुणबिन्दुलोलुपाः।।’ धा। का। १। ९।]]</li></ul></p>

बिल|क्षीरस्वामि-|प्रमृतिभिरनुपादानादस्माभिर्न|लिखितः।]]|बेललः-लिका|बेलकः-लिका|बिबेलिषकः-बिबिलिषकः-षिका|बेबिलकः-लिका
<ul><li><sup id="ref_krm_1125_01"><a href="#foot_krm_1125_01">1</a></sup> {@“बिल भेदने”@} <sup id="ref_krm_1125_02"><a href="#foot_krm_1125_02">2</a></sup> <sup id="ref_krm_1125_03"><a href="#foot_krm_1125_03">3</a></sup> ‘बेलति इति शपि, अयं चुरादौ च।’ इति मा। </li> <li>धा। </li> <li>वृत्तौ आत्रेय- वाक्योपादानात् भ्वादिष्वपि कश्चन बिलधातुरस्तीति ज्ञायते। </li> <li>क्षीरस्वामि- प्रमृतिभिरनुपादानादस्माभिर्न लिखितः।]] बेललः--लिका, बेलकः-लिका, बिबेलिषकः-बिबिलिषकः-षिका, बेबिलकः- <sup id="ref_krm_1125_04"><a href="#foot_krm_1125_04">4</a></sup> लिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि तौदादिककिलतिवत् <sup id="ref_krm_1125_05"><a href="#foot_krm_1125_05">5</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1125_06"><a href="#foot_krm_1125_06">6</a></sup> बिलम्, <sup id="ref_krm_1125_07"><a href="#foot_krm_1125_07">7</a></sup> बिल्वम्, <sup id="ref_krm_1125_08"><a href="#foot_krm_1125_08">8</a></sup> बिल्मम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1125_01"><a href="#ref_krm_1125_01">↑</a> (१११५)</li> <li id="foot_krm_1125_02"><a href="#ref_krm_1125_02">↑</a> (६-तुदादिः-१३५९। सक। सेट्। पर।)</li> <li id="foot_krm_1125_03"><a href="#ref_krm_1125_03">↑</a> [[[अ]</li> <li id="foot_krm_1125_04"><a href="#ref_krm_1125_04">↑</a> [पृष्ठम्०९२५+ २६]</li> <li id="foot_krm_1125_05"><a href="#ref_krm_1125_05">↑</a> (१९३)</li> <li id="foot_krm_1125_06"><a href="#ref_krm_1125_06">↑</a> [[१। ‘इगुपधज्ञा--’ (३-१-१३५) इति कर्तरि कप्रत्यये रूपमेवम्।]]</li> <li id="foot_krm_1125_07"><a href="#ref_krm_1125_07">↑</a> [[२। बाहुलकात् औणादिके वक्प्रत्यये रूपमेवम्। प्रत्ययस्य कित्त्वान्न गुणः।]]</li> <li id="foot_krm_1125_08"><a href="#ref_krm_1125_08">↑</a> [[३। बाहुलकात् औणादिके मक्प्रत्यये रूपमेवम्।]]</li></ul></p>

बिल|बेलकः-लिका|बिबेलयिषकः-षिका
<ul><li><sup id="ref_krm_1126_01"><a href="#foot_krm_1126_01">1</a></sup> {@“बिल भेदने”@} <sup id="ref_krm_1126_02"><a href="#foot_krm_1126_02">2</a></sup> “भिल--’ इति कौशिकः। </li> <li>भेलयति, भेलः, भिल्मम्।” इति क्षीरस्वामी। </li> <li>‘बिल्मं भिल्मं भांसनमिति वा।’ इति निरुक्ते <sup id="ref_krm_1126_03"><a href="#foot_krm_1126_03">3</a></sup> प्रयोगोपलम्भात् ‘भिल--’ इत्येतस्यापि धातुपाठेषु पाठ उन्नीयते, इति युधिष्ठिरमीमांसक- मतम्। </li> <li>बेलकः-लिका, बिबेलयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकचेतयतिवत् <sup id="ref_krm_1126_04"><a href="#foot_krm_1126_04">4</a></sup> ज्ञेयानि। </li> <li>बेलयन्-न्ती, बेलयिष्यन्-न्ती-ती, इति शतरि रूपाणीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1126_01"><a href="#ref_krm_1126_01">↑</a> (१११६)</li> <li id="foot_krm_1126_02"><a href="#ref_krm_1126_02">↑</a> (१०-चुरादिः-१६०६। सक। सेट्। उभ।)</li> <li id="foot_krm_1126_03"><a href="#ref_krm_1126_03">↑</a> (१-२०)</li> <li id="foot_krm_1126_04"><a href="#ref_krm_1126_04">↑</a> (५२२)</li></ul></p>

बिस|बेसकः-सिका|बिबेसिषकः-बिबिसिषकः-षिका|बेबिसकः-|सिका
<ul><li><sup id="ref_krm_1127_01"><a href="#foot_krm_1127_01">1</a></sup> {@“बिस प्रेरणे”@} <sup id="ref_krm_1127_02"><a href="#foot_krm_1127_02">2</a></sup> ‘विस--’ इति कुत्रचिद् दृष्टः पाठोऽप्रामाणिकः। </li> <li>बेसकः-सिका, बेसकः-सिका, बिबेसिषकः-बिबिसिषकः-षिका, बेबिसकः- सिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि दैवादिककुस्यतिवत् <sup id="ref_krm_1127_03"><a href="#foot_krm_1127_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1127_04"><a href="#foot_krm_1127_04">4</a></sup> बिस्तः, बिसम्। </li> <li><sup id="ref_krm_1127_05"><a href="#foot_krm_1127_05">5</a></sup> बिसितम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1127_01"><a href="#ref_krm_1127_01">↑</a> (१११७)</li> <li id="foot_krm_1127_02"><a href="#ref_krm_1127_02">↑</a> (४-दिवादिः-१२१७। अक। अनि। पर।)</li> <li id="foot_krm_1127_03"><a href="#ref_krm_1127_03">↑</a> (२३४)</li> <li id="foot_krm_1127_04"><a href="#ref_krm_1127_04">↑</a> [[४। औणादिके (द। उ। ६-७) तन्प्रत्यये, ‘तितुत्रतथ--’ (७-२-९) इत्यादिना इण्निषेधे च रूपमेवम्। केचित्तु धातोरस्य सेट्त्वेऽपि, ‘अपरिमाणबिस्ताचित--’ (४-१-२२) इत्यत्र बिस्त इति निपातनान्निष्ठायामनिट्त्वमिति साधयन्ति। शास्त्रस्य सङ्कोचे प्रमाणाभावात् तच्चिन्त्यम्।]]</li> <li id="foot_krm_1127_05"><a href="#ref_krm_1127_05">↑</a> [[आ। ‘… वेदव्योषकृदप्लुषो बिसितधीकुस्यज्जनांहोबुसम्।’ धा। का। २। ६६।]]</li></ul></p>

बुक्क|बुक्ककः-क्किका|बुबुक्किषकः-षिका|बोबुक्ककः-क्किका
<ul><li><sup id="ref_krm_1128_01"><a href="#foot_krm_1128_01">1</a></sup> {@“बुक्क भषणे”@} <sup id="ref_krm_1128_02"><a href="#foot_krm_1128_02">2</a></sup> भषणम् = श्वरवः। </li> <li>क्षीरस्वामी तु ‘--भाषणे’ इति पठित्वा, ‘भषणे इत्येके।’ इत्याह। </li> <li>‘--आभाषणे।’ इति शाकटायनः। </li> <li>‘णिचि बुक्कयतीति स्यात्, भाषणे शपि बुक्कति।’ <sup id="ref_krm_1128_03"><a href="#foot_krm_1128_03">3</a></sup> इति देवः। </li> <li>अत्र देवमतेऽपि भाषणमेवार्थ इति ज्ञायते। </li> <li><sup id="ref_krm_1128_04"><a href="#foot_krm_1128_04">4</a></sup> बुक्ककः-क्किका, बुक्ककः-क्किका, बुबुक्किषकः-षिका, बोबुक्ककः-क्किका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककखतिवत् <sup id="ref_krm_1128_05"><a href="#foot_krm_1128_05">5</a></sup> ज्ञेयानि। </li> <li>अप्रत्यये--बुक्का <sup id="ref_krm_1128_06"><a href="#foot_krm_1128_06">6</a></sup> इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1128_01"><a href="#ref_krm_1128_01">↑</a> (१११८)</li> <li id="foot_krm_1128_02"><a href="#ref_krm_1128_02">↑</a> (१-भ्वादिः-११९। अक। सेट्। पर।)</li> <li id="foot_krm_1128_03"><a href="#ref_krm_1128_03">↑</a> (श्लो। ४२)</li> <li id="foot_krm_1128_04"><a href="#ref_krm_1128_04">↑</a> [पृष्ठम्०९२६+ २५]</li> <li id="foot_krm_1128_05"><a href="#ref_krm_1128_05">↑</a> (१४१)</li> <li id="foot_krm_1128_06"><a href="#ref_krm_1128_06">↑</a> [[आ। ‘अफक्कताऽतक्यगुणेन तङ्कता खलश्वबुक्कापरुषे पुरेऽमुना।’ धा। का। १। १७।]]</li></ul></p>

बुक्क|बुक्ककः-क्किका|बुबुक्कयिषकः-षिका
<ul><li><sup id="ref_krm_1129_01"><a href="#foot_krm_1129_01">1</a></sup> {@“बुक्क भाषणे”@} <sup id="ref_krm_1129_02"><a href="#foot_krm_1129_02">2</a></sup> ‘-- भषणे’ इति धा। </li> <li>का। </li> <li><sup id="ref_krm_1129_03"><a href="#foot_krm_1129_03">3</a></sup> व्याख्यादृष्टः प्राठः। </li> <li>‘णिचि बुक्कयतीति स्यात्, भाषणे शपि बुक्कति।’ <sup id="ref_krm_1129_04"><a href="#foot_krm_1129_04">4</a></sup> इति देवः। </li> <li>बुक्ककः-क्किका, बुबुक्कयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिक- कुट्टयतिवत् <sup id="ref_krm_1129_05"><a href="#foot_krm_1129_05">5</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1129_06"><a href="#foot_krm_1129_06">6</a></sup> बुक्कयिष्णुः <sup id="ref_krm_1129_07"><a href="#foot_krm_1129_07">7</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1129_01"><a href="#ref_krm_1129_01">↑</a> (१११९)</li> <li id="foot_krm_1129_02"><a href="#ref_krm_1129_02">↑</a> (१०-चुरादिः-१७१४। अक। सेट्। उभ।)</li> <li id="foot_krm_1129_03"><a href="#ref_krm_1129_03">↑</a> (३-३८)</li> <li id="foot_krm_1129_04"><a href="#ref_krm_1129_04">↑</a> (श्लो। ४२)</li> <li id="foot_krm_1129_05"><a href="#ref_krm_1129_05">↑</a> (२०७)</li> <li id="foot_krm_1129_06"><a href="#ref_krm_1129_06">↑</a> [[१। छान्दसा अपि प्रत्ययाः क्वचिद् भाषायां क्वस्वादिवत् भवन्तीति, ‘णेश्छन्दसि’ (३-२-१३७) इति ताच्छीलिक इष्णुच्प्रत्यये णेरयादेशे च रूपमेवमिति ज्ञेयम्।]]</li> <li id="foot_krm_1129_07"><a href="#ref_krm_1129_07">↑</a> [[B। ‘सञ्चर्चयन् अपनयानथ बुक्कयिष्णुः श्वेवोग्रशब्दनपरः कररुद्धकाणः।’ धा। का। ३-३८।]]</li></ul></p>

बुगि|बुङ्गकः-ङ्गिका|बुबुङ्गिषकः-षिका|बोबुङ्गकः-ङ्गिका
<ul><li><sup id="ref_krm_1130_01"><a href="#foot_krm_1130_01">1</a></sup> {@“बुगि वर्जने”@} <sup id="ref_krm_1130_02"><a href="#foot_krm_1130_02">2</a></sup> ‘वुगि--’ इत्यस्य पाठभेदोऽयम्। </li> <li>‘भुगि भर्जने इत्येके।’ इति क्षीरस्वामी। </li> <li>बुङ्गकः-ङ्गिका, बुङ्गकः-ङ्गिका, बुबुङ्गिषकः-षिका, बोबुङ्गकः-ङ्गिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककुण्ठतिवत् <sup id="ref_krm_1130_03"><a href="#foot_krm_1130_03">3</a></sup> ज्ञेयानि। </li> <li>ण्यति-- <sup id="ref_krm_1130_04"><a href="#foot_krm_1130_04">4</a></sup> बुङ्ग्यम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1130_01"><a href="#ref_krm_1130_01">↑</a> (११२०)</li> <li id="foot_krm_1130_02"><a href="#ref_krm_1130_02">↑</a> (१-भ्वादिः-१५८। सक। सेट्। पर।)</li> <li id="foot_krm_1130_03"><a href="#ref_krm_1130_03">↑</a> (२०९)</li> <li id="foot_krm_1130_04"><a href="#ref_krm_1130_04">↑</a> [[C। ‘विजुङ्ग्य बुङ्ग्यं गुणसंघदङ्घका अलङ्घितानन्दरसात्तघर्घनाः।’ धा। का। १। २२।]]</li></ul></p>

बुध
<ul><li><sup id="ref_krm_1131_01"><a href="#foot_krm_1131_01">1</a></sup> {@“बुध अवगमने”@} <sup id="ref_krm_1131_02"><a href="#foot_krm_1131_02">2</a></sup> ज्वलादिः। </li> <li>‘बुध्यते बोधतीत्येवं बुधेरवगमे द्वयम्। </li> <li>बुधिरो बोधनार्थस्य बोधते बोधतीत्यपि।।’ <sup id="ref_krm_1131_03"><a href="#foot_krm_1131_03">3</a></sup> इति देवः। </li> <li>अवगमनम् = उद्बोधः, ज्ञानं च। </li> <li>आद्ये-अकर्मकः, द्वितीये-सकर्मकः। </li> <li>बोधकः-धिका, बोधकः-धिका, बुबोधिषकः-बुबुधिषकः-षिका, बोबुधकः- धिका इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककोलतिवत् <sup id="ref_krm_1131_04"><a href="#foot_krm_1131_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1131_05"><a href="#foot_krm_1131_05">5</a></sup> <sup id="ref_krm_1131_06"><a href="#foot_krm_1131_06">6</a></sup> बोधयन् शिष्यं धर्मम्। </li> <li><sup id="ref_krm_1131_07"><a href="#foot_krm_1131_07">7</a></sup> प्रबोधी-प्रतिबोधी। </li> <li>राज्ञां <sup id="ref_krm_1131_08"><a href="#foot_krm_1131_08">8</a></sup> बोधितः-बुधितो वा। </li> <li><sup id="ref_krm_1131_09"><a href="#foot_krm_1131_09">9</a></sup> विबुघः <sup id="ref_krm_1131_10"><a href="#foot_krm_1131_10">10</a></sup> -बोधः, <sup id="ref_krm_1131_11"><a href="#foot_krm_1131_11">11</a></sup> अविबोधयन्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1131_01"><a href="#ref_krm_1131_01">↑</a> (११२१)</li> <li id="foot_krm_1131_02"><a href="#ref_krm_1131_02">↑</a> (१-भ्वादिः-८५८। सक। सेट्। पर।)</li> <li id="foot_krm_1131_03"><a href="#ref_krm_1131_03">↑</a> (श्लो। ११९)</li> <li id="foot_krm_1131_04"><a href="#ref_krm_1131_04">↑</a> (२३१)</li> <li id="foot_krm_1131_05"><a href="#ref_krm_1131_05">↑</a> [पृष्ठम्०९२७+ २९]</li> <li id="foot_krm_1131_06"><a href="#ref_krm_1131_06">↑</a> [[१। ‘बुधयुधनशजनेङ्प्रुद्रुस्रुभ्यो णेः’ (१-३-८६) इति ण्यन्तादस्मात् परस्मैपदमेव। यदाऽयं चित्तवत्कर्तृकः, तदाऽपि, ‘अणावकर्मकात् चित्तवत्कर्तृकात्’ (१-३-८८) इति ण्यन्तात् परस्मैपदमेवेति ज्ञेयम्। अत्र, ‘गतिबुद्धिप्रत्यवसानार्थ--’ (१-४-५२) इत्यनेन बुघ्द्यर्थत्वात् अण्यन्तावस्थायां कर्तुः, ण्यन्तावस्थायां कर्मसंज्ञेत्यपि ज्ञेयम्।]]</li> <li id="foot_krm_1131_07"><a href="#ref_krm_1131_07">↑</a> [[२। ‘भविष्यति गम्यादयः’ (३-३-३) इति सूत्रे, प्र--प्रतिपूर्वकस्यास्य णिनिप्रत्ययान्त- त्वेन गणपाठात् भविष्यत्यर्थे णिनिः।]]</li> <li id="foot_krm_1131_08"><a href="#ref_krm_1131_08">↑</a> [[३। ‘मतिबुद्धिपूजार्थेभ्यश्च’ (३-२-१८८) इति वर्तमाने आदिकर्मणि च क्तप्रत्ययः। ‘उदुपधाद् भावादिकर्मणोः--’ (१-२-२१) इति कित्त्वविकल्पः। ‘क्तस्य च वर्तमाने’ (२-३-६७) इति षष्ठी। अत्र क्षीरतरङ्गिण्यां बोद्धा, बुद्धः इति इड्रहितप्रयोगौ प्रदर्शितौ। अनिट्कारिकासु (७-२-१०) बुध्यति इति श्यना निर्देशात् दैवादिकस्यैवानिट्त्वमिति, अस्य भौवादिकत्वेन सेड्रूपाण्येव भवन्तीति च युक्तमुत्पश्यामः।]]</li> <li id="foot_krm_1131_09"><a href="#ref_krm_1131_09">↑</a> [[४। ‘ज्वलितिकसन्तेभ्यो णः।’ (३-१-१४०) इति कर्तरि णप्रत्ययविकल्पः। तस्य वैकल्पिकत्वात्, कर्तरि पक्षे इगुपधलक्षणकप्रत्यये बुधः, बिबुधः इत्यादीनां सिद्धिः। ‘अभिधानलक्षणाः कृत्तद्धितसमासान्ताः, (भाष्यम्-३-३-१) इति वचनात् सामान्येन विहितानामपि कृतां क्वचित् संज्ञायामपि सम्भव इति, अत्र कप्रत्ययः संज्ञायामपि। तेन बुधः इति ग्रहविशेषस्य, जातिविशेषस्य च संज्ञा।]]</li> <li id="foot_krm_1131_10"><a href="#ref_krm_1131_10">↑</a> [[आ। ‘… तमहमितो विलोक्य विबुधैः कृतोत्तमायोधनम्।’ भ। का। १०। ३७।]]</li> <li id="foot_krm_1131_11"><a href="#ref_krm_1131_11">↑</a> [[B। ‘ततः प्राकारमारोहत् क्षपाटानविबोधयन्।’ भ। का। ८। ५६।]]</li></ul></p>

बुध|बोधकः-धिका|बुभुत्सकः-त्सिका|बोबुधकः-धिका
<ul><li><sup id="ref_krm_1132_01"><a href="#foot_krm_1132_01">1</a></sup> {@“बुध अवगमने”@} <sup id="ref_krm_1132_02"><a href="#foot_krm_1132_02">2</a></sup> <sup id="ref_krm_1132_03"><a href="#foot_krm_1132_03">3</a></sup> ‘तत्त्वं बुध्यते’ इति धर्मकीर्त्ति प्रयोगात्, ‘क्रमादमुं नारद इत्यबोधि सः।।’ <sup id="ref_krm_1132_04"><a href="#foot_krm_1132_04">4</a></sup> इति माघप्रयोगाच्च सकर्मकत्वमप्यस्यास्तीति ज्ञायते। </li> <li>परं तु ‘अत्र बुधादीनां चतुर्णाम्, ‘अणावकर्मकात्--’ <sup id="ref_krm_1132_05"><a href="#foot_krm_1132_05">5</a></sup> इत्येव सिद्धे, वचनमिदम् अचित्तवत्कर्तृकार्थम्।’ इति प्रतिपादयतो वृत्तिकारादेरेतदनभिमत- मिति ज्ञायते। </li> <li>मा। </li> <li>धा। </li> <li>वृत्तौ तु ‘अयमर्थभेदेन सकर्मकोऽकर्मकश्च।’ इति समाहितम्।]] ‘बुध्यते बोधतीत्येवं बुधेरवगमे द्वयम्।’ <sup id="ref_krm_1132_06"><a href="#foot_krm_1132_06">6</a></sup> इति देवः। </li> <li><sup id="ref_krm_1132_07"><a href="#foot_krm_1132_07">7</a></sup> बोधकः-धिका, बोधकः-धिका, <sup id="ref_krm_1132_08"><a href="#foot_krm_1132_08">8</a></sup> बुभुत्सकः-त्सिका, बोबुधकः-धिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि दैवादिकक्षुध्यतिवत् <sup id="ref_krm_1132_09"><a href="#foot_krm_1132_09">9</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1132_10"><a href="#foot_krm_1132_10">10</a></sup> बुद्धः, <sup id="ref_krm_1132_11"><a href="#foot_krm_1132_11">11</a></sup> बुधानः, <sup id="ref_krm_1132_12"><a href="#foot_krm_1132_12">12</a></sup> बुबुधानः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1132_01"><a href="#ref_krm_1132_01">↑</a> (११२२)</li> <li id="foot_krm_1132_02"><a href="#ref_krm_1132_02">↑</a> (४-दिवादिः-११७२। अक। अनि। आत्म।)</li> <li id="foot_krm_1132_03"><a href="#ref_krm_1132_03">↑</a> [[[अ]</li> <li id="foot_krm_1132_04"><a href="#ref_krm_1132_04">↑</a> (शि। व। १। ३)</li> <li id="foot_krm_1132_05"><a href="#ref_krm_1132_05">↑</a> (१-३-८८)</li> <li id="foot_krm_1132_06"><a href="#ref_krm_1132_06">↑</a> (श्लो। ११९)</li> <li id="foot_krm_1132_07"><a href="#ref_krm_1132_07">↑</a> [पृष्ठम्०९२८+ २९]</li> <li id="foot_krm_1132_08"><a href="#ref_krm_1132_08">↑</a> [[१। सन्नन्ताण्ण्वुलि, ‘हलन्ताच्च’ (१-२-१०) इति सनः कित्त्वे, भष्भावे चर्त्वे च रूपम्।]]</li> <li id="foot_krm_1132_09"><a href="#ref_krm_1132_09">↑</a> (३१५)</li> <li id="foot_krm_1132_10"><a href="#ref_krm_1132_10">↑</a> [[२। ‘क्तिच्क्तौ च संज्ञायाम्’ (३-३-१७४) इति संज्ञायाम् क्तप्रत्ययः। बुध्यतीति बुद्धः = सिद्धार्थः।]]</li> <li id="foot_krm_1132_11"><a href="#ref_krm_1132_11">↑</a> [[३। ‘युधिबुधिदृशेः किच्च’ (द। उ। ५-३३) इत्यानच्प्रत्ययः, किच्च। कित्त्वान्न गुणः। बुधानः = आचार्यः।]]</li> <li id="foot_krm_1132_12"><a href="#ref_krm_1132_12">↑</a> [[४। ‘मुचिबुधिभ्यां सन्वच्च’ इति मा। धा। वृत्त्युपात्तेन औणादिकसूत्रेण आनच्प्रत्यये, तस्य सन्वद्भावात् द्वित्वे, कित्त्वे च रूपम्। बुबुधानः = बोद्धुमिच्छुः।]]</li></ul></p>

बुधिर्|बोधकः-धिका|बुबोधिषकः-बुबुधिषकः-षिका|बोबुधकः-धिका
<ul><li><sup id="ref_krm_1133_01"><a href="#foot_krm_1133_01">1</a></sup> {@“बुधिर् बोधने”@} <sup id="ref_krm_1133_02"><a href="#foot_krm_1133_02">2</a></sup> ‘बुधिरो बोधनार्थस्य बोधते बोधतीत्यपि।।’ <sup id="ref_krm_1133_03"><a href="#foot_krm_1133_03">3</a></sup> इति देवः। </li> <li>चान्द्राः, क्षीरस्वामी च ‘बुध--’ इत्यनिरितं पठन्ति। </li> <li>बोधकः-धिका, बोधकः-धिका, बुबोधिषकः-बुबुधिषकः-षिका, बोबुधकः-धिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककोलतिवत् <sup id="ref_krm_1133_04"><a href="#foot_krm_1133_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1133_05"><a href="#foot_krm_1133_05">5</a></sup> बोधयमानः, <sup id="ref_krm_1133_06"><a href="#foot_krm_1133_06">6</a></sup> विबोध्यः, <sup id="ref_krm_1133_07"><a href="#foot_krm_1133_07">7</a></sup> तत्त्वबोधः- <sup id="ref_krm_1133_08"><a href="#foot_krm_1133_08">8</a></sup> तत्त्वबोधिनी।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1133_01"><a href="#ref_krm_1133_01">↑</a> (११२३)</li> <li id="foot_krm_1133_02"><a href="#ref_krm_1133_02">↑</a> (१-भ्वादिः-८७५। सक। सेट्। उभ।)</li> <li id="foot_krm_1133_03"><a href="#ref_krm_1133_03">↑</a> (श्लो। ११९)</li> <li id="foot_krm_1133_04"><a href="#ref_krm_1133_04">↑</a> (२३१)</li> <li id="foot_krm_1133_05"><a href="#ref_krm_1133_05">↑</a> [[५। ‘बुधयुध--’ (१-३-८६) इत्यत्र, अकर्मकैः युध-नश-जनैः साहचर्यात् तादृशस्या- कर्मकस्यैव ग्रहणमिति, सकर्मकोऽयं न तत्र विवक्षितः। तेनास्मात् ‘णिचश्च’ (१-३-७४) इत्यस्य प्रवृत्त्या यथासम्भवं ण्यन्तात् शता शानच्च भवतीति विशेषः।]]</li> <li id="foot_krm_1133_06"><a href="#ref_krm_1133_06">↑</a> [[आ। ‘या नेदितोर्वीपरिशर्धिवीचीविमृद्धवृक्षादिविबोध्यशैत्या।।’ धा। का। २। २६।]]</li> <li id="foot_krm_1133_07"><a href="#ref_krm_1133_07">↑</a> [[६। ‘कर्मण्यण्’ (३-२-१) इत्यणि रूपमेवम्।]]</li> <li id="foot_krm_1133_08"><a href="#ref_krm_1133_08">↑</a> [[७। ताच्छील्ये णिनिप्रत्यये रूपमेवम्। स्त्रियां ङीप्।]]</li></ul></p>

उ|बुन्दकः-न्दिका|बुबुन्दिषकः-षिका|बोबुदकः-दिका
<ul><li><sup id="ref_krm_1134_01"><a href="#foot_krm_1134_01">1</a></sup> {@“उ बुन्दिर् निशामने”@} <sup id="ref_krm_1134_02"><a href="#foot_krm_1134_02">2</a></sup> ‘उ बुन्धिर् <sup id="ref_krm_1134_03"><a href="#foot_krm_1134_03">3</a></sup> --’ इति नन्दी। </li> <li>‘उ बेदिर्--’ इत्यन्ये।’ इति क्षीरस्वामी। </li> <li>‘उ चुन्दिर्--’ इति काशकृत्स्नचन्द्रौ पेठतुरिति क्षीरतरङ्गिणीटीका। </li> <li><sup id="ref_krm_1134_04"><a href="#foot_krm_1134_04">4</a></sup> बुन्दकः-न्दिका, बुन्दकः-न्दिका, बुबुन्दिषकः-षिका, बोबुदकः-दिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकतुम्पतिवत् <sup id="ref_krm_1134_05"><a href="#foot_krm_1134_05">5</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1134_06"><a href="#foot_krm_1134_06">6</a></sup> बुन्दमानः-बुन्दिष्यमाणः, <sup id="ref_krm_1134_07"><a href="#foot_krm_1134_07">7</a></sup> बुन्नम्-बुन्नः-बुन्नवान्, <sup id="ref_krm_1134_08"><a href="#foot_krm_1134_08">8</a></sup> बुन्दित्वा-बुत्त्वा, <sup id="ref_krm_1134_09"><a href="#foot_krm_1134_09">9</a></sup> बुद्बुदः इत्यादीनि रूपाण्यस्य धातोः विशेषेण सम्भवन्तीति विशेषः। </li> <li><sup id="ref_krm_1134_10"><a href="#foot_krm_1134_10">10</a></sup> प्रबुन्द्यः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1134_01"><a href="#ref_krm_1134_01">↑</a> (११२४)</li> <li id="foot_krm_1134_02"><a href="#ref_krm_1134_02">↑</a> (१-भ्वादिः-८७६। सक। सेट्। उभ।)</li> <li id="foot_krm_1134_03"><a href="#ref_krm_1134_03">↑</a> [[८। “… आचार्यप्रवृत्तिर्ज्ञापयति-- ‘नैवंजातीयकानामिदिद्विधिर्भवति’ इति;\n\n  यदयमि- रितः कांश्चिन्नुमनुषक्तान् पठति-- ‘उ बुन्दिर् निशामने’…।” इति भाष्य- (१-३-७) वचनप्रामाण्यात् धकारपाठोऽप्रामाणिक इति ज्ञेयम्। अनेनैव भाष्य- वाक्येन कुत्रचिद्धातुषु अर्थनिर्देशः पाणिनीय एवेत्यपि बोध्यम्।]]</li> <li id="foot_krm_1134_04"><a href="#ref_krm_1134_04">↑</a> [पृष्ठम्०९२९+ २६]</li> <li id="foot_krm_1134_05"><a href="#ref_krm_1134_05">↑</a> (७४२)</li> <li id="foot_krm_1134_06"><a href="#ref_krm_1134_06">↑</a> [[१। अस्य धातोरुभयपदित्वात् शानजपि भवतीति विशेषः।]]</li> <li id="foot_krm_1134_07"><a href="#ref_krm_1134_07">↑</a> [[२। उदित्त्वेन क्त्त्वायामिड्विकल्पनात् ‘यस्य विभाषा’ (७-२-१५) इति निष्ठा- यामिण्निषेधे, उपधानकारलोपे, निष्ठातकार-धातुदकारयोर्नत्वे च रूपमेवम्।]]</li> <li id="foot_krm_1134_08"><a href="#ref_krm_1134_08">↑</a> [[३। ‘उदितो वा’ (७-२-५६) इति क्त्वायामिड्विकल्पः। इट्पक्षे ‘न क्त्वा सेट्’ (१-२-१८) इति कित्त्वनिषेधादुपधानकारलोपो न। इडभावपक्षे तु नकारलोपे, धातुदकारस्य चर्त्वे च बुत्त्वा इति द्वितकारकं रूपमिति ज्ञेयम्।]]</li> <li id="foot_krm_1134_09"><a href="#ref_krm_1134_09">↑</a> [[४। घञर्थे कप्रत्यये, ‘कृञादीनां के द्वे भवतः’ (वा। ६-१-१२) इति द्विर्वचने, पृषोदरादित्वात् (६-३-१०९) हलादिशेषाभावे च रूपमेवम्।]]</li> <li id="foot_krm_1134_10"><a href="#ref_krm_1134_10">↑</a> [[आ। ‘प्रबुन्द्यवेणीजववेनमाना खातान्तिका चीवरिभिर्निषादैः।’ धा। का। २। २७।]]</li></ul></p>

बुल|बोलकः-लिका|बुबोलयिषकः-षिका
<ul><li><sup id="ref_krm_1135_01"><a href="#foot_krm_1135_01">1</a></sup> {@“बुल निमज्जने”@} <sup id="ref_krm_1135_02"><a href="#foot_krm_1135_02">2</a></sup> ‘चुल समुच्छ्राये’ <sup id="ref_krm_1135_03"><a href="#foot_krm_1135_03">3</a></sup> इति चुरादिधातोः क्षीरस्वामिसम्मतः पाठ एवम्। </li> <li>इतरे सर्वेऽप्यमुं न पठन्ति। </li> <li>बोलकः-लिका, बुबोलयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकचोरयतिवत् <sup id="ref_krm_1135_04"><a href="#foot_krm_1135_04">4</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1135_01"><a href="#ref_krm_1135_01">↑</a> (११२५)</li> <li id="foot_krm_1135_02"><a href="#ref_krm_1135_02">↑</a> (१०-चुरादिः-१६०२। अक। सेट्। उभ।)</li> <li id="foot_krm_1135_03"><a href="#ref_krm_1135_03">↑</a> (५४७)</li> <li id="foot_krm_1135_04"><a href="#ref_krm_1135_04">↑</a> (५४६)</li></ul></p>

बुस|बोसकः-सिका|बुबुसिषकः-बुबोसिषकः-षिका|बोबुसकः-|सिका
<ul><li><sup id="ref_krm_1136_01"><a href="#foot_krm_1136_01">1</a></sup> {@“बुस उत्सर्गे”@} <sup id="ref_krm_1136_02"><a href="#foot_krm_1136_02">2</a></sup> बोसकः-सिका, बोसकः-सिका, बुबुसिषकः-बुबोसिषकः-षिका, बोबुसकः- सिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि दैवादिककुस्यतिवत् <sup id="ref_krm_1136_03"><a href="#foot_krm_1136_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1136_04"><a href="#foot_krm_1136_04">4</a></sup> बुसम्, <sup id="ref_krm_1136_05"><a href="#foot_krm_1136_05">5</a></sup> <sup id="ref_krm_1136_06"><a href="#foot_krm_1136_06">6</a></sup> खलेबुसम्, <sup id="ref_krm_1136_07"><a href="#foot_krm_1136_07">7</a></sup> बुस्तः। </li> <li><sup id="ref_krm_1136_08"><a href="#foot_krm_1136_08">8</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1136_01"><a href="#ref_krm_1136_01">↑</a> (११२६)</li> <li id="foot_krm_1136_02"><a href="#ref_krm_1136_02">↑</a> (४-दिवादिः-१२१९। सक। सेट्। पर।)</li> <li id="foot_krm_1136_03"><a href="#ref_krm_1136_03">↑</a> (२३४)</li> <li id="foot_krm_1136_04"><a href="#ref_krm_1136_04">↑</a> [[५। इगुपधलक्षणे कप्रत्यये रूपमेवम्। बुसम् = धान्यादीनां निस्सारो भागः।]]</li> <li id="foot_krm_1136_05"><a href="#ref_krm_1136_05">↑</a> [[B। ‘… वेदव्योषकृदप्लुषो बिसितधीकुस्यज्जनांहोबुसम्।’ धा। का। २। ६६।]]</li> <li id="foot_krm_1136_06"><a href="#ref_krm_1136_06">↑</a> [[६। यस्मिन् काले खले बुसं वर्तते स कालः = खलेबुसम्। तिष्ठद्गुप्रभृतिषु (२-१-१७) पाठात् अव्ययीभावसमासः, सप्तम्या अलुक् च।]]</li> <li id="foot_krm_1136_07"><a href="#ref_krm_1136_07">↑</a> [[७। औणादिके (द। उ। ६-७) तन्प्रत्यये, ‘तितुत्रत--’ (७-२-९) इत्यादिना इण्निषेधे च रूपमेवम्। यद्वा, अर्धर्चादिषु (२-४-३१) बुस्त इति पाठान्निष्ठायामनिट्त्वमिति बोध्यम्।]]</li> <li id="foot_krm_1136_08"><a href="#ref_krm_1136_08">↑</a> [पृष्ठम्०९३०+ २७]</li></ul></p>

बुस्त|बुस्तकः-स्तिका|बुबुस्तयिषकः-षिका
<ul><li><sup id="ref_krm_1137_01"><a href="#foot_krm_1137_01">1</a></sup> {@“बुस्त आदरानादरयोः”@} <sup id="ref_krm_1137_02"><a href="#foot_krm_1137_02">2</a></sup> ‘--बन्धने।’ इति क्षीरस्वाम्युद्धृतश्चान्द्रसम्मतपाठः। </li> <li>‘मुद्रितचान्द्र- घातुपाठे तु ‘-- वञ्चने’ इत्येव दृश्यते।’ इति क्षी। </li> <li>टीका। </li> <li>‘-- दाना- दरयोः’ इति धा। </li> <li>का। </li> <li>व्याख्यायां <sup id="ref_krm_1137_03"><a href="#foot_krm_1137_03">3</a></sup> दृष्टः पाठः। </li> <li>बुस्तकः-स्तिका, बुबुस्तयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिककुस्मयतिवत् <sup id="ref_krm_1137_04"><a href="#foot_krm_1137_04">4</a></sup> ज्ञेयानि। </li> <li>अस्योभयपदित्वात् शताऽपि भवतीति विशेषः। </li> <li><sup id="ref_krm_1137_05"><a href="#foot_krm_1137_05">5</a></sup> सम्बुस्तितः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1137_01"><a href="#ref_krm_1137_01">↑</a> (११२७)</li> <li id="foot_krm_1137_02"><a href="#ref_krm_1137_02">↑</a> (१०-चुरादिः-१५९१। सक। सेट्। उभ।)</li> <li id="foot_krm_1137_03"><a href="#ref_krm_1137_03">↑</a> (३-२०)</li> <li id="foot_krm_1137_04"><a href="#ref_krm_1137_04">↑</a> (२३६)</li> <li id="foot_krm_1137_05"><a href="#ref_krm_1137_05">↑</a> [[आ। ‘संबुस्तिते गिरिमखे परिचोद्य गोपान् प्रानक्कयद्धरिमखं मदधक्कनार्थी।।’ धा। का। ३। २०।]]</li></ul></p>

बृह|बर्हकः-र्हिका|बिबर्हिषकः-षिका|बरीबृहकः-हिका
<ul><li><sup id="ref_krm_1138_01"><a href="#foot_krm_1138_01">1</a></sup> {@“बृह वृद्धौ”@} <sup id="ref_krm_1138_02"><a href="#foot_krm_1138_02">2</a></sup> ‘… बृंहति बर्हति। </li> <li>वृद्धौ, भाषार्थविषये बृंहयेद् बर्हयेदिति।।’ <sup id="ref_krm_1138_03"><a href="#foot_krm_1138_03">3</a></sup> इति देवः। </li> <li>बर्हकः-र्हिका, बर्हकः-र्हिका, बिबर्हिषकः-षिका, बरीबृहकः-हिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकदर्हतिवत् <sup id="ref_krm_1138_04"><a href="#foot_krm_1138_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1138_05"><a href="#foot_krm_1138_05">5</a></sup> परिबृढः <sup id="ref_krm_1138_06"><a href="#foot_krm_1138_06">6</a></sup>, परिबृहितः, <sup id="ref_krm_1138_07"><a href="#foot_krm_1138_07">7</a></sup> बृहत्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1138_01"><a href="#ref_krm_1138_01">↑</a> (११२८)</li> <li id="foot_krm_1138_02"><a href="#ref_krm_1138_02">↑</a> (१-भ्वादिः-७३५। अक। सेट्। पर।)</li> <li id="foot_krm_1138_03"><a href="#ref_krm_1138_03">↑</a> (श्लो। १९८)</li> <li id="foot_krm_1138_04"><a href="#ref_krm_1138_04">↑</a> (८६६)</li> <li id="foot_krm_1138_05"><a href="#ref_krm_1138_05">↑</a> [[१। परिपूर्बादस्मान्निष्ठायाम्, इडभावः, तकारस्य ढत्वम्, हकारस्य लोपः इति, ‘प्रभौ परिबृढः’ (७-२-२१) इत्यनेन प्रभावभिधेये निपातितः। अन्यत्र परिबृहितः। अत्र बृंहतेरेव सानुषङ्गस्येदं निपातनमिति वार्तिककारपक्ष इति पदमञ्जर्य- नुसारेण मा। धा। वृत्तावुक्तम्। भाष्ये दर्हतिदृंहति विषय एव प्रकृत्यन्तरसद्भावे प्रमाणं प्रदर्शितमिति बोध्यम्। किञ्च, अत्र सर्वत्र भाष्यकोशेषु ‘प्रभौ परिवृढः’ (७-२-२१) इत्युपादाय परिवृढः इत्येव रूपसम्पादनं कृतमिति ज्ञायते। अतश्च दन्तोष्ठ्यादिः वर्हतिर्लिखिषमाणैव भाष्योपात्तेत्यपि ज्ञायते। अत्र तत्त्वं विद्वांसो विभावयन्तु।]]</li> <li id="foot_krm_1138_06"><a href="#ref_krm_1138_06">↑</a> [[B। ‘तान् दृष्ट्वाऽतिदृढान् धृष्टान् प्राप्तान् परिबृढाज्ञया।’ भ। का। ९। १८।]]</li> <li id="foot_krm_1138_07"><a href="#ref_krm_1138_07">↑</a> [[२। ‘वर्तमाने पृषद्बृहत्--’ (द। उ। ६। ५) इति कतिप्रत्ययः, तस्य शतृवद्भावश्च।]]</li></ul></p>

बृहि|बृंहकः-बृंहिका|बिबृंहिषकः-षिका|बरीबृंहकः-हिका
<ul><li><sup id="ref_krm_1139_01"><a href="#foot_krm_1139_01">1</a></sup> {@“बृहि वृद्धौ शब्दे च”@} <sup id="ref_krm_1139_02"><a href="#foot_krm_1139_02">2</a></sup> <sup id="ref_krm_1139_03"><a href="#foot_krm_1139_03">3</a></sup> अत्र शब्दः-गजशब्द एव, लोके तथैव प्रयोगात्। </li> <li>‘बृहिर्--’ इति चन्द्रदुर्गौ। </li> <li>‘… बृंहति बर्हति। </li> <li>वृद्धौ, भाषार्थविषये बृंहयेत् बर्हयेदिति।।’ <sup id="ref_krm_1139_04"><a href="#foot_krm_1139_04">4</a></sup> इति देवः। </li> <li>बृंहकः-बृंहिका, बृंहकः-बृंहिका, बिबृंहिषकः-षिका, बरीबृंहकः-हिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकदर्हतिवत् <sup id="ref_krm_1139_05"><a href="#foot_krm_1139_05">5</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1139_06"><a href="#foot_krm_1139_06">6</a></sup> परिबृढः- <sup id="ref_krm_1139_07"><a href="#foot_krm_1139_07">7</a></sup> उपबृंहितः, <sup id="ref_krm_1139_08"><a href="#foot_krm_1139_08">8</a></sup> बर्हिः, <sup id="ref_krm_1139_09"><a href="#foot_krm_1139_09">9</a></sup> ब्रह्म।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1139_01"><a href="#ref_krm_1139_01">↑</a> (११२९)</li> <li id="foot_krm_1139_02"><a href="#ref_krm_1139_02">↑</a> (१-भ्वादिः-७३६। अक। सेट्। पर।)</li> <li id="foot_krm_1139_03"><a href="#ref_krm_1139_03">↑</a> [पृष्ठम्०९३१+ २६]</li> <li id="foot_krm_1139_04"><a href="#ref_krm_1139_04">↑</a> (श्लो। १९८)</li> <li id="foot_krm_1139_05"><a href="#ref_krm_1139_05">↑</a> (८६६)</li> <li id="foot_krm_1139_06"><a href="#ref_krm_1139_06">↑</a> [[१। अत्रापि प्रभावभिधेये, ‘प्रभौ परिबृढः’ (७-२-२१) इति क्तप्रत्ययस्यानिट्त्वं तका- रस्य ढत्वं नकारहकारयोर्लोपश्च निपात्यते। अन्यत्र बृहितम् इत्येव। ‘बृंहितं = करिगर्जितम्।’ इति अमरः (२-८-१०७)।]]</li> <li id="foot_krm_1139_07"><a href="#ref_krm_1139_07">↑</a> [[आ। ‘यानैरप्युपबृंहितो विहितवान् प्रातः प्रयातुं मनः।’ धा। का। १। ९२।]]</li> <li id="foot_krm_1139_08"><a href="#ref_krm_1139_08">↑</a> [[२। ‘बृंहेर्नलोपश्च’ (द। उ। ९-३१) इतीसिप्रत्यये नलोपे च रूपम्। पश्चात् गुणः। बर्हिः = वेद्यास्तरणम्।]]</li> <li id="foot_krm_1139_09"><a href="#ref_krm_1139_09">↑</a> [[३। ‘बृंहिर्नोऽच्च’ (द। उ। ६-७४) इति मनिन्प्रत्यये धातूपधानकारस्य अकारे, पश्चाद् यणि च रूपम्। ब्रह्म = परं तेजः, वेदश्च।]]</li></ul></p>

बृहि|बृंहकः-हिका|बिबृंहयिषकः-षिका|बृंहयिता-त्री|बिबृंहयिषिता-त्री|बृंहयन्-न्ती|बिबृंहयिषन्-न्ती|बृंहयिष्यन्-न्ती-ती|बिबृंहयिषिष्यन्-न्ती-ती|बृंहयमाणः|बिबृंहयिषमाणः|बृंहयिष्यमाणः|बिबृंहयिषिष्यमाणः|सुवृट्-|सुबृड्-सुबृहौ-सुबृहः|-|बृंहितम्-तः-तवान्|बिबृंहयिषितः-तवान्|बृंहः|बिबृंहयिषुः|बृंहयितव्यम्|बिबृंहयिषितव्यम्|बृंहणीयम्|बिबृंहयिषणीयम्|बृंह्यम्|बिबृंहयिष्यम्|ईषद्बृंहः-दुर्बृंहः-सुबृंहः|बृंह्यमाणः|बिबृंहयिष्यमाणः|बिबृंहयिषः|बृंहयितुम्|बिबृंहयिषितुम्|बृंहणा|बिबृंहयिषा|बृंहणम्|बिबृंहयिषणम्|बृंहयित्वा|बिबृंहयिषित्वा|प्रबृंह्य|प्रबिबृंहयिष्य
<ul><li><sup id="ref_krm_1140_01"><a href="#foot_krm_1140_01">1</a></sup> {@“बृहि भाषार्थः”@} <sup id="ref_krm_1140_02"><a href="#foot_krm_1140_02">2</a></sup> आस्वदीयः। </li> <li>‘--भासार्थः’ इति क्षीरस्वामी। </li> <li>‘वृद्धौ, भाषार्थविषये बृंहयेद् बर्हयेदिति।।’ <sup id="ref_krm_1140_03"><a href="#foot_krm_1140_03">3</a></sup> इति देवः। </li> <li>बृंहकः-हिका, बिबृंहयिषकः-षिका, बृंहयिता-त्री, बिबृंहयिषिता-त्री;</li> <li>  बृंहयन्-न्ती, बिबृंहयिषन्-न्ती, बृंहयिष्यन्-न्ती-ती, बिबृंहयिषिष्यन्-न्ती-ती;</li> <li>  बृंहयमाणः, बिबृंहयिषमाणः, बृंहयिष्यमाणः, बिबृंहयिषिष्यमाणः;</li> <li>  सुवृट्- सुबृड्-सुबृहौ-सुबृहः;</li> <li>  -- -- -- बृंहितम्-तः-तवान्, बिबृंहयिषितः-तवान्, बृंहः, बिबृंहयिषुः;</li> <li>  बृंहयितव्यम्, बिबृंहयिषितव्यम्;</li> <li>  बृंहणीयम्, बिबृंहयिषणीयम्;</li> <li>  बृंह्यम्, बिबृंहयिष्यम्, ईषद्बृंहः-दुर्बृंहः-सुबृंहः;</li> <li>  बृंह्यमाणः, बिबृंहयिष्यमाणः, बृंहः, बिबृंहयिषः, बृंहयितुम्, बिबृंहयिषितुम्;</li> <li>  बृंहणा, बिबृंहयिषा, बृंहणम्, बिबृंहयिषणम्, बृंहयित्वा, बिबृंहयिषित्वा;</li> <li>  प्रबृंह्य, प्रबिबृंहयिष्य;</li> <li>  बृंहम् २, बृंहयित्वा २, बिबृंहयिषम् २, बिबृंहयिषित्वा २। <sup id="ref_krm_1140_04"><a href="#foot_krm_1140_04">4</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1140_01"><a href="#ref_krm_1140_01">↑</a> (११३०)</li> <li id="foot_krm_1140_02"><a href="#ref_krm_1140_02">↑</a> (१०-चुरादिः-१७६९। सक। सेट्। उभ।)</li> <li id="foot_krm_1140_03"><a href="#ref_krm_1140_03">↑</a> (श्लो। १९८)</li> <li id="foot_krm_1140_04"><a href="#ref_krm_1140_04">↑</a> [पृष्ठम्०९३२+ २५]</li></ul></p>

बृहू|बर्हकः-र्हिका|बिबर्हिषकः-बिबृक्षकः-क्षिका|बरीबृहकः-हिका
<ul><li><sup id="ref_krm_1141_01"><a href="#foot_krm_1141_01">1</a></sup> {@“बृहू उद्यमने”@} <sup id="ref_krm_1141_02"><a href="#foot_krm_1141_02">2</a></sup> क्षीरतरङ्गिणी-धातुकाव्यादिषु दृष्टः पाठ एवम्। </li> <li>अन्ये सर्वे दन्तोष्ठ्यादि ‘वृहू--’ इत्येव पठन्ति। </li> <li>तत्र क्षीरस्वामी ‘बृहु--’ इति उदितं पपाठ। </li> <li>बर्हकः-र्हिका, बर्हकः-र्हिका, बिबर्हिषकः-बिबृक्षकः-क्षिका, बरीबृहकः-हिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि तौदादिकतर्हतिवत् <sup id="ref_krm_1141_03"><a href="#foot_krm_1141_03">3</a></sup> ज्ञेयानि। </li> <li>णिनिप्रत्यये-- <sup id="ref_krm_1141_04"><a href="#foot_krm_1141_04">4</a></sup> जनजीबबर्ही इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1141_01"><a href="#ref_krm_1141_01">↑</a> (११३१)</li> <li id="foot_krm_1141_02"><a href="#ref_krm_1141_02">↑</a> (६-तुदादिः-१३४७। अक। वेट्। पर।)</li> <li id="foot_krm_1141_03"><a href="#ref_krm_1141_03">↑</a> (७७७)</li> <li id="foot_krm_1141_04"><a href="#ref_krm_1141_04">↑</a> [[आ। ‘मुरादिबन्धुः क्षुरघोरचेताः पुरन् खलानां जनजीवबर्ही।’ धा। का। २। ७७।]]</li></ul></p>

