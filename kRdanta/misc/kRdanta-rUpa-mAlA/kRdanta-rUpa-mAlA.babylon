<ul><li><sup id="ref_krm_0911_01"><a href="#foot_krm_0911_01">1</a></sup> {@“धीङ् आधारे”@} <sup id="ref_krm_0911_02"><a href="#foot_krm_0911_02">2</a></sup> स्वादिः। </li> <li>धायकः-यिका, धायकः-यिका, <sup id="ref_krm_0911_03"><a href="#foot_krm_0911_03">3</a></sup> दिधीषकः-षिका, देधीयकः-यिका;</li> <li>  धेता-त्री, धाययिता-त्री, दिधीषिता-त्री, देधीयिता-त्री;</li> <li>  -- धाययन्-न्ती, धाययिष्यन्-न्ती-ती;</li> <li>  -- <sup id="ref_krm_0911_04"><a href="#foot_krm_0911_04">4</a></sup> धीयमानः, धाययमानः, दिधीषमाणः, देधीयमानः;</li> <li>  धेष्यमाणः, धाययिष्यमाणः, दिधीषिष्यमाणः, देधीयिष्यमाणः;</li> <li>  प्रधीः-प्रध्यौ-प्रध्यः;</li> <li>  -- -- <sup id="ref_krm_0911_05"><a href="#foot_krm_0911_05">5</a></sup> धीनम् <sup id="ref_krm_0911_06"><a href="#foot_krm_0911_06">6</a></sup> -धीनः-धीनवान्, अधीनः, धायितः, धिधीषितः, देधीयितः-तवान्;</li> <li>  धयः, धायः, दिधीषुः, <sup id="ref_krm_0911_07"><a href="#foot_krm_0911_07">7</a></sup> देध्यः;</li> <li>  धेतव्यम्, धाययितव्यम्, दिधीषितव्यम्, देधीयितव्यम्;</li> <li>  धयनीयम्, धायनीयम्, दिधीषणीयम्, देधीयनीयम्;</li> <li>  धेयम्, धाय्यम्, दिधीष्यम्, देधीय्यम्;</li> <li>  ईषद्धयः-दुर्धयः-सुधयः;</li> <li>  -- -- <sup id="ref_krm_0911_08"><a href="#foot_krm_0911_08">8</a></sup> धीयमानः, धाय्यमानः, दिधीष्यमाणः, देधीय्यमानः;</li> <li>  धयः, धायः, दिधीषः, देधीयः;</li> <li>  धेतुम्, धाययितुम्, दिधीषितुम्, देधीयितुम्;</li> <li>  धीतिः, धायना, दिधीषा, देधीया;</li> <li>  धयनम्, धायनम्, दिधीषणम्, देधीयनम्;</li> <li>  धीत्वा, धाययित्वा, दिधीषित्वा, देधीयित्वा;</li> <li>  प्रधीय, प्रधाय्य, प्रदिधीष्य, प्रदेधीय्य;</li> <li>  धायम् २, धीत्वा २, धायम् २, धाययित्वा २, दिधीषम् २, दिधीषित्वा २, देधीयम् २;</li> <li>  देधीयित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0911_01"><a href="#ref_krm_0911_01">↑</a> (९०१)</li> <li id="foot_krm_0911_02"><a href="#ref_krm_0911_02">↑</a> (४-दिवादिः-११३६। अक। अनि। आत्म।)</li> <li id="foot_krm_0911_03"><a href="#ref_krm_0911_03">↑</a> [[३। सन्नन्ताण्ण्वुलि, ‘इको झल्’ (१-२-९) इति झलादेः सनः कित्त्वाद् गुणनिषेधे, ‘अज्झनगमां सनि’ (६-४-१६) इति दीर्घः। ‘पर्जन्यवल्लक्षण प्रवर्तते’ (परिभाषा १२१) इति न्यायात् दीर्घे स्वतो विद्यमानेऽपि पुनर्दीर्घः। एवं सन्नन्ते सर्वत्र बोध्यम्।]]</li> <li id="foot_krm_0911_04"><a href="#ref_krm_0911_04">↑</a> [[४। शानचि, ‘दिवादिभ्यः--’ (३-१-६९) इति श्यनि, रूपम्।]]</li> <li id="foot_krm_0911_05"><a href="#ref_krm_0911_05">↑</a> [[५। ‘स्वादय ओदितः’ (ग। सू। दिवादौ) इति वचनात् ओदित्त्वमस्य धातोर्ज्ञेयम्। तेन, ‘ओदितश्च’ (८-२-४५) इति निष्ठानत्वे रूपमेवम्। अधीनः इत्यत्र न धीनः अधीनः इति व्युत्पत्तिः। ‘वाक्यं वक्तर्यधीनं हि’, ‘अस्मास्वधीनं किमु निःस्पृहाणाम्’ (किरातार्जुनीये ३-९) इत्यादिषु अधीनशब्दः परतन्त्रवचनः, अव्युत्पन्नः।]]</li> <li id="foot_krm_0911_06"><a href="#ref_krm_0911_06">↑</a> [[आ। ‘किं सूयसे गिरमदून नितान्तदीनामुड्डीनकाकसम भूपतिधीनमेतत्।’ धा। का। २। ५८।]]</li> <li id="foot_krm_0911_07"><a href="#ref_krm_0911_07">↑</a> [[६। यङन्तात् पचाद्यचि, यङो लुकि, यणादेशः।]]</li> <li id="foot_krm_0911_08"><a href="#ref_krm_0911_08">↑</a> [पृष्ठम्०७९८+ २७]</li></ul></p>

धुक्ष|धुक्षकः-क्षिका|दुधुक्षिषकः-षिका|दोधुक्षकः-क्षिका
<ul><li><sup id="ref_krm_0912_01"><a href="#foot_krm_0912_01">1</a></sup> {@“धुक्ष सन्दीपनक्लेशनजीवनेषु”@} <sup id="ref_krm_0912_02"><a href="#foot_krm_0912_02">2</a></sup> धुक्षकः-क्षिका, धुक्षकः-क्षिका, दुधुक्षिषकः-षिका, दोधुक्षकः-क्षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकधिक्षतिवत् <sup id="ref_krm_0912_03"><a href="#foot_krm_0912_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0912_04"><a href="#foot_krm_0912_04">4</a></sup> सन्धुक्षमाणः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0912_01"><a href="#ref_krm_0912_01">↑</a> (९०२)</li> <li id="foot_krm_0912_02"><a href="#ref_krm_0912_02">↑</a> (१-भ्वादिः-६०२। सक। सेट्। आत्म।)</li> <li id="foot_krm_0912_03"><a href="#ref_krm_0912_03">↑</a> (८९८)</li> <li id="foot_krm_0912_04"><a href="#ref_krm_0912_04">↑</a> [[आ। ‘सन्धुक्षमाणमरिधिक्षकमूष्मजालं संवृक्ष्यवेदमतशिक्षकभिक्षुगम्यम्।’ धा। का। १। ७७।]]</li></ul></p>

धुञ्|धावकः-विका|दुधूषकः-षिका|धूयकः-यिका|धोता-त्री|धावयिता-त्री|दुधूषिता-त्री|दोधूयिता-त्री|धुन्वन्-ती|धावयन्-न्ती|दुधूषन्-न्ती|-|धोष्यन्-न्ती-ती|धावयिष्यन्-न्ती-ती|दुधूषिष्यन्-न्ती-ती|धुन्वानः|धावयमानः|दुधूषमाणः|दोधूयमानः|धोष्यमाणः|धावयिष्यमाणः|दुधूषिष्यमाणः|दोधूयिष्यमाणः|विधुत्-विधुतौ-विधुतः|-धुतम्-धुतः-धुतवान्|धावितः|दुधूषितः|दोधूयितः-तवान्|धवः|धवनः|प्रधावी|धावः|दुधूषुः|दोध्वः|धोतव्यम्|धावयितव्यम्|दुधूषितव्यम्|दोधूयितव्यम्|धवनीयम्|धावनीयम्|दुधूषणीयम्|दोधूयनीयम्|धव्यम्|अवश्यधाव्यम्|धाव्यम्|दुधूष्यम्|दोधूय्यम्|धूयमानः|धाव्यमानः|दुधूष्यमाणः|दोधूय्यमानः|दुधूषः|दोधूयः|धोतुम्|धावयितुम्|दुधूषितुम्|दोधूयितुम्|विधुतिः|धुनिः|धावना|दुधूषा|दोधूया|धवनम्|धावनम्|दुधूषणम्|दोधूयनम्|धुत्वा|धावयित्वा|दुधूषित्वा|दोधूयित्वा|विधुत्य|विधाव्य|विदुधूष्य|विदोधूय्य|धावम्|दुधूषम्|दोधूयम्
<ul><li><sup id="ref_krm_0913_01"><a href="#foot_krm_0913_01">1</a></sup> {@“धुञ् कम्पने”@} <sup id="ref_krm_0913_02"><a href="#foot_krm_0913_02">2</a></sup> <sup id="ref_krm_0913_03"><a href="#foot_krm_0913_03">3</a></sup> ‘धूञ् कम्पने’ इति अत्रैव <sup id="ref_krm_0913_04"><a href="#foot_krm_0913_04">4</a></sup> दीर्घान्तं क्षीरस्वामिप्रमृतयः पठन्ति। </li> <li>तस्य च ण्यन्ते नुगागमे धूनयतीत्यादिरूपं प्रदर्शयन्ति। </li> <li>स च दीर्घान्तो धातुः सेट्। </li> <li>‘ऊर्ध्वं धूनोति वायुर्विधृतशवशिरःश्रेणिकुञ्जेषु--’ <sup id="ref_krm_0913_05"><a href="#foot_krm_0913_05">5</a></sup> इति, ‘धूनोति चम्पकवनानि--’ <sup id="ref_krm_0913_06"><a href="#foot_krm_0913_06">6</a></sup> इति च प्रयोगदर्शनात् सोऽप्य- स्तीति ज्ञायते। </li> <li>अत्र ह्रस्वान्तपाठमादृत्य रूपाणि विलिखितानि। </li> <li>दीर्घान्तस्य तु यथाक्रममुत्तरत्र लेखनमादृतम्।]] ‘धूनयति धवति धवते धुनोति धुनुते धुनाति च धुनीते। </li> <li>धूनोति धूनुते स्युः पदानि कम्पे, विधूनने धुवति।।’ <sup id="ref_krm_0913_07"><a href="#foot_krm_0913_07">7</a></sup> इति देवः। </li> <li>धावकः-विका, धावकः-विका, <sup id="ref_krm_0913_08"><a href="#foot_krm_0913_08">8</a></sup> दुधूषकः-षिका, <sup id="ref_krm_0913_09"><a href="#foot_krm_0913_09">9</a></sup> धूयकः-यिका;</li> <li>  <sup id="ref_krm_0913_10"><a href="#foot_krm_0913_10">10</a></sup> धोता-त्री, धावयिता-त्री, दुधूषिता-त्री, दोधूयिता-त्री;</li> <li>  <sup id="ref_krm_0913_11"><a href="#foot_krm_0913_11">11</a></sup> धुन्वन्- <sup id="ref_krm_0913_12"><a href="#foot_krm_0913_12">12</a></sup> ती, धावयन्-न्ती, दुधूषन्-न्ती;</li> <li>  -- धोष्यन्-न्ती-ती, धावयिष्यन्-न्ती-ती, दुधूषिष्यन्-न्ती-ती;</li> <li>  धुन्वानः, धावयमानः, दुधूषमाणः, दोधूयमानः;</li> <li>  धोष्यमाणः, धावयिष्यमाणः, दुधूषिष्यमाणः, दोधूयिष्यमाणः;</li> <li>  <sup id="ref_krm_0913_13"><a href="#foot_krm_0913_13">13</a></sup> विधुत्-विधुतौ-विधुतः;</li> <li>  -- -- <sup id="ref_krm_0913_14"><a href="#foot_krm_0913_14">14</a></sup> धुतम्-धुतः-धुतवान्, धावितः, दुधूषितः, दोधूयितः-तवान्;</li> <li>  धवः, <sup id="ref_krm_0913_15"><a href="#foot_krm_0913_15">15</a></sup> धवनः, प्रधावी, धावः, दुधूषुः, <sup id="ref_krm_0913_16"><a href="#foot_krm_0913_16">16</a></sup> दोध्वः;</li> <li>  धोतव्यम्, धावयितव्यम्, दुधूषितव्यम्, दोधूयितव्यम्;</li> <li>  धवनीयम्, धावनीयम्, दुधूषणीयम्, दोधूयनीयम्;</li> <li>  <sup id="ref_krm_0913_17"><a href="#foot_krm_0913_17">17</a></sup> धव्यम्, अवश्यधाव्यम्, धाव्यम्, दुधूष्यम्, दोधूय्यम्;</li> <li>  <sup id="ref_krm_0913_18"><a href="#foot_krm_0913_18">18</a></sup> धूयमानः, धाव्यमानः, दुधूष्यमाणः, दोधूय्यमानः;</li> <li>  <sup id="ref_krm_0913_19"><a href="#foot_krm_0913_19">19</a></sup> धवः, धावः, दुधूषः, दोधूयः;</li> <li>  धोतुम्, धावयितुम्, दुधूषितुम्, दोधूयितुम्;</li> <li>  विधुतिः, <sup id="ref_krm_0913_20"><a href="#foot_krm_0913_20">20</a></sup> धुनिः, धावना, दुधूषा, दोधूया;</li> <li>  धवनम्, धावनम्, दुधूषणम्, दोधूयनम्;</li> <li>  धुत्वा, धावयित्वा, दुधूषित्वा, दोधूयित्वा;</li> <li>  विधुत्य, विधाव्य, विदुधूष्य, विदोधूय्य;</li> <li>  <sup id="ref_krm_0913_21"><a href="#foot_krm_0913_21">21</a></sup> धावम् २, धुत्वा २, धावम् २, धावयित्वा २, दुधूषम् २, दुधूषित्वा २, दोधूयम् २;</li> <li>  दोधूयित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0913_01"><a href="#ref_krm_0913_01">↑</a> (९०३)</li> <li id="foot_krm_0913_02"><a href="#ref_krm_0913_02">↑</a> (५-स्वादिः-१२५५। सक। अनि। उभ।)</li> <li id="foot_krm_0913_03"><a href="#ref_krm_0913_03">↑</a> [[[अ]</li> <li id="foot_krm_0913_04"><a href="#ref_krm_0913_04">↑</a> (स्वादावेव)</li> <li id="foot_krm_0913_05"><a href="#ref_krm_0913_05">↑</a> (मालतीमाधवे ५-४)</li> <li id="foot_krm_0913_06"><a href="#ref_krm_0913_06">↑</a> (कविरहस्ये)</li> <li id="foot_krm_0913_07"><a href="#ref_krm_0913_07">↑</a> (श्लो। २६)</li> <li id="foot_krm_0913_08"><a href="#ref_krm_0913_08">↑</a> [[१। सन्नन्ताण्ण्वुलि, झलादेः सनः कित्त्वात्, गुणनिषेधः, ‘अज्झनगमाम्--’ (६-४-१६) इति दीर्घः। एवं सन्नन्ते सर्वत्र प्रक्रिया बोध्या।]]</li> <li id="foot_krm_0913_09"><a href="#ref_krm_0913_09">↑</a> [[२। यङन्ताण्ण्वुलि, ‘अकृत्सार्वधातुकयोः--’ (७-४-२५) इति दीर्घः। अभ्यासे गुणः। यङन्ते सर्वत्रैषैव प्रक्रिया।]]</li> <li id="foot_krm_0913_10"><a href="#ref_krm_0913_10">↑</a> [पृष्ठम्०७९९+ २६]</li> <li id="foot_krm_0913_11"><a href="#ref_krm_0913_11">↑</a> [[१। शतरि, ‘स्वादिभ्यः--’ (३-१-७३) इति श्नुप्रत्यये, यणादेशे च रूपम्।]]</li> <li id="foot_krm_0913_12"><a href="#ref_krm_0913_12">↑</a> [[आ। ‘हेम्नः स्थलीषु परितः परिवृत्य वाजी धुन्वन् वपुः प्रविततायतकेशपङ्क्तिः।’ शि। व। ५। ५५।]]</li> <li id="foot_krm_0913_13"><a href="#ref_krm_0913_13">↑</a> [[२। क्विपि, ‘ह्रस्वस्य पिति कृति--’ (६-१-७१) इति तुगागमः। ल्यप्यप्येवं ज्ञेयम्।]]</li> <li id="foot_krm_0913_14"><a href="#ref_krm_0913_14">↑</a> [[B। ‘कुब्जा कृतारिबलमैक्षत वृण्वती सा पात्रं समीरधुतसौरभधूतभृङ्गम्।।’ धा। का। २। ६८।]]</li> <li id="foot_krm_0913_15"><a href="#ref_krm_0913_15">↑</a> [[३। ‘चलनशब्दार्थादकर्मकात्--’ (३-२-१४८) इति ताच्छीलिको युच्। अकर्मकत्वमपि धातोरस्य विवक्षाभेदेन भवति।]]</li> <li id="foot_krm_0913_16"><a href="#ref_krm_0913_16">↑</a> [[४। यङन्तात् पचाद्यचि यङो लुकि, यणादेशे रूपमेवम्।]]</li> <li id="foot_krm_0913_17"><a href="#ref_krm_0913_17">↑</a> [[५। ‘अचो यत्’ (३-१-९७) इति यत्प्रत्यये गुणः, अवादेशश्च। आवश्यकार्थे तु ‘ओरावश्यके’ (३-१-१२५) इति ण्यत्प्रत्यये आवादेशः।]]</li> <li id="foot_krm_0913_18"><a href="#ref_krm_0913_18">↑</a> [[६। यगन्ताच्छानशि, ‘अकृत्सार्वधातुकयोः--’ (७-४-२५) इति दीर्घः।]]</li> <li id="foot_krm_0913_19"><a href="#ref_krm_0913_19">↑</a> [[७। ‘ॠदोरप्’ (३-३-५७) इति भावेऽप्प्रत्ययः। घञोऽपवादः।]]</li> <li id="foot_krm_0913_20"><a href="#ref_krm_0913_20">↑</a> [[८। क्तिनि, बाहुलकात् निप्रत्ययः, ‘ग्लानिः, म्लानिः’ इतिवत्। धुनिः = नदी।]]</li> <li id="foot_krm_0913_21"><a href="#ref_krm_0913_21">↑</a> [पृष्ठम्०८००+ २८]</li></ul></p>

धुर्वी|धूर्वकः-र्विका|दुधूर्विषकः-षिका|दोधूर्वकः-र्विका
<ul><li><sup id="ref_krm_0914_01"><a href="#foot_krm_0914_01">1</a></sup> {@“धुर्वी हिंसार्थः”@} <sup id="ref_krm_0914_02"><a href="#foot_krm_0914_02">2</a></sup> धूर्वकः-र्विका, धूर्वकः-र्विका, दुधूर्विषकः-षिका, दोधूर्वकः-र्विका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकतूर्वतिवत् <sup id="ref_krm_0914_03"><a href="#foot_krm_0914_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0914_04"><a href="#foot_krm_0914_04">4</a></sup> धूः-धुरौ-धुरः। </li> <li><sup id="ref_krm_0914_05"><a href="#foot_krm_0914_05">5</a></sup> तन्प्रत्यये उकारदीर्घे ‘लोपो व्योः--’ <sup id="ref_krm_0914_06"><a href="#foot_krm_0914_06">6</a></sup> इति वकारलोपे च रूपम्। </li> <li>धूर्तः = शठः।]] धूर्तः। </li> <li><sup id="ref_krm_0914_07"><a href="#foot_krm_0914_07">7</a></sup> धूर्वितुम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0914_01"><a href="#ref_krm_0914_01">↑</a> (९०४)</li> <li id="foot_krm_0914_02"><a href="#ref_krm_0914_02">↑</a> (१-भ्वादिः-५७३। अक। सेट्। पर।)</li> <li id="foot_krm_0914_03"><a href="#ref_krm_0914_03">↑</a> (७५६)</li> <li id="foot_krm_0914_04"><a href="#ref_krm_0914_04">↑</a> [[१। ‘भ्राजभासधुर्वि--’ (३-२-१७७) इत्यादिना ताच्छीलिके क्विप्प्रत्यये, ‘राल्लोपः’ (६-४-२१) इति वकारलोपे, ‘र्वोरुपधाया दीर्घ इकः’ (८-२-६७) इति दीर्घे च रूपम्।]]</li> <li id="foot_krm_0914_05"><a href="#ref_krm_0914_05">↑</a> [[२। औणादिके [द। उ। ६। ७]</li> <li id="foot_krm_0914_06"><a href="#ref_krm_0914_06">↑</a> (६-१-६६)</li> <li id="foot_krm_0914_07"><a href="#ref_krm_0914_07">↑</a> [[आ। ‘दुदूर्विषून् धूर्वितुमेव गूर्वणं मूर्वन्तमापूर्वितपर्वताध्वरम्।।’ धा। का। १-७३।]]</li></ul></p>

धू|धावकः-विका|दुधूषकः-षिका|दोधूयकः-यिका
<ul><li><sup id="ref_krm_0915_01"><a href="#foot_krm_0915_01">1</a></sup> {@“धू विधूनने”@} <sup id="ref_krm_0915_02"><a href="#foot_krm_0915_02">2</a></sup> कुटादिः। </li> <li>‘धूनयति धवति धवते, धुनोति धुनुते धुनाति च धुनीते। </li> <li>धूनोति धूनुते स्युः पदानि कम्पे, विधूनने धुवति।।’ <sup id="ref_krm_0915_03"><a href="#foot_krm_0915_03">3</a></sup> इति देवः। </li> <li>धावकः-विका, धावकः-विका, दुधूषकः-षिका, दोधूयकः-यिका;</li> <li>  धुविता-त्री, इत्यादीनि सर्वाण्यपि रूपाणि तौदादिककुवतिवत् <sup id="ref_krm_0915_04"><a href="#foot_krm_0915_04">4</a></sup> ज्ञेयानि। </li> <li>धुवन्-ती, <sup id="ref_krm_0915_05"><a href="#foot_krm_0915_05">5</a></sup> धावयन्-न्ती,] <sup id="ref_krm_0915_06"><a href="#foot_krm_0915_06">6</a></sup> धुवनः, <sup id="ref_krm_0915_07"><a href="#foot_krm_0915_07">7</a></sup> धुवित्रम्, <sup id="ref_krm_0915_08"><a href="#foot_krm_0915_08">8</a></sup> धुवकः- धुवका, <sup id="ref_krm_0915_09"><a href="#foot_krm_0915_09">9</a></sup> धूतः इति रूपाण्यस्य भवन्ति, इति विशेषः। </li> <li><sup id="ref_krm_0915_10"><a href="#foot_krm_0915_10">10</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0915_01"><a href="#ref_krm_0915_01">↑</a> (९०५)</li> <li id="foot_krm_0915_02"><a href="#ref_krm_0915_02">↑</a> (६-तुदादिः-१३९८। सक। सेट्। पर।)</li> <li id="foot_krm_0915_03"><a href="#ref_krm_0915_03">↑</a> (श्लो। २६)</li> <li id="foot_krm_0915_04"><a href="#ref_krm_0915_04">↑</a> (२३८)</li> <li id="foot_krm_0915_05"><a href="#ref_krm_0915_05">↑</a> [ण्यन्तात् शतैव-- [[३। ‘निगरणचलनार्थेभ्यः--’ (१-३-८७) इति ण्यन्तान्नित्यं शतैव।]]</li> <li id="foot_krm_0915_06"><a href="#ref_krm_0915_06">↑</a> [[४। ‘चलनशब्दार्थादकर्मकात्--’ (३-२-१४८) इति ताच्छीलिको युच्। अकर्मकत्व- मस्य धातोर्विवक्षायां भवति।]]</li> <li id="foot_krm_0915_07"><a href="#ref_krm_0915_07">↑</a> [[५। ‘अर्तिलूधूसूखनसहचर इत्रः’ (३-२-१८४) इति करणे इत्रप्रत्ययः। इत्रप्रत्ययस्य ङिद्वद्भावेन गुणनिषेधात्, उवङादेशे धुवित्रम् इति भवति। केचित्तु गुणे धवित्रमित्युदाहरन्ति। ‘प्राणा वै धवित्राणि’ इति प्रयोगे छान्दसत्वाद् गुणः इति हरदत्तः।]]</li> <li id="foot_krm_0915_08"><a href="#ref_krm_0915_08">↑</a> [[६। ‘आशिषि च’ (३-१-१५०) इति वुन्। क्षिपकादिषु (वा। ७-३-४५) पाठात् धुवका इत्यत्र ‘प्रत्ययस्थात्--’ (७-३-४४) इति इत्वं न।]]</li> <li id="foot_krm_0915_09"><a href="#ref_krm_0915_09">↑</a> [[B। ‘नूत्या किं भयधूतविद्रुतगुवल्लोकं तदा तद्धुव- त्कोदण्डं कुवमानमैक्षि दलितं भोजेश्वराकूतवत्।।’ धा। का। २। ८२।]]</li> <li id="foot_krm_0915_10"><a href="#ref_krm_0915_10">↑</a> [पृष्ठम्०८०१+ २७]</li></ul></p>

