<ul><li><sup id="ref_krm_0482_01"><a href="#foot_krm_0482_01">1</a></sup> {@“घूर्ण भ्रमणे”@} <sup id="ref_krm_0482_02"><a href="#foot_krm_0482_02">2</a></sup> ‘भूवाद्योर्घुणिघूर्ण्योः स्तां घोणते घूर्णते शपि। </li> <li>भ्रमणेऽत्र तुदाद्योः शे स्यातां घुणति घूर्णति।।’ <sup id="ref_krm_0482_03"><a href="#foot_krm_0482_03">3</a></sup> इति देवः। </li> <li>घूर्णकः-र्णिका, घूर्णकः-र्णिका, जुघूर्णिषकः-षिका, जोघूर्णकः-र्णिका;</li> <li>  घूर्णिता-त्री, घूर्णयिता-त्री, जुघूर्णिषिता-त्री, जोघूर्णिता-त्री;</li> <li>  -- घूर्णयन्-न्ती, घूर्णयिष्यन्-न्ती-ती;</li> <li>  -- घूर्णमानः, घूर्णयमानः, जुघूर्णिषमाणः, जोघूर्ण्यमानः;</li> <li>  घूर्णिष्यमाणः, घूर्णयिष्यमाणः, जुघूर्णिषिष्यमाणः, जोघूर्णिष्यमाणः;</li> <li>  <sup id="ref_krm_0482_04"><a href="#foot_krm_0482_04">4</a></sup> घूर्ण्-घूर्णौ-घूर्णः;</li> <li>  -- -- -- घूर्णितम्-तः, घूर्णितः, जुघूर्णिषितः, जोघूर्णितः-तवान्;</li> <li>  घूर्णः, <sup id="ref_krm_0482_05"><a href="#foot_krm_0482_05">5</a></sup> घूर्णनः, घूर्णः, <sup id="ref_krm_0482_06"><a href="#foot_krm_0482_06">6</a></sup> धा। </li> <li>का। </li> <li>१-५७।]] घोणापुटघूर्णी, जुघूर्णिषुः, जोघूर्णः;</li> <li>  घूर्णितव्यम्, घूर्णयितव्यम्, जुघूर्णिषितव्यम्, जोघूर्णितव्यम्;</li> <li>  घूर्णनीयम्, घूर्णनीयम्, जुघूर्णिषणीयम्, जोघूर्णनीयम्;</li> <li>  <sup id="ref_krm_0482_07"><a href="#foot_krm_0482_07">7</a></sup> घूर्ण्यम्, घूर्ण्यम्, जुघूर्णिष्यम्, जोघूर्ण्यम्;</li> <li>  ईषद्घूर्णः-दुर्घूर्णः-सुघूर्णः;</li> <li>  -- -- -- घूर्ण्यमानः, घूर्ण्यमानः, जुघूर्णिष्यमाणः, जोघूर्ण्यमानः;</li> <li>  घूर्णः, घूर्णः, जुघूर्णिषः, जोघूर्णः;</li> <li>  घूर्णितुम्, घूर्णयितुम्, जुघूर्णिषितुम्, जोघूर्णितुम्;</li> <li>  <sup id="ref_krm_0482_08"><a href="#foot_krm_0482_08">8</a></sup> घूर्णा, घूर्णना, जुघूर्णिषा, जोघूर्णा;</li> <li>  घूर्णनम्, घूर्णनम्, जुघूर्णिषणम्, जोघूर्णनम्;</li> <li>  घूर्णित्वा, घूर्णयित्वा, जुघूर्णिषित्वा, जोघूर्णित्वा;</li> <li>  संघूर्ण्य, संघूर्ण्य, सञ्जुघूर्णिष्य, सञ्जोघूर्ण्य;</li> <li>  घूर्णम् २, घूर्णित्वा २, घूर्णम् २, घूर्णयित्वा २, जुघूर्णिषम् २, जुघूर्णिषित्वा २, जोघूर्णम् २;</li> <li>  जोघूर्णित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0482_01"><a href="#ref_krm_0482_01">↑</a> (४७३)</li> <li id="foot_krm_0482_02"><a href="#ref_krm_0482_02">↑</a> (१-भ्वादिः-४३८। अक। सेट्। आत्म।)</li> <li id="foot_krm_0482_03"><a href="#ref_krm_0482_03">↑</a> (श्लो। ९१)</li> <li id="foot_krm_0482_04"><a href="#ref_krm_0482_04">↑</a> [[१। ‘रात् सस्य’ (८-२-२४) इति नियमात् णकारस्य संयोगान्तलोपो न।]]</li> <li id="foot_krm_0482_05"><a href="#ref_krm_0482_05">↑</a> [[२। ‘अनुदात्तेतश्च हलादेः’ (३-२-१४९) इति ताच्छीलिको युच्।]]</li> <li id="foot_krm_0482_06"><a href="#ref_krm_0482_06">↑</a> [[B। ‘प्रघिण्य भूषाः परिघुण्य मालिकाः प्रघृण्य घोणापुटघूर्णिचन्दनम्।’ [घोणापुटं घूर्णयतीति घोणापुटघूर्णि ण्यन्तात् णिनिः।]</li> <li id="foot_krm_0482_07"><a href="#ref_krm_0482_07">↑</a> [पृष्ठम्०४६१+ २४]</li> <li id="foot_krm_0482_08"><a href="#ref_krm_0482_08">↑</a> [[१। ‘गुरोश्च हलः’ (३-३-१०३) इति स्त्रियामकारप्रत्ययः।]]</li></ul></p>

घूर्ण
<ul><li><sup id="ref_krm_0483_01"><a href="#foot_krm_0483_01">1</a></sup> {@“घूर्ण भ्रमणे”@} <sup id="ref_krm_0483_02"><a href="#foot_krm_0483_02">2</a></sup> ‘भूवाद्योः घुणिघूर्ण्योः स्तां घोणते घूर्णते शपि। </li> <li>भ्रमणेऽत्र तुदाद्योः शे स्यातां घुणति घूर्णति।।’ <sup id="ref_krm_0483_03"><a href="#foot_krm_0483_03">3</a></sup> इति देवः। </li> <li>अस्य धातोः परस्मैपदित्वात् शतरि-- <sup id="ref_krm_0483_04"><a href="#foot_krm_0483_04">4</a></sup> घूर्णन्-घूर्णयन्, घूर्णिष्यन्, घूर्णयिष्यन्, जुघूर्णिषन्-न्ती, जुघूर्णिषिष्यन्-न्ती-ती, इति इमानि रूपाणि भवन्तीति विशेषः। </li> <li>अन्यानि सर्वाण्यपि रूपाणि पूर्वोक्तभौवादिकघूर्णतिवत् <sup id="ref_krm_0483_05"><a href="#foot_krm_0483_05">5</a></sup> बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0483_01"><a href="#ref_krm_0483_01">↑</a> (४७४)</li> <li id="foot_krm_0483_02"><a href="#ref_krm_0483_02">↑</a> (६-तुदादिः-१३३९। अक। सेट्। पर।)</li> <li id="foot_krm_0483_03"><a href="#ref_krm_0483_03">↑</a> (श्लो। १९)</li> <li id="foot_krm_0483_04"><a href="#ref_krm_0483_04">↑</a> [[आ। ‘विद्रोणनेष्वघुणिता मदघूर्णदक्षा युद्धे सुरानपि खरोत्कुरिताः खुरन्तः।।’ धा। का। २-७६।]]</li> <li id="foot_krm_0483_05"><a href="#ref_krm_0483_05">↑</a> (४७३)</li></ul></p>

घृ
<ul><li><sup id="ref_krm_0484_01"><a href="#foot_krm_0484_01">1</a></sup> {@“घृ सेचने”@} <sup id="ref_krm_0484_02"><a href="#foot_krm_0484_02">2</a></sup> <sup id="ref_krm_0484_03"><a href="#foot_krm_0484_03">3</a></sup> ‘अविशेषविहिताः शब्दा नियतविषया दृश्यन्ते। </li> <li>घरतिरस्मायविशेषेणोपदिष्टः। </li> <li>स ‘घृतं घृणा घर्म’ इत्येवंविषयः।’ इति, ‘तृज्वत् क्रोष्टुः’ <sup id="ref_krm_0484_04"><a href="#foot_krm_0484_04">4</a></sup> इति सूत्रस्थभाष्यात् नियतविषयोऽयं धातुरिति पुरुषकारव्याख्यानात् <sup id="ref_krm_0484_05"><a href="#foot_krm_0484_05">5</a></sup> अवगम्यते।]] ‘-- घरेद् घारयेद्, यद्दीप्तौ क्षरणे जिघर्त्ति तदिंद केचिद् विदुः छान्दसम्।।’ <sup id="ref_krm_0484_06"><a href="#foot_krm_0484_06">6</a></sup> इति देवः। </li> <li><sup id="ref_krm_0484_07"><a href="#foot_krm_0484_07">7</a></sup> घारकः-रिका-घारकः-रिका, जिघीर्षकः-र्षिका, जेघ्रीयकः-यिका, इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकसेचनार्थकगृधातुवत् <sup id="ref_krm_0484_08"><a href="#foot_krm_0484_08">8</a></sup> बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0484_01"><a href="#ref_krm_0484_01">↑</a> (४७५)</li> <li id="foot_krm_0484_02"><a href="#ref_krm_0484_02">↑</a> (१-भ्वादिः-९३८। सक। अनि। पर।)</li> <li id="foot_krm_0484_03"><a href="#ref_krm_0484_03">↑</a> [[[अ]</li> <li id="foot_krm_0484_04"><a href="#ref_krm_0484_04">↑</a> (७-१-९५)</li> <li id="foot_krm_0484_05"><a href="#ref_krm_0484_05">↑</a> (श्लो। ३३)</li> <li id="foot_krm_0484_06"><a href="#ref_krm_0484_06">↑</a> (श्लो। ३३)</li> <li id="foot_krm_0484_07"><a href="#ref_krm_0484_07">↑</a> [पृष्ठम्०४६२+ २६]</li> <li id="foot_krm_0484_08"><a href="#ref_krm_0484_08">↑</a> (४२०)</li></ul></p>

घृ
<ul><li><sup id="ref_krm_0485_01"><a href="#foot_krm_0485_01">1</a></sup> {@“घृ क्षरणदीप्त्योः”@} <sup id="ref_krm_0485_02"><a href="#foot_krm_0485_02">2</a></sup> ‘यद्दीप्तौ क्षरणे जिघर्ति तदिदं केचिद्विदुश्छान्दसम्।।’ <sup id="ref_krm_0485_03"><a href="#foot_krm_0485_03">3</a></sup> इति देवः। </li> <li>क्षरणं = स्रवणम् इति क्षीरस्वामी। </li> <li>अस्य धातोः जुहोत्यादिपाठात् शतरि -- जिघ्रत् <sup id="ref_krm_0485_04"><a href="#foot_krm_0485_04">4</a></sup> इति पुंसि रूपम्। </li> <li>स्त्रियां तु जिघ्रती इत्येकमेव। </li> <li>अन्यानि शुद्धात्-णिजन्तात्-सन्नन्तात्-यङन्ताच्च जायमानानि रूपाणि भौवादिकसेचनार्थकगृधातुवत् <sup id="ref_krm_0485_05"><a href="#foot_krm_0485_05">5</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_0485_06"><a href="#foot_krm_0485_06">6</a></sup> इति सूत्रेणास्माद्धातोः मक्प्रत्यये, निपातनात् गुणः। </li> <li>घर्मः = निदाघः।]] घर्मः <sup id="ref_krm_0485_07"><a href="#foot_krm_0485_07">7</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0485_01"><a href="#ref_krm_0485_01">↑</a> (४७६)</li> <li id="foot_krm_0485_02"><a href="#ref_krm_0485_02">↑</a> (३-जुहोत्यादिः-१०९६। अक। अनि। पर।)</li> <li id="foot_krm_0485_03"><a href="#ref_krm_0485_03">↑</a> (श्लो। ३३)</li> <li id="foot_krm_0485_04"><a href="#ref_krm_0485_04">↑</a> [[१। ‘श्लौ’ (६-१-१०) इति द्वित्वम्। उत्तरखण्डे यण्। ‘नाभ्यस्ताच्छतुः’ (७-१-७८) इति नुम्निषेधः।]]</li> <li id="foot_krm_0485_05"><a href="#ref_krm_0485_05">↑</a> (४२०)</li> <li id="foot_krm_0485_06"><a href="#ref_krm_0485_06">↑</a> [[२। ‘घर्मः’ [द। उ। ७-३६]</li> <li id="foot_krm_0485_07"><a href="#ref_krm_0485_07">↑</a> [[आ। ‘घर्मोष्मभिस्तत्र समारताग्रे नभस्तुरैस्तैः प्रधने प्रवीणैः।।’ धा। का। २-५५।]]</li></ul></p>

घृ|ण्यन्तात्|सनि|तु|इमानि|रूपाणि-जिघारयिषकः-षिका|जिघारयिषिता-त्री
<ul><li><sup id="ref_krm_0486_01"><a href="#foot_krm_0486_01">1</a></sup> {@“घृ प्रस्रवणे”@} <sup id="ref_krm_0486_02"><a href="#foot_krm_0486_02">2</a></sup> स्रावणे इत्येके। </li> <li>संप्रस्रवणे इति मा। </li> <li>धा। </li> <li>वृत्तौ। </li> <li>‘यद्दीप्तौ क्षरणे जिघर्त्ति तदिदं केचिद्विदुश्छान्दसम्।।’ <sup id="ref_krm_0486_03"><a href="#foot_krm_0486_03">3</a></sup> इति देवः। </li> <li>घारकः-रिका, घारयिता-त्री, घारयन्-न्ती, <sup id="ref_krm_0486_04"><a href="#foot_krm_0486_04">4</a></sup> धारितम्, इत्यादीनि रूपाणि सेचनार्थकगृधातुवत् <sup id="ref_krm_0486_05"><a href="#foot_krm_0486_05">5</a></sup> बोध्यानि। </li> <li>ण्यन्तात् सनि तु इमानि रूपाणि--जिघारयिषकः-षिका, जिघारयिषिता-त्री;</li> <li>  जिघारयिषन्-न्ती, जिघारयिषिष्यन्-न्ती-ती, जिघारयिषमाणः, जिघारयि- षिष्यमाणः, जिघारयिट् - जिघारयिषौ - जिघारयिषः, जिघारयिषितः- तवान्, जिघारयिषः, जिघारयिषितव्यम्, जिघारयिषणीयम्, जिघारयिष्यम्, ईषद्जिघारयिषः-दुर्जिघारयिषः-सुजिघारयिषः, जिघारयिष्यमाणः, जिघारयिषः, जिघारयिषितुम्, जिघारयिषा, जिघारयिषणम्, जिघारयिषित्वा, प्रजिघारयिष्य, जिघारयिषम् २, जिघारयिषित्वा २। इति। </li> <li><sup id="ref_krm_0486_06"><a href="#foot_krm_0486_06">6</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0486_01"><a href="#ref_krm_0486_01">↑</a> (४७७)</li> <li id="foot_krm_0486_02"><a href="#ref_krm_0486_02">↑</a> (१०-चुरादिः-१६५१। सक। अनि। उभ।)</li> <li id="foot_krm_0486_03"><a href="#ref_krm_0486_03">↑</a> (श्लो। ३३)</li> <li id="foot_krm_0486_04"><a href="#ref_krm_0486_04">↑</a> [[B। ‘इत्थं सुगाजितमृदङ्गविमार्जनानि संवार्य मर्चयति घारितशङ्कमस्मिन्।’ धा। का। ३। २८।]]</li> <li id="foot_krm_0486_05"><a href="#ref_krm_0486_05">↑</a> (४२०)</li> <li id="foot_krm_0486_06"><a href="#ref_krm_0486_06">↑</a> [पृष्ठम्०४६३+ २६]</li></ul></p>

घृणि
<ul><li><sup id="ref_krm_0487_01"><a href="#foot_krm_0487_01">1</a></sup> {@“घृणि ग्रहणे”@} <sup id="ref_krm_0487_02"><a href="#foot_krm_0487_02">2</a></sup> घृण्णकः-ण्णिका, घृण्णकः-ण्णिका, जिघृण्णिषकः-षिका, जरीघृण्णकः- ण्णिका, घृण्णिता-त्री, घृण्णयिता-त्री, जिघृण्णिषिता-त्री, जरीघृण्णिता-त्री, घृण्णयन्-न्ती, घृण्णयिष्यन्-न्ती-ती, घृण्णमानः, जिघृण्णिषमाणः, जरीघृण्ण्य- मानः, घृण्णिष्यमाणः, घृण्णयिष्यमाणः, जिघृण्णिषिष्यमाणः, जरीघृण्णिष्य- माणः, <sup id="ref_krm_0487_03"><a href="#foot_krm_0487_03">3</a></sup> घृन्-घृण्णौ-घृण्णः, प्रघृण्ण्य, <sup id="ref_krm_0487_04"><a href="#foot_krm_0487_04">4</a></sup> इत्यादीनि सर्वाण्यपि रूपाणि भौवादिक- क्लिन्दतिवत् <sup id="ref_krm_0487_05"><a href="#foot_krm_0487_05">5</a></sup> बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0487_01"><a href="#ref_krm_0487_01">↑</a> (४७८)</li> <li id="foot_krm_0487_02"><a href="#ref_krm_0487_02">↑</a> (१-भ्वादिः-४३६। सक। सेट्। आत्म।)</li> <li id="foot_krm_0487_03"><a href="#ref_krm_0487_03">↑</a> [[१। ‘पदान्तस्य’ (८-४-३७) इति णत्वनिषेधः।]]</li> <li id="foot_krm_0487_04"><a href="#ref_krm_0487_04">↑</a> [[आ। ‘प्रघिण्य भूषाः परिघुण्य मालिकाः प्रघृण्य घोणापुटघूर्णिचन्दनम्।’ धा। का। १।५७।]]</li> <li id="foot_krm_0487_05"><a href="#ref_krm_0487_05">↑</a> (२८४)</li></ul></p>

