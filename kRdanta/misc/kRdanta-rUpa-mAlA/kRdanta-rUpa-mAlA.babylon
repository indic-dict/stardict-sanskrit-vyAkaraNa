<ul><li><sup id="ref_krm_1312_01"><a href="#foot_krm_1312_01">1</a></sup> {@“मृजू शुद्धौ”@} <sup id="ref_krm_1312_02"><a href="#foot_krm_1312_02">2</a></sup> <sup id="ref_krm_1312_03"><a href="#foot_krm_1312_03">3</a></sup> ‘मृजूष्--’ इति क्षीरस्वामी षितममुं पठित्वा, उत्तरत्र, ‘भिदादौ <sup id="ref_krm_1312_04"><a href="#foot_krm_1312_04">4</a></sup> मृजा।’ इत्यप्याह। </li> <li>अनूदितश्चायं पक्षः पुरुषकारे <sup id="ref_krm_1312_05"><a href="#foot_krm_1312_05">5</a></sup>, खण्डितश्च। </li> <li>‘षकारोऽङर्थः।’ इति च क्षीरस्वामिवाक्यं किञ्चिदनूदितमत्र पुरुषकारे। </li> <li>परं तु क्षीरतरङ्गिण्यां नैतादृशं वाक्यमधुनोपलभ्यते। </li> <li>यदि धातोः षित्त्वं प्रामाणिकं स्यात्--तर्हि षित्त्वेनैन निदानेनाङ्सिद्धेर्भिदादिपाठपरिकल्पनमन्या- य्यमिति तदाशयः। </li> <li>वस्तुतस्तु क्षीरतरङ्गिण्यां धातोरस्य षित्करणं लेखकदो- षादापतितमिति भाति।]] ‘शौचालंकारयोर्वा णौ मृजेर्मार्जति मार्जयेत्।। </li> <li>मार्ष्टि शुद्धौ तथा मार्जेः शब्दार्थान्मार्जयेण्णिचि।’ <sup id="ref_krm_1312_06"><a href="#foot_krm_1312_06">6</a></sup> इति देवः। </li> <li>मार्जकः-र्जिका, मार्जकः-र्जिका, <sup id="ref_krm_1312_07"><a href="#foot_krm_1312_07">7</a></sup> मिमार्जिषकः-षिका-मिमृक्षकः-क्षिका, <sup id="ref_krm_1312_08"><a href="#foot_krm_1312_08">8</a></sup> <sup id="ref_krm_1312_09"><a href="#foot_krm_1312_09">9</a></sup> मरीमृजकः-जिका;</li> <li>  <sup id="ref_krm_1312_10"><a href="#foot_krm_1312_10">10</a></sup> मार्जिता-मार्ष्टा-मार्ष्ट्री, मार्जयिता-त्री, मिमार्जिषिता-मिमृक्षिता-त्री, मरीमृजिता-त्री;</li> <li>  <sup id="ref_krm_1312_11"><a href="#foot_krm_1312_11">11</a></sup> मार्जन्-मृजन्-ती, मार्जयन्-न्ती, मिमार्जिषन्-मिमृक्षन्-न्ती;</li> <li>  मार्जिष्यन्- <sup id="ref_krm_1312_12"><a href="#foot_krm_1312_12">12</a></sup> मार्क्ष्यन्-न्ती-ती, मार्जयिष्यन्-न्ती-ती, मिमार्जिषिष्यन्-मिमृक्षिष्यन्-न्ती-ती;</li> <li>  -- <sup id="ref_krm_1312_13"><a href="#foot_krm_1312_13">13</a></sup> व्यतिमार्जानः, व्यतिमृजानः, मार्जयमानः, व्यतिमिमार्जिषमाणः-व्यतिमि- मृक्षमाणः, मरीमृज्यमानः- <sup id="ref_krm_1312_14"><a href="#foot_krm_1312_14">14</a></sup> मर्मृज्यमानासः व्यतिमार्जिष्यमाणः-व्यतिमार्क्ष्य- माणः, मार्जयिष्यमाणः, व्यतिमिमार्जिषिष्यमाणः-व्यतिमिमृक्षिष्यमाणः, मरीमृजिष्यमाणः;</li> <li>  <sup id="ref_krm_1312_15"><a href="#foot_krm_1312_15">15</a></sup> कंसपरिमृट्-कंसपरिमृड्-कंसपरिमृजौ-कंसपरिमृजः;</li> <li>  -- <sup id="ref_krm_1312_16"><a href="#foot_krm_1312_16">16</a></sup> <sup id="ref_krm_1312_17"><a href="#foot_krm_1312_17">17</a></sup> मृष्टम्-मृष्टः-मृष्टवान्, मार्जितः, मिमार्जिषितः-मिमृक्षितः, मरीमृजितः-तवान्;</li> <li>  परिमार्जः, <sup id="ref_krm_1312_18"><a href="#foot_krm_1312_18">18</a></sup> तुन्दपरिमृजः <sup id="ref_krm_1312_19"><a href="#foot_krm_1312_19">19</a></sup> -तुन्दपरिमार्जः, <sup id="ref_krm_1312_20"><a href="#foot_krm_1312_20">20</a></sup> परिमार्क्ष्णुः, <sup id="ref_krm_1312_21"><a href="#foot_krm_1312_21">21</a></sup> मार्जनः, मार्जः, मिमार्जिषुः-मिमृक्षुः, मरी<sup id="ref_krm_1312_22"><a href="#foot_krm_1312_22">22</a></sup>मृजः;</li> <li>  मार्जितव्यम्-मार्ष्टव्यम्, मार्जयितव्यम्, मिमार्जिषितव्यम्-मिमृक्षितव्यम्, मरीमृजितव्यम्;</li> <li>  मार्जनीयम्, मार्जनीयम्, मिमार्जिषणीयम्-मिमृक्षणीयम्, मरीमृजनीयम्;</li> <li>  <sup id="ref_krm_1312_23"><a href="#foot_krm_1312_23">23</a></sup> मृज्यः- <sup id="ref_krm_1312_24"><a href="#foot_krm_1312_24">24</a></sup> मार्ग्यः, <sup id="ref_krm_1312_25"><a href="#foot_krm_1312_25">25</a></sup> अवश्यमार्ज्यः, मार्ज्यम्, मिमार्जिष्यम्-मिमृक्ष्यम्, मरीमृज्यम्;</li> <li>  ईषन्मार्जः-दुर्मार्जः-सुमार्जः;</li> <li>  -- -- -- मृज्यमानः, मार्ज्यमानः, मिमार्जिष्यमाणः-मिमृक्ष्यमाणः, मरीमृज्यमानः;</li> <li>  <sup id="ref_krm_1312_26"><a href="#foot_krm_1312_26">26</a></sup> मार्गः, <sup id="ref_krm_1312_27"><a href="#foot_krm_1312_27">27</a></sup> अपामार्गः, मार्जः, मिमार्जिषः-मिमृक्षः, मरीमर्जः;</li> <li>  मार्जितुम्-मार्ष्टुम्, मार्जयितुम्, मिमार्जिषितुम्-मिमृक्षितुम्, मरीमृजितुम्;</li> <li>  <sup id="ref_krm_1312_28"><a href="#foot_krm_1312_28">28</a></sup> मृजा, <sup id="ref_krm_1312_29"><a href="#foot_krm_1312_29">29</a></sup> मृष्टिः, मार्जना, मिमार्जिषा-मिमृक्षा, मरीमृजा;</li> <li>  परिमार्जनम्- <sup id="ref_krm_1312_30"><a href="#foot_krm_1312_30">30</a></sup> सम्मार्जनी, <sup id="ref_krm_1312_31"><a href="#foot_krm_1312_31">31</a></sup> सांमार्जनम्, मार्जनम्, मिमार्जिषणम्-मिमृक्षणम्, मरीमृजनम्;</li> <li>  मार्जित्वा-मृष्ट्वा, मार्जयित्वा, मिमार्जिषित्वा-मिमृक्षित्वा, मरीमृजित्वा;</li> <li>  विमृज्य-अपमृज्य, विमार्ज्य, विमिमार्जिष्य-विमिमृक्ष्य, विमरीमृज्य;</li> <li>  मार्जम् २, मार्जित्वा २-मृष्ट्वा २, मार्जम् २, मार्जयित्वा २, मिमार्जिषम् २-मिमृक्षम् २, मिमार्जिषित्वा २-मिमृक्षित्वा २, मरीमृजम् २;</li> <li>  मरीमृजित्वा २;</li> <li>  <sup id="ref_krm_1312_32"><a href="#foot_krm_1312_32">32</a></sup> मर्जूः, <sup id="ref_krm_1312_33"><a href="#foot_krm_1312_33">33</a></sup> मार्जारः, <sup id="ref_krm_1312_34"><a href="#foot_krm_1312_34">34</a></sup> मार्जालीयः। </li> <li><sup id="ref_krm_1312_35"><a href="#foot_krm_1312_35">35</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1312_01"><a href="#ref_krm_1312_01">↑</a> (१३०२)</li> <li id="foot_krm_1312_02"><a href="#ref_krm_1312_02">↑</a> (२-अदादिः-१०६६। अक। वेट्। पर।)</li> <li id="foot_krm_1312_03"><a href="#ref_krm_1312_03">↑</a> [[[अ]</li> <li id="foot_krm_1312_04"><a href="#ref_krm_1312_04">↑</a> (३-३-१०४)</li> <li id="foot_krm_1312_05"><a href="#ref_krm_1312_05">↑</a> (श्लो। ६१)</li> <li id="foot_krm_1312_06"><a href="#ref_krm_1312_06">↑</a> (श्लो। ६०-६१)</li> <li id="foot_krm_1312_07"><a href="#ref_krm_1312_07">↑</a> [[७। धातोरस्य ऊदित्त्वेन, ‘स्वरतिसूतिसूयतिधूञूदितो वा’ (७-२-४४) इतीड्विकल्पः। इट्पक्षे रूपमेवम्। इडभावपक्षे, झलादित्वेन सनः कित्त्वेन गुणनिषेधे, ‘व्रश्चभ्रस्जसृजमृज--’ (८-२-३६) इत्यादिना षत्वे, ‘षढोः कः सि’ (८-२-४१) इति ककारे षत्वे च रूपमेवम्। एवमेव सन्नन्ते सर्वत्र रूपद्वयस्योपपत्तिर्ज्ञेया।]]</li> <li id="foot_krm_1312_08"><a href="#ref_krm_1312_08">↑</a> [पृष्ठम्१०४८+ २४]</li> <li id="foot_krm_1312_09"><a href="#ref_krm_1312_09">↑</a> [[१। ‘न धातुलोप आर्धधातुके’ (१-१-४) इत्यत्रत्यभाष्यपरामर्शनात् यङन्ते सर्वत्र वृद्धिविकल्पः इति ज्ञायत इति बृहच्छब्देन्दुशेखरे (पु। १८७८) स्पष्टम्। ततश्चात्र सर्वत्र मरीमार्जकः-र्जिका, मरीमार्जिता-त्री;\n\n  इत्यादीनि रूपाणि यथासम्भवं तत्तत्प्रत्ययेषु ज्ञेयानि। एवं ‘ममृंज्यते मर्मृज्यमानास इति चोपसंख्यानम्’ (वा। ७-४-९१) इत्युक्तत्वात् ण्वुलादिष्वप्यस्य रुकि रूपनिष्पत्तिर्भव- तीति न मन्तव्यम्;\n\n  यतोऽत्र निपातनस्थलेष्विव स्वरूपग्रहणात्, निर्दिष्टरूपस्यैव साधुत्वज्ञापनात्, यङ्लुकि विहितस्य रुको यङन्तेऽपि निर्दिष्टयोरुभयोर्विषयेऽप्युप- संख्यानार्थमेव वार्तिकावताराच्च इति स्पष्टं कैयटादौ।]]</li> <li id="foot_krm_1312_10"><a href="#ref_krm_1312_10">↑</a> [[२। तृजादिष्वप्यूदित्त्वादिड्विकल्पः। इडभावपक्षे, इट्पक्षेऽपि लघूपधलक्षणं गुणं बाधित्वा, ‘मृजेर्वृद्धिः’ (७-२-११४) इति वृद्धिः। एवमेव तव्यदादिष्वपि ज्ञेयम्।]]</li> <li id="foot_krm_1312_11"><a href="#ref_krm_1312_11">↑</a> [[३। शतरि, ‘अदिप्रभृतिभ्यः--’ (२-४-७२) इति शब्लुकि, ‘इहान्ये वैयाकरणाः मृजेरजादौ सङ्क्रमे विभाषा वृद्धिमारभन्ते’ (भाष्यवाक्यम् १-१-३) इति वृद्धिविकल्पः। वृद्ध्यभावपक्षे, शतुरपित्सार्वधातुकत्वेन ङिद्वद्भावादङ्गस्य गुणो न।]]</li> <li id="foot_krm_1312_12"><a href="#ref_krm_1312_12">↑</a> [[४। स्यप्रत्यये इडभावपक्षे षत्वकत्वषत्वेषु रूपमेवम्।]]</li> <li id="foot_krm_1312_13"><a href="#ref_krm_1312_13">↑</a> [[५। ‘कर्तरि कर्मव्यतीहारे’ (१-३-१४) इति शानच्। वृद्धिविकल्पः।]]</li> <li id="foot_krm_1312_14"><a href="#ref_krm_1312_14">↑</a> [[६। यङन्ताच्छानचि, ‘मर्मृज्यते मर्मृज्यमानास उपसंख्यानम्’ (वा। ७-४-९१) इति वचनात् रीगपवादतया पाक्षिके रुकि, बहुवचने जसः, ‘आज्जसेरसुक्’ (७-१-५०) इत्यसुकि रूपमेवम्। “छन्दोऽधिकारः ‘आज्जसेरसुक्’ (७-१-५०) इति यावत्।” इति काशिकायाम् (७-१-३८) उक्तत्वात् वैदिकेष्वेवास्य प्रयोग इति ज्ञेयम्।]]</li> <li id="foot_krm_1312_15"><a href="#ref_krm_1312_15">↑</a> [[७। कंसं परिमार्ष्टि इत्यर्थे, ‘क्विप् च’ (३-२-७६) इति कर्मण्युपपदे क्विप्। पदान्तनि- मित्तके षत्वे जश्त्वे चर्त्वविकल्पे च रूपमेवम्।]]</li> <li id="foot_krm_1312_16"><a href="#ref_krm_1312_16">↑</a> [पृष्ठम्१०४९+ २७]</li> <li id="foot_krm_1312_17"><a href="#ref_krm_1312_17">↑</a> [[१। ऊदित्त्वेनेड्विकल्पनात् निष्ठायाम्, ‘यस्य विभाषा’ (७-२-१५) इतीण्निषेधः। षत्वे ष्टुत्वे च रूपमेवम्।]]</li> <li id="foot_krm_1312_18"><a href="#ref_krm_1312_18">↑</a> [[२। तुन्दं परिमार्ष्टीत्यर्थे, ‘तुन्दशोकयोः परिमृजापनुदोः’ (३-२-५) इति कर्मण्युप- पदे अणोऽपवादतया कप्रत्ययः। कित्त्वेन गुणनिषेधः। ‘आलस्यसुखाहरणयोः--’ (वा। ३-२-५) इति वचनात् आलस्यविशिष्टे कर्तर्येवायं प्रत्यय इति ज्ञेयम्। तदभावपक्षे तुन्दपरिमार्जः इत्यत्र, ‘कर्मण्यण्’ (३-२-१) इति अण्प्रत्यये वृद्धौ च रूपम्। अत्र कप्रत्ययस्य कित्त्वात्, ‘मृजेरजादौ सङ्क्रमे विभाषा वृद्धिम्--’ (भाष्यवाक्यम् १-१-३) इति वचनात् आलस्यरूपार्थे एव वृद्धिविकल्पमाशङ्क्य, ‘सा भवत्येव सत्यभिधाने’ इति उद्द्योते (३-१-५) समाहितम्। उत्तरत्र च यद्यनभिधानमभिमतम्, तदानीम्, ‘इको गुणवृद्धी’ (१-१-३) इति सूत्रे भाष्य- स्वारस्यात् निरुक्तभाष्यवाक्ये ‘अजादौ’ इत्यस्य आतिदेशिकक्ङिदजादिप्रत्यये इत्यर्थपरकत्वमाश्रित्य, अत्र कप्रत्ययस्यौपदेशिककित्त्वेन वृद्धिनिषेध एवेति च समाहितम्।]]</li> <li id="foot_krm_1312_19"><a href="#ref_krm_1312_19">↑</a> [[आ। ‘इह युवतिवदनकान्तिभिराप्यायिततुन्दपरिमृजः शेते।’ अनर्घराघवे ७-११०।]]</li> <li id="foot_krm_1312_20"><a href="#ref_krm_1312_20">↑</a> [[३। ताच्छीलिके, “-- ‘परिक्षिपच्परिमृजः ग्स्नुः’ इति ग्स्नुप्रत्ययः। परिमार्क्ष्णुः।” इति प्रक्रियाकौमुदी। भाष्यादिषु तु नैतादृशं वचनमुपलभ्यते।]]</li> <li id="foot_krm_1312_21"><a href="#ref_krm_1312_21">↑</a> [[४। बाहुलकात्, नन्द्यादेः (३-१-१३४) आकृतिगणत्वाद्वा ण्यन्तात् कर्तरि ल्युप्रत्यये रूपमेवम्।]]</li> <li id="foot_krm_1312_22"><a href="#ref_krm_1312_22">↑</a> [मार्जः]</li> <li id="foot_krm_1312_23"><a href="#ref_krm_1312_23">↑</a> [[५। ‘मृजेर्विभाषा’ (३-१-११३) इति विभाषा क्यप्। पक्षे ण्यति निष्ठायामनिट्त्वात् ‘चजोः कु घिण्ण्यतोः’ (७-३-५२) इति कुत्वे वृद्धौ च मार्ग्यः इति रूपम्।]]</li> <li id="foot_krm_1312_24"><a href="#ref_krm_1312_24">↑</a> [[B। ‘मन्युस्तस्य त्वया मार्ग्यो मृज्यः शोकश्च तेन ते।।’ भ। का। ६-५७।]]</li> <li id="foot_krm_1312_25"><a href="#ref_krm_1312_25">↑</a> [[६। आवश्यकार्थे ण्यति, ‘ण्य आवश्यके’ (७-३-६५) इति कुत्वनिषेधः।]]</li> <li id="foot_krm_1312_26"><a href="#ref_krm_1312_26">↑</a> [पृष्ठम्१०५०+ २८]</li> <li id="foot_krm_1312_27"><a href="#ref_krm_1312_27">↑</a> [[१। ‘हलश्च’ (३-३-१२१) इति संज्ञायां घञि, कुत्वे, ‘उपसर्गस्य घञ्यमनुष्ये बहुलम्’ (६-३-१२२) इति ‘अप’ इत्युपसर्गान्त्याकारस्य दीर्घे रूपमेवम्। अपमृज्यतेऽनेन व्याध्यादिरिति अपामार्गः = ओषधिविशेषः।]]</li> <li id="foot_krm_1312_28"><a href="#ref_krm_1312_28">↑</a> [[२। स्त्रियां भावादौ भिदादिपाठात् (३-३-१०४) अङि, औपदेशिकङित्त्वादस्य प्रत्ययस्य ‘मृजेरजादौ--’ (भाष्यवाक्यम् १-३-५) इत्यत्र नास्य ग्रहणमिति निर्णयात्, ‘क्ङिति च’ (१-१-५) इति वृद्धिनिषेधे च रूपमेवम्। बाहुलकात् क्तिनि वृद्धौ च माष्टिः इत्यपि रूपमिति ज्ञेयम्। मा। धा। वृत्तौ तु ‘मार्ष्टिरिति चुरादौ वक्ष्यते’ इत्युक्तम्। चुरादिषु तु कुत्रापि मार्ष्टिशब्दनिष्पत्तिः तेन न क्रियते। मृष्टिरिति तु बाहुलकात् क्तिनि, क्तिचि वा निष्पद्यत इति ज्ञेयम्।]]</li> <li id="foot_krm_1312_29"><a href="#ref_krm_1312_29">↑</a> [[आ। ‘पयोधरांश्चन्दनपङ्कदिग्धान् वासांसि चामृष्टमृजानि दृष्ट्वा।’ भ। का। ११। २७।]]</li> <li id="foot_krm_1312_30"><a href="#ref_krm_1312_30">↑</a> [[३। सम्मार्जनी इति करणल्युडन्तात् स्त्रियां टित्त्वेन ङीपि रूपम्। सम्मार्जनी = शोधनसाधनी।]]</li> <li id="foot_krm_1312_31"><a href="#ref_krm_1312_31">↑</a> [[४। सम्पूर्वकादस्माद् भावे ‘अभिविधौ भाव इनुण्’ (३-३-४४) इतीनुणि, तदन्तात् ‘अण् इनुणः’ (५-४-१५) इति स्वार्थिके अण्प्रत्यये, ‘इनण्यनपत्ये’ (६-४-१६४) इति नान्तस्य प्रकृतिभावे च रूपमेवम्। क्लीबत्वं लोकादत्रेति ज्ञेयम्। काशिकायाम् (६-४-१६४) उदाहृतमिदं पदम्।]]</li> <li id="foot_krm_1312_32"><a href="#ref_krm_1312_32">↑</a> [[५। ‘मृजेर्गुणश्च’ (द। उ। १-१६५) इत्यूप्रत्यये, वचनादेव वृद्ध्यपवादे गुणे च रूपम्। मर्जूः = शुद्धिः।]]</li> <li id="foot_krm_1312_33"><a href="#ref_krm_1312_33">↑</a> [[६। ‘कञ्जिमृजिभ्यां चित्’ (द। उ। ८-६७) इत्यारन्प्रत्यये रूपसिद्धिः। मार्ष्टि भवन- मिति मार्जारः = बिडालः।]]</li> <li id="foot_krm_1312_34"><a href="#ref_krm_1312_34">↑</a> [[७। ‘स्थाचतिमृजेः आलवालजालीयरः’ (द। उ। १०-१) इत्यनेन यथासंख्यमालीयर् प्रत्यये रूपमेवम्। मार्ष्टि अशुभं रक्षांसि चेति मार्जालीयः = अग्निः।]]</li> <li id="foot_krm_1312_35"><a href="#ref_krm_1312_35">↑</a> [पृष्ठम्१०५१+ २९]</li></ul></p>

मृजू|मार्जकः-र्जिका|मिमार्जयिषकः-षिका|मिमार्जिषकः-षिका|मिमृक्षकः-क्षिका|मरीमृजकः-मरीमार्जकः-र्जिका|मार्जयिता-त्री|मिमार्ज-|यिषिता-त्री|मार्जिता-त्री|मार्ष्टा-मार्ष्ट्री|मिमार्जिषिता-मिमृक्षिता-त्री|मरीमृजिता-मरीमार्जिता-त्री
<ul><li><sup id="ref_krm_1313_01"><a href="#foot_krm_1313_01">1</a></sup> {@“मृजू शौचालङ्कारयोः”@} <sup id="ref_krm_1313_02"><a href="#foot_krm_1313_02">2</a></sup> आधृषीयः। </li> <li>‘शौचालङ्कारयोर्वा णौ मृजेर्मार्जति मार्जयेत्।।’ <sup id="ref_krm_1313_03"><a href="#foot_krm_1313_03">3</a></sup> इति देवः। </li> <li>‘मृजूष्--’ इति क्षीरस्वामी। </li> <li>ऊदित्त्वस्य ण्यन्ते प्रयोजनाभावात्, शुद्ध एवोपयोगाच्चास्य णिज्विकल्प इति ज्ञेयम्। </li> <li>यद्वा, आधृषीयत्वेनेड्विकल्प इति बोध्यम्। </li> <li>मार्जकः-र्जिका, मिमार्जयिषकः-षिका, मार्जकः-र्जिका, मिमार्जिषकः-षिका, मिमृक्षकः-क्षिका, मरीमृजकः-मरीमार्जकः-र्जिका;</li> <li>  मार्जयिता-त्री, मिमार्ज- यिषिता-त्री, मार्जिता-त्री, मार्ष्टा-मार्ष्ट्री, मिमार्जिषिता-मिमृक्षिता-त्री, मरीमृजिता-मरीमार्जिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि यथा- सम्भवमूह्यानि। </li> <li>णिजभावपक्षे पूर्वलिखितादादिकमार्ष्टिवत् <sup id="ref_krm_1313_04"><a href="#foot_krm_1313_04">4</a></sup> सन्नन्ते, यङन्ते च रूपाणि बोध्यानि। </li> <li>ण्यन्तात्, ण्यन्तप्रकृतिकसन्नन्ताच्च, णिन्नि- मित्तकं लघूपधलक्षणं गुणं बाधित्वा, ‘मृजेर्वृद्धिः’ <sup id="ref_krm_1313_05"><a href="#foot_krm_1313_05">5</a></sup> इति वृद्धि- रिति विशेषः। </li> <li>वृद्धिविधायके सूत्रे उत्सृष्टानुबन्धस्य मृजेरविशेषेण ग्रहणमिति विवेकः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1313_01"><a href="#ref_krm_1313_01">↑</a> (१३०३)</li> <li id="foot_krm_1313_02"><a href="#ref_krm_1313_02">↑</a> (१०-चुरादिः-१८४९। सक। सेट्। उभ।)</li> <li id="foot_krm_1313_03"><a href="#ref_krm_1313_03">↑</a> (श्लो। ६०)</li> <li id="foot_krm_1313_04"><a href="#ref_krm_1313_04">↑</a> (१३०२)</li> <li id="foot_krm_1313_05"><a href="#ref_krm_1313_05">↑</a> (७-२-११४)</li></ul></p>

मृड|मर्डकः-र्डिका|मिमर्डिषकः-षिका|मरीमृडकः-डिका|मर्डिता-त्री|मर्डयिता-त्री|मिमर्डिषिता-त्री|मरीमृडिता-त्री
<ul><li><sup id="ref_krm_1314_01"><a href="#foot_krm_1314_01">1</a></sup> {@“मृड सुखने”@} <sup id="ref_krm_1314_02"><a href="#foot_krm_1314_02">2</a></sup> ‘मृडेर्मृड्णाति सुखने तत्रैव मृडतीति शे।।’ <sup id="ref_krm_1314_03"><a href="#foot_krm_1314_03">3</a></sup> इति देवः। </li> <li>मर्डकः-र्डिका, मर्डकः-र्डिका, मिमर्डिषकः-षिका, मरीमृडकः-डिका;</li> <li>  मर्डिता-त्री, मर्डयिता-त्री, मिमर्डिषिता-त्री, मरीमृडिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि प्रातिस्विकरूपाणि विना भौवादिकगर्जतिवत् <sup id="ref_krm_1314_04"><a href="#foot_krm_1314_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1314_05"><a href="#foot_krm_1314_05">5</a></sup> मृडः-मृडानी, क्तिनि- <sup id="ref_krm_1314_06"><a href="#foot_krm_1314_06">6</a></sup> मृढिः, <sup id="ref_krm_1314_07"><a href="#foot_krm_1314_07">7</a></sup> मृडित्वा, <sup id="ref_krm_1314_08"><a href="#foot_krm_1314_08">8</a></sup> इमानि रूपाण्यधि- कान्यत्रेति विशेषः। </li> <li><sup id="ref_krm_1314_09"><a href="#foot_krm_1314_09">9</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1314_01"><a href="#ref_krm_1314_01">↑</a> (१३०४)</li> <li id="foot_krm_1314_02"><a href="#ref_krm_1314_02">↑</a> (६-तुदादिः-१३२७। अक। सेट्। पर।)</li> <li id="foot_krm_1314_03"><a href="#ref_krm_1314_03">↑</a> (श्लो। ८७)</li> <li id="foot_krm_1314_04"><a href="#ref_krm_1314_04">↑</a> (४२२)</li> <li id="foot_krm_1314_05"><a href="#ref_krm_1314_05">↑</a> [[१। ‘इगुपधज्ञा--’ (३-१-१३५) इति कर्तरि कप्रत्यये रूपम्। मृडस्य स्त्री इति विवक्षायां ‘इन्द्रवरुणभवशर्वरुद्रमृड--’ (४-१-४९) इत्यादिना पुंयोगे ङीषि आनुगागमे मृडानी इति रूपं भवति।]]</li> <li id="foot_krm_1314_06"><a href="#ref_krm_1314_06">↑</a> [[२। ‘तितुत्र--’ (७-२-९) इतीण्निषेधे ढत्वे ष्टुत्वे च रूपमेवम्।]]</li> <li id="foot_krm_1314_07"><a href="#ref_krm_1314_07">↑</a> [[३। ‘मृडमृद--’ (१-२-७) इति सेटः क्त्वायाः कित्त्वात् गुणनिषेधे रूपमेवम्। ‘न क्त्वा सेट्’ (१-२-१८) इत्यस्य प्रतिषेधः।]]</li> <li id="foot_krm_1314_08"><a href="#ref_krm_1314_08">↑</a> [[आ। ‘अमृडित्वा सहस्राक्षं क्लिशित्वा कौशलैर्निजैः।’ भ। का। ७। ९६।]]</li> <li id="foot_krm_1314_09"><a href="#ref_krm_1314_09">↑</a> [पृष्ठम्१०५२+ २७]</li></ul></p>

मृड|मर्डकः-र्डिका|मिमर्डिषकः-षिका|मरीमृडकः-डिका|मर्डिता-त्री|मर्डयिता-त्री|मिमर्डिषिता-त्री|मरीमृडिता-त्री
<ul><li><sup id="ref_krm_1315_01"><a href="#foot_krm_1315_01">1</a></sup> {@“मृड क्षोदे”@} <sup id="ref_krm_1315_02"><a href="#foot_krm_1315_02">2</a></sup> ‘मृड सुखे चेति केचित्।’ इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>‘--सुखने’ इति क्षीरस्वामी, पुरुषकारश्च। </li> <li>तत्र <sup id="ref_krm_1315_03"><a href="#foot_krm_1315_03">3</a></sup> “अन्ये… क्षोदे, मृड सुखने च” इति पठन्ति इति। </li> <li>‘मृडेर्मृड्णाति सुखने तत्रैव मृडतीति शे।।’ <sup id="ref_krm_1315_04"><a href="#foot_krm_1315_04">4</a></sup> इति देवः। </li> <li>मर्डकः-र्डिका, मर्डकः-र्डिका, मिमर्डिषकः-षिका, मरीमृडकः-डिका;</li> <li>  मर्डिता-त्री, मर्डयिता-त्री, मिमर्डिषिता-त्री, मरीमृडिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि तौदादिकतृपतिवत् <sup id="ref_krm_1315_05"><a href="#foot_krm_1315_05">5</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1315_06"><a href="#foot_krm_1315_06">6</a></sup> मृड्णन्-ती-न्ती, व्यतिमृडाणः, <sup id="ref_krm_1315_07"><a href="#foot_krm_1315_07">7</a></sup> मृडीकम्-मृडङ्कणः, इमानि रूपाणि अस्य धातोः विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1315_01"><a href="#ref_krm_1315_01">↑</a> (१३०५)</li> <li id="foot_krm_1315_02"><a href="#ref_krm_1315_02">↑</a> (९-क्र्यादिः-१५१६। सक। सेट्। पर।)</li> <li id="foot_krm_1315_03"><a href="#ref_krm_1315_03">↑</a> (पुरुषकारे श्लो। ८७)</li> <li id="foot_krm_1315_04"><a href="#ref_krm_1315_04">↑</a> (श्लो। ८७)</li> <li id="foot_krm_1315_05"><a href="#ref_krm_1315_05">↑</a> (७७२)</li> <li id="foot_krm_1315_06"><a href="#ref_krm_1315_06">↑</a> [[१। शतरि, ‘क्र्यादिभ्यः श्ना’ (३-१-८१) इति श्ना विकरणप्रत्ययः। ‘श्नाऽभ्यस्तयो- रातः’ (६-४-११२) इत्याकारलोपे णत्वे च रूपम्।]]</li> <li id="foot_krm_1315_07"><a href="#ref_krm_1315_07">↑</a> [[२। ‘मृडः कीकन् कङ्कणौ’ (द। उ। १०-११) इति कीकन् कङ्कणः इत्येतौ प्रत्ययौ भवतः। मृडीकम् = हिरण्यम्। मृडङ्कणः = शिशुः।]]</li></ul></p>

मृण|मर्णकः-र्णिका|मिमर्णिषकः-षिका|मरीमृणकः-णिका|मर्णिता-त्री|मर्णयिता-त्री|मिमर्णिषिता-त्री|मरीमृणिता-त्री
<ul><li><sup id="ref_krm_1316_01"><a href="#foot_krm_1316_01">1</a></sup> {@“मृण हिंसायाम्”@} <sup id="ref_krm_1316_02"><a href="#foot_krm_1316_02">2</a></sup> मर्णकः-र्णिका, मर्णकः-र्णिका, मिमर्णिषकः-षिका, मरीमृणकः-णिका;</li> <li>  मर्णिता-त्री, मर्णयिता-त्री, मिमर्णिषिता-त्री, मरीमृणिता-त्री;</li> <li>  इत्यादीनि सर्वाणि रूपाणि प्रातिस्विकरूपाणि विना तानादिकतर्णोतिवत् <sup id="ref_krm_1316_03"><a href="#foot_krm_1316_03">3</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_1316_04"><a href="#foot_krm_1316_04">4</a></sup> मृणालम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1316_01"><a href="#ref_krm_1316_01">↑</a> (१३०६)</li> <li id="foot_krm_1316_02"><a href="#ref_krm_1316_02">↑</a> (६-तुदादिः-१३३१। सक। सेट्। पर।)</li> <li id="foot_krm_1316_03"><a href="#ref_krm_1316_03">↑</a> (७६६)</li> <li id="foot_krm_1316_04"><a href="#ref_krm_1316_04">↑</a> [[३। ‘तमिबिडिविलिमृणि--’ (द। उ। ८-११५) इत्यादिना कालच्प्रत्यये रूपम्। मृणालम् = बिसम्।]]</li></ul></p>

मृद|मर्दकः-र्दिका|मिमर्दिषकः-षिका|मरीमृदकः-दिका|मर्दिता-त्री|मर्दयिता-त्री|मिमर्दिषिता-त्री|मरीमृदिता-त्री
<ul><li><sup id="ref_krm_1317_01"><a href="#foot_krm_1317_01">1</a></sup> {@“मृद क्षोदे”@} <sup id="ref_krm_1317_02"><a href="#foot_krm_1317_02">2</a></sup> <sup id="ref_krm_1317_03"><a href="#foot_krm_1317_03">3</a></sup> क्वचित् सिद्धान्तकौमुद्यां ‘मृद मर्दने’ इति भ्वादिष्वपि <sup id="ref_krm_1317_04"><a href="#foot_krm_1317_04">4</a></sup> पठ्यते। </li> <li>वस्तुतस्तत्र ‘म्रद्--’ इति भाव्यम् इत्याशयेनास्माभिर्नायं विलिखित इति ज्ञेयम्।]] ‘क्षोदनम् = सञ्चूर्णनम्’ इति धा। </li> <li>का। </li> <li><sup id="ref_krm_1317_05"><a href="#foot_krm_1317_05">5</a></sup>। </li> <li>मर्दकः-र्दिका, मर्दकः-र्दिका, मिमर्दिषकः-षिका, मरीमृदकः-दिका;</li> <li>  मर्दिता-त्री, मर्दयिता-त्री, मिमर्दिषिता-त्री, मरीमृदिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि तौदादिकतृपतिवत् <sup id="ref_krm_1317_06"><a href="#foot_krm_1317_06">6</a></sup> ज्ञेयानि। </li> <li>क्विपि- <sup id="ref_krm_1317_07"><a href="#foot_krm_1317_07">7</a></sup> मृत्-मृद्-मृदौ-मृदः, <sup id="ref_krm_1317_08"><a href="#foot_krm_1317_08">8</a></sup> मृत्तिका, मृत्सा-मृत्स्ना, <sup id="ref_krm_1317_09"><a href="#foot_krm_1317_09">9</a></sup> मुरमर्दनः, मर्दनम्, <sup id="ref_krm_1317_10"><a href="#foot_krm_1317_10">10</a></sup> मृद्यः, <sup id="ref_krm_1317_11"><a href="#foot_krm_1317_11">11</a></sup> महिषासुरमर्दनी, <sup id="ref_krm_1317_12"><a href="#foot_krm_1317_12">12</a></sup> मृदित्वा, <sup id="ref_krm_1317_13"><a href="#foot_krm_1317_13">13</a></sup> मृदङ्गः, इत्यादीनि रूपाणि अस्य धातोः विशेषेण भवन्ति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1317_01"><a href="#ref_krm_1317_01">↑</a> (१३०७)</li> <li id="foot_krm_1317_02"><a href="#ref_krm_1317_02">↑</a> (९-क्र्यादिः-१५१५। अक। सेट्। पर।)</li> <li id="foot_krm_1317_03"><a href="#ref_krm_1317_03">↑</a> [[[अ]</li> <li id="foot_krm_1317_04"><a href="#ref_krm_1317_04">↑</a> (७६७)</li> <li id="foot_krm_1317_05"><a href="#ref_krm_1317_05">↑</a> (३-१०)</li> <li id="foot_krm_1317_06"><a href="#ref_krm_1317_06">↑</a> (७७२)</li> <li id="foot_krm_1317_07"><a href="#ref_krm_1317_07">↑</a> [पृष्ठम्१०५३+ २९]</li> <li id="foot_krm_1317_08"><a href="#ref_krm_1317_08">↑</a> [[१। ‘मृदस्तिकन्’ (५-४-३९) इति मृच्छब्दात् स्वार्थे तिकन्प्रत्यये रूपमेवम्।]]</li> <li id="foot_krm_1317_09"><a href="#ref_krm_1317_09">↑</a> [[२। नन्द्यादेः (३-१-१३४) आकृतिगणत्वात् कर्तरि ल्युप्रत्ययः। मुरं मर्दयतीति मुरमर्दनः।]]</li> <li id="foot_krm_1317_10"><a href="#ref_krm_1317_10">↑</a> [[३। ‘ऋदुपधात्--’ (३-१-११०) इति क्यप्प्रत्ययः।]]</li> <li id="foot_krm_1317_11"><a href="#ref_krm_1317_11">↑</a> [[४। बाहुलकात् ‘कृत्यल्युटो बहुलम्’ (३-३-११३) इति कर्मण्युपपदे कर्तरि ल्युटि, स्त्रियां टित्त्वात् ङीपि च रूपमेवम्।]]</li> <li id="foot_krm_1317_12"><a href="#ref_krm_1317_12">↑</a> [[५। ‘मृडमृद--’ (१-२-७) इति सेटः क्त्वायाः कित्त्वात् गुणनिषेधे रूपमेवम्।]]</li> <li id="foot_krm_1317_13"><a href="#ref_krm_1317_13">↑</a> [[६। ‘विडादिभ्यः कित्’ (द। उ। ३-६१) इति अङ्गच्प्रत्ययः। मृदङ्गः = वाद्यविशेषः।]]</li></ul></p>

मृधु|मर्घकः-र्धिका|मर्धकः-र्धिका|मिमर्धिषकः-षिका|मरीमृधकः-धिका|मर्धिता-त्री|मर्धयिता-त्री|मिमर्धिषिता-त्री|मरीमृधिता-त्री
<ul><li><sup id="ref_krm_1318_01"><a href="#foot_krm_1318_01">1</a></sup> {@“मृधु उन्दने”@} <sup id="ref_krm_1318_02"><a href="#foot_krm_1318_02">2</a></sup> उन्दनम् = क्लेदनम्। </li> <li>मर्घकः-र्धिका, मर्धकः-र्धिका, मिमर्धिषकः-षिका, मरीमृधकः-धिका;</li> <li>  मर्धिता-त्री, मर्धयिता-त्री, मिमर्धिषिता-त्री, मरीमृधिता-त्री;</li> <li>  इत्यादीनि प्रातिस्विकरूपाणि विना सर्वाण्यपि रूपाणि तानादिकतर्णोतिवत् <sup id="ref_krm_1318_03"><a href="#foot_krm_1318_03">3</a></sup> ज्ञेयानि। </li> <li>शतरि-मर्धन्-न्ती, <sup id="ref_krm_1318_04"><a href="#foot_krm_1318_04">4</a></sup> मृद्धम्-द्धः-मृद्धवान्, <sup id="ref_krm_1318_05"><a href="#foot_krm_1318_05">5</a></sup> मर्धित्वा-मृद्ध्वा, <sup id="ref_krm_1318_06"><a href="#foot_krm_1318_06">6</a></sup> मृधम्, इमानि रूपाणि अस्य धातोः भवन्तीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1318_01"><a href="#ref_krm_1318_01">↑</a> (१३०८)</li> <li id="foot_krm_1318_02"><a href="#ref_krm_1318_02">↑</a> (१-भ्वादिः-८७४। सक। सेट्। उभ।)</li> <li id="foot_krm_1318_03"><a href="#ref_krm_1318_03">↑</a> (७६६)</li> <li id="foot_krm_1318_04"><a href="#ref_krm_1318_04">↑</a> [[आ। ‘या नेदितोर्वीपरिशर्धिवीचीविमृद्धवृक्षादिविबोध्यशैत्या।।’ धा। का। २। २६।]]</li> <li id="foot_krm_1318_05"><a href="#ref_krm_1318_05">↑</a> [[७। ‘उदितो वा’ (७-२-५६) इति क्त्वायामिड्विकल्पः। इट्पक्षे ‘न क्त्वा सेट्’ (१-२-१८) इति कित्त्वनिषेधात् गुणे मर्धित्वा इति रूपम्। तेन रूपद्वयं ज्ञेयम्।]]</li> <li id="foot_krm_1318_06"><a href="#ref_krm_1318_06">↑</a> [[८। ‘घञर्थे कविधानम्’ (वा। ३-३-५८) इति कप्रत्यये रूपमेवम्। बाहुलकाद्वा भावे कप्रत्ययः। मृधम् = समरः इति क्षीरस्वामी।]]</li></ul></p>

मृश|मर्शकः-र्शिका|मिमृक्षकः-क्षिका|मरीमृशकः-शिका|शतरि-आमृशन्-|न्ती-ती|म्रक्ष्यन्-मर्क्ष्यन्-न्ती-ती
<ul><li><sup id="ref_krm_1319_01"><a href="#foot_krm_1319_01">1</a></sup> {@“मृश आमर्शने”@} <sup id="ref_krm_1319_02"><a href="#foot_krm_1319_02">2</a></sup> आमर्शनम् = स्पर्शः। </li> <li>मर्शकः-र्शिका, मर्शकः-र्शिका, <sup id="ref_krm_1319_03"><a href="#foot_krm_1319_03">3</a></sup> मिमृक्षकः-क्षिका, मरीमृशकः-शिका;</li> <li>  <sup id="ref_krm_1319_04"><a href="#foot_krm_1319_04">4</a></sup> <sup id="ref_krm_1319_05"><a href="#foot_krm_1319_05">5</a></sup> म्रष्टा-मर्ष्टा-र्ष्ट्री, मर्शयिता-त्री, मिमृक्षिता-त्री, मरीमृशिता-त्री, इत्यादीनि सर्वाणि रूपाणि भौवादिककर्षतिवत् <sup id="ref_krm_1319_06"><a href="#foot_krm_1319_06">6</a></sup> ज्ञेयानि। </li> <li>शतरि- <sup id="ref_krm_1319_07"><a href="#foot_krm_1319_07">7</a></sup> आमृशन्- न्ती-ती, म्रक्ष्यन्-मर्क्ष्यन्-न्ती-ती;</li> <li>  इति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1319_01"><a href="#ref_krm_1319_01">↑</a> (१३०९)</li> <li id="foot_krm_1319_02"><a href="#ref_krm_1319_02">↑</a> (६-तुदादिः-१४२५। सक। अनि। पर।)</li> <li id="foot_krm_1319_03"><a href="#ref_krm_1319_03">↑</a> [[९। सन्नन्तात् ण्वुलि, ‘हलन्ताच्च’ (१-२-१०) इति सनः कित्त्वात् ‘--अकिति’ (६-१-५९) इत्युक्तत्वात् अमभावे ‘व्रश्च--’ (८-२-३६) इत्यादिना धातुशकारस्य षकारे ‘षढोः कः सि’ (८-२-४१) इति ककारे षत्वे च रूपमेवम्। एवं सन्नन्ते सर्वत्र प्रक्रिया ज्ञेया।]]</li> <li id="foot_krm_1319_04"><a href="#ref_krm_1319_04">↑</a> [पृष्ठम्१०५४+ २६]</li> <li id="foot_krm_1319_05"><a href="#ref_krm_1319_05">↑</a> [[१। ‘अनुदात्तस्य चर्दुपधस्यान्यतरस्याम्’ (६-१-५९) इति वा अमागमः। ततः यण्। तेन रूपद्वयं बोध्यम्। एवमेव अकिति झलादिप्रत्यये परतः सर्वत्र अमागमो विकल्पेन भवति।]]</li> <li id="foot_krm_1319_06"><a href="#ref_krm_1319_06">↑</a> (२५५)</li> <li id="foot_krm_1319_07"><a href="#ref_krm_1319_07">↑</a> [[२। ‘तुदादिभ्यः शः’ (३-१-७७) इति शः बिकरणप्रत्ययः। अपित्सार्वधातुकस्य शस्य ङिद्वद्भावाद् अङ्गस्य गुणो न। स्त्रियां नुम्विकल्पे रूपद्वयं ज्ञेयम्।]]</li></ul></p>

मृष|मर्षकः-र्षिका|मिमर्षिषकः-षिका|मरीमृषकः-षिका|मर्षिता-त्री|मर्षयिता-त्री|मिमर्षिषिता-त्री|मरीमृषिता-त्री
<ul><li><sup id="ref_krm_1320_01"><a href="#foot_krm_1320_01">1</a></sup> {@“मृष तितिक्षायाम्”@} <sup id="ref_krm_1320_02"><a href="#foot_krm_1320_02">2</a></sup> ‘-- -- क्षमायां यौ मर्षेन्मर्षेत मर्षयेत्। </li> <li>मृष्यते मृष्यतीति स्यात् स्नेहने शपि मर्षति।।’ <sup id="ref_krm_1320_03"><a href="#foot_krm_1320_03">3</a></sup> इति देवः। </li> <li>मर्षकः-र्षिका, मर्षकः-र्षिका, मिमर्षिषकः-षिका, मरीमृषकः-षिका;</li> <li>  मर्षिता-त्री, मर्षयिता-त्री, मिमर्षिषिता-त्री, मरीमृषिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि दैवादिकतृष्यतिवत् <sup id="ref_krm_1320_04"><a href="#foot_krm_1320_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1320_05"><a href="#foot_krm_1320_05">5</a></sup> परिमृष्यन्-न्ती, <sup id="ref_krm_1320_06"><a href="#foot_krm_1320_06">6</a></sup> मर्षितः-मर्षितवान्, <sup id="ref_krm_1320_07"><a href="#foot_krm_1320_07">7</a></sup> अपमृषितम् <sup id="ref_krm_1320_08"><a href="#foot_krm_1320_08">8</a></sup>, <sup id="ref_krm_1320_09"><a href="#foot_krm_1320_09">9</a></sup> दुर्मर्षणः, <sup id="ref_krm_1320_10"><a href="#foot_krm_1320_10">10</a></sup> <sup id="ref_krm_1320_11"><a href="#foot_krm_1320_11">11</a></sup> मर्षित्वा-मृषित्वा, <sup id="ref_krm_1320_12"><a href="#foot_krm_1320_12">12</a></sup> मर्षणः, इतीमान्यस्य विशेषरूपाणीति ज्ञेयम्। </li> <li><sup id="ref_krm_1320_13"><a href="#foot_krm_1320_13">13</a></sup> मृष्यमाणः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1320_01"><a href="#ref_krm_1320_01">↑</a> (१३१०)</li> <li id="foot_krm_1320_02"><a href="#ref_krm_1320_02">↑</a> (४-दिवादिः-११६४। सक। सेट्। उभ।)</li> <li id="foot_krm_1320_03"><a href="#ref_krm_1320_03">↑</a> (श्लो। १७३)</li> <li id="foot_krm_1320_04"><a href="#ref_krm_1320_04">↑</a> (७७५)</li> <li id="foot_krm_1320_05"><a href="#ref_krm_1320_05">↑</a> [[३। ‘परेर्मृषः’ (१-३-८२) इति परिपूर्वकस्यास्य कर्तृगामिन्यपि क्रियाफले परस्मैपदं शतैव। तेन शतरि, श्यनि अङ्गस्य गुणनिषेधे च रूपमेवम्।]]</li> <li id="foot_krm_1320_06"><a href="#ref_krm_1320_06">↑</a> [[४। ‘मृषस्तितिक्षायाम्’ (१-२-२०) इति सेटो निष्ठायाः कित्त्वनिषेधात् गुणे रूपमेवम्। अत्र धातुपाठ एवास्य धातोस्तितिक्षार्थनिर्देशात्, भौवादिकमर्षते- रुदित्त्वेन निष्ठायामिटः प्राप्त्यभावात्, पारिशेष्यात् दैवादिकस्यास्यैव ग्रहणस्य सम्भ- वेन (१-२-२०) सूत्रे पुनः ‘तितिक्षायाम्’ इत्युपादानं व्यर्थं सत् धातोरर्थान्तरत्वे गमकमिति शाब्दिकाः। तेन तितिक्षा (क्षमा) भिन्नार्थे निष्ठायाः कित्त्वमेव। यथा-- ‘अपमृषितं वाक्यमाह’ इति। अत्र धातोरुपसर्गयोगवशात् अविस्पष्टरूपार्थान्तरे वृत्तिरिति ज्ञेयम्।]]</li> <li id="foot_krm_1320_07"><a href="#ref_krm_1320_07">↑</a> [[आ। ‘विहितं मयाऽद्य सदसीदमपमृषितमच्युतार्चनम्।’ शि। व। १५-४६।]]</li> <li id="foot_krm_1320_08"><a href="#ref_krm_1320_08">↑</a> (वाक्यम्)</li> <li id="foot_krm_1320_09"><a href="#ref_krm_1320_09">↑</a> [[५। ईषदाद्युपपदेषु, ‘भाषायां शासियुधिदृशिधृषिमृषिभ्यो युज् वाच्यः’ (वा। ३-३-१३०) इति खलपवादो युच्। ‘वा इत्येके’ इति प्रक्रियाकौमुदी। तन्मते ईषन्मर्षः-दुर्मर्षः-सुमर्षः इति रूपाण्यपि बोध्यानि।]]</li> <li id="foot_krm_1320_10"><a href="#ref_krm_1320_10">↑</a> [पृष्ठम्१०५५+ २४]</li> <li id="foot_krm_1320_11"><a href="#ref_krm_1320_11">↑</a> [[१। क्त्वायाम्, ‘तृषिमृषिकृशेः काश्यपस्य’ (१-२-२५) इति कित्त्वविकल्पः। तेन रूपद्वयम्।]]</li> <li id="foot_krm_1320_12"><a href="#ref_krm_1320_12">↑</a> [[२। नन्द्यादेः (३-१-१३४) आकृतिगणत्वात्, बाहुलकाद् वा कर्तरि, ण्यन्तात्, शुद्धाद्वा ल्युप्रत्यये रूपमेवम्।]]</li> <li id="foot_krm_1320_13"><a href="#ref_krm_1320_13">↑</a> [[आ। ‘तन्मृष्यमाणास्त्वथ शुच्यदङ्गका भृत्याः सुनद्धं बहुरक्तमंशुकम्।’ धा। का। २। ६१।]]</li></ul></p>

मृष|मर्षकः-र्षिका|मिमर्षयिषकः-षिका|मिमर्षिषकः-षिका|मरीमृषकः-षिका|मर्षयिता-त्री|मर्षिता-त्री|मिमर्षयिषिता-त्री|मिमर्षि-|षिता-त्री|मरीमृषिता-त्री
<ul><li><sup id="ref_krm_1321_01"><a href="#foot_krm_1321_01">1</a></sup> {@“मृष तितिक्षायाम्”@} <sup id="ref_krm_1321_02"><a href="#foot_krm_1321_02">2</a></sup> आधृषीयः। </li> <li>तेन णिज्विकल्पः। </li> <li>‘--क्षमायां यौ मर्षेन्मर्षेत मर्षयेत्।’ <sup id="ref_krm_1321_03"><a href="#foot_krm_1321_03">3</a></sup> इति देवः। </li> <li>मर्षकः-र्षिका, मिमर्षयिषकः-षिका, मर्षकः-र्षिका, मिमर्षिषकः-षिका, मरीमृषकः-षिका;</li> <li>  मर्षयिता-त्री, मर्षिता-त्री, मिमर्षयिषिता-त्री, मिमर्षि- षिता-त्री, मरीमृषिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकचर्षतिवत् <sup id="ref_krm_1321_04"><a href="#foot_krm_1321_04">4</a></sup> ज्ञेयानि। </li> <li>णिजभावपक्षे क्विपि-मृट्-मृड्-मृषौ-मृषः, मृषित्वा-मर्षित्वा, इत्यादीनि रूपाण्यस्य धातोरिति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1321_01"><a href="#ref_krm_1321_01">↑</a> (१३११)</li> <li id="foot_krm_1321_02"><a href="#ref_krm_1321_02">↑</a> (१०-चुरादिः-१८५०। सक। सेट्। उभ।)</li> <li id="foot_krm_1321_03"><a href="#ref_krm_1321_03">↑</a> (श्लो। १७३)</li> <li id="foot_krm_1321_04"><a href="#ref_krm_1321_04">↑</a> (५५४)</li></ul></p>

मृषु|मर्षकः-र्षिका|मिमर्षिषकः-षिका|मरीमृषकः-षिका|मर्षिता-त्री|मर्षयिता-त्री|मिमर्षिषिता-त्री|मरीमृषिता-त्री
<ul><li><sup id="ref_krm_1322_01"><a href="#foot_krm_1322_01">1</a></sup> {@“मृषु सेचने सहने च”@} <sup id="ref_krm_1322_02"><a href="#foot_krm_1322_02">2</a></sup> ‘--हिंसाक्लेशदैन्येषु इत्येके’ इति धा। </li> <li>का। </li> <li><sup id="ref_krm_1322_03"><a href="#foot_krm_1322_03">3</a></sup>। </li> <li>‘-- स्नेहने’ इति देवसम्मतः पाठः <sup id="ref_krm_1322_04"><a href="#foot_krm_1322_04">4</a></sup> इति ज्ञायते। </li> <li>‘मृष्यते मृष्यतीति स्यात्, स्नेहने शपि मर्षति।।’ <sup id="ref_krm_1322_05"><a href="#foot_krm_1322_05">5</a></sup> इति देवः। </li> <li>मर्षकः-र्षिका, मर्षकः-र्षिका, मिमर्षिषकः-षिका, मरीमृषकः-षिका;</li> <li>  मर्षिता-त्री, मर्षयिता-त्री, मिमर्षिषिता-त्री, मरीमृषिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकपर्षतिवत् <sup id="ref_krm_1322_06"><a href="#foot_krm_1322_06">6</a></sup> ज्ञेयानि। </li> <li>युचि-मर्षणः, <sup id="ref_krm_1322_07"><a href="#foot_krm_1322_07">7</a></sup> मृष्टम्-ष्टः-मृष्टवान्, <sup id="ref_krm_1322_08"><a href="#foot_krm_1322_08">8</a></sup> मर्षित्वा-मृष्ट्वा, इमानि रूपाण्यधिकानीति विशेषः। </li> <li><sup id="ref_krm_1322_09"><a href="#foot_krm_1322_09">9</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1322_01"><a href="#ref_krm_1322_01">↑</a> (१३१२)</li> <li id="foot_krm_1322_02"><a href="#ref_krm_1322_02">↑</a> (१-भ्वादिः-७०७। सक। सेट्। पर।)</li> <li id="foot_krm_1322_03"><a href="#ref_krm_1322_03">↑</a> (१। ८८)</li> <li id="foot_krm_1322_04"><a href="#ref_krm_1322_04">↑</a> (श्लो। १७३)</li> <li id="foot_krm_1322_05"><a href="#ref_krm_1322_05">↑</a> (श्लो। १७३)</li> <li id="foot_krm_1322_06"><a href="#ref_krm_1322_06">↑</a> (१०५४)</li> <li id="foot_krm_1322_07"><a href="#ref_krm_1322_07">↑</a> [[३। उदित्त्वेन क्त्वायामिड्विकल्पनात्, निष्ठायाम् ‘यस्य विभाषा’ (७-२-१५) इतीण्निषेधः। ष्टुत्वं च।]]</li> <li id="foot_krm_1322_08"><a href="#ref_krm_1322_08">↑</a> [[४। ‘उदितो वा’ (७-२-५६) इति क्त्वायामिड्विकल्पः। इट्पक्षे ‘न क्त्वा सेट्’ (१-२-१८) इति कित्त्वनिषेधात् गुणः। तेन रूपद्वयम्।]]</li> <li id="foot_krm_1322_09"><a href="#ref_krm_1322_09">↑</a> [पृष्ठम्१०५६+ ३२]</li></ul></p>

मॄ|मारकः-रिका|मुमूर्षकः-मिमरिषकः-मिमरीषकः-षिका|मोमुरकः-रिका|मरिता-मरीता-त्री|मारयिता-त्री|मुमूर्षिता-मिमरिषिता-|मिमरीषिता-त्री|मोमुरिता-त्री
<ul><li><sup id="ref_krm_1323_01"><a href="#foot_krm_1323_01">1</a></sup> {@“मॄ हिंसायाम्”@} <sup id="ref_krm_1323_02"><a href="#foot_krm_1323_02">2</a></sup> प्वादिः, ल्वादिश्च। </li> <li>‘मृणाति हिंसार्थे प्वादेर्मृङस्तु म्रियते पदम्।।’ <sup id="ref_krm_1323_03"><a href="#foot_krm_1323_03">3</a></sup> इति देवः। </li> <li>मारकः-रिका, मारकः-रिका, मुमूर्षकः-मिमरिषकः-मिमरीषकः-षिका, मोमुरकः-रिका;</li> <li>  मरिता-मरीता-त्री, मारयिता-त्री, मुमूर्षिता-मिमरिषिता- मिमरीषिता-त्री, मोमुरिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि जौहोत्यादिक पिपर्तिवत् <sup id="ref_krm_1323_04"><a href="#foot_krm_1323_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1323_05"><a href="#foot_krm_1323_05">5</a></sup> मृणन्-मृणती, <sup id="ref_krm_1323_06"><a href="#foot_krm_1323_06">6</a></sup> मूर्णम्-मूर्णः-मूर्णवान्, <sup id="ref_krm_1323_07"><a href="#foot_krm_1323_07">7</a></sup> मूर्णिः, इतीमानि रूपाण्यस्माद् भवन्ति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1323_01"><a href="#ref_krm_1323_01">↑</a> (१३१३)</li> <li id="foot_krm_1323_02"><a href="#ref_krm_1323_02">↑</a> (९-क्र्यादिः-१४९२। सक। सेट्। पर।)</li> <li id="foot_krm_1323_03"><a href="#ref_krm_1323_03">↑</a> (श्लो। ३४)</li> <li id="foot_krm_1323_04"><a href="#ref_krm_1323_04">↑</a> (१०५५)</li> <li id="foot_krm_1323_05"><a href="#ref_krm_1323_05">↑</a> [[१। शतरि क्र्यादित्वात् श्नाप्रत्यये, ‘प्वादीनां ह्रस्वः’ (७-३-८०) इति ह्रस्वे, ‘श्नाभ्यस्तयोरातः’ (६-४-११२) इत्याकारलोपे णत्वे च रूपमेवम्।]]</li> <li id="foot_krm_1323_06"><a href="#ref_krm_1323_06">↑</a> [[२। धातोरुत्वे रपरत्वे ‘ल्वादिभ्यः’ (८-२-४४) इति निष्ठानत्वे, दीर्घे णत्वे च रूपमेवम्।]]</li> <li id="foot_krm_1323_07"><a href="#ref_krm_1323_07">↑</a> [[३। ‘ऋल्वादिभ्यः क्तिन् निष्ठावद् वाच्यः’ (वा। ८-२-४४) इति क्तिनस्तकारस्य नत्वे उत्वादिके च रूपमेवम्।]]</li></ul></p>

मेङ्|मायकः-यिका|मापकः-पिका|मित्सकः-त्सिका|मेमीयकः-यिका|माता-|मात्री|माययिता-त्री|मित्सिता-त्री|मेमीयिता-त्री
<ul><li><sup id="ref_krm_1324_01"><a href="#foot_krm_1324_01">1</a></sup> {@“मेङ् प्रणिदाने”@} <sup id="ref_krm_1324_02"><a href="#foot_krm_1324_02">2</a></sup> ‘मिमीते मायते माने, माति तत्रैव शब्लुकि। </li> <li>मयते प्रणिदानेऽर्थे…।।’ <sup id="ref_krm_1324_03"><a href="#foot_krm_1324_03">3</a></sup> इति देवः। </li> <li>“प्रणिदानम् = विनिमयः। </li> <li>‘प्रत्यर्पणम्’ इत्यपरे।” इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>“--प्रतिदाने-इति काशकृत्स्नः। </li> <li>तथैव कातन्त्रे, चान्द्रे च। </li> <li>‘प्रणिधाने’ इति पाठान्तरम्।” इति क्षी। </li> <li>टीका। </li> <li>मायकः-यिका, मापकः-पिका, मित्सकः-त्सिका, मेमीयकः-यिका;</li> <li>  माता- मात्री, माययिता-त्री, मित्सिता-त्री, मेमीयिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि आदादिकमातिवत् <sup id="ref_krm_1324_04"><a href="#foot_krm_1324_04">4</a></sup> ज्ञेयानि। </li> <li>शानचि- <sup id="ref_krm_1324_05"><a href="#foot_krm_1324_05">5</a></sup> मयमानः- प्रणिप्रयमानः, <sup id="ref_krm_1324_06"><a href="#foot_krm_1324_06">6</a></sup> अपमित्य, <sup id="ref_krm_1324_07"><a href="#foot_krm_1324_07">7</a></sup> अपमाय वा याचते। </li> <li>याचित्वा अपमयते। </li> <li><sup id="ref_krm_1324_08"><a href="#foot_krm_1324_08">8</a></sup> <sup id="ref_krm_1324_09"><a href="#foot_krm_1324_09">9</a></sup> धान्यमायः, इतीमानि रूपाण्यस्माद् भवन्तीति ज्ञेयम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1324_01"><a href="#ref_krm_1324_01">↑</a> (१३१४)</li> <li id="foot_krm_1324_02"><a href="#ref_krm_1324_02">↑</a> (१-भ्वादिः-९६१। सक। अनि। आत्म।)</li> <li id="foot_krm_1324_03"><a href="#ref_krm_1324_03">↑</a> (श्लो। ९)</li> <li id="foot_krm_1324_04"><a href="#ref_krm_1324_04">↑</a> (१२४०)</li> <li id="foot_krm_1324_05"><a href="#ref_krm_1324_05">↑</a> [[४। शानचि, शपि अयादेशे च रूपमेवम्। ‘--अशिति’ (६-१-४५) इत्युक्तत्वात् आत्वं नेति ज्ञेयम्। प्रणिमयमानः इत्यत्र ‘नेर्गदनदपतपदघुमा--’ (८-४-१७) इत्यादिना नेर्णत्वम्।]]</li> <li id="foot_krm_1324_06"><a href="#ref_krm_1324_06">↑</a> [[५। अपपूर्वकादस्मात्, ‘उदीचां माङो व्यतीहारे’ (३-४-१९) इति क्त्वाप्रत्यये, तस्य सामासिके ल्यपि, ‘मयतेरिदन्यतरस्याम्’ (६-४-७०) इति इकारेऽन्तादेशे च अपमित्य इति रूपम्। पक्षे अपमाय इति च। अपूर्वकालार्थं वचनमिदम्। अत्र (३-४-१९) ‘उदीचाम्’ इत्युक्तत्वात्, प्राचां मते तु ‘याचित्वाऽपमयते’ इत्यपि प्रयोगः साधुः। ‘उदीचाम्--’ (३-४-१९) इति सूत्रे ‘माङ्’ इति, मेङः कृतात्वस्य निर्देश इति ‘दाधा ध्वदाप्’ (१-१-२०) सूत्रे भाष्ये स्पष्टम्।]]</li> <li id="foot_krm_1324_07"><a href="#ref_krm_1324_07">↑</a> [[आ। ‘अपमित्य तपोवित्तैरस्या भागं भगीरथः।’ सुभद्राहरणे।]]</li> <li id="foot_krm_1324_08"><a href="#ref_krm_1324_08">↑</a> [पृष्ठम्१०५७+ २८]</li> <li id="foot_krm_1324_09"><a href="#ref_krm_1324_09">↑</a> [[१। कर्मणि उपपदे आदन्तलक्षणं कप्रत्ययं बाधित्वा, ‘ह्वावामश्च’ (३-२-२) इत्यण्। आत्वे कृते, ‘आतो युक् चिण्कृतोः’ (७-३-३३) इति युगागमः।]]</li></ul></p>

मेदृ|मेदकः-दिका|मिमेदिषकः-षिका|मेमेदकः-दिका|मेदिता-त्री|मेदयिता-त्री|मिमेदिषिता-त्री|मेमेदिता-त्री
<ul><li><sup id="ref_krm_1325_01"><a href="#foot_krm_1325_01">1</a></sup> {@“मेदृ मेधाहिंसनयोः”@} <sup id="ref_krm_1325_02"><a href="#foot_krm_1325_02">2</a></sup> ‘ऋदितो मेदते मेदेन्मेधाहिंसनयोर्द्वयोः।।’ <sup id="ref_krm_1325_03"><a href="#foot_krm_1325_03">3</a></sup> इति देवः। </li> <li>क्षीरस्वामी ‘मेथृ--’ इति पपाठ। </li> <li>मेदकः-दिका, मेदकः-दिका, मिमेदिषकः-षिका, मेमेदकः-दिका;</li> <li>  मेदिता-त्री, मेदयिता-त्री, मिमेदिषिता-त्री, मेमेदिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककेपतिवत् <sup id="ref_krm_1325_04"><a href="#foot_krm_1325_04">4</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1325_01"><a href="#ref_krm_1325_01">↑</a> (१३१५)</li> <li id="foot_krm_1325_02"><a href="#ref_krm_1325_02">↑</a> (१-भ्वादिः-८६९। सक। सेट्। उभ।)</li> <li id="foot_krm_1325_03"><a href="#ref_krm_1325_03">↑</a> (श्लो। १०४)</li> <li id="foot_krm_1325_04"><a href="#ref_krm_1325_04">↑</a> (२६१)</li></ul></p>

मेधृ|मेधकः-धिका|मिमेधिषकः-षिका|मेमेधकः-धिका|मेधिता-त्री|मेधयिता-त्री|मिमेधिषिता-त्री|मेमेधिता-त्री
<ul><li><sup id="ref_krm_1326_01"><a href="#foot_krm_1326_01">1</a></sup> {@“मेधृ सङ्गमे च”@} <sup id="ref_krm_1326_02"><a href="#foot_krm_1326_02">2</a></sup> अत्र चकारात् धातुपाठे पूर्वधातुगतं मेधाहिंसनरूपमर्थद्वयं विवक्षितम्। </li> <li>भोजराजस्तु ‘यतोऽङ्विधौ मेधाशब्दसाधनार्थं मिधृधातोर्गुणं विधत्ते’ तेन ज्ञायते--नास्यायं धातुः संमत इति। </li> <li>कौमाराश्चात्रैवानुकूलाः। </li> <li>स्पष्टमिदं प्रकृतस्थले मा। </li> <li>धा। </li> <li>वृत्तौ। </li> <li>मेधकः-धिका, मेधकः-धिका, मिमेधिषकः-षिका, मेमेधकः-धिका;</li> <li>  मेधिता-त्री, मेधयिता-त्री, मिमेधिषिता-त्री, मेमेधिता-त्री;</li> <li>  इत्यादीनि समस्तान्यपि रूपाणि भौवादिककेपतिवत् <sup id="ref_krm_1326_03"><a href="#foot_krm_1326_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1326_04"><a href="#foot_krm_1326_04">4</a></sup> मेवा, <sup id="ref_krm_1326_05"><a href="#foot_krm_1326_05">5</a></sup> गृहमेधी, <sup id="ref_krm_1326_06"><a href="#foot_krm_1326_06">6</a></sup> अश्वमेधः, <sup id="ref_krm_1326_07"><a href="#foot_krm_1326_07">7</a></sup> मेधिः, <sup id="ref_krm_1326_08"><a href="#foot_krm_1326_08">8</a></sup> मेध्यः-<sup id="ref_krm_1326_09"><a href="#foot_krm_1326_09">9</a></sup>, <sup id="ref_krm_1326_10"><a href="#foot_krm_1326_10">10</a></sup> प्रमेधितः इतीमानि धातोरस्य विशेषरूपाणीति ज्ञेयम्। </li> <li><sup id="ref_krm_1326_11"><a href="#foot_krm_1326_11">11</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1326_01"><a href="#ref_krm_1326_01">↑</a> (१३१६)</li> <li id="foot_krm_1326_02"><a href="#ref_krm_1326_02">↑</a> (१-भ्वादिः-८७०। सक। सेट्। उभ।)</li> <li id="foot_krm_1326_03"><a href="#ref_krm_1326_03">↑</a> (२६१)</li> <li id="foot_krm_1326_04"><a href="#ref_krm_1326_04">↑</a> [[२। ‘गुरोश्च हलः’ (३-३-१०३) इति स्त्रियां भावादौ अकारः। मेधा = बुद्धिः।]]</li> <li id="foot_krm_1326_05"><a href="#ref_krm_1326_05">↑</a> [[३। गृहान् = दारान् मेधति = सङ्गच्छत इति गृहमेधी = गृहस्थः। ‘सुप्यजातौ--’ (३-२-७८) इति ताच्छील्ये णिनिप्रत्ययः।]]</li> <li id="foot_krm_1326_06"><a href="#ref_krm_1326_06">↑</a> [[४। अश्वं मेधयति = हिंसयतीत्यर्थे ण्यन्तात्, अन्तर्भावितण्यन्तात् शुद्धाद्वा धातोः ‘कर्मण्यण्’ (३-२-१) इत्यण्प्रत्यये रूपमेवम्। अश्वमेधः = तन्नामको यज्ञविशेषः। एवमेघ पुरुषमेधः इत्यत्रापि ज्ञेयम्। पितृमेधः इत्यत्र तु पितृभिः सह मेधः (मेधति = संगच्छते इत्यर्थे) इति पचाद्यजन्तेन समासो ज्ञेयः।]]</li> <li id="foot_krm_1326_07"><a href="#ref_krm_1326_07">↑</a> [[५। ‘इक् कृष्यादिभ्यः’ (वा। ३-३-१०८) इति भावे स्त्रियाम् इक्प्रत्यये रूपम्। मेधिः = पशूनां बन्धविशेषे साधनीभूतो रज्जुविशेषः।]]</li> <li id="foot_krm_1326_08"><a href="#ref_krm_1326_08">↑</a> [[६। कर्मणि ण्यत्प्रत्यये रूपमेवम्। मेध्यः = यज्ञार्ह इत्यर्थः।]]</li> <li id="foot_krm_1326_09"><a href="#ref_krm_1326_09">↑</a> (पशुः)</li> <li id="foot_krm_1326_10"><a href="#ref_krm_1326_10">↑</a> [[आ। ‘नित्यं प्रमोहामिदितोरुमेदैः प्रमेधिता सद्भिरनिद्यमानैः।’ धा। का। २। २६।]]</li> <li id="foot_krm_1326_11"><a href="#ref_krm_1326_11">↑</a> [पृष्ठम्१०५८+ २३]</li></ul></p>

मेपृ|मेपकः-पिका|मिमेपिषकः-षिका|मेमेपकः-पिका|मेपिता-त्री|मेपयिता-त्री|मिमेपिषिता-त्री|मेमेपिता-त्री
<ul><li><sup id="ref_krm_1327_01"><a href="#foot_krm_1327_01">1</a></sup> {@“मेपृ गतौ”@} <sup id="ref_krm_1327_02"><a href="#foot_krm_1327_02">2</a></sup> मेपकः-पिका, मेपकः-पिका, मिमेपिषकः-षिका, मेमेपकः-पिका;</li> <li>  मेपिता-त्री, मेपयिता-त्री, मिमेपिषिता-त्री, मेमेपिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककेपतिवत् <sup id="ref_krm_1327_03"><a href="#foot_krm_1327_03">3</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1327_01"><a href="#ref_krm_1327_01">↑</a> (१३१७)</li> <li id="foot_krm_1327_02"><a href="#ref_krm_1327_02">↑</a> (१-भ्वादिः-३७१। सक। सेट्। आत्म।)</li> <li id="foot_krm_1327_03"><a href="#ref_krm_1327_03">↑</a> (२६१)</li></ul></p>

मेवृ|मेवकः-विका|मिमेविषकः-षिका|मेमेवकः-विका|मेविता-त्री|मेवयिता-त्री|मिमेविषिता-त्री|मेमेविता-त्री
<ul><li><sup id="ref_krm_1328_01"><a href="#foot_krm_1328_01">1</a></sup> {@“मेवृ सेवने”@} <sup id="ref_krm_1328_02"><a href="#foot_krm_1328_02">2</a></sup> मा। </li> <li>धा। </li> <li>वृत्तौ तु मैत्रेयसम्मतपाठत्वेनायमुपात्तः। </li> <li>मेवकः-विका, मेवकः-विका, मिमेविषकः-षिका, मेमेवकः-विका;</li> <li>  मेविता-त्री, मेवयिता-त्री, मिमेविषिता-त्री, मेमेविता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकक्षेवतिवत् <sup id="ref_krm_1328_03"><a href="#foot_krm_1328_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1328_04"><a href="#foot_krm_1328_04">4</a></sup> मेवितम्-तः-तवान्, मेवमानः, मेवित्वा, इतीमान्यस्य विशेषरूपाणीति ज्ञेयम्। </li> <li><sup id="ref_krm_1328_05"><a href="#foot_krm_1328_05">5</a></sup> मेव्यम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1328_01"><a href="#ref_krm_1328_01">↑</a> (१३१८)</li> <li id="foot_krm_1328_02"><a href="#ref_krm_1328_02">↑</a> (१-भ्वादिः-५०५। सक। सेट्। आत्म।)</li> <li id="foot_krm_1328_03"><a href="#ref_krm_1328_03">↑</a> (३२०)</li> <li id="foot_krm_1328_04"><a href="#ref_krm_1328_04">↑</a> [[१। अस्य धातोः सेट्त्वात् निष्ठायामेवं रूपम्।]]</li> <li id="foot_krm_1328_05"><a href="#ref_krm_1328_05">↑</a> [[आ। ‘सेव्यं सतां शङ्करग्लेव्यमब्जभूर्गेव्यं सुरैः पेव्यममेव्यमुन्मदैः।’ धा। का। १-६५।]]</li></ul></p>

मोक्ष|मोक्षकः-क्षिका|मुमोक्षयिषकः-षिका|मोक्षयिता-त्री|मुमोक्षयिषिता-त्री
<ul><li><sup id="ref_krm_1329_01"><a href="#foot_krm_1329_01">1</a></sup> {@“मोक्ष असने”@} <sup id="ref_krm_1329_02"><a href="#foot_krm_1329_02">2</a></sup> सिद्धान्तकौमुद्यादिषु धातुरयं नोपात्तः। </li> <li>‘-- सहने’ इति पाठान्तरम्। </li> <li>मोक्षकः-क्षिका, मुमोक्षयिषकः-षिका;</li> <li>  मोक्षयिता-त्री, मुमोक्षयिषिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकपक्षयतिवत् <sup id="ref_krm_1329_03"><a href="#foot_krm_1329_03">3</a></sup> ज्ञेयानि। </li> <li>युचि-- <sup id="ref_krm_1329_04"><a href="#foot_krm_1329_04">4</a></sup> मोक्षणा।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1329_01"><a href="#ref_krm_1329_01">↑</a> (१३१९)</li> <li id="foot_krm_1329_02"><a href="#ref_krm_1329_02">↑</a> (१०-चुरादिः-सक। सेट्। उभ।)</li> <li id="foot_krm_1329_03"><a href="#ref_krm_1329_03">↑</a> (९५६)</li> <li id="foot_krm_1329_04"><a href="#ref_krm_1329_04">↑</a> [[B। ‘उत्तंसभूषणविमोक्षणयाऽर्हिताभौ।’ धा। का। ३। ४०।]]</li></ul></p>

म्ना|म्नायकः-यिका|म्नापकः-पिका|मिम्नासकः-सिका|माम्नायकः-यिका|म्नाता-त्री|म्नापयिता-त्री
<ul><li><sup id="ref_krm_1330_01"><a href="#foot_krm_1330_01">1</a></sup> {@“म्ना अभ्यासे”@} <sup id="ref_krm_1330_02"><a href="#foot_krm_1330_02">2</a></sup> प्रायेणायमाङ्पूर्वक एव प्रयुज्यते। </li> <li>‘अभ्यासः = पारम्पर्येण वृत्तिः।’ इति क्षीरस्वामी। </li> <li>म्नायकः-यिका, म्नापकः-पिका, मिम्नासकः-सिका, माम्नायकः-यिका;</li> <li>  म्नाता-त्री;</li> <li>  म्नापयिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि प्रातिस्विकरूपाणि <sup id="ref_krm_1330_03"><a href="#foot_krm_1330_03">3</a></sup> विना भौवादिकधमतिवत् <sup id="ref_krm_1330_04"><a href="#foot_krm_1330_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1330_05"><a href="#foot_krm_1330_05">5</a></sup> आमनन्-ती, <sup id="ref_krm_1330_06"><a href="#foot_krm_1330_06">6</a></sup> व्यत्यामनमानः, <sup id="ref_krm_1330_07"><a href="#foot_krm_1330_07">7</a></sup> निम्नम्, <sup id="ref_krm_1330_08"><a href="#foot_krm_1330_08">8</a></sup> द्युम्नम्, <sup id="ref_krm_1330_09"><a href="#foot_krm_1330_09">9</a></sup> सुम्नम्, <sup id="ref_krm_1330_10"><a href="#foot_krm_1330_10">10</a></sup> आम्नायः इतीमानि रूपाण्यस्येति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1330_01"><a href="#ref_krm_1330_01">↑</a> (१३२०)</li> <li id="foot_krm_1330_02"><a href="#ref_krm_1330_02">↑</a> (१-भ्वादिः-९२९। अक। अनि। पर।)</li> <li id="foot_krm_1330_03"><a href="#ref_krm_1330_03">↑</a> [पृष्ठम्१०५९+ २९]</li> <li id="foot_krm_1330_04"><a href="#ref_krm_1330_04">↑</a> (९२४)</li> <li id="foot_krm_1330_05"><a href="#ref_krm_1330_05">↑</a> [[१। शतरि, शपि ‘पाघ्राध्मास्थाम्नादाण्दृश्यर्तिसर्तिशदसदां पिबजिघ्रधमतिष्ठमन--’ (७-३-७८) इत्यादिनाऽस्य मनादेशे पररूपे च रूपमेवम्।]]</li> <li id="foot_krm_1330_06"><a href="#ref_krm_1330_06">↑</a> [[२। ‘कर्तरि कर्मव्यतीहारे’ (१-३-१४) इति शानचि, शपि मनादेशे रूपमेवम्।]]</li> <li id="foot_krm_1330_07"><a href="#ref_krm_1330_07">↑</a> [[३। नीचभावमभ्यस्तीति निम्नम्। ‘सुपि--’ (३-२-४) इति योगविभागात्, ‘आतश्चोपसर्गे’ (३-१-१३६) इति वा कप्रत्यये, ‘आतो लोप इटि च’ (६-४-६४) इत्याकारलोपे च रूपमेवम्। अत्र धातुवृत्तौ तु --“ --‘आतोऽनुपसर्गे कः’ (३-२-३) इति वा कः। नेर्नीचभाववचनत्वेन मन्य (न?) त्यर्थस्याविशेषणान्न तं प्रतीहोपसर्गत्वम्।” इत्युक्तम्। तदिहावधेयम्।]]</li> <li id="foot_krm_1330_08"><a href="#ref_krm_1330_08">↑</a> [[४। दिने आम्नायते इति द्युम्नम्। द्युशब्दो दिनवचनः। अत्रापि कप्रत्यये रूपम्।]]</li> <li id="foot_krm_1330_09"><a href="#ref_krm_1330_09">↑</a> [[५। सुतरामाम्नायते इति सुम्नम् = सुखम्। ‘घञर्थे कविधानम्--’ (वा। ३-३-५८) इति घञर्थे कप्रत्यये रूपम्।]]</li> <li id="foot_krm_1330_10"><a href="#ref_krm_1330_10">↑</a> [[६। आ = समन्तात् म्नायते इति आम्नायः = वेदः। घञि ‘आतो युक्--’ (७-३-३३) इति युगागमे च रूपमेवम्।]]</li></ul></p>

म्रक्ष|म्रक्षकः-क्षिका|मिम्रक्षयिषकः-षिका|म्रक्षयिता-त्री|मिम्रक्षयिषिता-त्री
<ul><li><sup id="ref_krm_1331_01"><a href="#foot_krm_1331_01">1</a></sup> {@“म्रक्ष म्लेच्छने”@} <sup id="ref_krm_1331_02"><a href="#foot_krm_1331_02">2</a></sup> ‘म्लेच्छनम् = अपशब्दनम्।’ इति धातुवृत्तिः। </li> <li>‘म्रक्ष रोषे’ इति चान्द्रसम्मतः पाठ इति क्षीरतरङ्गिणीतो ज्ञायते। </li> <li>‘म्रक्ष च्छेदने’ इत्यपि क्वचित्पठ्यते--इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>‘म्लेच्छने म्रक्षयेत्, <sup id="ref_krm_1331_03"><a href="#foot_krm_1331_03">3</a></sup> म्रक्षेत् संघाते--।।’ <sup id="ref_krm_1331_04"><a href="#foot_krm_1331_04">4</a></sup> इति देवः। </li> <li>म्रक्षकः-क्षिका, मिम्रक्षयिषकः-षिका;</li> <li>  म्रक्षयिता-त्री, मिम्रक्षयिषिता-त्री;</li> <li>  इत्यादीनि समस्तान्यपि रूपाणि चौरादिकपक्षयतिवत् <sup id="ref_krm_1331_05"><a href="#foot_krm_1331_05">5</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1331_06"><a href="#foot_krm_1331_06">6</a></sup> अनयम्रक् <sup id="ref_krm_1331_07"><a href="#foot_krm_1331_07">7</a></sup> -म्रक्षौ-म्रक्षः। </li> <li><sup id="ref_krm_1331_08"><a href="#foot_krm_1331_08">8</a></sup> <sup id="ref_krm_1331_09"><a href="#foot_krm_1331_09">9</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1331_01"><a href="#ref_krm_1331_01">↑</a> (१३२१)</li> <li id="foot_krm_1331_02"><a href="#ref_krm_1331_02">↑</a> (१०-चुरादिः-१६६२। अक। सेट्। उभ।)</li> <li id="foot_krm_1331_03"><a href="#ref_krm_1331_03">↑</a> [[७। देवश्लोकदर्शनेनास्य भ्वादिषु ‘म्रक्ष संघाते’ इति पाठः संमत इति ज्ञायते। परं तु सर्वत्र धातुपाठेषु भ्वादिष्वस्य मृक्ष इत्येव पाठ उपलभ्यते। मा। धा। वृत्तौ तु चुरादिषु म्रक्षधातुप्रस्तावे ‘म्रक्षति इति संघाते शपि।’ इत्युक्तम्। धातुवृत्तावेव भ्वादिषु म्रक्ष इत्येव पाठो दृश्यते। ईदृशेषु स्थलेषु कतमः पाठः सर्वसम्मत इति दुर्निरूपं भवति।]]</li> <li id="foot_krm_1331_04"><a href="#ref_krm_1331_04">↑</a> (श्लो। १७१)</li> <li id="foot_krm_1331_05"><a href="#ref_krm_1331_05">↑</a> (९५६)</li> <li id="foot_krm_1331_06"><a href="#ref_krm_1331_06">↑</a> [[८। क्विपि संयोगान्तलोपे रूपमेवम्।]]</li> <li id="foot_krm_1331_07"><a href="#ref_krm_1331_07">↑</a> [[B। ‘धर्मेतरम्यग् अनयम्रगयं हि राजा।’ धा। का। ३-३०।]]</li> <li id="foot_krm_1331_08"><a href="#ref_krm_1331_08">↑</a> [[आ। ‘सोऽजुहोत् कृष्णवर्त्मानम् आमनन् मन्त्रमुत्तमम्।।’ भ। का। १७। ३०। ]]</li> <li id="foot_krm_1331_09"><a href="#ref_krm_1331_09">↑</a> [पृष्ठम्१०६०+ २६]</li></ul></p>

म्रद|म्रादकः-दिका|म्रदकः-दिका|मिम्रदिषकः-षिका|माम्रदकः-दिका|म्रदिता-त्री|म्रादयिता-त्री|मिम्रदिषिता-त्री|माम्रदिता-त्री
<ul><li><sup id="ref_krm_1332_01"><a href="#foot_krm_1332_01">1</a></sup> {@“म्रद मर्दने”@} <sup id="ref_krm_1332_02"><a href="#foot_krm_1332_02">2</a></sup> घटादिः, षिच्च। </li> <li>‘मृद--’ इति बालमनोरमापाठः। </li> <li>स च ‘अत् स्मृदॄत्वरप्रथम्रद--’ <sup id="ref_krm_1332_03"><a href="#foot_krm_1332_03">3</a></sup> इति सूत्रे म्रद इत्यनेनास्यैव ग्रहणस्य सर्वैरप्युक्तत्वात् चिन्त्यः। </li> <li>म्रादकः-दिका, म्रदकः-दिका, मिम्रदिषकः-षिका, माम्रदकः-दिका;</li> <li>  म्रदिता-त्री, म्रादयिता-त्री, मिम्रदिषिता-त्री, माम्रदिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकक्रपतिवत् <sup id="ref_krm_1332_04"><a href="#foot_krm_1332_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1332_05"><a href="#foot_krm_1332_05">5</a></sup> मृदुः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1332_01"><a href="#ref_krm_1332_01">↑</a> (१३२२)</li> <li id="foot_krm_1332_02"><a href="#ref_krm_1332_02">↑</a> (१-भ्वादिः-७६७। सक। सेट्। आत्म।)</li> <li id="foot_krm_1332_03"><a href="#ref_krm_1332_03">↑</a> (७-४-९५)</li> <li id="foot_krm_1332_04"><a href="#ref_krm_1332_04">↑</a> (२७२)</li> <li id="foot_krm_1332_05"><a href="#ref_krm_1332_05">↑</a> [[१। ‘प्रथिम्रदि--’ (द। उ। १। ११३) इति कुप्रत्ययः, सम्प्रसारणं च। म्रद्यते ऽसाबिति मृदुः = अकठिनः।]]</li></ul></p>

म्रुचु|म्रोचकः-चिका|मुम्रोचिषकः-मुम्रुचिषकः-षिका|मोम्रुचकः-चिका|म्रोचिता-त्री|म्रोचयिता-त्री|मुम्रोचिषिता-मुम्रुचिषिता-त्री|मोम्रुचिता-त्री
<ul><li><sup id="ref_krm_1333_01"><a href="#foot_krm_1333_01">1</a></sup> {@“म्रुचु गत्यर्थः”@} <sup id="ref_krm_1333_02"><a href="#foot_krm_1333_02">2</a></sup> म्रोचकः-चिका, म्रोचकः-चिका, मुम्रोचिषकः-मुम्रुचिषकः-षिका, मोम्रुचकः-चिका;</li> <li>  म्रोचिता-त्री, म्रोचयिता-त्री, मुम्रोचिषिता-मुम्रुचिषिता-त्री, मोम्रुचिता-त्री;</li> <li>  इत्यादिकानि समस्तान्यपि रूपाणि भौवादिकग्रोचतिवत् <sup id="ref_krm_1333_03"><a href="#foot_krm_1333_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1333_04"><a href="#foot_krm_1333_04">4</a></sup> म्रुक्तः-म्रुक्तवान्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1333_01"><a href="#ref_krm_1333_01">↑</a> (१३२३)</li> <li id="foot_krm_1333_02"><a href="#ref_krm_1333_02">↑</a> (१-भ्वादिः-१९५। सक। सेट्। पर।)</li> <li id="foot_krm_1333_03"><a href="#ref_krm_1333_03">↑</a> (४४३)</li> <li id="foot_krm_1333_04"><a href="#ref_krm_1333_04">↑</a> [[२। उदित्त्वेन क्त्वायामिड्विकल्पनात् निष्ठायाम्, ‘यस्य विभाषा’ (७-२-१५) इती- ण्निषेधः। माधवधातुवृत्तौ तु “भावादिकर्मणोः ‘उदुपधात्--’ (१-२-२१) इति कित्त्वविकल्पनात् ‘म्रुचितमनेन म्रोचितमनेन’ इत्यादि।” इत्युक्तम्। अत्र, ‘निषेधाश्च बलीयांसः’ (परि। १२२) इति न्यायेन, पुरस्तादि- ण्निषेधकाण्डारम्भसामर्थ्यात्, ‘उदुपधात्--’ (१-२-२१) इति सूत्रे उदिद्भिन्न- स्योदुपधस्य धातोरेव सर्वैरपि व्याख्यातृभिः उदाहरणप्रत्युदाहरणसमये उपादानाच्च, अत्रापि इण्निषेध एव भावादिकर्मणोः निष्ठायां प्रामाणिक इति प्रतिभाति।]]</li></ul></p>

म्रुन्चु|म्रुञ्चकः-ञ्चिका|मुम्रुञ्चिषकः-षिका|मोम्रुचकः-चिका|म्रुञ्चिता-त्री|म्रुञ्चयिता-त्री|मुम्रुञ्चिषिता-त्री|मोम्रुचिता-त्री
<ul><li><sup id="ref_krm_1334_01"><a href="#foot_krm_1334_01">1</a></sup> {@“म्रुन्चु गत्यर्थः”@} <sup id="ref_krm_1334_02"><a href="#foot_krm_1334_02">2</a></sup> अयं नोपधः, सन्धिवशाञ्ञकार इति ज्ञेयम्। </li> <li>म्रुञ्चकः-ञ्चिका, म्रुञ्चकः-ञ्चिका, मुम्रुञ्चिषकः-षिका, मोम्रुचकः-चिका;</li> <li>  म्रुञ्चिता-त्री, म्रुञ्चयिता-त्री, मुम्रुञ्चिषिता-त्री, मोम्रुचिता-त्री;</li> <li>  इत्यादिकानि समस्तान्यपि रूपाणि भौवादिकग्लुञ्चतिवत् <sup id="ref_krm_1334_03"><a href="#foot_krm_1334_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1334_04"><a href="#foot_krm_1334_04">4</a></sup> म्रुक्तम्। </li> <li><sup id="ref_krm_1334_05"><a href="#foot_krm_1334_05">5</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1334_01"><a href="#ref_krm_1334_01">↑</a> (१३२४)</li> <li id="foot_krm_1334_02"><a href="#ref_krm_1334_02">↑</a> (१-भ्वादिः-१९३। सक। सेट्। पर।)</li> <li id="foot_krm_1334_03"><a href="#ref_krm_1334_03">↑</a> (४४७)</li> <li id="foot_krm_1334_04"><a href="#ref_krm_1334_04">↑</a> [[आ। ‘आवक्रचञ्चूपुटतञ्चदारबत्वञ्चत्खगम्रुक्तशिखैर्लताद्रुमैः।’ धा। का। १-२६।]]</li> <li id="foot_krm_1334_05"><a href="#ref_krm_1334_05">↑</a> [पृष्ठम्१०६१+ २५]</li></ul></p>

म्रेट्ट|म्रेटकः-टिका|मिम्रेटिषकः-षिका|मेम्रेटकः-टिका|म्रेटिता-त्री|म्रेटयिता-त्री|मिम्रेटिषिता-त्री|मेम्रेटिता-त्री
<ul><li><sup id="ref_krm_1335_01"><a href="#foot_krm_1335_01">1</a></sup> {@“म्रेट्ट उन्मादे”@} <sup id="ref_krm_1335_02"><a href="#foot_krm_1335_02">2</a></sup> सिद्धान्तकौमुद्याद्यनुपात्तत्वेऽपि प्राचीनैः मैत्रेय-क्षीरस्वामी-सायण- प्रभृतिभिरुपात्तत्वादयं धातुरस्माभिरप्यत्र विलिख्यते। </li> <li>‘मेटृ--’ इति दुर्ग- नारायणभट्टादिसंमतः पाठः। </li> <li>म्रेटकः-टिका, म्रेटकः-टिका, मिम्रेटिषकः-षिका, मेम्रेटकः-टिका;</li> <li>  म्रेटिता-त्री, म्रेटयिता-त्री, मिम्रेटिषिता-त्री, मेम्रेटिता-त्री;</li> <li>  इत्यादिकानि सर्वाणि रूपाणि भौवादिककेपतिवत् <sup id="ref_krm_1335_03"><a href="#foot_krm_1335_03">3</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1335_01"><a href="#ref_krm_1335_01">↑</a> (१३२५)</li> <li id="foot_krm_1335_02"><a href="#ref_krm_1335_02">↑</a> (१-भ्वादिः-अक। सेट्। पर।)</li> <li id="foot_krm_1335_03"><a href="#ref_krm_1335_03">↑</a> (२६१)</li></ul></p>

म्रेडृ|म्रेडकः-डिका|मिम्रेडिषकः-षिका|मेम्रेडकः-डिका|म्रेडिता-त्री|म्रेडयिता-त्री|मिम्रेडिषिता-त्री|मेम्रेडिता-त्री
<ul><li><sup id="ref_krm_1336_01"><a href="#foot_krm_1336_01">1</a></sup> {@“म्रेडृ उन्मादे”@} <sup id="ref_krm_1336_02"><a href="#foot_krm_1336_02">2</a></sup> ‘मेडृ--’ इति काशकृत्स्नसम्मतः पाठः। </li> <li>म्रेडकः-डिका, म्रेडकः-डिका, मिम्रेडिषकः-षिका, मेम्रेडकः-डिका;</li> <li>  म्रेडिता-त्री, म्रेडयिता-त्री, मिम्रेडिषिता-त्री, मेम्रेडिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककेपतिवत् <sup id="ref_krm_1336_03"><a href="#foot_krm_1336_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1336_04"><a href="#foot_krm_1336_04">4</a></sup> आम्रेडितम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1336_01"><a href="#ref_krm_1336_01">↑</a> (१३२६)</li> <li id="foot_krm_1336_02"><a href="#ref_krm_1336_02">↑</a> (१-भ्वादिः-२९३। अक। सेट्। पर।)</li> <li id="foot_krm_1336_03"><a href="#ref_krm_1336_03">↑</a> (२६१)</li> <li id="foot_krm_1336_04"><a href="#ref_krm_1336_04">↑</a> [[आ। ‘प्रशौटदुस्रागणयौटितान्तिकान् मेटद्वृषाम्रेडितघोषमेदुरान्।’ धा। का। १-३९।]]</li></ul></p>

म्लुचु|म्लोचकः-चिका|मुम्लोचिषकः-मुम्लुचिषकः-षिका|मोम्लुचकः-चिका|म्लोचिता-त्री|म्लोचयिता-त्री|मुम्लोचिषिता-|मुम्लुचिषिता-त्री|मोम्लुचिता-त्री
<ul><li><sup id="ref_krm_1337_01"><a href="#foot_krm_1337_01">1</a></sup> {@“म्लुचु गत्यर्थः”@} <sup id="ref_krm_1337_02"><a href="#foot_krm_1337_02">2</a></sup> म्लोचकः-चिका, म्लोचकः-चिका, मुम्लोचिषकः-मुम्लुचिषकः-षिका, मोम्लुचकः-चिका;</li> <li>  म्लोचिता-त्री, म्लोचयिता-त्री, मुम्लोचिषिता- मुम्लुचिषिता-त्री, मोम्लुचिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिक- ग्रोचतिवत् <sup id="ref_krm_1337_03"><a href="#foot_krm_1337_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1337_04"><a href="#foot_krm_1337_04">4</a></sup> मलिम्लुचः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1337_01"><a href="#ref_krm_1337_01">↑</a> (१३२७)</li> <li id="foot_krm_1337_02"><a href="#ref_krm_1337_02">↑</a> (१-भ्वादिः-१९६। सक। सेट्। पर।)</li> <li id="foot_krm_1337_03"><a href="#ref_krm_1337_03">↑</a> (४४३)</li> <li id="foot_krm_1337_04"><a href="#ref_krm_1337_04">↑</a> [[१। ‘कप्रकरणे मूलविभुजादिभ्यः--’ (वा। ३-२-५) इति कप्रत्यये रूपमेवम्। ‘मलिम्लुच’ शब्दव्युत्पादनाऽवसरे अमरसुधायां ‘म्लुच स्तेये’ (भ्वा। से। पर।) इति कश्चन धातुः उपात्तः। परन्तु धातुपाठकोशेषु कुत्रापि स नोपलभ्यते।]]</li></ul></p>

म्लुन्चु|म्लुञ्चकः-ञ्चिका|मुम्लुञ्चिषकः-षिका|मोम्लुचकः-चिका|म्लुञ्चिता-त्री|म्लुञ्चयिता-त्री|मुम्लुञ्चिषिता-त्री|मोम्लुचिता-त्री
<ul><li><sup id="ref_krm_1338_01"><a href="#foot_krm_1338_01">1</a></sup> {@“म्लुन्चु गत्यर्थः”@} <sup id="ref_krm_1338_02"><a href="#foot_krm_1338_02">2</a></sup> म्लुञ्चकः-ञ्चिका, म्लुञ्चकः-ञ्चिका, मुम्लुञ्चिषकः-षिका, मोम्लुचकः-चिका;</li> <li>  म्लुञ्चिता-त्री, म्लुञ्चयिता-त्री, मुम्लुञ्चिषिता-त्री, मोम्लुचिता-त्री;</li> <li>  इत्यादीनि <sup id="ref_krm_1338_03"><a href="#foot_krm_1338_03">3</a></sup> सर्वाण्यपि रूपाणि भौवादिकग्लुञ्चतिवत् <sup id="ref_krm_1338_04"><a href="#foot_krm_1338_04">4</a></sup> ज्ञेयानि। </li> <li>कर्तरि क्तप्रत्यये <sup id="ref_krm_1338_05"><a href="#foot_krm_1338_05">5</a></sup> म्लुक्तः <sup id="ref_krm_1338_06"><a href="#foot_krm_1338_06">6</a></sup> इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1338_01"><a href="#ref_krm_1338_01">↑</a> (१३२८)</li> <li id="foot_krm_1338_02"><a href="#ref_krm_1338_02">↑</a> (१-भ्वादिः-१९४। सक। सेट्। पर।)</li> <li id="foot_krm_1338_03"><a href="#ref_krm_1338_03">↑</a> [पृष्ठम्१०६२+ २७]</li> <li id="foot_krm_1338_04"><a href="#ref_krm_1338_04">↑</a> (४४७)</li> <li id="foot_krm_1338_05"><a href="#ref_krm_1338_05">↑</a> [[१। उदित्त्वेन क्त्वायामिड्विकल्पनात् निष्ठायाम्, ‘यस्य विभाषा’ (७-२-१५) इती- ण्निषेधः। उपधानकारलोपः।]]</li> <li id="foot_krm_1338_06"><a href="#ref_krm_1338_06">↑</a> [[आ। ‘अम्लुक्तरश्मौ शशिना निमुम्रुचे निमुम्लुचेऽर्केण च यत्र सन्ततम्।।’ धा। का। १। २६।]]</li></ul></p>

म्लेच्छ|म्लेच्छकः-च्छिका|मिम्लेच्छिषकः-षिका|मेम्लेच्छकः-|च्छिका|म्लेच्छिता-त्री|म्लेच्छयिता-त्री|मिम्लेच्छिषिता-त्री|मेम्लेच्छिता-त्री
<ul><li><sup id="ref_krm_1339_01"><a href="#foot_krm_1339_01">1</a></sup> {@“म्लेच्छ अव्यक्ते शब्दे”@} <sup id="ref_krm_1339_02"><a href="#foot_krm_1339_02">2</a></sup> ‘अव्यक्तायां वाचि’ इति क्षीरस्वामी। </li> <li><sup id="ref_krm_1339_03"><a href="#foot_krm_1339_03">3</a></sup> म्लेच्छकः-च्छिका, म्लेच्छकः-च्छिका, मिम्लेच्छिषकः-षिका, मेम्लेच्छकः- च्छिका;</li> <li>  म्लेच्छिता-त्री, म्लेच्छयिता-त्री, मिम्लेच्छिषिता-त्री, मेम्लेच्छिता-त्री;</li> <li>  इत्यादीनि समस्तान्यपि रूपाणि दैवादिकक्लिश्यतिवत् <sup id="ref_krm_1339_04"><a href="#foot_krm_1339_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1339_05"><a href="#foot_krm_1339_05">5</a></sup> म्लिष्टम्, शतरि-म्लेच्छन्-न्ती, क्विपि-- <sup id="ref_krm_1339_06"><a href="#foot_krm_1339_06">6</a></sup> म्लेट्-म्लेड्- म्लेडौ-म्लेडः, इति विशेषः। </li> <li><sup id="ref_krm_1339_07"><a href="#foot_krm_1339_07">7</a></sup> म्लेच्छितवै।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1339_01"><a href="#ref_krm_1339_01">↑</a> (१३२९)</li> <li id="foot_krm_1339_02"><a href="#ref_krm_1339_02">↑</a> (१-भ्वादिः-२०५। अक। सेट्। पर।)</li> <li id="foot_krm_1339_03"><a href="#ref_krm_1339_03">↑</a> [[२। धातुरयमुपदेशे म्लेछ इत्येव पठ्यते। पश्चात्, ‘दीर्घात्’ (६-१-७५) इति तुक्। तुकश्चुत्वेन चकारे सर्वत्र म्लेच्छ इति श्रूयते।]]</li> <li id="foot_krm_1339_04"><a href="#ref_krm_1339_04">↑</a> (२८७)</li> <li id="foot_krm_1339_05"><a href="#ref_krm_1339_05">↑</a> [[३। ‘क्षुब्धस्वान्तध्वान्तलग्नम्लिष्टविरिब्धफाण्टबाढानि मन्थमनस्तमःसक्ताविस्प- स्वरानायासभृशेषु’ (७-२-१८) इत्यादिना यथासम्भवमस्य निष्ठायाम्, अविस्पष्टार्थे इडभावो निपात्यते। षत्व-ष्टुत्वादिकेषु म्लिष्टम् इति भवति। अन्यत्र म्लेच्छितम् इत्यपि साधुः।]]</li> <li id="foot_krm_1339_06"><a href="#ref_krm_1339_06">↑</a> [[४। क्विपि, ‘च्छ्वोः शूडनुनासिके च’ (६-४-१९) इति सतुक्कस्य छकारस्य शकारे, षत्वे, जश्त्वचर्त्वयोश्च रूपमेवम्। “वृत्तिप्रदीपे तु वितुक्कस्य शादेश उक्तः, तुगभावस्तु ‘अकृतव्यूहाः पाणिनीयाः (परि ५७…) कृतमपि शास्त्रं निवर्तयन्तीति।” इति मा। धा। वृत्तौ अत्र पक्षभेदः प्रोक्त इहावधेयः।]]</li> <li id="foot_krm_1339_07"><a href="#ref_krm_1339_07">↑</a> [[५। ‘कृत्यार्थे तवैकेन्केन्यत्वनः’ (३-४-१४) इति च्छन्दसि विषये धातोरस्मात् तवैप्रत्यये इडागमे च रूपमेवम्। तथा च किञ्चित् श्रुतिवाक्यमुपात्तं महाभाष्ये (१-१-१) “तस्माद् ब्राह्मणेन न म्लेच्छितवै नापभाषितवै, म्लेच्छो ह वा एष यदपशब्दः।” इति।]]</li></ul></p>

म्लेच्छ|म्लेच्छकः-च्छिका|मिम्लेच्छयिषकः-षिका|म्लेच्छयिता-त्री|मिम्लेच्छयि-|षिता-त्री
<ul><li><sup id="ref_krm_1340_01"><a href="#foot_krm_1340_01">1</a></sup> {@“म्लेच्छ अव्यक्तायां वाचि”@} <sup id="ref_krm_1340_02"><a href="#foot_krm_1340_02">2</a></sup> <sup id="ref_krm_1340_03"><a href="#foot_krm_1340_03">3</a></sup> ‘इहाव्यक्तवागपशब्दनम्।’ इति माधवः। </li> <li>चान्द्रास्तु धातुममुमत्र <sup id="ref_krm_1340_04"><a href="#foot_krm_1340_04">4</a></sup> न पठन्तीति क्षीरतरङ्गिण्यां स्पष्टम्। </li> <li>म्लेच्छकः-च्छिका, मिम्लेच्छयिषकः-षिका;</li> <li>  म्लेच्छयिता-त्री, मिम्लेच्छयि- षिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकचित्रयतिवत् <sup id="ref_krm_1340_05"><a href="#foot_krm_1340_05">5</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1340_01"><a href="#ref_krm_1340_01">↑</a> (१३३०)</li> <li id="foot_krm_1340_02"><a href="#ref_krm_1340_02">↑</a> (१०-चुरादिः-१६६३। अक। सेट्। उभ।)</li> <li id="foot_krm_1340_03"><a href="#ref_krm_1340_03">↑</a> [पृष्ठम्१०६३+ २३]</li> <li id="foot_krm_1340_04"><a href="#ref_krm_1340_04">↑</a> (चुरादौ)</li> <li id="foot_krm_1340_05"><a href="#ref_krm_1340_05">↑</a> (५२५)</li></ul></p>

म्लेटृ|म्लेटकः-टिका|मिम्लेटिषकः-षिका|मेम्लेटकः-टिका|म्लेटिता-त्री|म्लेटयिता-त्री|मिम्लेटिषिता-त्री|मेम्लेटिता-त्री
<ul><li><sup id="ref_krm_1341_01"><a href="#foot_krm_1341_01">1</a></sup> {@“म्लेटृ उन्मादे”@} <sup id="ref_krm_1341_02"><a href="#foot_krm_1341_02">2</a></sup> ‘म्लेडृ--’ इति कुत्रचिद् दृष्टः पाठः। </li> <li>धातुवृत्तौ-- ‘म्रेटृ म्रेडृ म्लेटृ उन्मादे’ इत्युपादाय, ‘म्लेडति’ इत्युदाहृतम्। </li> <li>धातुवृत्तावेव प्राचीन- मुद्रणे ‘म्रेटृ--’ इति नोपात्तम्। </li> <li>म्लेटकः-टिका, म्लेटकः-टिका, मिम्लेटिषकः-षिका, मेम्लेटकः-टिका;</li> <li>  म्लेटिता-त्री, म्लेटयिता-त्री, मिम्लेटिषिता-त्री, मेम्लेटिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकगेपतिवत् <sup id="ref_krm_1341_03"><a href="#foot_krm_1341_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1341_04"><a href="#foot_krm_1341_04">4</a></sup> म्लेटकः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1341_01"><a href="#ref_krm_1341_01">↑</a> (१३३१)</li> <li id="foot_krm_1341_02"><a href="#ref_krm_1341_02">↑</a> (१-भ्वादिः-२९२। अक। सेट्। पर।)</li> <li id="foot_krm_1341_03"><a href="#ref_krm_1341_03">↑</a> (४२९)</li> <li id="foot_krm_1341_04"><a href="#ref_krm_1341_04">↑</a> [[आ। ‘अम्लेटकैश्चाकटुचाटुभाषितैरटैः पटत्सम्रटिताञ्जनोत्करैः।।’ धा। का। १-३९।]]</li></ul></p>

म्लेवृ|म्लेवकः-विका|मिम्लेविषकः-षिका|मेम्लेवकः-विका|म्लेविता-त्री|म्लेवयिता-त्री|मिम्लेविषिता-त्री|मेम्लेविता-त्री
<ul><li><sup id="ref_krm_1342_01"><a href="#foot_krm_1342_01">1</a></sup> {@“म्लेवृ सेवने”@} <sup id="ref_krm_1342_02"><a href="#foot_krm_1342_02">2</a></sup> म्लेवकः-विका, म्लेवकः-विका, मिम्लेविषकः-षिका, मेम्लेवकः-विका;</li> <li>  म्लेविता-त्री, म्लेवयिता-त्री, मिम्लेविषिता-त्री, मेम्लेविता-त्री;</li> <li>  इत्यादिकानि सर्वाण्यपि रूपाणि भौवादिकक्लेवतिवत् <sup id="ref_krm_1342_03"><a href="#foot_krm_1342_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1342_04"><a href="#foot_krm_1342_04">4</a></sup> म्लेवितम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1342_01"><a href="#ref_krm_1342_01">↑</a> (१३३२)</li> <li id="foot_krm_1342_02"><a href="#ref_krm_1342_02">↑</a> (१-भ्वादिः-५०६। सक। सेट्। आत्म।)</li> <li id="foot_krm_1342_03"><a href="#ref_krm_1342_03">↑</a> (२९१)</li> <li id="foot_krm_1342_04"><a href="#ref_krm_1342_04">↑</a> [[B। ‘प्रम्लेवितं रेवितवत्समण्डलीं मव्यद्भिराभीरजनैरसूर्क्ष्यकैः।।’ धा। का। १-६५।]]</li></ul></p>

म्लै|म्लायकः-यिका|म्लापकः-पिका|मिम्लासकः-सिका|माम्लायकः-यिका|म्लाता-त्री|म्लापयिता-त्री|मिम्लासिता-त्री|माम्लायिता-त्री
<ul><li><sup id="ref_krm_1343_01"><a href="#foot_krm_1343_01">1</a></sup> {@“म्लै हर्षक्षये”@} <sup id="ref_krm_1343_02"><a href="#foot_krm_1343_02">2</a></sup> “-- ‘गात्रविनामे’ विनामः = कान्तिक्षयः।” इति क्षीरस्वामी। </li> <li>‘हर्षक्षयः = धातुक्षयः।’ इति माधवः। </li> <li>म्लायकः-यिका, म्लापकः-पिका, मिम्लासकः-सिका, माम्लायकः-यिका;</li> <li>  म्लाता-त्री, म्लापयिता-त्री, मिम्लासिता-त्री, माम्लायिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकग्लायतिवत् <sup id="ref_krm_1343_03"><a href="#foot_krm_1343_03">3</a></sup> ज्ञेयानि। </li> <li>अस्य मित्संज्ञा- <sup id="ref_krm_1343_04"><a href="#foot_krm_1343_04">4</a></sup> विधानाभावात् मित्संज्ञाकार्यं नेति विशेषः। </li> <li>तेन ण्यन्ते म्लायकः-यिका, इत्यादिकानि एकविधान्येव रूपाणि। </li> <li><sup id="ref_krm_1343_05"><a href="#foot_krm_1343_05">5</a></sup> म्लानिः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1343_01"><a href="#ref_krm_1343_01">↑</a> (१३३३)</li> <li id="foot_krm_1343_02"><a href="#ref_krm_1343_02">↑</a> (१-भ्वादिः-९०४ अक। अनि। पर।)</li> <li id="foot_krm_1343_03"><a href="#ref_krm_1343_03">↑</a> (४५२)</li> <li id="foot_krm_1343_04"><a href="#ref_krm_1343_04">↑</a> [पृष्ठम्१०६४+ २७]</li> <li id="foot_krm_1343_05"><a href="#ref_krm_1343_05">↑</a> [[१। बाहुलकात् क्तिनस्तकारस्य नकारे रूपमेवम्।]]</li></ul></p>

यक्ष|“अत्रात्रेयः-|‘केचित्|रामायणे|यक्षशब्दस्य|भक्षणार्थत्वेन|व्युत्पाद-|नादन्तस्थादिमाहुः|इत्युक्तवान्।’|रामायणोक्तिस्तुइत्यस्यानेकार्थत्वाश्रयणेन|निर्वाह्या।”]]|यक्षकः-क्षिका|यियक्षयिषकः-षिका|यक्षयिता-त्री|यियक्षयिषिता-त्री
<ul><li><sup id="ref_krm_1344_01"><a href="#foot_krm_1344_01">1</a></sup> {@“यक्ष पूजायाम्”@} <sup id="ref_krm_1344_02"><a href="#foot_krm_1344_02">2</a></sup> आकुस्मीयः। </li> <li><sup id="ref_krm_1344_03"><a href="#foot_krm_1344_03">3</a></sup> “अत्रात्रेयः-- ‘केचित् रामायणे यक्षशब्दस्य भक्षणार्थत्वेन व्युत्पाद- नादन्तस्थादिमाहुः;</li> <li>  तच्चिन्त्यम्। </li> <li>इत्युक्तवान्।’ रामायणोक्तिस्तु ‘यक्ष पूजायाम्’ इत्यस्यानेकार्थत्वाश्रयणेन निर्वाह्या।” इति ‘जक्ष--’ धातौ <sup id="ref_krm_1344_04"><a href="#foot_krm_1344_04">4</a></sup> माधवोक्तमिहावधेयम्।]] यक्षकः-क्षिका, यियक्षयिषकः-षिका;</li> <li>  यक्षयिता-त्री, यियक्षयिषिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकपक्षयतिवत् <sup id="ref_krm_1344_05"><a href="#foot_krm_1344_05">5</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_1344_06"><a href="#foot_krm_1344_06">6</a></sup> यक्षः, यक्ष्मा <sup id="ref_krm_1344_07"><a href="#foot_krm_1344_07">7</a></sup>, <sup id="ref_krm_1344_08"><a href="#foot_krm_1344_08">8</a></sup> यक्ष्यम्, इमानि रूपाण्यधिकानीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1344_01"><a href="#ref_krm_1344_01">↑</a> (१३३४)</li> <li id="foot_krm_1344_02"><a href="#ref_krm_1344_02">↑</a> (१०-चुरादिः-१६९३। सक। सेट्। आत्म।)</li> <li id="foot_krm_1344_03"><a href="#ref_krm_1344_03">↑</a> [[[अ]</li> <li id="foot_krm_1344_04"><a href="#ref_krm_1344_04">↑</a> (अदादिषु)</li> <li id="foot_krm_1344_05"><a href="#ref_krm_1344_05">↑</a> (९५६)</li> <li id="foot_krm_1344_06"><a href="#ref_krm_1344_06">↑</a> [[२। ‘अकर्तरि च कारके संज्ञायाम्’ (३-३-१९) इति कर्मणि घञ्प्रत्यये रूपमेवम्। यक्ष्यतेऽसौ इति यक्षः।]]</li> <li id="foot_krm_1344_07"><a href="#ref_krm_1344_07">↑</a> [[३। ‘अर्तिस्तु…’ (द। उ। ७-२६।) इति मन्प्रत्यये रूपमेवम्। यक्ष्मा = व्याधिः।]]</li> <li id="foot_krm_1344_08"><a href="#ref_krm_1344_08">↑</a> [[आ। ‘… भ्रूणस्य शाठ्यजनयक्ष्यमवेक्ष्य गात्रम्।’ धा। का। ३-३५।]]</li></ul></p>

यज|याजकः-जिका|यियक्षकः-क्षिका|यायजकः-जिका|यष्टा-यष्ट्री|याजयिता-त्री|यियक्षिता-त्री|यायजिता-त्री|यजन्-न्ती|याजयन्-न्ती|यियक्षन्-न्ती|-|यक्ष्यन्-न्ती-ती|याजयिष्यन्-न्ती-ती|यियक्षिष्यन्-न्ती-ती|यजमानः|याजयमानः|यियक्षमाणः|यायज्यमानः|यक्ष्यमाणः|याजयिष्यमाणः|यियक्षिष्यमाणः|यायजिष्यमाणः|देवेट्-देवेड्-देवेजौ-देवेजः|-इष्टम्-इष्टः-इष्टवान्-इष्टी|याजितः|यियक्षितः|यायजितः-तवान्|यजः|सोमयाजी-हविर्याजी|अग्निष्टोमयाजी|यज्वा|ऋत्विक्|उपयट्|साधुयाजी|याजः|यियक्षुः|यायजूकः|यायजः|यष्टव्यम्|याजयितव्यम्|यियक्षितव्यम्|यायजितव्यम्|यजनीयम्|याजनीयम्|यियक्षणीयम्|यायजनीयम्|याज्यम्|देवयज्या|याज्या|यियक्ष्यम्|यायज्यम्|ईषद्यजः-दुर्यजः-सुयजः|-इज्यमानः|याज्यमानः|यियक्ष्यमाणः|यागः-अनुयागः-प्रयागः|प्रयाजः-अनुयाजः|उपांशुयाजः-पत्नीसंयाजः-ऋतुयाजः-उपयाजः|यज्ञः|यियक्षः|यष्टुम्|यष्टुं|याजको|याजयितुम्|यियक्षितुम्|यायजितुम्|इष्टिः-इज्या|तिप्रत्यये|रूपमेवमिति|क्षीरतरङ्गिणी।]]|यष्टिः|याजना|यियक्षा|यायजा|यजनम्|याजनम्|यियक्षणम्|यायजनम्|इष्ट्वा|याजयित्वा|यियक्षित्वा|यायजित्वा|अन्विज्य|प्रयाज्य|प्रयियक्ष्य|प्रयायज्य|याजम्|यियक्षम्|यायजम्|यजेणुः|=|याजकः|ऋत्विक्।]]
<ul><li><sup id="ref_krm_1345_01"><a href="#foot_krm_1345_01">1</a></sup> {@“यज देवपूजासङ्गतिकरणदानेषु”@} <sup id="ref_krm_1345_02"><a href="#foot_krm_1345_02">2</a></sup> याजकः-जिका, याजकः-जिका, <sup id="ref_krm_1345_03"><a href="#foot_krm_1345_03">3</a></sup> यियक्षकः-क्षिका, यायजकः-जिका;</li> <li>  <sup id="ref_krm_1345_04"><a href="#foot_krm_1345_04">4</a></sup> यष्टा-यष्ट्री, याजयिता-त्री, यियक्षिता-त्री, यायजिता-त्री;</li> <li>  यजन्-न्ती, याजयन्-न्ती, यियक्षन्-न्ती;</li> <li>  -- यक्ष्यन्-न्ती-ती, याजयिष्यन्-न्ती-ती, यियक्षिष्यन्-न्ती-ती;</li> <li>  -- यजमानः, याजयमानः, <sup id="ref_krm_1345_05"><a href="#foot_krm_1345_05">5</a></sup> यियक्षमाणः, यायज्यमानः;</li> <li>  यक्ष्यमाणः, याजयिष्यमाणः, यियक्षिष्यमाणः, यायजिष्यमाणः;</li> <li>  <sup id="ref_krm_1345_06"><a href="#foot_krm_1345_06">6</a></sup> <sup id="ref_krm_1345_07"><a href="#foot_krm_1345_07">7</a></sup> देवेट्-देवेड्-देवेजौ-देवेजः;</li> <li>  -- -- <sup id="ref_krm_1345_08"><a href="#foot_krm_1345_08">8</a></sup> इष्टम्-इष्टः-इष्टवान्-इष्टी, याजितः, यियक्षितः, यायजितः-तवान्;</li> <li>  यजः, <sup id="ref_krm_1345_09"><a href="#foot_krm_1345_09">9</a></sup> सोमयाजी-हविर्याजी <sup id="ref_krm_1345_10"><a href="#foot_krm_1345_10">10</a></sup>, अग्निष्टोमयाजी, <sup id="ref_krm_1345_11"><a href="#foot_krm_1345_11">11</a></sup> यज्वा, <sup id="ref_krm_1345_12"><a href="#foot_krm_1345_12">12</a></sup> <sup id="ref_krm_1345_13"><a href="#foot_krm_1345_13">13</a></sup> यजमानः, <sup id="ref_krm_1345_14"><a href="#foot_krm_1345_14">14</a></sup> ऋत्विक्, ‘त्वं यज्ञे वरुणस्य <sup id="ref_krm_1345_15"><a href="#foot_krm_1345_15">15</a></sup> अवया असि।’ <sup id="ref_krm_1345_16"><a href="#foot_krm_1345_16">16</a></sup> उपयट्, <sup id="ref_krm_1345_17"><a href="#foot_krm_1345_17">17</a></sup> साधुयाजी, याजः, यियक्षुः, <sup id="ref_krm_1345_18"><a href="#foot_krm_1345_18">18</a></sup> यायजूकः, <sup id="ref_krm_1345_19"><a href="#foot_krm_1345_19">19</a></sup> यायजः;</li> <li>  <sup id="ref_krm_1345_20"><a href="#foot_krm_1345_20">20</a></sup> यष्टव्यम्, याजयितव्यम्, यियक्षितव्यम्, यायजितव्यम्;</li> <li>  यजनीयम्, याजनीयम्, यियक्षणीयम्, यायजनीयम्;</li> <li>  <sup id="ref_krm_1345_21"><a href="#foot_krm_1345_21">21</a></sup> याज्यम्, <sup id="ref_krm_1345_22"><a href="#foot_krm_1345_22">22</a></sup> देवयज्या, <sup id="ref_krm_1345_23"><a href="#foot_krm_1345_23">23</a></sup> याज्या, याज्यम्, यियक्ष्यम्, यायज्यम्;</li> <li>  ईषद्यजः-दुर्यजः-सुयजः;</li> <li>  -- -- <sup id="ref_krm_1345_24"><a href="#foot_krm_1345_24">24</a></sup> इज्यमानः, याज्यमानः, यियक्ष्यमाणः, यायज्यमानः;</li> <li>  <sup id="ref_krm_1345_25"><a href="#foot_krm_1345_25">25</a></sup> यागः-अनुयागः-प्रयागः, <sup id="ref_krm_1345_26"><a href="#foot_krm_1345_26">26</a></sup> प्रयाजः-अनुयाजः, <sup id="ref_krm_1345_27"><a href="#foot_krm_1345_27">27</a></sup> उपांशुयाजः-पत्नीसंयाजः-ऋतुयाजः-उपयाजः, <sup id="ref_krm_1345_28"><a href="#foot_krm_1345_28">28</a></sup> यज्ञः, याजः, यियक्षः, यायजः;</li> <li>  यष्टुम्, <sup id="ref_krm_1345_29"><a href="#foot_krm_1345_29">29</a></sup> यष्टुं, याजको <sup id="ref_krm_1345_30"><a href="#foot_krm_1345_30">30</a></sup>, याजयितुम्, यियक्षितुम्, यायजितुम्;</li> <li>  <sup id="ref_krm_1345_31"><a href="#foot_krm_1345_31">31</a></sup> <sup id="ref_krm_1345_32"><a href="#foot_krm_1345_32">32</a></sup> इष्टिः- <sup id="ref_krm_1345_33"><a href="#foot_krm_1345_33">33</a></sup> इज्या <sup id="ref_krm_1345_34"><a href="#foot_krm_1345_34">34</a></sup>, <sup id="ref_krm_1345_35"><a href="#foot_krm_1345_35">35</a></sup> तिप्रत्यये रूपमेवमिति क्षीरतरङ्गिणी।]] यष्टिः, याजना, यियक्षा, यायजा;</li> <li>  यजनम्, याजनम्, यियक्षणम्, यायजनम्;</li> <li>  इष्ट्वा, याजयित्वा, यियक्षित्वा, यायजित्वा;</li> <li>  अन्विज्य, प्रयाज्य, प्रयियक्ष्य, प्रयायज्य;</li> <li>  याजम् २, इष्ट्वा २, याजम् २, याजयित्वा २, यियक्षम् २, यियक्षित्वा २, यायजम् २;</li> <li>  यायजित्वा २;</li> <li>  <sup id="ref_krm_1345_36"><a href="#foot_krm_1345_36">36</a></sup> एणुप्रत्यये रूपम्। </li> <li>यजेणुः = याजकः, ऋत्विक्।]] यजेणुः;</li> <li>  <sup id="ref_krm_1345_37"><a href="#foot_krm_1345_37">37</a></sup> इति युच्प्रत्यये, प्रत्ययस्याननुनासिकत्वेनाना- देशाभावे च रूपमेवम्। </li> <li>यज्युः = अध्वर्युः।]] यज्युः, <sup id="ref_krm_1345_38"><a href="#foot_krm_1345_38">38</a></sup> इत्यत्रन्प्रत्ययः। </li> <li>इज्यन्तेऽस्मिन् देवता इति यजत्रम् = यज्ञस्थानम्। </li> <li>अग्निहोत्रमिति केचित्।]] यजत्रम्, <sup id="ref_krm_1345_39"><a href="#foot_krm_1345_39">39</a></sup> इत्युसिप्रत्ययः। </li> <li>यजुः = वेदः।]] यजुः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1345_01"><a href="#ref_krm_1345_01">↑</a> (१३३५)</li> <li id="foot_krm_1345_02"><a href="#ref_krm_1345_02">↑</a> (१-भ्वादिः-१००२। सक। अनि। उभ।)</li> <li id="foot_krm_1345_03"><a href="#ref_krm_1345_03">↑</a> [[४। सन्नन्ते सर्वत्र, ‘व्रश्चभ्रस्जसृजमृजयजराजभ्राजच्छशां षः’ (८-२-३६) इति षत्वे, ‘षढोः कः सि’ (८-२-४१) इति ककारे, षत्वे च रूपनिष्पत्तिरिति ज्ञेयम्।]]</li> <li id="foot_krm_1345_04"><a href="#ref_krm_1345_04">↑</a> [[५। तृजादिषु, ‘व्रश्च--’ (८-२-३६) इति षत्वे, ष्टुत्वे च रूपम्। एवं तव्यदादिष्वपि प्रक्रियोह्या।]]</li> <li id="foot_krm_1345_05"><a href="#ref_krm_1345_05">↑</a> [[B। ‘यियक्षमाणेनाहूतः पार्थेनाथ द्विषन्मुरम्।’ शि। व। २। १।]]</li> <li id="foot_krm_1345_06"><a href="#ref_krm_1345_06">↑</a> [पृष्ठम्१०६५+ ३०]</li> <li id="foot_krm_1345_07"><a href="#ref_krm_1345_07">↑</a> [[१। देवान् यजतीति देवेट्। कर्मण्युपपदे, ‘क्विप् च’ (३-२-७६) इति क्विपि ‘वचिस्वपियजादीनां किति’ (६-१-१५) इति यकारस्य सम्प्रसारणे, ‘सम्प्रसार- णाच्च’ (६-१-१०८) इति पूर्वरूपे, षत्वे, जश्त्वे च रूपमेवम्।]]</li> <li id="foot_krm_1345_08"><a href="#ref_krm_1345_08">↑</a> [[२। निष्ठायाम्, यजादित्वेन सम्प्रसारणे पूर्वरूपे, षत्वे ष्टुत्वे च रूपमेवम्। ‘इष्टादि- भ्यश्च’ (५-२-८८) इतीन्प्रत्यये इष्टी इति रूपम्। एवमेव क्त्वाप्रभृतिष्वपि प्रक्रिया ज्ञेया।]]</li> <li id="foot_krm_1345_09"><a href="#ref_krm_1345_09">↑</a> [[३। ‘भूते’ (३-२-८४) इत्यधिकारे, ‘करणे यजः’ (३-२-८५) इति णिनिप्रत्यये रूपमेवम्। सोमेन इष्टवान् सोमयाजी। एवमेव अग्निष्टोमयाजी इत्यादि- सिद्धिरूह्या।]]</li> <li id="foot_krm_1345_10"><a href="#ref_krm_1345_10">↑</a> [[आ। ‘मृषाऽसि त्वं हविर्याजी राघव च्छद्मतापसः।’ भ। का। ६-१२९।]]</li> <li id="foot_krm_1345_11"><a href="#ref_krm_1345_11">↑</a> [[४। भूतार्थे, ‘सुयजोर्ङ्वनिप्’ (३-२-१०३) इति ङ्वनिप्प्रत्यये प्रथमैकवचने उपधादीर्घे नकारलोपे च यज्वा इति रूपम्।]]</li> <li id="foot_krm_1345_12"><a href="#ref_krm_1345_12">↑</a> [[B। ‘यज्वानश्च ससुत्वानो यानगोपीन्मखेषु सः।।’ भ। का। ५-३७।]]</li> <li id="foot_krm_1345_13"><a href="#ref_krm_1345_13">↑</a> [[५। तच्छीलादिषु कर्तृषु ‘पूङ्यजोः शानन्’ (३-२-१२८) इति शानन्प्रत्ययः। शित्त्वात् शपि, ‘आने मुक्’ (७-२-८२) इति मुगागमे यजमानः इति रूपम्। यस्त्वसकृत् यागादिकं करोति स एवमुच्यते।]]</li> <li id="foot_krm_1345_14"><a href="#ref_krm_1345_14">↑</a> [[६। ऋतौ यजते, ऋतुं यजते, ऋतुप्रयुक्तो वा यजतीत्यर्थे धातोरस्मात् ऋतुशब्द उपपदे, ‘ऋत्विक्--’ (३-२-५९) इत्यादिना क्विन्। सम्प्रसारणे, पूर्वरूपे च कृते, निपातनात्, व्रश्चादिषत्वापवादतया ‘क्विन्प्रत्ययस्य कुः’ (८-२-६२) इति कुत्वे च ऋत्विक् इति सिद्ध्यति।]]</li> <li id="foot_krm_1345_15"><a href="#ref_krm_1345_15">↑</a> [[७। ‘अवे यजः’ (३-२-७२) इति मन्त्रे ण्विन्प्रत्यये, उपधावृद्धौ ‘अवयाः श्वेतवाः पुरोडाश्च’ (८-२-६७) इति निपातनाद्रुत्वे च रूपमेवम्। छन्दस्येवायं प्रयोगः।]]</li> <li id="foot_krm_1345_16"><a href="#ref_krm_1345_16">↑</a> [[८। ‘विजुपे छन्दसि (३-२-७३) इति छन्दसि विषये उपोपपदे धातोरस्य विच्प्रत्यये षत्वे जश्त्वे च रूपमेवम्।]]</li> <li id="foot_krm_1345_17"><a href="#ref_krm_1345_17">↑</a> [[९। ‘साधुकारिण्युपसंख्यानम्’ (वा। ३-२-७८) इति णिनिप्रत्यये रूपमेवम्।]]</li> <li id="foot_krm_1345_18"><a href="#ref_krm_1345_18">↑</a> [[१०। ‘यजजपदशां यङः’ (३-२-१६६) इति यङन्तादूकप्रत्यये, ‘दीर्घोऽकितः’ (७-४-८३) इत्यभ्यासदीर्घे च रूपमेवम्।]]</li> <li id="foot_krm_1345_19"><a href="#ref_krm_1345_19">↑</a> [[C। ‘तं यायजूकाः सह भिक्षुमुख्यैस्तपःकृशाः शान्त्युदकुम्भहस्ताः।’ भ। का। २-२०।]]</li> <li id="foot_krm_1345_20"><a href="#ref_krm_1345_20">↑</a> [पृष्ठम्१०६६+ २८]</li> <li id="foot_krm_1345_21"><a href="#ref_krm_1345_21">↑</a> [[१। ण्यति, ‘यजयाचरुच--’ (७-३-६६) इति कुत्वनिषेधः।]]</li> <li id="foot_krm_1345_22"><a href="#ref_krm_1345_22">↑</a> [[२। देवशब्द उपपदे छन्दसि विषये कर्मणि यत्प्रत्यये रूपमेवम्। निपातनात् स्त्रीलिङ्ग- त्वम्।]]</li> <li id="foot_krm_1345_23"><a href="#ref_krm_1345_23">↑</a> [[३। यजन्त्यनेनेति याज्या = ऋक्। बाहुलकात् करणे ण्यत्।]]</li> <li id="foot_krm_1345_24"><a href="#ref_krm_1345_24">↑</a> [[४। कर्मणि, यगन्ताच्छानचि सम्प्रसारणे पूर्वरूपे च रूपम्।]]</li> <li id="foot_krm_1345_25"><a href="#ref_krm_1345_25">↑</a> [[५। ‘हलश्च’ (३-३-१२१) इति संज्ञायां घञि, ‘चजोः कु घिण्ण्यतोः’ (७-३-५२) इति कुत्वे च रूपमेवम्। अनुयागः = भोजनम्, उपसर्गवशाद्धातोरर्थान्तरे वृत्तिः। प्रयागः = क्षेत्रविशेषः। अत्र सङ्गतिकरणं धातोरर्थः। नदीत्रयसङ्गति- करणं ह्यत्र देशे वदन्ति।]]</li> <li id="foot_krm_1345_26"><a href="#ref_krm_1345_26">↑</a> [[६। घञि, ‘प्रयाजानुयाजौ यज्ञाङ्गे’ (७-३-६२) इति निपातनात् यज्ञाङ्गविषये कुत्वं न। पञ्च प्रयाजाः। त्रयोऽनुयाजाः। ‘उपसर्गस्य घञि--’ (६-३-१२२) इति दीर्घे अनूयाज इत्यपि भवति।]]</li> <li id="foot_krm_1345_27"><a href="#ref_krm_1345_27">↑</a> [[७। “प्रयाजानुयाजग्रहणं प्रदर्शनार्थम्--अन्यत्राप्येवंप्रकारे कुत्वं न भवति। ‘एकादश उपयाजाः’, ‘उपांशुयाजमन्तरा यजति’, ‘अष्टौ पत्नीसंयाजा भवन्ति’ ‘ऋतुयाजैश्चरन्ति’--इत्येवमादि सिद्धं भवति।’ इति काशिका- (७-३-६२) वाक्यमिहावधेयम्। तेनैतेषां साधुत्वं बोध्यम्। ‘जाघन्या पत्नीः संयाजयन्ति’ (शतपथब्राह्मणे-३-७-६-१) इति श्रौतनिर्वचनपर्यालोचनायां तु पत्नीः संयाजयन्तीति पत्नीसंयाजः इति ण्यन्तात् ‘कर्मण्यण्’ (३-२-१) इत्यणेवात्रेति न कुत्वप्रसक्तिः। अतोऽत्रेतरेषां विषये कुत्वाभावस्योपपत्तिकल्पनेऽपि पत्नीसंयाजशब्दविषये नोपपत्तिकल्पनपरिश्रमः कार्यः इति ज्ञेयम्।]]</li> <li id="foot_krm_1345_28"><a href="#ref_krm_1345_28">↑</a> [[८। भावे, ‘यजयाच--’ (३-३-९०) इत्यादिना नङ्प्रत्यये, जकारस्य श्चुत्वे च रूपमेवम्।]]</li> <li id="foot_krm_1345_29"><a href="#ref_krm_1345_29">↑</a> [[९। ‘तुमुन्ण्वुलौ क्रियायां क्रियार्थायाम्’ (३-३-१०) इति क्रियार्थक्रियायां तुमुन्, ण्वुल् च भवतः। यष्टुं याति--यागाय यातीत्यर्थः।]]</li> <li id="foot_krm_1345_30"><a href="#ref_krm_1345_30">↑</a> [वा याति]</li> <li id="foot_krm_1345_31"><a href="#ref_krm_1345_31">↑</a> [पृष्ठम्१०६७+ २९]</li> <li id="foot_krm_1345_32"><a href="#ref_krm_1345_32">↑</a> [[१। ‘श्रुयजीषिस्तुभ्यः--’ (वा। ३-३-९५) इति करणे क्तिन्प्रत्यये सम्प्रसारणादिके च रूपम्।]]</li> <li id="foot_krm_1345_33"><a href="#ref_krm_1345_33">↑</a> [[२। ‘व्रजयजोर्भावे क्यप्’ (३-३-९८) इति स्त्रियां भावे क्यपि, कित्त्वेन सम्प्र- सारणादिकेषु चैवं रूपम्।]]</li> <li id="foot_krm_1345_34"><a href="#ref_krm_1345_34">↑</a> [[आ। ‘निर्व्याजमिज्या ववृते वचश्च भूयो बभाषे मुनिन कुमारः।।’ भ। का। २-३७।]]</li> <li id="foot_krm_1345_35"><a href="#ref_krm_1345_35">↑</a> [[३। बाहुलकादौणादिके [द। उ। १-७४]</li> <li id="foot_krm_1345_36"><a href="#ref_krm_1345_36">↑</a> [[४। बाहुलकादौणादिके [द। उ। १-१३३]</li> <li id="foot_krm_1345_37"><a href="#ref_krm_1345_37">↑</a> [[५। ‘यजिमनि--’ [द। उ। १-१३४]</li> <li id="foot_krm_1345_38"><a href="#ref_krm_1345_38">↑</a> [[६। ‘अमिनक्षियजि--’ [द। उ। ८-५६]</li> <li id="foot_krm_1345_39"><a href="#ref_krm_1345_39">↑</a> [[७। ‘अर्त्तिपॄवपियजि--’ [द। उ। ९-३९]</li></ul></p>

यत|प्रायः|सर्वेऽप्याधुनिकाः|वैयाकरणाः|धातुविषये|क्षीरस्वामिमतं|पुरुषकारोपात्तस्थलेषु|पुरुषकारवाक्यानुसारेणैवोद्धरन्ति|यातकः-तिका-यियातयिषकः-षिका|यातयिता-त्री|यियातयिषिता-त्री
<ul><li><sup id="ref_krm_1346_01"><a href="#foot_krm_1346_01">1</a></sup> {@“यत निकारोपस्कारयोः”@} <sup id="ref_krm_1346_02"><a href="#foot_krm_1346_02">2</a></sup> <sup id="ref_krm_1346_03"><a href="#foot_krm_1346_03">3</a></sup> ‘निराकारे’ इति दैवपाठमुपाश्रित्य पुरुषकारे व्याख्यातम्-- “… ‘निराकारः = परिभवः।’ इति च क्षीरस्वामी। </li> <li>उपस्कारोपसंस्कारयोः पुनः पाठकृतः <sup id="ref_krm_1346_04"><a href="#foot_krm_1346_04">4</a></sup> विप्रवदन्ते। </li> <li>तथा च आख्यातनिघण्टुः-- ‘यत्ने प्रैषे निराकारे यातयेदप्युपस्कृतौ।’ इति। </li> <li>श्लोकधातुपाठश्च-- ‘यत उपसंस्कारनिकारार्थः स निरश्च धान्यधनवाची।’ इति।” इति। </li> <li>अत्रेदमवधेयम्--माधवधातु- वृत्ति-प्रौढमनोरमाप्रभृतिष्वप्येवमेव क्षीरस्वामिपाठ उद्ध्रियते। </li> <li>परं तु क्षीरतरङ्गिण्यामधुना पाठोऽन्यादृश एवोपलभ्यत इत्युपर्येव प्रदर्शितम्। </li> <li>प्रायः सर्वेऽप्याधुनिकाः वैयाकरणाः धातुविषये क्षीरस्वामिमतं पुरुषकारोपात्तस्थलेषु पुरुषकारवाक्यानुसारेणैवोद्धरन्ति;</li> <li>  न तु स्वयं दृष्टत्वेनेत्य पि ज्ञायते।]] ‘--खेदे च’ इति क। </li> <li>क। </li> <li>द्रुमे। </li> <li><sup id="ref_krm_1346_05"><a href="#foot_krm_1346_05">5</a></sup> ‘यतते तु प्रयत्नार्थे, निराकारे तु यातयेत्।’ <sup id="ref_krm_1346_06"><a href="#foot_krm_1346_06">6</a></sup> इति देवः। </li> <li>‘निकारः = स्वेदनम्।’ इति क्षीरस्वामी। </li> <li>‘यत्नः प्रैषो वा निकारः’ इति बालमनोरमा। </li> <li>‘परिभवसंस्कारौ तौ’ इति धा। </li> <li>का। </li> <li>व्याख्या <sup id="ref_krm_1346_07"><a href="#foot_krm_1346_07">7</a></sup>। </li> <li>यातकः-तिका-यियातयिषकः-षिका;</li> <li>  यातयिता-त्री, यियातयिषिता-त्री;</li> <li>  इत्यादिकानि रूपाणि समस्तान्यपि चौरादिककालयतिवत् <sup id="ref_krm_1346_08"><a href="#foot_krm_1346_08">8</a></sup> ज्ञेयानि। </li> <li>यातना = तीव्रवेदना। </li> <li>‘ण्यासश्रन्थः--’ <sup id="ref_krm_1346_09"><a href="#foot_krm_1346_09">9</a></sup> इति युचि रूपम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1346_01"><a href="#ref_krm_1346_01">↑</a> (१३३६)</li> <li id="foot_krm_1346_02"><a href="#ref_krm_1346_02">↑</a> (१०-चुरादिः-१७३६। सक। सेट्। उभ।)</li> <li id="foot_krm_1346_03"><a href="#ref_krm_1346_03">↑</a> [[[अ]</li> <li id="foot_krm_1346_04"><a href="#ref_krm_1346_04">↑</a> (= ग्रान्थिकाः)</li> <li id="foot_krm_1346_05"><a href="#ref_krm_1346_05">↑</a> [पृष्ठम्१०६८+ ३१]</li> <li id="foot_krm_1346_06"><a href="#ref_krm_1346_06">↑</a> (श्लो। ९६)</li> <li id="foot_krm_1346_07"><a href="#ref_krm_1346_07">↑</a> (३-४०)</li> <li id="foot_krm_1346_08"><a href="#ref_krm_1346_08">↑</a> (१७५)</li> <li id="foot_krm_1346_09"><a href="#ref_krm_1346_09">↑</a> (३-३-१०७)</li></ul></p>

यती|यातकः-तिका|यियतिषकः-षिका|यायतकः-तिका|यतिता-त्री|यातयिता-त्री|यियतिषिता-त्री|यायतिता-त्री
<ul><li><sup id="ref_krm_1347_01"><a href="#foot_krm_1347_01">1</a></sup> {@“यती प्रयत्ने”@} <sup id="ref_krm_1347_02"><a href="#foot_krm_1347_02">2</a></sup> ‘यतते तु प्रयत्नार्थे, निराकारे तु यातयेत्।’ <sup id="ref_krm_1347_03"><a href="#foot_krm_1347_03">3</a></sup> इति देवः। </li> <li>यातकः-तिका, यातकः-तिका, यियतिषकः-षिका, यायतकः-तिका;</li> <li>  यतिता-त्री, यातयिता-त्री, यियतिषिता-त्री, यायतिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकचेततिवत् <sup id="ref_krm_1347_04"><a href="#foot_krm_1347_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1347_05"><a href="#foot_krm_1347_05">5</a></sup> यत्यम्, <sup id="ref_krm_1347_06"><a href="#foot_krm_1347_06">6</a></sup> यत्नः, <sup id="ref_krm_1347_07"><a href="#foot_krm_1347_07">7</a></sup> आयत्तः-आयत्तवान्, <sup id="ref_krm_1347_08"><a href="#foot_krm_1347_08">8</a></sup> यतिः, <sup id="ref_krm_1347_09"><a href="#foot_krm_1347_09">9</a></sup> यतमानः, इतीमानि रूपाण्यस्माद् भवन्तीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1347_01"><a href="#ref_krm_1347_01">↑</a> (१३३७)</li> <li id="foot_krm_1347_02"><a href="#ref_krm_1347_02">↑</a> (१-भ्वादिः-३०। अक। सेट्। आत्म।)</li> <li id="foot_krm_1347_03"><a href="#ref_krm_1347_03">↑</a> (श्लो। ९६)</li> <li id="foot_krm_1347_04"><a href="#ref_krm_1347_04">↑</a> (५२४)</li> <li id="foot_krm_1347_05"><a href="#ref_krm_1347_05">↑</a> [[१। ‘तकिशसिचतियतिजनीनामुपसंख्यानम्’ (वा। ३-१-९७) इति हलन्तलक्षणण्यदप- वादतया यत्प्रत्यये रूपमेवम्।]]</li> <li id="foot_krm_1347_06"><a href="#ref_krm_1347_06">↑</a> [[२। भावे, ‘यजयाचयतविच्छप्रच्छरक्षो नङ्’ (३-३-९०) इति नङ्प्रत्यये रूपम्।]]</li> <li id="foot_krm_1347_07"><a href="#ref_krm_1347_07">↑</a> [[३। निष्ठायाम्, ‘श्वीदितः--’ (७-२-१४) इति इण्निषेधः।]]</li> <li id="foot_krm_1347_08"><a href="#ref_krm_1347_08">↑</a> [[४। सर्वधातुभ्यो विहित औणादिके कर्तरि इन्प्रत्यये रूपमेवम्।]]</li> <li id="foot_krm_1347_09"><a href="#ref_krm_1347_09">↑</a> [[५। ‘ताच्छील्यवयोवचनशक्तिषु चानश्’ (३-२-१२९) इत्यनेन ताच्छील्यार्थे चानश्प्र- त्यये रूपमेवम्। शानच्प्रत्ययेऽप्येवमेव। यतमानः = यमनियमाद्यङ्गविशिष्टयोगा- भ्यासकविशेषः।]]</li></ul></p>

यत्रि|इति|ऋदिदत्र|पाठ|आभरणकारमतत्वेन|धातुवृत्तावु-|पादाय-|“अयं|पाठः|चिरन्तनव्याख्यानेषु|न|दृश्यते|इह|तु|रेफस्यैवोप-|धात्वप्रसङ्गेन|नलोपप्रसक्त्यभावात्-]]|यन्त्रकः-न्त्रिका|यियन्त्रयिषकः-षिका|यन्त्रयिता-त्री|यियन्त्रयिषिता-त्री
<ul><li><sup id="ref_krm_1348_01"><a href="#foot_krm_1348_01">1</a></sup> {@“यत्रि सङ्कोचने”@} <sup id="ref_krm_1348_02"><a href="#foot_krm_1348_02">2</a></sup> <sup id="ref_krm_1348_03"><a href="#foot_krm_1348_03">3</a></sup> ‘यन्तृ--’ इति ऋदिदत्र पाठ इति आभरणकारमतत्वेन धातुवृत्तावु- पादाय-- “अयं पाठः चिरन्तनव्याख्यानेषु न दृश्यते;</li> <li>  प्रत्युत यन्त्रणादिशब्द- मस्मादेव मैत्रेयादयो व्युदपादयन्।” इति विवेचितम्। </li> <li>“अत्रापि पूर्ववत् <sup id="ref_krm_1348_04"><a href="#foot_krm_1348_04">4</a></sup> इदित्करणात् यन्त्रतीत्याद्यपि भवति।” इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>“यन्त्र--इति पठितुं युक्तम्। </li> <li>यत्तु-इदित्करणात् यन्त्रतीति माधवेनो- क्तम्--तच्चिन्त्यम्।” इति सिद्धान्तकौमुद्युक्तिरेव साधुः। </li> <li>यतः-- ‘चिन्त्यात्’ इत्यादौ उपधानकारसद्भावेन, णिजभावपक्षे नलोपव्यावृत्त्या सार्थकतां लभमान इकारः णिजभावं चिन्तेर्ज्ञापयतीति तूचितम्। </li> <li>इह तु रेफस्यैवोप- धात्वप्रसङ्गेन नलोपप्रसक्त्यभावात्--इति ज्ञेयम्।]] यन्त्रकः-न्त्रिका, यियन्त्रयिषकः-षिका;</li> <li>  यन्त्रयिता-त्री, यियन्त्रयिषिता-त्री;</li> <li>  <sup id="ref_krm_1348_05"><a href="#foot_krm_1348_05">5</a></sup> इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकतन्त्रयतिवत् <sup id="ref_krm_1348_06"><a href="#foot_krm_1348_06">6</a></sup> ज्ञेयानि। </li> <li>यति-- <sup id="ref_krm_1348_07"><a href="#foot_krm_1348_07">7</a></sup> अयन्त्र्यम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1348_01"><a href="#ref_krm_1348_01">↑</a> (१३३८)</li> <li id="foot_krm_1348_02"><a href="#ref_krm_1348_02">↑</a> (१०-चुरादिः-१५३६। अक। सेट्। उभ।)</li> <li id="foot_krm_1348_03"><a href="#ref_krm_1348_03">↑</a> [[[अ]</li> <li id="foot_krm_1348_04"><a href="#ref_krm_1348_04">↑</a> (चितिधातुवत्)</li> <li id="foot_krm_1348_05"><a href="#ref_krm_1348_05">↑</a> [पृष्ठम्१०६९+ २६]</li> <li id="foot_krm_1348_06"><a href="#ref_krm_1348_06">↑</a> (६९८)</li> <li id="foot_krm_1348_07"><a href="#ref_krm_1348_07">↑</a> [[आ। ‘संचोरयन्तमरिगर्वमशेषभद्रं चिन्तन्तमन्तकमिवाप्तमयन्त्र्यवीर्यम्।’ धा। का। ३-१३।]]</li></ul></p>

यभ|“भय|विपरीतो|मैथुने’|तत्र|प्रमाणं|मृग्यम्।]]|याभकः-भिका|यियप्सकः-सिका|यायभकः-भिका|यब्धा-यब्ध्री|याभयिता-त्री|यियप्सिता-त्री|यायभिता-त्री
<ul><li><sup id="ref_krm_1349_01"><a href="#foot_krm_1349_01">1</a></sup> {@“यभ मैथुने”@} <sup id="ref_krm_1349_02"><a href="#foot_krm_1349_02">2</a></sup> <sup id="ref_krm_1349_03"><a href="#foot_krm_1349_03">3</a></sup> ‘यभ विपरीतमैथुने’ इति क्षीरस्वामि-माधवादिसम्मतः पाठः। </li> <li>‘--विपरीते मैथुने’ इति धा। </li> <li>का। </li> <li>व्याख्या <sup id="ref_krm_1349_04"><a href="#foot_krm_1349_04">4</a></sup> दृष्टः पाठः। </li> <li>“भय विपरीतो मैथुने’;</li> <li>  विपरीत इति--यभ इत्यर्थः।” इति पुरुष- कारः। </li> <li>‘जभ--’ इति चवर्गतृतीयादिं केचित् पठन्ति। </li> <li>धनपाल-काश्य- पादयः ‘यभ--’ इति पठित्वा, ‘जभ च’ इति पठन्तीति ग्रन्थेषु तत्र तत्रोदाहरणाज्ज्ञायते। </li> <li>‘रभिश्च भान्तेष्वथ मैथुने यभिः’ <sup id="ref_krm_1349_05"><a href="#foot_krm_1349_05">5</a></sup> इत्यत्र वृत्त्यादिषु यभतेरेवोदाहरणात् ‘जभ--’ इति पाठोऽप्रामाणिक इति च पुरुषकारे <sup id="ref_krm_1349_06"><a href="#foot_krm_1349_06">6</a></sup> निरूपितम्। </li> <li>‘जभि--’ इत्यपि कुत्रचिद् दृष्टः पाठः। </li> <li>“-- ‘विपरीत इति। </li> <li>विपरीतानुष्ठित इत्यर्थः।’ इति मैत्रेयः।।” इति धातुवृत्तिः। </li> <li>“तच्च पुरुषायितम्।” इति धा। </li> <li>का व्याख्या। </li> <li>एवं बहुधाऽत्र धातौ, स्वरूपविषयेऽर्थविचारे च विप्रतिपत्तिः ग्रन्थकृतां दृश्यते। </li> <li>प्रसिद्धपाठस्तु यभ इत्येवेति प्रामाणिकाः। </li> <li>‘यभस्व नित्यं यदि शक्तिरस्ति--’ <sup id="ref_krm_1349_07"><a href="#foot_krm_1349_07">7</a></sup> इत्यादिषु धातोरस्यात्मनेपदप्रयोगो दृश्यते। </li> <li>तत्र प्रमाणं मृग्यम्।]] याभकः-भिका, याभकः-भिका, <sup id="ref_krm_1349_08"><a href="#foot_krm_1349_08">8</a></sup> यियप्सकः-सिका, यायभकः-भिका;</li> <li>  <sup id="ref_krm_1349_09"><a href="#foot_krm_1349_09">9</a></sup> यब्धा-यब्ध्री, याभयिता-त्री, यियप्सिता-त्री, यायभिता-त्री;</li> <li>  इत्यादिकानि सर्वाण्यपि रूपाणि प्रातिस्विकरूपाणि विना भौवादिकतपतिवत् <sup id="ref_krm_1349_10"><a href="#foot_krm_1349_10">10</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1349_11"><a href="#foot_krm_1349_11">11</a></sup> याभः। </li> <li><sup id="ref_krm_1349_12"><a href="#foot_krm_1349_12">12</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1349_01"><a href="#ref_krm_1349_01">↑</a> (१३३९)</li> <li id="foot_krm_1349_02"><a href="#ref_krm_1349_02">↑</a> (१-भ्वादिः-९८०। अक। अनि। पर।)</li> <li id="foot_krm_1349_03"><a href="#ref_krm_1349_03">↑</a> [[[अ]</li> <li id="foot_krm_1349_04"><a href="#ref_krm_1349_04">↑</a> (२-३९)</li> <li id="foot_krm_1349_05"><a href="#ref_krm_1349_05">↑</a> (अनिट्कारिका, भाष्ये ७-२-१०)</li> <li id="foot_krm_1349_06"><a href="#ref_krm_1349_06">↑</a> (श्लो। १४५)</li> <li id="foot_krm_1349_07"><a href="#ref_krm_1349_07">↑</a> (मुक्तकम्)</li> <li id="foot_krm_1349_08"><a href="#ref_krm_1349_08">↑</a> [[१। ‘--अथ मैथुने यभिः’ इत्यनिट्कारिकासु (भाष्ये ७-२-१०) पाठात् धातोरस्यानिट्त्वम्। ‘खरि च’ (८-४-५५) इति चर्त्वेन भकारस्य पकारः।]]</li> <li id="foot_krm_1349_09"><a href="#ref_krm_1349_09">↑</a> [[२। तृजादिषु, ‘झषस्तथोर्धोऽधः’ (८-२-४०) इति धत्वेन धकारे, ‘झलां जश् झशि’ (८-४-५३) इति जश्त्वे च रूपनिष्पत्तिर्ज्ञेया।]]</li> <li id="foot_krm_1349_10"><a href="#ref_krm_1349_10">↑</a> (७०३)</li> <li id="foot_krm_1349_11"><a href="#ref_krm_1349_11">↑</a> [[B। ‘याभाद्यकामैर्नमनाद् गताद्यैः सृप्योऽसि विष्णो यमिभिर्वितापैः।।’ धा। का। २-३९।]]</li> <li id="foot_krm_1349_12"><a href="#ref_krm_1349_12">↑</a> [पृष्ठम्१०७०+ ३०]</li></ul></p>

