<ul><li><sup id="ref_krm_1171_01"><a href="#foot_krm_1171_01">1</a></sup> {@“ञि भी भये”@} <sup id="ref_krm_1171_02"><a href="#foot_krm_1171_02">2</a></sup> भायकः-यिका, <sup id="ref_krm_1171_03"><a href="#foot_krm_1171_03">3</a></sup> भापकः- <sup id="ref_krm_1171_04"><a href="#foot_krm_1171_04">4</a></sup> भीषकः-षिका, <sup id="ref_krm_1171_05"><a href="#foot_krm_1171_05">5</a></sup> भायकः-यिका, <sup id="ref_krm_1171_06"><a href="#foot_krm_1171_06">6</a></sup> बिभीषकः-षिका, बेभीयकः-यिका;</li> <li>  भेता-भेत्री, <sup id="ref_krm_1171_07"><a href="#foot_krm_1171_07">7</a></sup> भापयिता-भीषयिता-भाययिता-त्री, बिभीषिता-त्री, बेभीयिता-त्री;</li> <li>  <sup id="ref_krm_1171_08"><a href="#foot_krm_1171_08">8</a></sup> <sup id="ref_krm_1171_09"><a href="#foot_krm_1171_09">9</a></sup> बिभ्यत्-बिभ्यतौ-बिभ्यतः, <sup id="ref_krm_1171_10"><a href="#foot_krm_1171_10">10</a></sup> <sup id="ref_krm_1171_11"><a href="#foot_krm_1171_11">11</a></sup> भाययन्-न्ती, बिभीषन्-न्ती;</li> <li>  -- <sup id="ref_krm_1171_12"><a href="#foot_krm_1171_12">12</a></sup> भेष्यन्-न्ती-ती, भाययिष्यन्-न्ती-ती, बिभीषिष्यन्-न्ती-ती;</li> <li>  -- -- <sup id="ref_krm_1171_13"><a href="#foot_krm_1171_13">13</a></sup> <sup id="ref_krm_1171_14"><a href="#foot_krm_1171_14">14</a></sup> भापयमानः, <sup id="ref_krm_1171_15"><a href="#foot_krm_1171_15">15</a></sup> <sup id="ref_krm_1171_16"><a href="#foot_krm_1171_16">16</a></sup> भीषयमाणः, -- बेभीयमानः;</li> <li>  -- भापयिष्यमाणः-भीषयिष्यमाणः -- बेभीयिष्यमाणः;</li> <li>  भीः-भियौ-भियः;</li> <li>  -- -- -- -- भीतः-भीतवान्, भापितः-भीषितः-भायितः, बिभीषितः, बेभीयितः-तवान्;</li> <li>  <sup id="ref_krm_1171_17"><a href="#foot_krm_1171_17">17</a></sup> भीतः, वृकभीतः, <sup id="ref_krm_1171_18"><a href="#foot_krm_1171_18">18</a></sup> भीरुः <sup id="ref_krm_1171_19"><a href="#foot_krm_1171_19">19</a></sup> -भीलुकः, <sup id="ref_krm_1171_20"><a href="#foot_krm_1171_20">20</a></sup> भीरुकः, <sup id="ref_krm_1171_21"><a href="#foot_krm_1171_21">21</a></sup> विभीषणः, <sup id="ref_krm_1171_22"><a href="#foot_krm_1171_22">22</a></sup> भापः-भीषः-भायः, बिभीषुः, बेभ्यः;</li> <li>  भेतव्यम्, भापयितव्यम्-भीषयितव्यम्-भाययितव्यम्, बिभीषितव्यम्, बेभीयितव्यम्;</li> <li>  <sup id="ref_krm_1171_23"><a href="#foot_krm_1171_23">23</a></sup> प्रनिभयनीयम्-प्रणिभयनीयम्, भापनीयम्-भीषणीयम्-भायनीयम्, बिभीषणीयम्, बेभीयनीयम्;</li> <li>  भेयम्, भाप्यम्-भीष्यम्-भाय्यम्, बिभीष्यम्, बेभीय्यम्;</li> <li>  भायमानः, भाप्यमानः-भीष्यमाणः-भाय्यमानः, बिभीष्यमाणः, बेभीय्यमानः;</li> <li>  ईषद्भयः-दुर्भयः-सुभयः;</li> <li>  -- -- -- <sup id="ref_krm_1171_24"><a href="#foot_krm_1171_24">24</a></sup> <sup id="ref_krm_1171_25"><a href="#foot_krm_1171_25">25</a></sup> भयम्-वृकभयम्, भापः-भीषः-भायः, बिभीषः, बेभीयः;</li> <li>  भेतुम्, भापयितुम्-भीषयितुम्-भाययितुम्, बिभीषितुम्, बेभीयितुम्;</li> <li>  भीतिः, वृकभीतिः, <sup id="ref_krm_1171_26"><a href="#foot_krm_1171_26">26</a></sup> भीः, भापना-भीषणा-भायना, <sup id="ref_krm_1171_27"><a href="#foot_krm_1171_27">27</a></sup> भीषा- <sup id="ref_krm_1171_28"><a href="#foot_krm_1171_28">28</a></sup> जातभीषा, बिभीषा, बेभीया;</li> <li>  -- भापनम्-भीषणम्-भायनम्, बिभीषणम्, बेभीयनम्;</li> <li>  भीत्वा, भापयित्वा-भीषयित्वा-भाययित्वा, बिभीषित्वा, बेभीयित्वा;</li> <li>  प्रभीय, प्रभाप्य-प्रभीष्य-प्रभाय्य, प्रबिभीष्य, प्रबेभीय्य;</li> <li>  भायम् २, भीत्वा २, भापम् २ -भीषम् २ -भायम् २, भापयित्वा २ -भीषयित्वा २ -भाययित्वा २, बिभीषम् २, बिभीषित्वा २, बेभीयम् २;</li> <li>  बेभीयित्वा २;</li> <li>  <sup id="ref_krm_1171_29"><a href="#foot_krm_1171_29">29</a></sup> भेकः, <sup id="ref_krm_1171_30"><a href="#foot_krm_1171_30">30</a></sup> भयानकः, <sup id="ref_krm_1171_31"><a href="#foot_krm_1171_31">31</a></sup> भीमः-भीष्मः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1171_01"><a href="#ref_krm_1171_01">↑</a> (११६१)</li> <li id="foot_krm_1171_02"><a href="#ref_krm_1171_02">↑</a> (३-जुहोत्यादिः-१०८४। अक। अनि। पर।)</li> <li id="foot_krm_1171_03"><a href="#ref_krm_1171_03">↑</a> [[६। ‘बिभेतेर्हेतुभये’ (६-१-५६) इति विकल्पेन णावात्वे, आदन्तलक्षणः पुगागमः।]]</li> <li id="foot_krm_1171_04"><a href="#ref_krm_1171_04">↑</a> [[७। आत्वाभावपक्षे, ‘भियो हेतुभये षुक्’ (७-३-४०) इति षुगागमः।]]</li> <li id="foot_krm_1171_05"><a href="#ref_krm_1171_05">↑</a> [[८। अहेतुभये तु (करणादिजन्ये भये तु) णिज्निमित्तकवृद्धौ, आयादेशे च रूपमेवम्। एवमेव ण्यन्ते रूपत्रयस्योपपत्तिर्ज्ञेया।]]</li> <li id="foot_krm_1171_06"><a href="#ref_krm_1171_06">↑</a> [[९। सन्नन्तात् ण्वुलि, ‘इको झल्’ (१-२-९) इति सनः कित्त्वान्न गुणः। एवमुत्त- रत्रापि सन्नन्तेषु ज्ञेयम्।]]</li> <li id="foot_krm_1171_07"><a href="#ref_krm_1171_07">↑</a> [[आ। ‘विस्मापयित्री जनमुग्रसेनजं द्राग् भापयित्री भृशमस्य पञ्चताम्।’ वा। वि। १। ३८।]]</li> <li id="foot_krm_1171_08"><a href="#ref_krm_1171_08">↑</a> [[१०। शतरि शपो जुहोत्यादित्वात् श्लौ, द्विर्वचने, अभ्यासह्रस्वे, उत्तरखण्डे यणि ‘नाभ्यस्ताच्छतुः’ (७-१-७८) इति नुमो निषेधः।]]</li> <li id="foot_krm_1171_09"><a href="#ref_krm_1171_09">↑</a> (चोरात्)</li> <li id="foot_krm_1171_10"><a href="#ref_krm_1171_10">↑</a> [कुञ्जिकया एनं]</li> <li id="foot_krm_1171_11"><a href="#ref_krm_1171_11">↑</a> [[११। हेतुभये एवात्मनेपदविधानादत्र च अहेतु (करण) भयत्वात् ण्यन्ताच्छतैव।]]</li> <li id="foot_krm_1171_12"><a href="#ref_krm_1171_12">↑</a> [पृष्ठम्०९५५+ २४]</li> <li id="foot_krm_1171_13"><a href="#ref_krm_1171_13">↑</a> (जटिलो)</li> <li id="foot_krm_1171_14"><a href="#ref_krm_1171_14">↑</a> [[१। ‘भीस्म्योर्हेतुभये’ (१-३-६८) इति ण्यन्तादात्मनेपदम्।]]</li> <li id="foot_krm_1171_15"><a href="#ref_krm_1171_15">↑</a> (मुण्डो)</li> <li id="foot_krm_1171_16"><a href="#ref_krm_1171_16">↑</a> [[आ। ‘शत्रून् भीषयमाणं तं रामं विस्मापयेत कः।’ भ। का। ५-५८।]]</li> <li id="foot_krm_1171_17"><a href="#ref_krm_1171_17">↑</a> [[२। ‘ञीतः क्तः’ (३-२-१८७) इति वर्तमाने कर्तरि क्तप्रत्ययः। वृकभीतः इत्यत्र ‘भयभीतभीतिभीभिरिति वक्तव्यम्’ (वा। २-१-३७) इति वचनात् समासो बोध्यः।]]</li> <li id="foot_krm_1171_18"><a href="#ref_krm_1171_18">↑</a> [[३। तच्छीलादिषु कर्तृषु ‘भियः क्रुक्लुकनौ’ (३-२-१७४) इति क्रुः क्लुकन् च प्रत्ययौ भवतः। क्रमेण भीरुः, भीलुकः इति रूपे सिद्ध्यतः।]]</li> <li id="foot_krm_1171_19"><a href="#ref_krm_1171_19">↑</a> [[B। ‘अभीरुरवसं स्त्रीभिर्भास्वराभिरिहेश्वरः।।’ भ। का। ७-२५।]]</li> <li id="foot_krm_1171_20"><a href="#ref_krm_1171_20">↑</a> [[४। ‘क्रुकन्नपि वक्तव्यः’ (वा। ३-२-१७४) इति वचनात् क्रुकन्प्रत्यये रूपमेवम्। अयमपि ताच्छीलिकप्रत्ययः।]]</li> <li id="foot_krm_1171_21"><a href="#ref_krm_1171_21">↑</a> [[५। विशेषेण भीषयत इति विभीषणः। ण्यन्तात् नन्द्यादित्वात् (३-१-१३४) कर्तरि ल्युः। षुगागमः।]]</li> <li id="foot_krm_1171_22"><a href="#ref_krm_1171_22">↑</a> [[C। ‘बिभ्युर्बिडालेक्षणभीषणाभ्यो वैदूर्यकुड्येषु शशिद्युतिभ्यः।।’ शि। व। ३-४५।]]</li> <li id="foot_krm_1171_23"><a href="#ref_krm_1171_23">↑</a> [[६। ‘शेषे विभाषाऽकखादावषान्त उपदेशे’ (८-४-१८) इति उपसर्गस्थान्निमित्तात् परस्य नेः णत्वविकल्पः।]]</li> <li id="foot_krm_1171_24"><a href="#ref_krm_1171_24">↑</a> [पृष्ठम्०९५६+ २३]</li> <li id="foot_krm_1171_25"><a href="#ref_krm_1171_25">↑</a> [[१। ‘अज्विधौ-भयादीनामुपसंख्यानम्, नपुंसके क्तादिनिवृत्त्यर्थम्’ (वा। ३-३-५६) इति वचनादत्र ‘एरच्’ (३-३-५६) इति भावेऽच्प्रत्ययः। अच्प्रत्ययान्तस्य पुंलिङ्गत्वं तु प्रायिकम्। अतोऽत्र नपुंसकत्वम्। वार्तिकेऽत्र ‘क्तादिनिवृत्त्यर्थम्’ इत्युक्तत्वात् नपुंसके भावे विहितः ल्युट्प्रत्ययोऽप्यस्य धातोर्नेति ज्ञेयम्। वृकभयम् इत्यत्र ‘पञ्चमी भयेन’ (२-१-३७) इति समासः।]]</li> <li id="foot_krm_1171_26"><a href="#ref_krm_1171_26">↑</a> [[२। स्त्रियां भावे सम्पदादित्वात् (वा। ३-३-९४) क्विप्।]]</li> <li id="foot_krm_1171_27"><a href="#ref_krm_1171_27">↑</a> [[३। हेतुमण्ण्यन्तात् बाहुलकेन ‘अ प्रत्ययात्’ (३-३-१०२) इत्यकारप्रत्ययः, युजपवादः।]]</li> <li id="foot_krm_1171_28"><a href="#ref_krm_1171_28">↑</a> [[आ। ‘जगत्पतौ पश्यति जातभीषा प्रायस्तदालिङ्गनमभ्यनैषीत्।।’ या। अ। १३-५७।]]</li> <li id="foot_krm_1171_29"><a href="#ref_krm_1171_29">↑</a> [[४। ‘इण्भीका--’ (द। उ। ३-२१) इति कन्प्रत्यये रूपमेवम्। बिभेतीति भेकः।]]</li> <li id="foot_krm_1171_30"><a href="#ref_krm_1171_30">↑</a> [[५। ‘आनकः शीङ्भियः’ (द। उ। ३-२६) इत्यानकप्रत्ययः। बिभेति तस्मादिति भयानकः = भीषणः। ‘भीमादयोऽपादाने’ (३-४-७४) इति अपादानेऽयं प्रत्ययः।]]</li> <li id="foot_krm_1171_31"><a href="#ref_krm_1171_31">↑</a> [[६। ‘भियः षुग् वा’ (द। उ। ७-३५) इति मक्प्रत्ययः, पक्षे षुगागमश्च। बिभेत्यस्मा- ज्जन इति भीमः, भीष्मो वा। ‘भीमादयोऽपादाने’ (३-४-७४) इत्यपादानेऽयं प्रत्ययो ज्ञेयः।]]</li></ul></p>

भुज|भोजकः-जिका|बुभुक्षकः-क्षिका|बोभुजकः-जिका|भोक्ता-भोक्त्री|भोजयिता-त्री|बुभुक्षिता-त्री|बोभुजिता-त्री|भुञ्जन्-ती|देवदत्तं|यज्ञदत्तः-भोजयन्-न्ती|बुभुक्षन्-न्ती|-|भोक्ष्यन्-न्ती-ती|भोजयिष्यन्-न्ती-ती|बुभुक्षिष्यन्-न्ती-ती|-भुञ्जानः|भोजयमानः|बुभुक्षमाणः|बोभुज्यमानः|भोक्ष्यमाणः|भोजयिष्यमाणः|बुभुक्षिष्यमाणः|बोभुजिष्यमाणः|हुतभुक्|हव्यभुक्|बलिभुक्-बलिभुजौ-बलिभुजः|भुक्तम्-भुक्तवान्|प्रभुक्तः|भोजितः|बुभुक्षितः|बोभुजितः-तवान्|भोजः|विश्वभोजः|उष्णभोजी-शीतभोजी|कलहभोजी|अश्राद्धभोजी|कांस्यभोजी|भुञ्जानः|बुभुक्षुः|बोभुजः|भोक्तव्यम्|भोजयितव्यम्|बुभुक्षितव्यम्|बोभुजितव्यम्|प्रनिभोजनीयम्-प्रणिभोजनीयम्|भोजनीयम्|बुभुक्षणीयम्|बोभुजनीयम्|भोज्यम्-भोग्यम्|भोज्यम्|बुभुक्ष्यम्|बोभुज्यम्|ईषद्भोजः-दुर्भोजः-सुभोजः|भुज्यमानः|भोज्यमानः|बुभुक्ष्यमाणः|भुजः-भोगः|भोगः|बुभुक्षः|भोक्तुम्|भोक्तुं|शक्नोति|भोजयितुम्|बुभुक्षितुम्|बोभुजितुम्|भुक्तिः|भुजिः|अन्नभोजिका|भोजना|बुभुक्षा|बोभुजा|भोजनम्|बुभुक्षणम्|बोभुजनम्|भुक्त्वा|भोजयित्वा|बुभुक्षित्वा|बोभुजित्वा|उपभुज्य|उपभोज्य|प्रबुभुक्ष्य|प्रबोभुज्य|भोजम्|बुभुक्षम्|बोभुजम्
<ul><li><sup id="ref_krm_1172_01"><a href="#foot_krm_1172_01">1</a></sup> {@“भुज पालनाभ्यवहारयोः”@} <sup id="ref_krm_1172_02"><a href="#foot_krm_1172_02">2</a></sup> अभ्यवहारः = भोजनम्। </li> <li>‘भुजेद् भुनक्ति भुंक्ते स्युः, कौटिल्ये पालनेऽदने।’ <sup id="ref_krm_1172_03"><a href="#foot_krm_1172_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_1172_04"><a href="#foot_krm_1172_04">4</a></sup> भोजकः-जिका, भोजकः-जिका, <sup id="ref_krm_1172_05"><a href="#foot_krm_1172_05">5</a></sup> बुभुक्षकः-क्षिका, बोभुजकः-जिका;</li> <li>  भोक्ता-भोक्त्री, भोजयिता-त्री, बुभुक्षिता-त्री, बोभुजिता-त्री;</li> <li>  <sup id="ref_krm_1172_06"><a href="#foot_krm_1172_06">6</a></sup> भुञ्जन्-ती, देवदत्तं यज्ञदत्तः- <sup id="ref_krm_1172_07"><a href="#foot_krm_1172_07">7</a></sup> भोजयन्-न्ती, बुभुक्षन्-न्ती;</li> <li>  -- भोक्ष्यन्-न्ती-ती, भोजयिष्यन्-न्ती-ती, बुभुक्षिष्यन्-न्ती-ती;</li> <li>  -- <sup id="ref_krm_1172_08"><a href="#foot_krm_1172_08">8</a></sup> भुञ्जानः, भोजयमानः, बुभुक्षमाणः, बोभुज्यमानः;</li> <li>  भोक्ष्यमाणः, भोजयिष्यमाणः, बुभुक्षिष्यमाणः, बोभुजिष्यमाणः;</li> <li>  हुतभुक्, हव्यभुक्, <sup id="ref_krm_1172_09"><a href="#foot_krm_1172_09">9</a></sup> बलिभुक्-बलिभुजौ- <sup id="ref_krm_1172_10"><a href="#foot_krm_1172_10">10</a></sup> बलिभुजः;</li> <li>  -- -- भुक्तम्-भुक्तवान्, <sup id="ref_krm_1172_11"><a href="#foot_krm_1172_11">11</a></sup> प्रभुक्तः, भोजितः, बुभुक्षितः, बोभुजितः-तवान्;</li> <li>  <sup id="ref_krm_1172_12"><a href="#foot_krm_1172_12">12</a></sup> <sup id="ref_krm_1172_13"><a href="#foot_krm_1172_13">13</a></sup> भोजः, <sup id="ref_krm_1172_14"><a href="#foot_krm_1172_14">14</a></sup> विश्वभोजः, <sup id="ref_krm_1172_15"><a href="#foot_krm_1172_15">15</a></sup> उष्णभोजी-शीतभोजी, <sup id="ref_krm_1172_16"><a href="#foot_krm_1172_16">16</a></sup> कलहभोजी, <sup id="ref_krm_1172_17"><a href="#foot_krm_1172_17">17</a></sup> अश्राद्धभोजी, कांस्यभोजी, <sup id="ref_krm_1172_18"><a href="#foot_krm_1172_18">18</a></sup> <sup id="ref_krm_1172_19"><a href="#foot_krm_1172_19">19</a></sup> भुञ्जानः, भोजः, <sup id="ref_krm_1172_20"><a href="#foot_krm_1172_20">20</a></sup> बुभुक्षुः, बोभुजः;</li> <li>  भोक्तव्यम्, भोजयितव्यम्, बुभुक्षितव्यम्, बोभुजितव्यम्;</li> <li>  प्रनिभोजनीयम्-प्रणिभोजनीयम्, भोजनीयम्, बुभुक्षणीयम्, बोभुजनीयम्;</li> <li>  <sup id="ref_krm_1172_21"><a href="#foot_krm_1172_21">21</a></sup> भोज्यम्-भोग्यम्, भोज्यम्, बुभुक्ष्यम्, बोभुज्यम्;</li> <li>  ईषद्भोजः-दुर्भोजः-सुभोजः;</li> <li>  -- -- भुज्यमानः, भोज्यमानः, बुभुक्ष्यमाणः, बोभुज्यमानः;</li> <li>  <sup id="ref_krm_1172_22"><a href="#foot_krm_1172_22">22</a></sup> भुजः-भोगः, <sup id="ref_krm_1172_23"><a href="#foot_krm_1172_23">23</a></sup> भोगः, भोजः, बुभुक्षः, बोभुजः;</li> <li>  भोक्तुम्, <sup id="ref_krm_1172_24"><a href="#foot_krm_1172_24">24</a></sup> भोक्तुं शक्नोति, भोजयितुम्, बुभुक्षितुम्, बोभुजितुम्;</li> <li>  <sup id="ref_krm_1172_25"><a href="#foot_krm_1172_25">25</a></sup> भुक्तिः, <sup id="ref_krm_1172_26"><a href="#foot_krm_1172_26">26</a></sup> भुजिः, अन्नभोजिका, भोजना, <sup id="ref_krm_1172_27"><a href="#foot_krm_1172_27">27</a></sup> बुभुक्षा, बोभुजा;</li> <li>  भोजनम्, भोजनम्, बुभुक्षणम्, बोभुजनम्;</li> <li>  भुक्त्वा, भोजयित्वा, बुभुक्षित्वा, बोभुजित्वा;</li> <li>  उपभुज्य, उपभोज्य, प्रबुभुक्ष्य, प्रबोभुज्य;</li> <li>  <sup id="ref_krm_1172_28"><a href="#foot_krm_1172_28">28</a></sup> अग्रेभोजम्-भुक्त्वा, प्रथमं भोजं-भुक्त्वा, पूर्वं भोजं-भुक्त्वा वा व्रजति। </li> <li>भोजम् २, भुक्त्वा २, भोजम् २, भोजयित्वा २, बुभुक्षम् २, बुभुक्षित्वा २, बोभुजम् २;</li> <li>  बोभुजित्वा २;</li> <li>  <sup id="ref_krm_1172_29"><a href="#foot_krm_1172_29">29</a></sup> भुज्युः, <sup id="ref_krm_1172_30"><a href="#foot_krm_1172_30">30</a></sup> भुजिष्यम्-भुजिष्या।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1172_01"><a href="#ref_krm_1172_01">↑</a> (११६२)</li> <li id="foot_krm_1172_02"><a href="#ref_krm_1172_02">↑</a> (७-रुधादिः-१४५४। सक। अनि। पर।)</li> <li id="foot_krm_1172_03"><a href="#ref_krm_1172_03">↑</a> (श्लो। ६५)</li> <li id="foot_krm_1172_04"><a href="#ref_krm_1172_04">↑</a> [पृष्ठम्०९५७+ २५]</li> <li id="foot_krm_1172_05"><a href="#ref_krm_1172_05">↑</a> [[१। सन्नन्ते सर्वत्र ‘इको झल्’ (१-२-९) इति सनः कित्त्वे, धातुजकारस्य षकारे, तस्य ‘षढोः कः सि’ (८-२-४१) इति ककारे च रूपनिष्पत्तिर्ज्ञेया।]]</li> <li id="foot_krm_1172_06"><a href="#ref_krm_1172_06">↑</a> [[२। शतरि, शपो रुधादित्वेन श्नमि, ‘श्नसोरल्लोपः’ (६-४-१११) इति श्नमोऽकारस्य लोपे नकारस्य श्चत्वेन ञकारे च रूपमेवम्।]]</li> <li id="foot_krm_1172_07"><a href="#ref_krm_1172_07">↑</a> [[३। अभ्यवहारार्थे धातोरस्य ण्यन्तात्, ‘निगरणचलनार्थेभ्यः’ (१-३-८७) इति शतैव। ‘गतिबुद्धिप्रत्यवसानार्थ--’ (१-४-५२) इत्यादिना अणौ कर्तुः णौ कर्मसंज्ञाऽत्रेति विशेषः।]]</li> <li id="foot_krm_1172_08"><a href="#ref_krm_1172_08">↑</a> [[४। ‘भुजोऽनवने’ (१-३-६६) इत्यनेन अवनभिन्नार्थे आत्मनेपदं शानच्। ण्यन्तेऽपि पालनार्थे शानज्ज्ञेयः। सन्नन्तेऽपि पालनार्थे ‘पूर्ववत् सनः’ (१-३-६२) इति शानज्भवतीति बोध्यम्। धातूनामनेकार्थत्वात्, ‘भुञ्जाना मानुषान् भोगान् सर्वकामसमृद्धिनी।’ (रामा-अर। ४७-४), ‘बुभुजे पृथिवीपालः पृथिवीमेव केवलाम्।।’ (रघुवंशे। १५-१) इत्यादिषु, अनुभवार्थेऽपि आत्मनेपदं भवतीति बोध्यम्। स्पष्टमिदं माधवधातुवृत्तौ।]]</li> <li id="foot_krm_1172_09"><a href="#ref_krm_1172_09">↑</a> [[५। कर्मण्युपपदे ‘क्विप् च’ (३-२-७६) इति कर्तरि क्विप्। बलिभुक् = वायसः।]]</li> <li id="foot_krm_1172_10"><a href="#ref_krm_1172_10">↑</a> [[आ। ‘तूष्णीं प्रत्यभिजानते बलिभुजो भीताः स्वयूथ्यस्वरान्।।’ अनर्घराघवे ४। १।]]</li> <li id="foot_krm_1172_11"><a href="#ref_krm_1172_11">↑</a> [[६। ‘आदिकर्मणि क्तः कर्तरि च’ (३-४-७१) इति कर्तरि क्तः।’ ‘प्रभुक्तो गोरसं कृष्णः प्रभुक्तोऽनेन गोरसः।’ इति प्र। सर्वस्वे। अस्य धातोर्भक्षणार्थकत्वात् ‘क्तोऽधि- करणे च ध्रौव्यगतिप्रत्यवसानार्थेभ्यः’ (३-४-७६) इति अधिकरणेऽपि क्तप्रत्ययो बोध्यः। प्रत्यवसानार्थकाः = भक्षणार्थका धातवः।]]</li> <li id="foot_krm_1172_12"><a href="#ref_krm_1172_12">↑</a> [पृष्ठम्०९५८+ २९]</li> <li id="foot_krm_1172_13"><a href="#ref_krm_1172_13">↑</a> [[१। इगुपधलक्षणं कप्रत्ययं बाघित्वा ‘अज्विधिः सर्वधातुभ्यः पठ्यन्ते च पचादयः।’ (का। ३-१-१३४) इति वचनात् कर्तरि अच्प्रत्ययः।]]</li> <li id="foot_krm_1172_14"><a href="#ref_krm_1172_14">↑</a> [[२। विश्वं भुनक्ति इति विश्वभोजः। ‘कर्मण्यण्’ (३-२-१) इत्यण्प्रत्ययः।]]</li> <li id="foot_krm_1172_15"><a href="#ref_krm_1172_15">↑</a> [[३। ‘सुप्यजातौ णिनिस्ताच्छील्ये’ (३-२-७८) इति ताच्छील्ये णिनिप्रत्ययः। एवं शीतभोजी, कलहभोजी इत्यत्रापि ज्ञेयम्। कलहं भुनक्ति = पालयति इति कलहभोजी = नारदः।]]</li> <li id="foot_krm_1172_16"><a href="#ref_krm_1172_16">↑</a> [[आ। ‘… पुरतोऽभवत् कलहभोजिनो मुनेः।।’ च। भा। ५। ५३।]]</li> <li id="foot_krm_1172_17"><a href="#ref_krm_1172_17">↑</a> [[४। ‘व्रते’ (३-२-८०) इति णिनिप्रत्ययः। सति भोजनेऽश्राद्धमेव भुङ्क्ते इत्यत्र व्रतं गम्यते। एव कांस्यभोजी इत्यत्रापि व्रते गम्ये णिनिप्रत्यय इति ज्ञेयम्।]]</li> <li id="foot_krm_1172_18"><a href="#ref_krm_1172_18">↑</a> (भोगं)</li> <li id="foot_krm_1172_19"><a href="#ref_krm_1172_19">↑</a> [[५। ‘ताच्छील्यवयोवचनशक्तिषु चानश्’ (३-२-१२९) इति चानश्प्रत्ययः। ताच्छीलि- कोऽयं प्रत्ययः।]]</li> <li id="foot_krm_1172_20"><a href="#ref_krm_1172_20">↑</a> [[B। ‘बलात् बुभुक्षुणोत्क्षिप्य जह्रे भीमेन रक्षसा।।’ भ। का। ४। २।]]</li> <li id="foot_krm_1172_21"><a href="#ref_krm_1172_21">↑</a> [[६। ‘भोज्यं भक्ष्ये’ (७-३-६९) इति ण्यति कुत्वाभावो निपात्यते। ‘भक्ष्ये’ इत्यत्रोपल क्षणं खादनसामान्यधर्मस्य। तेन ‘भोज्या यवागूः’ इत्यत्र पानार्थकस्यापि भोज्या इति सिद्ध्यति। भक्षणादिभिन्नार्थे तु ‘चजोः कु घिण्ण्यतोः’ (७-३-५२) इति कुत्वे भोग्यः = कम्बलः इति सिद्ध्यति।]]</li> <li id="foot_krm_1172_22"><a href="#ref_krm_1172_22">↑</a> [[७। ‘भुजन्युब्जौ पाण्युपतापयोः’ (७-३-६१) इति पाणावभिधेये घञि कुत्वाभावः, गुणाभावश्च निपात्यते। भुज्यतेऽनेनेति भुजः = पाणिः। ‘बाहावभिधेये भुज इति प्रयोगो लाक्षणिकः।’ इति बृहच्छब्देन्दुशेखरे स्फुटम्। भुजादन्यत्र घञि कुत्वे भोगः = शरीरम्।]]</li> <li id="foot_krm_1172_23"><a href="#ref_krm_1172_23">↑</a> [[८। ‘हलश्च’ (३-३-१२१) इति संज्ञायां घञ्। भोगः = स्त्रीभोगाज्जातोऽक्षिरोगविशेषः। कारणे कार्योपचारोऽत्र। भोगः = सर्पकायश्च।]]</li> <li id="foot_krm_1172_24"><a href="#ref_krm_1172_24">↑</a> [[९। पूर्वकालत्वाभावेऽपि शक्नोत्यर्थे ‘शकधृषज्ञा--’ (३-४-६५) इति तुमुन्प्रत्ययः।]]</li> <li id="foot_krm_1172_25"><a href="#ref_krm_1172_25">↑</a> [पृष्ठम्०९५९+ २६]</li> <li id="foot_krm_1172_26"><a href="#ref_krm_1172_26">↑</a> [[१। ‘इक् कृष्यादिभ्यः’ (वा। ३-३-१०८) इति भावे इक्प्रत्ययः। अन्नभोजिका इत्यत्र उत्पत्तिरूपार्थे ‘पर्यायार्हर्णोत्पत्तिषु ण्वुच्’ (३-३-१११) इति स्त्रियां ण्वुच्। ‘पाचिका मे त्वया देया प्रोत्पन्ना मेऽन्नभोजिका।।’ इति प्र। सर्वस्वे।]]</li> <li id="foot_krm_1172_27"><a href="#ref_krm_1172_27">↑</a> [[आ। ‘अस्मानत्तुमितोऽभ्येति परिग्लानो बुभुक्षया।।’ भ। का। ७। ८४।]]</li> <li id="foot_krm_1172_28"><a href="#ref_krm_1172_28">↑</a> [[२। ‘विभाषाऽग्रेप्रथमपूर्वेषु’ (३-४-२४) इति अग्रेप्रथमपूर्वशब्देषूपपदेषु समानकर्तृकयोः पूर्वकाले क्त्वाणमुलौ विकल्पेन भवतः।]]</li> <li id="foot_krm_1172_29"><a href="#ref_krm_1172_29">↑</a> [[३। ‘भुजिमृङ्भ्याम्--’ (द। उ। १-१३५) इति युक्प्रत्ययः। भुज्युः = गन्धर्वः।]]</li> <li id="foot_krm_1172_30"><a href="#ref_krm_1172_30">↑</a> [[४। ‘रुचिभुजिभ्यां किष्यन्’ (द। उ। ८-१५) इति किष्यन्प्रत्ययः। भुजिष्यम् = भोग्यम्। भुजिष्या = दासी।]]</li></ul></p>

भुजो|भोजकः-जिका|बुभुक्षकः-क्षिका|बोभुजकः-जिका|भुग्नः-भुग्नवान्|विभुजन्-न्ती-ती|मूलविभुजः|भुजः|भोगः
<ul><li><sup id="ref_krm_1173_01"><a href="#foot_krm_1173_01">1</a></sup> {@“भुजो कौटिल्ये”@} <sup id="ref_krm_1173_02"><a href="#foot_krm_1173_02">2</a></sup> ‘भुजेद् भुनक्ति भुङ्क्ते स्युः कौटिल्ये पालनेऽदने।’ <sup id="ref_krm_1173_03"><a href="#foot_krm_1173_03">3</a></sup> इति देवः। </li> <li>भोजकः-जिका, भोजकः-जिका, बुभुक्षकः-क्षिका, बोभुजकः-जिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि प्रातिस्विकरूपाणि विना रौधादिकभुजधातुवत् <sup id="ref_krm_1173_04"><a href="#foot_krm_1173_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1173_05"><a href="#foot_krm_1173_05">5</a></sup> भुग्नः <sup id="ref_krm_1173_06"><a href="#foot_krm_1173_06">6</a></sup> -भुग्नवान्, <sup id="ref_krm_1173_07"><a href="#foot_krm_1173_07">7</a></sup> विभुजन्-न्ती-ती, <sup id="ref_krm_1173_08"><a href="#foot_krm_1173_08">8</a></sup> मूलविभुजः, <sup id="ref_krm_1173_09"><a href="#foot_krm_1173_09">9</a></sup> <sup id="ref_krm_1173_10"><a href="#foot_krm_1173_10">10</a></sup> भुजः, <sup id="ref_krm_1173_11"><a href="#foot_krm_1173_11">11</a></sup> भोगः;</li> <li>  इमानि रूपाण्यधिकान्यत्रेति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1173_01"><a href="#ref_krm_1173_01">↑</a> (११६३)</li> <li id="foot_krm_1173_02"><a href="#ref_krm_1173_02">↑</a> (६-तुदादिः-१४१७। अक। अनि। पर।)</li> <li id="foot_krm_1173_03"><a href="#ref_krm_1173_03">↑</a> (श्लो। ६५)</li> <li id="foot_krm_1173_04"><a href="#ref_krm_1173_04">↑</a> (११६२)</li> <li id="foot_krm_1173_05"><a href="#ref_krm_1173_05">↑</a> [[५। धातोरस्य, ओदित्त्वेन, ‘ओदितश्च’ (८-२-४४) इति निष्ठानत्वम्।]]</li> <li id="foot_krm_1173_06"><a href="#ref_krm_1173_06">↑</a> [[B। ‘महाभराभुग्नशिरः सहस्रसाहायकव्यग्रभुजं प्रसस्रे।।’ शि। व। ३। २५।]]</li> <li id="foot_krm_1173_07"><a href="#ref_krm_1173_07">↑</a> [[६। शतरि, तुदादित्वाच्छप्रत्यये तस्य ङिद्वद्भावेनाङ्गस्य गुणो न। स्त्रियां नुम्विकल्प इति विशेषः।]]</li> <li id="foot_krm_1173_08"><a href="#ref_krm_1173_08">↑</a> [[७। मूलानि विभुजतीति मूलविभुजः = रथः। ‘कप्रकरणे--मूलविभुजादिभ्य उपसंख्यानम्’ (वा। ३-२-५) इति कर्मण्यणोऽपवादः कप्रत्ययः।]]</li> <li id="foot_krm_1173_09"><a href="#ref_krm_1173_09">↑</a> [पृष्ठम्०९६०+ २७]</li> <li id="foot_krm_1173_10"><a href="#ref_krm_1173_10">↑</a> [[१। इगुपधलक्षणे कर्तरि कप्रत्यये रूपमेवम्।]]</li> <li id="foot_krm_1173_11"><a href="#ref_krm_1173_11">↑</a> [[२। ‘हलश्च’ (३-३-१२१) इति संज्ञायां घञि ‘चजोः कु--’ (७-३-५२) इति कुत्वे च रूपमेवम्। ‘भोगः = सर्पकायः।’ इति क्षीरस्वामी। “अथवा भोग- शब्दः शरीरवाच्यपि दृश्यते। तद्यथा-- ‘अहिरिव भोगैः पर्येति बाहुम्--’ (ऋ। वे। ६-७५-१४) अहिरिव शरीरैरिति गम्यते” इति भाष्य (५-१-९) वचनप्रामाण्यात् शरीरसामान्ये भोगशब्दस्य वृत्तिरिति गम्यते।]]</li></ul></p>

भुवोऽवकल्कने|भावकः-विका|बिभावयिषकः-षिका|भावयिता-त्री|बिभावयिषिता-त्री|भावयन्-न्ती|बिभावयिषन्-न्ती|भावयिष्यन्-न्ती-ती|बिभावयिषिष्यन्-न्ती-ती|भावयमानः|बिभावयिषमाणः|भावयिष्यमाणः|बिभावयिषिष्यमाणः|बिभावयिट्-यिषौ-यिषः|भावितम्-तः|बिभावयिषितः-तवान्|भावः|भावुकः|भावनः|बिभावयिषुः|भावयितव्यम्|बिभावयिषितव्यम्|भावनीयम्|बिभावयिषणीयम्|भाव्यम्|बिभावयिष्यम्|ईषद्भावः-|दुर्भावः-सुभावः|ईषद्बिभावयिषः-दुर्बिभावयिषः-सुबिभावयिषः|भाव्यमानः|बिभावयिष्यमाणः|बिभावयिषः|भावयितुम्|बिभावयिषितुम्|भावना|बिभावयिषा|भावनम्|बिभावयिषणम्|भावयित्वा|बिभावयिषित्वा|प्रभाव्य|प्रबिभावयिष्य|भावम्|बिभावयिषम्
<ul><li><sup id="ref_krm_1174_01"><a href="#foot_krm_1174_01">1</a></sup> {@“भुवोऽवकल्कने”@} <sup id="ref_krm_1174_02"><a href="#foot_krm_1174_02">2</a></sup> “अवकल्कनम् = मिश्रीकरणम्। </li> <li>भावयति दध्नौदनम्। </li> <li>अनित्यण्यन्तत्वार्था पञ्चमी। </li> <li>‘विकल्कने’ इति नन्दी। </li> <li>‘भावयेद् ब्राह्मणं तपः।’ --” इति क्षीरस्वामी। </li> <li>“अवकल्कनं = चिन्तनम्। </li> <li>इति काश्यपः। </li> <li>क्वचित् स्वामिग्रन्थेऽनुकल्कनम्-इति पठित्वा, ‘अनुकल्कनम् = मिश्रीकरणम्।’ इति द्वश्यते। </li> <li>…विकल्कनम् = विपाचनम् <sup id="ref_krm_1174_03"><a href="#foot_krm_1174_03">3</a></sup> उदाहृतम्। </li> <li>तस्यान्न- विशेष्यकत्वेन विपक्वीकरणार्थे वृत्तिरस्य धातोः इति काशिकासम्मतमिति ज्ञेयम्।]] विपक्वी- करणम्।) तथा च प्रयुज्यते-- ‘तपो भावितमात्मानम्--’ इति। </li> <li>‘-- अवकल्पने’ इत्यपरे। </li> <li>तथा च धनपालः…” इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>‘मूलशुद्धिस्त्वत्र कीदृशी? इति न विद्मः।’ इति पुरुषकारः। </li> <li>‘सत्तायां भवति, प्राप्तौ णिचि भावयते तङि। </li> <li>भवते शपि, तत्रैव भावयत्यवकल्कने।।’ <sup id="ref_krm_1174_04"><a href="#foot_krm_1174_04">4</a></sup> इति देवः। </li> <li>भावकः-विका, <sup id="ref_krm_1174_05"><a href="#foot_krm_1174_05">5</a></sup> बिभावयिषकः-षिका, भावयिता-त्री, बिभावयिषिता-त्री;</li> <li>  <sup id="ref_krm_1174_06"><a href="#foot_krm_1174_06">6</a></sup> भावयन्-न्ती, बिभावयिषन्-न्ती;</li> <li>  भावयिष्यन्-न्ती-ती, बिभावयिषिष्यन्-न्ती-ती;</li> <li>  <sup id="ref_krm_1174_07"><a href="#foot_krm_1174_07">7</a></sup> भावयमानः, बिभावयिषमाणः;</li> <li>  भावयिष्यमाणः, बिभावयिषिष्यमाणः, बिभावयिट्-यिषौ-यिषः;</li> <li>  <sup id="ref_krm_1174_08"><a href="#foot_krm_1174_08">8</a></sup> भावितम्-तः, बिभावयिषितः-तवान्;</li> <li>  भावः, <sup id="ref_krm_1174_09"><a href="#foot_krm_1174_09">9</a></sup> भावुकः, <sup id="ref_krm_1174_10"><a href="#foot_krm_1174_10">10</a></sup> भावनः, बिभावयिषुः;</li> <li>  भावयितव्यम्, बिभावयिषितव्यम्;</li> <li>  भावनीयम्, बिभावयिषणीयम्;</li> <li>  भाव्यम्, बिभावयिष्यम्;</li> <li>  ईषद्भावः- दुर्भावः-सुभावः;</li> <li>  ईषद्बिभावयिषः-दुर्बिभावयिषः-सुबिभावयिषः;</li> <li>  भाव्यमानः, बिभावयिष्यमाणः;</li> <li>  भावः, बिभावयिषः;</li> <li>  भावयितुम्, बिभावयिषितुम्;</li> <li>  भावना, बिभावयिषा;</li> <li>  भावनम्, बिभावयिषणम्;</li> <li>  भावयित्वा, बिभावयिषित्वा;</li> <li>  प्रभाव्य, प्रबिभावयिष्य;</li> <li>  भावम् २, भावयित्वा २, बिभावयिषम् २;</li> <li>  बिभावयिषित्वा २। इति रूपाण्यस्य भवन्ति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1174_01"><a href="#ref_krm_1174_01">↑</a> (११६४)</li> <li id="foot_krm_1174_02"><a href="#ref_krm_1174_02">↑</a> (१०-चुरादिः-१७४८। सक। सेट्। उभ।)</li> <li id="foot_krm_1174_03"><a href="#ref_krm_1174_03">↑</a> (= [[३। ‘प्रभावुकमन्नं भवति।’ इति काशिकायाम् (३-२-१५४)</li> <li id="foot_krm_1174_04"><a href="#ref_krm_1174_04">↑</a> (श्लो। ३)</li> <li id="foot_krm_1174_05"><a href="#ref_krm_1174_05">↑</a> [[४। ण्यन्तात् सनि, ‘ओः पुयण्ज्यपरे’ (७-४-८०) इत्यभ्यासे इकारः। एवमुत्तरत्रापि ज्ञेयम्।]]</li> <li id="foot_krm_1174_06"><a href="#ref_krm_1174_06">↑</a> [[५। ‘भू अवकल्कने’ इति पठितव्ये सति, ‘भुवोऽवकल्कने’ इति पाठः ‘अनित्य- ण्यन्तत्वार्थं पञ्चमी।’ इति ज्ञापयतीत्याहुः। तेन णिजभावपक्षे, धातोश्चिन्तनार्थकत्वे- अकर्मकत्वेन, चिन्तनस्य च चित्तवत्कर्तृकत्वेन ‘अणावकर्मकात् चित्तवत्कर्तृकात्’ (१-३-८७) इति ण्यन्तात् परस्मैपदमेव। मिश्रीकरणाद्यर्थान्तरे तु यथासम्भवमात्म- नेपदमपि धातोरस्य भवतीत्यपि बोध्यम्।]]</li> <li id="foot_krm_1174_07"><a href="#ref_krm_1174_07">↑</a> [पृष्ठम्०९६१+ २८]</li> <li id="foot_krm_1174_08"><a href="#ref_krm_1174_08">↑</a> [[आ। ‘रोषान्ध्यभावितमसृग्भिरकल्पयत् तं कृष्णोऽपि नाकिजनराकितलाग्यवीर्यः।।’ धा। का। ३। ४१।]]</li> <li id="foot_krm_1174_09"><a href="#ref_krm_1174_09">↑</a> [[१। तच्छीलतद्धर्मतत्साधुकारिष्वर्थेषु ‘लषपतपदस्थाभूवृष--’ (३-२-१५४) इत्यनेन उकञ्प्रत्ययः। ‘णेरनिटि’ (६-४-५१) इति णिलोपः। ‘न वाचमवमन्यन्ते नर्तकीमिव भावुकाः।।’ (या। अ। १-७) इत्यत्र, “भावुकाः = भावनाकृतो भगवद्भक्ताः। ‘भुवोऽवकल्कने’ इति भवतेर्णिजन्तात् ‘लषपत--’ (३-२-१५४) इत्यादिना उकञ्प्रत्ययः। ‘अवकल्कनम् = चिन्तनम्।’ इति व्याख्यातम्।” इति अप्पय्यदी- क्षितोक्तेः धातोरस्यैवोकञ्विधायके सूत्रे ग्रहणमित्यपि ज्ञायते।]]</li> <li id="foot_krm_1174_10"><a href="#ref_krm_1174_10">↑</a> [[२। ण्यन्तादस्मात् नन्द्यादेराकृतिगणत्वात् कर्तरि ल्युः। भावनः = चिन्तकः। (अत्र भावितम् इति मिश्रीकरणार्थे धातोर्वृत्तिरिति ज्ञेयम्)]]</li></ul></p>

