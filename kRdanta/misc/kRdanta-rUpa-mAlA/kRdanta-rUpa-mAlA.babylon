<ul><li><sup id="ref_krm_0309_01"><a href="#foot_krm_0309_01">1</a></sup> {@“क्षि क्षये”@} <sup id="ref_krm_0309_02"><a href="#foot_krm_0309_02">2</a></sup> ‘क्षये क्षयति, हिंसायां क्षिणातीति षितो भवेत्।। </li> <li>निवासगत्योः क्षियति, क्षिणोत्यावगुणे क्षिणोः।’ <sup id="ref_krm_0309_03"><a href="#foot_krm_0309_03">3</a></sup> इति देवः। </li> <li>‘औ = उविकरणे अगुणे = ‘संज्ञापूर्वको विधिरनित्यः’ <sup id="ref_krm_0309_04"><a href="#foot_krm_0309_04">4</a></sup> इति गुणाभावे च सति, ‘क्षणु हिंसायाम्, क्षिणु च’ इति मैत्रेयरक्षिता- द्युक्तस्य धातोः क्षिणोतीति भवति।’ इति पुरुषकारे कृष्णलीलाशुकमुनिः। </li> <li><sup id="ref_krm_0309_05"><a href="#foot_krm_0309_05">5</a></sup> <sup id="ref_krm_0309_06"><a href="#foot_krm_0309_06">6</a></sup> क्षायकः-यिका, <sup id="ref_krm_0309_07"><a href="#foot_krm_0309_07">7</a></sup> क्षायकः-यिका, <sup id="ref_krm_0309_08"><a href="#foot_krm_0309_08">8</a></sup> चिक्षीषकः-षिका, <sup id="ref_krm_0309_09"><a href="#foot_krm_0309_09">9</a></sup> चेक्षीयकः-यिका;</li> <li>  <sup id="ref_krm_0309_10"><a href="#foot_krm_0309_10">10</a></sup> क्षेता-त्री, क्षाययिता-त्री, चिक्षीषिता-त्री, चेक्षीयिता-त्री;</li> <li>  <sup id="ref_krm_0309_11"><a href="#foot_krm_0309_11">11</a></sup> क्षयन्-न्ती, क्षाययन्-न्ती, चिक्षीषन्-न्ती;</li> <li>  -- क्षेष्यन्-न्ती-ती, क्षाययिष्यन्-न्ती-ती, चिक्षीषिष्यन्-न्ती-ती;</li> <li>  -- -- क्षाययमाणः, क्षाययिष्यमाणः, -- चेक्षीयमाणः, चेक्षीयिष्यमाणः;</li> <li>  <sup id="ref_krm_0309_12"><a href="#foot_krm_0309_12">12</a></sup> प्रक्षित्-प्रक्षितौ-प्रक्षितः, <sup id="ref_krm_0309_13"><a href="#foot_krm_0309_13">13</a></sup> महीक्षित्;</li> <li>  -- -- <sup id="ref_krm_0309_14"><a href="#foot_krm_0309_14">14</a></sup> क्षितम्-क्षितः-क्षितवान्, <sup id="ref_krm_0309_15"><a href="#foot_krm_0309_15">15</a></sup> क्षीणः- <sup id="ref_krm_0309_16"><a href="#foot_krm_0309_16">16</a></sup> क्षीणवान्, <sup id="ref_krm_0309_17"><a href="#foot_krm_0309_17">17</a></sup> प्रक्षीणः-आक्षीणः;</li> <li>  परिक्षीणः, <sup id="ref_krm_0309_18"><a href="#foot_krm_0309_18">18</a></sup> क्षितायुः-क्षीणायुः <sup id="ref_krm_0309_19"><a href="#foot_krm_0309_19">19</a></sup>, क्षीणः क्षितो वा <sup id="ref_krm_0309_20"><a href="#foot_krm_0309_20">20</a></sup>, क्षायितम्-तः, चिक्षीषितः, चेक्षीयितः-तवान्;</li> <li>  <sup id="ref_krm_0309_21"><a href="#foot_krm_0309_21">21</a></sup> <sup id="ref_krm_0309_22"><a href="#foot_krm_0309_22">22</a></sup> क्षयः, <sup id="ref_krm_0309_23"><a href="#foot_krm_0309_23">23</a></sup> क्षयी, <sup id="ref_krm_0309_24"><a href="#foot_krm_0309_24">24</a></sup> क्षयिष्णुः, क्षायः, चिक्षीषुः, <sup id="ref_krm_0309_25"><a href="#foot_krm_0309_25">25</a></sup> चेक्षियः;</li> <li>  क्षेतव्यम्, क्षाययितव्यम्, चिक्षीषितव्यम्, चेक्षीयितव्यम्;</li> <li>  क्षयणीयम्, क्षायणीयम्, चिक्षीषणीयम्, चेक्षीयणीयम्;</li> <li>  <sup id="ref_krm_0309_26"><a href="#foot_krm_0309_26">26</a></sup> क्षय्यम्-क्षेयम्, क्षाय्यम्, चिक्षीष्यम्, चेक्षीय्यम्;</li> <li>  ईषत्क्षयः-दुःक्षयः-सुक्षयः;</li> <li>  -- -- -- <sup id="ref_krm_0309_27"><a href="#foot_krm_0309_27">27</a></sup> क्षीयमाणः, क्षाय्यमाणः, चिक्षीष्यमाणः, चेक्षीय्यमाणः;</li> <li>  क्षयः, क्षायः, चिक्षीषः, चेक्षीयः;</li> <li>  क्षेतुम्, क्षाययितुम्, चिक्षीषितुम्, चेक्षीयितुम्;</li> <li>  <sup id="ref_krm_0309_28"><a href="#foot_krm_0309_28">28</a></sup> क्षिया, क्षायणा, चिक्षीषा, चेक्षीया;</li> <li>  क्षयणम्, क्षायणम्, चिक्षीषणम्, चेक्षीयणम्;</li> <li>  क्षित्वा, क्षाययित्वा, चिक्षीषित्वा, चेक्षीयित्वा;</li> <li>  <sup id="ref_krm_0309_29"><a href="#foot_krm_0309_29">29</a></sup> प्रक्षीय, प्रक्षाय्य, प्रचिक्षीष्य, प्रचेक्षीय्य;</li> <li>  क्षायम् २, क्षित्वा २, क्षायम् २, क्षाययित्वा २, चिक्षीषम् २, चिक्षीषित्वा २, चेक्षीयम्;</li> <li>  चेक्षीयित्वा।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0309_01"><a href="#ref_krm_0309_01">↑</a> (३०२)</li> <li id="foot_krm_0309_02"><a href="#ref_krm_0309_02">↑</a> (१-भ्वादिः-२३६। अक। अनि। पर।)</li> <li id="foot_krm_0309_03"><a href="#ref_krm_0309_03">↑</a> (श्लो। १२-१३)</li> <li id="foot_krm_0309_04"><a href="#ref_krm_0309_04">↑</a> (परिभाषा-९५)</li> <li id="foot_krm_0309_05"><a href="#ref_krm_0309_05">↑</a> [पृष्ठम्०३१६+ २४]</li> <li id="foot_krm_0309_06"><a href="#ref_krm_0309_06">↑</a> [[१। ‘अचो ञ्णिति’ (७-२-११५) इतीकारस्य वृद्धौ, आयादेशः।]]</li> <li id="foot_krm_0309_07"><a href="#ref_krm_0309_07">↑</a> [[२। ण्यन्ताण्ण्वुलि णिनिमित्तकवृद्धौ सत्यां, ‘णेरनिटि’ (६-४-५१) इति णिलोपे आयादेशे च रूपम्। एवं ण्यन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0309_08"><a href="#ref_krm_0309_08">↑</a> [[३। ‘अज्झनगमां सनि’ (६-४-१६) इति दीर्घः। ‘इको झल्’ (१-२-९) इति सनः कित्त्वम्। तेन गुणो न। एवं सन्नन्ते सर्वत्र बोध्यम्।]]</li> <li id="foot_krm_0309_09"><a href="#ref_krm_0309_09">↑</a> [[४। यङन्तात्, ‘अकृतत्सार्वधातुकयोः--’ (७-४-२५) इति दीर्घः। ‘गुणो यङ्लुकोः’ (७-४-८२) इत्यभ्यासस्य गुणः।]]</li> <li id="foot_krm_0309_10"><a href="#ref_krm_0309_10">↑</a> [[५। अस्य धातोरनुदात्तत्वादिडागमो न भवति। एवं स्यादिप्रत्ययेष्वपि बोध्यम्।]]</li> <li id="foot_krm_0309_11"><a href="#ref_krm_0309_11">↑</a> [[६। ‘कर्तरि शप्’ (३-१-६८) इति शप्प्रत्यये गुणायादेशौ भवतः।]]</li> <li id="foot_krm_0309_12"><a href="#ref_krm_0309_12">↑</a> [[७। क्विपि, ‘ह्रस्वस्य पिति कृति--’ (६-१-७१) इति तुक्।]]</li> <li id="foot_krm_0309_13"><a href="#ref_krm_0309_13">↑</a> [[८। क्षीरस्वामी भ्वादावेवान्यत्र ‘क्षि ऐश्वर्ये’ इति पठति। तन्मते मह्यां क्षयति = ईष्टे इति महीक्षित् = राजा इति शब्दनिष्पत्तिर्ज्ञेया।]]</li> <li id="foot_krm_0309_14"><a href="#ref_krm_0309_14">↑</a> [[९। ‘निष्ठायामण्यदर्थे’ (६-४-६०) इत्यत्र ‘अण्यदर्थे’ इत्युक्तत्वात् भावकर्मवाचिनि निष्ठाप्रत्यये दीर्घो न भवति।]]</li> <li id="foot_krm_0309_15"><a href="#ref_krm_0309_15">↑</a> [[१०। कर्तरि निष्ठायाम्, ‘निष्ठायामण्यदर्थे’ (६-४-६०) इति दीर्घे, ‘क्षियो दीर्घात्’ (८-२-४६) इति निष्ठानत्वे, ‘अट्कुप्वाङ्नुम्--’ (८-४-२) इति णत्वे च रूपम्।]]</li> <li id="foot_krm_0309_16"><a href="#ref_krm_0309_16">↑</a> [[आ। ‘विस्फूर्जदक्षीणघनाघनोपमक्षीजा लजन्तस्त्रिदशानलाञ्जितान्। लाजादिहोतृष्वपि लञ्जनप्रदा यस्मिन् विनेशुर्जजनेषु दानवाः।।’ धा। का। १-३२।]]</li> <li id="foot_krm_0309_17"><a href="#ref_krm_0309_17">↑</a> [[११। ‘आदिकर्मणि क्तः कर्तरि च’ (३-४-७१) इति कर्तरि क्तः।]]</li> <li id="foot_krm_0309_18"><a href="#ref_krm_0309_18">↑</a> [[१२। ‘वाऽऽक्रोशदैन्ययोः’ (६-४-६१) इति दीर्घविकल्पः। दीर्घपक्षे निष्ठानत्वम्। दीर्घाभावे निष्ठानत्वाभावः।]]</li> <li id="foot_krm_0309_19"><a href="#ref_krm_0309_19">↑</a> [वा भव]</li> <li id="foot_krm_0309_20"><a href="#ref_krm_0309_20">↑</a> [तपस्वी]</li> <li id="foot_krm_0309_21"><a href="#ref_krm_0309_21">↑</a> [पृष्ठम्०३१७+ २४]</li> <li id="foot_krm_0309_22"><a href="#ref_krm_0309_22">↑</a> [[आ। ‘भयसंहृष्टरोमाणः ततस्तेऽपचितद्विषः। क्षणेन क्षीणविकान्ताः कपिनाऽनेषत क्षयम्।।’ भ। का। ९-२२।]]</li> <li id="foot_krm_0309_23"><a href="#ref_krm_0309_23">↑</a> [[१। ‘जिदृक्षिविश्रीण्--’ (३-२-१५७) इत्यादिना तच्छीलादिषु कर्तृषु इनिः।]]</li> <li id="foot_krm_0309_24"><a href="#ref_krm_0309_24">↑</a> [[२। ‘भुवश्च’ (३-२-१३८) इत्यत्र, अनुक्तसमुच्चयार्थकचकारेणास्यापि इष्णुच् ताच्छीलिकः।]]</li> <li id="foot_krm_0309_25"><a href="#ref_krm_0309_25">↑</a> [[३। यङन्तात् पचाद्यचि (३-१-१३४), ‘यङोऽचि च’ (२-४-७४) इति लुकि, इकारस्य संयोगपूर्वकत्वात् ‘अचि श्नुधातु--’ (६-४-७७) इत्यनेन इयङ्।]]</li> <li id="foot_krm_0309_26"><a href="#ref_krm_0309_26">↑</a> [[४। ‘क्षय्यजय्यौ शक्यार्थे’ (६-१-८१) इत्यनेन यति अयादेशो निपात्यते। शक्या- र्थादन्यत्र यति, गुणे क्षेयम् इत्येव। क्षेयम् = पापम्।]]</li> <li id="foot_krm_0309_27"><a href="#ref_krm_0309_27">↑</a> [[५। यकि, ‘अकृत्सार्वधातुकयोः’ (७-४-२५) इति दीर्घः।]]</li> <li id="foot_krm_0309_28"><a href="#ref_krm_0309_28">↑</a> [[६। भिदादिपाठात् ‘षिद् भिदादिभ्यः--’ (३-३-१०४) इत्यङ्। इयङादेशः।]]</li> <li id="foot_krm_0309_29"><a href="#ref_krm_0309_29">↑</a> [[७। ‘क्षियः’ (६-४-५९) इति ल्यपि दीर्घः।]]</li></ul></p>

क्षि
<ul><li><sup id="ref_krm_0310_01"><a href="#foot_krm_0310_01">1</a></sup> {@“क्षि हिंसायाम्”@} <sup id="ref_krm_0310_02"><a href="#foot_krm_0310_02">2</a></sup> छान्दसः। </li> <li>‘क्षये क्षयति, हिंसायां क्षिणातीति षितो भवेत्।। </li> <li>निवासगत्योः क्षियति, क्षिणोत्यावगुणे क्षिणोः।’ <sup id="ref_krm_0310_03"><a href="#foot_krm_0310_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_0310_04"><a href="#foot_krm_0310_04">4</a></sup> ‘चिरिणोति रिणोत्येवं क्षिणोति जिरिणोति च। </li> <li>दाश्नोति च दृणोत्याहुः पदानि छान्दसानि षट्।।’ <sup id="ref_krm_0310_05"><a href="#foot_krm_0310_05">5</a></sup> इति भट्टमल्लः। </li> <li>‘अयं धातुः भाषायामपि प्रयोगार्हः। </li> <li>अत एव, ‘न तद्यशः क्षत्रभृतां क्षिणोति।’ <sup id="ref_krm_0310_06"><a href="#foot_krm_0310_06">6</a></sup>, ‘इमां हृदि व्यायतपातमक्षिणोत्।’ <sup id="ref_krm_0310_07"><a href="#foot_krm_0310_07">7</a></sup>, ‘--पञ्चबाणः क्षिणोति।’ <sup id="ref_krm_0310_08"><a href="#foot_krm_0310_08">8</a></sup> इत्यादिप्रयोगाः सङ्गच्छन्ते।’ इति मैत्रेयरक्षितादयः। </li> <li>एतेषां मते तनादिषु ‘क्षिणु’ इति पाठः नास्तीति गम्यते। </li> <li>अस्य स्वादौ पाठात् <sup id="ref_krm_0310_09"><a href="#foot_krm_0310_09">9</a></sup> क्षिण्वन् <sup id="ref_krm_0310_10"><a href="#foot_krm_0310_10">10</a></sup> -ती, इति शतरि रूपमिति विशेषः। </li> <li>अन्यानि सर्वाणि रूपाणि भौवादिकक्षि <sup id="ref_krm_0310_11"><a href="#foot_krm_0310_11">11</a></sup> धातुवत् बोध्यानि। </li> <li>क्षीरस्वामी तु ‘ऋक्षि’ इति, अजादिमिदितं च धातुममुं पठति। </li> <li>तन्मते ऋङ्क्ष्णुवन्-ती, इत्यादीनि रूपाण्यूह्यानि। </li> <li>केचित्तु ‘ऋक्ष’ इत्यनिदितं पठन्ति। </li> <li>तेषां मते, ऋक्ष्णुवन्-ती, इत्यादीनि रूपाण्यूह्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0310_01"><a href="#ref_krm_0310_01">↑</a> (३०३)</li> <li id="foot_krm_0310_02"><a href="#ref_krm_0310_02">↑</a> (५-स्वादिः-१२७६। सक। अनि। पर।)</li> <li id="foot_krm_0310_03"><a href="#ref_krm_0310_03">↑</a> (श्लो। १२-१३)</li> <li id="foot_krm_0310_04"><a href="#ref_krm_0310_04">↑</a> [पृष्ठम्०३१८+ २३]</li> <li id="foot_krm_0310_05"><a href="#ref_krm_0310_05">↑</a> (श्लो। १-७७ आख्यातचन्द्रिका)</li> <li id="foot_krm_0310_06"><a href="#ref_krm_0310_06">↑</a> (रघुवंशे)</li> <li id="foot_krm_0310_07"><a href="#ref_krm_0310_07">↑</a> (रघुवंशे)</li> <li id="foot_krm_0310_08"><a href="#ref_krm_0310_08">↑</a> (शाकुन्तले)</li> <li id="foot_krm_0310_09"><a href="#ref_krm_0310_09">↑</a> [[आ। ‘तामातिक्य पदे पदेन चिबुके चातिग्नुबन् पाणिना चक्रे सध्नुवतां वधे दधृगसावृज्वीं मनोज्ञाकृतिम्। किं चादभ्नुवतीमिमां मम गृहानेहीति याच्ञापरा- मेष्यामीत्यमुचत् समृद्धकरुणः क्षिण्वन् कटाक्षैर्धृतिम्।।’ धा। का। २-७०।]]</li> <li id="foot_krm_0310_10"><a href="#ref_krm_0310_10">↑</a> [[१। ‘स्वादिभ्यः--’ (३-१-७३) इति श्नुः विकरणप्रत्ययः। ‘हुश्नुवोः सार्वधातुके’ (६-४-८७) इति यण्। णत्वम्।]]</li> <li id="foot_krm_0310_11"><a href="#ref_krm_0310_11">↑</a> (३०२)</li></ul></p>

क्षि|क्षायकः-यिका|चिक्षीषकः-षिका|चेक्षीयकः-यिका
<ul><li><sup id="ref_krm_0311_01"><a href="#foot_krm_0311_01">1</a></sup> {@“क्षि निवासगत्योः”@} <sup id="ref_krm_0311_02"><a href="#foot_krm_0311_02">2</a></sup> ‘क्षये क्षयति, हिंसायां क्षिणातीति षितो भवेत्।। </li> <li>निवासगत्योः क्षियति, क्षिणोत्यावणुणे क्षिणोः।’ <sup id="ref_krm_0311_03"><a href="#foot_krm_0311_03">3</a></sup> इति देवः। </li> <li>क्षायकः-यिका, क्षायकः-यिका, चिक्षीषकः-षिका, चेक्षीयकः-यिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकक्षि <sup id="ref_krm_0311_04"><a href="#foot_krm_0311_04">4</a></sup> धातुवत् ज्ञेयानि। </li> <li><sup id="ref_krm_0311_05"><a href="#foot_krm_0311_05">5</a></sup> <sup id="ref_krm_0311_06"><a href="#foot_krm_0311_06">6</a></sup> क्षियन्-न्ती-ती, <sup id="ref_krm_0311_07"><a href="#foot_krm_0311_07">7</a></sup> क्षेत्रम्, <sup id="ref_krm_0311_08"><a href="#foot_krm_0311_08">8</a></sup> क्षितिः, <sup id="ref_krm_0311_09"><a href="#foot_krm_0311_09">9</a></sup> <sup id="ref_krm_0311_10"><a href="#foot_krm_0311_10">10</a></sup> उत्क्षीणः, इत्यादीनि रूपाण्यस्य धातोः भवन्तीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0311_01"><a href="#ref_krm_0311_01">↑</a> (३०४)</li> <li id="foot_krm_0311_02"><a href="#ref_krm_0311_02">↑</a> (६-तुदादिः-१०४७। सक। अनि। पर।)</li> <li id="foot_krm_0311_03"><a href="#ref_krm_0311_03">↑</a> (श्लो। १२-१३)</li> <li id="foot_krm_0311_04"><a href="#ref_krm_0311_04">↑</a> (३०२)</li> <li id="foot_krm_0311_05"><a href="#ref_krm_0311_05">↑</a> [पृष्ठम्०३१९+ २३]</li> <li id="foot_krm_0311_06"><a href="#ref_krm_0311_06">↑</a> [[१। ‘तुदादिभ्यः--’ (३-१-७७) इति शः। शस्य ङिद्वद्भावादङ्गस्य गुणो न। ‘अचि श्नुधातु--’ (६-४-७७) इतीयङ्। स्त्रियाम्, ‘आच्छीनद्योर्नुम्’ (७-१-८०) इति नुमो वैकल्पिकत्वाद्रूपद्वयम्।]]</li> <li id="foot_krm_0311_07"><a href="#ref_krm_0311_07">↑</a> [[२। ‘कृत्यल्युटो बहुलम्’ (३-३-११३) इति बाहुलकात् अधिकरणे ष्ट्रन्प्रत्ययः। क्षेत्रम् = निवासस्थानम्।]]</li> <li id="foot_krm_0311_08"><a href="#ref_krm_0311_08">↑</a> [[३। अधिकरणे स्त्रियां क्तिन्। क्षियन्ति अस्यां जनाः इति क्षितिः = भूमिः।]]</li> <li id="foot_krm_0311_09"><a href="#ref_krm_0311_09">↑</a> [[आ। ‘क्षितितटशयनान्तात् उत्थितं दानपङ्कप्लुतबहुलशरीरं शाययत्येष भूयः।’ शिशुपालवघे ११-७।]]</li> <li id="foot_krm_0311_10"><a href="#ref_krm_0311_10">↑</a> [[B। ‘व्यापारेऽत्र तदाऽमरानपि रियन् आशाः पियन् नाधित- क्रौर्योत्क्षीणधनुष्प्रसूतनिनदः कंसे व्यकारीद् गरम्। येनानादरवान् धृतोऽपि स चलन् पृच्छन् किमित्युत्सृजन् धैर्यं मग्नमनाश्च हृद्रुजि चिरं भुग्नाननस्तस्थिवान्।।’ धा। का। २। ८३।]]</li></ul></p>

