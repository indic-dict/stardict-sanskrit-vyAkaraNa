<ul><li><sup id="ref_krm_0282_01"><a href="#foot_krm_0282_01">1</a></sup> {@“क्रीडृ विहारे”@} <sup id="ref_krm_0282_02"><a href="#foot_krm_0282_02">2</a></sup> क्रीडकः-डिका, क्रीडकः-डिका, चिक्रीडिषकः-षिका, चेक्रीडकः-डिका;</li> <li>  क्रीडिता-त्री, क्रीडयिता-त्री, चिक्रीडिषिता-त्री, चेक्रीडिता-त्री;</li> <li>  क्रीडन्-न्ती, <sup id="ref_krm_0282_03"><a href="#foot_krm_0282_03">3</a></sup> अनुक्रीडन्, सङ्क्रीडन्-न्ती, क्रीडयन्-न्ती, चिक्रीडिषन्-न्ती;</li> <li>  -- क्रीडिष्यन्-न्ती-ती, क्रीडयिष्यन्-न्ती-ती, चिक्रीडिषन्-न्ती-ती;</li> <li>  <sup id="ref_krm_0282_04"><a href="#foot_krm_0282_04">4</a></sup> अनुक्रीडमानः <sup id="ref_krm_0282_05"><a href="#foot_krm_0282_05">5</a></sup> -सङ्क्रीडमानः-परिक्रीडमानः, <sup id="ref_krm_0282_06"><a href="#foot_krm_0282_06">6</a></sup> आक्रीडमानः, <sup id="ref_krm_0282_07"><a href="#foot_krm_0282_07">7</a></sup> क्रीडयमानः, <sup id="ref_krm_0282_08"><a href="#foot_krm_0282_08">8</a></sup> अनुचिक्रीडिषमाणः, चेक्रीड्यमानः;</li> <li>  अनुक्रीडिष्यमाणः, क्रीडयिष्यमाणः, परिचिक्रीडिषिष्यमाणः, चेक्रीडिष्यमाणः;</li> <li>  सङ्क्रीट् <sup id="ref_krm_0282_09"><a href="#foot_krm_0282_09">9</a></sup> -सङ्क्रीड्-सङ्क्रीडौ-सङ्क्रीडः;</li> <li>  -- -- -- क्रीडितः <sup id="ref_krm_0282_10"><a href="#foot_krm_0282_10">10</a></sup> -तम्, क्रीडितः, चिक्रीडिषितः, चेक्रीडितः-तवान्;</li> <li>  <sup id="ref_krm_0282_11"><a href="#foot_krm_0282_11">11</a></sup> क्रीडः, <sup id="ref_krm_0282_12"><a href="#foot_krm_0282_12">12</a></sup> आक्रीडी, <sup id="ref_krm_0282_13"><a href="#foot_krm_0282_13">13</a></sup> क्रीडः, चिक्रीडिषुः, चेक्रीडः;</li> <li>  क्रीडितव्यम्, क्रीडयितव्यम्, चिक्रीडिषितव्यम्, चेक्रीडितव्यम्;</li> <li>  क्रीडनीयम्, क्रीडनीयम्, चिक्रीडिषणीयम्, चेक्रीडनीयम्;</li> <li>  क्रीड्यम्, क्रीड्यम्, चिक्रीडिष्यम्, चेक्रीड्यम्;</li> <li>  ईषत्क्रीडः-दुष्क्रीडः-सुक्रीडः;</li> <li>  -- -- -- क्रीड्यमानः, क्रीड्यमानः, चिक्रीडिष्यमाणः, चेक्रीड्यमानः;</li> <li>  क्रीडः- <sup id="ref_krm_0282_14"><a href="#foot_krm_0282_14">14</a></sup> आक्रीडः, <sup id="ref_krm_0282_15"><a href="#foot_krm_0282_15">15</a></sup> चिक्रीडः, क्रीडः, चिक्रीडिषः, चेक्रीडः;</li> <li>  क्रीडितुम्, क्रीडयितुम्, चिक्रीडिषितुम्, चेक्रीडितुम्;</li> <li>  <sup id="ref_krm_0282_16"><a href="#foot_krm_0282_16">16</a></sup> क्रीडा, क्रीडना, चिक्रीडिषा, चेक्रीडा;</li> <li>  <sup id="ref_krm_0282_17"><a href="#foot_krm_0282_17">17</a></sup> क्रीडनम्, क्रीडनम्, चिक्रीडिषणम्, चेक्रीडनम्;</li> <li>  क्रीडित्वा, क्रीडयित्वा, चिक्रीडिषित्वा, चेक्रीडित्वा;</li> <li>  सङ्क्रीड्य, सङ्क्रीड्य, सञ्चिक्रीडिष्य, सञ्चेक्रीड्य;</li> <li>  क्रीडम् २, क्रीडम् २, क्रीडम् २, क्रीडयित्वा २, चिक्रीडिषम् २, चिक्रीडिषित्वा २, चेक्रीडम् २;</li> <li>  चेक्रीडित्वा २। <sup id="ref_krm_0282_18"><a href="#foot_krm_0282_18">18</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0282_01"><a href="#ref_krm_0282_01">↑</a> (२७५)</li> <li id="foot_krm_0282_02"><a href="#ref_krm_0282_02">↑</a> (१-भ्वादिः-३५०। अक। सेट्। पर।)</li> <li id="foot_krm_0282_03"><a href="#ref_krm_0282_03">↑</a> [[५। ‘तृतीयार्थे’ (१-४-८५) इति यदाऽनुः कर्मप्रवचनीयसंज्ञकः, तदा शता।]]</li> <li id="foot_krm_0282_04"><a href="#ref_krm_0282_04">↑</a> [[६। ‘क्रीडोऽनुसंपरिभ्यश्च’ (१-३-२१) इति शानच्। ‘समोऽकूजने इति वक्तव्यम्’ (वा १-३-२१) इत्युक्तत्वात् ‘सङ्क्रीडन्ति शकटानि’ इत्यपि भवति। शत्रन्तमेतत्।]]</li> <li id="foot_krm_0282_05"><a href="#ref_krm_0282_05">↑</a> [[B। ‘फलन्यादत्स्व चित्राणि परिक्रीडस्व सानुषु। साध्वनुक्रीडमानानि पश्य बृन्दानि पक्षिणाम्।।’ भ। का। ८-१०।]]</li> <li id="foot_krm_0282_06"><a href="#ref_krm_0282_06">↑</a> [[७। ‘क्रीडोऽनुसंपरिभ्यश्च’ (१-३-२१) इत्यत्र चकारादाङ अनुवृत्तेः शानच्।]]</li> <li id="foot_krm_0282_07"><a href="#ref_krm_0282_07">↑</a> [पृष्ठम्०२८६+ २८]</li> <li id="foot_krm_0282_08"><a href="#ref_krm_0282_08">↑</a> [[१। ‘पूर्ववत् सनः’ (१-३-६२) इति शानच्।]]</li> <li id="foot_krm_0282_09"><a href="#ref_krm_0282_09">↑</a> [[२। ‘वाऽवसाने’ (८-४-५६) इति चर्त्वविकल्पः।]]</li> <li id="foot_krm_0282_10"><a href="#ref_krm_0282_10">↑</a> [[३। ‘प्रभुक्तो गोरसं कृष्णः प्रभुक्तोऽनेन गोरसः। प्रक्रीडितो वने शौरिः प्रक्रीडितमिहामुना।।’ इति ‘आदिकर्मणि क्तः कर्तरि च’ (३-४-७१) इति सूत्रोदाहरणम्--प्रक्रियासर्वस्वे कृतम्।]]</li> <li id="foot_krm_0282_11"><a href="#ref_krm_0282_11">↑</a> [[४। ‘इगुपधज्ञाप्रीकिरः कः’ (३-१-१३५) इति कर्तरि कः।]]</li> <li id="foot_krm_0282_12"><a href="#ref_krm_0282_12">↑</a> [[५। ‘सम्पृचानुरुधाङ्यम्--’ (३-२-१४२) इत्यादिना अनुपसृष्टात् घिनुण् ताच्छीलिकः।]]</li> <li id="foot_krm_0282_13"><a href="#ref_krm_0282_13">↑</a> [[आ। ‘सोढुमाक्रीडिनोऽशक्याः शिखिनः परिवादिनः।।’ भ-का। ७-८।]]</li> <li id="foot_krm_0282_14"><a href="#ref_krm_0282_14">↑</a> [[६। आक्रीडन्त्यस्मिन् इत्यधिकरणे ‘अकर्तरि च कारके संज्ञायाम्’ (३-३-१९) इति घञ्। ‘आक्रीडा विविधा राजन् पद्मिन्यश्चामलोदकाः’ इति श्रीविष्णुपुराणे।]]</li> <li id="foot_krm_0282_15"><a href="#ref_krm_0282_15">↑</a> [[७। ‘घञर्थे कविधानम्’ (वा (३-३-५८) इति कः। ‘द्वित्वप्रकरणे के कृञादीनामिति वक्तव्यम्’ (वा ६-१-१२) इति द्वित्वम्।]]</li> <li id="foot_krm_0282_16"><a href="#ref_krm_0282_16">↑</a> [[८। ‘गुरोश्च हलः’ (३-३-१३) इत्यप्रत्ययः।]]</li> <li id="foot_krm_0282_17"><a href="#ref_krm_0282_17">↑</a> [[B। ‘अकद्धरिक्रीडनधूततोडकान् प्रहूडितान् होडदरोड्यभिक्षुकैः।’ धा। का। १-४६।]]</li> <li id="foot_krm_0282_18"><a href="#ref_krm_0282_18">↑</a> [पृष्ठम्०२८७+ २७]</li></ul></p>

क्रुड
<ul><li><sup id="ref_krm_0283_01"><a href="#foot_krm_0283_01">1</a></sup> {@“क्रुड संवरणे”@} <sup id="ref_krm_0283_02"><a href="#foot_krm_0283_02">2</a></sup> कुटादिः। </li> <li>‘निमञ्जने’ इत्यात्रेयः। </li> <li>क्रोडकः-डिका, क्रोडकः-डिका, चुक्रुडिषकः-षिका, चोक्रुडकः- डिका, <sup id="ref_krm_0283_03"><a href="#foot_krm_0283_03">3</a></sup> चुक्रुडिषन्-न्ती, इत्यादीनि सर्वाण्यपि रूपाणि तौदादिकक्रुटतिवत् <sup id="ref_krm_0283_04"><a href="#foot_krm_0283_04">4</a></sup> ज्ञेयानि। </li> <li>क्रोडः <sup id="ref_krm_0283_05"><a href="#foot_krm_0283_05">5</a></sup> -डा, अश्वानामुरः क्रोडा। </li> <li>‘न क्रोडादिबह्वचः’ <sup id="ref_krm_0283_06"><a href="#foot_krm_0283_06">6</a></sup> इति स्त्रियां ङीष्निषेधः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0283_01"><a href="#ref_krm_0283_01">↑</a> (२७६)</li> <li id="foot_krm_0283_02"><a href="#ref_krm_0283_02">↑</a> (६-तुदादिः-१३९४। अक। सेट्। पर।)</li> <li id="foot_krm_0283_03"><a href="#ref_krm_0283_03">↑</a> [[१। ‘अनुदात्तङित आत्मनेपदम्’ (१-३-१२) इति सूत्रे उपदेशग्रहणानुवृत्त्या ङित्त्वा- भावात् सन्नन्तात् परस्मैपदमेव।]]</li> <li id="foot_krm_0283_04"><a href="#ref_krm_0283_04">↑</a> (२०४)</li> <li id="foot_krm_0283_05"><a href="#ref_krm_0283_05">↑</a> [[आ। ‘क्षौमेण स्फुडितं स्रजा निचुलितं चाव्रोड्य शोभं धनुः गेहक्रोडतले स मोदकुलितः दृष्ट्वाऽगुरिष्ट क्षणात्।’ धा। का। २-८२।]]</li> <li id="foot_krm_0283_06"><a href="#ref_krm_0283_06">↑</a> (४-१-५६)</li></ul></p>

