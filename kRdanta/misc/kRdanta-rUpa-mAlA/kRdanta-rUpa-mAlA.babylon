<ul><li><sup id="ref_krm_0752_01"><a href="#foot_krm_0752_01">1</a></sup> {@“तुन्प हिंसार्थः”@} <sup id="ref_krm_0752_02"><a href="#foot_krm_0752_02">2</a></sup> ‘शपि तोपति हिंसायां तत्रैव तुपतीति शे।।’ <sup id="ref_krm_0752_03"><a href="#foot_krm_0752_03">3</a></sup> ‘तत्रैव शशपोस्तुम्पेद् अर्दने तुम्ययेण्णिचि।’ <sup id="ref_krm_0752_04"><a href="#foot_krm_0752_04">4</a></sup> इति देवः। </li> <li>तोपकः-पिका, तोपकः-पिका, तुतुम्पिषकः-षिका, <sup id="ref_krm_0752_05"><a href="#foot_krm_0752_05">5</a></sup> तोतुपकः-पिका;</li> <li>  तुम्पिता-त्री, तुम्पयिता-त्री, तुतुम्पिषिता-त्री, तोतुपिता-त्री;</li> <li>  तुम्पन्-न्ती, प्रस्तुम्पन् <sup id="ref_krm_0752_06"><a href="#foot_krm_0752_06">6</a></sup>, तुम्पयन्-न्ती, तुतुम्पिषन्-न्ती;</li> <li>  -- तुम्पिष्यन्-न्ती-ती, तुम्पयिष्यन्-न्ती-ती, तुतुम्पिषिष्यन्-न्ती-ती;</li> <li>  -- -- तुम्पयमानः, तुम्पयिष्यमाणः, -- तोतुप्यमानः, तोतुपिष्यमाणः;</li> <li>  तुप्-तुब्-तुपौ-तुपः;</li> <li>  -- -- -- तुपितम्-तः, तुम्पितः, तुतुम्पिषितः, तोतुपितः-तवान्;</li> <li>  तुम्पः, तुम्पः, तुतुम्पिषुः, तोतुम्पः;</li> <li>  तुम्पितव्यम्, तुम्पयितव्यम्, तुतुम्पिषितव्यम्, तोतुपितव्यम्;</li> <li>  तुम्पनीयम्, तुम्पनीयम्, तुतुम्पिषणीयम्, तोतुपनीयम्;</li> <li>  <sup id="ref_krm_0752_07"><a href="#foot_krm_0752_07">7</a></sup> तुम्प्यम्, तुम्प्यम्, तुतुम्पिष्यम्, तोतुप्यम्;</li> <li>  ईषत्तुम्पः-दुस्तुम्पः-सुतुम्पः;</li> <li>  -- -- तुप्यमानः, तुम्प्यमानः, तुतुम्पिष्यमाणः, तोतुप्यमानः;</li> <li>  तुम्पः, <sup id="ref_krm_0752_08"><a href="#foot_krm_0752_08">8</a></sup> प्रस्तुम्पः-तुम्पः, तुतुम्पिषः, तोतुपः;</li> <li>  तुम्पितुम्, तुम्पयितुम्, तुतुम्पिषितुम्, तोतुपितुम्;</li> <li>  तुम्पा, तुम्पना, तुतुम्पिषा, तोतुपा;</li> <li>  तुम्पनम्, तुम्पनम्, तुतुम्पिषणम्, तोतुपनम्;</li> <li>  <sup id="ref_krm_0752_09"><a href="#foot_krm_0752_09">9</a></sup> तुम्पित्वा, तुम्पयित्वा, तुतुम्पिषित्वा, तोतुपित्वा;</li> <li>  प्रतुप्य, प्रतुम्प्य, प्रतुतुम्पिष्य, प्रतोतुप्य;</li> <li>  तुम्पम् २, तुम्पित्वा २, तुम्पम् २, तुम्पयित्वा २, तुतुम्पीषम् २, तुतुम्पिषित्वा २, तोतुपम् २;</li> <li>  तोतुपित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0752_01"><a href="#ref_krm_0752_01">↑</a> (७४२)</li> <li id="foot_krm_0752_02"><a href="#ref_krm_0752_02">↑</a> (१-भ्वादिः-४०५। सक। सेट्। पर।)</li> <li id="foot_krm_0752_03"><a href="#ref_krm_0752_03">↑</a> (श्लो। १३८)</li> <li id="foot_krm_0752_04"><a href="#ref_krm_0752_04">↑</a> (श्लो। १३९)</li> <li id="foot_krm_0752_05"><a href="#ref_krm_0752_05">↑</a> [[३। नोपधोऽयं धातुः। तेन यङि, ‘अनिदितां हल उपधायाः क्ङिति’ (६-४-२४) इति नकारलोपः। एवं यङन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0752_06"><a href="#ref_krm_0752_06">↑</a> [गौः वर्तते]</li> <li id="foot_krm_0752_07"><a href="#ref_krm_0752_07">↑</a> [पृष्ठम्०६६९+ २४]</li> <li id="foot_krm_0752_08"><a href="#ref_krm_0752_08">↑</a> [[१। ‘प्रात् तुम्पतौ गवि कर्तरि’ (ग। सू। ६-१-१५७) इति पारस्करादिषु पाठात् प्रपूर्वकादस्मात् गवि कर्तरि सुट्। एवं ‘प्रस्तुम्पन् गौः वर्तते’ इत्यादिष्वपि सुट् ज्ञेयः।]]</li> <li id="foot_krm_0752_09"><a href="#ref_krm_0752_09">↑</a> [[२। ‘न क्त्वा सेट्’ (१-२-१८) इति कित्त्वनिषेधात् उपधानकारलोपो न।]]</li></ul></p>

तुन्प|तुम्पकः-म्पिका|तुतुम्पिषकः-षिका|तोतुपकः-पिका|तुम्पिता-त्री|तुम्पयिता-त्री|तुतुम्पिषिता-त्री|तोतुपिता-त्री
<ul><li><sup id="ref_krm_0753_01"><a href="#foot_krm_0753_01">1</a></sup> {@“तुन्प हिंसार्थः”@} <sup id="ref_krm_0753_02"><a href="#foot_krm_0753_02">2</a></sup> ‘शपि तोपति हिंसायां तत्रैव तुपतीति शे।।’ <sup id="ref_krm_0753_03"><a href="#foot_krm_0753_03">3</a></sup> ‘तत्रैव शशपोस्तुम्पेद्, अर्दने तुम्पयेण्णिचि।’ <sup id="ref_krm_0753_04"><a href="#foot_krm_0753_04">4</a></sup> इति देवः। </li> <li><sup id="ref_krm_0753_05"><a href="#foot_krm_0753_05">5</a></sup> तुम्पकः-म्पिका, तुम्पकः-म्पिका, तुतुम्पिषकः-षिका, तोतुपकः-पिका;</li> <li>  तुम्पिता-त्री, तुम्पयिता-त्री, तुतुम्पिषिता-त्री, तोतुपिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकतुन्पधातुवत् <sup id="ref_krm_0753_06"><a href="#foot_krm_0753_06">6</a></sup> ज्ञेयानि। </li> <li>अस्य धातोः तुदादित्वात् शतरि-- ‘तुदादिभ्यः शः’ <sup id="ref_krm_0753_07"><a href="#foot_krm_0753_07">7</a></sup> इति शः विकरणप्रत्ययः। </li> <li>तस्य ‘सार्वधातुकमपित्’ <sup id="ref_krm_0753_08"><a href="#foot_krm_0753_08">8</a></sup> इति ङिद्वद्भावेन ‘अनिदिताम्--’ <sup id="ref_krm_0753_09"><a href="#foot_krm_0753_09">9</a></sup> इति धातोरुपधाभूतस्य नकारस्य शप्रत्यये परतः लोपेऽपि ‘शे तृम्फादीनाम्’ <sup id="ref_krm_0753_10"><a href="#foot_krm_0753_10">10</a></sup> इति वचनेन नुमि तुम्पन् इत्येव रूपम्। </li> <li><sup id="ref_krm_0753_11"><a href="#foot_krm_0753_11">11</a></sup> स्त्रियां तुम्पती-न्ती, इति रूपद्वयम्। </li> <li>‘आच्छीनद्योर्नुम्’ <sup id="ref_krm_0753_12"><a href="#foot_krm_0753_12">12</a></sup> इति नुम्विकल्पः। </li> <li><sup id="ref_krm_0753_13"><a href="#foot_krm_0753_13">13</a></sup> प्रस्तुम्पन्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0753_01"><a href="#ref_krm_0753_01">↑</a> (७४३)</li> <li id="foot_krm_0753_02"><a href="#ref_krm_0753_02">↑</a> (६-तुदादिः-१३१०। सक। सेट्। पर।)</li> <li id="foot_krm_0753_03"><a href="#ref_krm_0753_03">↑</a> (श्लो। १३८)</li> <li id="foot_krm_0753_04"><a href="#ref_krm_0753_04">↑</a> (श्लो। १३९)</li> <li id="foot_krm_0753_05"><a href="#ref_krm_0753_05">↑</a> [[आ। ‘शत्रूल्लोभकरेफरीढितृपिता तृम्फाय तोपार्थिनो राज्ञा नित्यमतुम्पकान् वितुफती बन्धूंश्च सन्तुम्फती’ धा। का। २। ७४।]]</li> <li id="foot_krm_0753_06"><a href="#ref_krm_0753_06">↑</a> (७४२)</li> <li id="foot_krm_0753_07"><a href="#ref_krm_0753_07">↑</a> (३-१-७७)</li> <li id="foot_krm_0753_08"><a href="#ref_krm_0753_08">↑</a> (१-२-४)</li> <li id="foot_krm_0753_09"><a href="#ref_krm_0753_09">↑</a> (६-४-२४)</li> <li id="foot_krm_0753_10"><a href="#ref_krm_0753_10">↑</a> (वा। ७-१-५९)</li> <li id="foot_krm_0753_11"><a href="#ref_krm_0753_11">↑</a> [पृष्ठम्०६७०+ २५]</li> <li id="foot_krm_0753_12"><a href="#ref_krm_0753_12">↑</a> (७-१-८०)</li> <li id="foot_krm_0753_13"><a href="#ref_krm_0753_13">↑</a> [[१। ‘प्रात् तुम्पतौ गवि कर्तरि’ (ग। सू। ६-१-१५७) इति पारस्करादिषु पाठात् प्रपूर्व- कादस्मात् गवि कर्तरि सुट्। एवं तव्यदादिष्वपि ज्ञेयम्।]]</li></ul></p>

तुन्फ|तुम्फकः-म्फिका|तुतुम्फिषकः-षिका|तोतुफकः-फिका|तुम्फिता-त्री|तुम्फयिता-त्री|तुतुम्फिषिता-त्री|तोतुफिता-त्री
<ul><li><sup id="ref_krm_0754_01"><a href="#foot_krm_0754_01">1</a></sup> {@“तुन्फ हिंसार्थः”@} <sup id="ref_krm_0754_02"><a href="#foot_krm_0754_02">2</a></sup> तुम्फकः-म्फिका, तुम्फकः-म्फिका, तुतुम्फिषकः-षिका, तोतुफकः-फिका;</li> <li>  तुम्फिता-त्री, तुम्फयिता-त्री, तुतुम्फिषिता-त्री, तोतुफिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकतुन्पधातुवत् <sup id="ref_krm_0754_03"><a href="#foot_krm_0754_03">3</a></sup> बोध्यानि। </li> <li>क्त्वायां ‘न क्त्वा सेट्’ <sup id="ref_krm_0754_04"><a href="#foot_krm_0754_04">4</a></sup> इत्यस्यापवादतया ‘नोपधात् थफान्ताद्वा’ <sup id="ref_krm_0754_05"><a href="#foot_krm_0754_05">5</a></sup> इति कित्त्वस्य विकल्पितत्वात् कित्त्वपक्षे ‘अनिदिताम्--’ <sup id="ref_krm_0754_06"><a href="#foot_krm_0754_06">6</a></sup> इति नलोपे तुफित्वा इति रूपम्, कित्त्वाभावपक्षे तुम्फित्वा इति रूपद्वयं भवतीति विशेषः। </li> <li>घञि <sup id="ref_krm_0754_07"><a href="#foot_krm_0754_07">7</a></sup> प्रतुम्फः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0754_01"><a href="#ref_krm_0754_01">↑</a> (७४४)</li> <li id="foot_krm_0754_02"><a href="#ref_krm_0754_02">↑</a> (१-भ्वादिः-४०९। सक। सेट्। पर।)</li> <li id="foot_krm_0754_03"><a href="#ref_krm_0754_03">↑</a> (७४२)</li> <li id="foot_krm_0754_04"><a href="#ref_krm_0754_04">↑</a> (१-२-१८)</li> <li id="foot_krm_0754_05"><a href="#ref_krm_0754_05">↑</a> (१-२-२३)</li> <li id="foot_krm_0754_06"><a href="#ref_krm_0754_06">↑</a> (६-४-२४)</li> <li id="foot_krm_0754_07"><a href="#ref_krm_0754_07">↑</a> [[आ। ‘अत्रुम्प्यधामानमिनं प्रतोफितुं प्रतुम्फशीलान् मिलतोऽथ राक्षसान्।’ धा। का। १। ५३।]]</li></ul></p>

तुन्फ|तुम्फकः-म्फिका|तुतुम्फिषकः-षिका|तोतुफकः-फिका|तुम्फिता-त्री|तुम्फयिता-त्री|तुतुम्फिषिता-त्री|तोतुफिता-त्री
<ul><li><sup id="ref_krm_0755_01"><a href="#foot_krm_0755_01">1</a></sup> {@“तुन्फ हिंसार्थः”@} <sup id="ref_krm_0755_02"><a href="#foot_krm_0755_02">2</a></sup> तृम्फादिः। </li> <li>तुम्फकः-म्फिका, तुम्फकः-म्फिका, तुतुम्फिषकः-षिका, तोतुफकः-फिका;</li> <li>  तुम्फिता-त्री, तुम्फयिता-त्री, तुतुम्फिषिता-त्री, तोतुफिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि गुन्फधातुवत् <sup id="ref_krm_0755_03"><a href="#foot_krm_0755_03">3</a></sup> ज्ञेयानि। </li> <li>शतरि सन्तुम्फन्- <sup id="ref_krm_0755_04"><a href="#foot_krm_0755_04">4</a></sup> ती-न्ती।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0755_01"><a href="#ref_krm_0755_01">↑</a> (७४५)</li> <li id="foot_krm_0755_02"><a href="#ref_krm_0755_02">↑</a> (६-तुदादिः-१३१२। सक। सेट्। पर।)</li> <li id="foot_krm_0755_03"><a href="#ref_krm_0755_03">↑</a> (४०७)</li> <li id="foot_krm_0755_04"><a href="#ref_krm_0755_04">↑</a> [[B। ‘--राज्ञो नित्यमतुम्पकान् वितुफती बन्धूंश्च सन्तुम्फती।’ धा। का। २। ७४।]]</li></ul></p>

तुप|तोपकः-पिका|तुतोपिषकः-तुतुपिषकः-षिका|तोतुपकः-|पिका|तोपिता-त्री|तोपयिता-त्री|तुतोपिषिता-तुतुपिषिता-त्री|तोतुपिता-त्री
<ul><li><sup id="ref_krm_0756_01"><a href="#foot_krm_0756_01">1</a></sup> {@“तुप हिंसार्थः”@} <sup id="ref_krm_0756_02"><a href="#foot_krm_0756_02">2</a></sup> ‘शपि तोपति हिंसायां तत्रैव तुपतीति शे।।’ <sup id="ref_krm_0756_03"><a href="#foot_krm_0756_03">3</a></sup> इति देवः। </li> <li>तोपकः-पिका, तोपकः-पिका, तुतोपिषकः-तुतुपिषकः-षिका, तोतुपकः- पिका;</li> <li>  तोपिता-त्री, तोपयिता-त्री, तुतोपिषिता-तुतुपिषिता-त्री, तोतुपिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि कुचधातुवत् <sup id="ref_krm_0756_04"><a href="#foot_krm_0756_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0756_05"><a href="#foot_krm_0756_05">5</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0756_01"><a href="#ref_krm_0756_01">↑</a> (७४६)</li> <li id="foot_krm_0756_02"><a href="#ref_krm_0756_02">↑</a> (१-भ्वादिः-४०४। सक। सेट्। पर।)</li> <li id="foot_krm_0756_03"><a href="#ref_krm_0756_03">↑</a> (श्लो। १३८)</li> <li id="foot_krm_0756_04"><a href="#ref_krm_0756_04">↑</a> (२००)</li> <li id="foot_krm_0756_05"><a href="#ref_krm_0756_05">↑</a> [पृष्ठम्०६७१+ २३]</li></ul></p>

तुप|तोपकः-पिका|तुतुपिषकः-तुतोपिषकः-षिका|तोतुपकः-पिका
<ul><li><sup id="ref_krm_0757_01"><a href="#foot_krm_0757_01">1</a></sup> {@“तुप हिंसार्थः”@} <sup id="ref_krm_0757_02"><a href="#foot_krm_0757_02">2</a></sup> ‘शपि तोपति हिंसायां तत्रैव तुपतीति शे।।’ <sup id="ref_krm_0757_03"><a href="#foot_krm_0757_03">3</a></sup> इति देवः। </li> <li>तोपकः-पिका, तोपकः-पिका, तुतुपिषकः-तुतोपिषकः-षिका, तोतुपकः-पिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककुचतिवत् <sup id="ref_krm_0757_04"><a href="#foot_krm_0757_04">4</a></sup> ज्ञेयानि। </li> <li>अस्य धातोः तुदादित्वात् शतरि--तुपन् इति रूपम्। </li> <li>स्त्रियां--तुपन्ती-तुपती इति रूपद्वयमिति विशेषः। </li> <li>क्तप्रत्यये ‘उदुपधात्--’ <sup id="ref_krm_0757_05"><a href="#foot_krm_0757_05">5</a></sup> इति कित्त्व- विकल्पो न भवति, ‘शब्विकरणेभ्यः एव इष्यते’ इति भाष्यकारवचनात्। </li> <li>तेन तुपितः इत्येव।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0757_01"><a href="#ref_krm_0757_01">↑</a> (७४७)</li> <li id="foot_krm_0757_02"><a href="#ref_krm_0757_02">↑</a> (६-तुदादिः-१३०९। सक। सेट्। पर।)</li> <li id="foot_krm_0757_03"><a href="#ref_krm_0757_03">↑</a> (श्लो। १३८)</li> <li id="foot_krm_0757_04"><a href="#ref_krm_0757_04">↑</a> (२००)</li> <li id="foot_krm_0757_05"><a href="#ref_krm_0757_05">↑</a> (१-२-२१)</li></ul></p>

तुफ|तोफकः-फिका|तुतुफिषकः-तुतोफिषकः-षिका|तोतुफकः-|फिका|तोफिता-त्री|तोफयिता-त्री|तुतुफिषिता-तुतोफिषिता-त्री|तोतु-|फिता-त्री
<ul><li><sup id="ref_krm_0758_01"><a href="#foot_krm_0758_01">1</a></sup> {@“तुफ हिंसार्थः”@} <sup id="ref_krm_0758_02"><a href="#foot_krm_0758_02">2</a></sup> तोफकः-फिका, तोफकः-फिका, तुतुफिषकः-तुतोफिषकः-षिका, तोतुफकः- फिका;</li> <li>  तोफिता-त्री, तोफयिता-त्री, तुतुफिषिता-तुतोफिषिता-त्री, तोतु- फिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककुचतिवत् <sup id="ref_krm_0758_03"><a href="#foot_krm_0758_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0758_04"><a href="#foot_krm_0758_04">4</a></sup> प्रतोफितुम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0758_01"><a href="#ref_krm_0758_01">↑</a> (७४८)</li> <li id="foot_krm_0758_02"><a href="#ref_krm_0758_02">↑</a> (१-भ्वादिः-४०८। सक। सेट्। पर।)</li> <li id="foot_krm_0758_03"><a href="#ref_krm_0758_03">↑</a> (२००)</li> <li id="foot_krm_0758_04"><a href="#ref_krm_0758_04">↑</a> [[आ। ‘अत्रुम्प्यधामानमिनं प्रतोफितुं प्रतुम्फशीलान् मिलतोऽथ राक्षसान्।’ धा। का। १। ५३।]]</li></ul></p>

तुफ|तोफकः-फिका|तुतुफिषकः-तुतोफिषकः-षिका|तोतुफकः-|फिका|तोफिता-त्री|तोफयिता-त्री|तुतुफिषिता-तुतोफिषिता-त्री|तोतुफिता-त्री
<ul><li><sup id="ref_krm_0759_01"><a href="#foot_krm_0759_01">1</a></sup> {@“तुफ हिंसार्थः”@} <sup id="ref_krm_0759_02"><a href="#foot_krm_0759_02">2</a></sup> तोफकः-फिका, तोफकः-फिका, तुतुफिषकः-तुतोफिषकः-षिका, तोतुफकः- फिका;</li> <li>  तोफिता-त्री, तोफयिता-त्री, तुतुफिषिता-तुतोफिषिता-त्री, तोतुफिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि कुरधातुवत् <sup id="ref_krm_0759_03"><a href="#foot_krm_0759_03">3</a></sup> बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0759_01"><a href="#ref_krm_0759_01">↑</a> (७४९)</li> <li id="foot_krm_0759_02"><a href="#ref_krm_0759_02">↑</a> (६-तुदादिः-१३११। सक। सेट्। पर।)</li> <li id="foot_krm_0759_03"><a href="#ref_krm_0759_03">↑</a> (२२९)</li></ul></p>

तुबि|तुम्बकः-म्बिका|तुतुम्बिषकः-षिका|तोतुम्बकः-म्बिका|तुम्बिता-त्री|तुम्बयिता-त्री|तुतुम्बिषिता-त्री|तोतुम्बिता-त्री
<ul><li><sup id="ref_krm_0760_01"><a href="#foot_krm_0760_01">1</a></sup> {@“तुबि अर्दने”@} <sup id="ref_krm_0760_02"><a href="#foot_krm_0760_02">2</a></sup> ‘लुम्बयेत् तुम्बयेदर्दे शपि लुम्बति तुम्बति।।’ <sup id="ref_krm_0760_03"><a href="#foot_krm_0760_03">3</a></sup> इति देवः। </li> <li>तुम्बकः-म्बिका, तुम्बकः-म्बिका, तुतुम्बिषकः-षिका, तोतुम्बकः-म्बिका;</li> <li>  तुम्बिता-त्री, तुम्बयिता-त्री, तुतुम्बिषिता-त्री, तोतुम्बिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि भौवादिककुठिधातुवत् <sup id="ref_krm_0760_04"><a href="#foot_krm_0760_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0760_05"><a href="#foot_krm_0760_05">5</a></sup> सन्तुम्बितः। </li> <li><sup id="ref_krm_0760_06"><a href="#foot_krm_0760_06">6</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0760_01"><a href="#ref_krm_0760_01">↑</a> (७५०)</li> <li id="foot_krm_0760_02"><a href="#ref_krm_0760_02">↑</a> (१-भ्वादिः-४२८। सक। सेट्। पर।)</li> <li id="foot_krm_0760_03"><a href="#ref_krm_0760_03">↑</a> (श्लो। १३९)</li> <li id="foot_krm_0760_04"><a href="#ref_krm_0760_04">↑</a> (२०९)</li> <li id="foot_krm_0760_05"><a href="#ref_krm_0760_05">↑</a> [[B। ‘वियोगसन्तुम्बितकोकचुम्बिता सन्तापसृब्धाऽपि जगाद तद्वधूः।’ धा। का। १। ५६।]]</li> <li id="foot_krm_0760_06"><a href="#ref_krm_0760_06">↑</a> [पृष्ठम्०६७२+ २३]</li></ul></p>

तुबि|तुम्बकः-म्बिका|तुतुम्बयिषकः-षिका|तुतुम्बिषकः-षिका|तोतुम्बकः-म्बिका|तुम्बयिता-त्री|तुतुम्बयिषिता-त्री|तुम्बिता-त्री|तुतुम्बि-|षिता-त्री|तोतुम्बिता-त्री
<ul><li><sup id="ref_krm_0761_01"><a href="#foot_krm_0761_01">1</a></sup> {@“तुबि अदर्शने”@} <sup id="ref_krm_0761_02"><a href="#foot_krm_0761_02">2</a></sup> अर्दने इति केचित्। </li> <li>इदित्करणात् णिचः पाक्षिकत्वम्। </li> <li>‘लुम्बयेत् तुम्बयेदर्दे शपि लुम्बति तुम्बति।।’ <sup id="ref_krm_0761_03"><a href="#foot_krm_0761_03">3</a></sup> इति देवः। </li> <li>‘तुपि अर्दने’ इति मैत्रेयदुर्गसंमतपाठमनुसृत्य दैवश्लोके-- ‘अर्दने तुम्प- येण्णिचि।’ <sup id="ref_krm_0761_04"><a href="#foot_krm_0761_04">4</a></sup> इत्यंशस्य उपपत्तिर्बोध्या। </li> <li>तुम्बकः-म्बिका, तुतुम्बयिषकः-षिका, तुम्बकः-म्बिका, तुतुम्बिषकः-षिका, तोतुम्बकः-म्बिका;</li> <li>  तुम्बयिता-त्री, तुतुम्बयिषिता-त्री, तुम्बिता-त्री, तुतुम्बि- षिता-त्री, तोतुम्बिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भाषार्थककुशि- धातुवत् <sup id="ref_krm_0761_05"><a href="#foot_krm_0761_05">5</a></sup> बोध्यानि। </li> <li>तुम्बः-तुम्बी = <sup id="ref_krm_0761_06"><a href="#foot_krm_0761_06">6</a></sup>। </li> <li>गौरादिपाठात् ङीष्। </li> <li><sup id="ref_krm_0761_07"><a href="#foot_krm_0761_07">7</a></sup> तुम्बितम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0761_01"><a href="#ref_krm_0761_01">↑</a> (७५१)</li> <li id="foot_krm_0761_02"><a href="#ref_krm_0761_02">↑</a> (१०-चुरादिः-१६५८। सक। सेट्। उभ।)</li> <li id="foot_krm_0761_03"><a href="#ref_krm_0761_03">↑</a> (श्लो। १३९)</li> <li id="foot_krm_0761_04"><a href="#ref_krm_0761_04">↑</a> (श्लो। १३९)</li> <li id="foot_krm_0761_05"><a href="#ref_krm_0761_05">↑</a> (२३२)</li> <li id="foot_krm_0761_06"><a href="#ref_krm_0761_06">↑</a> [अलाबूः]</li> <li id="foot_krm_0761_07"><a href="#ref_krm_0761_07">↑</a> [[आ। ‘किं कुम्ब्यते सदसि लुम्बितवैभवोऽहं बालोऽस्मि तुम्बितविरोधिभयाश्च यूयम्।’ धा। का। ३। २९।]]</li></ul></p>

