<ul><li><sup id="ref_krm_0263_01"><a href="#foot_krm_0263_01">1</a></sup> {@“कॄञ् हिंसायाम्”@} <sup id="ref_krm_0263_02"><a href="#foot_krm_0263_02">2</a></sup> प्वादिः, ल्वादिश्च। </li> <li>‘कृणन् कृणीते हिंसायाम्, विक्षेपे किरतीति शे।’ <sup id="ref_krm_0263_03"><a href="#foot_krm_0263_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_0263_04"><a href="#foot_krm_0263_04">4</a></sup> <sup id="ref_krm_0263_05"><a href="#foot_krm_0263_05">5</a></sup> कारकः-रिका, कारकः-रिका, <sup id="ref_krm_0263_06"><a href="#foot_krm_0263_06">6</a></sup> चिकरीषकः-चिकरिषकः- <sup id="ref_krm_0263_07"><a href="#foot_krm_0263_07">7</a></sup> चिकीर्षकः-र्षिका, <sup id="ref_krm_0263_08"><a href="#foot_krm_0263_08">8</a></sup> चेकिरकः-रिका;</li> <li>  <sup id="ref_krm_0263_09"><a href="#foot_krm_0263_09">9</a></sup> करीता-करिता-त्री, कारयिता-त्री, चिकरीषिता-चिकरिषिता-चिकीर्षिता-त्री, चेकिरिता-त्री;</li> <li>  <sup id="ref_krm_0263_10"><a href="#foot_krm_0263_10">10</a></sup> कृणन्-ती, कारयन्-न्ती, चिकरीषन्-चिकरिषन्-चिकीर्षन्-न्ती;</li> <li>  -- करीष्यन्-करिष्यन्-न्ती-ती, कारयिष्यन्-न्ती-ती, चिकरीषिष्यन्-चिकरिषिष्यन्-चिकीर्षिष्यन्-न्ती-ती;</li> <li>  -- कृणानः, कारयमाणः, चिकरीषमाणः-चिकरिषमाणः-चिकीर्षमाणः, चेकीर्यमाणः;</li> <li>  करीष्यमाणः-करिष्यमाणः, कारयिष्यमाणः, चिकरीषिष्यमाणः-चिकरिषिष्यमाणः-चिकीर्षिष्यमाणः, चेकिरिष्यमाणः;</li> <li>  <sup id="ref_krm_0263_11"><a href="#foot_krm_0263_11">11</a></sup> कीः-किरौ-किरः;</li> <li>  -- -- -- -- <sup id="ref_krm_0263_12"><a href="#foot_krm_0263_12">12</a></sup> कीर्णम्-कीर्णः-कीर्णवान्, कारितः, चिकरीषितः-चिकरिषितः-चिकीर्षितः, चेकिरितः-तवान्;</li> <li>  <sup id="ref_krm_0263_13"><a href="#foot_krm_0263_13">13</a></sup> <sup id="ref_krm_0263_14"><a href="#foot_krm_0263_14">14</a></sup> किरः, कारः, चिकरीषुः-चिकरिषुः-चिकीर्षुः, <sup id="ref_krm_0263_15"><a href="#foot_krm_0263_15">15</a></sup> चेकिरः;</li> <li>  करीतव्यम्-करितव्यम्, कारयितव्यम्, चिकरीषितव्यम्-चिकरिषितव्यम्-चिकीर्षितव्यम्, चेकिरितव्यम्;</li> <li>  करणीयम्, कारणीयम्, चिकरीषणीयम्-चिकरिषणीयम्-चिकीर्षणीयम्, चेकिरणीयम्;</li> <li>  <sup id="ref_krm_0263_16"><a href="#foot_krm_0263_16">16</a></sup> कार्यम्, कार्यम्, चिकरीष्यम्-चिकरिष्यम्-चिकीर्ष्यम्, चेकीर्यम्;</li> <li>  ईषत्करः-दुष्करः-सुकरः;</li> <li>  -- -- -- -- <sup id="ref_krm_0263_17"><a href="#foot_krm_0263_17">17</a></sup> करः, कारः, चिकरीषः-चिकरिषः-चिकीर्षः, चेकिरः;</li> <li>  <sup id="ref_krm_0263_18"><a href="#foot_krm_0263_18">18</a></sup> करीतुम्-करितुम्, कारयितुम्, चिकरीषितुम्-चिकरिषितुम्-चिकीर्षितुम्, चेकिरितुम्;</li> <li>  <sup id="ref_krm_0263_19"><a href="#foot_krm_0263_19">19</a></sup> कीर्णीः, <sup id="ref_krm_0263_20"><a href="#foot_krm_0263_20">20</a></sup> कारा, कारणा, चिकरीषा-चिकरिषा-चिकीर्षा, चेकिरा;</li> <li>  करणम्, कारणम्, चिकरीषणम्-चिकरिषणम्-चिकीर्षणम्, चेकिरणम्;</li> <li>  कीर्त्वा, कारयित्वा, चिकरीषित्वा-चिकरिषित्वा-चिकीर्षित्वा, चेकिरित्वा;</li> <li>  विकीर्य, विकार्य, विचिकरीष्य-विचिकरिष्य-विचिकीर्ष्य, विचेकीर्य;</li> <li>  कारम् २, कीर्त्वा २, कारम् २, कारयित्वा २, चिकरीषम् २, चिकरीषित्वा २, चिकरिषम् २, चिकरिषित्वा २, चिकीर्षम् २, चिकीर्षित्वा २, चेकिरम् २;</li> <li>  चेकिरित्वा २। <sup id="ref_krm_0263_21"><a href="#foot_krm_0263_21">21</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0263_01"><a href="#ref_krm_0263_01">↑</a> (२५८)</li> <li id="foot_krm_0263_02"><a href="#ref_krm_0263_02">↑</a> (९-क्र्यादिः-१४८५। सक। सेट्। उभ।)</li> <li id="foot_krm_0263_03"><a href="#ref_krm_0263_03">↑</a> (श्लो। ३९)</li> <li id="foot_krm_0263_04"><a href="#ref_krm_0263_04">↑</a> [पृष्ठम्०२६०+ २०]</li> <li id="foot_krm_0263_05"><a href="#ref_krm_0263_05">↑</a> [[१। ‘इत्त्वोत्त्वाभ्यां गुणवृद्धी विप्रतिषेधेन’ (वा। ७-१-१०२) इति वचनात् इत्त्वं बाधित्वा, ‘अचो ञ्णिति’ (७-२-११५) इति वृद्धिः।]]</li> <li id="foot_krm_0263_06"><a href="#ref_krm_0263_06">↑</a> [[२। ‘इट् सनि वा’ (७-२-४१) इति सन इड्विकल्पः। इट्पक्षे ‘वॄतो वा’ (७-२-३८) इति दीर्घविकल्पः। एवं सर्वत्र इट्पक्षे सनि ज्ञेयम्।]]</li> <li id="foot_krm_0263_07"><a href="#ref_krm_0263_07">↑</a> [[३। इडभावपक्षे, ‘इको झल्’ (१-२-९) इति सनः कित्त्वे, ‘ॠत इद्धातोः’ (७-१-१००) इति इत्त्वे रपरत्वे च, ‘हलि च’ (८-२-७७) इति दीर्घः। एवं इडभावपक्षे सनि सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0263_08"><a href="#ref_krm_0263_08">↑</a> [[४। इत्त्वरपरत्वद्वित्वेषु कृतेषु ‘गुणो यङ्लुकोः’ (७-४-८२) इत्यभ्यासे गुणः। ‘यस्य हलः’ (६-४-४९) इति यकारलोपः। एवं सर्वत्र यङन्ते ज्ञेयम्।]]</li> <li id="foot_krm_0263_09"><a href="#ref_krm_0263_09">↑</a> [[५। ‘वॄतो वा’ (७-२-३८) इति इटो दीर्घविकल्पः। एवं तव्यदादिषु च ज्ञेयम्।]]</li> <li id="foot_krm_0263_10"><a href="#ref_krm_0263_10">↑</a> [[६। ‘क्र्यादिभ्यः श्ना’ (३-१-८१) इति श्ना विकरणप्रत्ययः। ‘प्वादीनां ह्रस्वः’ (७-३-८०) इति शिति परे ह्रस्वः। ‘श्नाऽभ्यस्तयोरातः’ (६-४-११२) इत्याकार- लोपः। ‘ऋवर्णान्नस्य णत्वं वाच्यम्’ (वा। ८-४-१) इति णत्वम्। एवं ‘कृणानः’ इत्यत्रापि ज्ञेयम्।]]</li> <li id="foot_krm_0263_11"><a href="#ref_krm_0263_11">↑</a> [[७। इत्त्वे रपरत्वे च ‘र्वोरुपधाया दीर्घ इकः’ (८-२-७६) इति दीर्घः।]]</li> <li id="foot_krm_0263_12"><a href="#ref_krm_0263_12">↑</a> [[८। ‘श्र्युकः क्किति’ (७-२-११) इतीण्णिषेधः। इत्वे रपरत्वे च ‘ल्वादिभ्यः’ (८-२-४४) इति निष्ठानत्वम्। ‘रषाभ्याम्--’ (८-४-१) इति णत्वम्।]]</li> <li id="foot_krm_0263_13"><a href="#ref_krm_0263_13">↑</a> [पृष्ठम्०२६१+ १७]</li> <li id="foot_krm_0263_14"><a href="#ref_krm_0263_14">↑</a> [[१। ‘इगुपधज्ञाप्रीकिरः कः’ (३-१-१३५) इति कर्तरि कः।]]</li> <li id="foot_krm_0263_15"><a href="#ref_krm_0263_15">↑</a> [[२। यङन्तात् पचाद्यचि (३-१-१३४), ‘यङोऽचि च’ (२-४-७४) इति लुक्।]]</li> <li id="foot_krm_0263_16"><a href="#ref_krm_0263_16">↑</a> [[३। ‘ऋहलोर्ण्यत्’ (३-१-१२४) इति ण्यत्।]]</li> <li id="foot_krm_0263_17"><a href="#ref_krm_0263_17">↑</a> [[४। ‘ॠदोरप्’ (३-३-५७) इति भावेऽप्।]]</li> <li id="foot_krm_0263_18"><a href="#ref_krm_0263_18">↑</a> [[आ। ‘द्वारं पुनन् पदतलेन स लूनवैरी स्तीर्णाननं मदजलेन करीतुकामम्। नागं ददर्श पटबूर्णमुखं धुनानं कर्णौ शृणन्तमखिलानभिपूर्तरोषम्।।’ धा। का। ३-६।]]</li> <li id="foot_krm_0263_19"><a href="#ref_krm_0263_19">↑</a> [[५। ‘ॠल्वादिभ्यः क्तिन् निष्ठावद् वाच्यः’ (वा। ८-२-४४) इति क्तिनस्तकारस्य नकारः। णत्वम्।]]</li> <li id="foot_krm_0263_20"><a href="#ref_krm_0263_20">↑</a> [[६। ‘कारा बन्धने’ (गणसूत्रम् ३-३-१०४) इति भिदादिषु पाठात् अङ्। निपात- नात् वृद्धिः। ण्यन्ताद्वा अङ्।]]</li> <li id="foot_krm_0263_21"><a href="#ref_krm_0263_21">↑</a> [पृष्ठम्०२६२+ २८]</li></ul></p>

कॄ|कारकः-रिका|चिकरीषकः-चिकरिषकः-चिकीर्षकः-र्षिका|चेकिरकः-रिका
<ul><li><sup id="ref_krm_0264_01"><a href="#foot_krm_0264_01">1</a></sup> {@“कॄ हिंसायाम्”@} <sup id="ref_krm_0264_02"><a href="#foot_krm_0264_02">2</a></sup> प्वादिः, ल्वादिश्च। </li> <li>कारकः-रिका, कारकः-रिका, चिकरीषकः-चिकरिषकः-चिकीर्षकः-र्षिका, चेकिरकः-रिका;</li> <li>  कृणन्-ती, इत्यादीनि सर्वाण्यपि रूपाणि पूर्वोक्तकॄ <sup id="ref_krm_0264_03"><a href="#foot_krm_0264_03">3</a></sup> धातुवत् ज्ञेयानि। </li> <li>एकस्मिन्नेव विकरणे पुनः पाठः, कर्तृगामिन्यपि क्रियाफले परस्मैपदार्थः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0264_01"><a href="#ref_krm_0264_01">↑</a> (२५८-आ)</li> <li id="foot_krm_0264_02"><a href="#ref_krm_0264_02">↑</a> (९-क्र्यादिः-१४९६। सक। सेट्। पर।)</li> <li id="foot_krm_0264_03"><a href="#ref_krm_0264_03">↑</a> (२५८)</li></ul></p>

