<ul><li><sup id="ref_krm_1163_01"><a href="#foot_krm_1163_01">1</a></sup> {@“भा दीप्तौ”@} <sup id="ref_krm_1163_02"><a href="#foot_krm_1163_02">2</a></sup> <sup id="ref_krm_1163_03"><a href="#foot_krm_1163_03">3</a></sup> भायकः-यिका, <sup id="ref_krm_1163_04"><a href="#foot_krm_1163_04">4</a></sup> भापकः-पिका, बिभासकः-सिका, बाभायकः-यिका;</li> <li>  भाता-भात्री, भापयिता-त्री, बिभासिता-त्री, बाभायिता-त्री;</li> <li>  <sup id="ref_krm_1163_05"><a href="#foot_krm_1163_05">5</a></sup> <sup id="ref_krm_1163_06"><a href="#foot_krm_1163_06">6</a></sup> भान्-भान्ती-भाती, <sup id="ref_krm_1163_07"><a href="#foot_krm_1163_07">7</a></sup> भापयन्-न्ती, बिभासन्-न्ती;</li> <li>  -- भास्यन्-न्ती-ती, भापयिष्यन्-न्ती-ती, बिभासिष्यन्-न्ती-ती;</li> <li>  -- <sup id="ref_krm_1163_08"><a href="#foot_krm_1163_08">8</a></sup> व्यतिप्रभानः, भापयमानः, भापयिष्यमाणः, -- बाभायमानः, बाभायिष्यमाणः;</li> <li>  भाः-भौ-भाः;</li> <li>  -- -- सुप्रभातम्-तः, भापितः, बिभासितः, बाभायितः-तवान्;</li> <li>  <sup id="ref_krm_1163_09"><a href="#foot_krm_1163_09">9</a></sup> निभः, <sup id="ref_krm_1163_10"><a href="#foot_krm_1163_10">10</a></sup> आभः, <sup id="ref_krm_1163_11"><a href="#foot_krm_1163_11">11</a></sup> भम्, <sup id="ref_krm_1163_12"><a href="#foot_krm_1163_12">12</a></sup> विभावरी, <sup id="ref_krm_1163_13"><a href="#foot_krm_1163_13">13</a></sup> भायः, बिभासुः, <sup id="ref_krm_1163_14"><a href="#foot_krm_1163_14">14</a></sup> बाभाः;</li> <li>  भातव्यम्, भापयितव्यम्, बिभासितव्यम्, बाभायितव्यम्;</li> <li>  <sup id="ref_krm_1163_15"><a href="#foot_krm_1163_15">15</a></sup> प्रभानीयम्, <sup id="ref_krm_1163_16"><a href="#foot_krm_1163_16">16</a></sup> प्रभापनीयम्, बिभासनीयम्, बाभायनीयम्;</li> <li>  भेयम्, भाप्यम्, बिभास्यम्, बाभाय्यम्;</li> <li>  ईषद्भानः- <sup id="ref_krm_1163_17"><a href="#foot_krm_1163_17">17</a></sup> दुर्भानः-सुभानः;</li> <li>  -- -- भायमानः, भापयमानः, बिभास्यमानः, बाभाय्यमानः;</li> <li>  <sup id="ref_krm_1163_18"><a href="#foot_krm_1163_18">18</a></sup> भायः, भापः, बिभासः, बाभायः;</li> <li>  भातुम्, भापयितुम्, बिभासितुम्, बाभायितुम्;</li> <li>  भातिः, <sup id="ref_krm_1163_19"><a href="#foot_krm_1163_19">19</a></sup> प्रतिभा, प्रभा, विभा, आभा, भाः भापना, बिभासा, बाभाया;</li> <li>  <sup id="ref_krm_1163_20"><a href="#foot_krm_1163_20">20</a></sup> प्रभानम्, भापनम्, बिभासनम्, बाभायनम्;</li> <li>  भात्वा, भापयित्या, बिभासित्वा, बाभायित्वा;</li> <li>  प्रभाय, प्रभाप्य, प्रबिभास्य, प्रबाभाय्य;</li> <li>  भायम् २, भात्वा २, भापम् २, भापयित्वा २, बिभासम् २, बिभासित्वा २, बाभायम् २;</li> <li>  बाभायित्वा २;</li> <li>  <sup id="ref_krm_1163_21"><a href="#foot_krm_1163_21">21</a></sup> भातुः, <sup id="ref_krm_1163_22"><a href="#foot_krm_1163_22">22</a></sup> भानुः, <sup id="ref_krm_1163_23"><a href="#foot_krm_1163_23">23</a></sup> भामः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1163_01"><a href="#ref_krm_1163_01">↑</a> (११५३)</li> <li id="foot_krm_1163_02"><a href="#ref_krm_1163_02">↑</a> (२-अदादिः-१०५१। अक। अनि। पर।)</li> <li id="foot_krm_1163_03"><a href="#ref_krm_1163_03">↑</a> [[७। ‘आतो युक्चिण्कृतोः’ (७-३-३३) इति युगागमः। एवं घञि, णमुल्यपि ज्ञेयम्।]]</li> <li id="foot_krm_1163_04"><a href="#ref_krm_1163_04">↑</a> [[८। ण्यन्ते सर्वत्र, आदन्तलक्षणः पुगागमो ज्ञेयः।]]</li> <li id="foot_krm_1163_05"><a href="#ref_krm_1163_05">↑</a> [पृष्ठम्०९४७+ २८]</li> <li id="foot_krm_1163_06"><a href="#ref_krm_1163_06">↑</a> [[१। शतरि शपि, ‘अदिप्रभृतिभ्यः--’ (२-४-७२) इति शपो लुकि रूपमेवम्। स्त्रियाम्, ‘आच्छीनद्योः--’ (७-१-८०) इति नुम्विकल्पः।]]</li> <li id="foot_krm_1163_07"><a href="#ref_krm_1163_07">↑</a> [[२। दीप्तेः चित्तवत्कर्तृकत्वे, ‘अणावकर्मकात् चित्तवत्कर्तृकात्’ (१-३-८८) इति ण्यन्तात् परस्मैपदमेव। अचित्तवत्कर्तृकत्वे तु शानजपि भवतीति विशेषः।]]</li> <li id="foot_krm_1163_08"><a href="#ref_krm_1163_08">↑</a> [[आ। ‘ष्यतिप्रभानो विविधस्तदोच्चकैः तत्रैधते माङ्गलिकः स्म निस्वनः।’ वा। वि। १। ३५]]</li> <li id="foot_krm_1163_09"><a href="#ref_krm_1163_09">↑</a> [[३। ‘आतश्चोपसर्गे, (३-१-१३६) इति कर्तरि कप्रत्ययः। ‘आतो लोप इटि च’ (६-४-६४) इति आकारलोपः। निभः = तुल्यः। अत्र धात्वर्थानुगमाभावस्तु उपसर्गवशात् धातोरर्थान्तरे वृत्तेरिति ज्ञेयम्।]]</li> <li id="foot_krm_1163_10"><a href="#ref_krm_1163_10">↑</a> [[B। ‘मरुत्प्रयुक्ताश्च मरुत्सखाभं तमर्च्यमारादभिवर्तमानम्।’ रघुवंशे २। १०।]]</li> <li id="foot_krm_1163_11"><a href="#ref_krm_1163_11">↑</a> [[४। ‘अन्येभ्योऽपि दृश्यत इति वाच्यम्’ (वा। ३-२-१०१) इति वचनादत्र डप्रत्यये, डित्त्वसामर्थ्यात् भसंज्ञाभावेऽपि टिलोपे रूपमेवम्। भातीति भम् = नक्षत्रम्।]]</li> <li id="foot_krm_1163_12"><a href="#ref_krm_1163_12">↑</a> [[५। विपूर्वकादस्मात्, ‘अन्येभ्योऽपि दृश्यन्ते’ (३-२-७५) इति वनिप्प्रत्यये, स्त्रियाम्, ‘वनो र च’ (४-१-७) इति ङीब्रेफौ भवतः। विभावरी = रात्रिः।]]</li> <li id="foot_krm_1163_13"><a href="#ref_krm_1163_13">↑</a> [[६। ‘श्याऽऽद्व्यध--’ (३-१-१४१) इत्यादिना कर्तरि णप्रत्यये युगागमे च रूपम्।]]</li> <li id="foot_krm_1163_14"><a href="#ref_krm_1163_14">↑</a> [[७। यङन्तात् पचाद्यचि यङो लोपे, रूपमेवम्।]]</li> <li id="foot_krm_1163_15"><a href="#ref_krm_1163_15">↑</a> [[८। ‘न भाभूपू--’ (८-४-३४) इत्यनेन, उपसर्गस्थ न्निमित्तात् परस्याच उत्तरस्य कृन्नकारस्य णत्वनिषेधः।]]</li> <li id="foot_krm_1163_16"><a href="#ref_krm_1163_16">↑</a> [[९। ‘ण्यन्तभादीनामुपसंख्यानम्’ (वा। ८-४-३४) इति वचनात् ण्यन्तेऽपि कृन्न- कारस्य णत्वनिषेधः।]]</li> <li id="foot_krm_1163_17"><a href="#ref_krm_1163_17">↑</a> [[१०। ईषदाद्युषपदेषु खलपवादः, आदन्तलक्षणो युच्प्रत्ययः। ‘दुरः षत्वणत्वयोरुप- सर्गत्वप्रतिषेधो वाच्यः। (वा। १-४-६०)’ इति वचनान्न णत्वं षत्वं वाऽत्रेति ज्ञेयम्।]]</li> <li id="foot_krm_1163_18"><a href="#ref_krm_1163_18">↑</a> [पृष्ठम्०९४८+ २४]</li> <li id="foot_krm_1163_19"><a href="#ref_krm_1163_19">↑</a> [[१। स्त्रियाम्, ‘आतश्चोपसर्गे’ (३-३-१०६) इति भावादावङ् प्रत्ययः। सम्पदादि- त्वात् (वा। ३-३-९४) भावे क्विपि तु भाः इत्यपि भवति।]]</li> <li id="foot_krm_1163_20"><a href="#ref_krm_1163_20">↑</a> [[आ। ‘हरेः प्रगमनं नास्ति न प्रभानं हिमद्रुहः।’ भ। का। ९। १०७।]]</li> <li id="foot_krm_1163_21"><a href="#ref_krm_1163_21">↑</a> [[२। ‘कमिमनिजनिगाभा--’ (द। उ। १-१२५) इत्यादिना तुप्रत्ययः। भातीति भातुः = प्रकाशः।]]</li> <li id="foot_krm_1163_22"><a href="#ref_krm_1163_22">↑</a> [[३। ‘दाभाभ्यां नुः’ (द। उ। १-१४३) इति नुप्रत्ययः। भानुः = आदित्यः, किरणश्च।]]</li> <li id="foot_krm_1163_23"><a href="#ref_krm_1163_23">↑</a> [[४। ‘अर्तिस्तु--’ (द। उ। ७-२६) इति मन्प्रत्ययः। भामः = क्रोधः।]]</li></ul></p>

भाज|भाजकः-जिका|बिभाजयिषकः-षिका|भाजयिता-त्री|बिभाजयिषिता-त्री
<ul><li><sup id="ref_krm_1164_01"><a href="#foot_krm_1164_01">1</a></sup> {@“भाज पृथक्कर्मणि”@} <sup id="ref_krm_1164_02"><a href="#foot_krm_1164_02">2</a></sup> अदन्तः। </li> <li>‘आमर्दे तु भनक्ति भाजयति णौ भाजेः पृथक्कर्मणि।।’ <sup id="ref_krm_1164_03"><a href="#foot_krm_1164_03">3</a></sup> इति देवः। </li> <li>भाजकः-जिका, बिभाजयिषकः-षिका, भाजयिता-त्री, बिभाजयिषिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिककालयतिवत् <sup id="ref_krm_1164_04"><a href="#foot_krm_1164_04">4</a></sup> ज्ञेयानि। </li> <li>यत्प्रत्यये-- <sup id="ref_krm_1164_05"><a href="#foot_krm_1164_05">5</a></sup> विभाज्यः इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1164_01"><a href="#ref_krm_1164_01">↑</a> (११५४)</li> <li id="foot_krm_1164_02"><a href="#ref_krm_1164_02">↑</a> (१०-चुरादिः-१८८७। अक। सेट्। उभ।)</li> <li id="foot_krm_1164_03"><a href="#ref_krm_1164_03">↑</a> (श्लो। ६५)</li> <li id="foot_krm_1164_04"><a href="#ref_krm_1164_04">↑</a> (१८५)</li> <li id="foot_krm_1164_05"><a href="#ref_krm_1164_05">↑</a> [[B। ‘… ये ते निवांसितधियो ह्यसुभिर्विभाज्याः।।’ धा। का। ३। ५६।]]</li></ul></p>

