<ul><li><sup id="ref_krm_0716_01"><a href="#foot_krm_0716_01">1</a></sup> {@“तमु काङ्क्षायाम्”@} <sup id="ref_krm_0716_02"><a href="#foot_krm_0716_02">2</a></sup> शमादिः। </li> <li>घटादिः। </li> <li><sup id="ref_krm_0716_03"><a href="#foot_krm_0716_03">3</a></sup> ‘ग्लानावेव <sup id="ref_krm_0716_04"><a href="#foot_krm_0716_04">4</a></sup> प्रयोगः। </li> <li>मुरारिस्तु ‘द्रष्टुं बहूत्ताम्यति।’ इति काङ्क्षाया- मेवाह।’ इति धातुकाव्यव्याख्याने <sup id="ref_krm_0716_05"><a href="#foot_krm_0716_05">5</a></sup>।]] <sup id="ref_krm_0716_06"><a href="#foot_krm_0716_06">6</a></sup> तमकः-मिका, <sup id="ref_krm_0716_07"><a href="#foot_krm_0716_07">7</a></sup> तमकः-मिका, तितमिषकः-षिका, <sup id="ref_krm_0716_08"><a href="#foot_krm_0716_08">8</a></sup> तन्तमकः-तंतमकः-मिका;</li> <li>  तमिता-त्री, तमयिता-त्री, तितमिषिता-त्री, तन्तमिता-त्री;</li> <li>  <sup id="ref_krm_0716_09"><a href="#foot_krm_0716_09">9</a></sup> ताम्यन्-न्ती, तमयन्-न्ती, तितमिषन्-न्ती;</li> <li>  -- <sup id="ref_krm_0716_10"><a href="#foot_krm_0716_10">10</a></sup> तमिष्यन्-न्ती-ती, तमयिष्यन्-न्ती-ती, तितमिषिष्यन्-न्ती-ती;</li> <li>  -- तमयमानः, तमयिष्यमाणः, तन्तम्यमानः, तन्तमिष्यमाणः;</li> <li>  <sup id="ref_krm_0716_11"><a href="#foot_krm_0716_11">11</a></sup> प्रतान्-प्रतामौ-प्रतामः;</li> <li>  -- -- -- <sup id="ref_krm_0716_12"><a href="#foot_krm_0716_12">12</a></sup> तान्तः, तमितः, तितमिषितः, तन्तमितः-तवान्;</li> <li>  -- तमः, <sup id="ref_krm_0716_13"><a href="#foot_krm_0716_13">13</a></sup> तमी <sup id="ref_krm_0716_14"><a href="#foot_krm_0716_14">14</a></sup>, तमः, तितमिषुः, तन्तमः;</li> <li>  तमितव्यम्, तमयितव्यम्, तितमिषितव्यम्, तन्तमितव्यम्;</li> <li>  तमनीयम्, तमनीयम्, तितमिषणीयम्, तन्तमनीयम्;</li> <li>  <sup id="ref_krm_0716_15"><a href="#foot_krm_0716_15">15</a></sup> तम्यम्, तम्यम्, तितमिष्यम्, तन्तम्यम्;</li> <li>  ईषत्तमः-दुस्तमः-सुतमः;</li> <li>  -- -- -- तम्यमानः, तम्यमानः, तितमिष्यमाणः, तन्तम्यमानः, तमः, तमः, तितमिषः, तन्तमः;</li> <li>  तमितुम्, तमयितुम्, तितमिषितुम्, तन्तमितुम्;</li> <li>  <sup id="ref_krm_0716_16"><a href="#foot_krm_0716_16">16</a></sup> तान्तिः, तमना, तितमिषा, तन्तमा;</li> <li>  तमनम्, तमनम्, तितमिषणम्, तन्तमनम्;</li> <li>  <sup id="ref_krm_0716_17"><a href="#foot_krm_0716_17">17</a></sup> तमित्वा-तान्त्वा, तमयित्वा, तितमिषित्वा, तन्तमित्वा;</li> <li>  प्रतम्य, <sup id="ref_krm_0716_18"><a href="#foot_krm_0716_18">18</a></sup> प्रतमय्य, प्रतितमिष्य, प्रतन्तम्य;</li> <li>  <sup id="ref_krm_0716_19"><a href="#foot_krm_0716_19">19</a></sup> तमम् २, तमित्वा२, तान्त्वा २, <sup id="ref_krm_0716_20"><a href="#foot_krm_0716_20">20</a></sup> तमम् २ -तामम् २, तमित्वा २ -तान्त्वा २, तितमिषम् २, तितमिषित्वा २, तन्तमम् २;</li> <li>  तन्तमित्वा २;</li> <li>  <sup id="ref_krm_0716_21"><a href="#foot_krm_0716_21">21</a></sup> इत्यसुन् प्रत्ययः।]] तमः, <sup id="ref_krm_0716_22"><a href="#foot_krm_0716_22">22</a></sup> असच्प्रत्यये रूपम्।]] तमसा <sup id="ref_krm_0716_23"><a href="#foot_krm_0716_23">23</a></sup>, <sup id="ref_krm_0716_24"><a href="#foot_krm_0716_24">24</a></sup> इति रक्प्रत्ययः, दीर्घश्च। </li> <li>तम्यते जनैरिति ताम्रम् = लोहविशेषः।]] ताम्रम् <sup id="ref_krm_0716_25"><a href="#foot_krm_0716_25">25</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0716_01"><a href="#ref_krm_0716_01">↑</a> (७०६)</li> <li id="foot_krm_0716_02"><a href="#ref_krm_0716_02">↑</a> (४-दिवादिः-१२०२। सक। सेट्। पर।)</li> <li id="foot_krm_0716_03"><a href="#ref_krm_0716_03">↑</a> [[[अ]</li> <li id="foot_krm_0716_04"><a href="#ref_krm_0716_04">↑</a> [अस्य]</li> <li id="foot_krm_0716_05"><a href="#ref_krm_0716_05">↑</a> [२-६५]</li> <li id="foot_krm_0716_06"><a href="#ref_krm_0716_06">↑</a> [[१। ‘नोदात्तोपदेशस्य मान्तस्यानाचमेः’ (७-३-३४) इति वृद्धिनिषेधः। एवं घञि, णमुलि च ज्ञेयम्।]]</li> <li id="foot_krm_0716_07"><a href="#ref_krm_0716_07">↑</a> [[२। ‘जनीजॄष्क्रसुरञ्जोऽमन्ताश्च’ (ग। सू। भ्वादौ) इति मित्संज्ञायाम्, ‘मितां ह्रस्वः’ (६-४-९२) इति णौ उपधाया ह्रस्वः। एवं ण्यन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0716_08"><a href="#ref_krm_0716_08">↑</a> [[३। यङन्ते, ‘नुगतोऽनुनासिकान्तस्य’ (७-४-८४) इत्यभ्यासस्य नुगागमः। तस्य ‘पदान्तवद्वाच्यः’ (वा। ७-४-८४) इति वचनात् पदान्तवद्भावे, ‘वा पदान्तस्य’ (८-४-५९) इति परसवर्णविकल्पः। एवं यङन्ते सर्वत्र रूपद्वयं ज्ञेयम्।]]</li> <li id="foot_krm_0716_09"><a href="#ref_krm_0716_09">↑</a> [[४। ‘शमामष्टानां दीर्घः श्यनि’ (७-३-७४) इति दीर्घः।]]</li> <li id="foot_krm_0716_10"><a href="#ref_krm_0716_10">↑</a> [पृष्ठम्०६५२+ २५]</li> <li id="foot_krm_0716_11"><a href="#ref_krm_0716_11">↑</a> [[१। क्विपि, ‘अनुनासिकस्य क्विझलोः क्ङिति’ (६-४-१५) इति दीर्घे, ‘मो नो धातोः’ (८-२-६४) इति नकारः पदान्ते। तस्य नकारस्य त्रैपादिकत्वात् ‘न लोपः प्राति- पदिकान्तस्य’ (८-२-७) इति लोपो न।]]</li> <li id="foot_krm_0716_12"><a href="#ref_krm_0716_12">↑</a> [[२। उदित्त्वेन क्त्वायामिड्विकल्पनात्, निष्ठायाम्, ‘यस्य विभाषा’ (७-२-१५) इतीण्णिषेधः। ‘अनुनासिकस्य क्वि--’ (६-४-१५) इति दीर्घः। ‘मोऽनुस्वारः’ (८-३-२३) इत्यनुस्वारः। ‘अनुस्वारस्यययि--’ (८-४-५८) इति परसवर्णः।]]</li> <li id="foot_krm_0716_13"><a href="#ref_krm_0716_13">↑</a> [[आ। ‘अशाम्यदात्माऽपि तमी नमामि दमिप्रियं श्रान्तिहरं भवन्तम्।’ धा। का। २। ६५।]]</li> <li id="foot_krm_0716_14"><a href="#ref_krm_0716_14">↑</a> [[३। ‘शमित्यष्टाभ्यो घिनुण् (३-२-१४१) इति तच्छीलादिषु कर्तषु घिनुण्। ‘नोदात्तो- पदेशस्य--’ (७-३-३४) इति वृद्धिनिषेधः।]]</li> <li id="foot_krm_0716_15"><a href="#ref_krm_0716_15">↑</a> [[४। ‘पोरदुपधात्’ (३-१-९३) इति यत्।]]</li> <li id="foot_krm_0716_16"><a href="#ref_krm_0716_16">↑</a> [[५। ‘तितुत्र--’ (७-२-९) इतीण्णिषेधः। अनुस्वारपरसवर्णौ।]]</li> <li id="foot_krm_0716_17"><a href="#ref_krm_0716_17">↑</a> [[६। ‘उदितो वा’ (७-२-५६) इति क्त्वायामिड्विकल्पः। इडभावपक्षे, दीर्घानुस्वार- परसवर्णाः।]]</li> <li id="foot_krm_0716_18"><a href="#ref_krm_0716_18">↑</a> [[७। ‘ल्यपि लघुपूर्वात्’ (६-४-५६) इति णेरयादेशः।]]</li> <li id="foot_krm_0716_19"><a href="#ref_krm_0716_19">↑</a> [पृष्ठम्०६५३+ २४]</li> <li id="foot_krm_0716_20"><a href="#ref_krm_0716_20">↑</a> [[१। ‘चिण्णमुलोर्दीर्घोऽन्यतरस्याम्’ (६-४-९३) इति णमुल्परे णौ दीर्घविकल्पः।]]</li> <li id="foot_krm_0716_21"><a href="#ref_krm_0716_21">↑</a> [[२। ‘असुन्’ [द। उ। ९-४९]</li> <li id="foot_krm_0716_22"><a href="#ref_krm_0716_22">↑</a> [[३। औणादिके [द। उ। ९-४४]</li> <li id="foot_krm_0716_23"><a href="#ref_krm_0716_23">↑</a> [नदी]</li> <li id="foot_krm_0716_24"><a href="#ref_krm_0716_24">↑</a> [[४। ‘असितम्योर्दीर्घश्च’ [द। उ। ८-३६]</li> <li id="foot_krm_0716_25"><a href="#ref_krm_0716_25">↑</a> [[आ। ‘मधुरिपोरभिताम्रमुखी मुदं दिवि तदा विततान शुकावलिः।’ शि। व। ६। ५३।]]</li></ul></p>

तय|तायकः-यिका|तितयिषकः-षिका|तातयिकः-यिका|तयिता-त्री|ताययिता-त्री|तितयिषिता-त्री|तातयिता-त्री
<ul><li><sup id="ref_krm_0717_01"><a href="#foot_krm_0717_01">1</a></sup> {@“तय गतौ”@} <sup id="ref_krm_0717_02"><a href="#foot_krm_0717_02">2</a></sup> तायकः-यिका, तायकः-यिका, तितयिषकः-षिका, तातयिकः-यिका;</li> <li>  तयिता-त्री, ताययिता-त्री, तितयिषिता-त्री, तातयिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकचयतिवत् <sup id="ref_krm_0717_03"><a href="#foot_krm_0717_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0717_04"><a href="#foot_krm_0717_04">4</a></sup> प्रतय्य।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0717_01"><a href="#ref_krm_0717_01">↑</a> (७०७)</li> <li id="foot_krm_0717_02"><a href="#ref_krm_0717_02">↑</a> (१-भ्वादिः-४७९। सक। सेट्। आत्म।)</li> <li id="foot_krm_0717_03"><a href="#ref_krm_0717_03">↑</a> (५०२)</li> <li id="foot_krm_0717_04"><a href="#ref_krm_0717_04">↑</a> [[B। ‘प्रतय्य किंचिन्नयितो गृहान्तिकं ददर्श धन्यः स दयालुमीश्वरम्।’ धा। का। १। ६२।]]</li></ul></p>

तर्क|तर्ककः-र्किका|तितर्कयिषकः-षिका|तर्कयिता-त्री|तितर्कयिषिता-त्री|क्विपि-तर्क्-तर्क्-तर्कौ-|तर्कः
<ul><li><sup id="ref_krm_0718_01"><a href="#foot_krm_0718_01">1</a></sup> {@“तर्क भाषार्थः”@} <sup id="ref_krm_0718_02"><a href="#foot_krm_0718_02">2</a></sup> आस्वदीयः। </li> <li>‘ऊहेऽप्ययमिति मैत्रेयः’ इति मा। </li> <li>धा। </li> <li>वृत्तौ। </li> <li>तर्ककः-र्किका, तितर्कयिषकः-षिका;</li> <li>  तर्कयिता-त्री, तितर्कयिषिता-त्री;</li> <li>  इत्यादीनि सर्वाणि रूपाणि ग्रसधातुवत् <sup id="ref_krm_0718_03"><a href="#foot_krm_0718_03">3</a></sup> बोध्यानि। </li> <li>क्विपि-तर्क्-तर्क्-तर्कौ- तर्कः;</li> <li>  इति रूपाणि। </li> <li>णिलोपे ककारस्य संयोगान्तलोपो न। </li> <li>‘रात् सस्य’ <sup id="ref_krm_0718_04"><a href="#foot_krm_0718_04">4</a></sup> इति नियमात्। </li> <li>न च णिलोपस्य स्थानिवद्भावः शङ्क्यः। </li> <li>पूर्वत्रासिद्धे तन्निषेधात्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0718_01"><a href="#ref_krm_0718_01">↑</a> (७०८)</li> <li id="foot_krm_0718_02"><a href="#ref_krm_0718_02">↑</a> (१०-चुरादिः-१७८१। सक। सेट्। उभ।)</li> <li id="foot_krm_0718_03"><a href="#ref_krm_0718_03">↑</a> (४३९)</li> <li id="foot_krm_0718_04"><a href="#ref_krm_0718_04">↑</a> (८-२-२४)</li></ul></p>

तर्ज|तर्जकः-र्जिका|तितर्जिषकः-षिका|तातर्जकः-र्जिका|तर्जिता-त्री|तर्जयिता-त्री|तितर्जिषिता-त्री|तातर्जिता-त्री
<ul><li><sup id="ref_krm_0719_01"><a href="#foot_krm_0719_01">1</a></sup> {@“तर्ज भर्त्सने”@} <sup id="ref_krm_0719_02"><a href="#foot_krm_0719_02">2</a></sup> ‘सन्तर्जने तर्जयते भर्त्सनार्थे तु तर्जति।।’ <sup id="ref_krm_0719_03"><a href="#foot_krm_0719_03">3</a></sup> इति देवः। </li> <li>तर्जकः-र्जिका, तर्जकः-र्जिका, तितर्जिषकः-षिका, तातर्जकः-र्जिका;</li> <li>  तर्जिता-त्री, तर्जयिता-त्री, तितर्जिषिता-त्री, तातर्जिता-त्री;</li> <li>  <sup id="ref_krm_0719_04"><a href="#foot_krm_0719_04">4</a></sup> इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककर्जधातुवत् <sup id="ref_krm_0719_05"><a href="#foot_krm_0719_05">5</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_0719_06"><a href="#foot_krm_0719_06">6</a></sup> तर्जितः-तवान्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0719_01"><a href="#ref_krm_0719_01">↑</a> (७०९)</li> <li id="foot_krm_0719_02"><a href="#ref_krm_0719_02">↑</a> (१-भ्वादिः-२२७। सक। सेट्। पर।)</li> <li id="foot_krm_0719_03"><a href="#ref_krm_0719_03">↑</a> (श्लो। ६६)</li> <li id="foot_krm_0719_04"><a href="#ref_krm_0719_04">↑</a> [पृष्ठम्०६५४+ २७]</li> <li id="foot_krm_0719_05"><a href="#ref_krm_0719_05">↑</a> (१६९)</li> <li id="foot_krm_0719_06"><a href="#ref_krm_0719_06">↑</a> [[आ। ‘स्वर्गोपमं सर्जितपुण्यसंचयो गभीरगर्जद्रथतर्जिताम्बुदः।’ धा। का। १। ३०।]]</li></ul></p>

तर्ज|तर्जकः-र्जिका|तितर्जयिषकः-षिका|तर्जयिता-त्री|तितर्जयिषिता-त्री|तर्जयमानः|तर्जयिष्यमाणः|तितर्जयिषमाणः|तितर्जयिषिष्यमाणः
<ul><li><sup id="ref_krm_0720_01"><a href="#foot_krm_0720_01">1</a></sup> {@“तर्ज तर्जने”@} <sup id="ref_krm_0720_02"><a href="#foot_krm_0720_02">2</a></sup> आकुस्मीयः। </li> <li>‘सन्तर्जने तर्जयते भर्त्सनार्थे तु तर्जति।।’ <sup id="ref_krm_0720_03"><a href="#foot_krm_0720_03">3</a></sup> इति देवः। </li> <li>तर्जकः-र्जिका, तितर्जयिषकः-षिका, तर्जयिता-त्री, तितर्जयिषिता-त्री;</li> <li>  तर्जयमानः, तर्जयिष्यमाणः, तितर्जयिषमाणः, तितर्जयिषिष्यमाणः;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि गन्धधातुवत् <sup id="ref_krm_0720_04"><a href="#foot_krm_0720_04">4</a></sup> ज्ञेयानि। </li> <li>क्विपि-तर्क्- तर्ग्-तर्जौ-तर्जः, इति रूपाणीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0720_01"><a href="#ref_krm_0720_01">↑</a> (७१०)</li> <li id="foot_krm_0720_02"><a href="#ref_krm_0720_02">↑</a> (१०-चुरादिः-१६८२। सक। सेट्। आत्म।)</li> <li id="foot_krm_0720_03"><a href="#ref_krm_0720_03">↑</a> (श्लो। ६६)</li> <li id="foot_krm_0720_04"><a href="#ref_krm_0720_04">↑</a> (३७५)</li></ul></p>

तर्द|तर्दकः-र्दिका|तितर्दिषकः-षिका|तातर्दकः-र्दिका|तर्दिता-त्री|तर्दयिता-त्री|तितर्दिषिता-त्री|तातर्दिता-त्री
<ul><li><sup id="ref_krm_0721_01"><a href="#foot_krm_0721_01">1</a></sup> {@“तर्द हिंसायाम्”@} <sup id="ref_krm_0721_02"><a href="#foot_krm_0721_02">2</a></sup> <sup id="ref_krm_0721_03"><a href="#foot_krm_0721_03">3</a></sup> तर्दकः-र्दिका, तर्दकः-र्दिका, तितर्दिषकः-षिका, तातर्दकः-र्दिका;</li> <li>  तर्दिता-त्री, तर्दयिता-त्री, तितर्दिषिता-त्री, तातर्दिता-त्री;</li> <li>  इत्यादीनि सर्वाणि रूपाणि कर्जधातुवत् <sup id="ref_krm_0721_04"><a href="#foot_krm_0721_04">4</a></sup> ऊह्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0721_01"><a href="#ref_krm_0721_01">↑</a> (७११)</li> <li id="foot_krm_0721_02"><a href="#ref_krm_0721_02">↑</a> (१-भ्वादिः-५८। अक। सेट्। पर।)</li> <li id="foot_krm_0721_03"><a href="#ref_krm_0721_03">↑</a> [[B। ‘अतर्दकास्त्वद्य विकर्दमाशयाः प्रखर्दवृत्तैरसमन्तितान्तिकाः।’ धा। का। १। ९।]]</li> <li id="foot_krm_0721_04"><a href="#ref_krm_0721_04">↑</a> (१६९)</li></ul></p>

तल|तालकः-लिका|तितालयिषकः-षिका|तालयिता-त्री|तितालयिषिता-|त्री
<ul><li><sup id="ref_krm_0722_01"><a href="#foot_krm_0722_01">1</a></sup> {@“तल प्रतिष्ठायाम्”@} <sup id="ref_krm_0722_02"><a href="#foot_krm_0722_02">2</a></sup> तालकः-लिका, तितालयिषकः-षिका;</li> <li>  तालयिता-त्री, तितालयिषिता- त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि कलधातुवत् <sup id="ref_krm_0722_03"><a href="#foot_krm_0722_03">3</a></sup> बोध्यानि। </li> <li>पचाद्यचि- <sup id="ref_krm_0722_04"><a href="#foot_krm_0722_04">4</a></sup> तलः। </li> <li>‘तलम्-अच्। </li> <li>संज्ञापूर्वको विधिरनित्यः’ <sup id="ref_krm_0722_05"><a href="#foot_krm_0722_05">5</a></sup> इति वृद्ध्यभावः। </li> <li>मैत्रेयस्तु - ‘घुषिरविशब्दने’ <sup id="ref_krm_0722_06"><a href="#foot_krm_0722_06">6</a></sup> इति ज्ञापकं सामान्यमित्युक्त्वा, णिजभावे तलशब्दमाह।।’ इति मा। </li> <li>धा। </li> <li>वृत्तिः।।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0722_01"><a href="#ref_krm_0722_01">↑</a> (७१२)</li> <li id="foot_krm_0722_02"><a href="#ref_krm_0722_02">↑</a> (१०-चुरादिः-१५९८। सक। सेट्। उभ।)</li> <li id="foot_krm_0722_03"><a href="#ref_krm_0722_03">↑</a> (१७५)</li> <li id="foot_krm_0722_04"><a href="#ref_krm_0722_04">↑</a> [[C। ‘दुर्दान्तचक् पशुपचुक्कनमप्यरौत्सीत् प्रक्षालितक्षितितलातुलवर्षरोधी।’ धा। का। ३। २१।]]</li> <li id="foot_krm_0722_05"><a href="#ref_krm_0722_05">↑</a> (परिभाषा ९५)</li> <li id="foot_krm_0722_06"><a href="#ref_krm_0722_06">↑</a> (७-२-२३)</li></ul></p>

तसि|अवतंसकः|वतंसकः|तंसकः-सिका|तितंसयिषकः-षिका|तितंसकः-सिका|तातंसकः-सिका|तंसयिता-त्री|तितंसयिषिता-त्री|तंसिता-त्री|तितंसिता-त्री|तातंसिता-त्री
<ul><li><sup id="ref_krm_0723_01"><a href="#foot_krm_0723_01">1</a></sup> {@“तसि अलङ्करणे”@} <sup id="ref_krm_0723_02"><a href="#foot_krm_0723_02">2</a></sup> ‘तसि भूष अलङ्कारे’ इति दुर्गसम्मतः पाठ इति स्वामी। </li> <li>प्रायेणायम् अवपूर्वः। </li> <li>‘तस्यत्युपक्षयार्थे णौ, अलङ्कारे तु तंसयेत्।।’ <sup id="ref_krm_0723_03"><a href="#foot_krm_0723_03">3</a></sup> इति देवः। </li> <li>अवतंसकः, <sup id="ref_krm_0723_04"><a href="#foot_krm_0723_04">4</a></sup> वतंसकः तंसकः-सिका, तितंसयिषकः-षिका, तंसकः-सिका, <sup id="ref_krm_0723_05"><a href="#foot_krm_0723_05">5</a></sup> तितंसकः-सिका, तातंसकः-सिका;</li> <li>  तंसयिता-त्री, तितंसयिषिता-त्री, तंसिता-त्री, तितंसिता-त्री, तातंसिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकचपिधातुवत् <sup id="ref_krm_0723_06"><a href="#foot_krm_0723_06">6</a></sup> बोध्यानि। </li> <li>इदित्करणात् णिचो वैकल्पिकत्वं बोध्यम्। </li> <li>घञि-- <sup id="ref_krm_0723_07"><a href="#foot_krm_0723_07">7</a></sup> उत्तंसः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0723_01"><a href="#ref_krm_0723_01">↑</a> (७१३)</li> <li id="foot_krm_0723_02"><a href="#ref_krm_0723_02">↑</a> (१०-चुरादिः-१७३०। सक। सेट्। उभ।)</li> <li id="foot_krm_0723_03"><a href="#ref_krm_0723_03">↑</a> (श्लो। १८९)</li> <li id="foot_krm_0723_04"><a href="#ref_krm_0723_04">↑</a> [[१। ‘वष्टि भागुरिरल्लोपमवाप्योरुपसर्गयोः।’ इति वचनेन अवतंसकः-वतंसकः, इत्युभयमपि साधु।]]</li> <li id="foot_krm_0723_05"><a href="#ref_krm_0723_05">↑</a> [पृष्ठम्०६५५+ २५]</li> <li id="foot_krm_0723_06"><a href="#ref_krm_0723_06">↑</a> (४९९)</li> <li id="foot_krm_0723_07"><a href="#ref_krm_0723_07">↑</a> [[आ। ‘आक्रन्दयत्सु निभृतं नृषु लासिताशेषोत्तंसभूषणविमोक्षणयार्हिताभौ।’ धा। का। ३। ४०।]]</li></ul></p>

तसु|तासकः-सिका|तितसिषकः-षिका|तातसकः-सिका|तसिता-त्री|तासयिता-त्री|तितसिषिता-त्री|तातसिता-त्री
<ul><li><sup id="ref_krm_0724_01"><a href="#foot_krm_0724_01">1</a></sup> {@“तसु उपक्षये”@} <sup id="ref_krm_0724_02"><a href="#foot_krm_0724_02">2</a></sup> ‘प्रक्षेपे’ इति मैत्रेयः। </li> <li>‘तस्यत्युपक्षयार्थे णौ, अलङ्कारे तु तंसयेत्।।’ <sup id="ref_krm_0724_03"><a href="#foot_krm_0724_03">3</a></sup> इति देवः। </li> <li>तासकः-सिका, तासकः-सिका, तितसिषकः-षिका, तातसकः-सिका;</li> <li>  तसिता-त्री, तासयिता-त्री, तितसिषिता-त्री, तातसिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि दैवादिकक्नसुधातुवत् <sup id="ref_krm_0724_04"><a href="#foot_krm_0724_04">4</a></sup> बोध्यानि। </li> <li>‘जनीजॄष्क्नसु--’ <sup id="ref_krm_0724_05"><a href="#foot_krm_0724_05">5</a></sup> इति मित्त्वं नात्र प्रवर्तते, इति विशेषः। </li> <li>ल्युटि-- <sup id="ref_krm_0724_06"><a href="#foot_krm_0724_06">6</a></sup> तसनम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0724_01"><a href="#ref_krm_0724_01">↑</a> (७१४)</li> <li id="foot_krm_0724_02"><a href="#ref_krm_0724_02">↑</a> (४-दिवादिः-१२१२। अक। सेट्। पर।)</li> <li id="foot_krm_0724_03"><a href="#ref_krm_0724_03">↑</a> (श्लो। १८९)</li> <li id="foot_krm_0724_04"><a href="#ref_krm_0724_04">↑</a> (२६५)</li> <li id="foot_krm_0724_05"><a href="#ref_krm_0724_05">↑</a> (ग। सू। घटादौ)</li> <li id="foot_krm_0724_06"><a href="#ref_krm_0724_06">↑</a> [[B। ‘अस्तायासविजस्तविश्वतसनो निर्दस्तवासैर्नुतः-- भृश्यद्भ्रंशनवर्शकाकृशदयस्तृष्णाहरो हृष्य मे।।’ धा। का। २। ६६।]]</li></ul></p>

तायृ|तायकः-यिका|तितायिषकः-षिका|तातायकः-यिका|तायिता-त्री|ताययिता-त्री|तितायिषिता-त्री|तातायिता-त्री
<ul><li><sup id="ref_krm_0725_01"><a href="#foot_krm_0725_01">1</a></sup> {@“तायृ सन्तानपालनयोः”@} <sup id="ref_krm_0725_02"><a href="#foot_krm_0725_02">2</a></sup> सन्तानम् = प्रबन्धः। </li> <li>आद्ये -- अकर्मकः। </li> <li>द्वितीये -- सकर्मकः। </li> <li>तायकः-यिका, तायकः-यिका, तितायिषकः-षिका, तातायकः-यिका;</li> <li>  तायिता-त्री, ताययिता-त्री, तितायिषिता-त्री, तातायिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि कासृधातुवत् <sup id="ref_krm_0725_03"><a href="#foot_krm_0725_03">3</a></sup> ज्ञेयानि। </li> <li>क्विपि -- मित्रं तायते रक्षतीति, मित्रताः। </li> <li>वलि लोपे आकारान्तं प्रातिपदिकम्, इति विशेषः। </li> <li>अशेषताम् <sup id="ref_krm_0725_04"><a href="#foot_krm_0725_04">4</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0725_01"><a href="#ref_krm_0725_01">↑</a> (७१५)</li> <li id="foot_krm_0725_02"><a href="#ref_krm_0725_02">↑</a> (१-भ्वादिः-४८९। सक। सेट्। आत्म।)</li> <li id="foot_krm_0725_03"><a href="#ref_krm_0725_03">↑</a> (१८८)</li> <li id="foot_krm_0725_04"><a href="#ref_krm_0725_04">↑</a> [[C। ‘अशेषता भ्रूशलनैर्वलद्दृशा प्रवल्लमानं प्रियवल्लवीशुचम्।।’ धा। का। १। ६३।]]</li></ul></p>

