<ul><li><sup id="ref_krm_0286_01"><a href="#foot_krm_0286_01">1</a></sup> {@“क्रुश आह्वाने रोदने च”@} <sup id="ref_krm_0286_02"><a href="#foot_krm_0286_02">2</a></sup> ज्वलादिः। </li> <li>क्रोशकः-शिका, कोशकः-शिका, <sup id="ref_krm_0286_03"><a href="#foot_krm_0286_03">3</a></sup> चुक्रुक्षकः-क्षिका, चोक्रुशकः-शिका;</li> <li>  <sup id="ref_krm_0286_04"><a href="#foot_krm_0286_04">4</a></sup> क्रोष्टा-ष्ट्री, क्रोशयिता-त्री, चुक्रुक्षिता-त्री, चोक्रुशिता-त्री;</li> <li>  क्रोशन्-न्ती, क्रोशयन्-न्ती, चुक्रुक्षन्-न्ती;</li> <li>  -- क्रोक्ष्यन्-न्ती-ती, क्रोशयिष्यन्-न्ती-ती, चुक्रुक्षिष्यन्-न्ती-ती;</li> <li>  -- <sup id="ref_krm_0286_05"><a href="#foot_krm_0286_05">5</a></sup> व्यतिक्रोशमानः, क्रोशयमानः, -- चोक्रुश्यमानः;</li> <li>  व्यतिक्रोक्ष्यमाणः, क्रोशयिष्यमाणः, -- चोक्रुशिष्यमाणः;</li> <li>  <sup id="ref_krm_0286_06"><a href="#foot_krm_0286_06">6</a></sup> क्रुट्-क्रुड्-क्रुशौ-क्रुशः;</li> <li>  -- -- -- <sup id="ref_krm_0286_07"><a href="#foot_krm_0286_07">7</a></sup> क्रुष्टम्- <sup id="ref_krm_0286_08"><a href="#foot_krm_0286_08">8</a></sup> क्रुष्टः-क्रुष्टवान्, क्रोशितः, चुक्रुक्षितः, चोक्रुशितः-तवान्;</li> <li>  क्रुशः- <sup id="ref_krm_0286_09"><a href="#foot_krm_0286_09">9</a></sup> क्रोशः, <sup id="ref_krm_0286_10"><a href="#foot_krm_0286_10">10</a></sup> बान्धवक्रोशी, <sup id="ref_krm_0286_11"><a href="#foot_krm_0286_11">11</a></sup> आक्रोशकः, <sup id="ref_krm_0286_12"><a href="#foot_krm_0286_12">12</a></sup> उष्ट्रकोशी, क्रोशः, चुक्रुक्षुः, चोक्रुशः;</li> <li>  क्रोष्टव्यम्, क्रोशयितव्यम्, चुक्रुक्षितव्यम्, चोक्रुशितव्यम्;</li> <li>  क्रोशनीयम्, क्रोशनीयम्, चुक्रुक्षणीयम्, चोक्रुशनीयम्;</li> <li>  क्रोश्यम्, क्रोश्यम्, चुक्रुक्ष्यम्, चोक्रुश्यम्;</li> <li>  ईषत्क्रोशः-दुष्क्रोशः-सुक्रोशः;</li> <li>  -- -- क्रुश्यमानः, क्रोश्यमानः, चुक्रुक्ष्यमाणः, चोक्रुश्यमानः;</li> <li>  <sup id="ref_krm_0286_13"><a href="#foot_krm_0286_13">13</a></sup> क्रोशः, क्रोशः, चुक्रुक्षः, चोक्रुशः;</li> <li>  क्रोष्टुम्, क्रोशयितुम्, चुक्रुक्षितुम्, चोक्रुशितुम्;</li> <li>  आक्रुष्टिः, <sup id="ref_krm_0286_14"><a href="#foot_krm_0286_14">14</a></sup> व्यावक्रोशी, आक्रोशना, चुक्रुक्षा, चोक्रुशा;</li> <li>  क्रोशनम्, क्रोशनम्, चुक्रुक्षणम्, चोक्रुशनम्;</li> <li>  <sup id="ref_krm_0286_15"><a href="#foot_krm_0286_15">15</a></sup> क्रुष्ट्वा, क्राशयित्वा, चुक्रुक्षित्वा, चोक्रुशित्वा;</li> <li>  आक्रुश्य, सङ्क्रोश्य, सञ्चुक्रुक्ष्य, सञ्चोक्रुश्य;</li> <li>  क्रोशम् २, क्रुष्ट्वा २, क्रोशम् २, क्रोशयित्वा २, चुक्रुक्षम् २, चुक्रुक्षित्वा २, चोक्रुशम् २;</li> <li>  चोक्रुशित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0286_01"><a href="#ref_krm_0286_01">↑</a> (२७९)</li> <li id="foot_krm_0286_02"><a href="#ref_krm_0286_02">↑</a> (१-भ्वादिः-८५६। सक। अनि। पर।)</li> <li id="foot_krm_0286_03"><a href="#ref_krm_0286_03">↑</a> [[६। ‘हलन्ताच्च’ (१-२-१०) इति सनः कित्त्वम्। षत्वम्। ‘षढोः कः सि’ (८-२-४१) इति ककारः। ‘आदेशप्रत्यययोः’ (८-३-५९) इति षकारः।]]</li> <li id="foot_krm_0286_04"><a href="#ref_krm_0286_04">↑</a> [पृष्ठम्०२९०+ २६]</li> <li id="foot_krm_0286_05"><a href="#ref_krm_0286_05">↑</a> [[१। ‘कर्तरि कर्मव्यतीहारे’ (१-३-१४) इति शानच्।]]</li> <li id="foot_krm_0286_06"><a href="#ref_krm_0286_06">↑</a> [[२। ‘व्रश्च--’ (८-२-३६) इत्यादिना षत्वे, ‘झलां जशोऽन्ते’ (८-२-३९) इति जश्त्वम्।]]</li> <li id="foot_krm_0286_07"><a href="#ref_krm_0286_07">↑</a> [[आ। ‘आशितम्भवमुत्क्रुष्टं वल्गितं शयितं स्थितम्।’ भ। का। ६-१०६।]]</li> <li id="foot_krm_0286_08"><a href="#ref_krm_0286_08">↑</a> [[३। ‘मतिबुद्धिपूजार्थेभ्यश्च’ (३-२-१८८) इति चकारात्, ‘गत्यर्थाकर्मक--’ (३-४-७२) इत्यनेन रोदनेऽकर्मकत्वाद्वा क्तः कर्तरि वर्तमाने।]]</li> <li id="foot_krm_0286_09"><a href="#ref_krm_0286_09">↑</a> [[४। ‘ज्वलितिकसन्तेभ्यो णः’ (३-१-१४०) इति वा णः। पक्षे ‘इगुपध--’ (३-१-१३५) इति कर्तरि कः।]]</li> <li id="foot_krm_0286_10"><a href="#ref_krm_0286_10">↑</a> [[B। ‘बान्धवाक्रोशिनो भेजुः अनाथाः ककुभो दश।।’ भ। का। ६-१२३।]]</li> <li id="foot_krm_0286_11"><a href="#ref_krm_0286_11">↑</a> [[५। ‘देविक्रुशोश्चोपसर्गे’ (३-२-१४७) इति ताच्छीलिके वुञि रूपम्।]]</li> <li id="foot_krm_0286_12"><a href="#ref_krm_0286_12">↑</a> [[६। ‘कर्तर्युपमाने’ (३-२-७९) इति कर्तरि णिनिः।]]</li> <li id="foot_krm_0286_13"><a href="#ref_krm_0286_13">↑</a> [[७। ‘हलश्च’ (३-३-१२१) इति संज्ञायां घञ्।]]</li> <li id="foot_krm_0286_14"><a href="#ref_krm_0286_14">↑</a> [[८। ‘कर्मव्यतीहारे--’ (३-३-४३) इति णच्। ‘णचस्त्रियामञ्’ (५-४-१४) इत्यञ्। ‘टिड्ढा--’ (४-१-१५) इत्यादिना ङीप्।]]</li> <li id="foot_krm_0286_15"><a href="#ref_krm_0286_15">↑</a> [पृष्ठम्०२९१+ २९]</li></ul></p>

