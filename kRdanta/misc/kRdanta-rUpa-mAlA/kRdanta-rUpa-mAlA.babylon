<ul><li><sup id="ref_krm_0809_01"><a href="#foot_krm_0809_01">1</a></sup> {@“त्रैङ् पालने”@} <sup id="ref_krm_0809_02"><a href="#foot_krm_0809_02">2</a></sup> <sup id="ref_krm_0809_03"><a href="#foot_krm_0809_03">3</a></sup> त्रायकः-यिका, <sup id="ref_krm_0809_04"><a href="#foot_krm_0809_04">4</a></sup> त्रापकः-पिका, तित्रासकः-सिका, तात्रायकः-यिका;</li> <li>  त्राता-त्रात्री, त्रापयिता-त्री, तित्रासिता-त्री, तात्रायिता-त्री;</li> <li>  -- त्रापयन्-न्ती, त्रापयिष्यन्-न्ती-ती;</li> <li>  -- -- <sup id="ref_krm_0809_05"><a href="#foot_krm_0809_05">5</a></sup> त्रायमाणः, <sup id="ref_krm_0809_06"><a href="#foot_krm_0809_06">6</a></sup> चोरात्] त्रायमाणः, त्रापयमाणः, तित्रासमानः, तात्राय्यमाणः;</li> <li>  त्रास्यमानः, त्रापयिष्यमाणः, तित्रासिष्यमाणः, तात्रायिष्यमाणः;</li> <li>  सुत्राः-सुत्रौ-सुत्राः;</li> <li>  -- -- -- <sup id="ref_krm_0809_07"><a href="#foot_krm_0809_07">7</a></sup> त्रातम्-त्राणम्-त्रातः-त्राणः-त्रातवान्-त्राणवान्, <sup id="ref_krm_0809_08"><a href="#foot_krm_0809_08">8</a></sup> देवत्रातः-भवत्रातः, त्रापितः, तित्रासितः, तात्रायितः-तवान्;</li> <li>  <sup id="ref_krm_0809_09"><a href="#foot_krm_0809_09">9</a></sup> गोत्रः, <sup id="ref_krm_0809_10"><a href="#foot_krm_0809_10">10</a></sup> सुत्रः, आतपत्रम्, अङ्गुलित्रम्, <sup id="ref_krm_0809_11"><a href="#foot_krm_0809_11">11</a></sup> <sup id="ref_krm_0809_12"><a href="#foot_krm_0809_12">12</a></sup> सुत्रायी, <sup id="ref_krm_0809_13"><a href="#foot_krm_0809_13">13</a></sup> त्रायः, <sup id="ref_krm_0809_14"><a href="#foot_krm_0809_14">14</a></sup> <sup id="ref_krm_0809_15"><a href="#foot_krm_0809_15">15</a></sup> पार्ष्णिसंत्रायः, <sup id="ref_krm_0809_16"><a href="#foot_krm_0809_16">16</a></sup> सुत्रामा, <sup id="ref_krm_0809_17"><a href="#foot_krm_0809_17">17</a></sup> त्रापः, तित्रासुः, तात्रः;</li> <li>  त्रातव्यम्, त्रापयितव्यम्, तित्रासितव्यम्, तात्रायितव्यम्;</li> <li>  त्राणीयम्, त्रापणीयम्, तित्रासनीयम्, तात्रायणीयम्;</li> <li>  <sup id="ref_krm_0809_18"><a href="#foot_krm_0809_18">18</a></sup> त्रेयम्, त्राप्यम्, तित्रास्यम्, तात्राय्यम्;</li> <li>  <sup id="ref_krm_0809_19"><a href="#foot_krm_0809_19">19</a></sup> ईषत्त्राणः-दुस्त्राणः-सुत्राणः;</li> <li>  -- -- त्रायमाणः, त्राप्यमाणः, तित्रास्यमानः, तात्रायमाणः;</li> <li>  त्रायः, त्रापः, तित्रासः, तात्रायः;</li> <li>  त्रातुम्, त्रापयितुम्, तित्रासितुम्, तात्रायितुम्;</li> <li>  त्रातिः, <sup id="ref_krm_0809_20"><a href="#foot_krm_0809_20">20</a></sup> सुत्रा, त्रापणा, तित्रासा, तात्राया;</li> <li>  त्राणम्, त्रापणम्, तित्रासनम्, तात्रायणम्;</li> <li>  त्रात्वा, त्रापयित्वा, तित्रासित्वा, तात्रायित्वा;</li> <li>  प्रत्राय, प्रत्राप्य, प्रतित्रास्य, प्रतात्राय्य;</li> <li>  त्रायम् २, त्रात्वा २, त्रापम् २, त्रापयित्वा २, तित्रासम् २, तित्रासित्वा २, तात्रायम् २;</li> <li>  तात्रायित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0809_01"><a href="#ref_krm_0809_01">↑</a> (७९९)</li> <li id="foot_krm_0809_02"><a href="#ref_krm_0809_02">↑</a> (१-भ्वादिः-९६५। सक। अनि। आत्म।)</li> <li id="foot_krm_0809_03"><a href="#ref_krm_0809_03">↑</a> [[१। ‘आदेच उपदेशेऽशिति’ (६-१-४५) इत्यात्वे, ‘आतो युक् चिण्कृतोः’ (७-३-३३) इति युगागमः। एवमात्वं सर्वत्र, युगागमस्तु घञादिषु च इति ज्ञेयम्।]]</li> <li id="foot_krm_0809_04"><a href="#ref_krm_0809_04">↑</a> [[२। आदन्तलक्षणः पुगागमो ण्यन्ते सर्वत्र ज्ञेयः।]]</li> <li id="foot_krm_0809_05"><a href="#ref_krm_0809_05">↑</a> [[३। शानचि, आत्वाभावे, आयादेशे च रूपम्।]]</li> <li id="foot_krm_0809_06"><a href="#ref_krm_0809_06">↑</a> [[[४। ‘भीत्रार्थानां भयहेतुः’ (१-४-२५) इति अपादानसंज्ञा चोरस्य।]]</li> <li id="foot_krm_0809_07"><a href="#ref_krm_0809_07">↑</a> [[५। ‘नुदविदोन्दत्राघ्राह्रीभ्योऽन्यतरस्याम्’ (८-२-५६) इति निष्ठानत्वविकल्पः।]]</li> <li id="foot_krm_0809_08"><a href="#ref_krm_0809_08">↑</a> [[६। ‘क्तिच्क्तौ च संज्ञायाम्’ (३-३-१७४) इति संज्ञायां क्तप्रत्ययः। ‘देवत्रातो गलो ग्राह इतियोगे च सद्विधिः। मिथस्ते न विभाष्यन्ते गवाक्षः संशितव्रतः।।’ (भाष्यम्--७-४-४१) इति व्यवस्थितविभाषाश्रयणाद् अत्र निष्ठानत्वं न। देवत्रात इत्युपलक्षणम्, संज्ञायामन्योपपदेऽपि भवतीति ज्ञापनाय भवत्रात इत्यप्युक्तम्।]]</li> <li id="foot_krm_0809_09"><a href="#ref_krm_0809_09">↑</a> [[७। ‘आतोऽनुपसर्गे कः’ (३-२-३) इति कर्मण्युपपदेऽणपवादः कप्रत्ययः। ‘आतो लोप इटि च’ (६-४-६४) इत्याकारलोपः। एवम्, पार्ष्णित्रम्, तनुत्रम्, आतपत्रम् इत्यादिकमपि बोध्यम्।]]</li> <li id="foot_krm_0809_10"><a href="#ref_krm_0809_10">↑</a> [[८। ‘आतश्चोपसर्गे’ (३-१-१३६) इति कर्तरि कप्रत्ययः।]]</li> <li id="foot_krm_0809_11"><a href="#ref_krm_0809_11">↑</a> [[आ। ‘व्रजति पुरतरुण्यो बद्धचित्राङ्गुलित्रे कथमपि गुरुशोकान्मा रुदन् माङ्गलिक्यः।।’ भ। का। १। २६।]]</li> <li id="foot_krm_0809_12"><a href="#ref_krm_0809_12">↑</a> [[९। ताच्छील्ये णिनिप्रत्ययः। युगागमः।]]</li> <li id="foot_krm_0809_13"><a href="#ref_krm_0809_13">↑</a> [[१०। ‘श्याऽऽद्व्यथ--’ (३-१-१४१) इति कर्तरि णप्रत्यये रूपमेवम्।]]</li> <li id="foot_krm_0809_14"><a href="#ref_krm_0809_14">↑</a> [पृष्ठम्०७०८+ २६]</li> <li id="foot_krm_0809_15"><a href="#ref_krm_0809_15">↑</a> [[१। सोपसर्गे कर्मण्युपपदे तु कप्रत्ययं बाधित्वा औत्सर्गिकः ‘कर्मण्यण्’ (३-२-१) इत्यणेव भवति।]]</li> <li id="foot_krm_0809_16"><a href="#ref_krm_0809_16">↑</a> [[२। ‘आतो मनिन्--’ (३-२-७४) इति मनिन्प्रत्ययः। सुत्रामा = इन्द्रः।]]</li> <li id="foot_krm_0809_17"><a href="#ref_krm_0809_17">↑</a> [[आ। ‘सुत्रामपुत्रारिशिलीमुखानां स्मृत्वा गणस्तत्र वलीमुखानाम्।’ च। रा। ४। ४४।]]</li> <li id="foot_krm_0809_18"><a href="#ref_krm_0809_18">↑</a> [[३। ‘अचो यत्’ (३-१-९७) इति यत्। ‘ईद् यति’ (६-४-६५) इति ईत्वे गुणे च रूपम्।]]</li> <li id="foot_krm_0809_19"><a href="#ref_krm_0809_19">↑</a> [[४। ईषदाद्युपपदेषु खलपवादः ‘आतो युच्’ (३-३-१२८) इति युच्।]]</li> <li id="foot_krm_0809_20"><a href="#ref_krm_0809_20">↑</a> [[५। ‘आतश्चोपसर्गे’ (३-३-१०६) इति स्त्रियां भावादावङ्।]]</li></ul></p>

त्रौकृ
<ul><li><sup id="ref_krm_0810_01"><a href="#foot_krm_0810_01">1</a></sup> {@“त्रौकृ गत्यर्थः”@} <sup id="ref_krm_0810_02"><a href="#foot_krm_0810_02">2</a></sup> भौवादिकढौकतिवत् <sup id="ref_krm_0810_03"><a href="#foot_krm_0810_03">3</a></sup> सर्वाणि रूपाण्यूह्यानि। </li> <li>त्रौकितम् <sup id="ref_krm_0810_04"><a href="#foot_krm_0810_04">4</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0810_01"><a href="#ref_krm_0810_01">↑</a> (८००)</li> <li id="foot_krm_0810_02"><a href="#ref_krm_0810_02">↑</a> (१-भ्वादिः-९९। सक। सेट्। आत्म।)</li> <li id="foot_krm_0810_03"><a href="#ref_krm_0810_03">↑</a> (६५३)</li> <li id="foot_krm_0810_04"><a href="#ref_krm_0810_04">↑</a> [[B। ‘विष्वक्परित्रौकितलोचनैः स्थितं विष्वष्कमाणाम्बुदनादशङ्कया।।’ धा। का। १। १४।]]</li></ul></p>

त्वक्षू
<ul><li><sup id="ref_krm_0811_01"><a href="#foot_krm_0811_01">1</a></sup> {@“त्वक्षू तनूकरणे”@} <sup id="ref_krm_0811_02"><a href="#foot_krm_0811_02">2</a></sup> भौवादिकतक्षतिवत् <sup id="ref_krm_0811_03"><a href="#foot_krm_0811_03">3</a></sup> सर्वाणि रूपाण्यस्योह्यानि। </li> <li><sup id="ref_krm_0811_04"><a href="#foot_krm_0811_04">4</a></sup> त्वष्टा। </li> <li><sup id="ref_krm_0811_05"><a href="#foot_krm_0811_05">5</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0811_01"><a href="#ref_krm_0811_01">↑</a> (८०१)</li> <li id="foot_krm_0811_02"><a href="#ref_krm_0811_02">↑</a> (१-भ्वादिः-६५६। सक। वेट्। पर।)</li> <li id="foot_krm_0811_03"><a href="#ref_krm_0811_03">↑</a> (६९२)</li> <li id="foot_krm_0811_04"><a href="#ref_krm_0811_04">↑</a> [[६। ‘अप्तृन्तृच्स्वसृनप्तृनेष्टृत्वष्टृ--’ (६-४-११) इत्यनेन तृन्नन्तो निपातितः तच्छील- तद्धर्मतत्साधुकारिष्वर्थेषु। सूत्रे निपातादेव तृन्नन्तेऽत्र कदाचित् इड्घटितप्रयोगो न सम्भवति।]]</li> <li id="foot_krm_0811_05"><a href="#ref_krm_0811_05">↑</a> [पृष्ठम्०७०९+ २५]</li></ul></p>

त्वगि
