ासङ्गिक्यः <ul><li id="foot_krm_0208_01"><a href="#ref_krm_0208_01">↑</a> (२०३)</li> <li id="foot_krm_0208_02"><a href="#ref_krm_0208_02">↑</a> (१-भ्वादिः-१९९। सक। सेट्-पर।)</li> <li id="foot_krm_0208_03"><a href="#ref_krm_0208_03">↑</a> [[५। ‘रलो व्युपधात्--’ (१-२-२६) इति सनः कित्त्वविकल्पः। तेन रूपद्वयम्।]]</li> <li id="foot_krm_0208_04"><a href="#ref_krm_0208_04">↑</a> [[६। क्त्वायां विकल्पितेट्कत्वात् ‘यस्य विभाषा’ (७-२-१५) इति निष्ठायामनिद कुत्वम् च।]]</li> <li id="foot_krm_0208_05"><a href="#ref_krm_0208_05">↑</a> [पृष्ठम्०१९८+ २०]</li> <li id="foot_krm_0208_06"><a href="#ref_krm_0208_06">↑</a> [[१। ‘इगुपधज्ञाप्रीकिरः कः’ (३-१-१३५) इति कर्तरि कः।]]</li> <li id="foot_krm_0208_07"><a href="#ref_krm_0208_07">↑</a> [[२। निष्ठायामनिट्त्वात् ‘चजोः कु घिण्ण्यतोः’ (७-३-५२) इति ण्यति घञि च कुत्वम्।]]</li> <li id="foot_krm_0208_08"><a href="#ref_krm_0208_08">↑</a> [[३। ‘रलो व्युपधात्--’ (१-२-२६) इति क्त्वाप्रत्ययस्य कित्त्वविकल्पः। ‘उदितोवा’ (७-२-५६) इति क्त्वायां वा इट्।]]</li></ul></p>

