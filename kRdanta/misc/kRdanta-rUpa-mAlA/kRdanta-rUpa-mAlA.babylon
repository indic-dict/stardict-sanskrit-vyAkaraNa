<ul><li><sup id="ref_krm_0256_01"><a href="#foot_krm_0256_01">1</a></sup> {@“कृप दौर्बल्ये”@} <sup id="ref_krm_0256_02"><a href="#foot_krm_0256_02">2</a></sup> अदन्तः। </li> <li>‘कल्पते शपि सामर्थ्ये, कल्पयत्यवकल्कने। </li> <li>अदन्तस्य कृपेर्णौ तु दौर्बल्ये कृपयेदिति।।’ <sup id="ref_krm_0256_03"><a href="#foot_krm_0256_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_0256_04"><a href="#foot_krm_0256_04">4</a></sup> कृपकः <sup id="ref_krm_0256_05"><a href="#foot_krm_0256_05">5</a></sup> -पिका, <sup id="ref_krm_0256_06"><a href="#foot_krm_0256_06">6</a></sup> चिकृपयिषकः-षिका;</li> <li>  कृपयिता-त्री, चिकृपयिषिता-त्री;</li> <li>  कृपयन्-न्ती, चिकृपयिषन्-न्ती;</li> <li>  कृपयिष्यन्-न्ती-ती, चिकृपयिषिष्यन्-न्ती-ती;</li> <li>  कृपयमाणः, चिकृपयिषमाणः;</li> <li>  कृपयिष्यमाणः, चिकृपयिषिष्यमाणः;</li> <li>  कृप्-कृपौ-कृपः;</li> <li>  -- कृपितम्-तः, चिकृपयिषितः-तवान्;</li> <li>  कृपः, चिकृपयिषुः;</li> <li>  कृपयितव्यम्, चिकृपयिषितव्यम्;</li> <li>  कृपणीयम्, चिकृपयिषणीयम्;</li> <li>  कृप्यम्, चिकृपयिष्यम्;</li> <li>  ईषत्कृपः-दुष्कृपः-सुकृपः;</li> <li>  -- कृष्यमाणः, चिकृपयिष्यमाणः;</li> <li>  कृपः, चिकृपयिषः;</li> <li>  कृपयितुम्, चिकृपयिषितुम्;</li> <li>  कृपणा, चिकृपयिषा;</li> <li>  कृपणम्, चिकृपयिषणम्;</li> <li>  कृपयित्वा, चिकृपयिषित्वा;</li> <li>  <sup id="ref_krm_0256_07"><a href="#foot_krm_0256_07">7</a></sup> प्रकृपय्य, प्रचिकृपयिष्य;</li> <li>  <sup id="ref_krm_0256_08"><a href="#foot_krm_0256_08">8</a></sup> कृपम् २, कृपयित्वा २, चिकृपयिषम् २;</li> <li>  चिकृपयिषित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0256_01"><a href="#ref_krm_0256_01">↑</a> (२५१)</li> <li id="foot_krm_0256_02"><a href="#ref_krm_0256_02">↑</a> (१०-चुरादिः-१८७०। अक। सेट्। उभ।)</li> <li id="foot_krm_0256_03"><a href="#ref_krm_0256_03">↑</a> (श्लो। १३५)</li> <li id="foot_krm_0256_04"><a href="#ref_krm_0256_04">↑</a> [[१। अदन्तत्वेनातो लोपस्य स्थानिवद्भावात् लघूपधगुणो न।]]</li> <li id="foot_krm_0256_05"><a href="#ref_krm_0256_05">↑</a> [[आ। ‘चहकमहितं नन्दं बद्ध्वाऽस्य सारयतो धनं हरत कृपकस्यारेस्तातं हत श्रथयत्तमम्।।’ धा। का। ३-५४।]]</li> <li id="foot_krm_0256_06"><a href="#ref_krm_0256_06">↑</a> [[२। ण्यन्तात् सनि णेरयादेशः। अनेकाच्त्वात् यङ् न।]]</li> <li id="foot_krm_0256_07"><a href="#ref_krm_0256_07">↑</a> [[३। ‘ल्यपि लघुपूर्वात्’ (६-४-५६) इति णेरयादेशः।]]</li> <li id="foot_krm_0256_08"><a href="#ref_krm_0256_08">↑</a> [पृष्ठम्०२५०+ २६]</li></ul></p>

