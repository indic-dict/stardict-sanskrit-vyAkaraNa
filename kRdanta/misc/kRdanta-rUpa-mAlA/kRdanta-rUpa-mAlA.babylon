<ul><li><sup id="ref_krm_0524_01"><a href="#foot_krm_0524_01">1</a></sup> {@“चह परिकल्कने”@} <sup id="ref_krm_0524_02"><a href="#foot_krm_0524_02">2</a></sup> परिकल्कनम् = शाठ्यम्, दम्भो वा। </li> <li>‘चहयेच्चहतीत्येते चहेः स्तां परिकल्कने।।’ <sup id="ref_krm_0524_03"><a href="#foot_krm_0524_03">3</a></sup> इति देवः। </li> <li>चाहकः-हिका, <sup id="ref_krm_0524_04"><a href="#foot_krm_0524_04">4</a></sup> चाहकः-हिका, चिचहिषकः-षिका चाचहकः-हिका;</li> <li>  चहिता-त्री, चाहयिता-त्री, चिचहिषिता-त्री, चाचहिता-त्री;</li> <li>  चहन्-न्ती, चाहयन्-न्ती, चिचहिषन्-न्ती;</li> <li>  -- चहिष्यन्-न्ती-ती, चाहयिष्यन्-न्ती-ती, चिचहिषिष्यन्-न्ती-ती;</li> <li>  -- चाहयमानः, चाहयिष्यमाणः, चाचह्यमानः, चाचहिष्यमाणः;</li> <li>  <sup id="ref_krm_0524_05"><a href="#foot_krm_0524_05">5</a></sup> प्रचट्-प्रचड्-प्रचहौ-प्रचहः;</li> <li>  -- -- -- चहितम्-तः, चाहितः, चिचहिषितः, चाचहितः-तवान्;</li> <li>  चहः, चाहः, चिचहिषुः, चाचहः;</li> <li>  चहितव्यम्, चाहयितव्यम्, चिचहिषितव्यम्, चाचहितव्यम्;</li> <li>  चहनीयम्, चाहनीयम्, चिचहिषणीयम्, चाचहनीयम्;</li> <li>  चाह्यम्, चाह्यम्, चिचहिष्यम्, चाचह्यम्;</li> <li>  ईषच्चहः-दुश्चहः-सुचहः;</li> <li>  -- -- चह्यमानः;</li> <li>  चाह्यमानः, चिचहिष्यमाणः, चाचह्यमानः;</li> <li>  <sup id="ref_krm_0524_06"><a href="#foot_krm_0524_06">6</a></sup> चाहः, चाहः, चिचहिषः, चाचहः;</li> <li>  चहितुम्, चाहयितुम्, चिचहिषितुम्;</li> <li>  चाचहितुम्;</li> <li>  <sup id="ref_krm_0524_07"><a href="#foot_krm_0524_07">7</a></sup> <sup id="ref_krm_0524_08"><a href="#foot_krm_0524_08">8</a></sup> चाढिः, चाहना, चिचहिषा, चाचहा;</li> <li>  चहनम्, चाहनम्, चिचहिषणम्, चाचहनम्;</li> <li>  चहित्वा, चाहयित्वा, चिचहिषित्वा, चाचहित्वा;</li> <li>  प्रचह्य, प्रचाह्य, प्रचिचहिष्य, प्रचाचह्य;</li> <li>  चाहम् २, चहित्वा २, चाहम् २, चाहयित्वा २, चिचहिषम् २, चिचहिषित्वा २, चाचहम् २;</li> <li>  चाचहित्वा।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0524_01"><a href="#ref_krm_0524_01">↑</a> (५१४)</li> <li id="foot_krm_0524_02"><a href="#ref_krm_0524_02">↑</a> (१-भ्वादिः-७२९। सक। सेट्। पर।)</li> <li id="foot_krm_0524_03"><a href="#ref_krm_0524_03">↑</a> (श्लो। १९६)</li> <li id="foot_krm_0524_04"><a href="#ref_krm_0524_04">↑</a> [[३। धातुपाठेऽर्थनिर्देशस्योपलक्षणतया, परिकल्कनभिन्नेऽर्थे ण्यन्तात् इमानि रूपाणि लिखितानि। परिकल्कनेऽर्थे चुरादिपठितस्य घटादिषु पाठात्, मित्त्वप्रयुक्तानि कार्याणि उत्तरत्र (५१६ धातौ) प्रदर्श्यन्ते।]]</li> <li id="foot_krm_0524_05"><a href="#ref_krm_0524_05">↑</a> [[४। ‘हो ढः’ (८-२-३१) इति ढत्वे, अवसाने चर्त्वविकल्पः।]]</li> <li id="foot_krm_0524_06"><a href="#ref_krm_0524_06">↑</a> [[आ। ‘चाहेनामहितस्य चास्य निघनोद्योगं रहस्यूचिवान् गन्तव्यं खलु रंहसेति च दृढामाज्ञां प्रभोरभ्यधात्।।’ धा। का। १-९१।]]</li> <li id="foot_krm_0524_07"><a href="#ref_krm_0524_07">↑</a> [पृष्ठम्०४९६+ २४]</li> <li id="foot_krm_0524_08"><a href="#ref_krm_0524_08">↑</a> [[१। ‘तितुत्र--’ (७-२-९) इतीण्णिषेधः। अनन्तरम्, ढत्वधत्वष्टुत्वढलोपदीर्घेषु रूपमेवं भवति।]]</li></ul></p>

चह|चहकःहिका|चिचहयिषकः-षिका|चहयिता-त्री|चिचहयिषिता-त्री|चहयन्-न्ती|चिचहयिषन्-न्ती|चहयिष्यन्|न्ती-ती|चिचहयिषिष्यन्-न्ती-ती|चहयमानः|चिचहयिषमाणः|चहयिष्यमाणः|चिचहयिषिष्यमाणः|प्रचट्-प्रचड्-प्रचहौ-प्रचहः|-|चहितम्-तः|चिचहयिषितः-तवान्|चहः|चिचहयिषुः|चहयितव्यम्|चिचहयिषितव्यम्|चहनीयम्|चिचहयिषणीयम्|चह्यम्|चिचहयिष्यम्|ईषच्चहः-दुश्चहः-सुचहः|चह्यमानः|चिचहयिष्यमाणः|चिचहयिषः|चहयितुम्|चिचहयिषितुम्|चहना|चिचहयिषा|चहनम्|चिचहयिषणम्|चहयित्वा|चिचहयिषित्वा|प्रचहय्य|प्रचिचहयिष्य
<ul><li><sup id="ref_krm_0525_01"><a href="#foot_krm_0525_01">1</a></sup> {@“चह परिकल्कने”@} <sup id="ref_krm_0525_02"><a href="#foot_krm_0525_02">2</a></sup> ज्ञपादिः। </li> <li>‘चप--’ इति दुर्गसम्मतः पाठः। </li> <li>‘चहयेच्चहतीत्येते चहेः स्तां परिकल्कने।।’ <sup id="ref_krm_0525_03"><a href="#foot_krm_0525_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_0525_04"><a href="#foot_krm_0525_04">4</a></sup> चहकः <sup id="ref_krm_0525_05"><a href="#foot_krm_0525_05">5</a></sup> हिका, चिचहयिषकः-षिका;</li> <li>  चहयिता-त्री, चिचहयिषिता-त्री;</li> <li>  चहयन्-न्ती, चिचहयिषन्-न्ती;</li> <li>  चहयिष्यन् न्ती-ती, चिचहयिषिष्यन्-न्ती-ती;</li> <li>  चहयमानः, चिचहयिषमाणः;</li> <li>  चहयिष्यमाणः, चिचहयिषिष्यमाणः;</li> <li>  <sup id="ref_krm_0525_06"><a href="#foot_krm_0525_06">6</a></sup> प्रचट्-प्रचड्-प्रचहौ-प्रचहः;</li> <li>  -- -- चहितम्-तः, चिचहयिषितः-तवान्;</li> <li>  चहः, चिचहयिषुः;</li> <li>  चहयितव्यम्, चिचहयिषितव्यम्;</li> <li>  चहनीयम्, चिचहयिषणीयम्;</li> <li>  चह्यम्, चिचहयिष्यम्;</li> <li>  ईषच्चहः-दुश्चहः-सुचहः;</li> <li>  -- चह्यमानः, चिचहयिष्यमाणः;</li> <li>  चहः, चिचहयिषः;</li> <li>  चहयितुम्, चिचहयिषितुम्;</li> <li>  <sup id="ref_krm_0525_07"><a href="#foot_krm_0525_07">7</a></sup> चहना, चिचहयिषा;</li> <li>  चहनम्, चिचहयिषणम्;</li> <li>  चहयित्वा, चिचहयिषित्वा;</li> <li>  <sup id="ref_krm_0525_08"><a href="#foot_krm_0525_08">8</a></sup> प्रचहय्य, प्रचिचहयिष्य;</li> <li>  -- -- <sup id="ref_krm_0525_09"><a href="#foot_krm_0525_09">9</a></sup> चहम् २, चाहम् २, चहयित्वा २, चिचहयिषम् २, चिचहयिषित्वा २। <sup id="ref_krm_0525_10"><a href="#foot_krm_0525_10">10</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0525_01"><a href="#ref_krm_0525_01">↑</a> (५१५)</li> <li id="foot_krm_0525_02"><a href="#ref_krm_0525_02">↑</a> (१०-चुरादिः-१६२७। सक। सेट्। उभ।)</li> <li id="foot_krm_0525_03"><a href="#ref_krm_0525_03">↑</a> (श्लो। १९६)</li> <li id="foot_krm_0525_04"><a href="#ref_krm_0525_04">↑</a> [[आ। ‘चाणूर एनमथ विज्ञपयन् नृपाज्ञां चण्डातकं सुयमयंश्चहको बभाषे।’ धा। का। ३-२५।]]</li> <li id="foot_krm_0525_05"><a href="#ref_krm_0525_05">↑</a> [[२। ज्ञपादिषु अस्य पाठात् मित्त्वेन, ‘मितां ह्रस्वः’ (६-४-९२) इति णौ उपधाया ह्रस्वः। एवमेव ण्यन्तात् सन्यपि उपधाह्रस्वो बोध्यः।]]</li> <li id="foot_krm_0525_06"><a href="#ref_krm_0525_06">↑</a> [[३। ‘हो ढः’ (८-२-३१) इति ढत्वे, अवसाने चर्त्वविकल्पः।]]</li> <li id="foot_krm_0525_07"><a href="#ref_krm_0525_07">↑</a> [[४। ‘ण्यासश्रन्थो युच्’ (३-३-१०७) इति युच्।]]</li> <li id="foot_krm_0525_08"><a href="#ref_krm_0525_08">↑</a> [[५। ‘ल्यपि लघुपूर्वात्’ (६-४-५६) इति णेरयादेशः।]]</li> <li id="foot_krm_0525_09"><a href="#ref_krm_0525_09">↑</a> [[६। ‘चिण्णमुलोदीर्घोऽन्यतरस्याम्’ (६-४-९३) इति णमुल्परे णौ दीर्घविकल्पः।]]</li> <li id="foot_krm_0525_10"><a href="#ref_krm_0525_10">↑</a> [पृष्ठम्०४९७+ २१]</li></ul></p>

चह
<ul><li><sup id="ref_krm_0526_01"><a href="#foot_krm_0526_01">1</a></sup> {@“चह परिकल्कने”@} <sup id="ref_krm_0526_02"><a href="#foot_krm_0526_02">2</a></sup> कथादिरदन्तश्च। </li> <li>‘चहयेच्चहतीत्येते चहेः स्तां परिकल्कने।।’ <sup id="ref_krm_0526_03"><a href="#foot_krm_0526_03">3</a></sup> इति देवः। </li> <li>चहकः-हिका, चिचहयिषकः-षिका, इत्यादीनि सर्वाण्यपि रूपाणि पूर्वलिखितचौरादिकचहयतिवत् <sup id="ref_krm_0526_04"><a href="#foot_krm_0526_04">4</a></sup> ज्ञेयानि। </li> <li>चहम् २, चहयित्वा २, इति णमुलि एकमेव रूपम्। </li> <li>‘चिण्णमुलोः--’ <sup id="ref_krm_0526_05"><a href="#foot_krm_0526_05">5</a></sup> इति नात्र प्रवर्तते। </li> <li>अस्यादन्तेषु पाठादल्लोपस्य स्थानिवद्भावेन व्यवधानात्, णित्परत्वा- भावात्, ‘अत उपधायाः’ <sup id="ref_krm_0526_06"><a href="#foot_krm_0526_06">6</a></sup> इति वृद्धिर्न भवति। </li> <li>अतः रूपेषु न विशेषः। </li> <li>चुरादावेव पुनः पाठस्य फलं तु--अस्य धातोः चङि अचचहत्-- इति, पूर्वपठितस्य <sup id="ref_krm_0526_07"><a href="#foot_krm_0526_07">7</a></sup> धातोः अचीचहत् इति च रूपभेद इति ज्ञेयम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0526_01"><a href="#ref_krm_0526_01">↑</a> (५१६)</li> <li id="foot_krm_0526_02"><a href="#ref_krm_0526_02">↑</a> (१०-चुरादिः-१८६७। सक। सेट्। उभ।)</li> <li id="foot_krm_0526_03"><a href="#ref_krm_0526_03">↑</a> (श्लो। १९६)</li> <li id="foot_krm_0526_04"><a href="#ref_krm_0526_04">↑</a> (५१६)</li> <li id="foot_krm_0526_05"><a href="#ref_krm_0526_05">↑</a> (६-४-९३)</li> <li id="foot_krm_0526_06"><a href="#ref_krm_0526_06">↑</a> (७-२-११६)</li> <li id="foot_krm_0526_07"><a href="#ref_krm_0526_07">↑</a> (५१६)</li></ul></p>

