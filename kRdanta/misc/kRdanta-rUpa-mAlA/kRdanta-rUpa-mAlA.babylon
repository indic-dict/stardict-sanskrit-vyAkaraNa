li id="foot_krm_0011_03"><a href="#ref_krm_0011_03">↑</a> (१-भ्वादिः-२५४। सक-सेट्। आ।)</li> <li id="foot_krm_0011_04"><a href="#ref_krm_0011_04">↑</a> [[१ धातुरयं तोपधः दोपध इति मतद्वयम्। तोपधत्वे-अटिट्टिषकः इत्यादि, दोपधत्वे अट्टिटिषक इत्यादि च रूपाणीति ज्ञेयम्। टोपधोऽपि कल्पद्रुमे--तत्पक्षे क्विपि अट् इति।]]</li> <li id="foot_krm_0011_05"><a href="#ref_krm_0011_05">↑</a> [[B। ‘मार्गात् स दृष्ट्वा हरिपादलाञ्छनं व्यवेष्टतोर्व्यां महनीयचेष्टितः। तत्केलिसंघोष्टि- तलोष्टमानमद्वने मरुद्घट्टितपोस्फुटद्रुमे।।’ धा। का १-३४। तोपधे दोपधे वा क्विपि रूपम्।]]</li> <li id="foot_krm_0011_06"><a href="#ref_krm_0011_06">↑</a> [[२। ‘गुरोश्च हलः’ (३-३-१०३) इत्यः प्रत्ययः।]]</li> <li id="foot_krm_0011_07"><a href="#ref_krm_0011_07">↑</a> [पृष्ठम्००१३+ २८]</li></ul></p>

