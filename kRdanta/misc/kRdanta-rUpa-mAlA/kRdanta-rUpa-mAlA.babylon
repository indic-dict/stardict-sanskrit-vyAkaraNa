<ul><li><sup id="ref_krm_0036_01"><a href="#foot_krm_0036_01">1</a></sup> {@‘अर्च पूजायाम्’@} <sup id="ref_krm_0036_02"><a href="#foot_krm_0036_02">2</a></sup> ‘पूजायां णौ विभाषाऽर्चेरर्चयत्यर्चतेऽर्चति। </li> <li>भूवादौ पाठसामर्थ्यात् कर्तृगामिफलेऽर्चति।।’ <sup id="ref_krm_0036_03"><a href="#foot_krm_0036_03">3</a></sup> इति देवः। </li> <li>अर्चकः-र्चिका इत्यादिकानां ण्यन्ताण्यन्तसाधारण्येन लिखितत्वात् पूर्वोक्त <sup id="ref_krm_0036_04"><a href="#foot_krm_0036_04">4</a></sup> पूजार्थकार्चतिवद्रूपाणि ज्ञेयानि। </li> <li>ण्यन्तात् सनि तु अर्चिचयिषकः-षिका, अर्चिचयिष्यम्;</li> <li>  अर्चिचयिषिता-त्री, अर्चिचयिष्यमाणः;</li> <li>  अर्चिचयिषन्-न्ती, अर्चिचयिषः;</li> <li>  अर्चिचयिषिष्यन्-न्ती-ती, अर्चिचयिषितुम्;</li> <li>  अर्चिचयिषमाणः, अर्चिचयिषा;</li> <li>  अर्चिचयिषिष्यमाणः, अर्चिचयिषणम्;</li> <li>  अर्चिचयिषितम्-तः-तवान्, अर्चिचयिषित्वा, समर्चिचयिष्य;</li> <li>  अर्चिचयिषुः, अर्चिचयिषम् २, अर्चिचयिषितव्यम्;</li> <li>  अर्चिचयिषित्वा २, अर्चिचयिषणीयम्;</li> <li>  इमानि रूपाणि--इति विशेषः। </li> <li>^आ। </li> <li>‘आधृषाद्वा’ <sup id="ref_krm_0036_05"><a href="#foot_krm_0036_05">5</a></sup> इति णिचो वैकल्पिकत्वम्। </li> <li>‘शेषात् कर्तरि परस्मैपदम्’ <sup id="ref_krm_0036_06"><a href="#foot_krm_0036_06">6</a></sup> इति णिजभावपक्षे परस्मैपदी। </li> <li>शाकटायनस्तु अनुदात्तेत्त्वमस्य धातोरङ्गीकृत्यात्मनेपदित्वं ब्रूते। </li> <li>तत्पक्षे शानचि ‘अर्चमानः’ इति रूपम्। </li> <li><sup id="ref_krm_0036_07"><a href="#foot_krm_0036_07">7</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0036_01"><a href="#ref_krm_0036_01">↑</a> (३७)</li> <li id="foot_krm_0036_02"><a href="#ref_krm_0036_02">↑</a> (१०-चुरादिः-१८०९। से। उ। ^आ आधृषीयः।)</li> <li id="foot_krm_0036_03"><a href="#ref_krm_0036_03">↑</a> (श्लो। ४९।)</li> <li id="foot_krm_0036_04"><a href="#ref_krm_0036_04">↑</a> (३६)</li> <li id="foot_krm_0036_05"><a href="#ref_krm_0036_05">↑</a> (ग। सू।)</li> <li id="foot_krm_0036_06"><a href="#ref_krm_0036_06">↑</a> (१-३-७८)</li> <li id="foot_krm_0036_07"><a href="#ref_krm_0036_07">↑</a> [पृष्ठम्००३६+ २६]</li></ul></p>

