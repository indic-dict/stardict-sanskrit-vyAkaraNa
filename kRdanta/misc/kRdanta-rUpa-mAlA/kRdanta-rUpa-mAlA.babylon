<ul><li><sup id="ref_krm_0244_01"><a href="#foot_krm_0244_01">1</a></sup> {@“कूज अव्यक्ते शब्दे”@} <sup id="ref_krm_0244_02"><a href="#foot_krm_0244_02">2</a></sup> कूजकः-जिका, कूजकः-जिका, चुकूजिषकः-षिका, चोकूजकः-जिका;</li> <li>  कूजिता-त्री, कूजयिता-त्री, चुकूजिषिता-त्री, चोकूजिता-त्री;</li> <li>  <sup id="ref_krm_0244_03"><a href="#foot_krm_0244_03">3</a></sup> कूजन्-न्ती, कूजयन्-न्ती, चुकूजिषन्-न्ती;</li> <li>  -- कूजिष्यन्-न्ती-ती, कूजयिष्यन्-न्ती-ती, चुकूजिषिष्यन्-न्ती-ती;</li> <li>  -- <sup id="ref_krm_0244_04"><a href="#foot_krm_0244_04">4</a></sup> व्यतिकूजमानः, कूजयमानः, -- चोकूज्यमानः;</li> <li>  व्यतिकूजिष्यमाणः, कूजयिष्यमाणः, -- चोकूजिष्यमाणः;</li> <li>  <sup id="ref_krm_0244_05"><a href="#foot_krm_0244_05">5</a></sup> कूक्-कूग् कूजौ-कूजः;</li> <li>  -- -- कूजितम्-तः, कूजितः, चुकूजिषितः, चोकूजितः-तवान्;</li> <li>  कूजः, <sup id="ref_krm_0244_06"><a href="#foot_krm_0244_06">6</a></sup> कूजनः, कूजः, चुकूजिषुः, चोकूजः;</li> <li>  कूजितव्यम्, कूजयितव्यम्, चुकूजिषितव्यम्, चोकूजितव्यम्;</li> <li>  कूजनीयम्, कूजनीयम्, चुकूजिषणीयम्, चोकूजनीयम्;</li> <li>  <sup id="ref_krm_0244_07"><a href="#foot_krm_0244_07">7</a></sup> कूज्यम्, कूज्यम्, चुकूजिष्यम्, चोकूज्यम्;</li> <li>  ईषत्कूजः-दुष्कूजः-सुकूजः;</li> <li>  -- -- <sup id="ref_krm_0244_08"><a href="#foot_krm_0244_08">8</a></sup> कूज्यमानः, कूज्यमानः, चुकूजिष्यमाणः, चोकूज्यमानः;</li> <li>  कूजः, कूजः, चुकूजिषः, चोकूजः;</li> <li>  कूजितुम्, कूजयितुम्, चुकूजिषितुम्, चोकूजितुम्;</li> <li>  कूजा, कूजना, चुकूजिषा, चुकूजयिषा, चोकूजा;</li> <li>  कूजनम्, कूजनम्, चुकूजिषणम्, चोकूजनम्;</li> <li>  कूजित्वा, कूजयित्वा, चुकूजिषित्वा, चोकूजित्बा;</li> <li>  सङ्कूज्य, प्रकूज्य, प्रचुकूजिष्य, प्रचोकूज्य;</li> <li>  कूजम् २, कूजित्वा २, कूजम् २, कूजयित्वा २, चुकूजिषम् २, चुकूजिषित्वा २, चोकूजम् २;</li> <li>  चोकूजित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0244_01"><a href="#ref_krm_0244_01">↑</a> (२३९)</li> <li id="foot_krm_0244_02"><a href="#ref_krm_0244_02">↑</a> (१-भ्वादिः-२२३। अक। सेट्। पर।)</li> <li id="foot_krm_0244_03"><a href="#ref_krm_0244_03">↑</a> [[आ। ‘प्रध्नज्य मोदं स दधृञ्ज तद्वनं ध्वजोद्रतिध्वञ्जितकूजदण्डजम्।’ धा। का। १-३०।]]</li> <li id="foot_krm_0244_04"><a href="#ref_krm_0244_04">↑</a> [[२। ‘कर्तरि कर्मव्यतीहारे’ (१-३-१४) इति आत्मनेपदम्। तेन शानच्।]]</li> <li id="foot_krm_0244_05"><a href="#ref_krm_0244_05">↑</a> [[३। ‘चोः कुः’ (८-२-३०) इति पदान्ते कुत्वम्।]]</li> <li id="foot_krm_0244_06"><a href="#ref_krm_0244_06">↑</a> [[४। ‘चलनशब्दार्थादकर्मकाद्युच्’ (३-२-१४८) इति ताच्छीलिको युच्।]]</li> <li id="foot_krm_0244_07"><a href="#ref_krm_0244_07">↑</a> [[५। निष्ठायां सेट्त्वात् कुत्वं न।]]</li> <li id="foot_krm_0244_08"><a href="#ref_krm_0244_08">↑</a> [पृष्ठम्०२३०+ २७]</li></ul></p>

कूट|कूटकः-टिका|चुकूटयिषकःषिका|कूटयिता-त्री|चुकूटयिषिता-त्री|कूटयमानः|चुकूटयिषमाणः|कूटयिष्यमाणः|चुकूटयिषिष्यमाणः|कूट्-कूटौ-कूटः|-|कूटितम्-तः|चुकूटयिषितः-तवान्|कूटः|चुकूटयिषुः|कूटयितव्यम्|चुकूटयिषितव्यम्|कूटनीयम्|चुकूटयिषणीयम्|कूट्यम्|चुकूटयिष्यम्|ईषत्कूटः-दुष्कूटः-सुकूटः|कूट्यमानः|चुकूटयिष्यमाणः|साङ्कूटिनम्|चुकूटयिषः|कूटयितुम्|चुकूटयिषितुम्|कूटना|चुकूटयिषा|कूटनम्|चुकूटयिषणम्|कूटयित्वा|चुकूटयिषित्वा|सङ्कूट्य|सञ्चुकूटयिष्य|कूटम्|चुकूटयिषम्
<ul><li><sup id="ref_krm_0245_01"><a href="#foot_krm_0245_01">1</a></sup> {@“कूट आप्रदाने”@} <sup id="ref_krm_0245_02"><a href="#foot_krm_0245_02">2</a></sup> आकुस्मीयः। </li> <li>‘अवसादने’--इत्येके। </li> <li>‘कूटयेताप्रसादे णौ कूटेः, दाहे तु कूटयेत्।’ <sup id="ref_krm_0245_03"><a href="#foot_krm_0245_03">3</a></sup> इति देवः। </li> <li>कूटकः-टिका, चुकूटयिषकःषिका;</li> <li>  कूटयिता-त्री, चुकूटयिषिता-त्री;</li> <li>  <sup id="ref_krm_0245_04"><a href="#foot_krm_0245_04">4</a></sup> कूटयमानः, <sup id="ref_krm_0245_05"><a href="#foot_krm_0245_05">5</a></sup> चुकूटयिषमाणः;</li> <li>  कूटयिष्यमाणः, चुकूटयिषिष्यमाणः;</li> <li>  कूट्-कूटौ-कूटः;</li> <li>  -- कूटितम्-तः, चुकूटयिषितः-तवान्;</li> <li>  कूटः, चुकूटयिषुः;</li> <li>  कूटयितव्यम्, चुकूटयिषितव्यम्;</li> <li>  कूटनीयम्, चुकूटयिषणीयम्;</li> <li>  कूट्यम्, चुकूटयिष्यम्;</li> <li>  ईषत्कूटः-दुष्कूटः-सुकूटः;</li> <li>  -- कूट्यमानः, चुकूटयिष्यमाणः;</li> <li>  <sup id="ref_krm_0245_06"><a href="#foot_krm_0245_06">6</a></sup> कूटः, <sup id="ref_krm_0245_07"><a href="#foot_krm_0245_07">7</a></sup> साङ्कूटिनम्, चुकूटयिषः;</li> <li>  <sup id="ref_krm_0245_08"><a href="#foot_krm_0245_08">8</a></sup> कूटयितुम्, चुकूटयिषितुम्;</li> <li>  कूटना, चुकूटयिषा;</li> <li>  कूटनम्, चुकूटयिषणम्;</li> <li>  कूटयित्वा, चुकूटयिषित्वा;</li> <li>  सङ्कूट्य, सञ्चुकूटयिष्य;</li> <li>  कूटम् २, कूटयित्वा २, चुकूटयिषम् २;</li> <li>  चुकूटयिषित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0245_01"><a href="#ref_krm_0245_01">↑</a> (२४०)</li> <li id="foot_krm_0245_02"><a href="#ref_krm_0245_02">↑</a> (१०-चुरादिः-१७०२। अक। सेट्। आत्म।)</li> <li id="foot_krm_0245_03"><a href="#ref_krm_0245_03">↑</a> (श्लो-७५)</li> <li id="foot_krm_0245_04"><a href="#ref_krm_0245_04">↑</a> [[१। ‘आ कुस्मादात्मनेपदिनः’ इति गणसूत्रं चुरादौ। तेन शानजेव।]]</li> <li id="foot_krm_0245_05"><a href="#ref_krm_0245_05">↑</a> [[२। ‘पूर्ववत् सनः’ (१-३-६२) इत्यात्मनेपदम्।]]</li> <li id="foot_krm_0245_06"><a href="#ref_krm_0245_06">↑</a> [[आ। ‘कुत्स्या हि गालनपटा इव कष्टमेते दुष्कीर्तिभालनपराः खलु कूटवृत्त्या।’ धा। का। ३-३६।]]</li> <li id="foot_krm_0245_07"><a href="#ref_krm_0245_07">↑</a> [[३। ‘अभिविधौ भाव इनुण्’ (३-३-४४) इतीनुण्। ‘अण् इनुणः’ (५-४-१५) इति नित्यमण् तद्धितः। ‘इनण्णनपत्ये’ (६-४-१६४) इत्यनेन प्रकृतिभावः।]]</li> <li id="foot_krm_0245_08"><a href="#ref_krm_0245_08">↑</a> [पृष्ठम्०२३१+ २६]</li></ul></p>

कूट
<ul><li><sup id="ref_krm_0246_01"><a href="#foot_krm_0246_01">1</a></sup> {@“कूट परितापे”@} <sup id="ref_krm_0246_02"><a href="#foot_krm_0246_02">2</a></sup> ‘कूड’ इति हरदत्तः। </li> <li>‘परिदाहे--’ इत्यन्ये। </li> <li>अदन्तः कथादिः। </li> <li>‘कूटयेताप्रसादे णौ, कूटेर्दाहे तु कूटयेत्।’ <sup id="ref_krm_0246_03"><a href="#foot_krm_0246_03">3</a></sup> इति देवः। </li> <li>कूटयन्-न्ती, चुकूटयिषन्-न्ती, कूटयिष्यन्-न्ती-ती, चुकूटयिषिष्यन्-न्ती-ती, इति शतृप्रत्ययोऽधिकोऽत्रेति विशेषः। </li> <li>अन्यानि सर्वाण्यपि रूपाणि पूर्वलिखित <sup id="ref_krm_0246_04"><a href="#foot_krm_0246_04">4</a></sup> चौरादिककूटयतिवज्ज्ञेयानि। </li> <li>संकूटिनं वर्तते। </li> <li>समनताद् दाह इत्यर्थः। </li> <li>‘अभिविधौ भाव इनुण्’ <sup id="ref_krm_0246_05"><a href="#foot_krm_0246_05">5</a></sup> इति इनुणि, इनुणन्तात् ‘अण् इनुणः’ <sup id="ref_krm_0246_06"><a href="#foot_krm_0246_06">6</a></sup> इति अण् तद्धितप्रत्ययः। </li> <li>आदिवृद्धिः। </li> <li>‘सङ्कूटनम् इत्यपि ल्युटा समावेश इष्यते, ‘भावे’ इति वर्तमाने पुनर्भावग्रहणात्।’ इति भाष्यम्। </li> <li>इनुणन्तः स्वभावात् नपुंसके वर्तते इति काशिका।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0246_01"><a href="#ref_krm_0246_01">↑</a> (२४१)</li> <li id="foot_krm_0246_02"><a href="#ref_krm_0246_02">↑</a> (१०-चुरादिः-१८९१। अक। सेट्-अभ।)</li> <li id="foot_krm_0246_03"><a href="#ref_krm_0246_03">↑</a> (श्लो-७५)</li> <li id="foot_krm_0246_04"><a href="#ref_krm_0246_04">↑</a> (२४०)</li> <li id="foot_krm_0246_05"><a href="#ref_krm_0246_05">↑</a> (३-३-४४)</li> <li id="foot_krm_0246_06"><a href="#ref_krm_0246_06">↑</a> (५-४-१५)</li></ul></p>

कूण
<ul><li><sup id="ref_krm_0247_01"><a href="#foot_krm_0247_01">1</a></sup> {@“कूण सङ्कोचे”@} <sup id="ref_krm_0247_02"><a href="#foot_krm_0247_02">2</a></sup> आकुस्मीयः। </li> <li>कूणकः-णिका, चुकूणयिषकः-षिका, इत्यादीनि सर्वाण्यपि रूपाणि ‘कूट आप्रदाने’ <sup id="ref_krm_0247_03"><a href="#foot_krm_0247_03">3</a></sup> इति धातुवत् ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0247_01"><a href="#ref_krm_0247_01">↑</a> (२४२)</li> <li id="foot_krm_0247_02"><a href="#ref_krm_0247_02">↑</a> (१०-चुरादिः-१६८९। सक। सेट्। आत्म।)</li> <li id="foot_krm_0247_03"><a href="#ref_krm_0247_03">↑</a> (२४०)</li></ul></p>

कूण
<ul><li><sup id="ref_krm_0248_01"><a href="#foot_krm_0248_01">1</a></sup> {@“कूण सङ्कोचने”@} <sup id="ref_krm_0248_02"><a href="#foot_krm_0248_02">2</a></sup> कूणयन्-न्ती, कूणयिष्यन्-न्ती-ती, चुकूणयिषन्-न्ती-ती, चुकूणयिषिष्यन्- न्ती-ती, इति शतृप्रत्ययोऽधिकोऽत्रेति विशेषः। </li> <li>अन्यानि सर्वाण्यपि रूपाणि ‘कूट आप्रदाने’ <sup id="ref_krm_0248_03"><a href="#foot_krm_0248_03">3</a></sup> इति चौरादिकधातुवज्ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0248_01"><a href="#ref_krm_0248_01">↑</a> (२४३)</li> <li id="foot_krm_0248_02"><a href="#ref_krm_0248_02">↑</a> (१०-चुरादिः-१८९६-अक, सेट्। उभ।)</li> <li id="foot_krm_0248_03"><a href="#ref_krm_0248_03">↑</a> (२४०)</li></ul></p>

