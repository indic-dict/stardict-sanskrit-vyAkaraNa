<ul><li><sup id="ref_krm_1382_01"><a href="#foot_krm_1382_01">1</a></sup> {@“रन्ज रागे”@} <sup id="ref_krm_1382_02"><a href="#foot_krm_1382_02">2</a></sup> ‘रजते रजतीत्येव रज्यते रज्यतीत्यपि।। </li> <li>रागार्थे शप्श्यनोर्द्वे द्वे--’ <sup id="ref_krm_1382_03"><a href="#foot_krm_1382_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_1382_04"><a href="#foot_krm_1382_04">4</a></sup> रञ्जकः-ञ्जिका, <sup id="ref_krm_1382_05"><a href="#foot_krm_1382_05">5</a></sup> रञ्जकः-ञ्जिका, रजकः-जिका, <sup id="ref_krm_1382_06"><a href="#foot_krm_1382_06">6</a></sup> रिरङ्क्षकः-क्षिका, <sup id="ref_krm_1382_07"><a href="#foot_krm_1382_07">7</a></sup> रारजकः-जिका;</li> <li>  रङ्क्ता-रङ्क्त्री, रञ्जयिता-रजयिता-त्री, रिरङ्क्षिता-त्री, रारजिता-त्री;</li> <li>  <sup id="ref_krm_1382_08"><a href="#foot_krm_1382_08">8</a></sup> रजन्-न्ती, रञ्जयन्-न्ती <sup id="ref_krm_1382_09"><a href="#foot_krm_1382_09">9</a></sup>, रजयन्-न्ती <sup id="ref_krm_1382_10"><a href="#foot_krm_1382_10">10</a></sup>, रिरङ्क्षन्-न्ती;</li> <li>  -- रङ्क्ष्यन्-न्ती-ती, रञ्जयिष्यन्-रजयिष्यन्-न्ती-ती, रिरङ्क्षिष्यन्-न्ती-ती;</li> <li>  -- रजमानः, रञ्जयमानः-रजयमानः, रिरङ्क्षमाणः, रारज्यमानः;</li> <li>  रङ्क्ष्यमाणः, रञ्जयिष्यमाणः-रजयिष्यमाणः, रिरङ्क्षिष्यमाणः, रारजिष्यमाणः;</li> <li>  <sup id="ref_krm_1382_11"><a href="#foot_krm_1382_11">11</a></sup> अनुरक्-अनुरग्-अनुरजौ-अनुरजः;</li> <li>  -- -- -- <sup id="ref_krm_1382_12"><a href="#foot_krm_1382_12">12</a></sup> रक्तम्-रक्तः-रक्तवान्, <sup id="ref_krm_1382_13"><a href="#foot_krm_1382_13">13</a></sup> विरक्तः-रक्तम्, रञ्जितः-रजितः <sup id="ref_krm_1382_14"><a href="#foot_krm_1382_14">14</a></sup>, रिरङ्क्षितः, रारजितः-तवान्;</li> <li>  रञ्जः, <sup id="ref_krm_1382_15"><a href="#foot_krm_1382_15">15</a></sup> रागी, <sup id="ref_krm_1382_16"><a href="#foot_krm_1382_16">16</a></sup> रञ्जनः, <sup id="ref_krm_1382_17"><a href="#foot_krm_1382_17">17</a></sup> मनोऽनुरञ्जनः, <sup id="ref_krm_1382_18"><a href="#foot_krm_1382_18">18</a></sup> इति क्वुन्प्रत्ययः। </li> <li>रजकी इति ‘पुंयोगादाख्यायाम्’ <sup id="ref_krm_1382_19"><a href="#foot_krm_1382_19">19</a></sup> इति ङीष्। </li> <li>अपुंयोगे तु ङीषा न भाव्यम् इति भाष्यकाराभिप्रायः।” इति कैयटेन च निर्णीतत्वात् अत्र प्रयोगे ष्वुन् न, क्युनेवेत्यतः न्यास-पदमञ्जर्यादय उपेक्ष्याः। </li> <li>तदुक्तम् शब्दकौस्तुमे-- “एवञ्च, भाष्यमते नृतिखनिभ्यामेव ष्वुन्। </li> <li>न तु रञ्जेः इति स्थितम्।” <sup id="ref_krm_1382_20"><a href="#foot_krm_1382_20">20</a></sup> इति। </li> <li>विस्तरस्त्वन्यत्र।]] रजकः-रजकी, <sup id="ref_krm_1382_21"><a href="#foot_krm_1382_21">21</a></sup> रज्यन्-न्ती-ती, <sup id="ref_krm_1382_22"><a href="#foot_krm_1382_22">22</a></sup> रज्यमानः <sup id="ref_krm_1382_23"><a href="#foot_krm_1382_23">23</a></sup>, रञ्जः-रजः, रिरङ्क्षुः, रिरञ्जयिषुः-रिरजयिषुः, रारञ्जः;</li> <li>  रङ्क्तव्यम्, रञ्जयितव्यम्-रजयितव्यम्, रिरङ्क्षितव्यम्, रारजितव्यम्;</li> <li>  रञ्जनीयम्, रञ्जनीयम्-रजनीयम्, रिरङ्क्षणीयम्, रारजनीयम्;</li> <li>  <sup id="ref_krm_1382_24"><a href="#foot_krm_1382_24">24</a></sup> रङ्ग्यम्, रञ्ज्यम्-रज्यम्, रिरङ्क्ष्यम्, रारज्यम्;</li> <li>  ईषद्रञ्जः-दूरञ्जः-सुरञ्जः;</li> <li>  -- -- -- <sup id="ref_krm_1382_25"><a href="#foot_krm_1382_25">25</a></sup> रज्यमानः, रञ्ज्यमानः-रज्यमानः, रिरङ्क्ष्यमाणः, रारज्यमानः;</li> <li>  विरागः- <sup id="ref_krm_1382_26"><a href="#foot_krm_1382_26">26</a></sup> वैरङ्गिकः-आश्चर्यो <sup id="ref_krm_1382_27"><a href="#foot_krm_1382_27">27</a></sup> रागः, अन्यद्रागः, <sup id="ref_krm_1382_28"><a href="#foot_krm_1382_28">28</a></sup> रङ्गः, <sup id="ref_krm_1382_29"><a href="#foot_krm_1382_29">29</a></sup> रङ्गः, रञ्जः-रजः, रिरङ्क्षः, रारजः;</li> <li>  रङ्क्तुम्, रञ्जयितुम्-रजयितुम्, रिरङ्क्षितुम्, रारजितुम्;</li> <li>  विरक्तिः, रञ्जना-रजना, रिरङ्क्षा, रिरञ्जयिषा-रिरजयिषा, रारजा;</li> <li>  रञ्जनम्, रञ्जनम्-रञ्जनी, रजनम्-रजनी, रिरङ्क्षणम्, रारजनम्;</li> <li>  रक्त्वा, रञ्जयित्वा-रजयित्वा, रिरङ्क्षित्वा, रारजित्वा;</li> <li>  <sup id="ref_krm_1382_30"><a href="#foot_krm_1382_30">30</a></sup> विरज्य, विरञ्ज्य- <sup id="ref_krm_1382_31"><a href="#foot_krm_1382_31">31</a></sup> विरजय्य, विरिरङ्क्ष्य, विरारज्य;</li> <li>  रञ्जम् २, रक्त्वा २, <sup id="ref_krm_1382_32"><a href="#foot_krm_1382_32">32</a></sup> रञ्जम् २ -राञ्जम् २ -रजम् २ -राजम् २, रञ्जयित्वा २ -रजयित्वा २, रिरङ्क्षम् २, रिरङ्क्षित्वा २, रारजम् २;</li> <li>  रारजित्वा २;</li> <li>  <sup id="ref_krm_1382_33"><a href="#foot_krm_1382_33">33</a></sup> इति क्वुन्प्रत्ययः। </li> <li>प्रत्ययस्य कित्त्वादुपधानकारलोपः।]] रजकः-रजकी, <sup id="ref_krm_1382_34"><a href="#foot_krm_1382_34">34</a></sup> इति क्युन्प्रत्ययः। </li> <li>रजति रज्यते वाऽनेनेति रजनः = रजकः, रागश्च। </li> <li>‘स च बाहुलकात् टिद्द्रष्टव्यः।’ इति कैयटोक्तेः <sup id="ref_krm_1382_35"><a href="#foot_krm_1382_35">35</a></sup> स्त्रियां ङीपि रञ्जनी रात्रिः, हरिद्रा च।]] रजनः-रजनी, <sup id="ref_krm_1382_36"><a href="#foot_krm_1382_36">36</a></sup> इति अतच्प्रत्यये, कित्त्वेनानुनासिलोपे च रूपम्। </li> <li>रजन्तेऽस्मिन् जना इति रजतम् = लोहविशेषः। </li> <li>“रजतस्य विकारो राजतम्-- ‘प्राणिरजतादिभ्योऽञ्’ <sup id="ref_krm_1382_37"><a href="#foot_krm_1382_37">37</a></sup> इति षष्ठ्यन्तात् विकारेऽञ्- प्रत्ययः। </li> <li>अत्र, ‘अनुदात्तादेः--’ <sup id="ref_krm_1382_38"><a href="#foot_krm_1382_38">38</a></sup> इत्येवाञि सिद्धे पुनरञ्विधानम्, ‘मयड्वैतयोः--’ <sup id="ref_krm_1382_39"><a href="#foot_krm_1382_39">39</a></sup> इति धिकारमयटो बाधनार्थम्।” इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>एतेन ‘रजतमयम् पात्रम्’ इति च्छान्दसानां प्रयोगोऽपाणिनीय इति ज्ञेयम्।]] रजतम्, <sup id="ref_krm_1382_40"><a href="#foot_krm_1382_40">40</a></sup> इत्यसुन्प्रत्ययः, स च किच्च भवति। </li> <li>रजः = अशुभम्, रेणुश्च।]] रजः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1382_01"><a href="#ref_krm_1382_01">↑</a> (१३७२)</li> <li id="foot_krm_1382_02"><a href="#ref_krm_1382_02">↑</a> (१-भ्वादिः-९९९। अक। अनि। उभ।)</li> <li id="foot_krm_1382_03"><a href="#ref_krm_1382_03">↑</a> (श्लो। ५७-५८)</li> <li id="foot_krm_1382_04"><a href="#ref_krm_1382_04">↑</a> [[१। ‘नकारजावनुस्वारपञ्चमौ झलि धातुषु।’ इत्यभियुक्तोक्तेरयं धातुरुपदेशे नकारो- पधः। सन्धिवशाञ्ञकार इति बोध्यम्।]]</li> <li id="foot_krm_1382_05"><a href="#ref_krm_1382_05">↑</a> [[२। ण्यन्ते सर्वत्र मृगरमणभिन्नार्थे नलोपाभावादेवमेव रूपम्। ‘रजको मृगाणाम्’ इत्यत्र तु ‘रञ्जेर्णौ मृगरमणे’ (वा। ६-४-२४) इति नलोपे, ‘जनीजॄष्क्नसुरञ्जोऽ- मन्ताश्च’ (ग। सू। भ्वादिः) इति मित्संज्ञायां ‘मितां ह्रस्वः’ (६-४-९२) इत्युपधाह्रस्वः। एवमेवार्थभेदाद्रूपद्वयस्योपपत्तिः सर्वत्र बोध्या। मृगरमणम् = आखेटकः इत्येके। “परे तु ‘रजयाञ्चकार विरजाः स मृगान्--’ (किराता- र्जुनीये ६-२४) इति भारविप्रयोगात् मृगरमणं यथाश्रुतमेव। अत एव भगवता ‘रञ्जयति वस्त्राणि’ (भाष्ये ६-४-२४) इति प्रत्युदाहृतम् इत्याहुः।” इति भाष्यप्रदीपोद्द्योते निरूपितमिहावधेयम्। एतेन ‘राजर्षिकल्पो रजयन्’ इति क्षीरतरङ्गिण्युपात्तवचनस्याप्युपपत्तिर्ज्ञेया। मृगरमणम् = मृगाणाम् रमणमिति बोध्यम्। ‘जनीजॄष्क्नसुरञ्जः--’ (ग। सू। भ्वादिषु) इत्यत्रार्थविशेषोपादानाभावात् यथाश्रुतार्थे रागेऽपि मित्त्वमिति ज्ञेयम्। ‘मृग- रमणम् = मृगक्रीडा।’ इति न्यासः।]]</li> <li id="foot_krm_1382_06"><a href="#ref_krm_1382_06">↑</a> [[३। सन्नन्ते सर्वत्र धातुजकारस्य कुत्वेन गकारे, उपधानकारस्यानुस्वारपरसवर्णयोः, सनः सकारस्य षकारे, चर्त्वे च रूपमेवम्।]]</li> <li id="foot_krm_1382_07"><a href="#ref_krm_1382_07">↑</a> [[४। यङ्निमित्तक उपधानकारलोपे, अभ्यासे दीर्घे च रूपमेवम्।]]</li> <li id="foot_krm_1382_08"><a href="#ref_krm_1382_08">↑</a> [[५। शतरि शपि, ‘रञ्जेश्च’ (६-४-२६) इत्युपधानकारलोपः।]]</li> <li id="foot_krm_1382_09"><a href="#ref_krm_1382_09">↑</a> [पक्षिणः]</li> <li id="foot_krm_1382_10"><a href="#ref_krm_1382_10">↑</a> [मृगान्]</li> <li id="foot_krm_1382_11"><a href="#ref_krm_1382_11">↑</a> [[६। क्विपि, उपधानकारलोपे कुत्वे चर्त्वविकल्पे च रूपमेवम्।]]</li> <li id="foot_krm_1382_12"><a href="#ref_krm_1382_12">↑</a> [पृष्ठम्१०९७+ ३३]</li> <li id="foot_krm_1382_13"><a href="#ref_krm_1382_13">↑</a> [[१। विरक्तः, रक्तम् इत्यत्र ‘क्तिच्क्तौ च संज्ञायाम्’ (३-३-१७४) इति संज्ञायां क्तः।]]</li> <li id="foot_krm_1382_14"><a href="#ref_krm_1382_14">↑</a> [[आ। ‘कलतया वचसः परिवादिनीस्वरजिता रजिता वशमाययुः।।’ शि। व। ६। ९।]]</li> <li id="foot_krm_1382_15"><a href="#ref_krm_1382_15">↑</a> [[२। तच्छीलादिषु कर्तृषु ‘सम्पृचानुरुध… त्यजरजभजातिचरापचरामुषाभ्याहनश्च’ (३-२-१४२) इति घिनुण्। प्रकृतसूत्रे ‘रज’ इति निपातनात् घिनुण्यपि उपधा- नकारलोपः। तदुक्तं भाष्ये--’ ‘घिनुणि निपातनात् सिद्धम्’ (भाष्यम् ६-४-२४) इति। णित्त्वादुपधावृद्धौ, ‘चजोः कु घिण्ण्यतोः’ (७-३-५२) इति कुत्वे च रूप- मेवम्। अनुरागी इत्यादयस्तु घञन्तात् मत्वर्थीय इनिप्रत्यये साधव इति बोध्यम्।]]</li> <li id="foot_krm_1382_16"><a href="#ref_krm_1382_16">↑</a> [[३। रजति, रजते वा इति रञ्जनः। बाहुलकात् ‘कृत्यल्युटो बहुलम्’ (३-३-११३) इति कर्तरि ल्युट्। यद्वा, ‘शिल्पिनि ष्वुन्’ (३-१-१४५) इति सूत्रभाष्ये ‘नृतिखनिरञ्जिभ्यः--’ इति वचनात् कर्तरि ष्वुन्। न चात्र नलोपः शङ्क्यः, ‘कित एवैते औणादिकाः’ इति षाष्ठभाष्यात् (६-४-२४) औणादिकक्युन्प्रत्य- यान्त एव नलोप इत्येतदुत्तरत्र स्पष्टीकरिष्यमाणत्वात् इत्यलमत्र।]]</li> <li id="foot_krm_1382_17"><a href="#ref_krm_1382_17">↑</a> [[४। मनांस्यनुरञ्जयतीति मनोऽनुरञ्जनः। नन्द्यादित्वात् (३-१-१३४) कर्मण्युपपदे कर्तरि ल्युः। गौरादि (४-१-४१) पाठात् स्त्रियां ङीष्। एवमेव रसिकरञ्जनी- प्रभृतयः शब्दाः साधवः। रसिकरञ्जिनी इति प्रयोगसत्त्वे तु ‘सुप्यजातौ--’ (३-२-७८) इति णिनिप्रत्यये, ‘ऋन्नेभ्यो ङीप्’ (४-१-५) इति ङीपि तस्य साधुत्वं बोध्यम्।]]</li> <li id="foot_krm_1382_18"><a href="#ref_krm_1382_18">↑</a> [[५। ‘शिल्पिनि ष्वुन्’ (३-१-१४५) इत्यत्र, ‘नृतिखनिरञ्जिभ्य इति वक्तव्यम्’ इति भाष्यात् कर्तरि ष्वुन्। वस्तुतस्तु षष्ठे (६-४-२४) “कित एवैते औणादिकाः।” इति भाष्येण ‘रजकरजनरजस्सूपसंख्यानं कर्तव्यम्’ (वा। ६-४-२४) इति वार्तिकप्रत्याख्यानपरेण, “रजकः इत्यत्र ‘क्वुन् शिल्पिसंज्ञयोः--’ [द। उ। ३-५]</li> <li id="foot_krm_1382_19"><a href="#ref_krm_1382_19">↑</a> (४-१-४८)</li> <li id="foot_krm_1382_20"><a href="#ref_krm_1382_20">↑</a> (३-१-१४५)</li> <li id="foot_krm_1382_21"><a href="#ref_krm_1382_21">↑</a> [[६। ‘कुषिरजोः प्राचां श्यन् परस्मैपदं च’ (३-१-९०) इति कर्मकर्तरि विकल्पेन श्यन्प्रत्ययः परस्मैपदं च। यगात्मनेपदयोरपवादौ। एतच्च व्यवस्थितविभाषेति काशिकादिषु स्पष्टम्। श्यनः अपित्सार्वधातुकत्वेन ङिद्वद्भावः। तेन, ‘अनिदिताम्--’ (६-४-२४) इति उपधानकारलोपः। स्त्रियाम्, ‘आच्छी- नद्योर्नुम्’ (७-१-८०) इति नुम्विकल्पः।]]</li> <li id="foot_krm_1382_22"><a href="#ref_krm_1382_22">↑</a> [पृष्ठम्१०९८+ २७]</li> <li id="foot_krm_1382_23"><a href="#ref_krm_1382_23">↑</a> [वस्त्रः स्वयमेव]</li> <li id="foot_krm_1382_24"><a href="#ref_krm_1382_24">↑</a> [[१। निष्ठायामनिट्त्वात् ण्यति, ‘चजोः कु घिण्ण्यतोः’ (७-३-५२) इति कुत्वे रूपमेवम्।]]</li> <li id="foot_krm_1382_25"><a href="#ref_krm_1382_25">↑</a> [[२। यगात्मनेपदयोरपवादत्वेन श्यन्परस्मैपदयोविंहितयोरपि, ‘कुषिरजोः प्राचाम् --’ (३-१-९०) इत्यत्र ‘प्राचां’ ग्रहणात् पक्षे यगात्मनेपदे भवत इति रूप- स्यास्यापि साधुत्वं बोध्यम्।]]</li> <li id="foot_krm_1382_26"><a href="#ref_krm_1382_26">↑</a> [[३। विपूर्वकादस्माद् भावे घञि, ‘घञि च भावकरणयोः’ (६-४-२७) इति उपधान- कारलोपे, ‘अत उपधायाः’ (७-२-११६) इत्युपधाभूताकारस्य वृद्धौ, ‘चजोः--’ (७-३-५२) इति कुत्वे च विरागः इति सम्पद्यते। तस्मात् ‘विरागमर्हति’ इत्यर्थे, ‘छेदादिभ्यो नित्यम्’ (५-१-६४) इति ठक्प्रत्यये, ‘विरागो विरङ्गं च’ (ग। सू। ५-१-६४) इति गणपाठात् प्रकृतेर्विरङ्गादेशे, आदिवृद्धौ च वैरङ्गिकः इति रूपमिति बोध्यम्।]]</li> <li id="foot_krm_1382_27"><a href="#ref_krm_1382_27">↑</a> [[४। रज्यतेऽनेनेति रागः। करणे घञि, ‘घञि च भावकरणयोः’ (६-४-२७) इत्युपाधानकारलोपे, उपधाभूताकारस्य वृद्धौ कुत्वे च रूपमेवम्। अन्यद्रागः इत्यत्र, ‘अषष्ठ्यतृतीयास्थस्य अन्यस्य दुग् आशीराशास्थास्थितोत्सुकोति कारक- रागच्छेषु’ (६-३-९९) इति रागशब्दे परत अन्यशब्दस्य दुगागमः।]]</li> <li id="foot_krm_1382_28"><a href="#ref_krm_1382_28">↑</a> [[५। रञ्जयति प्रेक्षकाणां मनांस्यत्रेत्यर्थेऽन्तर्भावितण्यर्थाद्धातोरधिकरणे घञि कुत्वे रूप- मेवम्। रङ्गः = नाटकादीनां प्रेक्षणस्थानम्।]]</li> <li id="foot_krm_1382_29"><a href="#ref_krm_1382_29">↑</a> [[६। ‘हलश्च’ (३-३-१२१) इत्यनेन संज्ञायां घञि, ‘पुंसि संज्ञायां घः प्रायेण’ (३-३-११८) इति घप्रत्यये वा सति कुत्वे रूपमेवम्। रङ्गः = देशविशेषः, देवश्च।]]</li> <li id="foot_krm_1382_30"><a href="#ref_krm_1382_30">↑</a> [पृष्ठम्१०९९+ ३०]</li> <li id="foot_krm_1382_31"><a href="#ref_krm_1382_31">↑</a> [[१। ण्यन्तात् क्त्वो ल्यपि मृगरमणार्थे नकारलोपे, मित्संज्ञकत्वात् उपधाह्रस्वे च ‘ल्यपि लघुपूर्वात्’ (६-४-५६) इति णेरयादेशे रूपमेवम्।]]</li> <li id="foot_krm_1382_32"><a href="#ref_krm_1382_32">↑</a> [[२। ‘जनीजॄष्क्नसुरञ्जोऽमन्ताश्च’ (ग। सू। भ्वादिषु) इत्यत्रार्थविशेषानिर्देशपुरस्सरं मित्त्वानुशासनात्, अनुपधात्वेऽपि रञ्जम् २-राञ्जम् २ इति दीर्घविकल्पः, ‘चिण्णमुलोर्दीर्घोऽन्यतरस्याम्’ (६-४-९३) इति सूत्रेण भवतीति माधवः। मृगरमणार्थे नलोपपक्षे तु रजम् २-राजम् २ इति द्विरूपविषये न विप्रति- पत्तिरिति ज्ञेयम्।]]</li> <li id="foot_krm_1382_33"><a href="#ref_krm_1382_33">↑</a> [[३। ‘क्वुन् शिल्पिसंज्ञयोरपूर्वस्यापि’ [द। उ। ३-५]</li> <li id="foot_krm_1382_34"><a href="#ref_krm_1382_34">↑</a> [[४। ‘रजः क्युन्’ [द। उ। ५-२४]</li> <li id="foot_krm_1382_35"><a href="#ref_krm_1382_35">↑</a> (६-४-२४)</li> <li id="foot_krm_1382_36"><a href="#ref_krm_1382_36">↑</a> [[५। ‘पृषिरञ्जिभ्यां कित्’ [द। उ। ६-१५]</li> <li id="foot_krm_1382_37"><a href="#ref_krm_1382_37">↑</a> (४-३-१५४)</li> <li id="foot_krm_1382_38"><a href="#ref_krm_1382_38">↑</a> (४-२-४४)</li> <li id="foot_krm_1382_39"><a href="#ref_krm_1382_39">↑</a> (४-३-१४३)</li> <li id="foot_krm_1382_40"><a href="#ref_krm_1382_40">↑</a> [[६। ‘भूरञ्जिभ्यां कित्’ [द। उ। ९। ७६]</li></ul></p>

रन्ज|रञ्जकः-ञ्जिका|रञ्जकः-रजकः-ञ्जिका-जिका|रिरङ्क्षकः-क्षिका|रारजकः-जिका|रङ्क्ता-रङ्क्त्री|रञ्जयिता-रजयिता-त्री|रिङ्क्षिता-त्री|रारजिता-त्री
<ul><li><sup id="ref_krm_1383_01"><a href="#foot_krm_1383_01">1</a></sup> {@“रन्ज रागे”@} <sup id="ref_krm_1383_02"><a href="#foot_krm_1383_02">2</a></sup> <sup id="ref_krm_1383_03"><a href="#foot_krm_1383_03">3</a></sup> धातोरस्यापि ‘जनीजॄष्क्नसुरञ्जोऽमन्ताश्च’ <sup id="ref_krm_1383_04"><a href="#foot_krm_1383_04">4</a></sup> इत्यत्र ग्रहणं ज्ञेयम्। </li> <li>क्षीरस्वामिना “स्वरितेत्त्वार्थं विकरणार्थं च इह <sup id="ref_krm_1383_05"><a href="#foot_krm_1383_05">5</a></sup> पाठः।” इत्युक्तम्। </li> <li>भ्वादिष्वपि उभयपदित्वस्याविशिष्टत्वात् तत्रापि स्वरितेत्त्वस्यैवाङ्गीकाराच्च चिन्त्यमिदमिति ज्ञेयम्। </li> <li>विकरणार्थं स्वरार्थमिति स्यादिति भाति।]] ‘रजते रजतीत्येव रज्यते रज्यतीत्यपि।। </li> <li>रागार्थे शप्श्यनोर्द्वे द्वे…।’ <sup id="ref_krm_1383_06"><a href="#foot_krm_1383_06">6</a></sup> इति देवः। </li> <li><sup id="ref_krm_1383_07"><a href="#foot_krm_1383_07">7</a></sup> रञ्जकः-ञ्जिका, रञ्जकः-रजकः-ञ्जिका-जिका, रिरङ्क्षकः-क्षिका, रारजकः-जिका;</li> <li>  रङ्क्ता-रङ्क्त्री, रञ्जयिता-रजयिता-त्री, रिङ्क्षिता-त्री, रारजिता-त्री;</li> <li>  इत्यादिकानि सर्वाणि रूपाणि भौवादिकरजतिवत् <sup id="ref_krm_1383_08"><a href="#foot_krm_1383_08">8</a></sup> ज्ञेयानि। </li> <li>शतरि <sup id="ref_krm_1383_09"><a href="#foot_krm_1383_09">9</a></sup> रज्यन्-न्ती, इति, शानचि, रज्यमानः इति च भवति। </li> <li>भौवादिकधातुवत् सर्वाण्यपि विशेषरूपाण्यस्मादपि भवन्तीति च बोध्यम्। </li> <li>घिनुणि- <sup id="ref_krm_1383_10"><a href="#foot_krm_1383_10">10</a></sup> रागी।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1383_01"><a href="#ref_krm_1383_01">↑</a> (१३७३)</li> <li id="foot_krm_1383_02"><a href="#ref_krm_1383_02">↑</a> (४-दिवादिः-११६७। अक। अनि। उभ।)</li> <li id="foot_krm_1383_03"><a href="#ref_krm_1383_03">↑</a> [[[अ]</li> <li id="foot_krm_1383_04"><a href="#ref_krm_1383_04">↑</a> (ग। सू। भ्वादिषु)</li> <li id="foot_krm_1383_05"><a href="#ref_krm_1383_05">↑</a> (दिवादिषु)</li> <li id="foot_krm_1383_06"><a href="#ref_krm_1383_06">↑</a> (श्लो। ५७-५८)</li> <li id="foot_krm_1383_07"><a href="#ref_krm_1383_07">↑</a> [पृष्ठम्११००+ २८]</li> <li id="foot_krm_1383_08"><a href="#ref_krm_1383_08">↑</a> (१३७२)</li> <li id="foot_krm_1383_09"><a href="#ref_krm_1383_09">↑</a> [[१। शतरि शपो दिवादित्वाच्छ्यनि, तस्यापित्सार्वधातुकत्वेन ङिद्वद्भावात्, ‘अनि- दितां हल उपधायाः क्ङिति’ (६-४-२४) इत्युपधानकारलोपः।]]</li> <li id="foot_krm_1383_10"><a href="#ref_krm_1383_10">↑</a> [[आ। ‘एता देवानुरोधिन्यो द्वेषिण्य इव रागिणम्।’ भ। का। ७। ९।]]</li></ul></p>

रप|रापकः-पिका|रिरपिषकः-षिका|रारपकः-पिका|रपिता-त्री|रापयिता-त्री|रिरपिषिता-त्री|रारपिता-त्री
<ul><li><sup id="ref_krm_1384_01"><a href="#foot_krm_1384_01">1</a></sup> {@“रप व्यक्तायां वाचि”@} <sup id="ref_krm_1384_02"><a href="#foot_krm_1384_02">2</a></sup> ‘--वचसि क्लैव्ये’ इति दशपाद्युणादिवृत्ति <sup id="ref_krm_1384_03"><a href="#foot_krm_1384_03">3</a></sup> पाठः। </li> <li>रापकः-पिका, रापकः-पिका, रिरपिषकः-षिका, रारपकः-पिका;</li> <li>  रपिता-त्री, रापयिता-त्री, रिरपिषिता-त्री, रारपिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकचपतिवत् <sup id="ref_krm_1384_04"><a href="#foot_krm_1384_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1384_05"><a href="#foot_krm_1384_05">5</a></sup> राप्यम्, <sup id="ref_krm_1384_06"><a href="#foot_krm_1384_06">6</a></sup> इत्युक्तम्।]] रिपुः इमौ रूपौ विशेषेण भवतः इति ज्ञेयम्</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1384_01"><a href="#ref_krm_1384_01">↑</a> (१३७४)</li> <li id="foot_krm_1384_02"><a href="#ref_krm_1384_02">↑</a> (१-भ्वादिः-४०१। अक। सेट्। पर।)</li> <li id="foot_krm_1384_03"><a href="#ref_krm_1384_03">↑</a> (१-१११)</li> <li id="foot_krm_1384_04"><a href="#ref_krm_1384_04">↑</a> (४९७)</li> <li id="foot_krm_1384_05"><a href="#ref_krm_1384_05">↑</a> [[२। ‘आसुयुवपिरपि--’ (३-१-१२६) इति ण्यत्। यतोऽपवादः।]]</li> <li id="foot_krm_1384_06"><a href="#ref_krm_1384_06">↑</a> [[३। ‘रपेरिच्चोपधायाः’ (द। उ। १-१११) इति कुप्रत्ययः, उपधायाः इच्च भवति। रिपुः = वैरी। अत्र द। उ। टिप्पन्याम् “श्वेतवनवासिना रपेर्हिं- सार्थत्वमाश्रित्य रिपुशब्दो निरुक्तः। तथाहि-- “रपति हिनस्ति इति रिपुः = शत्रुः। संज्ञाशब्देषु धातोरर्थान्तरवृत्तित्वमस्ति। तथाह्युक्तम्-- ‘धातो- स्तदर्थातिशयेन योगस्तदुच्यते पञ्चविधं निरुक्तम्।’ इति” [पृष्ठम् १४। १५।]</li></ul></p>

रफ|राफकः-फिका|रिरफिषकः-षिका|रारफकः-फिका|रफिता-त्री|राफयिता-त्री|रिरफिषिता-त्री|रारफिता-त्री
<ul><li><sup id="ref_krm_1385_01"><a href="#foot_krm_1385_01">1</a></sup> {@“रफ गतौ”@} <sup id="ref_krm_1385_02"><a href="#foot_krm_1385_02">2</a></sup> धातुममुं हिंसार्थं पठति कण्ठः इति क्षीरस्वामी। </li> <li>राफकः-फिका, राफकः-फिका, रिरफिषकः-षिका, रारफकः-फिका;</li> <li>  रफिता-त्री, राफयिता-त्री, रिरफिषिता-त्री, रारफिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकचपतिवत् <sup id="ref_krm_1385_03"><a href="#foot_krm_1385_03">3</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_1385_04"><a href="#foot_krm_1385_04">4</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1385_01"><a href="#ref_krm_1385_01">↑</a> (१३७५)</li> <li id="foot_krm_1385_02"><a href="#ref_krm_1385_02">↑</a> (१-भ्वादिः-४१३। सक। सेट्। पर।)</li> <li id="foot_krm_1385_03"><a href="#ref_krm_1385_03">↑</a> (४९७)</li> <li id="foot_krm_1385_04"><a href="#ref_krm_1385_04">↑</a> [पृष्ठम्११०१+ २३]</li></ul></p>

रफि|रम्फकः-म्फिका|रिरम्फिषकः-षिका|रारम्फकः-म्फिका|रम्फिता-त्री|रम्फयिता-त्री|रिरम्फिषिता-त्री|रारम्फिता-त्री
<ul><li><sup id="ref_krm_1386_01"><a href="#foot_krm_1386_01">1</a></sup> {@“रफि गतौ”@} <sup id="ref_krm_1386_02"><a href="#foot_krm_1386_02">2</a></sup> केचित् हिंसार्थकत्वमस्याङ्गीकुर्वन्तीति क्षीरतरङ्गिणीतो ज्ञायते। </li> <li>रम्फकः-म्फिका, रम्फकः-म्फिका, रिरम्फिषकः-षिका;</li> <li>  रारम्फकः-म्फिका;</li> <li>  रम्फिता-त्री, रम्फयिता-त्री, रिरम्फिषिता-त्री, रारम्फिता-त्री;</li> <li>  इत्यादिकानि समस्तान्यपि रूपाणि भौवादिककम्पतिवत् <sup id="ref_krm_1386_03"><a href="#foot_krm_1386_03">3</a></sup> बोध्यानि। </li> <li>अस्य धातोः गत्यर्थकत्वात् ण्यन्तात् शानचि-रम्फयमाणः, रम्फयिष्यमाणः इति विशेषः। </li> <li>घञि- <sup id="ref_krm_1386_04"><a href="#foot_krm_1386_04">4</a></sup> सुरम्फः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1386_01"><a href="#ref_krm_1386_01">↑</a> (१३७६)</li> <li id="foot_krm_1386_02"><a href="#ref_krm_1386_02">↑</a> (१-भ्वादिः-४१४। सक। सेट्। पर।)</li> <li id="foot_krm_1386_03"><a href="#ref_krm_1386_03">↑</a> (१६६)</li> <li id="foot_krm_1386_04"><a href="#ref_krm_1386_04">↑</a> [[आ। ‘हयैः सुरम्फैर्द्रुतमर्बतो रवेः पर्बद्भिरालर्ब्यत रक्तिमा करैः।’ धा। का। १-५४।]]</li></ul></p>

रबि|रम्बकः-म्बिका|रिरम्बिषकः-षिका|रारम्बकः-म्बिका|रम्बिता-त्री|रम्बयिता-त्री|रिरम्बिषिता-त्री|रारम्बिता-त्री
<ul><li><sup id="ref_krm_1387_01"><a href="#foot_krm_1387_01">1</a></sup> {@“रबि शब्दे”@} <sup id="ref_krm_1387_02"><a href="#foot_krm_1387_02">2</a></sup> रम्बकः-म्बिका, रम्बकः-म्बिका, रिरम्बिषकः-षिका, रारम्बकः-म्बिका;</li> <li>  रम्बिता-त्री, रम्बयिता-त्री, रिरम्बिषिता-त्री, रारम्बिता-त्री;</li> <li>  इत्यादिकानि सर्वाण्यपि रूपाणि भौवादिककम्पतिवत् <sup id="ref_krm_1387_03"><a href="#foot_krm_1387_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1387_04"><a href="#foot_krm_1387_04">4</a></sup> रम्बणः, <sup id="ref_krm_1387_05"><a href="#foot_krm_1387_05">5</a></sup> सुरम्बी, <sup id="ref_krm_1387_06"><a href="#foot_krm_1387_06">6</a></sup> हेरम्बः, <sup id="ref_krm_1387_07"><a href="#foot_krm_1387_07">7</a></sup> अस्य धातोः इमानि रूपाण्यधिकानीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1387_01"><a href="#ref_krm_1387_01">↑</a> (१३७७)</li> <li id="foot_krm_1387_02"><a href="#ref_krm_1387_02">↑</a> (१-भ्वादिः-३७६। अक। सेट्। आत्म।)</li> <li id="foot_krm_1387_03"><a href="#ref_krm_1387_03">↑</a> (१६६)</li> <li id="foot_krm_1387_04"><a href="#ref_krm_1387_04">↑</a> [[१। ‘अनुदात्तेतश्च हलादेः’ (३-२-१४९) इति, ‘चलनशब्दार्थादकर्मकाद्युच्’ (३-२-१४८) इति वा युच् ताच्छीलिकः।]]</li> <li id="foot_krm_1387_05"><a href="#ref_krm_1387_05">↑</a> [[२। ‘सुप्यजातौ--’ (३-२-७८) इति णिनिप्रत्यये रूपमेवम्।]]</li> <li id="foot_krm_1387_06"><a href="#ref_krm_1387_06">↑</a> [[३। हे इत्येवं रम्बते इति हेरम्बः = विनायकः। पचाद्यचि रूपमेवम्। ‘के रम्बते-- करम्बः। स्वर्णं रत्नकरम्बितम्, कृञश्च चित् (‘कृञश्च’ द। उ। ७-१७) इत्यम्बज् वा’ इति क्षीरतरङ्गिण्यामुक्तम्। “‘हः शङ्करे हरौ हंसे रणरोमाञ्च- वाजिषु’ इति नानार्थरत्नमाला। ‘हे उषसि रम्बते’ इति स्वामी।” इति अमरसुधा (१-३८)।]]</li> <li id="foot_krm_1387_07"><a href="#ref_krm_1387_07">↑</a> [[B। ‘सकम्पहेरम्बसमानलम्बनाः…।’ धा। का। १-४९।]]</li></ul></p>

रभ|आरम्भकः-म्भिका|रम्भकः-म्भिका|रिप्सकः-प्सिका|रारभकः-भिका|आरब्धा-ब्ध्री|रम्भयिता-त्री|रिप्सिता-त्री|रारभिता-त्री|-|रम्भयन्|न्ती|रम्भयिष्यन्-न्ती-ती|-आरभमाणः|आरभमाणः|रम्भयमाणः|रिप्समानः|रारभ्यमाणः|रप्स्यमानः|रम्भयिष्यमाणः|रिप्सिष्यमाणः|रारभिष्यमाणः|सुरप्-सुरभ्-सुरभौ-सुरभः|आरब्धम्-ब्धः|रम्भितम्-तः|रिप्सितम्|रारभितम्-तः-तवान्|रम्भः-रम्भा|साध्वारम्भी|रम्भः|रिप्सुः|रारम्भः|आरब्धव्यम्|आरम्भयितव्यम्|रिप्सितव्यम्|रारभितव्यम्|आरम्भणीयम्|रिप्सनीयम्|रारभणीयम्|आरभ्यम्|आरम्भ्यम्|रिप्स्यम्|रारभ्यम्|ईषद्रम्भः-दूरम्भः-सुरम्भः|आरभ्यमाणः|आरम्भ्यमाणः|रिप्स्यमानः|आरम्भः|रिप्सः|रारभः|आरब्धुम्|आरम्भयितुम्|रिप्सितुम्|रारभितुम्|रब्धिः|आरम्भणा|रिप्सा|रारभा|आरम्भणम्|रिप्सनम्|रारभणम्|रब्ध्वा|रम्भयित्वा|रिप्सित्वा|रारभित्वा|आरभ्य|आरम्भ्य|आरिप्स्य|आरारभ्य|रम्भम्|रिप्सम्|रारभम्
<ul><li><sup id="ref_krm_1388_01"><a href="#foot_krm_1388_01">1</a></sup> {@“रभ राभस्ये”@} <sup id="ref_krm_1388_02"><a href="#foot_krm_1388_02">2</a></sup> राभस्यम् = कार्योपक्रमः। </li> <li>अयं प्रायेण आङ्पूर्वक एव प्रयुज्यते। </li> <li><sup id="ref_krm_1388_03"><a href="#foot_krm_1388_03">3</a></sup> <sup id="ref_krm_1388_04"><a href="#foot_krm_1388_04">4</a></sup> आरम्भकः-म्भिका, <sup id="ref_krm_1388_05"><a href="#foot_krm_1388_05">5</a></sup> रम्भकः-म्भिका, <sup id="ref_krm_1388_06"><a href="#foot_krm_1388_06">6</a></sup> रिप्सकः-प्सिका, रारभकः-भिका;</li> <li>  <sup id="ref_krm_1388_07"><a href="#foot_krm_1388_07">7</a></sup> आरब्धा-ब्ध्री, रम्भयिता-त्री, रिप्सिता-त्री, रारभिता-त्री;</li> <li>  -- रम्भयन् न्ती, रम्भयिष्यन्-न्ती-ती;</li> <li>  -- <sup id="ref_krm_1388_08"><a href="#foot_krm_1388_08">8</a></sup> आरभमाणः, <sup id="ref_krm_1388_09"><a href="#foot_krm_1388_09">9</a></sup> आरभमाणः, रम्भयमाणः, रिप्समानः, रारभ्यमाणः, रप्स्यमानः, रम्भयिष्यमाणः, रिप्सिष्यमाणः, रारभिष्यमाणः;</li> <li>  सुरप्-सुरभ्-सुरभौ-सुरभः;</li> <li>  -- -- आरब्धम्-ब्धः, रम्भितम्-तः, रिप्सितम्, रारभितम्-तः-तवान्;</li> <li>  <sup id="ref_krm_1388_10"><a href="#foot_krm_1388_10">10</a></sup> <sup id="ref_krm_1388_11"><a href="#foot_krm_1388_11">11</a></sup> रम्भः-रम्भा, <sup id="ref_krm_1388_12"><a href="#foot_krm_1388_12">12</a></sup> साध्वारम्भी, रम्भः, रिप्सुः, <sup id="ref_krm_1388_13"><a href="#foot_krm_1388_13">13</a></sup> रारम्भः;</li> <li>  आरब्धव्यम्, आरम्भयितव्यम्, रिप्सितव्यम्, रारभितव्यम्;</li> <li>  आरम्भणीयम्, आरम्भणीयम्, रिप्सनीयम्, रारभणीयम्;</li> <li>  <sup id="ref_krm_1388_14"><a href="#foot_krm_1388_14">14</a></sup> आरभ्यम्, आरम्भ्यम्, रिप्स्यम्, रारभ्यम्;</li> <li>  ईषद्रम्भः-दूरम्भः-सुरम्भः;</li> <li>  -- -- -- आरभ्यमाणः, आरम्भ्यमाणः, रिप्स्यमानः, रारभ्यमाणः;</li> <li>  आरम्भः, आरम्भः, रिप्सः, रारभः;</li> <li>  आरब्धुम्, आरम्भयितुम्, रिप्सितुम्, रारभितुम्;</li> <li>  रब्धिः, आरम्भणा, रिप्सा, रारभा;</li> <li>  आरम्भणम्, आरम्भणम्, रिप्सनम्, रारभणम्;</li> <li>  रब्ध्वा, रम्भयित्वा, रिप्सित्वा, रारभित्वा;</li> <li>  आरभ्य, आरम्भ्य, आरिप्स्य, आरारभ्य;</li> <li>  रम्भम् २, रब्ध्वा २, रम्भम् २, रम्भयित्वा २, रिप्सम् २, रिप्सित्वा २, रारभम् २;</li> <li>  रारभित्वा २;</li> <li>  <sup id="ref_krm_1388_15"><a href="#foot_krm_1388_15">15</a></sup> इत्यसच्प्रत्यये रूपम्। </li> <li>बाहुलकात्, ‘राभस्ये’ इति निर्देशाद्वा नुम् न।]] रभसः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1388_01"><a href="#ref_krm_1388_01">↑</a> (१३७८)</li> <li id="foot_krm_1388_02"><a href="#ref_krm_1388_02">↑</a> (१-भ्वादिः-९७४। अक। अनि। आत्म।)</li> <li id="foot_krm_1388_03"><a href="#ref_krm_1388_03">↑</a> [पृष्ठम्११०२+ २८]</li> <li id="foot_krm_1388_04"><a href="#ref_krm_1388_04">↑</a> [[१। ‘रभेरशब्लिटोः’ (७-१-६३) इति, अजादिषु प्रत्ययेषु शब्लिड्वर्जं नुमागमः। एवमेव घञादिष्वपि ज्ञेयम्। “काशकृत्स्नधातुपाठीयकन्नडटीकायां रभकः रभः, रभमाणः, रभणीयम् इत्यादिप्रयोगेषु नुमोऽदर्शनात् वस्तुतः सानुषङ्गाः आरम्भः, आरम्भणम्… इत्येवमादयः प्रयोगाः न रभधातोः, किं तर्हि? सानुषङ्गस्य रम्भधातोः…” इत्यादिकं क्षीरतरङ्गिणीटिप्पणे (पुटे १५१) सुदूरं विचारितम्। तत्र पाणिनीयधातुपाठकोशेषु कुत्रापि सानुषङ्गस्य रम्भधातोरुल्लेखाभावात् प्रमाणं मृग्यमिति बोध्यम्। ‘रेभृ शब्दे’ इति भौवा- दिकस्य धातोः दुर्गसम्मतं ‘रभि शब्दे’ इति पाठमाश्रित्य निर्वाहं केचित् कुर्वन्ति। तदपि दुर्गान्यैस्तत्पाठानादरात् न प्रमाणमिति बोध्यम्।]]</li> <li id="foot_krm_1388_05"><a href="#ref_krm_1388_05">↑</a> [[२। ण्यन्ते ण्वुलि, ‘अत उपधायाः’ (७-२-११६) इति प्राप्तां परामपि वृद्धिं बाधित्वा, ‘रभेरशब्लिटोः’ (७-१-६३) इति नुम् नित्यत्वाद्भवति।]]</li> <li id="foot_krm_1388_06"><a href="#ref_krm_1388_06">↑</a> [[३। सन्नन्ते, ‘सनि मीमाघुरभ--’ (७-४-५४) इत्यादिना इस्। ‘अत्र लोपोऽ- भ्यासस्य’ (७-४-५८) इत्यभ्यासलोपः। ‘स्कोः--’ (८-२-२९) इति सलोपः। भकारस्य चर्त्वेन पकारः।]]</li> <li id="foot_krm_1388_07"><a href="#ref_krm_1388_07">↑</a> [[४। तृजादिषु ‘झषस्तथोः--’ (८-२-४०) इति धत्वे, जश्त्वे च रूपमिति ज्ञेयम्।]]</li> <li id="foot_krm_1388_08"><a href="#ref_krm_1388_08">↑</a> [[५। शानचि, ‘रभेरशब्लिटोः’ (७-१-६३) इत्युक्तत्वात् नुमागमो न। यस्तु परि- भाषेन्दुशेखरे ‘गौणमुख्ययोर्मुख्ये कार्यसम्प्रत्ययः’ (परिभाषा १६) इत्यत्र, “…संज्ञाभूतानां प्रतिषेधम् आरभता वार्तिककृता…” इति वाक्ये, आत्मनेपदस्यास्य धातोः शत्रन्तप्रयोगः प्रयुक्तः, स तु सम्पातायात इति न तावता धातोरस्योभयपदित्वं कल्प्यम्। न च ‘अनुदात्तेत्त्वलक्षणमात्मनेपदम् अनित्यम्’ (परि। ९७) इति वचनात् आत्मनेवदस्यानित्यत्वात् ‘आरभता’ इति प्रयोगः सूपपन्न इति वाच्यम्। तस्याः परिभाषायाः भाष्याद्यनादृतत्वेनाप्रामाण्यस्य नागेशभट्टैरेव समर्थितत्वादित्यन्यत्र विस्तरः। ‘भोक्तुम् आरभमाणः’ इत्यत्र, ‘शकधृषज्ञाग्लाघटरभ--’ (३-४-६५) इत्यादिना धातुमात्रात् तुमुन्।]]</li> <li id="foot_krm_1388_09"><a href="#ref_krm_1388_09">↑</a> [भोक्तुम्]</li> <li id="foot_krm_1388_10"><a href="#ref_krm_1388_10">↑</a> [पृष्ठम्११०३+ २६]</li> <li id="foot_krm_1388_11"><a href="#ref_krm_1388_11">↑</a> [[१। पचाद्यचि नुमि रम्भः। स्त्रियां टापि रम्भा = अप्सरोविशेषः, कदली च।]]</li> <li id="foot_krm_1388_12"><a href="#ref_krm_1388_12">↑</a> [[२। ‘साधुकारिण्युपसंख्यानम्’ (वा। ३-२-७८) इति णिनिः।]]</li> <li id="foot_krm_1388_13"><a href="#ref_krm_1388_13">↑</a> [[३। यङन्तात् पचाद्यचि, यङो लुकि नुमागमे च रूपमेवम्।]]</li> <li id="foot_krm_1388_14"><a href="#ref_krm_1388_14">↑</a> [[४। ‘पोरदुपधात्’ (३-१-९८) इति यत्प्रत्ययः। हलन्तलक्षणण्यतोऽपवादः।]]</li> <li id="foot_krm_1388_15"><a href="#ref_krm_1388_15">↑</a> [[५। ‘अत्यविचमितमिरभि--’ [द। उ। ९-४४]</li></ul></p>

रभि|रम्भकः-म्भिका|रिरम्भिषकः-षिका|रारम्भकः-म्भिका|रम्भिता-त्री|रम्भयिता-त्री|रिरम्भिषिता-त्री|रारम्भिता-त्री
<ul><li><sup id="ref_krm_1389_01"><a href="#foot_krm_1389_01">1</a></sup> {@“रभि शब्दे”@} <sup id="ref_krm_1389_02"><a href="#foot_krm_1389_02">2</a></sup> ‘रेभृ शब्दे’ इत्यस्य दुर्गसम्मतः पाठ एवमिति क्षीरतरङ्गिणीतो ज्ञायते। </li> <li>रम्भकः-म्भिका, रम्भकः-म्भिका, रिरम्भिषकः-षिका, रारम्भकः-म्भिका;</li> <li>  रम्भिता-त्री, रम्भयिता-त्री, रिरम्भिषिता-त्री, रारम्भिता-त्री;</li> <li>  इतीमानि रूपाणि भौवादिककुण्ठतिवत् <sup id="ref_krm_1389_03"><a href="#foot_krm_1389_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1389_04"><a href="#foot_krm_1389_04">4</a></sup> करम्भः। </li> <li><sup id="ref_krm_1389_05"><a href="#foot_krm_1389_05">5</a></sup> प्ररम्भणम्। </li> <li><sup id="ref_krm_1389_06"><a href="#foot_krm_1389_06">6</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1389_01"><a href="#ref_krm_1389_01">↑</a> (१३७९)</li> <li id="foot_krm_1389_02"><a href="#ref_krm_1389_02">↑</a> (१-भ्वादिः-३८५। अक। सेट्। आत्म।)</li> <li id="foot_krm_1389_03"><a href="#ref_krm_1389_03">↑</a> (२०९)</li> <li id="foot_krm_1389_04"><a href="#ref_krm_1389_04">↑</a> [[६। केन जलेन रम्भ्यते = मिश्रीक्रियते इति करम्भः = दधिसक्तवः। ‘अकर्तरि च कारके --’ (३-३-१९) इति घञ्। धातूनामनेकार्थत्वात् मिश्रीकरणार्थेऽत्र वृत्तिः। ‘ज्योत्स्नाकरम्भमुदरम्भरयश्चकोराः।।’ इति मुरारिः (अनर्घराघवे २-८३)।]]</li> <li id="foot_krm_1389_05"><a href="#ref_krm_1389_05">↑</a> [[आ। ‘प्रचीभ्यरेफैः पशवोऽम्भसां निधिप्ररम्भणस्तम्भिभिरागता व्रजम्।’ धा। का। १-५०।]]</li> <li id="foot_krm_1389_06"><a href="#ref_krm_1389_06">↑</a> [पृष्ठम्११०४+ २९]</li></ul></p>

