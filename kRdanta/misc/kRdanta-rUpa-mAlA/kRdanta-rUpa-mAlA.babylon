<ul><li><sup id="ref_krm_1226_01"><a href="#foot_krm_1226_01">1</a></sup> {@“मदी हर्षग्लेपनयोः”@} <sup id="ref_krm_1226_02"><a href="#foot_krm_1226_02">2</a></sup> शमादिः, घटादिश्च। </li> <li>‘ग्लेपनम् = दैन्यम्’ इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>‘ग्लपने’ इति क्षीरतरङ्गिण्यां पाठः। </li> <li>‘स्तुत्यादौ मन्दते, हर्षे माद्येत्, मादयते णिचि।।’ <sup id="ref_krm_1226_03"><a href="#foot_krm_1226_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_1226_04"><a href="#foot_krm_1226_04">4</a></sup> मादकः-दिका, <sup id="ref_krm_1226_05"><a href="#foot_krm_1226_05">5</a></sup>, मादकः <sup id="ref_krm_1226_06"><a href="#foot_krm_1226_06">6</a></sup> इत्यादिषु मित्त्वं नेति ज्ञेयम्।]] मदकः-निमादकः-मादकः-दिका, मिमदिषकः-षिका, मामदकः-दिका;</li> <li>  मदिता-त्री, मदयिता-त्री, मिमदिषिता-त्री, मामदिता-त्री;</li> <li>  <sup id="ref_krm_1226_07"><a href="#foot_krm_1226_07">7</a></sup> माद्यन्-न्ती, मदयन्-न्ती, मिमदिषन्-न्ती;</li> <li>  -- मदिष्यन्-न्ती-ती, मदयिष्यन्-न्ती-ती, मिमदिषिष्यन्-न्ती-ती;</li> <li>  -- -- मदयमानः, मदयिष्यमाणः, --मामद्यमानः, मामदिष्यमाणः;</li> <li>  सुमत्-सुमद्-सुमदौ-सुमदः;</li> <li>  -- -- -- <sup id="ref_krm_1226_08"><a href="#foot_krm_1226_08">8</a></sup> मत्तम्-मत्तः-मत्तवान्, मदितः, मिमदिषितः, मामदितः-तवान्;</li> <li>  मदः, <sup id="ref_krm_1226_09"><a href="#foot_krm_1226_09">9</a></sup> प्रमद्वरः, <sup id="ref_krm_1226_10"><a href="#foot_krm_1226_10">10</a></sup> प्रमादी, <sup id="ref_krm_1226_11"><a href="#foot_krm_1226_11">11</a></sup> इरम्मदः <sup id="ref_krm_1226_12"><a href="#foot_krm_1226_12">12</a></sup>, <sup id="ref_krm_1226_13"><a href="#foot_krm_1226_13">13</a></sup> उन्मदिष्णुः <sup id="ref_krm_1226_14"><a href="#foot_krm_1226_14">14</a></sup>, मदः, <sup id="ref_krm_1226_15"><a href="#foot_krm_1226_15">15</a></sup> मदनः, मिमदिषुः, मामदः;</li> <li>  मदितव्यम्, मदयितव्यम्, मिमदिषितव्यम्, मामदितव्यम्;</li> <li>  <sup id="ref_krm_1226_16"><a href="#foot_krm_1226_16">16</a></sup> मदनीयम्, मदनीयम्, मिमदिषणीयम्, मामदनीयम्;</li> <li>  माद्यम्- <sup id="ref_krm_1226_17"><a href="#foot_krm_1226_17">17</a></sup> मद्यम्, मद्यम्, मिमदिष्यम्, मामद्यम्;</li> <li>  ईषन्मदः-दुर्मदः-सुमदः;</li> <li>  -- -- -- मद्यमानः, मद्यमानः, मिमदिष्यमाणः, मामद्यमानः;</li> <li>  मादः, <sup id="ref_krm_1226_18"><a href="#foot_krm_1226_18">18</a></sup> विद्यामदः-धनमदः, कुलमदः, <sup id="ref_krm_1226_19"><a href="#foot_krm_1226_19">19</a></sup> <sup id="ref_krm_1226_20"><a href="#foot_krm_1226_20">20</a></sup> प्रमदः, <sup id="ref_krm_1226_21"><a href="#foot_krm_1226_21">21</a></sup> सम्मदः, प्रमादः-सम्मादः-उन्मादः-विमादः, मदः, मिमदिषः, मामदः;</li> <li>  मदितुम्, मदयितुम्, मिमदिषितुम्, मामदितुम्;</li> <li>  मत्तिः, मदना, मिमदिषा, मामदा;</li> <li>  मदनम्, मदनम्, मिमदिषणम्, मामदनम्;</li> <li>  मदित्वा, <sup id="ref_krm_1226_22"><a href="#foot_krm_1226_22">22</a></sup> मदयित्वा, मिमदिषित्वा, मामदित्वा;</li> <li>  प्रमद्य, प्रमदय्य, प्रमिमदिष्य, प्रमामद्य;</li> <li>  मादम् २, मदित्वा २, <sup id="ref_krm_1226_23"><a href="#foot_krm_1226_23">23</a></sup> मादम् २ -मदम् २, <sup id="ref_krm_1226_24"><a href="#foot_krm_1226_24">24</a></sup> मदयित्वा २, मिमदिषम् २, मिमदिषित्वा २, मामदम् २;</li> <li>  मामदित्वा २;</li> <li>  <sup id="ref_krm_1226_25"><a href="#foot_krm_1226_25">25</a></sup> इति ण्यन्तात् इत्नुच्प्रत्यये रूपमेवम्। </li> <li>मदयित्नुः = मदिरा।]] मदयित्नुः, <sup id="ref_krm_1226_26"><a href="#foot_krm_1226_26">26</a></sup> इत्यादिना किरच्प्रत्यये रूपमेवम्। </li> <li>माद्यन्तेऽ- नयेति मदिरा = सुरा।]] मदिरा, <sup id="ref_krm_1226_27"><a href="#foot_krm_1226_27">27</a></sup> मत्सरः, <sup id="ref_krm_1226_28"><a href="#foot_krm_1226_28">28</a></sup> मत्स्यः-मत्सी। </li> <li><sup id="ref_krm_1226_29"><a href="#foot_krm_1226_29">29</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1226_01"><a href="#ref_krm_1226_01">↑</a> (१२१६)</li> <li id="foot_krm_1226_02"><a href="#ref_krm_1226_02">↑</a> (४-दिवादिः-[८१५] १२०८। अक। सेट्। पर।)</li> <li id="foot_krm_1226_03"><a href="#ref_krm_1226_03">↑</a> (श्लो। ११२)</li> <li id="foot_krm_1226_04"><a href="#ref_krm_1226_04">↑</a> [पृष्ठम्०९९६+ २८]</li> <li id="foot_krm_1226_05"><a href="#ref_krm_1226_05">↑</a> [[१। ‘घटादयो मितः’ (ग। सू। भ्वादौ) इति मित्त्वात् ‘मितां ह्रस्वः’ (६-४-९२) इति णौ उपधाया ह्रस्वो भवति। एवं ण्यन्ते सर्वत्र ज्ञेयम्। ‘मदी हर्षे’ इति दिवादिषु पठितस्यैव धातोर्मित्त्वार्थं घटादिषु (भ्वादौ) अनुवादः। तेन हर्षग्लेपन- रूपार्थविशेष एव घटादिपाठात् मित्त्वेन मदकः इत्यादीनि ण्यन्ते रूपाणीति ज्ञेयम्। अन्यत्रार्थेषु निमादकः [= अक्षरव्यञ्जनानां स्पष्टमुच्चारयिता]</li> <li id="foot_krm_1226_06"><a href="#ref_krm_1226_06">↑</a> [= चित्तविकारोत्पादयिता]</li> <li id="foot_krm_1226_07"><a href="#ref_krm_1226_07">↑</a> [[२। श्यनि, ‘शमामष्टानाम्--’ (७-३-७४) इति दीर्घे रूपमेवम्।]]</li> <li id="foot_krm_1226_08"><a href="#ref_krm_1226_08">↑</a> [[३। ‘श्वीदितो निष्ठायाम्’ (७-२-१४) इति निष्ठायामिण्निषेधे ‘न ध्याख्यापॄमूर्च्छि- मदाम्’ (८-२-५७) इति निष्ठानत्वनिषेधे च रूपमेवम्।]]</li> <li id="foot_krm_1226_09"><a href="#ref_krm_1226_09">↑</a> [[४। ‘स्थेशभास-’ (३-२-१७५) इत्यत्र “प्रमद्वरोऽपि इति केचित्।” इति प्रक्रियाकौमुदी।]]</li> <li id="foot_krm_1226_10"><a href="#ref_krm_1226_10">↑</a> [[५। ‘शमित्यष्टाभ्यः--’ (३-२-१४१) इति ताच्छील्ये घिनुण्प्रत्यये रूपमेवम्।]]</li> <li id="foot_krm_1226_11"><a href="#ref_krm_1226_11">↑</a> [[६। इरया माद्यतीति इरम्मदः = मेघज्योतिः। इरा = उदकम्। ‘उग्रम्पश्येरम्मद- पाणिन्धमाश्च’ (३-२-३७) इति कर्तरि तृजाद्यपवादतया खश् निपात्यते। निपातना- देव श्यन् न। ‘इरया = वारिणा माद्यन् वैद्युताग्निरिरम्मदः।’ इति प्र। सर्वस्वे।]]</li> <li id="foot_krm_1226_12"><a href="#ref_krm_1226_12">↑</a> [[आ। ‘इरम्मदं ज्योतिरमुञ्चदब्भ्रं शनैश्शनैः प्रावृषिकं ररास।।’ वा। वि। ३। ६।]]</li> <li id="foot_krm_1226_13"><a href="#ref_krm_1226_13">↑</a> [[७। ‘अलंकृञ्निराकृञ्प्रजनोत्पचोत्पतोन्मद--’ (३-२-१३६) इत्यादिना तच्छीलादिषु कर्तृषु इष्णुच्प्रत्ययः।]]</li> <li id="foot_krm_1226_14"><a href="#ref_krm_1226_14">↑</a> [[B। ‘व्यालद्विपा यन्तृभिरुन्मदिष्णवः कथंचिदारादपथेन निन्यिरे।।’ शि। व। १२। २८।]]</li> <li id="foot_krm_1226_15"><a href="#ref_krm_1226_15">↑</a> [[८। ण्यन्तात् ‘नन्दिग्रहि--’ (३-१-१३४) इति नन्द्यादित्वात् कर्तरि ल्युप्रत्यये रूपमेवम्। मदयतीति मदनः।]]</li> <li id="foot_krm_1226_16"><a href="#ref_krm_1226_16">↑</a> [पृष्ठम्०९९७+ ३२]</li> <li id="foot_krm_1226_17"><a href="#ref_krm_1226_17">↑</a> [[१। “मदसाधनम्--मद्यम्। बाहुलकात् करणे यत्।” इति प्र। सर्वस्वे।]]</li> <li id="foot_krm_1226_18"><a href="#ref_krm_1226_18">↑</a> [[२। ‘मदोऽनुपसर्गे’ (३-३-६७) इति अनुपसर्गेऽप्प्रत्ययः। घञोऽपवादः। कुलमदः, धनमदः, इत्यादिषु चैवं ज्ञेयम्।]]</li> <li id="foot_krm_1226_19"><a href="#ref_krm_1226_19">↑</a> [कन्यानाम्]</li> <li id="foot_krm_1226_20"><a href="#ref_krm_1226_20">↑</a> [[३। ‘प्रमदसम्मदौ हर्षे’ (३-३-६८) इति हर्षेऽभिधेये एतौ शब्दौ निपात्येते। हर्षादन्यत्र, उपसर्गे च प्रमादः, संमादः इत्यादिषु घञ् इति ज्ञेयम्। ‘सध माद- स्थयोश्छन्दसि’ (६-३-९६) इत्यत्र माद इति निर्देशबलात् केवलादप्यस्माद्- धातोर्घञ् भवतीति ज्ञेयम्।]]</li> <li id="foot_krm_1226_21"><a href="#ref_krm_1226_21">↑</a> [कोकिलानाम्]</li> <li id="foot_krm_1226_22"><a href="#ref_krm_1226_22">↑</a> [[आ। ‘कपितोयनिधीन् प्लवङ्गमेन्दुर्मदयित्वा मधुरेण दर्शनेन।’ भ। का। १०। २८।]]</li> <li id="foot_krm_1226_23"><a href="#ref_krm_1226_23">↑</a> [[४। घटादिषु पाठसामर्थ्यात् ‘चिण्णमुलोः--’ (६-४-९३) इति णौ परतः दीर्घो विकल्पेन भवति। तेन रूपद्वयं ज्ञेयम्।]]</li> <li id="foot_krm_1226_24"><a href="#ref_krm_1226_24">↑</a> [[आ। ‘कपितोयनिधीन् प्लवङ्गमेन्दुर्मदयित्वा मधुरेण दर्शनेन।’ भ। का। १०। २८।]]</li> <li id="foot_krm_1226_25"><a href="#ref_krm_1226_25">↑</a> [[५। ‘स्तनिहृषिपुषिगदिमदि--’ [द। उ। १-१४०]</li> <li id="foot_krm_1226_26"><a href="#ref_krm_1226_26">↑</a> [[६। ‘इषिमदि--’ [द। उ। ८-२६]</li> <li id="foot_krm_1226_27"><a href="#ref_krm_1226_27">↑</a> [[७। ‘कृधूमदिभ्यः कित्’ (द। उ। ८-५३) इति सरन्प्रत्ययः, तस्य च कित्त्वम्। माद्यत्यसौ परव्यसनैरिति मत्सरः = ईर्ष्या।]]</li> <li id="foot_krm_1226_28"><a href="#ref_krm_1226_28">↑</a> [[८। ‘ऋतन्यञ्चि--’ (द। उ। १०-१२) इत्यादिना स्यन्प्रत्यये रूपमेवम्। माद्यत्युदकं प्राप्य इति मत्स्यः। स्त्रियाम् गौरादिपाठात् (४-१-४१) ङीष्। ‘मत्स्यस्य ङ्याम्--’ (वा। ६-४-१४९) इति यकारलोपः।]]</li> <li id="foot_krm_1226_29"><a href="#ref_krm_1226_29">↑</a> [पृष्ठम्०९९८+ २७]</li></ul></p>

मन|मानकः-निका|मिमंसकः-सिका|मम्मनकः-मंमनकः-निका|मन्ता-त्री|मानयिता-त्री|मिमंसिता-त्री|मम्मनिता-मंमनिता-त्री|-|मानयन्-न्ती|मानयिष्यन्-न्ती-ती|-मन्यमानः|मानयमानः|मिमंसमानः|मंमन्यमानः|मंस्यमानः|मानयिष्यमाणः|मिमंसिष्यमाणः|मंमनिष्यमाणः|सुमत्-सुमतौ-सुमतः|हरिमत्|मतम्-राज्ञां|मतः-मतवान्|मानितः|मिमंसितः|मंमनितः-तवान्|भट्टिकाव्येऽपिश्रियम्मन्यपदस्य|प्रयुक्तत्वात्|नागेशपक्ष|एव|ज्यायानिति|भाति।]]|श्रिमन्यं|उपकुम्भम्मन्यः|श्रियम्मन्या|श्रीमन्मन्यः|रजनिम्मन्यः|साधुम्मन्यः|पटुमानिनी|मेनका|मानः|मिमंसुः|मम्मनः|मन्तव्यम्|मानयितव्यम्|मिमंसितव्यम्|मम्मनितव्यम्|मननीयम्|माननीयम्|मिमंसनीयम्|मम्मननीयम्|मान्यम्|मिमंस्यम्|मम्मन्यम्|ईषन्मनः-दुर्मनः-सुमनः|मन्यमानः|मान्यमानः|मिमंस्यमानः|मम्मन्यमानः|मिमंसः|मन्तुम्|मानयितुम्|मिमंसितुम्|मम्मनितुम्|मन्या|सुमत्|मतिः|मन्तिः|अनुमतिः|मानना|मिमंसा|मम्मना|मननम्|माननम्|मिमंसनम्|मम्मननम्|मत्वा|मानयित्वा|मिमंसित्वा|मम्मनित्वा|अनुमत्य|अनुमान्य|अनुमिमंस्य|अनुमम्मन्य|मानम्|मिमंसम्|मम्मनम्
<ul><li><sup id="ref_krm_1227_01"><a href="#foot_krm_1227_01">1</a></sup> {@“मन ज्ञाने”@} <sup id="ref_krm_1227_02"><a href="#foot_krm_1227_02">2</a></sup> ‘स्तम्भे मानयते, ज्ञाने मन्यते मनुते पदम्।। </li> <li>पूजायाम् मानयेन्मानेत्, यौ मीमांसेत तङ्सनोः।’ <sup id="ref_krm_1227_03"><a href="#foot_krm_1227_03">3</a></sup> इति देवः। </li> <li>मानकः-निका, मानकः-निका, <sup id="ref_krm_1227_04"><a href="#foot_krm_1227_04">4</a></sup> मिमंसकः-सिका, <sup id="ref_krm_1227_05"><a href="#foot_krm_1227_05">5</a></sup> मम्मनकः-मंमनकः-निका;</li> <li>  मन्ता-त्री, मानयिता-त्री, मिमंसिता-त्री, मम्मनिता-मंमनिता-त्री;</li> <li>  -- मानयन्-न्ती, मानयिष्यन्-न्ती-ती;</li> <li>  -- -- <sup id="ref_krm_1227_06"><a href="#foot_krm_1227_06">6</a></sup> मन्यमानः, मानयमानः, मिमंसमानः, मंमन्यमानः;</li> <li>  मंस्यमानः, मानयिष्यमाणः, मिमंसिष्यमाणः, मंमनिष्यमाणः;</li> <li>  <sup id="ref_krm_1227_07"><a href="#foot_krm_1227_07">7</a></sup> सुमत्-सुमतौ-सुमतः, हरिमत्;</li> <li>  -- -- मतम्- <sup id="ref_krm_1227_08"><a href="#foot_krm_1227_08">8</a></sup> राज्ञां मतः-मतवान्, मानितः, मिमंसितः, मंमनितः-तवान्;</li> <li>  मनः, <sup id="ref_krm_1227_09"><a href="#foot_krm_1227_09">9</a></sup> दर्शनीयमानी <sup id="ref_krm_1227_10"><a href="#foot_krm_1227_10">10</a></sup>, <sup id="ref_krm_1227_11"><a href="#foot_krm_1227_11">11</a></sup> पण्डितम्मन्यः <sup id="ref_krm_1227_12"><a href="#foot_krm_1227_12">12</a></sup> -पण्डितमानी, <sup id="ref_krm_1227_13"><a href="#foot_krm_1227_13">13</a></sup> <sup id="ref_krm_1227_14"><a href="#foot_krm_1227_14">14</a></sup> शूरमानी, <sup id="ref_krm_1227_15"><a href="#foot_krm_1227_15">15</a></sup> कालिम्मन्या, <sup id="ref_krm_1227_16"><a href="#foot_krm_1227_16">16</a></sup> दिवामन्या-दोषामन्यम्, <sup id="ref_krm_1227_17"><a href="#foot_krm_1227_17">17</a></sup> गाम्मन्यः, <sup id="ref_krm_1227_18"><a href="#foot_krm_1227_18">18</a></sup> स्त्रियम्मन्यः-स्त्रींम्मन्यः, <sup id="ref_krm_1227_19"><a href="#foot_krm_1227_19">19</a></sup> नरम्मन्यः, <sup id="ref_krm_1227_20"><a href="#foot_krm_1227_20">20</a></sup> भुवम्मन्यः, <sup id="ref_krm_1227_21"><a href="#foot_krm_1227_21">21</a></sup> इत्येव न्याय्यम् इति ‘इच एकाचः--’ <sup id="ref_krm_1227_22"><a href="#foot_krm_1227_22">22</a></sup> इति सूत्रभाष्यवाक्यम् ‘तस्मात् श्रिमन्य- मित्येव भवितव्यम्।’ इत्याकारकमवलम्ब्य सिद्धान्तकौमुद्यामुक्तम्। </li> <li>प्रकृतसूत्रे उद्द्योते नागेशभट्टैस्तु उपात्तभाष्यवाक्यस्य एकदेश्युक्तित्वं प्रसाध्य, श्रियम्मन्यम् इत्येव प्रामाणिकं रूपमिति स्थापितम्। </li> <li>भट्टिकाव्येऽपि <sup id="ref_krm_1227_23"><a href="#foot_krm_1227_23">23</a></sup> श्रियम्मन्यपदस्य प्रयुक्तत्वात् नागेशपक्ष एव ज्यायानिति भाति।]] श्रिमन्यं <sup id="ref_krm_1227_24"><a href="#foot_krm_1227_24">24</a></sup>, <sup id="ref_krm_1227_25"><a href="#foot_krm_1227_25">25</a></sup> उपकुम्भम्मन्यः, <sup id="ref_krm_1227_26"><a href="#foot_krm_1227_26">26</a></sup> श्रियम्मन्या, श्रीमन्मन्यः, रजनिम्मन्यः, <sup id="ref_krm_1227_27"><a href="#foot_krm_1227_27">27</a></sup> साधुम्मन्यः, <sup id="ref_krm_1227_28"><a href="#foot_krm_1227_28">28</a></sup> पटुमानिनी, <sup id="ref_krm_1227_29"><a href="#foot_krm_1227_29">29</a></sup> मेनका, मानः, मिमंसुः, मम्मनः;</li> <li>  मन्तव्यम्, मानयितव्यम्, मिमंसितव्यम्, मम्मनितव्यम्;</li> <li>  मननीयम्, माननीयम्, मिमंसनीयम्, मम्मननीयम्;</li> <li>  मान्यम्, मान्यम्, मिमंस्यम्, मम्मन्यम्;</li> <li>  ईषन्मनः-दुर्मनः-सुमनः;</li> <li>  -- -- मन्यमानः, मान्यमानः, मिमंस्यमानः, मम्मन्यमानः;</li> <li>  मानः, मानः, मिमंसः, मम्मनः;</li> <li>  मन्तुम्, मानयितुम्, मिमंसितुम्, मम्मनितुम्;</li> <li>  <sup id="ref_krm_1227_30"><a href="#foot_krm_1227_30">30</a></sup> मन्या, <sup id="ref_krm_1227_31"><a href="#foot_krm_1227_31">31</a></sup> सुमत्, मतिः, <sup id="ref_krm_1227_32"><a href="#foot_krm_1227_32">32</a></sup> मन्तिः, अनुमतिः, मानना, मिमंसा, मम्मना;</li> <li>  मननम्, माननम्, मिमंसनम्, मम्मननम्;</li> <li>  मत्वा;</li> <li>  मानयित्वा, मिमंसित्वा, मम्मनित्वा;</li> <li>  अनुमत्य, अनुमान्य, अनुमिमंस्य, अनुमम्मन्य;</li> <li>  <sup id="ref_krm_1227_33"><a href="#foot_krm_1227_33">33</a></sup> मानम् २, मत्वा २, मानम् २, मानयित्वा २, मिमंसम् २, मिमंसित्वा २, मम्मनम् २;</li> <li>  मम्मनित्वा २;</li> <li>  <sup id="ref_krm_1227_34"><a href="#foot_krm_1227_34">34</a></sup> मुनिः, <sup id="ref_krm_1227_35"><a href="#foot_krm_1227_35">35</a></sup> मनुः-मनुष्यः-मनुषी, <sup id="ref_krm_1227_36"><a href="#foot_krm_1227_36">36</a></sup> मन्तुः, <sup id="ref_krm_1227_37"><a href="#foot_krm_1227_37">37</a></sup> मन्युः, <sup id="ref_krm_1227_38"><a href="#foot_krm_1227_38">38</a></sup> मन्त्रः, <sup id="ref_krm_1227_39"><a href="#foot_krm_1227_39">39</a></sup> मठरः, <sup id="ref_krm_1227_40"><a href="#foot_krm_1227_40">40</a></sup> मांसम्, <sup id="ref_krm_1227_41"><a href="#foot_krm_1227_41">41</a></sup> मधु, <sup id="ref_krm_1227_42"><a href="#foot_krm_1227_42">42</a></sup> मनः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1227_01"><a href="#ref_krm_1227_01">↑</a> (१२१७)</li> <li id="foot_krm_1227_02"><a href="#ref_krm_1227_02">↑</a> (४-दिवादिः-११७६। सक। अनि। आत्म।)</li> <li id="foot_krm_1227_03"><a href="#ref_krm_1227_03">↑</a> (श्लो। १२५-१२६)</li> <li id="foot_krm_1227_04"><a href="#ref_krm_1227_04">↑</a> [[१। सन्नन्तात् ण्वुलि, द्विर्वचनादिकेषु कृतेषु ‘नश्चापदान्तस्य झलि’ (८-३-२४) इत्यनेन धातुनकारस्यानुस्वारे रूपमेवम्। एवमेव सन्नन्ते सर्वत्र प्रक्रिया ज्ञेया।]]</li> <li id="foot_krm_1227_05"><a href="#ref_krm_1227_05">↑</a> [[२। यङन्ते सर्वत्र द्विर्वंचनादिकेषु कृतेषु, अभ्यासे, ‘नुगतोऽनुनासिकान्तस्य’ (७-४-८५) इति नुगागमः, तस्य च पदान्तवद्भाववचनात् परसवर्णविकल्पः। तेन रूपद्वयम्।]]</li> <li id="foot_krm_1227_06"><a href="#ref_krm_1227_06">↑</a> [[३। शतरि, दिवादित्वात् शपोऽपवादः श्यन्प्रत्ययोऽत्रेति ज्ञेयम्।]]</li> <li id="foot_krm_1227_07"><a href="#ref_krm_1227_07">↑</a> [[४। क्विपि, ‘अनुदात्तोपदेशवनतितनोत्यादीनामनुनासिकलोपो झलि क्ङिति’ (६-४-३७) इत्यनुनासिकलोपः। ‘ह्रस्वस्य पिति कृति--’ (६-१-७१) इति तुक्।]]</li> <li id="foot_krm_1227_08"><a href="#ref_krm_1227_08">↑</a> [[५। अनुदात्तोपदेशत्वादस्य धातोर्निष्ठायामनुनासिकलोपे, रूपाण्यूह्यानि। राज्ञां मतः इत्यत्र ‘मतिबुद्धिपूजार्थेभ्यः--’ (३-२-१८८) इति बुद्ध्यर्थकत्वादस्य वर्तमाने कर्तरि क्तः। ‘क्तस्य च वर्तमाने’ (२-३-६७) इति कर्तरि षष्ठी।]]</li> <li id="foot_krm_1227_09"><a href="#ref_krm_1227_09">↑</a> [[६। दर्शनीयां मन्यते इत्यर्थे कर्मण्युपपदे ‘मनः’ (३-२-८२) इत्यनेनात्र णिनिः। ‘भार्यायाः’ इत्यत्र कर्मणि षष्ठी। भार्याशब्दसापेक्षस्यापि दर्शनीयशब्दस्य गमकत्वात् समासः। ‘क्यङ्मानिनोश्च’ (६-३-३६) इत्यनेन मानिन्शब्द उत्तरपदे दर्शनीयाशब्दस्य पुंवद्भावः।]]</li> <li id="foot_krm_1227_10"><a href="#ref_krm_1227_10">↑</a> [भार्यायाः]</li> <li id="foot_krm_1227_11"><a href="#ref_krm_1227_11">↑</a> [[७। पण्डितमात्मानं मन्यते इत्यर्थे, ‘आत्ममाने खश् च’ (३-२-८३) इति पाक्षिकः खश्। पक्षे णिनिः। खशः शित्त्वात् विकरणप्रत्ययः श्यन्प्रवृत्तः। ‘अरुर्द्विषद- जन्तस्य--’ (६-३-६७) इति पूर्वपदस्य मुम्।]]</li> <li id="foot_krm_1227_12"><a href="#ref_krm_1227_12">↑</a> [[आ। ‘अखण्ड्यमानं परिखण्ड्य शक्रं त्वं पण्डितंमन्यमुदीर्णदण्डः।’ भ। का। १२। १७।]]</li> <li id="foot_krm_1227_13"><a href="#ref_krm_1227_13">↑</a> [पृष्ठम्०९९९+ ३५]</li> <li id="foot_krm_1227_14"><a href="#ref_krm_1227_14">↑</a> [[आ। ‘राममुच्चैरुपालब्ध शूरमानी कपिप्रभुः। व्रणवेदनया ग्लायन् साधुम्मन्यमसाधुवत्।।’ भ। का। ६। १२८।]]</li> <li id="foot_krm_1227_15"><a href="#ref_krm_1227_15">↑</a> [[१। कालीमात्मानं मन्यते इत्यर्थे खश्प्रत्यये, श्यनि च कृते, ‘स्त्रियाः पुंवत्--’ (६-३-३४) इति प्राप्तं पुंवद्भावं परत्वाद् बाधित्वा, ‘खित्यनव्ययस्य’ (६-३-६६) इति ह्रस्वः। तेन कालिम्मन्या इति सिद्ध्यति।]]</li> <li id="foot_krm_1227_16"><a href="#ref_krm_1227_16">↑</a> [[२। ‘दिवा’ इत्यधिकरणशक्तिप्रधानमव्ययम्। एवम्भूतस्याप्यस्य वृत्तिविषये कर्मत्वं बोध्यम्। तेन दिवा मन्यते इत्यर्थेऽत्र खशि, अव्ययत्वादुपपदस्य मुम्, ह्रस्वश्च नेति ज्ञेयम्। एवमेव दोषामत्त्यम् इत्यत्रापि ज्ञेयम्।]]</li> <li id="foot_krm_1227_17"><a href="#ref_krm_1227_17">↑</a> [[३। अत्रापि पूर्ववत् गाम् आत्मानं मन्यते इत्यर्थे खशि, ‘इच एकाचोऽम्प्रत्ययवच्च’ (६-३-६८) इत्यनेन खिदन्ते परे एकाचः पूर्वपदस्य ‘गो’ इत्यस्य अम् इत्यागमो भवति, स च ‘--प्रत्ययवच्च’ (६-३-६८) इति वचनात् स्वादिप्रत्ययवद् भवति। तेन ‘औतोऽम्शसोः’ (६-१-९३) इत्यनेन प्रत्ययाश्रित आकारोऽत्र भवति। तेन गाम्मन्यः इति रूपं सिद्ध्यति।]]</li> <li id="foot_krm_1227_18"><a href="#ref_krm_1227_18">↑</a> [[४। स्त्रियमात्मानं मन्यते इत्यर्थे खशि, पूर्ववत् ‘इच एकाचः--’ (६-३-६८) इति अमागमे, ‘वाऽम्शसोः’ (६-४-८०) इति विकल्पेन इयङ्। इयङ्पक्षे स्त्रियम्मन्यः, इति रूपम्। इयङभावपक्षे ‘अमि पूर्वः’ (६-१-१०७) इति पूर्वरूपे स्त्रीम्मन्यः इति रूपम्।]]</li> <li id="foot_krm_1227_19"><a href="#ref_krm_1227_19">↑</a> [[५। नरं आत्मानं मन्यते इत्यर्थे खशि, अमागमे, ‘ऋतो ङिसर्वनामस्थानयोः’ (७-३-११०) इति गुणे नरम्मन्यः इति रूपम्। अत्र ‘--प्रत्ययवच्च’ (६-३-६८) इति वचनात् मुमपवादतया प्रवृत्तस्यामः प्रत्ययत्वम्। प्रत्ययत्वादेव सर्वनामस्थान- संज्ञा, तदाश्रितो गुणश्चात्रेति ज्ञेयम्।]]</li> <li id="foot_krm_1227_20"><a href="#ref_krm_1227_20">↑</a> [[६। भुवमात्मानं मन्यते इत्यर्थे खशि, अमि, ‘अचि श्नुधातु--’ (६-४-७७) इत्यादिना उवङत्रेति ज्ञेयम्।]]</li> <li id="foot_krm_1227_21"><a href="#ref_krm_1227_21">↑</a> [[७। श्रियमात्मानं मन्यते इत्यत्र श्रिमन्यं [ब्राह्मणकुलम्]</li> <li id="foot_krm_1227_22"><a href="#ref_krm_1227_22">↑</a> (६-३-६८)</li> <li id="foot_krm_1227_23"><a href="#ref_krm_1227_23">↑</a> (५-७१)</li> <li id="foot_krm_1227_24"><a href="#ref_krm_1227_24">↑</a> [कुलम्]</li> <li id="foot_krm_1227_25"><a href="#ref_krm_1227_25">↑</a> [[८। कुम्भस्य समीपे उपकुम्भम्। ‘अव्ययं विभक्ति--’ (२-१-६) इत्यादिना सामीप्ये अव्ययीभावसमासे, ‘अव्ययीभावश्च’ (१-१-४१) इत्यनेन अव्ययी- भावसमासस्याव्ययत्वम्। ‘अव्ययीभावस्याव्ययत्वे प्रयोजनं लुङ्मुखस्वरोपचाराः’ (वा। १-१-४१) इति वचनात् उपकुम्भमात्मानं मन्यते इत्यर्थेऽव्ययत्वाभावात् मुमागमोऽत्रेति ज्ञेयम्। स्पष्टमिदं प्रकृतसूत्रे (१-१-४१) भाष्यादौ।]]</li> <li id="foot_krm_1227_26"><a href="#ref_krm_1227_26">↑</a> [[B। ‘मिथ्यैव श्रीः श्रियम्मन्या क्षीमन्मन्यो मृषा हरिः।’ भ। का। ५। ७१।]]</li> <li id="foot_krm_1227_27"><a href="#ref_krm_1227_27">↑</a> [पृष्ठम्१०००+ ३०]</li> <li id="foot_krm_1227_28"><a href="#ref_krm_1227_28">↑</a> [[१। पट्वीमात्मानं मन्यते इत्यर्थे, पाक्षिके णिनिप्रत्यये ‘स्त्रियाः पुंवत्--’ (६-३-३४) इति पुंवद्भावे रूपमेवम्। पक्षे पटुम्मन्या इत्यपि भवति।]]</li> <li id="foot_krm_1227_29"><a href="#ref_krm_1227_29">↑</a> [[२। ‘आशिषि च’ (३-१-१५०) इति वुन्प्रत्यये, ‘प्रत्ययस्थात्--’ (७-३-४४) इति प्राप्तस्येत्वस्य ‘आशिषि वुनश्च न’ (वा। ७-३-४५) इति निषेधः। ‘आशीरर्थेऽके मनेः एत्वं वाच्यम्’ इति वचनेन एकारः इति प्र। कौमुद्यामुक्तम्। मेनका = अप्सरोविशेषः।]]</li> <li id="foot_krm_1227_30"><a href="#ref_krm_1227_30">↑</a> [[३। स्त्रियाम्, ‘संज्ञायां समजनिषदनिपतमन--’ (३-३-९९) इत्यादिना संज्ञायां क्यपि रूपमेवम्। ‘मन्या = गलपार्श्वशिरा (सिरा), मन्यन्तेऽनयेति कृत्वा। तया हि क्रुद्धो ज्ञायते।’ इति पदमञ्जरी। न्यासकारस्तु ‘संज्ञायाम्’ इत्युक्तत्वात् अझलादित्वेऽपि प्रत्ययस्थं कित्त्वमाश्रित्यानुनासिकलोपे तुकि च मत्या इति रूपमनुमेने। ‘मन्या = पश्चाद्ग्रीवासिरा।’ इति मा। धा। वृत्तिः। ‘सुमत्’ इति सम्पदादित्वात् (३-३-९४) क्विपि अनुनासिकलोपे, तुकि च रूपम्। सुमत् = लक्ष्मीः।]]</li> <li id="foot_krm_1227_31"><a href="#ref_krm_1227_31">↑</a> [[आ। ‘पुरोहिताऽमात्यमुखाश्च योधा विवृद्धमन्युप्रतिपूर्णमन्याः।।’ भ। का। ३। २८।]]</li> <li id="foot_krm_1227_32"><a href="#ref_krm_1227_32">↑</a> [[४। क्तिचि रूपमेवम्। ‘न क्तिचि दीर्घश्च’ (६-४-३९) इत्यनेन क्तिचि अनुनासि- कलोपदीर्घयोर्निषेधः। मतिः इत्यत्र तु क्तिनि अनुनासिकलोपो भवत्येव। ‘मन्त्रे वृषेषपचमन--’ (३-३-९६) इत्यनेन मन्त्रे एव मन्यतेः क्तिन्विधानात् लोके न मतिरित्यस्य प्रयोग इति न मन्तव्यम्। उदात्तस्वरार्थं सूत्रस्यास्य (३-३-९६) प्रवृत्तेः।]]</li> <li id="foot_krm_1227_33"><a href="#ref_krm_1227_33">↑</a> [पृष्ठम्१००१+ २७]</li> <li id="foot_krm_1227_34"><a href="#ref_krm_1227_34">↑</a> [[१। ‘मनेरुच्च’ (द। उ। १-५१) इति इन्प्रत्यये अकारस्य उकारादेशे च रूपमेवम्। मुनिः = ऋषिः।]]</li> <li id="foot_krm_1227_35"><a href="#ref_krm_1227_35">↑</a> [[२। औणादिके उप्रत्यये रूपमेवम्। मन्यते मनुते वा मनुः। मनुशब्दात् ‘मनोर्जा- तावञ्यतौ षुक् च’ (४-१-१६१) इति अञ् यत् इत्येतौ प्रत्ययौ भवतः;\n\n  तत्सन्नियोगेन षुगागमश्च। मानुषः, मनुष्यः इति जातिशब्दौ एतौ। स्त्रियाम्, ‘हयगवयमुकयमत्स्यमनुष्याणामप्रतिषेधः’ (वा। ४-१-६३) इति प्रतिप्रसवेन ङीपि, ‘हलस्तद्धितस्य’ (६-४-१५०) इति यलोपे मनुषी इति रूपम्।]]</li> <li id="foot_krm_1227_36"><a href="#ref_krm_1227_36">↑</a> [[३। ‘कमिमनि--’ (द। उ। १-१२५) इति तुप्रत्यये रूपमेवम्। ‘मन्तुः पुंस्यपराधे- ऽपि मनुष्येऽपि प्रजापतौ’ इति मेदिनी इति अमरकोशव्याख्याने (२। २६)।]]</li> <li id="foot_krm_1227_37"><a href="#ref_krm_1227_37">↑</a> [[४। ‘यजिमनि--’ (द। उ। १-१३४) इति युच्प्रत्यये रूपमेवम्। मन्युः = दैन्यम्, यागः, अन्तर्गतः क्रोधश्च।]]</li> <li id="foot_krm_1227_38"><a href="#ref_krm_1227_38">↑</a> [[५। ‘गुधृवीपचिवचियमिमनि--’ (द। उ। ८। ८९) इति त्रप्रत्यये रूपमेवम्। ‘वेदभेदे गुह्यवादे मन्त्रः--’ इति अमरः (३। १६७)।]]</li> <li id="foot_krm_1227_39"><a href="#ref_krm_1227_39">↑</a> [[६। ‘वनिमनिभ्याम्--’ (द। उ। ८। ९९) इति अरप्रत्यये ठकारे चान्तादेशे रूपमेवम्। मठरः = ज्ञानी, गोत्रं च। मूढः इति क्षीरस्वामी।]]</li> <li id="foot_krm_1227_40"><a href="#ref_krm_1227_40">↑</a> [[७। ‘मनेर्दीर्घश्च’ (द। उ। ९। २३) इति सप्रत्यये दीर्घे च रूपमेवम्। मन्यते तदिति मांसम् = पिशितम् इत्यर्थः।]]</li> <li id="foot_krm_1227_41"><a href="#ref_krm_1227_41">↑</a> [[८। ‘फलिपाटिनमिमनि--’ (द। उ। १। १०३) इति उप्रत्यये धकारादेशे च रूपम्। मन्यते तदतिशयेन इति मधु = माध्वी।]]</li> <li id="foot_krm_1227_42"><a href="#ref_krm_1227_42">↑</a> [[९। ‘असुन्’ (द। उ। ९। ४९) इति असुन्प्रत्यये रूपमेवम्।]]</li></ul></p>

मन|मानकः-निका|मिमानयिषकः-षिका|मानयिता-त्री|मिमानयिषिता-त्री
<ul><li><sup id="ref_krm_1228_01"><a href="#foot_krm_1228_01">1</a></sup> {@“मन स्तम्भे”@} <sup id="ref_krm_1228_02"><a href="#foot_krm_1228_02">2</a></sup> आकुस्मीयः। </li> <li>‘स्तम्भः = गर्वः…। </li> <li>पक्षे मनतीति चन्द्रः’ इति क्षीरस्वामी। </li> <li>‘स्तम्भे मानयते, ज्ञाने मन्यते मनुते पदम्।।’ <sup id="ref_krm_1228_03"><a href="#foot_krm_1228_03">3</a></sup> इति देवः। </li> <li>मानकः-निका, मिमानयिषकः-षिका;</li> <li>  मानयिता-त्री, मिमानयिषिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकगालयतिवत् <sup id="ref_krm_1228_04"><a href="#foot_krm_1228_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1228_05"><a href="#foot_krm_1228_05">5</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1228_01"><a href="#ref_krm_1228_01">↑</a> (१२१८)</li> <li id="foot_krm_1228_02"><a href="#ref_krm_1228_02">↑</a> (१०-चुरादिः-१७१०। अक। सेट्। आत्म।)</li> <li id="foot_krm_1228_03"><a href="#ref_krm_1228_03">↑</a> (श्लो। १२५)</li> <li id="foot_krm_1228_04"><a href="#ref_krm_1228_04">↑</a> (३८८)</li> <li id="foot_krm_1228_05"><a href="#ref_krm_1228_05">↑</a> [पृष्ठम्१००२+ ३०]</li></ul></p>

मनु|मानकः-निका|मिमनिषकः-षिका|मम्मनकः-मंमनकः-|निका|मनिता-त्री|मानयिता-त्री|मिमनिषिता-त्री|मम्मनिता-मंमनिता-त्री|क्विपिहरिमत्-हरिमतौ-हरिमतः
<ul><li><sup id="ref_krm_1229_01"><a href="#foot_krm_1229_01">1</a></sup> {@“मनु अवबोधने”@} <sup id="ref_krm_1229_02"><a href="#foot_krm_1229_02">2</a></sup> ‘स्तम्भे मानयते, ज्ञाने मन्यते मनुते पदम्।।’ <sup id="ref_krm_1229_03"><a href="#foot_krm_1229_03">3</a></sup> इति देवः। </li> <li>‘--बोधने इति मैत्रेयः।’ इति मा। </li> <li>धा। </li> <li>वृत्तिटीका। </li> <li>मानकः-निका, मानकः-निका, <sup id="ref_krm_1229_04"><a href="#foot_krm_1229_04">4</a></sup> मिमनिषकः-षिका, मम्मनकः-मंमनकः- निका;</li> <li>  मनिता-त्री, मानयिता-त्री, मिमनिषिता-त्री, मम्मनिता-मंमनिता-त्री;</li> <li>  इत्यादीनि सर्वाणि रूपाणि दैवादिकमन्यतिवत् <sup id="ref_krm_1229_05"><a href="#foot_krm_1229_05">5</a></sup> ज्ञेयानि। </li> <li>क्विपि <sup id="ref_krm_1229_06"><a href="#foot_krm_1229_06">6</a></sup> हरिमत्-हरिमतौ-हरिमतः;</li> <li>  <sup id="ref_krm_1229_07"><a href="#foot_krm_1229_07">7</a></sup> मतः-तम्-तवान्, <sup id="ref_krm_1229_08"><a href="#foot_krm_1229_08">8</a></sup> मनितम्-तः-तवान्, <sup id="ref_krm_1229_09"><a href="#foot_krm_1229_09">9</a></sup> मनित्वा-मत्वा, <sup id="ref_krm_1229_10"><a href="#foot_krm_1229_10">10</a></sup> मेनका, <sup id="ref_krm_1229_11"><a href="#foot_krm_1229_11">11</a></sup> अभिमत्य, <sup id="ref_krm_1229_12"><a href="#foot_krm_1229_12">12</a></sup> मन्तिः, <sup id="ref_krm_1229_13"><a href="#foot_krm_1229_13">13</a></sup> मन्वानः इतीमानि रूपाणि अस्य धातोः विशेषेण संभवन्तीति विशेषः। </li> <li><sup id="ref_krm_1229_14"><a href="#foot_krm_1229_14">14</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1229_01"><a href="#ref_krm_1229_01">↑</a> (१२१९)</li> <li id="foot_krm_1229_02"><a href="#ref_krm_1229_02">↑</a> (८-तनादिः-१४७१। सक। सेट्। आत्म।)</li> <li id="foot_krm_1229_03"><a href="#ref_krm_1229_03">↑</a> (श्लो। १२५)</li> <li id="foot_krm_1229_04"><a href="#ref_krm_1229_04">↑</a> [[१। अस्य धातोः सेट्त्वात् सनि रूपमेवम्। एवं सन्नन्ते सर्वत्र बोध्यम्। शुद्धात् तृजादिषु च एवमेव ऊह्यम्।]]</li> <li id="foot_krm_1229_05"><a href="#ref_krm_1229_05">↑</a> (१२१७)</li> <li id="foot_krm_1229_06"><a href="#ref_krm_1229_06">↑</a> [[२। ‘गमः क्वौ’ (६-४-४०) इत्यत्र ‘गमादीनामिति वक्तव्यम्’ इति वचनात् क्विपि अनुनासिकलोपे, ‘ह्रस्वस्य--’ (६-१-७१) इति तुकि च रूपमेवम्।]]</li> <li id="foot_krm_1229_07"><a href="#ref_krm_1229_07">↑</a> [[३। निष्ठायाम्, ‘अनुदात्तोपदेशवनतितनोत्यादीनाम्--’ (६-४-३७) इति अनुनासिकलोपे रूपमेवम्।]]</li> <li id="foot_krm_1229_08"><a href="#ref_krm_1229_08">↑</a> [[४। निष्ठायाम्, ‘यस्य विभाषा’ (७-२-१५) इति निषेधस्यानित्यत्वादिट्। तदनित्यत्वे च, ‘कृती छेदने’ (तु। से। पर।) इतीदित्करणं लिङ्गम्। अन्यथा, ‘सेऽसिचि--’ (७-२-५७) इति वेट्कत्वात् सिद्धे किं तेन?’ इति अमख्याख्यायाम् (१-१०७) प्रतिपादितत्वात् मनितम् इत्यपि साधुरिति ज्ञेयम्। तथा-- ‘बुद्धं बुधितं मनितम्’ इत्यमरः। ‘एवमेव स्वामी’ इति प्र। सर्वस्वे।]]</li> <li id="foot_krm_1229_09"><a href="#ref_krm_1229_09">↑</a> [[५। ‘उदितो वा’ (७-२-५६) इति क्त्वायामिड्विकल्पः। इट्पक्षे मनित्वा। इडभावपक्षे, अनुनासिकलोपे मत्वा इति रूपद्वयं बोध्यम्।]]</li> <li id="foot_krm_1229_10"><a href="#ref_krm_1229_10">↑</a> [[६। ‘आशिषि च’ (३-१-१५०) इति वुन्। ‘नशिमन्योरलिट्येत्वं वक्तव्यम्’ (वा। ६-४-१२०) इति वचनात् एत्वे रूपमेवम्। “--‘मेनका’ इत्यपि भाषायां न प्राप्नोति। यदि तु इष्यते पृषोदरादित्वाद्भविष्यति। … ‘आशिषि चोपसंख्यानम्’ (वा। ७-३-४५) इति इत्वाभावः।” इति प्रकृतसूत्रभाष्ये (६-४-१२०) कैयटे प्रतिपादितम्।]]</li> <li id="foot_krm_1229_11"><a href="#ref_krm_1229_11">↑</a> [[७। ल्यपि, ‘वा ल्यपि’ (६-४-३८) इत्यस्य व्यवस्थितविभाषाश्रयणाद् अत्र नान्तानिटां नित्यम् अनुनासिकलोपः। तेन अभिमत्य इत्येकमेव रूपम्।]]</li> <li id="foot_krm_1229_12"><a href="#ref_krm_1229_12">↑</a> [[८। तनोत्यादित्वात् क्तिचि ‘न क्तिचि दीर्घश्च’ (६-४-३९) इति दीर्घानुनासिकलोप- निषेधे रूपमेवम्।]]</li> <li id="foot_krm_1229_13"><a href="#ref_krm_1229_13">↑</a> [[आ। ‘कंसस्तृणीकृतरिपुः घृणिमान् वताप्तिं मन्वान एकमथ मञ्चमलञ्चकार।।’ धा। का। ३। ४।]]</li> <li id="foot_krm_1229_14"><a href="#ref_krm_1229_14">↑</a> [पृष्ठम्१००३+ २८]</li></ul></p>

मन्थ|मन्थकः-न्थिका|मिमन्थिषकः-षिका|मामथकः-थिका|मन्थिता-त्री|मन्थयिता-त्री|मिमन्थिषिता-त्री|मामथिता-त्री|क्विपि-मत्-|मथ्-मथौ-मथः
<ul><li><sup id="ref_krm_1230_01"><a href="#foot_krm_1230_01">1</a></sup> {@“मन्थ विलोडने”@} <sup id="ref_krm_1230_02"><a href="#foot_krm_1230_02">2</a></sup> <sup id="ref_krm_1230_03"><a href="#foot_krm_1230_03">3</a></sup> “अत्रायं धातुर्यद्यपि क्षीरस्वाम्यादिभिः न पठ्यते, तथापि मैत्रेय-चन्द्र-दुर्गैः पठितत्वात्, ‘शमीगर्भादग्निं मन्थति’, ‘ततो यथा प्राशु मन्थति। </li> <li>यदि मथ्यमानो न जायेत’ इत्यादिदर्शनाच्चास्त्येव।” इति मा। </li> <li>धा। </li> <li>वृत्तिः।]] ‘विलोडनम् = क्षोभणम्’ इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>अयं द्विकर्मकः। </li> <li>‘हिंसासंक्लेशयोर्मन्थेत्, मथेन्मथ्नाति लोडने।’ <sup id="ref_krm_1230_04"><a href="#foot_krm_1230_04">4</a></sup> इति देवः। </li> <li>मन्थकः-न्थिका, मन्थकः-न्थिका, मिमन्थिषकः-षिका, मामथकः-थिका;</li> <li>  मन्थिता-त्री, मन्थयिता-त्री, मिमन्थिषिता-त्री, मामथिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि कुथ्नातिवत् <sup id="ref_krm_1230_05"><a href="#foot_krm_1230_05">5</a></sup> बोध्यानि। </li> <li>क्विपि-मत्- मथ्-मथौ-मथः;</li> <li>  <sup id="ref_krm_1230_06"><a href="#foot_krm_1230_06">6</a></sup> मन्थन्-न्ती, <sup id="ref_krm_1230_07"><a href="#foot_krm_1230_07">7</a></sup> मन्थः, मन्थनम्- <sup id="ref_krm_1230_08"><a href="#foot_krm_1230_08">8</a></sup> मन्थनी, <sup id="ref_krm_1230_09"><a href="#foot_krm_1230_09">9</a></sup> मथित्वा- मन्थित्वा, <sup id="ref_krm_1230_10"><a href="#foot_krm_1230_10">10</a></sup> मन्थानः इमानि रूपाणि अस्य धातोः विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1230_01"><a href="#ref_krm_1230_01">↑</a> (१२२०)</li> <li id="foot_krm_1230_02"><a href="#ref_krm_1230_02">↑</a> (१-भ्वादिः-४२। सक। सेट्। पर।)</li> <li id="foot_krm_1230_03"><a href="#ref_krm_1230_03">↑</a> [[[अ]</li> <li id="foot_krm_1230_04"><a href="#ref_krm_1230_04">↑</a> (श्लो। ९८)</li> <li id="foot_krm_1230_05"><a href="#ref_krm_1230_05">↑</a> (२२३)</li> <li id="foot_krm_1230_06"><a href="#ref_krm_1230_06">↑</a> [[१। अस्य धातोः भ्वादित्वाद् औत्सर्गिके शपि रूपमेवम्।]]</li> <li id="foot_krm_1230_07"><a href="#ref_krm_1230_07">↑</a> [[२। ‘हलश्च’ (३-३-१२१) इति करणे संज्ञायां घञ्।]]</li> <li id="foot_krm_1230_08"><a href="#ref_krm_1230_08">↑</a> [[३। ‘करणाधिकरणयोश्च’ (३-३-११७) इति अधिकरणे ल्युडन्तात् स्त्रियाम्, ‘टिड्ढाणञ्--’ (४-१-१५) इति ङीपि रूपमेवम्।]]</li> <li id="foot_krm_1230_09"><a href="#ref_krm_1230_09">↑</a> [[४। क्त्वायाम्, ‘नोपधात् थफान्ताद्वा’ (१-२-२३) इति कित्त्वविकल्पनात् पक्षे नलोपः। तेन रूपद्वयं ज्ञेयम्।]]</li> <li id="foot_krm_1230_10"><a href="#ref_krm_1230_10">↑</a> [[५। बाहुलकात् आनच्प्रत्यये रूपम्।]]</li></ul></p>

मन्थ|मन्थकः-न्थिका|मिमन्थिषकः-षिका|मामथकः-थिका|मन्थिता-त्री|मन्थयिता-त्री|मिमन्थिषिता-त्री|मामथिता-त्री
<ul><li><sup id="ref_krm_1231_01"><a href="#foot_krm_1231_01">1</a></sup> {@“मन्थ विलोडने”@} <sup id="ref_krm_1231_02"><a href="#foot_krm_1231_02">2</a></sup> ‘--विलोटने’ इति पुरुषकारे <sup id="ref_krm_1231_03"><a href="#foot_krm_1231_03">3</a></sup> पाठः। </li> <li>‘हिंसासंक्लेशयोर्मन्थेत्, मथेन्मथ्नाति लोडने।’ <sup id="ref_krm_1231_04"><a href="#foot_krm_1231_04">4</a></sup> इति देवः। </li> <li>मन्थकः-न्थिका, मन्थकः-न्थिका, मिमन्थिषकः-षिका, मामथकः-थिका;</li> <li>  मन्थिता-त्री, मन्थयिता-त्री, मिमन्थिषिता-त्री, मामथिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि क्रैयादिकग्रथ्नातिवत् <sup id="ref_krm_1231_05"><a href="#foot_krm_1231_05">5</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_1231_06"><a href="#foot_krm_1231_06">6</a></sup> मन्थाः इति रूपं विशेषः। </li> <li><sup id="ref_krm_1231_07"><a href="#foot_krm_1231_07">7</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1231_01"><a href="#ref_krm_1231_01">↑</a> (१२२१)</li> <li id="foot_krm_1231_02"><a href="#ref_krm_1231_02">↑</a> (९-क्र्यादिः-१५११। सक। सेट्। पर।)</li> <li id="foot_krm_1231_03"><a href="#ref_krm_1231_03">↑</a> (श्लो। ९८)</li> <li id="foot_krm_1231_04"><a href="#ref_krm_1231_04">↑</a> (श्लो। ९८)</li> <li id="foot_krm_1231_05"><a href="#ref_krm_1231_05">↑</a> (४३७)</li> <li id="foot_krm_1231_06"><a href="#ref_krm_1231_06">↑</a> [[६। ‘मन्थः’ (द। उ। ६-६२) इति इनिप्रत्ययः किच्च। मथ्नातीति मन्थाः = वायुः, वैशाखः, वज्रश्च। ‘पथिमथि--’ (७-१-८५) इत्याकारे ‘इतोऽत्--’ (७-१-८६) इत्यकारे च प्रथमैकवचने रूपमेवम्। ‘वैशाखो मन्थमन्थानमन्थानो मन्थदण्डके’ इत्यमरः (२। ७४)।]]</li> <li id="foot_krm_1231_07"><a href="#ref_krm_1231_07">↑</a> [पृष्ठम्१००४+ २५]</li></ul></p>

मभ्र|मभ्रकः-भ्रिका|मिमभ्रिषकः-मिमब्भ्रिषकः-षिका|मामभ्रकः-|भ्रिका|मभ्रिता-त्री|मभ्रयिता-त्री|मिमभ्रिषिता-त्री|मामभ्रिता-त्री
<ul><li><sup id="ref_krm_1232_01"><a href="#foot_krm_1232_01">1</a></sup> {@“मभ्र गत्यर्थः”@} <sup id="ref_krm_1232_02"><a href="#foot_krm_1232_02">2</a></sup> मभ्रकः-भ्रिका, मभ्रकः-भ्रिका, मिमभ्रिषकः- <sup id="ref_krm_1232_03"><a href="#foot_krm_1232_03">3</a></sup> मिमब्भ्रिषकः-षिका, मामभ्रकः- भ्रिका;</li> <li>  मभ्रिता-त्री, मभ्रयिता-त्री, मिमभ्रिषिता-त्री, मामभ्रिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककर्बतिवत् <sup id="ref_krm_1232_04"><a href="#foot_krm_1232_04">4</a></sup> बोध्यानि। </li> <li>कर्मणि क्तप्रत्यये- <sup id="ref_krm_1232_05"><a href="#foot_krm_1232_05">5</a></sup> मभ्रितः इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1232_01"><a href="#ref_krm_1232_01">↑</a> (१२२२)</li> <li id="foot_krm_1232_02"><a href="#ref_krm_1232_02">↑</a> (१-भ्वादिः-५५८। सक। सेट्। पर।)</li> <li id="foot_krm_1232_03"><a href="#ref_krm_1232_03">↑</a> [[१। सनि ‘अनचि च’ (८-४-४७) इति भकारस्य पक्षे द्विर्वचने ‘झलां जश् झशि’ (८-४-५३) इति भकारस्य जश्त्वे रूपमेवम्। द्विंर्वचनाभावे मिमभ्रिषकः इति सन्नन्ते सर्वत्र रूपद्वयं बोध्यम्।]]</li> <li id="foot_krm_1232_04"><a href="#ref_krm_1232_04">↑</a> (१७३)</li> <li id="foot_krm_1232_05"><a href="#ref_krm_1232_05">↑</a> [[आ। ‘क्मरन् मनोदुर्गममब्भ्रमेचकं बभ्रद्वधूविभ्रमवृष्टिमभ्रितम्।।’ धा। का। १। ७१।]]</li></ul></p>

मय|मायकः-यिका|मिमयिषकः-षिका|मामयकः-यिका|मयिता-त्री|माययिता-त्री|मिमयिषिता-त्री|मामयिता-त्री
<ul><li><sup id="ref_krm_1233_01"><a href="#foot_krm_1233_01">1</a></sup> {@“मय गतौ”@} <sup id="ref_krm_1233_02"><a href="#foot_krm_1233_02">2</a></sup> मायकः-यिका, मायकः-यिका, मिमयिषकः-षिका, मामयकः-यिका;</li> <li>  मयिता-त्री, माययिता-त्री, मिमयिषिता-त्री, मामयिता-त्री;</li> <li>  <sup id="ref_krm_1233_03"><a href="#foot_krm_1233_03">3</a></sup> प्रमत्-प्रमतौ-प्रमतः, <sup id="ref_krm_1233_04"><a href="#foot_krm_1233_04">4</a></sup> मयिता, इत्यादीनि सर्वाण्यपि रूपाणि भौवादिक- चयतिवत् <sup id="ref_krm_1233_05"><a href="#foot_krm_1233_05">5</a></sup> ज्ञेयानि। </li> <li>ल्यपि- <sup id="ref_krm_1233_06"><a href="#foot_krm_1233_06">6</a></sup> प्रमय्य इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1233_01"><a href="#ref_krm_1233_01">↑</a> (१२२३)</li> <li id="foot_krm_1233_02"><a href="#ref_krm_1233_02">↑</a> (१-भ्वादिः-४७७। सक। सेट्। आत्म।)</li> <li id="foot_krm_1233_03"><a href="#ref_krm_1233_03">↑</a> [[२। क्विपि ‘लोपो व्योर्वलि’ (६-१-६६) इति यकारलोपे ‘ह्रस्वस्य पिति--’ (६-१-७१) इति तुकि च रूपमेवम्।]]</li> <li id="foot_krm_1233_04"><a href="#ref_krm_1233_04">↑</a> [[३। तच्छीलादिषु कर्तृषु ‘अनुदात्तेतश्च हलादेः’ (३-२-१४९) इति प्राप्तस्य युचः, ‘न यः’ (३-२-१५२) इति निषेधात् ‘तृन्’ (३-२-१३५) इत्यौत्सर्गिकस्तृन्नेव।]]</li> <li id="foot_krm_1233_05"><a href="#ref_krm_1233_05">↑</a> (५०२)</li> <li id="foot_krm_1233_06"><a href="#ref_krm_1233_06">↑</a> [[B। ‘पयः प्रदोहादिरताः प्रमय्य तं प्रैक्षन्त नूत्नाचयितं कुतूहलात्।।’ धा। का। १। ६१।]]</li></ul></p>

मर्च|मर्चकः-र्चिका|मिमर्चयिषकः-षिका|मर्चयिता-त्री|मिमर्चयिषिता-त्री
<ul><li><sup id="ref_krm_1234_01"><a href="#foot_krm_1234_01">1</a></sup> {@“मर्च शब्दार्थे”@} <sup id="ref_krm_1234_02"><a href="#foot_krm_1234_02">2</a></sup> अयं धातुः क्षीरतरङ्गिण्यां, सि। </li> <li>कौमुद्यादिषु च स्वतन्त्रेण पठ्यते। </li> <li>अन्ये तु पाठान्तरत्वेनाहुः। </li> <li>‘मर्ज--’ इत्यपि क्षीरस्वामी। </li> <li>मर्चकः-र्चिका, मिमर्चयिषकः-षिका;</li> <li>  मर्चयिता-त्री, मिमर्चयिषिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकगर्जयतिवत् <sup id="ref_krm_1234_03"><a href="#foot_krm_1234_03">3</a></sup> बोध्यानि। </li> <li>शतरि मर्चयन्- <sup id="ref_krm_1234_04"><a href="#foot_krm_1234_04">4</a></sup> न्ती इति। </li> <li><sup id="ref_krm_1234_05"><a href="#foot_krm_1234_05">5</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1234_01"><a href="#ref_krm_1234_01">↑</a> (१२२४)</li> <li id="foot_krm_1234_02"><a href="#ref_krm_1234_02">↑</a> (१०-चुरादिः-१६५०। अक। सेट्। उभ।)</li> <li id="foot_krm_1234_03"><a href="#ref_krm_1234_03">↑</a> (३७८)</li> <li id="foot_krm_1234_04"><a href="#ref_krm_1234_04">↑</a> [[C। ‘इत्थं सुगाजितमृदङ्गविमार्जनानि संवार्य मर्चयति घारितशङ्कमस्मिन्।’ धा। का। ३। २८।]]</li> <li id="foot_krm_1234_05"><a href="#ref_krm_1234_05">↑</a> [पृष्ठम्१००५+ २७]</li></ul></p>

मर्ब|मर्बकः-र्बिका|मिमर्बिषकः-षिका|मामर्बकः-र्बिका|मर्बिता-त्री|मर्बयिता-त्री|मिमर्बिषिता-त्री|मामर्बिता-त्री
<ul><li><sup id="ref_krm_1235_01"><a href="#foot_krm_1235_01">1</a></sup> {@“मर्ब गतौ”@} <sup id="ref_krm_1235_02"><a href="#foot_krm_1235_02">2</a></sup> मर्बकः-र्बिका, मर्बकः-र्बिका, मिमर्बिषकः-षिका, मामर्बकः-र्बिका;</li> <li>  मर्बिता-त्री, मर्बयिता-त्री, मिमर्बिषिता-त्री, मामर्बिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककर्बतिवत् <sup id="ref_krm_1235_03"><a href="#foot_krm_1235_03">3</a></sup> बोध्यानि। </li> <li>ल्यपि-उपमर्ब्य <sup id="ref_krm_1235_04"><a href="#foot_krm_1235_04">4</a></sup> इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1235_01"><a href="#ref_krm_1235_01">↑</a> (१२२५)</li> <li id="foot_krm_1235_02"><a href="#ref_krm_1235_02">↑</a> (१-भ्वादिः-४१९। सक। सेट्। पर।)</li> <li id="foot_krm_1235_03"><a href="#ref_krm_1235_03">↑</a> (१७३)</li> <li id="foot_krm_1235_04"><a href="#ref_krm_1235_04">↑</a> [[आ। ‘प्रबर्ब्य शैलानुपमर्ब्य पद्मिनीं प्रकर्ब्य चाशाः श्रमशोणितैरिव।।’ धा। का। १। ५४।]]</li></ul></p>

मर्व|मर्वकः-विका|मर्वकः-र्विका|मिमर्विषकः-षिका|मामर्वकः-र्विका|मर्विता-त्री|मर्वयिता-त्री|मिमर्विषिता-त्री|मामर्विता-त्री
<ul><li><sup id="ref_krm_1236_01"><a href="#foot_krm_1236_01">1</a></sup> {@“मर्व पूरणे”@} <sup id="ref_krm_1236_02"><a href="#foot_krm_1236_02">2</a></sup> ‘गतौ च द्रुमे’ इति धा। </li> <li>का। </li> <li>व्याख्यायाम् <sup id="ref_krm_1236_03"><a href="#foot_krm_1236_03">3</a></sup>। </li> <li><sup id="ref_krm_1236_04"><a href="#foot_krm_1236_04">4</a></sup> मर्वकः-विका, मर्वकः-र्विका, मिमर्विषकः-षिका, मामर्वकः-र्विका;</li> <li>  मर्विता-त्री, मर्वयिता-त्री, मिमर्विषिता-त्री, मामर्विता-त्री;</li> <li>  इत्यादीनि सर्वाणि रूपाणि भौवादिककर्वतिवत् <sup id="ref_krm_1236_05"><a href="#foot_krm_1236_05">5</a></sup> ज्ञेयानि। </li> <li>क्विपि- <sup id="ref_krm_1236_06"><a href="#foot_krm_1236_06">6</a></sup> मः-मरौ-मरः इति रूपमिति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1236_01"><a href="#ref_krm_1236_01">↑</a> (१२२६)</li> <li id="foot_krm_1236_02"><a href="#ref_krm_1236_02">↑</a> (१-भ्वादिः-५७८। सक। सेट्। पर।)</li> <li id="foot_krm_1236_03"><a href="#ref_krm_1236_03">↑</a> (१। ७३।)</li> <li id="foot_krm_1236_04"><a href="#ref_krm_1236_04">↑</a> [[B। ‘अफर्विताकाङ्क्षतमर्वकं सतां मांसादिसंचर्वकदुष्टभर्वकम्।’ धा। का। १। ७४।]]</li> <li id="foot_krm_1236_05"><a href="#ref_krm_1236_05">↑</a> (१७३आ)</li> <li id="foot_krm_1236_06"><a href="#ref_krm_1236_06">↑</a> [[१। ‘राल्लोपः’ (६-४-२१) इति वकारस्य लोपः। रुत्वविसर्गौ च भवतः।]]</li></ul></p>

मल|मालकः-लिका|मिमलिषकः-षिका|मामलकः-लिका|मलिता-त्री|मालयिता-त्री|मिमलिषिता-त्री|मामलिता-त्री|मलम्|कमलम्|परिमलम्|माला-माली|मालभारीमाल्यम्|मलिनः-मलीमसः|आमलकम्-आमलकी|मलयः
<ul><li><sup id="ref_krm_1237_01"><a href="#foot_krm_1237_01">1</a></sup> {@“मल धारणे”@} <sup id="ref_krm_1237_02"><a href="#foot_krm_1237_02">2</a></sup> मालकः-लिका, मालकः-लिका, मिमलिषकः-षिका, मामलकः-लिका;</li> <li>  मलिता-त्री, मालयिता-त्री, मिमलिषिता-त्री, मामलिता-त्री;</li> <li>  इत्यादीनि सर्वाणि रूपाणि प्रातिस्विकरूपाणि विना भौवादिककलतिवत् <sup id="ref_krm_1237_03"><a href="#foot_krm_1237_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1237_04"><a href="#foot_krm_1237_04">4</a></sup> मलम्, <sup id="ref_krm_1237_05"><a href="#foot_krm_1237_05">5</a></sup> कमलम्, <sup id="ref_krm_1237_06"><a href="#foot_krm_1237_06">6</a></sup> परिमलम्, <sup id="ref_krm_1237_07"><a href="#foot_krm_1237_07">7</a></sup> माला-माली, <sup id="ref_krm_1237_08"><a href="#foot_krm_1237_08">8</a></sup> <sup id="ref_krm_1237_09"><a href="#foot_krm_1237_09">9</a></sup> मालभारी <sup id="ref_krm_1237_10"><a href="#foot_krm_1237_10">10</a></sup> माल्यम्, <sup id="ref_krm_1237_11"><a href="#foot_krm_1237_11">11</a></sup> मलिनः-मलीमसः, <sup id="ref_krm_1237_12"><a href="#foot_krm_1237_12">12</a></sup> आमलकम्-आमलकी, <sup id="ref_krm_1237_13"><a href="#foot_krm_1237_13">13</a></sup> मलयः;</li> <li>  इत्यादीनि रूपाणि अस्य धातोः विशेषेण भवन्तीति विशेषः। </li> <li>यङन्तात् शानचि- <sup id="ref_krm_1237_14"><a href="#foot_krm_1237_14">14</a></sup> मामल्यमानः इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1237_01"><a href="#ref_krm_1237_01">↑</a> (१२२७)</li> <li id="foot_krm_1237_02"><a href="#ref_krm_1237_02">↑</a> (१-भ्वादिः-४९३। सक। सेट्। आत्म।)</li> <li id="foot_krm_1237_03"><a href="#ref_krm_1237_03">↑</a> (१७४)</li> <li id="foot_krm_1237_04"><a href="#ref_krm_1237_04">↑</a> [[२। शरीरं मल्यते धार्यते इत्यर्थे अच्प्रत्यये एवं रूपम्।]]</li> <li id="foot_krm_1237_05"><a href="#ref_krm_1237_05">↑</a> [[३। केन मल्यते इति ‘घञर्थे कविधानम्--’ (वा। ३-३-५८) इति कः। ‘कर्तृकरणे कृता बहुलम्’ (२-१-३२) इति समासः।]]</li> <li id="foot_krm_1237_06"><a href="#ref_krm_1237_06">↑</a> [[४। मल्यते = धार्यते इति ‘अकर्तरि च कारके संज्ञायाम्’ (३-३-१९) इति कर्मणि संज्ञायां विषये घञ्प्रत्ययः। संज्ञापूर्वकत्वात् वृद्ध्यभावः। ‘घनो घ च’ (३-३-१२५) इति घो वा। चकारात् घञ् च। यद्वा मलते धारयतीत्यर्थे अचि रूपमेवम्। ‘विमर्दोत्थे परिमलो गन्धे जनमनोहरे।’ इत्यमरः (१। १०)।]]</li> <li id="foot_krm_1237_07"><a href="#ref_krm_1237_07">↑</a> [[५। ‘मल्यते धार्यते इति माला, घञ्। संज्ञायां पुंस्त्वं प्रायिकम्’ इति प्र। सर्वस्वे। व्रीह्यादित्वात् (५-२-११६) इनिप्रत्यये माली इति।]]</li> <li id="foot_krm_1237_08"><a href="#ref_krm_1237_08">↑</a> [पृष्ठम्१००६+ २७]</li> <li id="foot_krm_1237_09"><a href="#ref_krm_1237_09">↑</a> [[१। ‘इष्टकेषीकामालानां चिततूलभारिषु’ (६-३-६५) तति भारिन्शब्दे उत्तरपदे मालाशब्दस्य ह्रस्वे रूपमेवम् = मालभारिणी = कन्या। ‘तदन्तस्यापि ग्रहणम्’ इति वचनात् उत्पलमालभारिणी = कन्या इत्यपि भवति।]]</li> <li id="foot_krm_1237_10"><a href="#ref_krm_1237_10">↑</a> [[२। ‘ऋहलोर्ण्यत्’ (३-१-१२४) इति ण्यति रूपमेवम्।]]</li> <li id="foot_krm_1237_11"><a href="#ref_krm_1237_11">↑</a> [[३। ‘ज्योत्स्नातमिस्राशृङ्गिणोर्जस्विन्नूर्जस्वलगोमिन्मलिनमलीमसाः’ (५-२-११४) इति मत्वर्थे संज्ञायां विषये एते शब्दाः निपात्यन्ते। इनच्प्रत्यये--मलिनः, ईमसप्रत्यये-मलीमसः इति ज्ञेयम्।]]</li> <li id="foot_krm_1237_12"><a href="#ref_krm_1237_12">↑</a> [[४। ‘क्वुन् शिल्पिसंज्ञयोः--’ (द। उ। ३। ५) इति क्वुन्प्रत्यये, स्त्रियाम्, ‘षिद्गौ- रादिभ्यश्च’ (४-१-४१) इति ङीषि च रूपमेवम्।]]</li> <li id="foot_krm_1237_13"><a href="#ref_krm_1237_13">↑</a> [[५। ‘वलिमलितनिभ्यः कयन्’ (द। उ। ८। १०) इति कयन्प्रत्यये रूपमेवम्। मलयः = भूधरविशेषः।]]</li> <li id="foot_krm_1237_14"><a href="#ref_krm_1237_14">↑</a> [[आ। ‘मामल्यमानं स्मितमल्लिकावलीमाभाल्यदैत्याधिपभल्लनोद्धुरम्।’ धा। का। १। ६४।]]</li></ul></p>

मल्ल|मल्लकः-ल्लिका|मिमल्लिषकः-षिका|मामल्लकः-ल्लिका|मल्लिता-त्री|मल्लयिता-त्री|मिमल्लिषिता-त्री|मामल्लिता-त्री
<ul><li><sup id="ref_krm_1238_01"><a href="#foot_krm_1238_01">1</a></sup> {@“मल्ल धारणे”@} <sup id="ref_krm_1238_02"><a href="#foot_krm_1238_02">2</a></sup> मल्लकः-ल्लिका, मल्लकः-ल्लिका, मिमल्लिषकः-षिका, मामल्लकः-ल्लिका;</li> <li>  मल्लिता-त्री, मल्लयिता-त्री, मिमल्लिषिता-त्री, मामल्लिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककड्डतिवत् <sup id="ref_krm_1238_03"><a href="#foot_krm_1238_03">3</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_1238_04"><a href="#foot_krm_1238_04">4</a></sup> मल्लिका, <sup id="ref_krm_1238_05"><a href="#foot_krm_1238_05">5</a></sup> <sup id="ref_krm_1238_06"><a href="#foot_krm_1238_06">6</a></sup> मल्लकः, <sup id="ref_krm_1238_07"><a href="#foot_krm_1238_07">7</a></sup> मल्लमल्लम् इमानि रूपाण्यधिकान्यत्रेति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1238_01"><a href="#ref_krm_1238_01">↑</a> (१२२८)</li> <li id="foot_krm_1238_02"><a href="#ref_krm_1238_02">↑</a> (१-भ्वादिः-४९४। सक। सेट्। आत्म।)</li> <li id="foot_krm_1238_03"><a href="#ref_krm_1238_03">↑</a> (१५६)</li> <li id="foot_krm_1238_04"><a href="#ref_krm_1238_04">↑</a> [[६। ‘संज्ञायाम्’ (३-३-१०९) इति संज्ञायां विषये स्त्रियां ण्वुलि रूपमेवम्। ‘मल्लिका तृणशून्येऽपि’ इति मेदिनी।]]</li> <li id="foot_krm_1238_05"><a href="#ref_krm_1238_05">↑</a> [[आ। ‘मामल्यमानं स्मितमल्लिकावलीमाभाल्यदैत्याधिपभल्लनोद्धुरम्।’ धा। का। १। ६४।]]</li> <li id="foot_krm_1238_06"><a href="#ref_krm_1238_06">↑</a> [[७। संज्ञायां क्वुन्प्रत्यये मल्लकः इति रूपम्।]]</li> <li id="foot_krm_1238_07"><a href="#ref_krm_1238_07">↑</a> [[८। मलं मल्लते धार्यते इति मलमल्लम् = कौपीनम्। ‘कर्मण्यण्’ (३-२-१) इत्यण्।]]</li></ul></p>

मव|मावकः-विका|मिमविषकः-षिका|मामवकः-विका|मविता-त्री|मावयिता-त्री|मिमविषिता-त्री|मामविता-त्री|एवं|क्तिन्यपि|ज्ञेयम्।]]|मूः-मुवौ-मुवः|निष्ठायाम्-मवितम्-तः-तवान्|मूतम्-मूतः-मूतवान्|क्तिनिमूतिः
<ul><li><sup id="ref_krm_1239_01"><a href="#foot_krm_1239_01">1</a></sup> {@“मव बन्धने”@} <sup id="ref_krm_1239_02"><a href="#foot_krm_1239_02">2</a></sup> मावकः-विका, मावकः-विका, मिमविषकः-षिका, मामवकः-विका;</li> <li>  मविता-त्री, मावयिता-त्री, मिमविषिता-त्री, मामविता-त्री;</li> <li>  इत्यादीनि सर्वाणि रूपाणि विशेषरूपाणि विना भौवादिककसतिवत् <sup id="ref_krm_1239_03"><a href="#foot_krm_1239_03">3</a></sup> <sup id="ref_krm_1239_04"><a href="#foot_krm_1239_04">4</a></sup> बोध्यानि। </li> <li>क्विपि- <sup id="ref_krm_1239_05"><a href="#foot_krm_1239_05">5</a></sup>स्रिव्यविमवामुपधायाश्च’ <sup id="ref_krm_1239_06"><a href="#foot_krm_1239_06">6</a></sup> इति उपधायाः वकारस्य च स्थाने ऊठादेशे सवर्णदीर्घे विसर्गे च रूपमेवम्। </li> <li>एवं क्तिन्यपि ज्ञेयम्।]] मूः-मुवौ-मुवः, निष्ठायाम्- <sup id="ref_krm_1239_07"><a href="#foot_krm_1239_07">7</a></sup> मवितम्-तः-तवान्, मूतम्-मूतः-मूतवान्, क्तिनि <sup id="ref_krm_1239_08"><a href="#foot_krm_1239_08">8</a></sup> मूतिः;</li> <li>  इमानि रूपाण्यस्य धातोः विशेषेण भवन्तीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1239_01"><a href="#ref_krm_1239_01">↑</a> (१२२९)</li> <li id="foot_krm_1239_02"><a href="#ref_krm_1239_02">↑</a> (१-भ्वादिः-५९९। सक। सेट्। पर।)</li> <li id="foot_krm_1239_03"><a href="#ref_krm_1239_03">↑</a> [पृष्ठम्१००७+ २९]</li> <li id="foot_krm_1239_04"><a href="#ref_krm_1239_04">↑</a> (१८०)</li> <li id="foot_krm_1239_05"><a href="#ref_krm_1239_05">↑</a> [[१। क्वौ परतः ‘ज्वरत्वर[श्रि]</li> <li id="foot_krm_1239_06"><a href="#ref_krm_1239_06">↑</a> (६-४-२०)</li> <li id="foot_krm_1239_07"><a href="#ref_krm_1239_07">↑</a> [[२। धातोरस्य सेट्त्वात् मवितम् इति रूपम्। काशिकायां तु (६-४-२०) मूतम्-तः-तवान् इति दृश्यते।]]</li> <li id="foot_krm_1239_08"><a href="#ref_krm_1239_08">↑</a> [[आ। ‘कृण्वन्तमाश्चर्यगतीरमूतिदं जगन्त्यवन्तं त्रिदशोपधावितम्।।’ धा। का। १। ७६।]]</li></ul></p>

मव्य|मव्यकः-व्यिका|मव्यकः-मव्यिका|मिमव्यिषकः-षिका|मामव्यकः-व्यिका|मव्यिता-त्री|मव्ययिता-त्री|मिमव्यिषिता-त्री|मामविता-मामव्यिता-त्री|मव्यन्-न्ती|मव्ययन्-न्ती|मिमव्यिषन्-न्ती|-|मव्यिष्यन्-न्ती-ती|मव्ययिष्यन्-न्ती-ती|मिमव्यिषिष्यन्-न्ती-ती|व्यतिमव्यमानः|मव्ययमानः|व्यतिमिमव्यिषमाणः|मामव्य्यमानः-मामव्यमानः|व्यतिमव्यिष्यमाणः|मव्ययिष्यमाणः|व्यतिमिमव्यिषिष्यमाणः|मामव्यिष्यमाणः|मौः-मावौ-मावः|मव्यितम्-तः|मव्यितः|मिमव्यिषितः|मामव्यितः-तवान्|मव्यः|मिमव्यिषुः|मामव्यः|मव्यितव्यम्|मव्ययितव्यम्|मिमव्यिषितव्यम्|मामव्यितव्यम्|मव्यनीयम्|मिमव्यिषणीयम्|मामव्यनीयम्|मव्यम्-मव्य्यम्|मव्यम्|मिमविष्यम्|मामव्य्यम्-मामव्यम्|ईषन्मव्यः-दुर्मव्यः-सुमव्यः|मव्यमानः-मव्य्यमानः|मव्यमानः|मिमव्यिष्यमाणः|मामव्य्यमानः|मिमव्यिषः|मव्यितुम्|मव्ययितुम्|मिमव्यिषितुम्|मामव्यितुम्|मव्या|मव्यना|मिमव्यिषा|मामव्या|मव्यनम्|मिमव्यिषणम्|मामव्यनम्|मव्यित्वा|मव्ययित्वा|मिमव्यिषित्वा|मामव्यित्वा|प्रमव्य-प्रमव्य्य|प्रमव्य्य|प्रमिमव्यिष्य|प्रमामव्य-प्रमामव्य्य|मिमव्यिषम्|मामव्यम्|ममव्यित्वा
<ul><li><sup id="ref_krm_1240_01"><a href="#foot_krm_1240_01">1</a></sup> {@“मव्य बन्धने”@} <sup id="ref_krm_1240_02"><a href="#foot_krm_1240_02">2</a></sup> मव्यकः-व्यिका, मव्यकः-मव्यिका, मिमव्यिषकः-षिका, <sup id="ref_krm_1240_03"><a href="#foot_krm_1240_03">3</a></sup> मामव्यकः-व्यिका;</li> <li>  मव्यिता-त्री, मव्ययिता-त्री, मिमव्यिषिता-त्री, <sup id="ref_krm_1240_04"><a href="#foot_krm_1240_04">4</a></sup> मामविता-मामव्यिता-त्री;</li> <li>  <sup id="ref_krm_1240_05"><a href="#foot_krm_1240_05">5</a></sup> मव्यन्-न्ती, मव्ययन्-न्ती, मिमव्यिषन्-न्ती;</li> <li>  -- -- मव्यिष्यन्-न्ती-ती, मव्ययिष्यन्-न्ती-ती, मिमव्यिषिष्यन्-न्ती-ती;</li> <li>  -- व्यतिमव्यमानः, मव्ययमानः, व्यतिमिमव्यिषमाणः, मामव्य्यमानः-मामव्यमानः;</li> <li>  व्यतिमव्यिष्यमाणः;</li> <li>  मव्ययिष्यमाणः, व्यतिमिमव्यिषिष्यमाणः, मामव्यिष्यमाणः;</li> <li>  <sup id="ref_krm_1240_06"><a href="#foot_krm_1240_06">6</a></sup> मौः-मावौ-मावः;</li> <li>  -- -- -- मव्यितम्-तः, मव्यितः, मिमव्यिषितः, मामव्यितः-तवान्;</li> <li>  मव्यः, मव्यः, मिमव्यिषुः, मामव्यः;</li> <li>  मव्यितव्यम्, मव्ययितव्यम्, मिमव्यिषितव्यम्, मामव्यितव्यम्;</li> <li>  मव्यनीयम्, मव्यनीयम्, मिमव्यिषणीयम्, मामव्यनीयम्;</li> <li>  <sup id="ref_krm_1240_07"><a href="#foot_krm_1240_07">7</a></sup> मव्यम्-मव्य्यम्, मव्यम्, मिमविष्यम्, <sup id="ref_krm_1240_08"><a href="#foot_krm_1240_08">8</a></sup> मामव्य्यम्-मामव्यम्;</li> <li>  <sup id="ref_krm_1240_09"><a href="#foot_krm_1240_09">9</a></sup> ईषन्मव्यः-दुर्मव्यः-सुमव्यः;</li> <li>  -- -- -- मव्यमानः-मव्य्यमानः, मव्यमानः, मिमव्यिष्यमाणः, मामव्य्यमानः;</li> <li>  मव्यः, मव्यः, मिमव्यिषः, मामव्यः;</li> <li>  मव्यितुम्, मव्ययितुम्, मिमव्यिषितुम्, मामव्यितुम्;</li> <li>  <sup id="ref_krm_1240_10"><a href="#foot_krm_1240_10">10</a></sup> मव्या, मव्यना, मिमव्यिषा, मामव्या;</li> <li>  मव्यनम्, मव्यनम्, मिमव्यिषणम्, मामव्यनम्;</li> <li>  मव्यित्वा, मव्ययित्वा, मिमव्यिषित्वा, मामव्यित्वा;</li> <li>  प्रमव्य-प्रमव्य्य, प्रमव्य्य, प्रमिमव्यिष्य, प्रमामव्य-प्रमामव्य्य;</li> <li>  मव्यम् २, मव्यित्वा २, मव्यम् २, मव्ययित्वा २, मिमव्यिषम् २, मिमव्यिषित्वा २, मामव्यम् २;</li> <li>  ममव्यित्वा २;</li> <li>  <sup id="ref_krm_1240_11"><a href="#foot_krm_1240_11">11</a></sup> मवाका।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1240_01"><a href="#ref_krm_1240_01">↑</a> (१२३०)</li> <li id="foot_krm_1240_02"><a href="#ref_krm_1240_02">↑</a> (१-भ्वादिः-५०८। सक। सेट्। पर।)</li> <li id="foot_krm_1240_03"><a href="#ref_krm_1240_03">↑</a> [[३। यङन्तात् ण्वुलि अल्लोपयलोपयो रूपमेवम्।]]</li> <li id="foot_krm_1240_04"><a href="#ref_krm_1240_04">↑</a> [[४। यङन्तात् तृजादिषु अल्लोपयलोपयोः, ‘हलो यमां यमि लोषः’ (८-४-६४) इति यकारलोपे च मामविता इति रूपम्। ‘हलो यमाम्--’ (८-४-६४) इति लोपस्य पाक्षिकत्वात्, तदभावे मामव्यिता इति रूपमिति ज्ञेयम्।]]</li> <li id="foot_krm_1240_05"><a href="#ref_krm_1240_05">↑</a> [[B। ‘प्रम्लेवितं रेवितवत्समण्डलीं मव्यद्भिराभीरजनैरसूर्क्ष्यकैः।।’ धा। का। १। ६५।]]</li> <li id="foot_krm_1240_06"><a href="#ref_krm_1240_06">↑</a> [[५। क्विपि, ‘लोपो व्योर्वलि’ (६-१-६६) इति धातुयकारलोपे धातुवकारस्य ऊठि, ‘एत्येधत्यूठूसु’ (६-१-८९) इति वृद्धौ च रूपमेवम्।]]</li> <li id="foot_krm_1240_07"><a href="#ref_krm_1240_07">↑</a> [[६। ण्यति, ‘हलो यमाम्--’ (८-४-६४) इति यलोपस्य पाक्षिकत्वाद्रूपद्वयम्। एवमेव यकि, ल्यपि च रूपद्वयं ज्ञेयम्।]]</li> <li id="foot_krm_1240_08"><a href="#ref_krm_1240_08">↑</a> [[७। यङन्तात् यत्प्रत्यये ‘हलो यमां यमि--’ (८-४-६४) इति लोपस्य वैकल्पिकत्वाद् रूपद्वयम्। एवमेव यकि, ल्यपि शानजन्तेऽपि ज्ञेयम्।]]</li> <li id="foot_krm_1240_09"><a href="#ref_krm_1240_09">↑</a> [पृष्ठम्१००८+ २६]</li> <li id="foot_krm_1240_10"><a href="#ref_krm_1240_10">↑</a> [[१। ‘गुरोश्च हलः’ (३-३-१०३) इत्यकारप्रत्यये रूपमेवम्।]]</li> <li id="foot_krm_1240_11"><a href="#ref_krm_1240_11">↑</a> [[२। ‘बलाकादयश्च’ (द। उ। ३। ३२) इति आकप्रत्यये यलोपे च निपात्यते। मवाका = करेणुबन्धनम्।]]</li></ul></p>

मश|माशकः-शिका|मिमशिषकः-षिका|मामशकः-शिका|मशिता-त्री|माशयिता-त्री|मिमशिषिता-त्री|मामशिता-त्री|शतरि-कशन्-|न्ती|क्विपि-मट्-मड्-मशौ-मशः
<ul><li><sup id="ref_krm_1241_01"><a href="#foot_krm_1241_01">1</a></sup> {@“मश शब्दे रोषकृते च”@} <sup id="ref_krm_1241_02"><a href="#foot_krm_1241_02">2</a></sup> ‘शब्दने, रोषक्रियायां चार्थे--’ इति क्षीरस्वामी। </li> <li>“शब्दकोपयोः-इति द्रुमोक्त्या रोषकृतम् = रोष एव।” इति धा। </li> <li>का। </li> <li>व्याख्यायाम् <sup id="ref_krm_1241_03"><a href="#foot_krm_1241_03">3</a></sup>। </li> <li>माशकः-शिका, माशकः-शिका, मिमशिषकः-षिका, मामशकः-शिका;</li> <li>  मशिता-त्री, माशयिता-त्री, मिमशिषिता-त्री, मामशिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि आदादिककशतिवत् <sup id="ref_krm_1241_04"><a href="#foot_krm_1241_04">4</a></sup> ज्ञेयानि। </li> <li>शतरि--कशन्- न्ती, क्विपि- <sup id="ref_krm_1241_05"><a href="#foot_krm_1241_05">5</a></sup> मट्-मड्-मशौ-मशः;</li> <li>  इत्यादीनि रूपाण्यस्य भवन्तीति विशेषः। </li> <li><sup id="ref_krm_1241_06"><a href="#foot_krm_1241_06">6</a></sup> मशकः। </li> <li><sup id="ref_krm_1241_07"><a href="#foot_krm_1241_07">7</a></sup> मशनः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1241_01"><a href="#ref_krm_1241_01">↑</a> (१२३१)</li> <li id="foot_krm_1241_02"><a href="#ref_krm_1241_02">↑</a> (१-भ्वादिः-७२४। अक। सेट्। पर।)</li> <li id="foot_krm_1241_03"><a href="#ref_krm_1241_03">↑</a> (१-९०)</li> <li id="foot_krm_1241_04"><a href="#ref_krm_1241_04">↑</a> (१७८)</li> <li id="foot_krm_1241_05"><a href="#ref_krm_1241_05">↑</a> [[३। क्विपि, ‘व्रश्च--’ (८-२-३६) इत्यादिना षत्वे जश्त्वचर्त्वयोश्च रूपमेवम्।]]</li> <li id="foot_krm_1241_06"><a href="#ref_krm_1241_06">↑</a> [[४। ‘क्वुन् शिल्पिसंज्ञयोः--’ (द। उ। ३। ५) इति संज्ञायां क्वुन्प्रत्यये रूपमेवम्।]]</li> <li id="foot_krm_1241_07"><a href="#ref_krm_1241_07">↑</a> [[५। ‘चलनशब्दार्थात्--’ (३-२-१४८) इति ताच्छीलिके युचि रूपमेवम्।]]</li></ul></p>

मष|माषकः-षिका|मिमषिषकः-षिका|मामषकः-षिका|मषिता-त्री|माषयिता-त्री|मिमषिषिता-त्री|मामषिता-त्री
<ul><li><sup id="ref_krm_1242_01"><a href="#foot_krm_1242_01">1</a></sup> {@“मष हिंसार्थः”@} <sup id="ref_krm_1242_02"><a href="#foot_krm_1242_02">2</a></sup> माषकः-षिका, माषकः-षिका, मिमषिषकः-षिका, मामषकः-षिका;</li> <li>  मषिता-त्री, माषयिता-त्री, मिमषिषिता-त्री, मामषिता-त्री;</li> <li>  इत्यादीनि <sup id="ref_krm_1242_03"><a href="#foot_krm_1242_03">3</a></sup> सर्वाण्यपि रूपाणि भौवादिकखषतिवत् <sup id="ref_krm_1242_04"><a href="#foot_krm_1242_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1242_05"><a href="#foot_krm_1242_05">5</a></sup> दण्डोपमाषम्- दण्डेनोपमाषं वा गाः कालयति। </li> <li><sup id="ref_krm_1242_06"><a href="#foot_krm_1242_06">6</a></sup> माषः, <sup id="ref_krm_1242_07"><a href="#foot_krm_1242_07">7</a></sup> मषी।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1242_01"><a href="#ref_krm_1242_01">↑</a> (१२३२)</li> <li id="foot_krm_1242_02"><a href="#ref_krm_1242_02">↑</a> (१-भ्वादिः-६९२। सक। सेट्। पर।)</li> <li id="foot_krm_1242_03"><a href="#ref_krm_1242_03">↑</a> [पृष्ठम्१००९+ ३०]</li> <li id="foot_krm_1242_04"><a href="#ref_krm_1242_04">↑</a> (३४६)</li> <li id="foot_krm_1242_05"><a href="#ref_krm_1242_05">↑</a> [[१। ‘हिंसार्थानां च समानकर्मकाणाम्’ (३-४-४८) इति णमुल्। ‘तृतीयाप्रभृतीनि--’ (२-२-२१) इति समासविकल्पः।]]</li> <li id="foot_krm_1242_06"><a href="#ref_krm_1242_06">↑</a> [[२। मष्यते = हिंस्यते बुद्धिभ्रंशसम्पादनेन इति माषः = धान्यबिशेषः। संज्ञायाम्, ‘हलश्च’ (३-३-१२१) इति करणे घञ्।]]</li> <li id="foot_krm_1242_07"><a href="#ref_krm_1242_07">↑</a> [[३। ‘इक् कृष्यादिभ्यः’ (वा। ३-३-१०८) इतीक्प्रत्यये, ‘कृदिकारादक्तिनः’ (ग। सू। ४-१-४५) इति ङीषि च मषी इति सिद्ध्यति। मषी = स्याही।]]</li></ul></p>

मसी|मासकः-सिका|मिमसिषकः-षिका|मामसकः-सिका|मसिता-त्री|मासयिता-त्री|मिमसिषिता-त्री|मामसिता-त्री
<ul><li><sup id="ref_krm_1243_01"><a href="#foot_krm_1243_01">1</a></sup> {@“मसी परिणामे”@} <sup id="ref_krm_1243_02"><a href="#foot_krm_1243_02">2</a></sup> परिणामः--विकारः। </li> <li>‘-- परिमाणे’ इति कविकल्पद्रुम-माधवीयधातुवृत्त्योः पाठः। </li> <li>‘समी--’ इति क्वचित् पाठः। </li> <li>मासकः-सिका, मासकः-सिका, मिमसिषकः-षिका, मामसकः-सिका;</li> <li>  मसिता-त्री, मासयिता-त्री, मिमसिषिता-त्री, मामसिता-त्री;</li> <li>  इत्यादीनि समस्ता- न्यपि रूपाणि प्रातिस्विकरूपाणि विना भौवादिकग्रसतिवत् <sup id="ref_krm_1243_03"><a href="#foot_krm_1243_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1243_04"><a href="#foot_krm_1243_04">4</a></sup> मस्तः-मस्तवान्, मस्तकम्, <sup id="ref_krm_1243_05"><a href="#foot_krm_1243_05">5</a></sup> मासः, <sup id="ref_krm_1243_06"><a href="#foot_krm_1243_06">6</a></sup> मस्यन्-न्ती-ती, <sup id="ref_krm_1243_07"><a href="#foot_krm_1243_07">7</a></sup> मः-मसौ-मसः, इतीमानि रूपाण्यस्मात् सम्भवन्तीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1243_01"><a href="#ref_krm_1243_01">↑</a> (१२३३)</li> <li id="foot_krm_1243_02"><a href="#ref_krm_1243_02">↑</a> (४-दिवादिः-१२२१। अक। सेट्। पर।)</li> <li id="foot_krm_1243_03"><a href="#ref_krm_1243_03">↑</a> (४४०)</li> <li id="foot_krm_1243_04"><a href="#ref_krm_1243_04">↑</a> [[४। ईदित्त्वात्, ‘श्वीदितो निष्ठायाम्’ (७-२-१४) इति निष्ठायामिण्निषेधे रूपमेवम्। निष्ठान्तात् संज्ञायां कन्प्रत्यये मस्तकम् इति भवति।]]</li> <li id="foot_krm_1243_05"><a href="#ref_krm_1243_05">↑</a> [[५। मस्यते = परिमीयतेऽनेनेति मासः = त्रिंशद्दिनावधिकः कालविशेषः। एतच्च धातोरस्य परिमाणार्थकत्वे ज्ञेयम्। परिणामार्थकत्वे तु मस्यति = पदार्थान् परिणम- यतीत्यर्थे बाहुलकात् संज्ञायां घञि मासः इति सिद्ध्यति। मासूशब्दस्तु प्रकृत्यन्तरम्, नास्माद्धातोः सिद्धमिति ज्ञेयम्।]]</li> <li id="foot_krm_1243_06"><a href="#ref_krm_1243_06">↑</a> [[६। शतरि दिवादित्वात् श्यनि रूपमेवम्।]]</li> <li id="foot_krm_1243_07"><a href="#ref_krm_1243_07">↑</a> [[७। क्विपि धातुसकारस्य रुत्वे विसर्गे च रूपमेवम्।]]</li></ul></p>

मस्क|मस्ककः-स्किका|मिमस्किषकः-षिका|मामस्ककः-स्किका
<ul><li><sup id="ref_krm_1244_01"><a href="#foot_krm_1244_01">1</a></sup> {@“मस्क गत्यर्थे”@} <sup id="ref_krm_1244_02"><a href="#foot_krm_1244_02">2</a></sup> मस्ककः-स्किका, मस्ककः-स्किका, मिमस्किषकः-षिका, मामस्ककः-स्किका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककर्जतिवत् <sup id="ref_krm_1244_03"><a href="#foot_krm_1244_03">3</a></sup> ज्ञेयानि। </li> <li>क्विपि <sup id="ref_krm_1244_04"><a href="#foot_krm_1244_04">4</a></sup> मक्-मस्कौ-मस्कः इति रूपम्। </li> <li><sup id="ref_krm_1244_05"><a href="#foot_krm_1244_05">5</a></sup> मस्कनः। </li> <li>अस्य आत्मनेपदित्वात् शानचि मस्कमानः इति भवति। </li> <li><sup id="ref_krm_1244_06"><a href="#foot_krm_1244_06">6</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1244_01"><a href="#ref_krm_1244_01">↑</a> (१२३४)</li> <li id="foot_krm_1244_02"><a href="#ref_krm_1244_02">↑</a> (१-भ्वादिः-१०२। सक। सेट्। आत्म।)</li> <li id="foot_krm_1244_03"><a href="#ref_krm_1244_03">↑</a> (१६९)</li> <li id="foot_krm_1244_04"><a href="#ref_krm_1244_04">↑</a> [[८। ‘स्कोः संयोगाद्योरन्ते च’ (८-२-२९) इति सकारस्य पदान्तनिमित्तको लोपः।]]</li> <li id="foot_krm_1244_05"><a href="#ref_krm_1244_05">↑</a> [[९। ‘अनुदात्तेतश्च हलादेः’ (३-२-१४९) इति ताच्छीलिके युचि रूपम्।]]</li> <li id="foot_krm_1244_06"><a href="#ref_krm_1244_06">↑</a> [पृष्ठम्१०१०+ २५]</li></ul></p>

टु|मज्जकः-ज्जिका|मिमङ्क्षकः-क्षिका|मामज्जकः-ज्जिका|मङ्क्ता-मङूक्त्री|मज्जयिता-त्री|मिमङ्क्षिता-त्री|मामज्जिता-त्री|मज्जन्-ती|मज्जयन्-न्ती|मिमङ्क्षन्-न्ती|-|मङ्क्ष्यन्-न्ती-ती|मज्जयिष्यन्-न्ती-ती|मिमङ्क्षिष्यन्-न्ती-ती|-मज्जयमानः|मामज्ज्यमानः|मज्जयिष्यमाणः|मामज्जिष्यमाणः|सुमक्-सुमग्-सुमज्जौ-सुमज्जः|-मग्नः-मग्नवान्|मज्जितः|मिमङ्क्षितः|मामज्जितः-तवान्|मज्जः|मिमङूक्षुः|मामज्जः|मङ्क्तव्यम्|मज्जयितव्यम्|मिमङ्क्षितव्यम्|मामज्जितव्यम्|मज्जनीयम्|मिमङ्क्षणीयम्|मामज्जनीयम्|मद्ग्यम्-मद्ग्यः|मज्ज्यम्|मिमङ्क्ष्यम्|मामज्ज्यम्|ईषन्मज्जः-दुर्मज्जः-सुमज्जः|मज्ज्यमानः|मिमङ्क्ष्यमाणः|मद्गः|मज्जथुःमज्जः|मिमङ्क्षः|मङ्क्तुम्|मज्जयितुम्|मिमङ्क्षितुम्|मामज्जितुम्|मज्जा|मज्जना|मिमङ्क्षा|मामज्जा|मज्जनम्|मिमङ्क्षणम्|मामज्जनम्|मङ्क्त्वा-मक्त्वा|मज्जयित्वा|मिमङ्क्षित्वा|मामज्जित्वा|प्रमज्ज्य|प्रमिमङ्क्ष्य|प्रमामज्ज्य|मज्जम्मङ्क्त्वामक्त्वामज्जम्मज्जयित्वामिमङ्क्षम्मिमङ्क्षित्वामामज्जम्
<ul><li><sup id="ref_krm_1245_01"><a href="#foot_krm_1245_01">1</a></sup> {@“टु मस्जो शुद्धौ”@} <sup id="ref_krm_1245_02"><a href="#foot_krm_1245_02">2</a></sup> ‘शुद्ध्या स्नानम्, व्रुडनं च लक्ष्यते।’ इति क्षीरस्वामी। </li> <li>व्रुडनम् = संवरणम्। </li> <li><sup id="ref_krm_1245_03"><a href="#foot_krm_1245_03">3</a></sup> मज्जकः-ज्जिका, मज्जकः-ज्जिका, <sup id="ref_krm_1245_04"><a href="#foot_krm_1245_04">4</a></sup> मिमङ्क्षकः-क्षिका, मामज्जकः-ज्जिका;</li> <li>  <sup id="ref_krm_1245_05"><a href="#foot_krm_1245_05">5</a></sup> मङ्क्ता-मङूक्त्री, मज्जयिता-त्री, मिमङ्क्षिता-त्री, मामज्जिता-त्री;</li> <li>  <sup id="ref_krm_1245_06"><a href="#foot_krm_1245_06">6</a></sup> मज्जन्-ती, मज्जयन्-न्ती, मिमङ्क्षन्-न्ती;</li> <li>  -- मङ्क्ष्यन्-न्ती-ती, मज्जयिष्यन्-न्ती-ती, मिमङ्क्षिष्यन्-न्ती-ती;</li> <li>  -- -- <sup id="ref_krm_1245_07"><a href="#foot_krm_1245_07">7</a></sup> मज्जयमानः, -- मामज्ज्यमानः;</li> <li>  -- मज्जयिष्यमाणः, -- मामज्जिष्यमाणः;</li> <li>  <sup id="ref_krm_1245_08"><a href="#foot_krm_1245_08">8</a></sup> सुमक्-सुमग्-सुमज्जौ-सुमज्जः;</li> <li>  -- -- -- <sup id="ref_krm_1245_09"><a href="#foot_krm_1245_09">9</a></sup> मग्नः-मग्नवान्, मज्जितः, मिमङ्क्षितः, मामज्जितः-तवान्;</li> <li>  मज्जः, मज्जः, मिमङूक्षुः, मामज्जः;</li> <li>  मङ्क्तव्यम्, मज्जयितव्यम्, मिमङ्क्षितव्यम्, मामज्जितव्यम्;</li> <li>  मज्जनीयम्, मज्जनीयम्, मिमङ्क्षणीयम्, मामज्जनीयम्;</li> <li>  <sup id="ref_krm_1245_10"><a href="#foot_krm_1245_10">10</a></sup> <sup id="ref_krm_1245_11"><a href="#foot_krm_1245_11">11</a></sup> मद्ग्यम्-मद्ग्यः, मज्ज्यम्, मिमङ्क्ष्यम्, मामज्ज्यम्;</li> <li>  ईषन्मज्जः-दुर्मज्जः-सुमज्जः;</li> <li>  -- -- -- मज्ज्यमानः, मज्ज्यमानः, मिमङ्क्ष्यमाणः, मामज्ज्यमानः;</li> <li>  मद्गः, <sup id="ref_krm_1245_12"><a href="#foot_krm_1245_12">12</a></sup> मज्जथुः <sup id="ref_krm_1245_13"><a href="#foot_krm_1245_13">13</a></sup> मज्जः, मिमङ्क्षः, मामज्जः;</li> <li>  मङ्क्तुम्, मज्जयितुम्, मिमङ्क्षितुम्, मामज्जितुम्;</li> <li>  <sup id="ref_krm_1245_14"><a href="#foot_krm_1245_14">14</a></sup> मज्जा, मज्जना, मिमङ्क्षा, मामज्जा;</li> <li>  मज्जनम्, मज्जनम्, मिमङ्क्षणम्, मामज्जनम्;</li> <li>  <sup id="ref_krm_1245_15"><a href="#foot_krm_1245_15">15</a></sup> मङ्क्त्वा <sup id="ref_krm_1245_16"><a href="#foot_krm_1245_16">16</a></sup> -मक्त्वा, मज्जयित्वा, मिमङ्क्षित्वा, मामज्जित्वा;</li> <li>  प्रमज्ज्य, प्रमज्ज्य, प्रमिमङ्क्ष्य, प्रमामज्ज्य;</li> <li>  मज्जम् २ मङ्क्त्वा २ मक्त्वा २ मज्जम् २ मज्जयित्वा २ मिमङ्क्षम् २ मिमङ्क्षित्वा २ मामज्जम् २;</li> <li>  मामज्जित्वा २;</li> <li>  <sup id="ref_krm_1245_17"><a href="#foot_krm_1245_17">17</a></sup> मद्गुः, <sup id="ref_krm_1245_18"><a href="#foot_krm_1245_18">18</a></sup> मज्जा-मज्ज नौ-मज्जनः, <sup id="ref_krm_1245_19"><a href="#foot_krm_1245_19">19</a></sup> मञ्जूषा, <sup id="ref_krm_1245_20"><a href="#foot_krm_1245_20">20</a></sup> मद्गुरः। </li> <li><sup id="ref_krm_1245_21"><a href="#foot_krm_1245_21">21</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1245_01"><a href="#ref_krm_1245_01">↑</a> (१२३५)</li> <li id="foot_krm_1245_02"><a href="#ref_krm_1245_02">↑</a> (६-तुदादिः-१४१५। अक। अनि। पर।)</li> <li id="foot_krm_1245_03"><a href="#ref_krm_1245_03">↑</a> [[१। ण्वुलि, ‘झलां जश् झशि’ (८-४-५३) इति सकारस्य दकारे, तस्य श्चुत्वेन जकारः। एवमेव ण्यन्तेषु, यङन्तेषु, शुद्धे अजादिप्रत्ययेषु च रूपनिष्पत्तिरिति ज्ञेयम्।]]</li> <li id="foot_krm_1245_04"><a href="#ref_krm_1245_04">↑</a> [[२। सन्नन्तात् ण्वुलि, धातोरनिट्त्वेन झलादिप्रत्ययपरकत्वात्, ‘मस्जिनशोर्झलि’ (७-१-६०) इति नुमागमः। अत्र च ‘मिदचोऽन्त्यात् परः’ (१-१-४७) इति नियमं बाधित्वा, ‘मस्जेरन्त्यात् पूर्वं नुममिच्छन्ति अनुषङ्गादिलोपार्थम्’ (वा। १-१-४७) इति भाष्याद्युक्तप्रकारेण धातुजकारात् पूर्वं नुम्। तेन सकारस्य संयोगादिलोपे, कुत्वे च रूपमेवम्। एवमेव सन्नन्ते सर्वत्र प्रक्रियोह्या।]]</li> <li id="foot_krm_1245_05"><a href="#ref_krm_1245_05">↑</a> [[३। तृचि अन्त्यात् पूर्वं नुमि, ‘स्कोः संयोगाद्योरन्ते च’ (८-२-२९) इति संयोगादिलोपे रूपमेवम्। एवमेव तव्यदादिष्वपि ज्ञेयम्।]]</li> <li id="foot_krm_1245_06"><a href="#ref_krm_1245_06">↑</a> [[४। शतरि, तुदादित्वात् शपोऽपवादत्वेन शप्रत्यये जश्त्वश्चुत्वयो रूपमेवम्।]]</li> <li id="foot_krm_1245_07"><a href="#ref_krm_1245_07">↑</a> [[५। शुद्धेश्चेतनकर्तृकत्वे, ण्यन्तात्, ‘अणावकर्मकात्--’ (१-३-८८) इति परस्मैपदमेव। अचित्तवत्कर्तृकत्वे तु आत्मनेपदमपीत्यतोऽत्रात्मनेपदम्।]]</li> <li id="foot_krm_1245_08"><a href="#ref_krm_1245_08">↑</a> [[६। क्विपि, संयोगादिलोपे, जकारस्य कुत्वे च रूपमेवम्।]]</li> <li id="foot_krm_1245_09"><a href="#ref_krm_1245_09">↑</a> [[७। निष्ठायाम्, ‘मस्जिनशोः--’ (७-१-६०) इति नुमि, सकारस्य संयोगादिलोपे, नुमो नकारस्य ‘अनिदिताम्--’ (६-४-२४) इति लोपे, ‘ओदितश्च’ (८-२-४५) इति निष्ठानत्वे, नत्वस्यासिद्धत्वेन झल्परकत्वात् ‘चोः कुः’ (८-२-३०) इति कुत्वे च रूपमेवम्।]]</li> <li id="foot_krm_1245_10"><a href="#ref_krm_1245_10">↑</a> [पृष्ठम्१०११+ २८]</li> <li id="foot_krm_1245_11"><a href="#ref_krm_1245_11">↑</a> [[१। ण्यति, ‘चजोः कु घिण्णयतोः’ (७-३-५२) इति धातुजकारस्य कुत्वे सकारस्य जश्त्वेन दकारे च रूपमेवम्। घञ्यप्येवमेव रूपनिष्पत्तिरिति ज्ञेयम्।]]</li> <li id="foot_krm_1245_12"><a href="#ref_krm_1245_12">↑</a> [[२। भावे, ‘ट्वितोऽथुच्’ (३-३-८९) इत्यथुच्प्रत्यये रूपमेवम्।]]</li> <li id="foot_krm_1245_13"><a href="#ref_krm_1245_13">↑</a> [[आ। ‘तल्पे कान्तान्तरैः सार्धं मन्येऽहं धिङ् निमज्जथुम्।।’ भ। का। ५। २०।]]</li> <li id="foot_krm_1245_14"><a href="#ref_krm_1245_14">↑</a> [[३। ‘गुरोश्च हलः’ (३-३-१०३) इति स्त्रियामकारप्रत्यये रूपमेवम्। केचित्तु क्तिनि, नुमि नलोपे च मक्तिरिति साधयन्ति। ‘प्रसज्य चापवादविषयं तत उत्सर्गोऽभिनिवि- शते’ (परि। ६५) इति न्यायानुसरणे तु मज्जा इत्यकारप्रत्ययान्तं रूपमेव न्याय्य- मिति प्रतिभाति।]]</li> <li id="foot_krm_1245_15"><a href="#ref_krm_1245_15">↑</a> [[४। क्त्वाप्रत्यये, ‘जान्तनशां विभाषा’ (६-४-३२) इत्यनुनासिकलोपनिषेधविकल्पः। निषेधविकल्पे विधिविकल्पपर्यवसानात् अनुनासिकलोपो विभाषा भवतीति ज्ञेयम्। तेन रूपद्वयम्।]]</li> <li id="foot_krm_1245_16"><a href="#ref_krm_1245_16">↑</a> [[B। ‘अध्यास्त यं नक्रकुलं स्थवीयो द्विपोऽप्यमङ्क्त्वा न यमुत्ततार।’ वा। वि। ३। ३८।]]</li> <li id="foot_krm_1245_17"><a href="#ref_krm_1245_17">↑</a> [[५। ‘भृमृशीतॄचरित्सरितनिमिमस्जिभ्य उः’ (द। उ-१-९२) इत्युप्रत्यये रूपमेवम्। मज्जत्यम्भसीति मद्गुः = जलपक्षिविशेषः। न्यङ्क्वादि (७-३-५३) पाठात् जकारस्य कुत्वेन गकारः।]]</li> <li id="foot_krm_1245_18"><a href="#ref_krm_1245_18">↑</a> [[६। ‘श्वन्नुक्षन्--’ (द। उ। ६-५५) इत्यादिना कनिन्प्रत्यये रूपमेवम्। मज्जत्यस्थिष्विति मज्जा = अस्थ्यन्तसारः। नकारान्तोऽयं शब्दः।]]</li> <li id="foot_krm_1245_19"><a href="#ref_krm_1245_19">↑</a> [[७। ‘मस्जेर्नुम् च’ (द। उ। ९-१८) इत्यूषन्प्रत्यये, नुभागमे च रूपमेवम्। मज्जत्यस्या- मिति मञ्जूषा = पेटिका।]]</li> <li id="foot_krm_1245_20"><a href="#ref_krm_1245_20">↑</a> [[८। बाहुलकादौणादिकेऽरप्रत्यये न्यङ्क्वादित्वात् (७-३-५३) कुत्वे च रूपम्। मद्गुरः = जलपक्षिविशेषः।]]</li> <li id="foot_krm_1245_21"><a href="#ref_krm_1245_21">↑</a> [पृष्ठम्१०१२+ २८]</li></ul></p>

मह|माहकः-हिका|मिमहिषकः-षिका|मामहकः-हिका|महिता-त्री|माहयिता-त्री|मिमहिषिता-त्री|मामहिता-त्री
<ul><li><sup id="ref_krm_1246_01"><a href="#foot_krm_1246_01">1</a></sup> {@“मह पूजायाम्”@} <sup id="ref_krm_1246_02"><a href="#foot_krm_1246_02">2</a></sup> ‘महयेन्महतीत्येते पूजायां णौ शपि क्रमात्।’ <sup id="ref_krm_1246_03"><a href="#foot_krm_1246_03">3</a></sup> इति देवः। </li> <li>क्षीरस्वामी नामुं धातुं पठति। </li> <li>माहकः-हिका, माहकः-हिका, मिमहिषकः-षिका, मामहकः-हिका;</li> <li>  महिता-त्री, माहयिता-त्री, मिमहिषिता-त्री, मामहिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकचहतिवत् <sup id="ref_krm_1246_04"><a href="#foot_krm_1246_04">4</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_1246_05"><a href="#foot_krm_1246_05">5</a></sup> मही, <sup id="ref_krm_1246_06"><a href="#foot_krm_1246_06">6</a></sup> महिषः-महिषी, महिष्मान्, <sup id="ref_krm_1246_07"><a href="#foot_krm_1246_07">7</a></sup> महत्-महान्-महान्तौ-महान्तः, <sup id="ref_krm_1246_08"><a href="#foot_krm_1246_08">8</a></sup> माहिनम्-महिनम्, महिमा, इत्यादीनि रूपाणि अस्य धातोः विशेषेण संभवन्तीति विशेषः। </li> <li>कर्मणि क्तप्रत्यये <sup id="ref_krm_1246_09"><a href="#foot_krm_1246_09">9</a></sup> महितम्-तः इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1246_01"><a href="#ref_krm_1246_01">↑</a> (१२३६)</li> <li id="foot_krm_1246_02"><a href="#ref_krm_1246_02">↑</a> (१-भ्वादिः-७३०। सक। सेट्। पर।)</li> <li id="foot_krm_1246_03"><a href="#ref_krm_1246_03">↑</a> (श्लो। १९६)</li> <li id="foot_krm_1246_04"><a href="#ref_krm_1246_04">↑</a> (५१४)</li> <li id="foot_krm_1246_05"><a href="#ref_krm_1246_05">↑</a> [[१। पचाद्यजन्तात् महशब्दात् गौरादित्वात् (४-१-४१) स्त्रियां ङीषि रूपमेवम्।]]</li> <li id="foot_krm_1246_06"><a href="#ref_krm_1246_06">↑</a> [[२। ‘अविमह्योष्टिषच्’ (द। उ। ९-३) इति टिषच्प्रत्यये महिषः इति रूपम्। टित्त्वात् स्त्रियां महिषी इति भवति। महिषा अस्मिन् सन्तीति महिष्मान् = देशः। ‘महिषाच्चेति वक्तव्यम्’ (वा। ४-२-८७) इति ‘तदस्मिन्नस्तीति देशे तन्नाम्नि’ (४-२-६७) इति विषये ड्मतुप्प्रत्यये डित्त्वाट्टिलोपे च रूपमेवम्।]]</li> <li id="foot_krm_1246_07"><a href="#ref_krm_1246_07">↑</a> [[३। ‘वर्त्तमाने पृषद्बृहन्महद्--’ (द। उ। ६-५) इति वर्तमानकाले कतिप्रत्यये शतृव- दित्यतिदेशान्नुमि, ‘सान्तमहतः संयोगस्य’ (६-४-१०) इत्यसंबुद्धौ सर्वनामस्थाने परतः उपधायाः दीर्घे च महान् इति रूपं सिध्यति।]]</li> <li id="foot_krm_1246_08"><a href="#ref_krm_1246_08">↑</a> [[४। ‘महेरिनण् च’ (द। उ। ५। १९) इति इनण्प्रत्यये माहिनम् इति, चकारात् इनन्प्रत्यये महिनम् इति च रूपम्। महिनम् = राज्यम्।]]</li> <li id="foot_krm_1246_09"><a href="#ref_krm_1246_09">↑</a> [[आ। ‘चाहेनामहितस्य चास्य निधनोद्योगं रहस्यूचिवान्…।।’ धा। का। १। ९१।]]</li></ul></p>

मह|महकः-हिका|मिमहयिषकः-षिका|महयिता-त्री|मिमहयिषिता-त्री
<ul><li><sup id="ref_krm_1247_01"><a href="#foot_krm_1247_01">1</a></sup> {@“मह पूजायाम्”@} <sup id="ref_krm_1247_02"><a href="#foot_krm_1247_02">2</a></sup> अदन्तः, कथादिश्च। </li> <li>‘महयेत् महतीत्येते पूजायां णौ शपि क्रमात्।’ <sup id="ref_krm_1247_03"><a href="#foot_krm_1247_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_1247_04"><a href="#foot_krm_1247_04">4</a></sup> महकः-हिका, मिमहयिषकः-षिका;</li> <li>  महयिता-त्री, मिमहयिषिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकचहयतिवत् <sup id="ref_krm_1247_05"><a href="#foot_krm_1247_05">5</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_1247_06"><a href="#foot_krm_1247_06">6</a></sup> महः-मही, <sup id="ref_krm_1247_07"><a href="#foot_krm_1247_07">7</a></sup> मघवन्, इति रूपाणि विशेषेण भवन्ति इति ज्ञेयम्। </li> <li><sup id="ref_krm_1247_08"><a href="#foot_krm_1247_08">8</a></sup> णमुलि महम् २, महयित्वा २, इत्येकमेव रूपम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1247_01"><a href="#ref_krm_1247_01">↑</a> (१२३७)</li> <li id="foot_krm_1247_02"><a href="#ref_krm_1247_02">↑</a> (१०-चुरादिः-१८६८। सक। सेट्। उभ।)</li> <li id="foot_krm_1247_03"><a href="#ref_krm_1247_03">↑</a> (श्लो। १९६)</li> <li id="foot_krm_1247_04"><a href="#ref_krm_1247_04">↑</a> [[५। अस्य धातोः अदन्तेषु पाठसामर्थ्यात् अल्लोपस्य स्थानिवद्भावेन णिच्परत्वा- भावात् ‘अत उपधायाः’ (७-२-११६) इति वृद्धिर्नेति ज्ञेयम्।]]</li> <li id="foot_krm_1247_05"><a href="#ref_krm_1247_05">↑</a> (५१५)</li> <li id="foot_krm_1247_06"><a href="#ref_krm_1247_06">↑</a> [[६। ‘पुंसि संज्ञायां घः--’ (३-३-११८) इति घप्रत्यये रूपमेवम्। स्त्रियां गौरादिपाठात् (४-१-४१) ङीषि मही इति सिद्ध्यति।]]</li> <li id="foot_krm_1247_07"><a href="#ref_krm_1247_07">↑</a> [[७। ‘श्वन्नुक्षन्…’ (द। उ। ६-५५) इति कनिन्प्रत्यये घकारेऽन्तादेशे वुगागमे च निपातिते रूपमेवम्।]]</li> <li id="foot_krm_1247_08"><a href="#ref_krm_1247_08">↑</a> [पृष्ठम्१०१३+ २७]</li></ul></p>

महि|मंहकः-हिका|मिमंहिषकः-षिका|मामंहकः-हिका|मंहिता-त्री|मंहयिता-त्री|मिमंहिषिता-त्री|मामंहिता-त्री
<ul><li><sup id="ref_krm_1248_01"><a href="#foot_krm_1248_01">1</a></sup> {@“महि वृद्धौ”@} <sup id="ref_krm_1248_02"><a href="#foot_krm_1248_02">2</a></sup> मंहकः-हिका, मंहकः-हिका, मिमंहिषकः-षिका, मामंहकः-हिका;</li> <li>  मंहिता-त्री, मंहयिता-त्री, मिमंहिषिता-त्री, मामंहिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककण्ठतिवत् <sup id="ref_krm_1248_03"><a href="#foot_krm_1248_03">3</a></sup> ज्ञेयानि। </li> <li>कर्तरि क्तप्रत्यये मंहितः <sup id="ref_krm_1248_04"><a href="#foot_krm_1248_04">4</a></sup> इति, युचि-मंहनः इति च विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1248_01"><a href="#ref_krm_1248_01">↑</a> (१२३८)</li> <li id="foot_krm_1248_02"><a href="#ref_krm_1248_02">↑</a> (१-भ्वादिः-६३४। अक। सेट्। आत्म।)</li> <li id="foot_krm_1248_03"><a href="#ref_krm_1248_03">↑</a> (१४९)</li> <li id="foot_krm_1248_04"><a href="#ref_krm_1248_04">↑</a> [[आ। ‘अक्रूर एत्य बहुधागतमंहितांहाः…।।’ धा। का। १। ८०।]]</li></ul></p>

महि|मंहकः-हिका|मिमंहयिषकः-षिका|मिमंहिषकः-षिका|मामंहकः-हिका|मंहयिता-त्री|मिमंहयिषिता-त्री|मंहिता-त्री|मिमं-|हिषिता-त्री|मामंहिता-त्री
<ul><li><sup id="ref_krm_1249_01"><a href="#foot_krm_1249_01">1</a></sup> {@“महि भाषार्थः”@} <sup id="ref_krm_1249_02"><a href="#foot_krm_1249_02">2</a></sup> आस्वदीयः। </li> <li>‘--भासार्थः’ इति क्षीरस्वामी। </li> <li>मंहकः-हिका, मिमंहयिषकः-षिका, मंहकः-हिका, मिमंहिषकः-षिका, मामंहकः-हिका;</li> <li>  मंहयिता-त्री, मिमंहयिषिता-त्री, मंहिता-त्री, मिमं- हिषिता-त्री, मामंहिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिककुंश- यतिवत् <sup id="ref_krm_1249_03"><a href="#foot_krm_1249_03">3</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1249_01"><a href="#ref_krm_1249_01">↑</a> (१२३९)</li> <li id="foot_krm_1249_02"><a href="#ref_krm_1249_02">↑</a> (१०-चुरादिः-१८००। सक। सेट्। उभ।)</li> <li id="foot_krm_1249_03"><a href="#ref_krm_1249_03">↑</a> (२३२)</li></ul></p>

मा|मायकः-यिका|मापकः-पिका|मित्सकः-त्सिका|मेमीयकः-यिका|माता-त्री|मापयिता-त्री|मित्सिता-त्री|मेमीयिता-त्री|निर्मान्-न्ती-ती|मापयिष्यन्-न्ती-ती|मित्सिष्यन्-न्ती-ती|-|मापयमानः|मापयिष्यमाणः|मेमीयमानः|मेमीयिष्यमाणः|प्रमीः-प्रम्यौ-प्रम्यः|-मितम्-तः-तवान्|मापितः|मित्सितः|मेमीयितः-तवान्|प्रमः|मायः|माया-मायावी-मायिकः-मायी|धान्यमायः|मापः|मित्सुः|मेम्यः|मातव्यम्|मापयितव्यम्|मित्सितव्यम्|मेमीयितव्यम्|प्रनिमानीयम्-प्रणिमानीयम्|मापनीयम्|मित्सनीयम्|मेमीयनीयम्|मेयम्|पाय्यम्|माप्यम्|मित्स्यम्|मेमीय्यम्|ईषन्मानः-दुर्मानः-सुमानः|-मीयमानः|माप्यमानः|मित्स्यमानः|मेमीय्यमानः|आमः|मित्सः|मेमीयः|मातुम्|मापयितुम्|मित्सितुम्|मेमीयितुम्|प्रमा-उपमा-अनुमा|प्रमितिः|मापना|मित्सा|मेमीया|प्रमाणम्|मापनम्|मित्सनम्|मेमीयनम्|मित्वा|मापयित्वा|मित्सित्वा|मेमीयित्वा|प्रमाय|प्रमाप्य|प्रमित्स्य|प्रमेमीय्य|मायम्|मापम्|मित्सम्|मेमीयम्
<ul><li><sup id="ref_krm_1250_01"><a href="#foot_krm_1250_01">1</a></sup> {@“मा माने”@} <sup id="ref_krm_1250_02"><a href="#foot_krm_1250_02">2</a></sup> ‘मिमीते मायते माने माति तत्रैव शब्लुकि।’ <sup id="ref_krm_1250_03"><a href="#foot_krm_1250_03">3</a></sup> इति देवः। </li> <li>‘मानम् = वर्तनम्’ इति क्षीरस्वामी। </li> <li>‘-- अन्तर्भावः’ इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>‘आधेयस्याधाराद् अनधिकपरिमाणताऽत्र मानम्।’ इति पुरुषकारः। </li> <li><sup id="ref_krm_1250_04"><a href="#foot_krm_1250_04">4</a></sup> मायकः-यिका, <sup id="ref_krm_1250_05"><a href="#foot_krm_1250_05">5</a></sup> मापकः-पिका, <sup id="ref_krm_1250_06"><a href="#foot_krm_1250_06">6</a></sup> मित्सकः-त्सिका, <sup id="ref_krm_1250_07"><a href="#foot_krm_1250_07">7</a></sup> मेमीयकः-यिका;</li> <li>  माता-त्री, मापयिता-त्री, मित्सिता-त्री, मेमीयिता-त्री;</li> <li>  <sup id="ref_krm_1250_08"><a href="#foot_krm_1250_08">8</a></sup> <sup id="ref_krm_1250_09"><a href="#foot_krm_1250_09">9</a></sup> निर्मान्- <sup id="ref_krm_1250_10"><a href="#foot_krm_1250_10">10</a></sup> न्ती-ती, मापयिष्यन्-न्ती-ती, मित्सिष्यन्-न्ती-ती;</li> <li>  -- -- मापयमानः, मापयिष्यमाणः, -- मेमीयमानः, मेमीयिष्यमाणः;</li> <li>  प्रमीः-प्रम्यौ-प्रम्यः;</li> <li>  -- -- -- <sup id="ref_krm_1250_11"><a href="#foot_krm_1250_11">11</a></sup> मितम्-तः-तवान्, मापितः, मित्सितः, मेमीयितः-तवान्;</li> <li>  <sup id="ref_krm_1250_12"><a href="#foot_krm_1250_12">12</a></sup> प्रमः, <sup id="ref_krm_1250_13"><a href="#foot_krm_1250_13">13</a></sup> मायः, माया-मायावी-मायिकः-मायी, <sup id="ref_krm_1250_14"><a href="#foot_krm_1250_14">14</a></sup> धान्यमायः, मापः, मित्सुः, <sup id="ref_krm_1250_15"><a href="#foot_krm_1250_15">15</a></sup> मेम्यः;</li> <li>  मातव्यम्, मापयितव्यम्, मित्सितव्यम्, मेमीयितव्यम्;</li> <li>  <sup id="ref_krm_1250_16"><a href="#foot_krm_1250_16">16</a></sup> प्रनिमानीयम्-प्रणिमानीयम्, मापनीयम्, मित्सनीयम्, मेमीयनीयम्;</li> <li>  <sup id="ref_krm_1250_17"><a href="#foot_krm_1250_17">17</a></sup> मेयम्, <sup id="ref_krm_1250_18"><a href="#foot_krm_1250_18">18</a></sup> पाय्यम्, माप्यम्, मित्स्यम्, मेमीय्यम्;</li> <li>  ईषन्मानः-दुर्मानः-सुमानः;</li> <li>  -- -- <sup id="ref_krm_1250_19"><a href="#foot_krm_1250_19">19</a></sup> <sup id="ref_krm_1250_20"><a href="#foot_krm_1250_20">20</a></sup> मीयमानः, माप्यमानः, मित्स्यमानः, मेमीय्यमानः;</li> <li>  मायः, <sup id="ref_krm_1250_21"><a href="#foot_krm_1250_21">21</a></sup> आमः, मापः, मित्सः, मेमीयः;</li> <li>  मातुम्, मापयितुम्, मित्सितुम्, मेमीयितुम्;</li> <li>  <sup id="ref_krm_1250_22"><a href="#foot_krm_1250_22">22</a></sup> प्रमा-उपमा-अनुमा, प्रमितिः, मापना, मित्सा, मेमीया;</li> <li>  प्रमाणम्, मापनम्, मित्सनम्, मेमीयनम्;</li> <li>  मित्वा, मापयित्वा, मित्सित्वा, मेमीयित्वा;</li> <li>  <sup id="ref_krm_1250_23"><a href="#foot_krm_1250_23">23</a></sup> प्रमाय, प्रमाप्य, प्रमित्स्य, प्रमेमीय्य;</li> <li>  मायम् २, मित्वा २, मापम् २, मापयित्वा २, मित्सम् २, मित्सित्वा २, मेमीयम् २;</li> <li>  मेमीयित्वा २;</li> <li>  <sup id="ref_krm_1250_24"><a href="#foot_krm_1250_24">24</a></sup> मेरुः, <sup id="ref_krm_1250_25"><a href="#foot_krm_1250_25">25</a></sup> मात्रा, <sup id="ref_krm_1250_26"><a href="#foot_krm_1250_26">26</a></sup> मासः। </li> <li><sup id="ref_krm_1250_27"><a href="#foot_krm_1250_27">27</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1250_01"><a href="#ref_krm_1250_01">↑</a> (१२४०)</li> <li id="foot_krm_1250_02"><a href="#ref_krm_1250_02">↑</a> (२-अदादिः-१०६२। सक। अनि। पर।)</li> <li id="foot_krm_1250_03"><a href="#ref_krm_1250_03">↑</a> (श्लो। ९)</li> <li id="foot_krm_1250_04"><a href="#ref_krm_1250_04">↑</a> [[१। ण्वुलि ‘आतो युक् चिण्कृतोः’ (७-३-३३) इति युगागमः। एवं घञ्णमुलादिष्वपि ज्ञेयम्।]]</li> <li id="foot_krm_1250_05"><a href="#ref_krm_1250_05">↑</a> [[२। ण्यन्ते सर्वत्र ‘अर्त्तिह्रीव्ली--’ (७-३-३६) इति आदन्तलक्षणे पुगागमे रूपमेवम्।]]</li> <li id="foot_krm_1250_06"><a href="#ref_krm_1250_06">↑</a> [[३। ‘सनि मीमाघु--’ (७-४-५४) इत्यादिना इस्भावे, ‘अत्र लोपोऽभ्यासस्य’ (७-४-५८) इत्यभ्यासलोपे, ‘सः स्यार्धधातुके’ (७-४-४९) इति सकारस्य तकारे, ‘हलन्ताच्च’ (१-२-१०) इति सनः कित्त्वेन गुणाभावे च रूपमेवम्। एवं सन्नन्ते सर्वत्र प्रक्रिया ज्ञेया।]]</li> <li id="foot_krm_1250_07"><a href="#ref_krm_1250_07">↑</a> [[४। यङन्ते सर्वत्र, ‘घुमास्था--’ (६-४-६६) इतीकारे, ‘गुणो यङ्लुकोः’ (७-४-८२) इत्यभ्यासे गुणः।]]</li> <li id="foot_krm_1250_08"><a href="#ref_krm_1250_08">↑</a> [पृष्ठम्१०१४+ २४]</li> <li id="foot_krm_1250_09"><a href="#ref_krm_1250_09">↑</a> [[१। शतरि, अदादित्वेन शपो लुकि, सवर्णदीर्घे, ‘आच्छीनद्योर्नुम्’ (७-१-८०) इति स्त्रियां नुम्विकल्पे च निर्मान्ती-निर्माती इति रूपद्वयम् इति ज्ञेयम्।]]</li> <li id="foot_krm_1250_10"><a href="#ref_krm_1250_10">↑</a> [[आ। ‘ख्यान्त्यः कथाः प्राणमुदां पतीनां निर्मान्त्य इष्टानि चट्न् वचत्यः।’ धा। का। २। ५०।]]</li> <li id="foot_krm_1250_11"><a href="#ref_krm_1250_11">↑</a> [[२। ‘द्यतिस्यतिमास्थाम् इत् ति किति’ (७-४-४०) इति क्तप्रत्यये परतः प्रकृतेः इकारः। गुणनिषेधः। एवं क्त्वाक्तिन्प्रभृतिष्वपीकारो बोध्यः।]]</li> <li id="foot_krm_1250_12"><a href="#ref_krm_1250_12">↑</a> [[३। ‘आतश्चोपसर्गे’ (३-१-१३६) इति कर्तरि कप्रत्ययः। ‘आतो लोप इटि च’ (६-४-६४) इत्याकारलोपः।]]</li> <li id="foot_krm_1250_13"><a href="#ref_krm_1250_13">↑</a> [[४। ‘श्याऽऽद्व्यध--’ (३-१-१४१) इत्यादिना कर्तरि आदन्तलक्षणो णप्रत्ययः। ‘आतो युक् चिण्कृतोः’ (७-३-३३) इति युगागमः। स्त्रियां टापि माया इति सिद्ध्यति। मायाशब्दात् मत्वर्थीये विनिप्रत्यये मायावी इति, व्रीह्यादित्वात् (५-२-११६) इनिठन्प्रत्यययोश्च मायी-मायिकः इति च रूपाणि सिद्ध्यन्ति।]]</li> <li id="foot_krm_1250_14"><a href="#ref_krm_1250_14">↑</a> [[५। कर्मण्युपपदे कर्तरि, ‘ह्वावामश्च’ (३-२-२) इत्यण्प्रत्यये युगागमे च रूपमेवम्। ‘आतोऽनुपसर्गे कः’ (३-२-३) इति प्राप्तस्य कप्रत्ययस्यापवादः।]]</li> <li id="foot_krm_1250_15"><a href="#ref_krm_1250_15">↑</a> [[६। यङन्तात् पचाद्यचि (३-१-१३४), ‘यङोऽचि च’ (२-४-७४) इति यङो लुकि ईकारे, उत्तरखण्डे यणि च रूपमेवम्।]]</li> <li id="foot_krm_1250_16"><a href="#ref_krm_1250_16">↑</a> [[७। ‘शेषे विभाषा--’ (८-४-१८) इति नेर्णत्वविकल्पः। ‘नेर्गदनदपतपदघुमा --’ (८-४-१७) इत्यत्र नास्य धातोर्ग्रहणम्, अपि तु माङ्मेङोरेव ग्रहणम् इति बहवः।]]</li> <li id="foot_krm_1250_17"><a href="#ref_krm_1250_17">↑</a> [[८। यति परे, ‘ईद् यति’ (६-४-६५) इति ईकारे गुणे च रूपमेवम्।]]</li> <li id="foot_krm_1250_18"><a href="#ref_krm_1250_18">↑</a> [[९। माने = परिमाणेऽभिधेये ‘पाय्यसान्नाय्यनिकाय्यधाय्या मानहविर्निवाससामिधे- नीषु’ (३-१-१२९) इत्यनेन ण्यदायादेशौ आदेः पकारश्च निपात्यन्ते।]]</li> <li id="foot_krm_1250_19"><a href="#ref_krm_1250_19">↑</a> [पृष्ठम्१०१५+ २५]</li> <li id="foot_krm_1250_20"><a href="#ref_krm_1250_20">↑</a> [[१। यगन्ताच्छानशि ईकारे मीयमानः इति सिद्ध्यति। क्षीरस्वामी तु ‘घुमास्था- --’ (६-४-६६) इति सूत्रे नास्य धातोर्ग्रहणमिति ‘सर्वत्र हि पामाग्रहणं लुग्विकरणस्य णत्ववर्जम्’ इति वचनं किञ्चिदुपादाय मायते इति यकि रूपं साधितवान् भाष्यादिषु नैतादृशं वचनमुपलभ्यते। प्रक्रियाकौमुदीकारं वर्जयित्वा सर्वेऽपि ‘गामादाग्रहणेष्वविशेषः’ (परि। ११६) इति परिभाषामवलम्ब्य ‘घुमास्था--’ (६-४-६६) इत्यादिषु सर्वत्र माग्रहणेष्वस्यापि ग्रहणमिच्छन्ति। स्पष्टमिदं माधवधातुवृत्त्यादिषु।]]</li> <li id="foot_krm_1250_21"><a href="#ref_krm_1250_21">↑</a> [[२। आ = समन्तात् मीयतेऽत्रेति आमः = अपक्वपदार्थः। अधिकरणे ‘घञर्थे कविधानम्--’ (वा। ३-३-५८) इति कप्रत्यये, आकारलोपे रूपमेवम्।]]</li> <li id="foot_krm_1250_22"><a href="#ref_krm_1250_22">↑</a> [[३। स्त्रियां भावादौ, ‘आतश्चोपसर्गे’ (३-३-१०६) इति क्तिन्नपवादोऽङ्प्रत्ययः। ‘आतो लोप इटि च’ (६-४-६४) इत्याकारलोपे अदन्तत्वेन टापि प्रमा, उपमा इत्यादिकं सिद्ध्यति। प्रमितिः, उपमितिः, अनुमितिः इत्यादयस्तु बाहुलकात् क्तिनि सिद्ध्यन्तीति ज्ञेयम्।]]</li> <li id="foot_krm_1250_23"><a href="#ref_krm_1250_23">↑</a> [[४। समासे क्त्वाप्रत्ययस्य ल्यबादेशे, ‘न ल्यपि’ (६-४-६९) इतीकारनिषेधः।]]</li> <li id="foot_krm_1250_24"><a href="#ref_krm_1250_24">↑</a> [[५। ‘मापो रुरी च’ (द। उ। १-१५७) इति रुप्रत्यये ईकारे चान्तादेशे गुणे रूपमेवम्। माति सूर्येन्दुभ्यामिति मेरुः = सुरगिरिः।]]</li> <li id="foot_krm_1250_25"><a href="#ref_krm_1250_25">↑</a> [[६। ‘हुयामा--’ (द। उ। ८। ८४) इति त्रन्प्रत्यये रूपमेवम्। मीयतेऽनेनेति मात्रा = अल्पपरिमाणम्।]]</li> <li id="foot_krm_1250_26"><a href="#ref_krm_1250_26">↑</a> [[७। मातीत्यर्थे ‘मासश्च’ (द। उ। ९। २७) इति सप्रत्ययो निपात्यते। मासः = त्रिंशद्दिनपरिच्छिन्नः कालविशेषः।]]</li> <li id="foot_krm_1250_27"><a href="#ref_krm_1250_27">↑</a> [पृष्ठम्१०१६+ २७]</li></ul></p>

माक्षि|माङ्क्षकः-क्षिका|मिमाङ्क्षिषकः-षिका|मामाङ्क्षकः-|क्षिका|माङ्क्षिता-त्री|माङ्क्षयिता-त्री|मिमाङ्क्षिषिता-त्री|मामाङ्-|क्षिता-त्री
<ul><li><sup id="ref_krm_1251_01"><a href="#foot_krm_1251_01">1</a></sup> {@“माक्षि काङ्क्षायाम्”@} <sup id="ref_krm_1251_02"><a href="#foot_krm_1251_02">2</a></sup> माङ्क्षकः-क्षिका, माङ्क्षकः-क्षिका, मिमाङ्क्षिषकः-षिका, मामाङ्क्षकः- क्षिका;</li> <li>  माङ्क्षिता-त्री, माङ्क्षयिता-त्री, मिमाङ्क्षिषिता-त्री, मामाङ्- क्षिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककाङ्क्षतिवत् <sup id="ref_krm_1251_03"><a href="#foot_krm_1251_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1251_04"><a href="#foot_krm_1251_04">4</a></sup> ण्यति माङ्क्ष्यः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1251_01"><a href="#ref_krm_1251_01">↑</a> (१२४१)</li> <li id="foot_krm_1251_02"><a href="#ref_krm_1251_02">↑</a> (१-भ्वादिः-६६९। सक। सेट्। पर।)</li> <li id="foot_krm_1251_03"><a href="#ref_krm_1251_03">↑</a> (१८३)</li> <li id="foot_krm_1251_04"><a href="#ref_krm_1251_04">↑</a> [[आ। ‘सूर्क्ष्य! त्वदीक्षा चिरकाङ्क्षिता नो वाङ्क्षाम्यमाङ्क्ष्यान् न तु नीचलोकान्।’ धा। का। १। ८५।]]</li></ul></p>

माङ्|मायकः-यिका|मापकः-पिका|मित्सकः-त्सिका|मेमीयकः-यिका|माता-त्री|मापयिता-त्री|मित्सिता-त्री|मेमीयिता-त्री
<ul><li><sup id="ref_krm_1252_01"><a href="#foot_krm_1252_01">1</a></sup> {@“माङ् माने शब्दे च”@} <sup id="ref_krm_1252_02"><a href="#foot_krm_1252_02">2</a></sup> ‘मिमीते मायते माने माति तत्रैव शब्लुकि। </li> <li>मयते प्रणिदानेऽर्थे--।।’ <sup id="ref_krm_1252_03"><a href="#foot_krm_1252_03">3</a></sup> इति देवः। </li> <li>मायकः-यिका, मापकः-पिका, मित्सकः-त्सिका, मेमीयकः-यिका;</li> <li>  माता-त्री, मापयिता-त्री, मित्सिता-त्री, मेमीयिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि आदादिकमातिवत् <sup id="ref_krm_1252_04"><a href="#foot_krm_1252_04">4</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_1252_05"><a href="#foot_krm_1252_05">5</a></sup> मिमानः, <sup id="ref_krm_1252_06"><a href="#foot_krm_1252_06">6</a></sup> वातप्रमीः-वातप्रम्यौ-वातप्रम्यः, <sup id="ref_krm_1252_07"><a href="#foot_krm_1252_07">7</a></sup> प्रणिमानम्-प्रणिमापनम्, मेयम्, पाय्यम्, <sup id="ref_krm_1252_08"><a href="#foot_krm_1252_08">8</a></sup> व्योममायः, <sup id="ref_krm_1252_09"><a href="#foot_krm_1252_09">9</a></sup> चन्द्रमाः इमानि रूपाण्यधिकान्यत्रेति विशेषः। </li> <li>अस्य धातोः आत्मनेपदित्वात् शानचि-अनुमिमानः, मित्समानः, मास्यमानः, मित्स्यमानः, इति विशेषः। </li> <li><sup id="ref_krm_1252_10"><a href="#foot_krm_1252_10">10</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1252_01"><a href="#ref_krm_1252_01">↑</a> (१२४२)</li> <li id="foot_krm_1252_02"><a href="#ref_krm_1252_02">↑</a> (३-जुहोत्यादिः-१०८८। सक-अक। अनि। आत्म।)</li> <li id="foot_krm_1252_03"><a href="#ref_krm_1252_03">↑</a> (श्लो। ९)</li> <li id="foot_krm_1252_04"><a href="#ref_krm_1252_04">↑</a> (१२४०)</li> <li id="foot_krm_1252_05"><a href="#ref_krm_1252_05">↑</a> [[१। शानचि, ‘जुहोत्यादिभ्यः--’ (२-४-७५) इति शपः श्लुः। ‘श्लौ’ (६-१-१०) इति द्विर्वचने, ‘भृञामित्’ (७-४-७६) इत्यभ्यासस्येकारः। ‘श्नाऽभ्यस्तयोरातः’ (६-४-११२) इत्याकारलोपः।]]</li> <li id="foot_krm_1252_06"><a href="#ref_krm_1252_06">↑</a> [[२। वातं प्रमिमीते इत्यर्थे ‘क्विप् च’ (३-२-७६) इति कर्मण्युपपदे क्विपि ‘घुमास्थागा- पाजहातिसां हलि’ (६-४-६६) इतीकारे रूपमेवम्। ‘ईत्वे वकारप्रतिषेधः--’ (वा। ६-४-६६) इति वचनं तु श्रूयमाणवकारादिषत्ययविषयकमिति नात्र प्रवर्तते। वातप्रमीः शमीवृक्षः, पक्षिविशेषश्च।]]</li> <li id="foot_krm_1252_07"><a href="#ref_krm_1252_07">↑</a> [[३। ‘नेर्गदनदपतपदघुमा--’ (८-४-१७) इत्यादिना उपसर्गस्थान्निमित्तात् परस्य नेर्णत्वम्। एवं ण्यन्तेऽपि णत्वं ज्ञेयम्।]]</li> <li id="foot_krm_1252_08"><a href="#ref_krm_1252_08">↑</a> [[B। ‘जगाम सपरीवारो व्योममायमिवोत्थितम्।।’ भ। का। ६। ८८।]]</li> <li id="foot_krm_1252_09"><a href="#ref_krm_1252_09">↑</a> [[४। ‘चन्द्रे मो डित्’ (द। उ। ९-८८) इत्यनेन चन्द्रशब्द उपपदे धातोरस्यासिप्रत्यये तस्य च डिद्वद्भावेन टिलोपे च रूपमेवम्।]]</li> <li id="foot_krm_1252_10"><a href="#ref_krm_1252_10">↑</a> [पृष्ठम्१०१७+ ३०]</li></ul></p>

माङ्|मायकः-यिका|मापकः-पिका|मित्सकः-त्सिका|मेमीयकः-यिका|माता-त्री|मापयिता-त्री|मित्सिता-त्री|मेमीयिता-त्री
<ul><li><sup id="ref_krm_1253_01"><a href="#foot_krm_1253_01">1</a></sup> {@“माङ् माने”@} <sup id="ref_krm_1253_02"><a href="#foot_krm_1253_02">2</a></sup> ‘मिमीते मायते माने माति तत्रैव शब्लुकि।’ <sup id="ref_krm_1253_03"><a href="#foot_krm_1253_03">3</a></sup> इति देवः। </li> <li>दुर्गादयः केचिदेवामुं धातुं पठन्ति। </li> <li>क्षीरस्वामिप्रभृतयस्तु न पठन्ति। </li> <li>मायकः-यिका, मापकः-पिका, मित्सकः-त्सिका, मेमीयकः-यिका;</li> <li>  माता-त्री, मापयिता-त्री, मित्सिता-त्री, मेमीयिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि आदादिकमातिवत् <sup id="ref_krm_1253_04"><a href="#foot_krm_1253_04">4</a></sup> ज्ञेयानि। </li> <li>शानचि, <sup id="ref_krm_1253_05"><a href="#foot_krm_1253_05">5</a></sup> मायमानः इति रूपम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1253_01"><a href="#ref_krm_1253_01">↑</a> (१२४३)</li> <li id="foot_krm_1253_02"><a href="#ref_krm_1253_02">↑</a> (४-दिवादिः-११४२। सक। अनि। आत्म।)</li> <li id="foot_krm_1253_03"><a href="#ref_krm_1253_03">↑</a> (श्लो। ९)</li> <li id="foot_krm_1253_04"><a href="#ref_krm_1253_04">↑</a> (१२४०)</li> <li id="foot_krm_1253_05"><a href="#ref_krm_1253_05">↑</a> [[१। शानचि, ‘दिवादिभ्यः--’ (३-१-६९) इति श्यनि, रूपमेवम्। अत्र श्यनोऽपि- त्सार्वधातुकत्वेन ङिद्वद्भावात् ‘घुमास्था--’ (६-४-६६) इति ईकारे सति मीयमानः इत्येव न्याय्यम्। ‘गामादाग्रहणेष्वविशेषः’ (परि। ११६) इति वचनमप्यस्य ईकारे ऽनुकूलम्। तथापि सर्वैरपि वैयाकरणैः ‘घुमास्था--’ (६-४-६६) सूत्रे भौवादिका- दादिकजौहोत्यादिकमाधातूनामेव ग्रहणस्योक्तत्वात् अत्र न ईकार इति ज्ञेयम्।]]</li></ul></p>

मान|मीमांसकः-सिका|मीमांस्दकः-सिका|मीमांसयिषकः-षिका|मानकः-|निका|मीमांसिता-त्री|मीमांसयिता-त्री|मीमांसयिषिता-त्री|मान-|यिता-त्री
<ul><li><sup id="ref_krm_1254_01"><a href="#foot_krm_1254_01">1</a></sup> {@“मान पूजायाम्”@} <sup id="ref_krm_1254_02"><a href="#foot_krm_1254_02">2</a></sup> <sup id="ref_krm_1254_03"><a href="#foot_krm_1254_03">3</a></sup> ‘मानेर्जिज्ञासायाम्’ इति <sup id="ref_krm_1254_04"><a href="#foot_krm_1254_04">4</a></sup> वचनात् पूजितविचारे धातोरस्य नित्यसन्नन्तत्वम्। </li> <li>न तु इच्छार्थकः सन्। </li> <li>‘नित्यसन्नन्तत्वसाधनाच्च धातोः पृथक् प्रयोगाभावात् पूजाद्यर्थपाठो व्यर्थः’ इति हरदत्तादयः। </li> <li>स्वार्थसन्नन्तात् क्रमेण ण्यन्तस्म, इच्छासन्नन्तस्य च प्रयोगः प्रदर्शित इति ज्ञेयम्।]] ‘पूजायां मानयेत् मानेत् यौ, मीमांसेत तङ्सनोः।’ <sup id="ref_krm_1254_05"><a href="#foot_krm_1254_05">5</a></sup> इति देवः। </li> <li><sup id="ref_krm_1254_06"><a href="#foot_krm_1254_06">6</a></sup> मीमांसकः-सिका, मीमांस्दकः-सिका, मीमांसयिषकः-षिका, <sup id="ref_krm_1254_07"><a href="#foot_krm_1254_07">7</a></sup> मानकः- निका;</li> <li>  मीमांसिता-त्री, मीमांसयिता-त्री, मीमांसयिषिता-त्री, मान- यिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकदीदांसतिवत् <sup id="ref_krm_1254_08"><a href="#foot_krm_1254_08">8</a></sup> ज्ञेयानि। </li> <li>अस्यात्मनेपदित्वात् शानजेव, न शतेति विशेषः। </li> <li><sup id="ref_krm_1254_09"><a href="#foot_krm_1254_09">9</a></sup> माता। </li> <li><sup id="ref_krm_1254_10"><a href="#foot_krm_1254_10">10</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1254_01"><a href="#ref_krm_1254_01">↑</a> (१२४४)</li> <li id="foot_krm_1254_02"><a href="#ref_krm_1254_02">↑</a> (१-भ्वादिः-९७२। सक। सेट्। आत्म।)</li> <li id="foot_krm_1254_03"><a href="#ref_krm_1254_03">↑</a> [[[अ]</li> <li id="foot_krm_1254_04"><a href="#ref_krm_1254_04">↑</a> (काशिका ३-१-६)</li> <li id="foot_krm_1254_05"><a href="#ref_krm_1254_05">↑</a> (श्लो। १२६)</li> <li id="foot_krm_1254_06"><a href="#ref_krm_1254_06">↑</a> [[२। ‘मान्बधदान्शान्भ्यो दीर्घश्चाभ्यासस्य’ (३-१-६) इति स्वार्थे सन्। अभ्यासकार्येषु प्रवृत्तेषु दीर्घश्चाभ्यासस्य भवति। एवमेवोत्तरत्र सर्वत्रापि ज्ञेयम्।]]</li> <li id="foot_krm_1254_07"><a href="#ref_krm_1254_07">↑</a> [[३। ‘अवयवे कृतं लिङ्गं समुदायस्य विशेषकं भवति’ (भाष्यम् ३-१-६) इति वचनात् स्वार्थसन्नन्तादेवास्यात्मनेपदत्वम्, अर्थान्तरे तु चुरादिपाठ उन्नेयः। तदानीं ‘शेषात् कर्तरि--’ (१-३-७८) इति परस्मैपदम्। स्वार्थसन्नपि अर्थान्तरे न भवति इत्यतः मानकः-निका, मानयिता-त्री, मानयन्-न्ती इत्यादीनि रूपाण्यूह्यानि।]]</li> <li id="foot_krm_1254_08"><a href="#ref_krm_1254_08">↑</a> (८३२)</li> <li id="foot_krm_1254_09"><a href="#ref_krm_1254_09">↑</a> [[४। ‘नप्तृनेष्टृ--’ (द। उ। २-३) इत्यादिना तृन्तृचोः प्रत्यययोः नकारलोपे च रूपमेवम्। माता = जननी।]]</li> <li id="foot_krm_1254_10"><a href="#ref_krm_1254_10">↑</a> [पृष्ठम्१०१८+ २८]</li></ul></p>

मान|मानकः-निका|मिमानयिषकः-षिका|मिमानिषकः-षिका|मामानकः-निका|मानयिता-त्री|मिमानयिषिता-त्री|मानिता-त्री|मिमानि-|षिता-त्री|मामानिता-त्री
<ul><li><sup id="ref_krm_1255_01"><a href="#foot_krm_1255_01">1</a></sup> {@“मान पूजायाम्”@} <sup id="ref_krm_1255_02"><a href="#foot_krm_1255_02">2</a></sup> आधृषीयः। </li> <li>‘पूजायां मानयेत् मानेत् यौ, मीमांसेत तङ्सनोः।’ <sup id="ref_krm_1255_03"><a href="#foot_krm_1255_03">3</a></sup> इति देवः। </li> <li>मानकः-निका, मिमानयिषकः-षिका, मानकः-निका, मिमानिषकः-षिका, मामानकः-निका;</li> <li>  मानयिता-त्री, मिमानयिषिता-त्री, मानिता-त्री, मिमानि- षिता-त्री, मामानिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकचीकयति- वत् <sup id="ref_krm_1255_04"><a href="#foot_krm_1255_04">4</a></sup> ज्ञेयानि। </li> <li>धातोरस्याधृषीयत्वेन ‘आधृषाद्वा’ <sup id="ref_krm_1255_05"><a href="#foot_krm_1255_05">5</a></sup> इति णिज्विकल्पः। </li> <li>तेन णिजभावपक्षे क्रमेण शुद्धात्, शुद्धप्रकृतिक- सन्नन्तात्, शुद्धप्रकृतिकयङन्तादपि रूपाणि विलिखितानीति ज्ञेयम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1255_01"><a href="#ref_krm_1255_01">↑</a> (१२४५)</li> <li id="foot_krm_1255_02"><a href="#ref_krm_1255_02">↑</a> (१०-चुरादिः-१८४४। सक। सेट्। उभ।)</li> <li id="foot_krm_1255_03"><a href="#ref_krm_1255_03">↑</a> (श्लो। १२६)</li> <li id="foot_krm_1255_04"><a href="#ref_krm_1255_04">↑</a> (५२९)</li> <li id="foot_krm_1255_05"><a href="#ref_krm_1255_05">↑</a> (ग। सू। चुरादौ)</li></ul></p>

मान्थ|मान्थकः-न्थिका|मिमान्थिषकः-षिका|मामाथकः-थिका|मान्थिता-त्री|मान्थयिता-त्री|मिमान्थिषिता-त्री|मामाथिता-त्री
<ul><li><sup id="ref_krm_1256_01"><a href="#foot_krm_1256_01">1</a></sup> {@“मान्थ हिंसासंक्लेशनयोः”@} <sup id="ref_krm_1256_02"><a href="#foot_krm_1256_02">2</a></sup> “-- ‘मथि--’ इत्यपि दौर्गाः” इति क्षीरस्वामी। </li> <li>सिद्धान्तकौमुद्यादिषु, धातुरयं न पठ्यते। </li> <li>‘हिंसा = प्राण्युपघातः, संक्लेशः = बाधा।’ इति क्षीरस्वामी। </li> <li>मान्थकः-न्थिका, मान्थकः-न्थिका, मिमान्थिषकः-षिका, <sup id="ref_krm_1256_03"><a href="#foot_krm_1256_03">3</a></sup> मामाथकः-थिका;</li> <li>  मान्थिता-त्री, मान्थयिता-त्री, मिमान्थिषिता-त्री, मामाथिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि क्रैयादिककुथ्नातिवत् <sup id="ref_krm_1256_04"><a href="#foot_krm_1256_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1256_05"><a href="#foot_krm_1256_05">5</a></sup>न्थित्वा इत्येकमेव रूपमिति ज्ञेयम्।]] मान्थित्वा-माथित्वा, <sup id="ref_krm_1256_06"><a href="#foot_krm_1256_06">6</a></sup> प्रमान्थनम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1256_01"><a href="#ref_krm_1256_01">↑</a> (१२४६)</li> <li id="foot_krm_1256_02"><a href="#ref_krm_1256_02">↑</a> (१-भ्वादिः-४६। सक। सेट्। पर।)</li> <li id="foot_krm_1256_03"><a href="#ref_krm_1256_03">↑</a> [[१। यङन्ते सर्वत्र यङ्निमित्तकः, ‘अनिदिताम्--’ (६-४-२४) इत्युपधानकारलोपः। क्षीरस्वाम्युपात्तदौर्गमते तु धातोरिदित्त्वात् नोपधानकारलोपस्य प्रसक्तिः, तदानीम्, मामान्थकः-न्थिका, मामान्थिता-त्री, इत्यादीनि रूपाणि यथायथमूह्यानि।]]</li> <li id="foot_krm_1256_04"><a href="#ref_krm_1256_04">↑</a> (२२३)</li> <li id="foot_krm_1256_05"><a href="#ref_krm_1256_05">↑</a> [[२। क्त्वायाम्, ‘नोपधात् थफान्ताद् वा’ (१-२-२३) इति कित्त्वविकल्पनाद् उपधानकारलोपपक्षे माथित्वा इति, तदभावपक्षे मान्थित्वा इति च रूपद्वयम्। दौर्गमते तु मा[म]</li> <li id="foot_krm_1256_06"><a href="#ref_krm_1256_06">↑</a> [[आ। ‘स भोजराडद्य हरिं मिमन्थिषुः प्रमान्थनं सेधतु, को निषेत्स्यति।।’ धा। का। १-७।]]</li></ul></p>

मार्ग|मार्गकः-र्गिका|मिमार्गयिषकः-षिका
<ul><li><sup id="ref_krm_1257_01"><a href="#foot_krm_1257_01">1</a></sup> {@“मार्ग संस्कारगत्योः”@} <sup id="ref_krm_1257_02"><a href="#foot_krm_1257_02">2</a></sup> <sup id="ref_krm_1257_03"><a href="#foot_krm_1257_03">3</a></sup> चुरादिषु ‘व्रज मार्ग संस्कारगत्योः’ इति पठ्यते। </li> <li>तत्र ‘मार्ग’ इति पृथग्धातु- रिति बहूनां पक्षः। </li> <li>तन्मतानुसारेणास्माभिरयमत्र लिख्यते।]] <sup id="ref_krm_1257_04"><a href="#foot_krm_1257_04">4</a></sup> ‘अन्वेषणेऽर्थे मृगयेत णौ यो मार्गेर्भवेन्मार्गति मार्गयेच्च।।’ <sup id="ref_krm_1257_05"><a href="#foot_krm_1257_05">5</a></sup> इति देवः। </li> <li>मार्गकः-र्गिका, मिमार्गयिषकः-षिका;</li> <li>  मार्गयिता-त्री, मिमार्गयिषिता-त्री, इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकगर्जयतिवत् <sup id="ref_krm_1257_06"><a href="#foot_krm_1257_06">6</a></sup> ज्ञेयानि। </li> <li>यति-- <sup id="ref_krm_1257_07"><a href="#foot_krm_1257_07">7</a></sup> मार्ग्यम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1257_01"><a href="#ref_krm_1257_01">↑</a> (१२४७)</li> <li id="foot_krm_1257_02"><a href="#ref_krm_1257_02">↑</a> (१०-चुरादिः-१६१८। सक। सेट्। उभ।)</li> <li id="foot_krm_1257_03"><a href="#ref_krm_1257_03">↑</a> [[[अ]</li> <li id="foot_krm_1257_04"><a href="#ref_krm_1257_04">↑</a> [पृष्ठम्१०१९+ २६]</li> <li id="foot_krm_1257_05"><a href="#ref_krm_1257_05">↑</a> (श्लो। ४४)</li> <li id="foot_krm_1257_06"><a href="#ref_krm_1257_06">↑</a> (३७८)</li> <li id="foot_krm_1257_07"><a href="#ref_krm_1257_07">↑</a> [[आ। ‘सुव्राजितेन मनसा परिमार्ग्य एषां तोषं व्यशुल्कयदसौ नयनप्रचम्पैः’।। धा। का। ३। २३।]]</li></ul></p>

मार्ग|मार्गकः-र्गिका|मिमार्गयिषकः-षिका|मिमार्गिषकः-|षिका|मामार्गकः-र्गिका|मार्गयिता-त्री|मिमार्गयिषिता-त्री|मार्गिता-त्री|मिमार्गिषिता-त्री|मामार्गिता-त्री
<ul><li><sup id="ref_krm_1258_01"><a href="#foot_krm_1258_01">1</a></sup> {@“मार्ग अन्वेषणे”@} <sup id="ref_krm_1258_02"><a href="#foot_krm_1258_02">2</a></sup> ‘अन्वेषणेऽर्थे मृगयेत णौ यो मार्गेर्भवेन्मार्गति मार्गयेच्च।।’ <sup id="ref_krm_1258_03"><a href="#foot_krm_1258_03">3</a></sup> इति देवः। </li> <li>आधृषीयत्वादस्य धातोर्णिज्विकल्पः। </li> <li>णिजभावपक्षे धातोरस्य भौवादिकत्वमिति ज्ञेयम्। </li> <li>मार्गकः-र्गिका, मिमार्गयिषकः-षिका, मार्गकः-र्गिका, मिमार्गिषकः- षिका, मामार्गकः-र्गिका;</li> <li>  मार्गयिता-त्री, मिमार्गयिषिता-त्री, मार्गिता-त्री, मिमार्गिषिता-त्री, मामार्गिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिक- चर्पयतिवत् <sup id="ref_krm_1258_04"><a href="#foot_krm_1258_04">4</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1258_01"><a href="#ref_krm_1258_01">↑</a> (१२४८)</li> <li id="foot_krm_1258_02"><a href="#ref_krm_1258_02">↑</a> (१०-चुरादिः-१८४७। सक। सेट्। उभ। आधृषीयः)</li> <li id="foot_krm_1258_03"><a href="#ref_krm_1258_03">↑</a> (श्लो। ४४)</li> <li id="foot_krm_1258_04"><a href="#ref_krm_1258_04">↑</a> (५५४)</li></ul></p>

मार्ज|मार्जकः-र्जिका|मिमार्जयिषकः-षिका|मार्जयिता-त्री|मिमार्जयि-षिता-त्री
<ul><li><sup id="ref_krm_1259_01"><a href="#foot_krm_1259_01">1</a></sup> {@“मार्ज शब्दार्थः”@} <sup id="ref_krm_1259_02"><a href="#foot_krm_1259_02">2</a></sup> ‘शौचालङ्कारयोर्वा णौ मृजेर्मार्जति मार्जयेत्।। </li> <li>मार्ष्टि शुद्धौ तथा मार्जेः शब्दार्थाद् मार्जयेण्णिचि।’ <sup id="ref_krm_1259_03"><a href="#foot_krm_1259_03">3</a></sup> इति देवः। </li> <li>‘शुद्धौ च इति द्रुमे।’ इति धा। </li> <li>का। </li> <li>व्या। </li> <li><sup id="ref_krm_1259_04"><a href="#foot_krm_1259_04">4</a></sup>। </li> <li>मार्जकः-र्जिका, मिमार्जयिषकः-षिका;</li> <li>  मार्जयिता-त्री, मिमार्जयि-षिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकगर्जयतिवत् <sup id="ref_krm_1259_05"><a href="#foot_krm_1259_05">5</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1259_06"><a href="#foot_krm_1259_06">6</a></sup> विमार्जनम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1259_01"><a href="#ref_krm_1259_01">↑</a> (१२४९)</li> <li id="foot_krm_1259_02"><a href="#ref_krm_1259_02">↑</a> (१०-चुरादिः-१६४९। अक। सेट्। उभ।)</li> <li id="foot_krm_1259_03"><a href="#ref_krm_1259_03">↑</a> (श्लो। ६०। ६१)</li> <li id="foot_krm_1259_04"><a href="#ref_krm_1259_04">↑</a> (३-२८)</li> <li id="foot_krm_1259_05"><a href="#ref_krm_1259_05">↑</a> (३७८)</li> <li id="foot_krm_1259_06"><a href="#ref_krm_1259_06">↑</a> [[B। ‘इत्थं सुगाजितमृदङ्गविमार्जनानि--’ धा। का। ३। २८।]]</li></ul></p>

माहृ|माहकः-हिका|मिमाहिषकः-षिका|मामाहकः-हिका|माहिता-त्री|माहयिता-त्री|मिमाहिषिता-त्री|मामाहिता-त्री
<ul><li><sup id="ref_krm_1260_01"><a href="#foot_krm_1260_01">1</a></sup> {@“माहृ माने”@} <sup id="ref_krm_1260_02"><a href="#foot_krm_1260_02">2</a></sup> ‘मानम् = वर्तनम्।’ इति क्षीरस्वामी। </li> <li>माहकः-हिका, माहकः-हिका, मिमाहिषकः-षिका, मामाहकः-हिका;</li> <li>  माहिता-त्री, माहयिता-त्री, मिमाहिषिता-त्री, मामाहिता-त्री;</li> <li>  इत्यादि- <sup id="ref_krm_1260_03"><a href="#foot_krm_1260_03">3</a></sup> कानि सर्वाण्यपि रूपाणि भौवादिककाशतिवत् <sup id="ref_krm_1260_04"><a href="#foot_krm_1260_04">4</a></sup> ज्ञेयानि। </li> <li>क्विपि प्रमाट्-प्रमाड्-प्रमाहौ-प्रमाहः इति रूपमिति विशेषः। </li> <li>अस्योभयपदित्वात् प्रमाहन्-न्ती-ती, माहिष्यन्-न्ती-ती, इत्यादीन्यपि रूपाणि शतरि स्यप्रत्यये च सम्भवन्ति। </li> <li>ण्यति- <sup id="ref_krm_1260_05"><a href="#foot_krm_1260_05">5</a></sup> अमाह्यः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1260_01"><a href="#ref_krm_1260_01">↑</a> (१२५०)</li> <li id="foot_krm_1260_02"><a href="#ref_krm_1260_02">↑</a> (१-भ्वादिः-८९५। सक। सेट्। उभ।)</li> <li id="foot_krm_1260_03"><a href="#ref_krm_1260_03">↑</a> [पृष्ठम्१०२०+ २४]</li> <li id="foot_krm_1260_04"><a href="#ref_krm_1260_04">↑</a> (१८६)</li> <li id="foot_krm_1260_05"><a href="#ref_krm_1260_05">↑</a> [[आ। ‘या दासते मोदममाह्यधाम्नां गूढाशयानामपि तापसानाम्।।’ धा। का। २। २८।]]</li></ul></p>

मिच्छ|मिच्छकः-च्छिका|मिमिच्छषकः-षिका|मेमिच्छकः-|च्छिका|मिच्छिता-त्री|मिच्छयिता-त्री|मिमिच्छिषिता-त्री|मेमिच्छिता-त्री
<ul><li><sup id="ref_krm_1261_01"><a href="#foot_krm_1261_01">1</a></sup> {@“मिच्छ उत्क्लेशे”@} <sup id="ref_krm_1261_02"><a href="#foot_krm_1261_02">2</a></sup> ‘उत्क्लेशः = बाधनम्’ इति क्षीरस्वामी। </li> <li>अस्य मते सकर्मकत्वम्। </li> <li>उत्क्लेशः = पीडा।’ इति धातुवृत्तिः। </li> <li>तदानीमकर्मकत्वम्। </li> <li><sup id="ref_krm_1261_03"><a href="#foot_krm_1261_03">3</a></sup> मिच्छकः-च्छिका, मिच्छकः-च्छिका, <sup id="ref_krm_1261_04"><a href="#foot_krm_1261_04">4</a></sup> मिमिच्छषकः-षिका, मेमिच्छकः- च्छिका;</li> <li>  मिच्छिता-त्री, मिच्छयिता-त्री, मिमिच्छिषिता-त्री, मेमिच्छिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकचिल्लतिवत् <sup id="ref_krm_1261_05"><a href="#foot_krm_1261_05">5</a></sup> ज्ञेयानि। </li> <li>शतरि-स्त्रियाम्, मिच्छन्-न्ती-ती, इति नुम् वा।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1261_01"><a href="#ref_krm_1261_01">↑</a> (१२५१)</li> <li id="foot_krm_1261_02"><a href="#ref_krm_1261_02">↑</a> (६-तुदादिः-१२९७। सक। सेट्। पर।)</li> <li id="foot_krm_1261_03"><a href="#ref_krm_1261_03">↑</a> [[१। ‘मिछ’ इत्येव धातुरुपदेशे पठ्यते। तस्य, ‘छे च’ (६-१-७३) इति तुकि, श्चुत्वे च मिच्छ इति सम्पद्यते। एवमेव सर्वत्रास्य तुग् ज्ञेयः।]]</li> <li id="foot_krm_1261_04"><a href="#ref_krm_1261_04">↑</a> [[२। सन्नन्ते गुणात् पूर्वम्, अन्तरङ्गत्वात् तुकि लघूपधत्वाभावात् न गुणः। एवमेव सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_1261_05"><a href="#ref_krm_1261_05">↑</a> (५२८)</li></ul></p>

मिजि|मिञ्जकः-ञ्जिका|मिमिञ्जयिषकः-षिका|मिमिञ्जिषकः-|षिका|मेमिञ्जकः-ञ्जिक|मिञ्जयिता-त्री|मिमिञ्जयिषिता-त्री|मिञ्जिता-त्री|मिमिञ्जिषिता-त्री|मेमिञ्जिता-त्री
<ul><li><sup id="ref_krm_1262_01"><a href="#foot_krm_1262_01">1</a></sup> {@“मिजि भाषार्थः”@} <sup id="ref_krm_1262_02"><a href="#foot_krm_1262_02">2</a></sup> आस्वदीयः। </li> <li>इदित्करणात् णिचो वैकल्पिकत्वम्। </li> <li>धातुरयं क्षीरस्वामिना नोपात्तः। </li> <li><sup id="ref_krm_1262_03"><a href="#foot_krm_1262_03">3</a></sup> मिञ्जकः-ञ्जिका, मिमिञ्जयिषकः-षिका, मिञ्जकः-ञ्जिका, मिमिञ्जिषकः- षिका, मेमिञ्जकः-ञ्जिक;</li> <li>  मिञ्जयिता-त्री, मिमिञ्जयिषिता-त्री, मिञ्जिता-त्री, मिमिञ्जिषिता-त्री, मेमिञ्जिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिककुंशयतिवत् <sup id="ref_krm_1262_04"><a href="#foot_krm_1262_04">4</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1262_01"><a href="#ref_krm_1262_01">↑</a> (१२५२)</li> <li id="foot_krm_1262_02"><a href="#ref_krm_1262_02">↑</a> (१०-चुरादिः-१७५७। सक। सेट्। उभ।)</li> <li id="foot_krm_1262_03"><a href="#ref_krm_1262_03">↑</a> [[३। इदित्त्वान्नुमि, अनुस्वारे परसवर्णे च रूपमेवम्। एवमेव सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_1262_04"><a href="#ref_krm_1262_04">↑</a> (२३२)</li></ul></p>

