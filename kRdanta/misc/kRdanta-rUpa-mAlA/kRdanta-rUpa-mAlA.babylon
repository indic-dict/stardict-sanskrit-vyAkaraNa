<ul><li><sup id="ref_krm_0262_01"><a href="#foot_krm_0262_01">1</a></sup> {@“कॄ विक्षेपे”@} <sup id="ref_krm_0262_02"><a href="#foot_krm_0262_02">2</a></sup> ‘कृणन् कृणीते हिंसायाम्, विक्षेपे किरतीति शे।।’ <sup id="ref_krm_0262_03"><a href="#foot_krm_0262_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_0262_04"><a href="#foot_krm_0262_04">4</a></sup> कारकः-रिका, कारकः-रिका, <sup id="ref_krm_0262_05"><a href="#foot_krm_0262_05">5</a></sup> चिकरिषकः-षिका, <sup id="ref_krm_0262_06"><a href="#foot_krm_0262_06">6</a></sup> चेकिरकः-रिका;</li> <li>  <sup id="ref_krm_0262_07"><a href="#foot_krm_0262_07">7</a></sup> करिता-करीता-त्री, कारयिता-त्री, चिकरिषिता-त्री, चेकिरिता-त्री;</li> <li>  <sup id="ref_krm_0262_08"><a href="#foot_krm_0262_08">8</a></sup> <sup id="ref_krm_0262_09"><a href="#foot_krm_0262_09">9</a></sup> किरन्-न्ती-ती, <sup id="ref_krm_0262_10"><a href="#foot_krm_0262_10">10</a></sup> उपस्किरन् <sup id="ref_krm_0262_11"><a href="#foot_krm_0262_11">11</a></sup>, <sup id="ref_krm_0262_12"><a href="#foot_krm_0262_12">12</a></sup> प्रतिस्किरन् <sup id="ref_krm_0262_13"><a href="#foot_krm_0262_13">13</a></sup>, कारयन्-न्ती, चिकरिषन्-न्ती;</li> <li>  -- करिष्यन्-करीष्यन्-न्ती-ती, कारयिष्यन्-न्ती-ती, चिकरिषिष्यन्-न्ती-ती;</li> <li>  <sup id="ref_krm_0262_14"><a href="#foot_krm_0262_14">14</a></sup> व्यतिकिरमाणः, <sup id="ref_krm_0262_15"><a href="#foot_krm_0262_15">15</a></sup> अपस्किरमाणः <sup id="ref_krm_0262_16"><a href="#foot_krm_0262_16">16</a></sup>, अपस्किरमाणः <sup id="ref_krm_0262_17"><a href="#foot_krm_0262_17">17</a></sup>, अपस्किरमाणः <sup id="ref_krm_0262_18"><a href="#foot_krm_0262_18">18</a></sup>, कारयमाणः, चेकीर्यमाणः, <sup id="ref_krm_0262_19"><a href="#foot_krm_0262_19">19</a></sup> अपचेस्कीर्यमाणः;</li> <li>  अपस्करिष्यमाणः-अपस्करीष्यमाणः, कारयिष्यमाणः, चेकिरिष्यमाणः;</li> <li>  <sup id="ref_krm_0262_20"><a href="#foot_krm_0262_20">20</a></sup> कीः-किरौ-किरः;</li> <li>  -- -- -- <sup id="ref_krm_0262_21"><a href="#foot_krm_0262_21">21</a></sup> कीर्णम्-कीर्णः-कीर्णवान्, कारितः, चिकरिषितः, चेकिरितः-तवान्;</li> <li>  <sup id="ref_krm_0262_22"><a href="#foot_krm_0262_22">22</a></sup> किरः, <sup id="ref_krm_0262_23"><a href="#foot_krm_0262_23">23</a></sup> विष्किरः-विकिरः, <sup id="ref_krm_0262_24"><a href="#foot_krm_0262_24">24</a></sup> विकिरम्, उत्किरः, कारः, <sup id="ref_krm_0262_25"><a href="#foot_krm_0262_25">25</a></sup> चिकरिषुः, चेकिरः;</li> <li>  <sup id="ref_krm_0262_26"><a href="#foot_krm_0262_26">26</a></sup> करितव्यम्-करीतव्यम्, कारयितव्यम्, चिकरिषितव्यम्, चेकिरितव्यम्;</li> <li>  करणीयम्, कारणीयम्, चिकरिषणीयम्, चेकिरणीयम्;</li> <li>  <sup id="ref_krm_0262_27"><a href="#foot_krm_0262_27">27</a></sup> कार्यम्, कार्यम्, चिकरिष्यम्, चेकीर्यम्;</li> <li>  ईषत्करः-दुष्करः-सुकरः;</li> <li>  -- -- -- कीर्यमाणः, <sup id="ref_krm_0262_28"><a href="#foot_krm_0262_28">28</a></sup> व्यतिकीर्यमाणः, कार्यमाणः, चिकरिष्यमाणः, चेकीर्यमाणः;</li> <li>  <sup id="ref_krm_0262_29"><a href="#foot_krm_0262_29">29</a></sup> करः, <sup id="ref_krm_0262_30"><a href="#foot_krm_0262_30">30</a></sup> अवस्करः <sup id="ref_krm_0262_31"><a href="#foot_krm_0262_31">31</a></sup>-अवकरः, <sup id="ref_krm_0262_32"><a href="#foot_krm_0262_32">32</a></sup> अपस्करः <sup id="ref_krm_0262_33"><a href="#foot_krm_0262_33">33</a></sup> अपकरः, <sup id="ref_krm_0262_34"><a href="#foot_krm_0262_34">34</a></sup> आकरः <sup id="ref_krm_0262_35"><a href="#foot_krm_0262_35">35</a></sup>, <sup id="ref_krm_0262_36"><a href="#foot_krm_0262_36">36</a></sup> उत्कारः <sup id="ref_krm_0262_37"><a href="#foot_krm_0262_37">37</a></sup> -निकारो <sup id="ref_krm_0262_38"><a href="#foot_krm_0262_38">38</a></sup>, उत्करः- निकरश्च <sup id="ref_krm_0262_39"><a href="#foot_krm_0262_39">39</a></sup>, कारः, चिकरिषः, चेकिरः;</li> <li>  <sup id="ref_krm_0262_40"><a href="#foot_krm_0262_40">40</a></sup> करितुम्-करीतुम्, कारयितुम्, चिकरिषितुम्, चेकिरितुम्;</li> <li>  <sup id="ref_krm_0262_41"><a href="#foot_krm_0262_41">41</a></sup> कीर्णिः, कारणा, चिकरिषा, चेकिरा;</li> <li>  करणम्, कारणम्, चिकरिषणम्, चेकिरणम्;</li> <li>  <sup id="ref_krm_0262_42"><a href="#foot_krm_0262_42">42</a></sup> कीर्त्वा, कारयित्वा, चिकरिषित्वा, चेकिरित्वा;</li> <li>  विकीर्य, विकार्य, विचिकरिष्य, विचेकीर्य;</li> <li>  कारम् २, <sup id="ref_krm_0262_43"><a href="#foot_krm_0262_43">43</a></sup> उपस्कारं कीर्त्वा २, <sup id="ref_krm_0262_44"><a href="#foot_krm_0262_44">44</a></sup> कारम् २, कारयित्वा २, चिकरिषम् २, चिकरिषित्वा २, चेकिरम् २;</li> <li>  चेकिरित्वा २;</li> <li>  <sup id="ref_krm_0262_45"><a href="#foot_krm_0262_45">45</a></sup> कीटन् प्रत्यये रूपम्। </li> <li>किरीटम् = मुकुटम्।]] किरीटम्, <sup id="ref_krm_0262_46"><a href="#foot_krm_0262_46">46</a></sup> क्युप्रत्ययेऽनादेशः। </li> <li>किरणः = रश्मिः।]] किरणः, <sup id="ref_krm_0262_47"><a href="#foot_krm_0262_47">47</a></sup> नप्रत्ययान्तः। </li> <li>कर्णः = श्रोत्रम्।]] कर्णः, <sup id="ref_krm_0262_48"><a href="#foot_krm_0262_48">48</a></sup> इत्युनन्प्रत्ययः। </li> <li>करुणः = शोचनीयः। </li> <li>करुणा = कृपा।]] करुणा, <sup id="ref_krm_0262_49"><a href="#foot_krm_0262_49">49</a></sup> अभच् प्रत्यये रूपम्। </li> <li>करभः = त्रिवर्ष उष्ट्रः। </li> <li>‘मणिबन्धादाकनिष्ठं करस्य करभो बहिः’ इत्यमरः।]] करभः, <sup id="ref_krm_0262_50"><a href="#foot_krm_0262_50">50</a></sup> ईरन् प्रत्यये रूपम्। </li> <li>करीरम् = वृक्षः।]] करीरम्, <sup id="ref_krm_0262_51"><a href="#foot_krm_0262_51">51</a></sup> इति ईषन् प्रत्ययः। </li> <li>करीषम् = गोमयबिकारः।]] करीषम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0262_01"><a href="#ref_krm_0262_01">↑</a> (२५७)</li> <li id="foot_krm_0262_02"><a href="#ref_krm_0262_02">↑</a> (६-तुदादिः-१४०९। सक। सेट्। पर। किरादिः।)</li> <li id="foot_krm_0262_03"><a href="#ref_krm_0262_03">↑</a> (श्लो। ३९)</li> <li id="foot_krm_0262_04"><a href="#ref_krm_0262_04">↑</a> [[३। ‘इत्त्वोत्त्वाभ्यां गुणवृद्धी विप्रतिषेधेन’ (वा। ७-१-१०२) इति वचनात् इत्त्वं बाधित्वा वृद्धिः। ‘उरण् रपरः’ (१-१-५१) इति रपरत्वम्।]]</li> <li id="foot_krm_0262_05"><a href="#ref_krm_0262_05">↑</a> [[४। ‘इट् सनि वा’ (७-२-४१) इति प्राप्तं वैकल्पिकमिटं बाधित्वा, ‘किरश्च पञ्चभ्यः’ (७-२-७५) इति नित्यमिट्। ‘अत्रेटो दीर्घो नेष्टः’ (वा। ७-२-७५) इति दीर्घो न। भागवृत्तिकारस्तु दीर्घविकल्पं सन्नन्तेऽपि ब्रूते--इति माधवधातु- वृत्तिः। तदानीं ‘चिकरीषकः--’ इत्यादीनि रूपाण्यपि सर्वत्र सन्नन्ते ज्ञेयानि।]]</li> <li id="foot_krm_0262_06"><a href="#ref_krm_0262_06">↑</a> [[५। ‘ॠत इद्धातोः’ (७-१-१००) इतीत्त्वम्। रपरत्वम्। द्वित्वम्। ‘गुणो यङ्लुकोः’ (७-४-८२) इत्यभ्यासे गुणः। ‘यस्य हलः’ (६-४-४९) इति यकारलोपः। एवं यङन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0262_07"><a href="#ref_krm_0262_07">↑</a> [[६। ‘वृतो वा’ (७-२-३८) इति दीर्घविकल्पः। एवं तव्यदादिष्वपि बोध्यम्।]]</li> <li id="foot_krm_0262_08"><a href="#ref_krm_0262_08">↑</a> [पृष्ठम्०२५७+ २७]</li> <li id="foot_krm_0262_09"><a href="#ref_krm_0262_09">↑</a> [[१। ‘तुदादिभ्यः--’ (३-१-७७) इति शः विकरणप्रत्ययः। इत्वं, रपरत्वम्। ‘आ- च्छीनद्योर्नुम्’ (७-१-८०) इति नुम्विकल्पः।]]</li> <li id="foot_krm_0262_10"><a href="#ref_krm_0262_10">↑</a> [[२। ‘किरतौ लवने’ (६-१-१४०) इति उपपूर्वकात् सुट्।]]</li> <li id="foot_krm_0262_11"><a href="#ref_krm_0262_11">↑</a> (श्वापदः)</li> <li id="foot_krm_0262_12"><a href="#ref_krm_0262_12">↑</a> [[३। ‘हिंसायां प्रतेश्च’ (६-१-१४१) इति प्रतिपूर्वकात् सुट्।]]</li> <li id="foot_krm_0262_13"><a href="#ref_krm_0262_13">↑</a> (श्वापदः)</li> <li id="foot_krm_0262_14"><a href="#ref_krm_0262_14">↑</a> [[४। ‘कर्तरि कर्मव्यतीहारे’ (१-३-१४) इति शानच्।]]</li> <li id="foot_krm_0262_15"><a href="#ref_krm_0262_15">↑</a> [[५। ‘किरतेर्हर्षजीविकाकुलायकरणेष्विति वक्तव्यम्’ (वा। १-३-२१) इति शानच्। ‘अपाच्चतुष्पाच्छकुनिष्वालेखने’ (६-१-१४२) इति सुट्। सुडपि ‘हर्षजीविकाकुला- यकरणेष्विति वाच्यम्’ (वा। ६-१-१४२) इति वचनात् उक्तेष्वर्थेष्वेव। यथासंख्यम् उदाहरणेषु अर्थमेदोऽनुसन्धेयः। ‘अवाच्चतुष्पात्--’ (६-१-१४२) इति दाक्षि- णात्यपाठ इति धातुरूपप्रकाशिकायां श्रीकण्ठशास्त्रिणः।]]</li> <li id="foot_krm_0262_16"><a href="#ref_krm_0262_16">↑</a> (वृषभो हृष्टः)</li> <li id="foot_krm_0262_17"><a href="#ref_krm_0262_17">↑</a> (कुक्कुटो भक्षाथीं)</li> <li id="foot_krm_0262_18"><a href="#ref_krm_0262_18">↑</a> (श्वा आश्रयाथीं)</li> <li id="foot_krm_0262_19"><a href="#ref_krm_0262_19">↑</a> [[६। ‘सुट् कात् पूर्वः’ (६-१-१३५), ‘अडभ्यासव्यवायेऽपि’ (६-१-१३६) इत्यनुवर्त- माने, ‘अपाच्चतुष्पात्--’ (६-१-१४२) इति सुट् कात् पूर्वः।]]</li> <li id="foot_krm_0262_20"><a href="#ref_krm_0262_20">↑</a> [[७। इत्वे, रपरत्वे, ‘र्वोरुपधाया दीर्घ इकः’ (८-२-७६) इति दीर्घे रुत्वविसर्गौ।]]</li> <li id="foot_krm_0262_21"><a href="#ref_krm_0262_21">↑</a> [[८। ‘श्र्युकः क्किति’ (७-२-११) इतीण्णिषिध्यते। इत्वे रपरत्वे च ‘हलि च’ (८-२-७७) इति दीर्घे, ‘रदाभ्यां निष्ठातो नः--’ (८-२-४२) इति निष्ठानत्वम्। ‘रषाभ्यां नो णः--’ (८-४-१) इति णत्वम्।]]</li> <li id="foot_krm_0262_22"><a href="#ref_krm_0262_22">↑</a> [[९। ‘इगुपधज्ञाप्रीकिरः कः’ (३-१-१३५) इति कर्तरि कः। किरः = वराहः। ‘कोलः पोत्री किरः किटिः।’ इत्यमरः।]]</li> <li id="foot_krm_0262_23"><a href="#ref_krm_0262_23">↑</a> [[१०। ‘विष्किरः शकुनिर्विकिरो वा’ (६-१-१५०) इति विकल्पेन सुट् शकुनौ वाच्ये। यदा सुट्, तदानीं, ‘परिनिविभ्यः--’ (८-३-७०) इति षत्वम्।]]</li> <li id="foot_krm_0262_24"><a href="#ref_krm_0262_24">↑</a> [[११। ‘विष्किरः शकुनौ वा’ (६-१-१५०) इति सूत्रपाठमालम्ब्य महाभाष्ये, वाग्रहणस्य निपातनेन सम्बन्धकथनात्, ‘विकिरान्नं च वैष्णवम्।’, ‘विकिरं वैश्वदेविकम्’ इत्यादिप्रयोगा अपि साधव इति ज्ञेयम्। स्पष्टमिदं सि। कौमुद्याम्।]]</li> <li id="foot_krm_0262_25"><a href="#ref_krm_0262_25">↑</a> [[आ। ‘वने चिकरिषोर्वृक्षान् बलं जिगरिषुः कपेः।।’ भ। का। ९-५४।]]</li> <li id="foot_krm_0262_26"><a href="#ref_krm_0262_26">↑</a> [पृष्ठम्०२५८+ २६]</li> <li id="foot_krm_0262_27"><a href="#ref_krm_0262_27">↑</a> [[१। ‘ऋहलोर्ण्यत्’ (३-१-१२४) इति ण्यत्।]]</li> <li id="foot_krm_0262_28"><a href="#ref_krm_0262_28">↑</a> [[आ। ‘सरित्प्रवाहैर्व्यतिकीर्यमाणैः सङ्कल्पयोनेरिव शिल्पभेदैः। पश्य प्रिये त्वं परिवृत्य किञ्चिद् दिव्योपमान् जानपदान् विशेषान्।।’ यादवाभ्युदये १८-७४।]]</li> <li id="foot_krm_0262_29"><a href="#ref_krm_0262_29">↑</a> [[२। ‘ॠदोरप्’ (३-३-५७) इत्यप् भावे।]]</li> <li id="foot_krm_0262_30"><a href="#ref_krm_0262_30">↑</a> [[३। ‘वर्चस्केऽवस्करः’ (६-१-१४८) इति सुट् वर्चस्केऽभिधेये। वर्चस्कम् = भाण्डात् काष्ठादिना आकृष्टम् अन्नमलम्। तत्सम्बन्धात् देशोऽपि तथोच्यते। अन्यत्र अवकर इत्येव। अवकरः = सम्मार्जन्या क्षिप्ता धूलिः। ‘सम्मार्जनी शोधनी स्यात्, सङ्करोऽवकरस्तया। क्षिप्ते--’ इत्यमरः।]]</li> <li id="foot_krm_0262_31"><a href="#ref_krm_0262_31">↑</a> (वर्चस्कम्)</li> <li id="foot_krm_0262_32"><a href="#ref_krm_0262_32">↑</a> [[४। ‘अपस्करो रथाङ्गम्’ (६-१-१४९) इति सुट्। रथाङ्गम् = रथावयवः, न तु चक्रम्।]]</li> <li id="foot_krm_0262_33"><a href="#ref_krm_0262_33">↑</a> [रथाङ्गम्]</li> <li id="foot_krm_0262_34"><a href="#ref_krm_0262_34">↑</a> [[५। आकीर्यन्ते धातवोऽत्रेति--आकरः = खनिः। ‘पुंसि संज्ञायां घः प्रायेण’ (३-३-११८) इति संज्ञायामधिकरणे घः।]]</li> <li id="foot_krm_0262_35"><a href="#ref_krm_0262_35">↑</a> [[B। ‘देहव्रश्चनतुण्डाग्रं तं विलोक्याशुभाकरम्। पापगोचरमात्मानमशोचन् वानरा मुहुः।।’ भ। का। ७-८०।]]</li> <li id="foot_krm_0262_36"><a href="#ref_krm_0262_36">↑</a> [[६। ‘कॄ धान्ये’ (३-३-३०) इति, भावे कर्तृभिन्ने कारके च घञ्--धान्ये वाच्ये। ‘उत्कारश्च निकारश्च द्वौ धान्योत्क्षेपणार्थकौ।’ इत्यमरः। ‘निकारः स्यात् परिभवे, धान्यस्योत्क्षेपणेऽपि च’ इति धरणिकोशः। धान्यभिन्नविषयके त्वर्थे उत्करः, निकरः इत्यबेव।]]</li> <li id="foot_krm_0262_37"><a href="#ref_krm_0262_37">↑</a> [[C। ‘सदोद्गारसुगन्धीनां फलानामलमाशिताः। उत्कारेषु च धान्यानामनभीष्टपरिग्रहाः।।’ भ। का। ७-३८।]]</li> <li id="foot_krm_0262_38"><a href="#ref_krm_0262_38">↑</a> [वा धान्यस्य]</li> <li id="foot_krm_0262_39"><a href="#ref_krm_0262_39">↑</a> [पुष्पस्य]</li> <li id="foot_krm_0262_40"><a href="#ref_krm_0262_40">↑</a> [पृष्ठम्०२५९+ २२]</li> <li id="foot_krm_0262_41"><a href="#ref_krm_0262_41">↑</a> [[१। ‘ॠल्वादिभ्यः क्तिन् निष्ठावद् वाच्यः’ (वा। ८-२-४४) इति क्तिनस्तकारस्य नकारः।]]</li> <li id="foot_krm_0262_42"><a href="#ref_krm_0262_42">↑</a> [[२। ‘श्रथुकः क्किति’ (७-२-११) इतीण्णिषेधः।]]</li> <li id="foot_krm_0262_43"><a href="#ref_krm_0262_43">↑</a> [[३। ‘किरतौ लवने’ (६-१-१४०) इति किरतिसामान्ये विहितोऽपि सुट् ‘णमुलत्र वक्तव्यः’ इति काशिकावचनात् णमुल्येव, इति पक्षमवलम्बयात्र णमुलन्तं रूपं लिखितम्।]]</li> <li id="foot_krm_0262_44"><a href="#ref_krm_0262_44">↑</a> [मद्रका लुनन्ति]</li> <li id="foot_krm_0262_45"><a href="#ref_krm_0262_45">↑</a> [[४। औणादिके [द। उ। ५-३]</li> <li id="foot_krm_0262_46"><a href="#ref_krm_0262_46">↑</a> [[५। औणादिके [द। उ। ५-२६]</li> <li id="foot_krm_0262_47"><a href="#ref_krm_0262_47">↑</a> [[६। औणादिकः [द। उ। ५-४२]</li> <li id="foot_krm_0262_48"><a href="#ref_krm_0262_48">↑</a> [[७। ‘कॄवॄतॄदारिभ्य उनन्’ [द। उ। ५-५२]</li> <li id="foot_krm_0262_49"><a href="#ref_krm_0262_49">↑</a> [[८। औणादिके [द। उ। ७-१८]</li> <li id="foot_krm_0262_50"><a href="#ref_krm_0262_50">↑</a> [[९। औणादिके [द। उ। ८-७२]</li> <li id="foot_krm_0262_51"><a href="#ref_krm_0262_51">↑</a> [[१०। ‘कॄतॄभ्यामीषन्’ [द। उ। ९-९]</li></ul></p>

