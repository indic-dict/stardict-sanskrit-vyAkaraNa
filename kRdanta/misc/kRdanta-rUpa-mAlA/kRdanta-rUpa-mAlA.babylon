<ul><li><sup id="ref_krm_0637_01"><a href="#foot_krm_0637_01">1</a></sup> {@“ज्या वयोहानौ”@} <sup id="ref_krm_0637_02"><a href="#foot_krm_0637_02">2</a></sup> प्वादिः, ल्वादिः, ग्रह्यादिश्च। </li> <li><sup id="ref_krm_0637_03"><a href="#foot_krm_0637_03">3</a></sup> ज्यायकः-यिका, <sup id="ref_krm_0637_04"><a href="#foot_krm_0637_04">4</a></sup> ज्यापकः-पिका, <sup id="ref_krm_0637_05"><a href="#foot_krm_0637_05">5</a></sup> जिज्यासकः-सिका, <sup id="ref_krm_0637_06"><a href="#foot_krm_0637_06">6</a></sup> जेजीयकः-यिका;</li> <li>  ज्याता-त्री, ज्यापयिता-त्री, जिज्यासिता-त्री, जेजीयिता-त्री;</li> <li>  <sup id="ref_krm_0637_07"><a href="#foot_krm_0637_07">7</a></sup> जिनन्-ती, ज्यापयन्-न्ती, जिज्यासन्-न्ती;</li> <li>  -- ज्यास्यन्-न्ती-ती, ज्यापयिष्यन्-न्ती-ती, जिज्यासिष्यन्-न्ती-ती;</li> <li>  -- -- ज्यापयमानः, -- जेजीयमानः;</li> <li>  -- ज्यापयिष्यमाणः, -- जेजीयिष्यमाणः;</li> <li>  <sup id="ref_krm_0637_08"><a href="#foot_krm_0637_08">8</a></sup> प्रजीः-प्रज्यौ-प्रज्यः;</li> <li>  -- -- -- <sup id="ref_krm_0637_09"><a href="#foot_krm_0637_09">9</a></sup> जीनम्- <sup id="ref_krm_0637_10"><a href="#foot_krm_0637_10">10</a></sup> जीनः-जीनवान्, ज्यापितः, जिज्यासितः, जेजीयितः-तवान्;</li> <li>  <sup id="ref_krm_0637_11"><a href="#foot_krm_0637_11">11</a></sup> <sup id="ref_krm_0637_12"><a href="#foot_krm_0637_12">12</a></sup> ब्रह्मज्यः, प्रज्यः, <sup id="ref_krm_0637_13"><a href="#foot_krm_0637_13">13</a></sup> ज्यायः, ज्यापः, जिज्यासुः, <sup id="ref_krm_0637_14"><a href="#foot_krm_0637_14">14</a></sup> जेज्यः;</li> <li>  ज्यातव्यम्, ज्यापयितव्यम्, जिज्यासितव्यम्, जेजीयितव्यम्;</li> <li>  ज्यानीयम्, ज्यापनीयम्, जिज्यासनीयम्, जेजीयनीयम्;</li> <li>  <sup id="ref_krm_0637_15"><a href="#foot_krm_0637_15">15</a></sup> ज्येयम्, ज्याप्यम्, जिज्यास्यम्, जेजीय्यम्;</li> <li>  <sup id="ref_krm_0637_16"><a href="#foot_krm_0637_16">16</a></sup> ईषज्ज्यानः-दुर्ज्यानः-सुज्यानः;</li> <li>  -- -- जीयमानः, ज्याप्यमानः, जिज्यास्यमानः, जेजीय्यमानः;</li> <li>  ज्यायः, ज्यापः, जिज्यासः, जेजीयः;</li> <li>  ज्यातुम्, ज्यापयितुम्, जिज्यासितुम्, जेजीयितुम्;</li> <li>  <sup id="ref_krm_0637_17"><a href="#foot_krm_0637_17">17</a></sup> ज्यानिः, ज्यापना, जिज्यासा, जेजीया;</li> <li>  ज्यानम्, ज्यापनम्, जिज्यासनम्, जेजीयनम्;</li> <li>  <sup id="ref_krm_0637_18"><a href="#foot_krm_0637_18">18</a></sup> जीत्वा, ज्यापयित्वा, जिज्यासित्वा, जेजीयित्वा;</li> <li>  <sup id="ref_krm_0637_19"><a href="#foot_krm_0637_19">19</a></sup> प्रज्याय, प्रज्याप्य, प्रजिज्यास्य, प्रजेजीय्य;</li> <li>  ज्यायम् २, जीत्वा २, ज्यापम् २, ज्यापयित्वा २, जिज्यासम् २, जिज्यासित्वा २, जेजीयम् २;</li> <li>  जेजीयित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0637_01"><a href="#ref_krm_0637_01">↑</a> (६२७)</li> <li id="foot_krm_0637_02"><a href="#ref_krm_0637_02">↑</a> (९-क्र्यादिः-१४९९। अक। अनि। पर।)</li> <li id="foot_krm_0637_03"><a href="#ref_krm_0637_03">↑</a> [[१। ‘आतो युक् चिण्कृतोः’ (७-३-३३) इति णिति कृति प्रत्यये परे युगागमः। एवं णे, घञि, णमुलि च ज्ञेयम्।]]</li> <li id="foot_krm_0637_04"><a href="#ref_krm_0637_04">↑</a> [[२। ‘अर्तिह्रीव्लीरीक्नूयीक्ष्माय्यातां पुग् णौ’ (७-३-३६) इति आदन्तलक्षणः पुगागमो वोध्यः। एवं ण्यन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0637_05"><a href="#ref_krm_0637_05">↑</a> [[३। द्वित्वे, हलादिशेषे, अभ्यासघटकाकारस्य ‘सन्यतः’ (७-४-७९) इतीत्वम्। एवं सन्नन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0637_06"><a href="#ref_krm_0637_06">↑</a> [[४। यङि, ‘ग्रहिज्यावयिव्यधिवष्टिविचतिवृश्चतिपृच्छतिभृज्जतीनां ङीति च’ (६-१-१६) इति सम्प्रसारणे, पूर्वरूपे, ‘हलः’ (६-४-२) इति दीर्घे द्वित्वे, अभ्यासस्य गुणे च रूपम्। एवं यङन्ते सर्वत्र प्रक्रियोह्या।]]</li> <li id="foot_krm_0637_07"><a href="#ref_krm_0637_07">↑</a> [[५। ‘क्र्यादिभ्यः--’ (३-१-८१) इति श्ना विकरणप्रत्ययः। तस्य ङिद्वद्भावाद् अङ्गस्य सम्प्रसारणम्। पूर्वरूपं दीर्घश्च। ‘प्वादीनां ह्रस्वः’ (७-३-८०) इति ह्रस्वः। ‘श्नाऽभ्यस्तयोरातः’ (६-४-११२) इत्याकारलोपः।]]</li> <li id="foot_krm_0637_08"><a href="#ref_krm_0637_08">↑</a> [[६। क्विपि, सम्प्रसारणपूर्वरूपदीर्घेषु सत्सु रूपम्। द्विवचने ‘एरनेकाचः--’ (६-४-८२) इति यण्।]]</li> <li id="foot_krm_0637_09"><a href="#ref_krm_0637_09">↑</a> [[७। निष्ठायाम्, सम्प्रसारणादिषु सत्सु, ‘ल्वादिभ्यः’ (८-२-४४) इति निष्ठानत्वम्]]</li> <li id="foot_krm_0637_10"><a href="#ref_krm_0637_10">↑</a> [[आ। ‘इत्थं हरौ गृणति हस्तिपकोऽपि कोपी जीनोऽप्यहं न तु रिणामि भियेति वादी।’ धा। का। ३। ८।]]</li> <li id="foot_krm_0637_11"><a href="#ref_krm_0637_11">↑</a> [पृष्ठम्०५९७+ २२]</li> <li id="foot_krm_0637_12"><a href="#ref_krm_0637_12">↑</a> [[१। ब्रह्म जिनातीति ब्रह्मज्यः। वयोहानिरूपार्थे धातुरकर्मकोऽपि, धातूनामनेकार्थकत्वेन चिन्तनाद्यर्थे सकर्मकत्वम्। ‘कविधौ सर्वत्र सम्प्रसारणिभ्यो डः’ (वा। ३-२-३) इति डप्रत्यये, डित्वसामर्थ्यादभस्यापि टेर्लोपे, रूपम्। एवं ‘प्रज्यः’ इत्यत्र ‘आतश्चोपसर्गे’ (३-१-१३६) इति कप्रत्ययस्थलेऽपि डो ज्ञेयः।]]</li> <li id="foot_krm_0637_13"><a href="#ref_krm_0637_13">↑</a> [[२। ‘श्याऽऽद्व्यधास्रु--’ (३-१-१४१) इत्यादिना कर्तरि णप्रत्ययः। युगागमः।]]</li> <li id="foot_krm_0637_14"><a href="#ref_krm_0637_14">↑</a> [[३। अच्प्रत्ययनिमित्तके यङो लुकि, ‘न धातुलोपः--’ (१-१-४) इति निषेधे, ‘एरेनकाचः--’ (६-४-८२) इति यणादेशः।]]</li> <li id="foot_krm_0637_15"><a href="#ref_krm_0637_15">↑</a> [[४। ‘ईद्यति’ (६-४-६५) इति ईत्त्वे, गुणे रूपम्।]]</li> <li id="foot_krm_0637_16"><a href="#ref_krm_0637_16">↑</a> [[५। ‘आतो युच्’ (३-३-१२८) इति ईषदाद्युपपदे खलपवादो युच्। अनादेशः।]]</li> <li id="foot_krm_0637_17"><a href="#ref_krm_0637_17">↑</a> [[६। ‘ग्लाम्लास्नाज्याहाभ्यो निः’ (वा। ३-३-९४) इति क्तिनोऽपवादः निप्रत्ययः।]]</li> <li id="foot_krm_0637_18"><a href="#ref_krm_0637_18">↑</a> [[७। क्त्वायाम्, सम्प्रसारणपूर्वरूपदीर्घाः।]]</li> <li id="foot_krm_0637_19"><a href="#ref_krm_0637_19">↑</a> [[८। ‘ज्यश्च’ (६-१-४२) इति ल्यपि सम्प्रसारणनिषेघः।]]</li></ul></p>

ज्युङ्|ज्यावकः-विका|जुज्यूषकः-षिका|जोज्यूयकः-यिका
<ul><li><sup id="ref_krm_0638_01"><a href="#foot_krm_0638_01">1</a></sup> {@“ज्युङ् गतौ”@} <sup id="ref_krm_0638_02"><a href="#foot_krm_0638_02">2</a></sup> ज्यावकः-विका, ज्यावकः-विका, जुज्यूषकः-षिका, जोज्यूयकः-यिका;</li> <li>  <sup id="ref_krm_0638_03"><a href="#foot_krm_0638_03">3</a></sup> ज्युतम्, इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकच्यवतिवत् <sup id="ref_krm_0638_04"><a href="#foot_krm_0638_04">4</a></sup> <sup id="ref_krm_0638_05"><a href="#foot_krm_0638_05">5</a></sup> ज्ञेयानि। </li> <li>ण्यन्तात् सनि ‘स्रवतिशृणोति--’ <sup id="ref_krm_0638_06"><a href="#foot_krm_0638_06">6</a></sup> इत्यादिना विहितः अभ्यासस्येत्वविकल्पो नास्य भवति--जुज्यावयिषकः-षिका, इत्येव रूपम्, इति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0638_01"><a href="#ref_krm_0638_01">↑</a> (६२८)</li> <li id="foot_krm_0638_02"><a href="#ref_krm_0638_02">↑</a> (१-भ्वादिः-९५६। अक। अनि। आत्म।)</li> <li id="foot_krm_0638_03"><a href="#ref_krm_0638_03">↑</a> [[आ। ‘स्तोत्रावमानैर्दुतवेणुवीणैश्च्युताशुभैर्व्योमचरैर्ज्युतं ते।’ धा। का। २। ३६।]]</li> <li id="foot_krm_0638_04"><a href="#ref_krm_0638_04">↑</a> (५५८)</li> <li id="foot_krm_0638_05"><a href="#ref_krm_0638_05">↑</a> [पृष्ठम्०५९८+ २७]</li> <li id="foot_krm_0638_06"><a href="#ref_krm_0638_06">↑</a> (७-४-८१)</li></ul></p>

ज्रि|ज्रायकः-यिका|जिज्रीषकः-षिका|जेज्रीयकः-यिका|ज्रेता-त्री|ज्राययिता-त्री|जिज्रीषिता-त्री|जेज्रीयिता-त्री
<ul><li><sup id="ref_krm_0639_01"><a href="#foot_krm_0639_01">1</a></sup> {@“ज्रि अभिभवे”@} <sup id="ref_krm_0639_02"><a href="#foot_krm_0639_02">2</a></sup> ‘अभिभवः = न्यूनीकरणम्, न्यूनीभवनं च। </li> <li>आद्ये सकर्मकः, द्वितीये त्वकर्मकः।’ इति सि। </li> <li>कौमुदी। </li> <li>क्षीरस्वामी तु ‘जृ’ इति पठति। </li> <li>तन्मते जारकः, जरन् इत्यादीनि रूपाणि। </li> <li>देवः क्षीरस्वामिसम्मतपाठस्या- नुकूलः। </li> <li>यदाह -- ‘जृणाति जीर्यति जरत्येकार्थे जारयत्यपि। </li> <li><sup id="ref_krm_0639_03"><a href="#foot_krm_0639_03">3</a></sup>’ इति। </li> <li>धातुकाव्ये तु ‘ज्ञि अभिभवे’ इति पठित्वा, तदनुगुणः प्रयोगोऽपि प्रदर्शितः। </li> <li>यथा-- ‘श्रुत्यन्तवाचा ध्रुवया प्रदूनं घोरद्रवच्चक्रजिताज्ञितारिम्।’ <sup id="ref_krm_0639_04"><a href="#foot_krm_0639_04">4</a></sup> इति। </li> <li>ज्रायकः-यिका, ज्रायकः-यिका, जिज्रीषकः-षिका, जेज्रीयकः-यिका;</li> <li>  ज्रेता-त्री, ज्राययिता-त्री, जिज्रीषिता-त्री, जेज्रीयिता-त्री;</li> <li>  ज्रयन्-न्ती, इत्यादीनि सर्वाण्यपि रूपाणि जिधातूपादानेन विहितानि कार्याणि विना, तद्वत् <sup id="ref_krm_0639_05"><a href="#foot_krm_0639_05">5</a></sup> बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0639_01"><a href="#ref_krm_0639_01">↑</a> (६२९)</li> <li id="foot_krm_0639_02"><a href="#ref_krm_0639_02">↑</a> (१-भ्वादिः-९४७। सक। अनि। पर।)</li> <li id="foot_krm_0639_03"><a href="#ref_krm_0639_03">↑</a> (श्लो। ३९)</li> <li id="foot_krm_0639_04"><a href="#ref_krm_0639_04">↑</a> (२-३५)</li> <li id="foot_krm_0639_05"><a href="#ref_krm_0639_05">↑</a> (५९९)</li></ul></p>

ज्रि|ण्यन्तात्|सनि|तु-|जिज्राययिषकः-षिका|जिज्राययिषिता-त्री|जिज्राययिषन्-न्ती|जिज्राय-|यिषिष्यन्-न्ती-ती|जिज्राययिषमाणः|जिज्राययिषिष्यमाणः|जिज्राययिट्-|यिषौ-यिषः|जिज्राययिषितः-तवान्|जिज्राययिषुः|जिज्राययिषितव्यम्|जिज्राययिषणीयम्|जिज्राययिष्यम्|ईषज्जिज्राययिषः-दुर्जिज्राययिषः-सुजि-|ज्राययिषः|जिज्राययिष्यमाणः|जिज्राययिषः|जिज्राययिषितुम्|यिषा|जिज्राययिषणम्|जिज्राययिषित्वा|प्रजिज्राययिष्य|जिज्राययिषम्
<ul><li><sup id="ref_krm_0640_01"><a href="#foot_krm_0640_01">1</a></sup> {@“ज्रि वयोहानौ”@} <sup id="ref_krm_0640_02"><a href="#foot_krm_0640_02">2</a></sup> “जॄ--’ इति चौरादिकघातोर्नन्दिसम्मतः पाठ एवम्” इति मा। </li> <li>धा। </li> <li>वृत्तौ। </li> <li>आधृषीयत्वेनास्य धातोर्णिज्विकल्पः। </li> <li>णिच्पक्षे, णिजभावपक्षे च, शुद्धात् सन्नन्तात् यङन्ताच्च जिधातुवत् <sup id="ref_krm_0640_03"><a href="#foot_krm_0640_03">3</a></sup> धातुस्वरूपनिबन्धनकार्याणि विना बोध्यानि। </li> <li>ण्यन्तात् सनि तु-- जिज्राययिषकः-षिका, जिज्राययिषिता-त्री, जिज्राययिषन्-न्ती, जिज्राय- यिषिष्यन्-न्ती-ती, जिज्राययिषमाणः, जिज्राययिषिष्यमाणः, जिज्राययिट्- यिषौ-यिषः, जिज्राययिषितः-तवान्, जिज्राययिषुः जिज्राययिषितव्यम्, जिज्राययिषणीयम्, जिज्राययिष्यम्, ईषज्जिज्राययिषः-दुर्जिज्राययिषः-सुजि- ज्राययिषः, जिज्राययिष्यमाणः, जिज्राययिषः, जिज्राययिषितुम्, जिज्राय- यिषा, जिज्राययिषणम्, जिज्राययिषित्वा, प्रजिज्राययिष्य, जिज्राययिषम् २, जिज्राययिषित्वा २;</li> <li>  इति रूपाणीति विशेषः। </li> <li><sup id="ref_krm_0640_04"><a href="#foot_krm_0640_04">4</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0640_01"><a href="#ref_krm_0640_01">↑</a> (६३०)</li> <li id="foot_krm_0640_02"><a href="#ref_krm_0640_02">↑</a> (१०-चुरादिः-१८१६। सक। सेट्। उभ। आधृषीयः।)</li> <li id="foot_krm_0640_03"><a href="#ref_krm_0640_03">↑</a> (५९९)</li> <li id="foot_krm_0640_04"><a href="#ref_krm_0640_04">↑</a> [पृष्ठम्०५९९+ २७]</li></ul></p>

