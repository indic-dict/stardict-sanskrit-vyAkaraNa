<ul><li><sup id="ref_krm_0683_01"><a href="#foot_krm_0683_01">1</a></sup> {@“णिजिर् शौचपोषणयोः”@} <sup id="ref_krm_0683_02"><a href="#foot_krm_0683_02">2</a></sup> ‘निङ्क्ते, नेनेक्ति नेनिक्ते शौचेऽर्थे पोषणे तथा।।’ <sup id="ref_krm_0683_03"><a href="#foot_krm_0683_03">3</a></sup> इति देवः। </li> <li>नेजकः- <sup id="ref_krm_0683_04"><a href="#foot_krm_0683_04">4</a></sup> निर्णेजकः-जिका, नेजकः-जिका, <sup id="ref_krm_0683_05"><a href="#foot_krm_0683_05">5</a></sup> निनिक्षकः-क्षिका, नेनिजकः-जिका;</li> <li>  <sup id="ref_krm_0683_06"><a href="#foot_krm_0683_06">6</a></sup> नेक्ता-त्री, नेजयिता-त्री, निनिक्षिता-त्री, <sup id="ref_krm_0683_07"><a href="#foot_krm_0683_07">7</a></sup> प्रणेनिजिता-त्री;</li> <li>  <sup id="ref_krm_0683_08"><a href="#foot_krm_0683_08">8</a></sup> नेनिजत् <sup id="ref_krm_0683_09"><a href="#foot_krm_0683_09">9</a></sup> -ती, नेजयन्-न्ती, निनिक्षन्-न्ती;</li> <li>  -- नेक्ष्यन्-न्ती-ती, नेजयिष्यन्-न्ती-ती, निनिक्षिष्यन्-न्ती-ती;</li> <li>  -- नेनिजानः, नेजयमानः, निनिक्षमाणः, नेनिज्यमानः;</li> <li>  नेक्ष्यमाणः, नेजयिष्यमाणः, निनिक्षिष्यमाणः, नेनिजिष्यमाणः;</li> <li>  सुनिक्-सुनिग्-सुनिजौ-सुनिजः;</li> <li>  -- -- निक्तम्-क्तः-क्तवान्, नेजितः, निनिक्षितः, नेनिजितः-तवान्;</li> <li>  <sup id="ref_krm_0683_10"><a href="#foot_krm_0683_10">10</a></sup> निजः, नेजः, निनिक्षुः, नेनिजः;</li> <li>  नेक्तव्यम्, नेजयितव्यम्, निनिक्षितव्यम्, नेनिजितव्यम्;</li> <li>  नेजनीयम्, नेजनीयम्, निनिक्षणीयम्, नेनिजनीयम्;</li> <li>  <sup id="ref_krm_0683_11"><a href="#foot_krm_0683_11">11</a></sup> <sup id="ref_krm_0683_12"><a href="#foot_krm_0683_12">12</a></sup> नेग्यम्, नेज्यम्, निनिक्ष्यम्, नेनिज्यम्;</li> <li>  ईषन्नेजः-दुर्नेजः-सुनेजः;</li> <li>  -- -- निज्यमानः, नेज्यमानः, निनिक्ष्यमाणः, नेनिज्यमानः;</li> <li>  नेगः, नेजः, निनिक्षः, नेनिजः;</li> <li>  नेक्तुम्, नेजयितुम्, निनिक्षितुम्, नेनिजितुम्;</li> <li>  निक्तिः, नेजना, निनिक्षा, नेनिजा;</li> <li>  नेजनम्, नेजनम्, निनिक्षणम् नेनिजनम्;</li> <li>  निक्त्वा, नेजयित्वा, निनिक्षित्वा, नेनिजित्वा;</li> <li>  प्रणिज्य, प्रणेज्य, प्रणिनिक्ष्य, प्रणेनिज्य;</li> <li>  नेजम् २, निक्त्वा २, नेजम् २, नेजयित्वा २, निनिक्षम् २, निनिक्षित्वा २, नेनिजम् २;</li> <li>  नेनिजित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0683_01"><a href="#ref_krm_0683_01">↑</a> (६७३)</li> <li id="foot_krm_0683_02"><a href="#ref_krm_0683_02">↑</a> (३-जुहोत्यादिः-१०९३। सक। अनि। उभ।)</li> <li id="foot_krm_0683_03"><a href="#ref_krm_0683_03">↑</a> (श्लो। ६३)</li> <li id="foot_krm_0683_04"><a href="#ref_krm_0683_04">↑</a> [[१। ‘उपसर्गादसमासेऽपि णोपदेशस्य’ (८-४-१४) इति धातुनकारस्य णकारः। ‘निजिर्--’ इति धातुप्रदीपादिसम्मते क्वाचित्कपाठे तु णत्वस्याप्रसक्तिरिति ज्ञेयम्। ‘निर्णेजकः स्याद् रजकः--’ इत्यमरः।]]</li> <li id="foot_krm_0683_05"><a href="#ref_krm_0683_05">↑</a> [[२। अस्य धातोरनुदात्तत्वेनेडभावे, ‘हलन्ताच्च’ (१-२-१०) इति सनः कित्त्वात् लघूपध- गुणो न। ‘कुहोश्चुः’ (७-४-६२) इति कुत्वे, ‘आदेशप्रत्यययोः’ (८-३-५९) इति षत्वे, ‘खरि च’ (८-४-५५) इति चर्त्वम्। एवं सन्नन्ते सर्वत्र प्रक्रिया ज्ञेया।]]</li> <li id="foot_krm_0683_06"><a href="#ref_krm_0683_06">↑</a> [[३। ‘एकाच उपदेशेऽनुदात्तात्’ (७-२-१०) इतीण्णिषेधः। एवं वलाद्यार्धधातुके सर्वत्र ज्ञेयम्। किति प्रत्यये परतः क्तादौ गुणाभावोऽपि बोध्यः।]]</li> <li id="foot_krm_0683_07"><a href="#ref_krm_0683_07">↑</a> [[४। ‘उभौ साभ्यासस्य’ (८-४-२१) इति लिङ्गेन, ‘पूर्वत्रासिद्धीयमद्विर्वचने’ (परि। १२७) इत्यस्यानित्यत्वात् पूर्वं द्वित्वे, अभ्यासघटकस्यैव नकारस्य णत्वं ज्ञेयम्।]]</li> <li id="foot_krm_0683_08"><a href="#ref_krm_0683_08">↑</a> [[५। विकरणप्रत्ययस्य शपः, ‘जुहोत्यादिभ्यः श्लुः’ (२-४-७५) इति श्लौ, ‘श्लौ’ (६-१-१०) इति द्वित्वे, ‘निजां त्रयाणां गुणःश्लौ’ (७-४-७५) इत्यभ्यासस्य गुणः। ‘नाभ्यस्ताच्छतुः’ (७-१-७८) इति नुम्निषेधः। एवम्, नेनिजानः इत्यत्रापि गुणो बोध्यः।]]</li> <li id="foot_krm_0683_09"><a href="#ref_krm_0683_09">↑</a> [[आ। ‘प्रणेनिजद्भिर्मतिमर्थतत्त्वं सुवेविजानैर्यदुभिः स विष्णुः।’ धा। का। २। ५५।]]</li> <li id="foot_krm_0683_10"><a href="#ref_krm_0683_10">↑</a> [[६। ‘इगुपधज्ञा--’ (३-१-१३५) इति कर्तरि कप्रत्ययः। कित्त्वान्न गुणः।]]</li> <li id="foot_krm_0683_11"><a href="#ref_krm_0683_11">↑</a> [पृष्ठम्०६२६+ २६]</li> <li id="foot_krm_0683_12"><a href="#ref_krm_0683_12">↑</a> [[१। अस्य धातोर्निष्ठायामनिट्त्वात्, ‘चजोः कुघिण्ण्यतोः’ (७-३-५२) इति कुत्वम्। एवं घञन्तेऽपि जकारस्य कुत्वेन गकारो ज्ञेयः।]]</li></ul></p>

णिदि|प्रणिन्दकः-प्रनिन्दकः-न्दिका|निन्दकः-न्दिका|निनिन्दिषकः-षिका|नेनिन्दकः-न्दिका|निन्दिता-त्री|निन्दयिता-त्री|निनिन्दिषिता-त्री|नेनिन्दिता-त्री
<ul><li><sup id="ref_krm_0684_01"><a href="#foot_krm_0684_01">1</a></sup> {@“णिदि कुत्सायाम्”@} <sup id="ref_krm_0684_02"><a href="#foot_krm_0684_02">2</a></sup> ‘कुत्सायां सन्निकर्षे वा, कुत्सामात्रे तु निन्दति।।’ <sup id="ref_krm_0684_03"><a href="#foot_krm_0684_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_0684_04"><a href="#foot_krm_0684_04">4</a></sup> प्रणिन्दकः-प्रनिन्दकः-न्दिका, निन्दकः-न्दिका, निनिन्दिषकः-षिका, नेनिन्दकः-न्दिका;</li> <li>  निन्दिता-त्री, निन्दयिता-त्री, निनिन्दिषिता-त्री, नेनिन्दिता-त्री;</li> <li>  निन्दितम्-तः-तवान्, <sup id="ref_krm_0684_05"><a href="#foot_krm_0684_05">5</a></sup> निन्दकः <sup id="ref_krm_0684_06"><a href="#foot_krm_0684_06">6</a></sup>, इत्यादीनिसर्वाण्यपि रूपाणि भौवादिक, जिन्वतिवत् <sup id="ref_krm_0684_07"><a href="#foot_krm_0684_07">7</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0684_01"><a href="#ref_krm_0684_01">↑</a> (६७४)</li> <li id="foot_krm_0684_02"><a href="#ref_krm_0684_02">↑</a> (१-भ्वादिः-६६। सक। सेट्। पर।)</li> <li id="foot_krm_0684_03"><a href="#ref_krm_0684_03">↑</a> (श्लो ११४)</li> <li id="foot_krm_0684_04"><a href="#ref_krm_0684_04">↑</a> [[२। ‘वा निंसनिक्षनिन्दाम्’ (८-४-३३) इति कृत्प्रत्ययपरकधातुसम्बन्धिनकारस्य णत्वं विकल्पेन भवति।]]</li> <li id="foot_krm_0684_05"><a href="#ref_krm_0684_05">↑</a> [[३। ‘निन्दहिंसक्लिशखाद--’ (३-२-१४६) इत्यादिना तच्छीलादिपु कर्तृषु वुञ्। अकादेशः।]]</li> <li id="foot_krm_0684_06"><a href="#ref_krm_0684_06">↑</a> [[आ। ‘निन्दको रजनिम्मन्यं दिवसं क्लेशको निशाम्।’ भ। का। ७। १३।]]</li> <li id="foot_krm_0684_07"><a href="#ref_krm_0684_07">↑</a> (६०४)</li></ul></p>

णिदृ|प्रणेदकः-दिका|नेदकः-दिकाः|निनिदिषकः-निनेदिषकः-षिका|नेनिदकः-दिका|नेदिता-त्री|नेदयिता|त्री|निनिदिषिता-निनेदिषिता-त्री|नेनिदिता-त्री|अस्य|धातोरूभयपदित्वात्|नेदमानः|नेदयमानः|निनिदिषमाणः|निनेदिषमाणः|नेदिष्यमाणः|निनिदिषिष्यगाणः-निनेदिषिष्यमाणः
<ul><li><sup id="ref_krm_0685_01"><a href="#foot_krm_0685_01">1</a></sup> {@“णिदृ कुत्सासन्निकर्षयोः”@} <sup id="ref_krm_0685_02"><a href="#foot_krm_0685_02">2</a></sup> ‘प्रत्येकं निदिनेद्योः स्तां नेदते नेदतीत्युभे। </li> <li>कुत्सायां सन्निकर्षे वा, कुत्सामात्रे तु निन्दति।।’ <sup id="ref_krm_0685_03"><a href="#foot_krm_0685_03">3</a></sup> इति देवः। </li> <li>प्रणेदकः-दिका, नेदकः-दिकाः, निनिदिषकः-निनेदिषकः-षिका नेनिदकः-दिका;</li> <li>  नेदिता-त्री, नेदयिता, त्री निनिदिषिता-निनेदिषिता-त्री, नेनिदिता-त्री;</li> <li>  <sup id="ref_krm_0685_04"><a href="#foot_krm_0685_04">4</a></sup> <sup id="ref_krm_0685_05"><a href="#foot_krm_0685_05">5</a></sup> निद्यमानः, इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककिटतिवत् <sup id="ref_krm_0685_06"><a href="#foot_krm_0685_06">6</a></sup> ज्ञेयानि। </li> <li>अस्य धातोरूभयपदित्वात् नेदमानः, नेदयमानः, निनिदिषमाणः, निनेदिषमाणः, नेदिष्यमाणः, निनिदिषिष्यगाणः-निनेदिषिष्यमाणः;</li> <li>  इति शानजन्तानि रूपाण्यधिकानीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0685_01"><a href="#ref_krm_0685_01">↑</a> (६७५)</li> <li id="foot_krm_0685_02"><a href="#ref_krm_0685_02">↑</a> (१-भ्वादिः-८७१। सक। सेट्। उभ।)</li> <li id="foot_krm_0685_03"><a href="#ref_krm_0685_03">↑</a> (श्लो। ११४)</li> <li id="foot_krm_0685_04"><a href="#ref_krm_0685_04">↑</a> [पृष्ठम्०६२७+ २४]</li> <li id="foot_krm_0685_05"><a href="#ref_krm_0685_05">↑</a> [[आ। ‘नित्यं प्रमोहामिदितोरुमेदैः प्रमेधिता सद्भिरनिद्यमानैः।’ धा। का। २। २६।]]</li> <li id="foot_krm_0685_06"><a href="#ref_krm_0685_06">↑</a> (१९०)</li></ul></p>

णिल|नेलकः-प्रणेलकः-लिका|नेलकः-लिका|निनिलिषकः-निनेलिषकः-षिका|नेनिलकः-लिका
<ul><li><sup id="ref_krm_0686_01"><a href="#foot_krm_0686_01">1</a></sup> {@“णिल गहने”@} <sup id="ref_krm_0686_02"><a href="#foot_krm_0686_02">2</a></sup> नेलकः-प्रणेलकः-लिका, नेलकः-लिका, निनिलिषकः-निनेलिषकः-षिका, नेनिलकः-लिका;</li> <li>  <sup id="ref_krm_0686_03"><a href="#foot_krm_0686_03">3</a></sup> निलितम्-तः-तवान्, इत्यादीनि सर्वाण्यपि रूपाणि तौदादिककिलतिवत् <sup id="ref_krm_0686_04"><a href="#foot_krm_0686_04">4</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0686_01"><a href="#ref_krm_0686_01">↑</a> (६७६)</li> <li id="foot_krm_0686_02"><a href="#ref_krm_0686_02">↑</a> (६-तुदादिः-१३६०। अक। सेट्। पर।)</li> <li id="foot_krm_0686_03"><a href="#ref_krm_0686_03">↑</a> [[B। ‘बिलशयप्रतिमैर्निलिते पुरे स हि सुहृत्सु हिलन् अचरत् सुखम्।’ धा। का। २। ७९।]]</li> <li id="foot_krm_0686_04"><a href="#ref_krm_0686_04">↑</a> (१९३)</li></ul></p>

णिवि|प्रणिन्वकः-निन्वकः-न्विका|निन्वकः-न्विका|निनिन्विषकः-षिका|नेनिन्वकः-न्विका
<ul><li><sup id="ref_krm_0687_01"><a href="#foot_krm_0687_01">1</a></sup> {@“णिवि सेचने”@} <sup id="ref_krm_0687_02"><a href="#foot_krm_0687_02">2</a></sup> ‘सेवने’ इति तरङ्गिण्याम्। </li> <li>‘स्रंसने’ इति मैत्रेयः। </li> <li>प्रणिन्वकः- <sup id="ref_krm_0687_03"><a href="#foot_krm_0687_03">3</a></sup> निन्वकः-न्विका, निन्वकः-न्विका, निनिन्विषकः-षिका, नेनिन्वकः-न्विका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकजिन्वतिवत् <sup id="ref_krm_0687_04"><a href="#foot_krm_0687_04">4</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0687_01"><a href="#ref_krm_0687_01">↑</a> (६७७)</li> <li id="foot_krm_0687_02"><a href="#ref_krm_0687_02">↑</a> (१-भ्वादिः-५९०। सक। सेट्। पर।)</li> <li id="foot_krm_0687_03"><a href="#ref_krm_0687_03">↑</a> [[C। ‘विश्वेन्वितं स्रङ्मधुपिन्विताङ्गकं मिन्वन्तमुच्चैः कृपयैव निन्वकान्।’ धा। का। १। ७५।]]</li> <li id="foot_krm_0687_04"><a href="#ref_krm_0687_04">↑</a> (६०४)</li></ul></p>

णिश
<ul><li><sup id="ref_krm_0688_01"><a href="#foot_krm_0688_01">1</a></sup> {@“णिश समाधौ”@} <sup id="ref_krm_0688_02"><a href="#foot_krm_0688_02">2</a></sup> प्रणेशकः-शिका, नेशकः-शिका, निनिशिषकः-निनेशिषकः-षिका, नेनिशकः-शिका, इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककिटतिवत् <sup id="ref_krm_0688_03"><a href="#foot_krm_0688_03">3</a></sup> ज्ञेयानि। </li> <li>निट्-निशौ-निशः, निशा, <sup id="ref_krm_0688_04"><a href="#foot_krm_0688_04">4</a></sup> इत्यस्याधिकानि रूपाणीति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0688_01"><a href="#ref_krm_0688_01">↑</a> (६७८)</li> <li id="foot_krm_0688_02"><a href="#ref_krm_0688_02">↑</a> (१-भ्वादिः-७२२। अक। सेट्। पर।)</li> <li id="foot_krm_0688_03"><a href="#ref_krm_0688_03">↑</a> (१९०)</li> <li id="foot_krm_0688_04"><a href="#ref_krm_0688_04">↑</a> [[१। ‘सम्पदादिभ्यः क्विप्’ (वा। ३-३-९४) इति भावे स्त्रियां क्विप्। ‘आपं चैव हलन्तानां यथा वाचा निशा दिशा।।’ इति वचनेन टापि निशा इति भवति।]]</li></ul></p>

णिसि|प्रणिंसकः-प्रनिंसकः-सिका|निंसकः-सिका|निनिंसिषकः-षिका|नेनिंसकः-सिका
<ul><li><sup id="ref_krm_0689_01"><a href="#foot_krm_0689_01">1</a></sup> {@“णिसि चुम्बने”@} <sup id="ref_krm_0689_02"><a href="#foot_krm_0689_02">2</a></sup> <sup id="ref_krm_0689_03"><a href="#foot_krm_0689_03">3</a></sup> प्रणिंसकः-प्रनिंसकः-सिका, निंसकः-सिका, निनिंसिषकः-षिका, <sup id="ref_krm_0689_04"><a href="#foot_krm_0689_04">4</a></sup> नेनिंसकः-सिका;</li> <li>  <sup id="ref_krm_0689_05"><a href="#foot_krm_0689_05">5</a></sup> रमोष्ठनिंसी- <sup id="ref_krm_0689_06"><a href="#foot_krm_0689_06">6</a></sup> इत्यादीनि सर्वाण्यपि रूपाणि भौवादिक- जिन्वतिवत् <sup id="ref_krm_0689_07"><a href="#foot_krm_0689_07">7</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0689_01"><a href="#ref_krm_0689_01">↑</a> (६७९)</li> <li id="foot_krm_0689_02"><a href="#ref_krm_0689_02">↑</a> (२-अदादिः-१०२५। सक। सेट्। आत्म।)</li> <li id="foot_krm_0689_03"><a href="#ref_krm_0689_03">↑</a> [[२। ‘वा निंसनिक्षनिन्दाम्’ (८-४-३३) इति कृत्प्रत्ययपरकस्य धातुनकारस्य णत्व- विकल्पः।]]</li> <li id="foot_krm_0689_04"><a href="#ref_krm_0689_04">↑</a> [पृष्ठम्०६२८+ ३१]</li> <li id="foot_krm_0689_05"><a href="#ref_krm_0689_05">↑</a> [[१। ‘सुप्यजातौ--’ (३-२-७८) इति ताच्छील्ये णिनिः।]]</li> <li id="foot_krm_0689_06"><a href="#ref_krm_0689_06">↑</a> [[आ। ‘स्वीयैश्चकंसे कशनीयकासी रमोष्ठनिंसी नतचित्तनिञ्जी।।’ धा। का। २। ४५।]]</li> <li id="foot_krm_0689_07"><a href="#ref_krm_0689_07">↑</a> (६०४)</li></ul></p>

