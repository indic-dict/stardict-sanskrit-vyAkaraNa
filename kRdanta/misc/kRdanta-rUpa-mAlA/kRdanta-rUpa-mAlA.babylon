<ul><li><sup id="ref_krm_1064_01"><a href="#foot_krm_1064_01">1</a></sup> {@“पृषु सेचने”@} <sup id="ref_krm_1064_02"><a href="#foot_krm_1064_02">2</a></sup> ‘--हिंसासंक्लेशनयोश्च’ इति माधवः। </li> <li>पर्षकः-र्षिका, पर्षकः-र्षिका, पिपर्षिषकः-षिका, <sup id="ref_krm_1064_03"><a href="#foot_krm_1064_03">3</a></sup> परीपृषकः-षिका;</li> <li>  पर्षिता-त्री, पर्षयिता-त्री, पिपर्षिषिता-त्री, परीपृषिता-त्री;</li> <li>  पर्षन्- <sup id="ref_krm_1064_04"><a href="#foot_krm_1064_04">4</a></sup> व्यतिपर्षन्-न्ती, पर्षयन्-न्ती, पिपर्षिषन्-न्ती;</li> <li>  -- -- पर्षयमाणः, -- परीपृष्यमाणः;</li> <li>  -- पर्षयिष्यमाणः, -- परीपृषिष्यमाणः;</li> <li>  पृट्-पृड्-पृषौ-पृषः;</li> <li>  -- -- -- <sup id="ref_krm_1064_05"><a href="#foot_krm_1064_05">5</a></sup> पृष्टम्-पृष्टः-पृष्टवान्, पर्षितः, पिपर्षिषितः, परीपृषितः-तवान्;</li> <li>  पर्षः, <sup id="ref_krm_1064_06"><a href="#foot_krm_1064_06">6</a></sup> पर्षणः, सुपर्षी, पर्षः, पिपर्षिषुः, परीपर्षः;</li> <li>  पर्षितव्यम्, पर्षयितव्यम्, पिपर्षिषितव्यम्, परीपृषितव्यम्;</li> <li>  पर्षणीयम्, पर्षणीयम्, पिपर्षिषणीयम्, परीपृषणीयम्;</li> <li>  <sup id="ref_krm_1064_07"><a href="#foot_krm_1064_07">7</a></sup> <sup id="ref_krm_1064_08"><a href="#foot_krm_1064_08">8</a></sup> पृष्यम्, पर्ष्यम्, पिपर्षिष्यम्, परीपृष्यम्;</li> <li>  ईषत्पर्षः- <sup id="ref_krm_1064_09"><a href="#foot_krm_1064_09">9</a></sup> दुष्पर्षः-सुपर्षः;</li> <li>  -- -- पृष्यमाणः, पर्ष्यमाणः, पिपर्षिष्यमाणः, परीपृष्यमाणः;</li> <li>  पर्षः, पर्षः, पिपर्षिषः, परीपृषः;</li> <li>  पर्षितुम्, पर्षयितुम्, पिपर्षिषितुम्, परीपृषितुम्;</li> <li>  पृष्टिः, पर्षणा, पिपर्षिषा, परीपृषा;</li> <li>  पर्षणम्, पर्षणम्, पिपर्षिषणम्, परीपृषणम्;</li> <li>  <sup id="ref_krm_1064_10"><a href="#foot_krm_1064_10">10</a></sup> पर्षित्वा-पृष्ट्वा, पर्षयित्वा, पिपर्षिषित्वा, परीपृषित्वा;</li> <li>  प्रपृष्य, प्रपर्ष्य, प्रपिपर्षिष्य, प्रपरीपृष्य;</li> <li>  <sup id="ref_krm_1064_11"><a href="#foot_krm_1064_11">11</a></sup> दण्डोपपर्षम्, दण्डेनोपपर्षम्, दण्डपर्षं वा गाः कालयति। </li> <li>पर्षम् २, पर्षित्वा २ -पृष्ट्वा २, पर्षम् २, पर्षयित्वा २, पिपर्षिषम् २, पिपर्षिषित्वा २, परीपृषम् २;</li> <li>  परीपृषित्वा २;</li> <li>  <sup id="ref_krm_1064_12"><a href="#foot_krm_1064_12">12</a></sup> पृषितम्, <sup id="ref_krm_1064_13"><a href="#foot_krm_1064_13">13</a></sup> पृषत्-पृषती, <sup id="ref_krm_1064_14"><a href="#foot_krm_1064_14">14</a></sup> पृषतम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1064_01"><a href="#ref_krm_1064_01">↑</a> (१०५४)</li> <li id="foot_krm_1064_02"><a href="#ref_krm_1064_02">↑</a> (१-भ्वादिः-७०५। सक। सेट्। पर।)</li> <li id="foot_krm_1064_03"><a href="#ref_krm_1064_03">↑</a> [[२। यङन्ते सर्वत्र, ‘रीग् ऋदुपधस्य च’ (७-४-९०) इति रीगागमः।]]</li> <li id="foot_krm_1064_04"><a href="#ref_krm_1064_04">↑</a> [[३। ‘न गतिहिंसार्थेभ्यः’ (१-३-१५) इति कर्मव्यतीहारे शानज्निषेधात् शतैव।]]</li> <li id="foot_krm_1064_05"><a href="#ref_krm_1064_05">↑</a> [[४। उदित्त्वेन क्त्वायामिड्विकल्पनात्, निष्ठायाम्, ‘यस्य बिभाषा’ (७-२-१५) इतीण्निषेधः। ष्टुत्वम्।]]</li> <li id="foot_krm_1064_06"><a href="#ref_krm_1064_06">↑</a> [[५। नन्द्यादित्वेन (३-१-१३४) कर्तरि ल्युप्रत्ययः।]]</li> <li id="foot_krm_1064_07"><a href="#ref_krm_1064_07">↑</a> [पृष्ठम्०८९०+ २६]</li> <li id="foot_krm_1064_08"><a href="#ref_krm_1064_08">↑</a> [[१। ‘ऋदुपधात्--’ (३-१-११०) इति भावकर्मणोः क्यप्। ण्यदपवादः।]]</li> <li id="foot_krm_1064_09"><a href="#ref_krm_1064_09">↑</a> [[२। खल्विधायके सूत्रे (३-३-१२६) ‘दुस्’ इति सान्तस्योपसर्गस्योपादानम्, रेफान्तस्य च, इति पक्षद्वयम्। तत्र सान्तस्यैवेति पक्षे षत्वमत्रेति ज्ञेयम्। रेफान्तस्यैवेति पक्षे तु ‘दुरः षत्वणत्वयोरुपसर्गत्वप्रतिषेधः’ (वा। १-४-६०) इति उपसर्गत्वनिषेधात् षत्वाभावः।]]</li> <li id="foot_krm_1064_10"><a href="#ref_krm_1064_10">↑</a> [[३। ‘उदितो वा’ (७-२-५६) इति क्त्वायामिड्विकल्पः। इट्पक्षे, ‘न क्त्वा सेट्’ (१-२-१८) इति कित्त्वनिषेधाद् गुणः।]]</li> <li id="foot_krm_1064_11"><a href="#ref_krm_1064_11">↑</a> [[४। ‘हिंसार्थानां च समानकर्मकाणाम्’ (३-४-४८) इति णमुल्। ‘तृतीयाप्रभृतीन्य- न्यतरस्याम्’ (२-२-२१) इति समासविकल्पः।]]</li> <li id="foot_krm_1064_12"><a href="#ref_krm_1064_12">↑</a> [[५। बाहुलकान्निष्ठायामिडागम इति केचित्। वस्तुतस्तु बाहुलकात् औणादिके इतक्- प्रत्यये रूपमेवमिति ज्ञेयम्।]]</li> <li id="foot_krm_1064_13"><a href="#ref_krm_1064_13">↑</a> [[६। ‘वर्तमाने पृषद्-’ (द। उ। ६-५) इत्यादिना कतिप्रत्यये, तस्य शतृवद्भावेन शपि, पररूपे च रूपमेवम्। स्त्रियाम्, उगित्त्वेन, ‘उगितश्च’ (४-१-६) इति ङीपि पृषती इति रूपम्।]]</li> <li id="foot_krm_1064_14"><a href="#ref_krm_1064_14">↑</a> [[७। ‘पृषिरञ्जिभ्यां कित्’ (द। उ। ६-१५) इति अतच्प्रत्ययः। पृषतः = मृगः, बिन्दुश्च।]]</li></ul></p>

