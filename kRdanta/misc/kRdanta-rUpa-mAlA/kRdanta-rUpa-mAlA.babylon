<ul><li><sup id="ref_krm_0397_01"><a href="#foot_krm_0397_01">1</a></sup> {@“गल्भ धार्ष्ट्ये”@} <sup id="ref_krm_0397_02"><a href="#foot_krm_0397_02">2</a></sup> गल्भकः-ल्भिका, गल्भकः-ल्भिका, जिगल्भिषकः-षिका, जागल्भकः-ल्भिका;</li> <li>  गल्भिता-त्री, गल्भयिता-त्री, जिगल्भिषिता-त्री, जागल्भिता-त्री;</li> <li>  -- गल्भयन्-न्ती, गल्भयिष्यन्-न्ती-ती;</li> <li>  -- प्रगल्भमानः, <sup id="ref_krm_0397_03"><a href="#foot_krm_0397_03">3</a></sup> अवगल्भमानः, गल्भयमानः, जिगल्भिषमाणः, जागल्भ्यमानः;</li> <li>  <sup id="ref_krm_0397_04"><a href="#foot_krm_0397_04">4</a></sup> गल्भिष्यमाणः, गल्भयिष्यमाणः, जिगल्भिषिष्यमाणः, जागल्भिष्यमाणः, <sup id="ref_krm_0397_05"><a href="#foot_krm_0397_05">5</a></sup> प्रगल्-प्रगल्भौ-प्रगल्भः;</li> <li>  -- -- गल्भितम्-तः-तवान्, गल्भितः, जिगल्भिषितः, जागल्भितः-तवान्;</li> <li>  गल्भः-प्रगल्भः-अवगल्भः, <sup id="ref_krm_0397_06"><a href="#foot_krm_0397_06">6</a></sup> प्रगल्भी, <sup id="ref_krm_0397_07"><a href="#foot_krm_0397_07">7</a></sup> गल्भनः, गल्भः, जिगल्भिषुः, जागल्भः;</li> <li>  गल्भितव्यम्, गल्भयितव्यम्, जिगल्भिषितव्यम्, जागल्भितव्यम्;</li> <li>  गल्भनीयम्, गल्भनीयम्, जिगल्भिषणीयम्, जागल्भनीयम्;</li> <li>  गल्भ्यम्, गल्भ्यम्, जिगल्भिष्यम्, जागल्भ्यम्;</li> <li>  ईषद्गल्भः-दुर्गल्भः-सुगल्भः;</li> <li>  -- -- गल्भ्यमानः, गल्भ्यमानः, जिगल्भिष्यमाणः, जागल्भ्यमानः;</li> <li>  गल्भः, गल्भः जिगल्भिषः, जागल्भः;</li> <li>  गल्भितुम्, गल्भयितुम्, जिगल्भिषितुम्, जागल्भितुम्;</li> <li>  <sup id="ref_krm_0397_08"><a href="#foot_krm_0397_08">8</a></sup> गल्भा, गल्भना, जिगल्भिषा, जागल्भा;</li> <li>  गल्भनम्, गल्भनम्, जिगल्भिषणम्, जागल्भनम्;</li> <li>  गल्भित्वा, गल्भयित्वा, जिगल्भिषित्वा, जागल्भित्वा;</li> <li>  प्रगल्भ्य, प्रगल्भ्य, प्रजिगल्भिष्य, प्रजागल्भ्य;</li> <li>  गल्भम् २, गल्भित्वा २, गल्भम् २, गल्भयित्वा २, जिगल्भिषम् २, जिगल्भिषित्वा २, जागल्भम् २;</li> <li>  जागल्भित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0397_01"><a href="#ref_krm_0397_01">↑</a> (३८९)</li> <li id="foot_krm_0397_02"><a href="#ref_krm_0397_02">↑</a> (१-भ्वादिः-३९२। अक। सेट्। आत्म।)</li> <li id="foot_krm_0397_03"><a href="#ref_krm_0397_03">↑</a> [[२। अवगल्भ इवाचरन् = अवगल्भमानः। ‘आचारेऽवगल्भ--’ (वा। ३-१-११)]]</li> <li id="foot_krm_0397_04"><a href="#ref_krm_0397_04">↑</a> [पृष्ठम्०३८२+ २५]</li> <li id="foot_krm_0397_05"><a href="#ref_krm_0397_05">↑</a> [[१। क्विपि भकारस्य संयोगान्तलोपः।]]</li> <li id="foot_krm_0397_06"><a href="#ref_krm_0397_06">↑</a> [[२। ‘सुप्यजादौ’--(३-२-७८) इति ताच्छील्ये णिनिः।]]</li> <li id="foot_krm_0397_07"><a href="#ref_krm_0397_07">↑</a> [[३। ‘अनुदात्तेतश्च हलादेः’ (३-२-१४९) इति ताच्छीलिकः युच्।]]</li> <li id="foot_krm_0397_08"><a href="#ref_krm_0397_08">↑</a> [[४। स्त्रियां भावादौ ‘गुरोश्च हलः’ (३-३-१०३) इति अकारप्रत्ययः।]]</li></ul></p>

गल्ह
<ul><li><sup id="ref_krm_0398_01"><a href="#foot_krm_0398_01">1</a></sup> {@“गल्ह कुत्सायाम्”@} <sup id="ref_krm_0398_02"><a href="#foot_krm_0398_02">2</a></sup> क्विपि, प्रगल्-प्रगल्हौ-प्रगल्हः, इति रूपम्। </li> <li>हकारस्य संयोगान्तलोपः। </li> <li>अन्यानि सर्वाणि रूपाणि-ण्यन्तात्-सन्नन्तात्-यङन्ताच्च गर्हतिवत् <sup id="ref_krm_0398_03"><a href="#foot_krm_0398_03">3</a></sup> बोध्यानि। </li> <li>यथा--गल्हकः-ल्हिका, गल्हकः-ल्हिका, जिगल्हिषकः-षिका, जागल्हकः-ल्हिका, इत्यादिकानि। </li> <li>ण्यति <sup id="ref_krm_0398_04"><a href="#foot_krm_0398_04">4</a></sup> गल्ह्यम्। </li> <li><sup id="ref_krm_0398_05"><a href="#foot_krm_0398_05">5</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0398_01"><a href="#ref_krm_0398_01">↑</a> (३९०)</li> <li id="foot_krm_0398_02"><a href="#ref_krm_0398_02">↑</a> (१-भ्वादिः-६३७। सक। सेट्। आत्म।)</li> <li id="foot_krm_0398_03"><a href="#ref_krm_0398_03">↑</a> (३८५)</li> <li id="foot_krm_0398_04"><a href="#ref_krm_0398_04">↑</a> [[आ। अक्रूर एत्य बहुधा गतमंहितांहा गर्होज्झितोऽपतदगल्ह्यतमे पदाब्जे।।’ धा। का। १-८०।]]</li> <li id="foot_krm_0398_05"><a href="#ref_krm_0398_05">↑</a> [पृष्ठम्०३८३+ २७]</li></ul></p>

गवेष|गवेषकः-षिका|जिगवेषयिषकः-षिका
<ul><li><sup id="ref_krm_0399_01"><a href="#foot_krm_0399_01">1</a></sup> {@“गवेष मार्गणे”@} <sup id="ref_krm_0399_02"><a href="#foot_krm_0399_02">2</a></sup> अदन्तः। </li> <li>गवेषकः-षिका, जिगवेषयिषकः-षिका;</li> <li>  गवेषयिता-त्री, जिगवेष- यिषिता-त्री, क्विपि-गवेट्-गवेषौ-गवेषः, इत्यादीनि रूपाणि सर्वाण्यपि कथयतिवत् <sup id="ref_krm_0399_03"><a href="#foot_krm_0399_03">3</a></sup> ज्ञेयानि। </li> <li>तुमुनि--गवेषयितुम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0399_01"><a href="#ref_krm_0399_01">↑</a> (३९१)</li> <li id="foot_krm_0399_02"><a href="#ref_krm_0399_02">↑</a> (१०-चुरादिः-१८८४। सक। सेट्। उभ।)</li> <li id="foot_krm_0399_03"><a href="#ref_krm_0399_03">↑</a> (१६२)</li></ul></p>

