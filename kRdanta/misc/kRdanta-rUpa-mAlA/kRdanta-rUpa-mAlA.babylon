<ul><li><sup id="ref_krm_0832_01"><a href="#foot_krm_0832_01">1</a></sup> {@“दल विशरणे”@} <sup id="ref_krm_0832_02"><a href="#foot_krm_0832_02">2</a></sup> घटादिः। </li> <li><sup id="ref_krm_0832_03"><a href="#foot_krm_0832_03">3</a></sup> ‘दलिवलिस्खलिरणिध्वनित्रपिक्षपयश्च’ इति घटादिषु भोजसम्मतः पाठः। </li> <li>भ्वादिषु ‘दल विशरणे’ इति पठितस्यैव घटादिषु तस्मिन्नेवार्थे मित्त्वार्थोऽनुवाद इति सिद्धान्तकौमुद्यादितः ज्ञायते। </li> <li>मा। </li> <li>धातुवृत्त्यादिषु तु, ‘दल विदारणे’ इति चुरादिषु पठितस्यापि घटादिषु मित्त्वार्थोऽर्थविशेषे भोजसम्मतः पाठ इति दृश्यते। </li> <li>उभयथाऽपि नार्थे भेदः।]] ‘विदारणे शपि दलेद् दालयेदिति णौ दलेः।।’ <sup id="ref_krm_0832_04"><a href="#foot_krm_0832_04">4</a></sup> इति देवः। </li> <li>उद्दालकः-लिका, <sup id="ref_krm_0832_05"><a href="#foot_krm_0832_05">5</a></sup> दलकः-दालकः-लिका, दिदलिषकः-षिका, दादलकः-लिका;</li> <li>  दलिता-त्री, दलयिता-दालयिता-त्री, दिदलिषिता-त्री, दादलिता-त्री;</li> <li>  दलिष्यन्-न्ती-ती, दलयिष्यन्-दालयिष्यन्-न्ती-ती, दिदलिषिष्यन्-न्ती-ती;</li> <li>  -- <sup id="ref_krm_0832_06"><a href="#foot_krm_0832_06">6</a></sup> -- दलयमानः-दालयमानः, -- दादल्यमानः;</li> <li>  -- दलयिष्यमाणः, दालयिष्यमाणः -- दादलिष्यमाणः;</li> <li>  प्रदल्-प्रदलौ-प्रदलः;</li> <li>  -- -- -- दलितम्-तः, दलितः-दालितः, दिदलिषितः, दादलितः-तवान्;</li> <li>  दलम्, <sup id="ref_krm_0832_07"><a href="#foot_krm_0832_07">7</a></sup> कुद्दालः, दलः-दालः, दिदलिषुः, दादलः;</li> <li>  दलितव्यम्, दलयितव्यम्-दालयितव्यम्, दिदलिषितव्यम्, दादलितव्यम्;</li> <li>  दलनीयम्, दलनीयम्-दालनीयम्, दिदलिषणीयम्, दादलनीयम्;</li> <li>  दाल्यम्, दल्यम्-दाल्यम्, दिदलिष्यम्, दादल्यम्;</li> <li>  ईषद्दलः-दुर्दलः-सुदलः;</li> <li>  -- -- दल्यमानः, दल्यमानः-दाल्यमानः, दिदलिष्यमाणः, दादल्यमानः;</li> <li>  दालः, <sup id="ref_krm_0832_08"><a href="#foot_krm_0832_08">8</a></sup> दाडि<sup id="ref_krm_0832_09"><a href="#foot_krm_0832_09">9</a></sup>मम्, दलः-दालः, दिदलिषः, दादलः;</li> <li>  दलितुम्, दलयितुम्-दालयितुम्, दिदलिषितुम्, दादलितुम्;</li> <li>  <sup id="ref_krm_0832_10"><a href="#foot_krm_0832_10">10</a></sup> दलितिः, दलना-दालना, दिदलिषा, दादला;</li> <li>  दलनम्, दलनम्-दालनम्, दिदलिषणम्, दादलनम्;</li> <li>  दलित्वा, दलयित्वा-दालयित्वा, दिदलिषित्वा, दादलित्वा;</li> <li>  प्रदल्य, प्रदलय्य-प्रदाल्य, प्रदिदलिष्य, प्रदादल्य;</li> <li>  दालम् २, दलित्वा २, दलम् २-दालम् २-दालम् २, दलयित्वा २-दालयित्वा २, दिदलिषम् २, दिदलिषित्वा २, दादलम् २;</li> <li>  दादलित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0832_01"><a href="#ref_krm_0832_01">↑</a> (८२२)</li> <li id="foot_krm_0832_02"><a href="#ref_krm_0832_02">↑</a> (१-भ्वादिः-५४८। सक। सेट्। पर।)</li> <li id="foot_krm_0832_03"><a href="#ref_krm_0832_03">↑</a> [[[अ]</li> <li id="foot_krm_0832_04"><a href="#ref_krm_0832_04">↑</a> (श्लो १५९)</li> <li id="foot_krm_0832_05"><a href="#ref_krm_0832_05">↑</a> [[५। ‘घटादयो मितः’ (ग। सू। भ्वादौ) इति मित्संज्ञायाम्, ‘मितां ह्रस्वः’ (६-४-९२) णावुपधाह्रस्वः। एवं मित्त्वपक्षे ण्यन्ते सर्वत्र ज्ञेयम्। पाणिनिमते घटादिष्वस्य पाठाभावात्, मित्त्वाभावपक्षे दालकः इत्यादीनि रूपाणीति ज्ञेयम्।]]</li> <li id="foot_krm_0832_06"><a href="#ref_krm_0832_06">↑</a> [पृष्ठम्०७२७+ २५]</li> <li id="foot_krm_0832_07"><a href="#ref_krm_0832_07">↑</a> [[१। कुं = भूमिं दलतीति कुद्दालः = आयुधविशेषः। ‘कर्मण्यण्’ (३-२-१) इत्यण्। पृषोदरादित्वात् (६-१-११०) कुशब्दोत्तरं दकारः प्रवृत्तः।]]</li> <li id="foot_krm_0832_08"><a href="#ref_krm_0832_08">↑</a> [[२। भावघञन्तात् दालशब्दात्, ‘निर्वृत्तेऽक्षद्यूतादिभ्यः’ (४-४-१९) इति प्रकरणे निर्वृत्तार्थे ‘भावप्रत्ययान्तादिमब् वक्तव्यः’ (वा। ४-४-२०) इति इमप्प्रत्ययः।]]</li> <li id="foot_krm_0832_09"><a href="#ref_krm_0832_09">↑</a> [लि]</li> <li id="foot_krm_0832_10"><a href="#ref_krm_0832_10">↑</a> [[३। ‘तितुत्रेष्वग्रहादीनाम्--’ (वा। ७-२-९) इति वचनात् भणितिः इत्यादाविवात्रापि इडागमो ज्ञेयः।]]</li></ul></p>

दल|दालकः-लिका|दिदालयिषकः-षिका
<ul><li><sup id="ref_krm_0833_01"><a href="#foot_krm_0833_01">1</a></sup> {@“दल विदारणे”@} <sup id="ref_krm_0833_02"><a href="#foot_krm_0833_02">2</a></sup> आस्वदीयः। </li> <li>‘विदारणे शपि दलेद् दालयेदिति णौ दलेः।।’ <sup id="ref_krm_0833_03"><a href="#foot_krm_0833_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_0833_04"><a href="#foot_krm_0833_04">4</a></sup> दालकः-लिका, दिदालयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरा- दिककालयतिवत् <sup id="ref_krm_0833_05"><a href="#foot_krm_0833_05">5</a></sup> ऊह्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0833_01"><a href="#ref_krm_0833_01">↑</a> (८२३)</li> <li id="foot_krm_0833_02"><a href="#ref_krm_0833_02">↑</a> (१०-चुरादिः-१७५२। सक। सेट्। उभ।)</li> <li id="foot_krm_0833_03"><a href="#ref_krm_0833_03">↑</a> (श्लो। १५९)</li> <li id="foot_krm_0833_04"><a href="#ref_krm_0833_04">↑</a> [पृष्ठम्०७२८+ २५]</li> <li id="foot_krm_0833_05"><a href="#ref_krm_0833_05">↑</a> (१७५)</li></ul></p>

दशि
<ul><li><sup id="ref_krm_0834_01"><a href="#foot_krm_0834_01">1</a></sup> {@“दशि दंशने”@} <sup id="ref_krm_0834_02"><a href="#foot_krm_0834_02">2</a></sup> आकुस्मीयः। </li> <li>‘दंशने दशतीति स्यात् तत्र दंशयते णिचि।। </li> <li>भाषणे दंशयेत् … … …।’ <sup id="ref_krm_0834_03"><a href="#foot_krm_0834_03">3</a></sup> इति देवः। </li> <li>दंशकः-शिका, दिदंशयिषकः-षिका, इत्यादिकानि रूपाणि सर्वाण्यपि चौरा- दिककुंशयतिवत् <sup id="ref_krm_0834_04"><a href="#foot_krm_0834_04">4</a></sup> ज्ञेयानि। </li> <li>आकुस्मीयत्वादस्य शानजेव भवति। </li> <li>दंशयमानः, दिदंशयिषमाणः, इति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0834_01"><a href="#ref_krm_0834_01">↑</a> (८२४)</li> <li id="foot_krm_0834_02"><a href="#ref_krm_0834_02">↑</a> (१०-चुरादिः-१६७५। सक। सेट्। आत्म।)</li> <li id="foot_krm_0834_03"><a href="#ref_krm_0834_03">↑</a> (श्लो। १६४-५)</li> <li id="foot_krm_0834_04"><a href="#ref_krm_0834_04">↑</a> (२३२)</li></ul></p>

दशि|दंशकः-शिका|दिदंशयिषकः-षिका
<ul><li><sup id="ref_krm_0835_01"><a href="#foot_krm_0835_01">1</a></sup> {@“दशि भाषार्थः”@} <sup id="ref_krm_0835_02"><a href="#foot_krm_0835_02">2</a></sup> आस्वदीयः। </li> <li>‘भासार्थः’ इति क्षीरस्वामी। </li> <li>‘दंशने दशतीति स्यात् तत्र दंशयते णिचि।। </li> <li>भाषणे दंशयेत्… …।’ <sup id="ref_krm_0835_03"><a href="#foot_krm_0835_03">3</a></sup> इति देवः। </li> <li>दंशकः-शिका, दिदंशयिषकः-षिका;</li> <li>  इत्यादिकानि रूपाणि सर्वाण्यपि चौरादिककुंशयतिवत् <sup id="ref_krm_0835_04"><a href="#foot_krm_0835_04">4</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0835_01"><a href="#ref_krm_0835_01">↑</a> (८२५)</li> <li id="foot_krm_0835_02"><a href="#ref_krm_0835_02">↑</a> (१०-चुरादिः-१७६५। सक। सेट्। उभ।)</li> <li id="foot_krm_0835_03"><a href="#ref_krm_0835_03">↑</a> (श्लो। १६४-१६५)</li> <li id="foot_krm_0835_04"><a href="#ref_krm_0835_04">↑</a> (२३२)</li></ul></p>

दसि|दंसकः-सिका|दिदंसयिषकः-षिका
<ul><li><sup id="ref_krm_0836_01"><a href="#foot_krm_0836_01">1</a></sup> {@“दसि दर्शनदंशनयोः”@} <sup id="ref_krm_0836_02"><a href="#foot_krm_0836_02">2</a></sup> आकुस्मीयः। </li> <li>‘दंसयेन् मोक्षणे, दस्येत् क्षये, दंसयते णिचि।। </li> <li>दंशदर्शनयोः, दासेर्दाने दासति दासते।’ <sup id="ref_krm_0836_03"><a href="#foot_krm_0836_03">3</a></sup> इति देवः। </li> <li>दंसकः-सिका, दिदंसयिषकः-षिका;</li> <li>  इत्यादीनि समस्तान्यपि रूपाणि चौरादिककुंशयतिवत् <sup id="ref_krm_0836_04"><a href="#foot_krm_0836_04">4</a></sup> ज्ञेयानि। </li> <li>“अत्र ‘दस--’ इत्यनिदितमपि केचित् पठन्ति। </li> <li>यदाह-- ‘पितेव पुत्रं दसये वचोभिः--’ इत्यत्र भट्टभास्करः-- ‘दसये = संगृह्णामि। </li> <li>‘दस दंशन- दर्शनयोः’ चौरादिक उदात्तेत्। </li> <li>व्यत्ययेन वृद्ध्यभावः।’ इति।” इति माधवधातुवृत्तौ। </li> <li><sup id="ref_krm_0836_05"><a href="#foot_krm_0836_05">5</a></sup> ‘दस--’ इति पाठमवलब्म्य, अस्माद्धातोर्निष्ठायाम्, ‘वा दान्त- शान्तपूर्णदस्तस्पष्टच्छन्नज्ञप्ताः’ <sup id="ref_krm_0836_06"><a href="#foot_krm_0836_06">6</a></sup> इत्यनेन इडभावो णिलुक् च निपा- तितौ। </li> <li>तेन दस्तः, दासितः इति रूपद्वयम्। </li> <li>‘दंसयेन्मोक्षणे--’ इति देवश्लोकात् मोक्षणेऽपि कश्चन दंसधातुर- स्तीति प्रतीयते। </li> <li>प्रकृतधातुपाठकोशेषु तु न दृश्यते। </li> <li>‘रक्षणे’ इत्यर्थे जसि धातोरनन्तरं क्वचिदस्योल्लेखः पुरुषकारे कृतः। </li> <li>अिदित्करणाण्णिचो वैकल्पिकत्वम्। </li> <li>णिजभावपक्षे-- ‘शेषात् कर्तरि--’ <sup id="ref_krm_0836_07"><a href="#foot_krm_0836_07">7</a></sup> इति परस्मैपदं शता भवति-- <sup id="ref_krm_0836_08"><a href="#foot_krm_0836_08">8</a></sup> प्रदंसन्। </li> <li>‘दसि दंसनदर्शनयोः’ ‘दंसनम् = वर्मग्रहणम्।’ इति धातुकाव्ये <sup id="ref_krm_0836_09"><a href="#foot_krm_0836_09">9</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0836_01"><a href="#ref_krm_0836_01">↑</a> (८२६)</li> <li id="foot_krm_0836_02"><a href="#ref_krm_0836_02">↑</a> (१०-चुरादिः-१६७६। सक। सेट्। आत्म।)</li> <li id="foot_krm_0836_03"><a href="#ref_krm_0836_03">↑</a> (श्लो। १८६-७)</li> <li id="foot_krm_0836_04"><a href="#ref_krm_0836_04">↑</a> (२३२)</li> <li id="foot_krm_0836_05"><a href="#ref_krm_0836_05">↑</a> [पृष्ठम्०७२९+ २७]</li> <li id="foot_krm_0836_06"><a href="#ref_krm_0836_06">↑</a> (७-२-२७)</li> <li id="foot_krm_0836_07"><a href="#ref_krm_0836_07">↑</a> (१-३-७८)</li> <li id="foot_krm_0836_08"><a href="#ref_krm_0836_08">↑</a> [[आ। ‘लोको हरेर्बलमचेतयमान एतद् युद्धं मृगेन्द्रशशदंशनवत् प्रदंसन्।’ धा। का। ३। ३३।]]</li> <li id="foot_krm_0836_09"><a href="#ref_krm_0836_09">↑</a> (३-३३।)</li></ul></p>

दसि|दंसकः-सिका|दिदंसयिषकः-षिका
<ul><li><sup id="ref_krm_0837_01"><a href="#foot_krm_0837_01">1</a></sup> {@“दसि भाषार्थः”@} <sup id="ref_krm_0837_02"><a href="#foot_krm_0837_02">2</a></sup> दंसकः-सिका, दिदंसयिषकः-षिका;</li> <li>  इत्यादिकानि समस्तान्यपि रूपाणि चौरादिककुंशयतिवत् <sup id="ref_krm_0837_03"><a href="#foot_krm_0837_03">3</a></sup> बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0837_01"><a href="#ref_krm_0837_01">↑</a> (८२७)</li> <li id="foot_krm_0837_02"><a href="#ref_krm_0837_02">↑</a> (१०-चुरादिः-१७८७। सक। अक। सेट्। उभ। आस्वदीयः।)</li> <li id="foot_krm_0837_03"><a href="#ref_krm_0837_03">↑</a> (२३२)</li></ul></p>

दसु|दासकः-सिका|दिदसिषकः-षिका|दादसकः-सिका
<ul><li><sup id="ref_krm_0838_01"><a href="#foot_krm_0838_01">1</a></sup> {@“दसु उपक्षये”@} <sup id="ref_krm_0838_02"><a href="#foot_krm_0838_02">2</a></sup> ‘--उपतापे’ इति दशपाद्युणादिवृत्तौ पाठः। </li> <li>‘दंसयेन्मोक्षणे, दस्येत् क्षये, दंसयते णिचि।। </li> <li>दंशदर्शनयोः, दासेर्दाने दासति दासते।’ <sup id="ref_krm_0838_03"><a href="#foot_krm_0838_03">3</a></sup> इति देवः। </li> <li>दासकः-सिका, दासकः-सिका, दिदसिषकः-षिका, दादसकः-सिका;</li> <li>  इत्यादिकानि समस्तान्यपि रूपाणि दैवादिकक्नस्यतिवत् <sup id="ref_krm_0838_04"><a href="#foot_krm_0838_04">4</a></sup> ऊह्यानि। </li> <li>अस्य घटादिषु पाठाभावाण्ण्यन्ते मित्त्वं न प्रवर्तते, इति विशेषः। </li> <li>अस्यापि धातोर्ण्यन्ते ‘वा दान्त--’ <sup id="ref_krm_0838_05"><a href="#foot_krm_0838_05">5</a></sup> इत्यादिना णिलुकि इडभावे च दस्तः, दासितः इति निपात्यते। </li> <li><sup id="ref_krm_0838_06"><a href="#foot_krm_0838_06">6</a></sup> इत्यादिना युच्प्रत्ययः। </li> <li>दस्यतीति दस्युः = तस्करः।]] दस्युः, <sup id="ref_krm_0838_07"><a href="#foot_krm_0838_07">7</a></sup> इत्यादिना रक्प्रत्ययः। </li> <li>दस्यतीति दस्रः = देवभिषक्। </li> <li>पुष्पवन्तशब्दादिवत् नित्यद्विवचनान्तोऽयं शब्दः।]] दस्रौ। </li> <li><sup id="ref_krm_0838_08"><a href="#foot_krm_0838_08">8</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0838_01"><a href="#ref_krm_0838_01">↑</a> (८२८)</li> <li id="foot_krm_0838_02"><a href="#ref_krm_0838_02">↑</a> (४-दिवादिः-१२१३। सक। सेट्। पर।)</li> <li id="foot_krm_0838_03"><a href="#ref_krm_0838_03">↑</a> (श्लो। १८६-१८७)</li> <li id="foot_krm_0838_04"><a href="#ref_krm_0838_04">↑</a> (२६५)</li> <li id="foot_krm_0838_05"><a href="#ref_krm_0838_05">↑</a> (७-२-२७)</li> <li id="foot_krm_0838_06"><a href="#ref_krm_0838_06">↑</a> [[१। ‘यजिमनिशुन्धिदसि--’ [द। उ। १। १३४]</li> <li id="foot_krm_0838_07"><a href="#ref_krm_0838_07">↑</a> [[२। ‘स्फायितञ्चि--’ [द। उ। ८-३१]</li> <li id="foot_krm_0838_08"><a href="#ref_krm_0838_08">↑</a> [पृष्ठम्०७३०+ २६]</li></ul></p>

दह|दाहकः-हिका|दिधक्षकः-क्षिका|दन्दहकः-दंदहकः-हिका|दग्धा-दग्ध्री|दाहयिता-त्री|दिधक्षिता-त्री|दन्दहिता-त्री|दहन्-न्ती|दाहयन्-न्ती|दिधक्षन्-न्ती|दिधक्षयन्|-धक्ष्यन्-न्ती-ती|दाहयिष्यन्-न्ती-ती|दिधक्षिष्यन्-न्ती-ती|-|व्यतिदहमानः|दाहयमानः|दन्दह्यमानः|व्यतिधक्ष्यमाणः|दाहयिष्यमाणः|दन्दहिष्यमाणः|प्रधकू-प्रधगू-प्रदहौ-प्रदहः|दग्धम्-दग्धः-दग्धवान्|दाहितः|दिधक्षितः|दन्दहितः-तवान्|दहनः|परिदाही|दाहः|दिधक्षुः|दन्दहः|दग्धव्यम्|दाहयितव्यम्|दिधक्षितव्यम्|दन्दहितव्यम्|दहनीयम्|दहेलिमः|दाहनीयम्|दिधक्षणीयम्|दन्दहनीयम्|दाह्यम्|दिधक्ष्यम्|दन्दह्यम्|ईषद्दहः-दुर्दहः-सुदहः|दह्यमानः|दाह्यमानः|दिधक्ष्यमाणः|निदाघः-अवदाघः|दिधक्षः|दग्धुम्|दाहयितुम्|दिधक्षितुम्|दन्दहितुम्|दग्धिः|दाहना|दिधक्षा|दन्दहा|दहनम्|दाहनम्|दिधक्षणम्|दन्दहनम्|दग्ध्वा|दाहयित्वा|दिधक्षित्वा|दन्दहित्वा|प्रदह्य|प्रदाह्य|प्रदिधक्ष्य|प्रदन्दह्य|दाहम्|दिधक्षम्|दन्दहम्
<ul><li><sup id="ref_krm_0839_01"><a href="#foot_krm_0839_01">1</a></sup> {@“दह भस्मीकरणे”@} <sup id="ref_krm_0839_02"><a href="#foot_krm_0839_02">2</a></sup> दाहकः-हिका, दाहकः-हिका, <sup id="ref_krm_0839_03"><a href="#foot_krm_0839_03">3</a></sup> दिधक्षकः-क्षिका, <sup id="ref_krm_0839_04"><a href="#foot_krm_0839_04">4</a></sup> दन्दहकः-दंदहकः-हिका;</li> <li>  <sup id="ref_krm_0839_05"><a href="#foot_krm_0839_05">5</a></sup> दग्धा-दग्ध्री, दाहयिता-त्री, दिधक्षिता-त्री, दन्दहिता-त्री;</li> <li>  दहन्-न्ती, दाहयन्-न्ती, दिधक्षन्-न्ती, <sup id="ref_krm_0839_06"><a href="#foot_krm_0839_06">6</a></sup> दिधक्षयन् <sup id="ref_krm_0839_07"><a href="#foot_krm_0839_07">7</a></sup>;</li> <li>  -- <sup id="ref_krm_0839_08"><a href="#foot_krm_0839_08">8</a></sup> धक्ष्यन्-न्ती-ती, दाहयिष्यन्-न्ती-ती, दिधक्षिष्यन्-न्ती-ती;</li> <li>  -- व्यतिदहमानः, दाहयमानः, -- दन्दह्यमानः;</li> <li>  व्यतिधक्ष्यमाणः, दाहयिष्यमाणः, -- दन्दहिष्यमाणः;</li> <li>  <sup id="ref_krm_0839_09"><a href="#foot_krm_0839_09">9</a></sup> प्रधकू-प्रधगू-प्रदहौ-प्रदहः;</li> <li>  -- -- -- दग्धम्-दग्धः-दग्धवान्, दाहितः, दिधक्षितः, दन्दहितः-तवान्;</li> <li>  <sup id="ref_krm_0839_10"><a href="#foot_krm_0839_10">10</a></sup> दहनः, <sup id="ref_krm_0839_11"><a href="#foot_krm_0839_11">11</a></sup> परिदाही, दाहः, दिधक्षुः, दन्दहः;</li> <li>  दग्धव्यम्, दाहयितव्यम्, दिधक्षितव्यम्, दन्दहितव्यम्;</li> <li>  दहनीयम्, <sup id="ref_krm_0839_12"><a href="#foot_krm_0839_12">12</a></sup> दहेलिमः, दाहनीयम्, दिधक्षणीयम्, दन्दहनीयम्;</li> <li>  <sup id="ref_krm_0839_13"><a href="#foot_krm_0839_13">13</a></sup> दाह्यम्, दाह्यम्, दिधक्ष्यम्, दन्दह्यम्;</li> <li>  ईषद्दहः-दुर्दहः-सुदहः;</li> <li>  -- -- -- दह्यमानः, दाह्यमानः, दिधक्ष्यमाणः, दन्दह्यमानः;</li> <li>  दाहः, <sup id="ref_krm_0839_14"><a href="#foot_krm_0839_14">14</a></sup> निदाघः <sup id="ref_krm_0839_15"><a href="#foot_krm_0839_15">15</a></sup> -अवदाघः, दाहः, दिधक्षः, दन्दहः;</li> <li>  दग्धुम्, दाहयितुम्, दिधक्षितुम्, दन्दहितुम्;</li> <li>  दग्धिः, दाहना, दिधक्षा, दन्दहा;</li> <li>  दहनम्, दाहनम्, दिधक्षणम्, दन्दहनम्;</li> <li>  दग्ध्वा, दाहयित्वा, दिधक्षित्वा, दन्दहित्वा;</li> <li>  प्रदह्य, प्रदाह्य, प्रदिधक्ष्य, प्रदन्दह्य;</li> <li>  दाहम् २, दग्ध्वा २, दाहम् २, दाहयित्वा २, दिधक्षम् २, दिधक्षित्वा २, दन्दहम् २;</li> <li>  दन्दहित्वा २;</li> <li>  <sup id="ref_krm_0839_16"><a href="#foot_krm_0839_16">16</a></sup> इत्यादिना रक्प्रत्ययः। </li> <li>दह्रः = अग्निः सूर्यो वा।]] दह्रः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0839_01"><a href="#ref_krm_0839_01">↑</a> (८२९)</li> <li id="foot_krm_0839_02"><a href="#ref_krm_0839_02">↑</a> (१-भ्वादिः-९९१। सक। अनि। पर।)</li> <li id="foot_krm_0839_03"><a href="#ref_krm_0839_03">↑</a> [[१। ‘दादेर्धातोर्घः’ (८-२-३२) इति हकारस्य घत्वे, ‘एकाचो बशो भष् झषन्तस्य स्ध्वोः’ (८-२-३७) इति भष्भावेन दकारस्य धकारे, ‘खरि च’ (८-४-५५) इति चर्त्वे, षत्वे च, दिधक्षकः इति रूपम्। एवं सन्नन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0839_04"><a href="#ref_krm_0839_04">↑</a> [[२। ‘लुपसदचरजपजभदहदशगॄभ्यो भावगर्हायाम्’ (३-१-२४) इति यङ् भावगर्हायाम्। ‘जपजभदहदशभञ्जपशां च’ (७-४-८६) इति अभ्यासस्य नुगागमः। ‘स च पदान्तवद् वाच्यः’ (वा। ७-४-८५) इति पदान्तवद्भावेन, ‘वा पदान्तस्य’। (८-४-५९) इति परसवर्णविकल्पः। एवं यङन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0839_05"><a href="#ref_krm_0839_05">↑</a> [[३। तृचि, घत्वधत्वजश्त्वानि भवन्ति। एवमेव तव्यदादिष्वपि प्रक्रियोह्या।]]</li> <li id="foot_krm_0839_06"><a href="#ref_krm_0839_06">↑</a> [[४। सन्नन्ताण्णिचि शतरि रूपमेवम्। ‘स्याच्छुद्धा प्रकृतिर्ण्यन्ता सन्नन्ता णिचि सन्परा। यङन्ता यङ्लुगन्ता च नातोऽन्या निष्प्रयोजना।।’ इति क्षीरस्वाम्युक्तमिह ध्येयम्।]]</li> <li id="foot_krm_0839_07"><a href="#ref_krm_0839_07">↑</a> [[आ। ‘तं सुस्थयन्तः सचिवा नरेन्द्रं दिधक्षयन्तः समुदूहुरारात्।’ भ। का। ३। ३३।]]</li> <li id="foot_krm_0839_08"><a href="#ref_krm_0839_08">↑</a> [[५। घत्वचर्त्वभष्भावषत्वेषु रूपमेवम्।]]</li> <li id="foot_krm_0839_09"><a href="#ref_krm_0839_09">↑</a> [[६। क्विपि, घत्वभष्भावचर्त्वजश्त्वेषु रूपमेवम्।]]</li> <li id="foot_krm_0839_10"><a href="#ref_krm_0839_10">↑</a> [[७। नन्द्यादेः (३-१-१३४) आकृतिगणत्वात् कर्तरि ल्युः। दहनः = अग्निः।]]</li> <li id="foot_krm_0839_11"><a href="#ref_krm_0839_11">↑</a> [[८। ‘सम्पृचानुरुधाङ्यमाङ्यसपरिसृसंसृजपरिदेविसंज्वरपरिक्षिपपरिरटपरिवदपरिदह--’ (३-२-१४२) इत्यादिना तच्छीलादिषु कर्तृषु घिनुण्प्रत्ययो भवति।]]</li> <li id="foot_krm_0839_12"><a href="#ref_krm_0839_12">↑</a> [[९। ‘केलिमर उपसंख्यानम्’ (वा। ३-१-९६) इति भावकर्मणोः केलिमर् प्रत्ययः।]]</li> <li id="foot_krm_0839_13"><a href="#ref_krm_0839_13">↑</a> [पृष्ठम्०७३१+ २८]</li> <li id="foot_krm_0839_14"><a href="#ref_krm_0839_14">↑</a> [[१। नितरां दहतीति निदाघः। घञि, न्यङ्क्वादिषु (७-३-५३) ‘संज्ञायां मेघनि- दाघावदाघार्घाः’ (ग। सू। ७-३-५३) इति वचनात् कुत्वम्। निदाघः = ग्रीष्मः। अवदाघः = भक्ष्यविशेषः। असंज्ञायां तु निदाहः, अवदाहः इत्येव भवति।]]</li> <li id="foot_krm_0839_15"><a href="#ref_krm_0839_15">↑</a> [[आ। ‘कृत्वा स कृत्यं दशनांशुगौरं कृष्णं ययौ दैत्यनिदाघमेघम्।।’ धा। का। २। ४०।]]</li> <li id="foot_krm_0839_16"><a href="#ref_krm_0839_16">↑</a> [[२। ‘स्फायितञ्चि--’ [द। उ। ८। ३१]</li></ul></p>

