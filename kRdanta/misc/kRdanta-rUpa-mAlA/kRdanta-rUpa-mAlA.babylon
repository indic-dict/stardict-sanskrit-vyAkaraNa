<ul><li><sup id="ref_krm_0967_01"><a href="#foot_krm_0967_01">1</a></sup> {@“डु पचष् पाके”@} <sup id="ref_krm_0967_02"><a href="#foot_krm_0967_02">2</a></sup> पाचकः-चिका, पाचकः-चिका, <sup id="ref_krm_0967_03"><a href="#foot_krm_0967_03">3</a></sup> पिपक्षकः-क्षिका, <sup id="ref_krm_0967_04"><a href="#foot_krm_0967_04">4</a></sup> पापचकः-चिका;</li> <li>  <sup id="ref_krm_0967_05"><a href="#foot_krm_0967_05">5</a></sup> पक्ता-त्री, पाचयिता-त्री, पिपक्षिता-त्री, पापचिता-त्री;</li> <li>  पचन्-न्ती, पाचयन्-न्ती, पिपक्षन्-न्ती;</li> <li>  -- <sup id="ref_krm_0967_06"><a href="#foot_krm_0967_06">6</a></sup> प्रणिपक्ष्यन्-प्रनिपक्ष्यन्-<sup id="ref_krm_0967_07"><a href="#foot_krm_0967_07">7</a></sup>-न्ती-ती, पाचयिष्यन्-न्ती-ती, पिपक्षिष्यन्-न्ती-ती;</li> <li>  <sup id="ref_krm_0967_08"><a href="#foot_krm_0967_08">8</a></sup> पचमानः, पाचयमानः, पिपक्षमाणः, पापच्यमानः;</li> <li>  पक्ष्यमाणः, पाचयिष्यमाणः, पिपक्षिष्यमाणः, पापचिष्यमाणः;</li> <li>  <sup id="ref_krm_0967_09"><a href="#foot_krm_0967_09">9</a></sup> ओदनपक्-पचौ-पचः;</li> <li>  -- -- <sup id="ref_krm_0967_10"><a href="#foot_krm_0967_10">10</a></sup> पक्वम्-पक्वः-पक्ववान्, <sup id="ref_krm_0967_11"><a href="#foot_krm_0967_11">11</a></sup> प्रपक्वानि <sup id="ref_krm_0967_12"><a href="#foot_krm_0967_12">12</a></sup>, पाचितः, पिपक्षितः, पापचितः-तवान्;</li> <li>  <sup id="ref_krm_0967_13"><a href="#foot_krm_0967_13">13</a></sup> पचः, <sup id="ref_krm_0967_14"><a href="#foot_krm_0967_14">14</a></sup> श्वपचः, <sup id="ref_krm_0967_15"><a href="#foot_krm_0967_15">15</a></sup> दूरेपाकः-अक्षेपाकः, फलेपाकः-क्षणेपाकः-का, <sup id="ref_krm_0967_16"><a href="#foot_krm_0967_16">16</a></sup> दूरेपाकुः- फलेपाकुः, <sup id="ref_krm_0967_17"><a href="#foot_krm_0967_17">17</a></sup> पचनः, <sup id="ref_krm_0967_18"><a href="#foot_krm_0967_18">18</a></sup> श्वपाकः-मांसपाकः ओदनपाचः, कपोतपाकः, पिण्डपाकः, मूलपाकः-उलूकपाकः, <sup id="ref_krm_0967_19"><a href="#foot_krm_0967_19">19</a></sup> प्रस्थंपचः- <sup id="ref_krm_0967_20"><a href="#foot_krm_0967_20">20</a></sup> खारिम्पचः-द्रोणंपचः, <sup id="ref_krm_0967_21"><a href="#foot_krm_0967_21">21</a></sup> मितम्पचः <sup id="ref_krm_0967_22"><a href="#foot_krm_0967_22">22</a></sup> - <sup id="ref_krm_0967_23"><a href="#foot_krm_0967_23">23</a></sup> नखम्पचः, <sup id="ref_krm_0967_24"><a href="#foot_krm_0967_24">24</a></sup> अल्पम्पचः, <sup id="ref_krm_0967_25"><a href="#foot_krm_0967_25">25</a></sup> <sup id="ref_krm_0967_26"><a href="#foot_krm_0967_26">26</a></sup> <sup id="ref_krm_0967_27"><a href="#foot_krm_0967_27">27</a></sup> उत्पचिष्णुः, <sup id="ref_krm_0967_28"><a href="#foot_krm_0967_28">28</a></sup> पचेलिमाः <sup id="ref_krm_0967_29"><a href="#foot_krm_0967_29">29</a></sup> <sup id="ref_krm_0967_30"><a href="#foot_krm_0967_30">30</a></sup>, <sup id="ref_krm_0967_31"><a href="#foot_krm_0967_31">31</a></sup> किम्पचानः, <sup id="ref_krm_0967_32"><a href="#foot_krm_0967_32">32</a></sup> पेचिवान्, पाचः, पिपक्षुः, पापचः;</li> <li>  पक्तव्यम्, पाचयितव्यम्, पिपक्षितव्यम्, पापचितव्यम्;</li> <li>  पचनीयम्, पाचनीयम्, पिपक्षणीयम्, पापचनीयम्;</li> <li>  <sup id="ref_krm_0967_33"><a href="#foot_krm_0967_33">33</a></sup> पाक्यम् <sup id="ref_krm_0967_34"><a href="#foot_krm_0967_34">34</a></sup>, <sup id="ref_krm_0967_35"><a href="#foot_krm_0967_35">35</a></sup> कृष्टपच्यम्, <sup id="ref_krm_0967_36"><a href="#foot_krm_0967_36">36</a></sup> कृष्टपाक्यम्, <sup id="ref_krm_0967_37"><a href="#foot_krm_0967_37">37</a></sup> अवश्यपाक्यम्, पाच्यम्, पिपक्ष्यम्, पापच्यम्;</li> <li>  ईषत्पचः-दुष्पचः-सुपचः;</li> <li>  -- -- पच्यमानः, पाच्यमानः, पिपक्ष्यमाणः, पापच्यमानः;</li> <li>  <sup id="ref_krm_0967_38"><a href="#foot_krm_0967_38">38</a></sup> पाकः, <sup id="ref_krm_0967_39"><a href="#foot_krm_0967_39">39</a></sup> मांसपाकः-मांस्पाकः, <sup id="ref_krm_0967_40"><a href="#foot_krm_0967_40">40</a></sup> पक्त्रिमम्, <sup id="ref_krm_0967_41"><a href="#foot_krm_0967_41">41</a></sup> पाचः, पिपक्षः, पापचः;</li> <li>  <sup id="ref_krm_0967_42"><a href="#foot_krm_0967_42">42</a></sup> पक्तुम्, पाचयितुम्, पिपक्षितुम्, पापचितुम्;</li> <li>  <sup id="ref_krm_0967_43"><a href="#foot_krm_0967_43">43</a></sup> पचा, <sup id="ref_krm_0967_44"><a href="#foot_krm_0967_44">44</a></sup> पक्तिः, <sup id="ref_krm_0967_45"><a href="#foot_krm_0967_45">45</a></sup> पाचिका, पाचना, पिपक्षा, पापचा;</li> <li>  पचनम्, <sup id="ref_krm_0967_46"><a href="#foot_krm_0967_46">46</a></sup> मांसपचनम्-मांस्पचनम्, पाचनम्, पिपक्षणम्, पापचनम्;</li> <li>  पक्त्वा, पाचयित्वा, पिपक्षित्वा, पापचित्वा;</li> <li>  विपच्य, प्रपाच्य, प्रपिपक्ष्य, प्रपापच्य;</li> <li>  पाचम् २, पक्त्वा २, पाचम् २, पाचयित्वा २, पिपक्षम् २, पिपक्षित्वा २, पापचम् २;</li> <li>  पापचित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0967_01"><a href="#ref_krm_0967_01">↑</a> (९५७)</li> <li id="foot_krm_0967_02"><a href="#ref_krm_0967_02">↑</a> (१-भ्वादिः-९९६। सक। अनि। उभ।)</li> <li id="foot_krm_0967_03"><a href="#ref_krm_0967_03">↑</a> [[४। सन्नन्ताण्ण्वुलि, ‘चोः कुः’ (८-२-३०) इति कुत्वे, षत्वे च रूपम्। एवं सन्नन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0967_04"><a href="#ref_krm_0967_04">↑</a> [[५। यङन्ते सर्वत्र, ‘दीर्घोऽकितः’ (७-४-८३) इत्यभ्यासदीर्घः।]]</li> <li id="foot_krm_0967_05"><a href="#ref_krm_0967_05">↑</a> [[६। तृजादिषु सर्वत्र ‘चोः कुः’ (८-२-३०) इति कुत्वं ज्ञेयम्।]]</li> <li id="foot_krm_0967_06"><a href="#ref_krm_0967_06">↑</a> [[७। ‘लृट् शेषे च’ (३-३-१३) इति लृडत्र भविष्यति काले;\n\n  ‘पक्ष्यामीति व्रजति’ इत्यर्थः। ‘शेषे विभाषा--’ (८-४-१८) इति नेर्णत्वविकल्पः।]]</li> <li id="foot_krm_0967_07"><a href="#ref_krm_0967_07">↑</a> [व्रजति]</li> <li id="foot_krm_0967_08"><a href="#ref_krm_0967_08">↑</a> [पृष्ठम्०८३२+ २८]</li> <li id="foot_krm_0967_09"><a href="#ref_krm_0967_09">↑</a> [[१। ओदनं पचतीति ओदनपक्। ‘क्विप् च’ (३-२-७६) इति कर्मण्युपपदे क्विप्। ‘अनुनासिकस्य क्विझलोः--’ (६-४-१६) इत्यत्र काशिकायामुदाहृतमेवम्।]]</li> <li id="foot_krm_0967_10"><a href="#ref_krm_0967_10">↑</a> [[२। ‘पचो वः’ (८-२-५२) इति निष्ठातकारस्य वकारः। वकारस्यासिद्धत्वात् झल्पर- त्वम्। तेन, ‘चोः कुः’ (८-२-३०) इति कुत्वं भवतीति ज्ञेयम्।]]</li> <li id="foot_krm_0967_11"><a href="#ref_krm_0967_11">↑</a> [[३। ‘प्रपक्वानि’ इत्यत्र ‘कुमति च’ (८-४-१३) इति प्राप्तं णत्वम्, ‘युवादीनां प्रतिषेधः’ (वा। ८-४-११) इत्यनेन न भवति।]]</li> <li id="foot_krm_0967_12"><a href="#ref_krm_0967_12">↑</a> [फलानि]</li> <li id="foot_krm_0967_13"><a href="#ref_krm_0967_13">↑</a> [[४। ‘नन्दिग्रहिपचादिभ्यः--’ (३-१-१३४) इति, अच्प्रत्ययः।]]</li> <li id="foot_krm_0967_14"><a href="#ref_krm_0967_14">↑</a> [[५। पचादिषु (३-१-१३४) पाठादत्र कर्मण्यणं बाधित्वा कर्तरि, अच्प्रत्ययः।]]</li> <li id="foot_krm_0967_15"><a href="#ref_krm_0967_15">↑</a> [[६। अत्र सर्वत्र, पचादिषु पाठादचि, वृद्धौ, तथा न्यङ्क्वादिषु (७-३-५३) पाठात् कुत्वे च रूपम्।]]</li> <li id="foot_krm_0967_16"><a href="#ref_krm_0967_16">↑</a> [[७। न्यङ्क्वादिषु (७-३-५३) पाठात् कुत्वम्, पचादिष्वेव पाठादुप्रत्ययश्च।]]</li> <li id="foot_krm_0967_17"><a href="#ref_krm_0967_17">↑</a> [[८। नन्द्यादिषु (३-१-१३४) पाठात् कर्तरि ल्युप्रत्ययः इति केचित्।]]</li> <li id="foot_krm_0967_18"><a href="#ref_krm_0967_18">↑</a> [[९। ‘अणपीष्यते’ इति क्षीरतरङ्गिण्यामुक्तम्। तदानीमत्र कुत्वं न्यङ्क्वादित्वात ज्ञेयम्। वस्तुतस्तु ‘कर्मण्यण्’ (३-२-१) इत्यत्र भाष्ये ‘ओदनपाचः’ इति प्रयुक्तत्वात् अण्विषये कुत्वं नेति ज्ञायते।]]</li> <li id="foot_krm_0967_19"><a href="#ref_krm_0967_19">↑</a> [[१०। ‘परिमाणे पचः’ (३-२-३३) इति खश्प्रत्यये मुमि च रूपमेवम्। एवं परिमाण- वाचकेषु सर्वेष्वपि उपपदेषु खश् ज्ञेयः।]]</li> <li id="foot_krm_0967_20"><a href="#ref_krm_0967_20">↑</a> [[आ। ‘खारिम्पचामत्र विपक्वमन्नं विष्वण्य सुष्वाप स रक्षिवर्गः।।’ वा। वि। ३। ४।]]</li> <li id="foot_krm_0967_21"><a href="#ref_krm_0967_21">↑</a> [[११। ‘मितनखे च’ (३-२-३४) इति खशि मुमागमः।]]</li> <li id="foot_krm_0967_22"><a href="#ref_krm_0967_22">↑</a> [[B। ‘अमितम्पचमीशानं सर्वभोगीणमुत्तमम्।’ भ। का। ६। ९७।]]</li> <li id="foot_krm_0967_23"><a href="#ref_krm_0967_23">↑</a> [[C। ‘नखम्पचोष्णं नलिनेक्षणानामुरोजमेवातितरामुपास्ते।।’ च। भारते। ४। ५६।]]</li> <li id="foot_krm_0967_24"><a href="#ref_krm_0967_24">↑</a> [[१२। ‘मितनखेच’ ‘(३-२-३४) इत्यत्र मितशब्देन मितपर्यायाणामपि ग्रहणमिति मते ‘अल्पम्पचः’ इत्यत्र खशि मुमागमो ज्ञेयः।]]</li> <li id="foot_krm_0967_25"><a href="#ref_krm_0967_25">↑</a> [[ड्। ‘ऐव विद्वन् पितुः कामात् पान्तावल्पंपचान् मुनीन्।।’ भ। का। ६। ९७।]]</li> <li id="foot_krm_0967_26"><a href="#ref_krm_0967_26">↑</a> [पृष्ठम्०८३३+ २९]</li> <li id="foot_krm_0967_27"><a href="#ref_krm_0967_27">↑</a> [[१। ‘अलङ्कृञ्निराकृञ्प्रजनोत्पच--’ (३-२-१३६) इत्यादिना तच्छीलादिषु कर्तृषु इष्णुच्प्रत्ययः।]]</li> <li id="foot_krm_0967_28"><a href="#ref_krm_0967_28">↑</a> [[२। ‘केलिमर उपसंख्यानम्’ (वा। ३-१-९६) इति केलिमर्प्रत्यये रूपम्। कर्मकर्तर्ये- वायं प्रत्यय इति वृत्तिकारादयः। अविशेषात् भावकर्मणोरेवेति दीक्षि- तादयः।]]</li> <li id="foot_krm_0967_29"><a href="#ref_krm_0967_29">↑</a> [[आ। ‘स वारनारीकुचसञ्चितोवमं ददर्श मालूरफलं पचेलिमम्।।’ नैषधे १। ९४।]]</li> <li id="foot_krm_0967_30"><a href="#ref_krm_0967_30">↑</a> [शालयः]</li> <li id="foot_krm_0967_31"><a href="#ref_krm_0967_31">↑</a> [[३। किम्शब्दे उपपदे, ‘ताच्छील्यवयोवचनशक्तिषु चानश्’ (३-२-१२९) इति चानशि, बाहुलकात् मुमागमाभाव इति अमरव्याख्यायां भानुजीदीक्षितः।]]</li> <li id="foot_krm_0967_32"><a href="#ref_krm_0967_32">↑</a> [[४। कर्तरि लिटः क्वसौ, ‘वस्वेकाजाद्घसाम्’ (७-२-६७) इतीडागमे, ‘अत एक- हल्मध्येऽनादेशादेर्लिटि’ (६-४-१२०) इत्येत्वाभ्यासलोपयो रूपम्।]]</li> <li id="foot_krm_0967_33"><a href="#ref_krm_0967_33">↑</a> [[५। निष्ठायामस्य धातोरनिट्त्वेन ण्यति, ‘चजोः कु घिण्ण्यतोः’ (७-३-५२) इत्यनेन कुत्वम्।]]</li> <li id="foot_krm_0967_34"><a href="#ref_krm_0967_34">↑</a> [[B। ‘पितॄणां कुरुषे कार्यमपाक्यैः स्वादुभिः फलैः।।’ भ। का। ६। ६४।]]</li> <li id="foot_krm_0967_35"><a href="#ref_krm_0967_35">↑</a> [[६। ‘राजसूयसूर्यमृषोद्यरुच्यकृष्टपच्याव्यथ्याः’ (३-१-११४) इत्यनेन यत्प्रत्यये कर्म- कर्तरि कृष्टपच्यः इति निपात्यते। कृष्टे ये स्वयमेव पच्यन्ते केचन व्रीहि- विशेषाः ते कृष्टपच्याः। अन्यत्र कृष्टपाक्यः इत्येव।]]</li> <li id="foot_krm_0967_36"><a href="#ref_krm_0967_36">↑</a> [[C। ‘अकृष्टपच्याः पश्यन्तौ ततो दाशरथी लताः।’ भ। का। ६। ५९।]]</li> <li id="foot_krm_0967_37"><a href="#ref_krm_0967_37">↑</a> [[७। ‘ण्य आवश्यके’ (७-३-६५) इति निषेधाद् आवश्यकार्थे तु ण्यत्प्रत्यये कुत्वं न भवति।]]</li> <li id="foot_krm_0967_38"><a href="#ref_krm_0967_38">↑</a> [[८। घञि, ‘चजोः कु--’ (७-३-५२) इति कुत्वम्।]]</li> <li id="foot_krm_0967_39"><a href="#ref_krm_0967_39">↑</a> [[९। मांसस्य पाकः मांसपाकः मांस्पाको वा। ‘मांसस्य पचि ल्युड्घञोः’ (वा। ६-३-१०९) इति वचनात् पचतेर्घञि मांसशब्दस्योपपदस्यान्त्यलोपो वा भवति।]]</li> <li id="foot_krm_0967_40"><a href="#ref_krm_0967_40">↑</a> [[१०। ‘ड्वितः क्त्रिः’ (३-३-८८) इति क्त्रिप्रत्यये, ‘तेन’ इत्यधिकारे, निर्वृत्तार्थे ‘क्त्रेर्मम्नित्यम्’ (४-४-२०) इति नित्यं मप्प्रत्यये रूपम्।]]</li> <li id="foot_krm_0967_41"><a href="#ref_krm_0967_41">↑</a> [[ड्। ‘विपक्त्रिमज्ञानगतिर्मनस्वी मान्यो मुनिः स्वां पुरमृष्यशृङ्गः।।’ भ। का। १। १०।]]</li> <li id="foot_krm_0967_42"><a href="#ref_krm_0967_42">↑</a> [पृष्ठम्०८३४+ २८]</li> <li id="foot_krm_0967_43"><a href="#ref_krm_0967_43">↑</a> [[१। षित्त्वाद् ‘षिद्भिदादिभ्यः--’ (३-३-१०४) इत्यङ् भवति।]]</li> <li id="foot_krm_0967_44"><a href="#ref_krm_0967_44">↑</a> [[२। ‘स्थागापापचो भावे’ (३-३-९५) इति वचनात् पक्षे क्तिन्नपि भावे भवति।]]</li> <li id="foot_krm_0967_45"><a href="#ref_krm_0967_45">↑</a> [[३। ‘पर्यायार्हर्णोत्पत्तिषु ण्वुच्’ (३-३-१११) इति ऋणे ण्वुच्। ‘शायिकाऽद्य तव प्रापदर्हसि क्षीरपायिकाम्। पाचिका मे त्वया देया प्रोत्पन्ना मेऽन्नभोजिका।।’ इति प्र। सर्वस्वे।]]</li> <li id="foot_krm_0967_46"><a href="#ref_krm_0967_46">↑</a> [[४। ‘मांसस्य पचि युड्घञोः’ (काशिका ६-१-१४४) इति मांसशब्दस्थाकारस्य लोपः ल्युट्प्रत्यये परतः। तेन मांस्पचनम् इत्यपि साधु। ‘मांस्पचन्या उखायाः’ इति प्रयोगोऽत्रानुसन्धेयः (भाष्य०, काशिका० ६-१-६३)।]]</li></ul></p>

पचि|पञ्चकः-ञ्चिका|पिपञ्चिषकः-षिका|पापञ्चकः-ञ्चिका|पङ्कः|पङ्क्तिः|पञ्चालाः
<ul><li><sup id="ref_krm_0968_01"><a href="#foot_krm_0968_01">1</a></sup> {@“पचि व्यक्तीकरणे”@} <sup id="ref_krm_0968_02"><a href="#foot_krm_0968_02">2</a></sup> <sup id="ref_krm_0968_03"><a href="#foot_krm_0968_03">3</a></sup> ‘पच व्यक्तीकरणे’ इति दुर्गः। </li> <li>‘तिङो गोत्रादीनि--’ <sup id="ref_krm_0968_04"><a href="#foot_krm_0968_04">4</a></sup> इत्यत्र काशिकायां न्यासे च ‘पचति <sup id="ref_krm_0968_05"><a href="#foot_krm_0968_05">5</a></sup> गोत्रम्’ इत्युक्तत्वात् तन्मतेऽपि ‘पच’ इत्येव पाठ इति गम्यते। </li> <li>पच इत्यदन्तपाठेऽपि धातोरस्या- निट्त्वम्, अनिट्कारिकासु पाठात्--इति ज्ञेयम्।]] ‘णौ पञ्चयति विस्तारे व्यक्तौ तु शपि पञ्चते।’ <sup id="ref_krm_0968_06"><a href="#foot_krm_0968_06">6</a></sup> इति देवः। </li> <li>पञ्चकः-ञ्चिका, पञ्चकः-ञ्चिका, पिपञ्चिषकः-षिका, पापञ्चकः-ञ्चिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककञ्चतिवत् <sup id="ref_krm_0968_07"><a href="#foot_krm_0968_07">7</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0968_08"><a href="#foot_krm_0968_08">8</a></sup> पङ्कः, <sup id="ref_krm_0968_09"><a href="#foot_krm_0968_09">9</a></sup> पङ्क्तिः, <sup id="ref_krm_0968_10"><a href="#foot_krm_0968_10">10</a></sup> पञ्चालाः;</li> <li>  इति अस्य धातो रूपाणीति विशेषः। </li> <li><sup id="ref_krm_0968_11"><a href="#foot_krm_0968_11">11</a></sup> पञ्चितः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0968_01"><a href="#ref_krm_0968_01">↑</a> (९५८)</li> <li id="foot_krm_0968_02"><a href="#ref_krm_0968_02">↑</a> (१-भ्वादिः-१७४। सक। सेट्। आत्म।)</li> <li id="foot_krm_0968_03"><a href="#ref_krm_0968_03">↑</a> [[[अ]</li> <li id="foot_krm_0968_04"><a href="#ref_krm_0968_04">↑</a> (८-१-२७)</li> <li id="foot_krm_0968_05"><a href="#ref_krm_0968_05">↑</a> [= व्यक्तीकरोति]</li> <li id="foot_krm_0968_06"><a href="#ref_krm_0968_06">↑</a> (श्लो। १८)</li> <li id="foot_krm_0968_07"><a href="#ref_krm_0968_07">↑</a> (१४५)</li> <li id="foot_krm_0968_08"><a href="#ref_krm_0968_08">↑</a> [[५। घञि, न्यङ्क्वादिपाठात् कुत्वम्।]]</li> <li id="foot_krm_0968_09"><a href="#ref_krm_0968_09">↑</a> [[६। बाहुलकात् ‘क्तिन्नपि इष्यते’ (वा। ३-३-९४) इति क्तिन्, कुत्वं च।]]</li> <li id="foot_krm_0968_10"><a href="#ref_krm_0968_10">↑</a> [[७। ‘तमिविडि--’ (द। उ। ८-११५) इति कालच्प्रत्यये रूपम्। पञ्चते पञ्चयति वा पञ्चालाः = विषयः, पर्वतेश्वरयक्षश्च।]]</li> <li id="foot_krm_0968_11"><a href="#ref_krm_0968_11">↑</a> [[आ। ‘अमुञ्चनैर्मञ्चितचित्तपञ्चितत्रयीमतप्रस्तुचितैः शुभार्जकैः।’ धा। का। १। २४।]]</li></ul></p>

पचि|पञ्चकः-पञ्चिका|पिपञ्चयिषकः-षिका|पञ्चकः-ञ्चिका|पिपञ्चिषकः-षिका|पापञ्चकः-ञ्चिका
<ul><li><sup id="ref_krm_0969_01"><a href="#foot_krm_0969_01">1</a></sup> {@“पचि विस्तारवचने”@} <sup id="ref_krm_0969_02"><a href="#foot_krm_0969_02">2</a></sup> ‘विस्तारमात्रे च’ इति द्रुमे। </li> <li>‘वचने’ इत्यविवक्षितमित्यर्थः। </li> <li><sup id="ref_krm_0969_03"><a href="#foot_krm_0969_03">3</a></sup> ‘णौ पञ्चयति विस्तारे, व्यक्तौ तु शपि पञ्चते।’ <sup id="ref_krm_0969_04"><a href="#foot_krm_0969_04">4</a></sup> इति देवः। </li> <li>पञ्चकः-पञ्चिका, पिपञ्चयिषकः-षिका, पञ्चकः-ञ्चिका, पिपञ्चिषकः-षिका, पापञ्चकः-ञ्चिका;</li> <li>  इत्यादीनि सर्वाणि रूपाणि चौरादिकचम्पयतिवत् <sup id="ref_krm_0969_05"><a href="#foot_krm_0969_05">5</a></sup> ऊह्यानि। </li> <li>घञि- <sup id="ref_krm_0969_06"><a href="#foot_krm_0969_06">6</a></sup> प्रपञ्चः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0969_01"><a href="#ref_krm_0969_01">↑</a> (९५९)</li> <li id="foot_krm_0969_02"><a href="#ref_krm_0969_02">↑</a> (१०-चुरादिः-१६५२। सक। सेट्। उभ।)</li> <li id="foot_krm_0969_03"><a href="#ref_krm_0969_03">↑</a> [पृष्ठम्०८३५+ ३१]</li> <li id="foot_krm_0969_04"><a href="#ref_krm_0969_04">↑</a> (श्लो। १८)</li> <li id="foot_krm_0969_05"><a href="#ref_krm_0969_05">↑</a> (४९९)</li> <li id="foot_krm_0969_06"><a href="#ref_krm_0969_06">↑</a> [[आ। ‘कृष्णः प्रपञ्चरहितां धृततेजितास्त्रैः वीरैः स्तुतां गिरमकीर्तदरातिवर्धी।।’ धा। का। ३। २८।]]</li></ul></p>

पट|पाटकः-टिका|पिपटिषकः-षिका|पापटकः-टिका|पाटूपटः|परिपाटी|पटुः|गोष्ठेपटुः|पटिमा|पटाका|पटलम्|पटोलः|पटलिका|पाटलम्|पाटली|पटीरः|पटनः|पटितिः|कपाटम्
<ul><li><sup id="ref_krm_0970_01"><a href="#foot_krm_0970_01">1</a></sup> {@“पट गतौ”@} <sup id="ref_krm_0970_02"><a href="#foot_krm_0970_02">2</a></sup> ‘भाषार्थे पाटयेद् ग्रन्थे पटयेद् गमने पटेत्।।’ <sup id="ref_krm_0970_03"><a href="#foot_krm_0970_03">3</a></sup> इति देवः। </li> <li>पाटकः-टिका, पाटकः-टिका, पिपटिषकः-षिका, पापटकः-टिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि कटतिवत् <sup id="ref_krm_0970_04"><a href="#foot_krm_0970_04">4</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_0970_05"><a href="#foot_krm_0970_05">5</a></sup> पाटूपटः, <sup id="ref_krm_0970_06"><a href="#foot_krm_0970_06">6</a></sup> परिपाटी, <sup id="ref_krm_0970_07"><a href="#foot_krm_0970_07">7</a></sup> पटुः, गोष्ठेपटुः, <sup id="ref_krm_0970_08"><a href="#foot_krm_0970_08">8</a></sup> पटिमा, <sup id="ref_krm_0970_09"><a href="#foot_krm_0970_09">9</a></sup> पटाका, <sup id="ref_krm_0970_10"><a href="#foot_krm_0970_10">10</a></sup> पटलम्, <sup id="ref_krm_0970_11"><a href="#foot_krm_0970_11">11</a></sup> पटोलः, पटलिका, पाटलम्, पाटली, <sup id="ref_krm_0970_12"><a href="#foot_krm_0970_12">12</a></sup> पटीरः, <sup id="ref_krm_0970_13"><a href="#foot_krm_0970_13">13</a></sup> पटनः, <sup id="ref_krm_0970_14"><a href="#foot_krm_0970_14">14</a></sup> पटितिः, <sup id="ref_krm_0970_15"><a href="#foot_krm_0970_15">15</a></sup> कपाटम्;</li> <li>  <sup id="ref_krm_0970_16"><a href="#foot_krm_0970_16">16</a></sup> इतीमानि रूपाणि अधिकान्यत्रेति विशेषः। </li> <li><sup id="ref_krm_0970_17"><a href="#foot_krm_0970_17">17</a></sup> पटन्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0970_01"><a href="#ref_krm_0970_01">↑</a> (९६०)</li> <li id="foot_krm_0970_02"><a href="#ref_krm_0970_02">↑</a> (१-भ्वादिः-२९६। सक। सेट्। पर।)</li> <li id="foot_krm_0970_03"><a href="#ref_krm_0970_03">↑</a> (श्लो। ७६)</li> <li id="foot_krm_0970_04"><a href="#ref_krm_0970_04">↑</a> (१४८)</li> <li id="foot_krm_0970_05"><a href="#ref_krm_0970_05">↑</a> [[१। ‘पाटेर्णिलुक् ऊक् चाभ्यासस्य’ (वा। ६-१-१२) इत्यनेन ण्यन्तात् पचाद्यचि णिलुक्, अभ्यासे हलादिशेषं बाधित्वा ऊक् च भवति। “माधवोऽभ्यासदीर्घोक्त्या ‘पाटूपट’ इतीच्छति। ‘पाटेर्णिलुक् दीर्घ ऊक् चे’ त्यूचिवान् भोजराडपि।।” ‘तमः पटपटूपटम्’, ‘आटोपपाटूपटम्।’ इति च प्रयोगः।’ इति प्र। सर्वस्वे।]]</li> <li id="foot_krm_0970_06"><a href="#ref_krm_0970_06">↑</a> [[२। परिपटतीति परिपाटी। ताच्छील्ये णिनिः।]]</li> <li id="foot_krm_0970_07"><a href="#ref_krm_0970_07">↑</a> [[३। ‘फलिपाटि--’ (द। उ। १-१०३) इत्युप्रत्ययो णिलुक् च। पाटयतीति पटुः = चतुरः। ‘गोष्ठेपटुः’ इत्यत्र पात्रेसमितादित्वात् (२-१-४८) सप्तम्या अलुक्।]]</li> <li id="foot_krm_0970_08"><a href="#ref_krm_0970_08">↑</a> [[४। अतिशयेन पटुः पटिमा। पृथ्वादित्वात् (५-१-१२२) इमनिच् तद्धितः।]]</li> <li id="foot_krm_0970_09"><a href="#ref_krm_0970_09">↑</a> [[५। ‘शलिपटि--’ (द। उ। ३-३३) इत्यादिना आकप्रत्ययः। पटाका = पक्षिजातिः।]]</li> <li id="foot_krm_0970_10"><a href="#ref_krm_0970_10">↑</a> [[६। ‘वृषादिभ्यश्चित्’ (द। उ। ८-१०९) इत्यादिना कलप्रत्ययः। पटलम् = घन- संघातः, अक्षिरोगश्च।]]</li> <li id="foot_krm_0970_11"><a href="#ref_krm_0970_11">↑</a> [[७। ‘कपिगड्पिटिभ्य ओलः’ (द। उ। ८-१०५) इत्योलप्रत्ययः। पटोलः = द्रव्यजातिः।]]</li> <li id="foot_krm_0970_12"><a href="#ref_krm_0970_12">↑</a> [[८। औणादिके (द। उ। ८-७२) ईरन्प्रत्यये रूपम्। पटीरम् = कार्मुकम्।]]</li> <li id="foot_krm_0970_13"><a href="#ref_krm_0970_13">↑</a> [[९। ‘चलनशब्दार्थादकर्मकाद्--’ (३-२-१४८) इत्यनेन तच्छीलादिषु कर्तृषु युच्प्रत्ययः।]]</li> <li id="foot_krm_0970_14"><a href="#ref_krm_0970_14">↑</a> [[१०। ‘तितुत्रेष्वग्रहादीनामिति वक्तव्यम्’ (वा। ७-२-९) इत्यनेन इड् भवति।]]</li> <li id="foot_krm_0970_15"><a href="#ref_krm_0970_15">↑</a> [[११। कं = शिरं पाटयतीति कपाटम् = द्वारपिधानम्। ण्यन्तात् ‘कर्मण्यण्’ (३-२-१) इत्यण्। ‘कवाटम्’ इत्येव दाक्षिणात्यानां पाठ इति केचित्। तदानीं वटधातोरेतद्रूपमिति ज्ञेयम्।]]</li> <li id="foot_krm_0970_16"><a href="#ref_krm_0970_16">↑</a> [पृष्ठम्०८३६+ २८]</li> <li id="foot_krm_0970_17"><a href="#ref_krm_0970_17">↑</a> [[आ। ‘अम्लेटकैश्चाकटुचाटुभाषितैरटैः पटत्संरटिताञ्जनोत्करैः।।’ धा। का। १। ३९।]]</li></ul></p>

पट|पाटकः-टिका|पिपाटयिषकः-षिका|पाटयिता-त्री|पिपाटयिषिता-त्री
<ul><li><sup id="ref_krm_0971_01"><a href="#foot_krm_0971_01">1</a></sup> {@“पट भाषार्थः”@} <sup id="ref_krm_0971_02"><a href="#foot_krm_0971_02">2</a></sup> आस्वदीयः। </li> <li>‘भाषार्थे पाटयेद् ग्रन्थे पटयेद् गमने पटेत्।।’ <sup id="ref_krm_0971_03"><a href="#foot_krm_0971_03">3</a></sup> इति देवः। </li> <li>पाटकः-टिका, पिपाटयिषकः-षिका;</li> <li>  पाटयिता-त्री, पिपाटयिषिता-त्री;</li> <li>  इत्यादीनि सर्वाणि रूपाणि चौरादिककालयतिवत् <sup id="ref_krm_0971_04"><a href="#foot_krm_0971_04">4</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0971_01"><a href="#ref_krm_0971_01">↑</a> (९६१)</li> <li id="foot_krm_0971_02"><a href="#ref_krm_0971_02">↑</a> (१०-चुरादिः-१७५३। सक। सेट्। उभ।)</li> <li id="foot_krm_0971_03"><a href="#ref_krm_0971_03">↑</a> (श्लो। ७६)</li> <li id="foot_krm_0971_04"><a href="#ref_krm_0971_04">↑</a> (१७५)</li></ul></p>

पट|पटकः-टिका|पिपटयिषकः-षिका|पटयिता-त्री|पिपटयिषिता-त्री
<ul><li><sup id="ref_krm_0972_01"><a href="#foot_krm_0972_01">1</a></sup> {@“पट ग्रन्थे”@} <sup id="ref_krm_0972_02"><a href="#foot_krm_0972_02">2</a></sup> अदन्तः ‘भाषार्थे पाटयेद् ग्रन्थे पटयेद् गमने पटेत्।।’ <sup id="ref_krm_0972_03"><a href="#foot_krm_0972_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_0972_04"><a href="#foot_krm_0972_04">4</a></sup> पटकः-टिका, पिपटयिषकः-षिका, पटयिता-त्री, पिपटयिषिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिककलयतिवत् <sup id="ref_krm_0972_05"><a href="#foot_krm_0972_05">5</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0972_06"><a href="#foot_krm_0972_06">6</a></sup> प्रपटय्य।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0972_01"><a href="#ref_krm_0972_01">↑</a> (९६२)</li> <li id="foot_krm_0972_02"><a href="#ref_krm_0972_02">↑</a> (१०-चुरादिः-१८५७। सक। सेट्। उभ।)</li> <li id="foot_krm_0972_03"><a href="#ref_krm_0972_03">↑</a> (श्लो। ७६)</li> <li id="foot_krm_0972_04"><a href="#ref_krm_0972_04">↑</a> [[१। अत्र अल्लोपस्य स्थानिवत्त्वात् सर्वत्र उपधावृद्धिंर्न।]]</li> <li id="foot_krm_0972_05"><a href="#ref_krm_0972_05">↑</a> (१७६)</li> <li id="foot_krm_0972_06"><a href="#ref_krm_0972_06">↑</a> [[B। ‘क्रुद्धेनाकथि चाप्यवर्यगणने शठ्येन भोः श्वठ्यतां मन्त्री तौ प्रपटय्य पाशवटनैः पापौ विरह्यौ पुरात्।’ धा। का। ३-५३।]]</li></ul></p>

पठ|पाठकः-ठिका|पिपठिषकः-षिका|पापठकः-ठिका
<ul><li><sup id="ref_krm_0973_01"><a href="#foot_krm_0973_01">1</a></sup> {@“पठ व्यक्तायां वाचि”@} <sup id="ref_krm_0973_02"><a href="#foot_krm_0973_02">2</a></sup> पाठकः-ठिका, पाठकः-ठिका, पिपठिषकः-षिका, पापठकः-ठिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककठतिवत् <sup id="ref_krm_0973_03"><a href="#foot_krm_0973_03">3</a></sup> ज्ञेयानि। </li> <li>निपठः <sup id="ref_krm_0973_04"><a href="#foot_krm_0973_04">4</a></sup> निपाठः, निपठितिः <sup id="ref_krm_0973_05"><a href="#foot_krm_0973_05">5</a></sup> , इमानि रूपाणि अधिकान्यत्रेति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0973_01"><a href="#ref_krm_0973_01">↑</a> (९६३)</li> <li id="foot_krm_0973_02"><a href="#ref_krm_0973_02">↑</a> (१-भ्वादिः-३३०। सक। सेट्। पर।)</li> <li id="foot_krm_0973_03"><a href="#ref_krm_0973_03">↑</a> (१४८)</li> <li id="foot_krm_0973_04"><a href="#ref_krm_0973_04">↑</a> [[२। ‘नौ गदनदपठस्वनः’ (३-३-६४) इति करणे वा अप् प्रत्ययः।]]</li> <li id="foot_krm_0973_05"><a href="#ref_krm_0973_05">↑</a> [[३। क्तिनि, ‘तितुत्र--’ (७-२-९) इति इण्निषेधे प्राप्ते ‘अग्रहादीनामिति वक्तव्यम्’ (वा। ७-२-९) इति इट् भवति।]]</li></ul></p>

पडि|पण्डकः-ण्डिका|पिपण्डिषकः-षिका|पापण्डकः-ण्डिका
<ul><li><sup id="ref_krm_0974_01"><a href="#foot_krm_0974_01">1</a></sup> {@“पडि गतौ”@} <sup id="ref_krm_0974_02"><a href="#foot_krm_0974_02">2</a></sup> पण्डकः-ण्डिका, पण्डकः-ण्डिका, पिपण्डिषकः-षिका, पापण्डकः-ण्डिका;</li> <li>  इत्यादीनि सर्वाणि रूपाणि भौवादिककण्ठतिवत् <sup id="ref_krm_0974_03"><a href="#foot_krm_0974_03">3</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0974_04"><a href="#foot_krm_0974_04">4</a></sup> पण्डा, <sup id="ref_krm_0974_05"><a href="#foot_krm_0974_05">5</a></sup> गोष्ठेपण्डः, अस्य धातोः इमे रूपे अधिके इति ज्ञेयम्। </li> <li><sup id="ref_krm_0974_06"><a href="#foot_krm_0974_06">6</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0974_01"><a href="#ref_krm_0974_01">↑</a> (९६४)</li> <li id="foot_krm_0974_02"><a href="#ref_krm_0974_02">↑</a> (१-भ्वादिः-२८१। सक। सेट्। आत्म।)</li> <li id="foot_krm_0974_03"><a href="#ref_krm_0974_03">↑</a> (१४९)</li> <li id="foot_krm_0974_04"><a href="#ref_krm_0974_04">↑</a> [[४। स्त्रियां भावादौ ‘गुरोश्च हलः’ (३-३-१०३) इत्यप्रत्ययः। पण्डा = मतिः ज्ञानं च, गत्यर्थानां ज्ञानार्थत्वात्। ‘तदस्य संजातं तारकादिभ्यः--’ (५-२-३६) इतीतच्प्रत्यये पण्डितः इति रूपम्।]]</li> <li id="foot_krm_0974_05"><a href="#ref_krm_0974_05">↑</a> [[५। पण्डतीति पण्डः। पचाद्यच्। क्षेपे गम्ये गोष्ठेषण्ड इति ‘पात्रेसमितादयश्च’ (२-१-४८) इत्यत्र निपातनात् सप्तम्या अलुक्।]]</li> <li id="foot_krm_0974_06"><a href="#ref_krm_0974_06">↑</a> [पृष्ठम्०८३७+ ३०]</li></ul></p>

पडि|पण्डकः-ण्डिका|पिपण्डयिषकः-षिका|पिपण्डिषकः-षिका|पापण्डकः-ण्डिका
<ul><li><sup id="ref_krm_0975_01"><a href="#foot_krm_0975_01">1</a></sup> {@“पडि नाशने”@} <sup id="ref_krm_0975_02"><a href="#foot_krm_0975_02">2</a></sup> इदित्करणात् णिचो वैकल्पिकत्वम्। </li> <li>पण्डकः-ण्डिका, पिपण्डयिषकः-षिका, पण्डकः-ण्डिका, पिपण्डिषकः-षिका, पापण्डकः-ण्डिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिककण्ठयतिवत् <sup id="ref_krm_0975_03"><a href="#foot_krm_0975_03">3</a></sup> ज्ञेयानि। </li> <li>पापप्रपण्डी <sup id="ref_krm_0975_04"><a href="#foot_krm_0975_04">4</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0975_01"><a href="#ref_krm_0975_01">↑</a> (९६५)</li> <li id="foot_krm_0975_02"><a href="#ref_krm_0975_02">↑</a> (१०-चुरादिः-१६१५। सक। सेट्। उभ।)</li> <li id="foot_krm_0975_03"><a href="#ref_krm_0975_03">↑</a> (१५०)</li> <li id="foot_krm_0975_04"><a href="#ref_krm_0975_04">↑</a> [[आ। ‘इत्यादिवादिषु जनेषु विमोटितारिः पापप्रपण्डिपदपांसुरवाज्यधामा।’ धा। का। ३। २३।]]</li></ul></p>

