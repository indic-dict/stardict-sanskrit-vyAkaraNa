<ul><li><sup id="ref_krm_0068_01"><a href="#foot_krm_0068_01">1</a></sup> {@“इङ् अध्ययने”@} <sup id="ref_krm_0068_02"><a href="#foot_krm_0068_02">2</a></sup> नित्यमधिपूर्वः। </li> <li>‘अयत्येतीयते गत्यां, अधीतेऽध्येति चेङिकोः।’ इति <sup id="ref_krm_0068_03"><a href="#foot_krm_0068_03">3</a></sup> देवः। </li> <li>‘धात्वर्थं बाधते कश्चित् कश्चित्तमनुवर्तते। </li> <li>विशिनष्टि तमेवार्थमुपसर्गगतिस्त्रिधा।।’ इति क्षीरतरङ्गिण्यामुद्धृतः श्लोकः। </li> <li>अध्यायकः-यिका, <sup id="ref_krm_0068_04"><a href="#foot_krm_0068_04">4</a></sup> अध्यापकः-पिका, <sup id="ref_krm_0068_05"><a href="#foot_krm_0068_05">5</a></sup> अधिजिगमिषकः-षिका;</li> <li>  अध्येता-त्री, अध्यापयिता-त्री, अधिजिगमिषिता-त्री;</li> <li>  <sup id="ref_krm_0068_06"><a href="#foot_krm_0068_06">6</a></sup> अधीयन् पारायणम्, <sup id="ref_krm_0068_07"><a href="#foot_krm_0068_07">7</a></sup> अध्यापयन्- <sup id="ref_krm_0068_08"><a href="#foot_krm_0068_08">8</a></sup> न्ती, अध्यापयिष्यन्-न्ती-ती;</li> <li>  <sup id="ref_krm_0068_09"><a href="#foot_krm_0068_09">9</a></sup> अधीयती, <sup id="ref_krm_0068_10"><a href="#foot_krm_0068_10">10</a></sup> अध्यापयन्- <sup id="ref_krm_0068_11"><a href="#foot_krm_0068_11">11</a></sup> न्ती, अध्यापयिष्यन्-न्ती-ती;</li> <li>  <sup id="ref_krm_0068_12"><a href="#foot_krm_0068_12">12</a></sup> अधीयानः, <sup id="ref_krm_0068_13"><a href="#foot_krm_0068_13">13</a></sup> -- अधिजिगांसमानः <sup id="ref_krm_0068_14"><a href="#foot_krm_0068_14">14</a></sup>;</li> <li>  अध्येष्यमाणः, -- <sup id="ref_krm_0068_15"><a href="#foot_krm_0068_15">15</a></sup> अधिजिगांसिष्यमाणः;</li> <li>  <sup id="ref_krm_0068_16"><a href="#foot_krm_0068_16">16</a></sup> अधीतः <sup id="ref_krm_0068_17"><a href="#foot_krm_0068_17">17</a></sup> -तम्, अध्यापितः, अधिजिगमिषितः-तवान्;</li> <li>  अध्ययः, <sup id="ref_krm_0068_18"><a href="#foot_krm_0068_18">18</a></sup> मन्त्राध्यायः, अध्यापः, अधिजिगमिषुः, <sup id="ref_krm_0068_19"><a href="#foot_krm_0068_19">19</a></sup> अधिजिगापयिषुः;</li> <li>  अध्यापिपयिषुः;</li> <li>  अध्येतव्यम्, अद्यापयितव्यम्, अधिजिगमिषितव्यम्;</li> <li>  अध्ययनीयम्, अध्यापनीयम्, अधिजिगमिषणीयम्;</li> <li>  अध्येयम्, अध्याप्यम्, अधिजिगमिष्यम्;</li> <li>  ईषदध्ययः, दुरध्ययः, स्वध्ययः;</li> <li>  -- <sup id="ref_krm_0068_20"><a href="#foot_krm_0068_20">20</a></sup> अधीयमानः, अध्याप्यमानः, अधिजिगांस्यमानः;</li> <li>  <sup id="ref_krm_0068_21"><a href="#foot_krm_0068_21">21</a></sup> अध्यायः, <sup id="ref_krm_0068_22"><a href="#foot_krm_0068_22">22</a></sup> अध्यायः, <sup id="ref_krm_0068_23"><a href="#foot_krm_0068_23">23</a></sup> उपाध्यायः, उपाध्याया, <sup id="ref_krm_0068_24"><a href="#foot_krm_0068_24">24</a></sup> उपाध्यायी, <sup id="ref_krm_0068_25"><a href="#foot_krm_0068_25">25</a></sup> उपाध्यायानी, अध्यापः, अधिजिगमिषः;</li> <li>  अध्येतुम्, अध्यापयितुम्, अधिजिगमिषितुम्;</li> <li>  अधीतिः, अध्यापना, अधिजिगमिषा, अधिजिगापयिषा, अध्यापिपयिषा;</li> <li>  अध्ययनम्, अध्यापनम्, अधिजिगमिषणम्;</li> <li>  अधीत्य, अध्याप्य, अधिजिगमिष्य;</li> <li>  अध्यायम् २, अध्यापम् २, अधिजिगमिषम् २;</li> <li> </li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0068_01"><a href="#ref_krm_0068_01">↑</a> (६६)</li> <li id="foot_krm_0068_02"><a href="#ref_krm_0068_02">↑</a> (२-अदादिः-१०४६। सक-अनिट्-आत्म।)</li> <li id="foot_krm_0068_03"><a href="#ref_krm_0068_03">↑</a> (श्लो १४)</li> <li id="foot_krm_0068_04"><a href="#ref_krm_0068_04">↑</a> [[१। ‘क्रीङ्जीनां णौ’ (६-१-४८) इति आत्वे ‘अर्तिही--’ (७-३-३६) इति पुक्।]]</li> <li id="foot_krm_0068_05"><a href="#ref_krm_0068_05">↑</a> [[२। ‘इङश्च’ (२-४-४८) इति सनि गमिः। ‘गमेरिट् परस्मैपदेषु’ (७-२-५८) इति इट्। ‘परस्मैपदेषु’ इत्यस्य ‘तङानयोरभावे’ इत्यर्थः।]]</li> <li id="foot_krm_0068_06"><a href="#ref_krm_0068_06">↑</a> [[३। ‘इङ्धार्योः शत्रकृच्छ्रिणि’ (३-२-१३०) इति शता।]]</li> <li id="foot_krm_0068_07"><a href="#ref_krm_0068_07">↑</a> [[आ। ‘वाचंयमान् स्थण्डिलशायिनश्च युयु- क्षमाणान् अनिशं मुमुक्षून्। अध्या- पयन्तं विनयात् प्रणेमुः पद्गाः भरद्वाजमुनिं सशिष्यम्।।’ भ। का। ३-४१।]]</li> <li id="foot_krm_0068_08"><a href="#ref_krm_0068_08">↑</a> [[५। ‘बुधयुधनशजनेङ्--’ (१-३-८६) इति ण्यन्तात् परस्मैपदमेव।]]</li> <li id="foot_krm_0068_09"><a href="#ref_krm_0068_09">↑</a> [[४। ‘उगितश्च’ (६-३-४५) इति स्त्रियां ङीप्। अधीयन् पारायणं अकृ- च्छ्रेणाधीयान इत्यर्थः।]]</li> <li id="foot_krm_0068_10"><a href="#ref_krm_0068_10">↑</a> [[आ। ‘वाचंयमान् स्थण्डिलशायिनश्च युयु- क्षमाणान् अनिशं मुमुक्षून्। अध्या- पयन्तं विनयात् प्रणेमुः पद्गाः भरद्वाजमुनिं सशिष्यम्।।’ भ। का। ३-४१।]]</li> <li id="foot_krm_0068_11"><a href="#ref_krm_0068_11">↑</a> [[५। ‘बुधयुधनशजनेङ्--’ (१-३-८६) इति ण्यन्तात् परस्मैपदमेव।]]</li> <li id="foot_krm_0068_12"><a href="#ref_krm_0068_12">↑</a> [[६। इयड् पूर्वम्। पश्चात् दीर्घः।]]</li> <li id="foot_krm_0068_13"><a href="#ref_krm_0068_13">↑</a> [[B। ‘ऋग्यजुषमधीयानान् सामन्यांश्च समर्चयन्। बुभुजे देवसात्कृत्वा शूल्यमुख्यं च होमवान्।।’ भ। का। ४-९।]]</li> <li id="foot_krm_0068_14"><a href="#ref_krm_0068_14">↑</a> [[७। ‘इङश्च’ (२-४-४८) इति गमादेशः। ‘अज्झनगमां सनि’ (६-४-१६) दीर्घः।]]</li> <li id="foot_krm_0068_15"><a href="#ref_krm_0068_15">↑</a> [[८। ‘आर्धधातुकस्येट्--’ (७-२-३५) इतीट्।]]</li> <li id="foot_krm_0068_16"><a href="#ref_krm_0068_16">↑</a> [पृष्ठम्००६७+ ४२]</li> <li id="foot_krm_0068_17"><a href="#ref_krm_0068_17">↑</a> [[आ। ‘इत्यः स्वधीतोपनिषद्भिरेषामधी- त्यरूपः स वियन् क्रमेण। इयञ्जनं राजपथं समायात् वाताकुलोद्भातव- ताकमीशः।।’ धा। का। २-४८।]]</li> <li id="foot_krm_0068_18"><a href="#ref_krm_0068_18">↑</a> [[१। ‘कर्मण्यण्’ (३-२-१) इत्यण्।]]</li> <li id="foot_krm_0068_19"><a href="#ref_krm_0068_19">↑</a> [[२। ‘णौ च संश्चङोः।’ (२-४-५१) इति गादेशः वा, पक्षे आत्वे पुकि अध्या- पिपयिषुः इति रूपम्।]]</li> <li id="foot_krm_0068_20"><a href="#ref_krm_0068_20">↑</a> [[३। कर्मणि युक्।]]</li> <li id="foot_krm_0068_21"><a href="#ref_krm_0068_21">↑</a> [[४। ‘अध्यायन्याय--’ (३-३-१२२) इति संज्ञायां अधिकरणे घञ्। घाप- वादः।]]</li> <li id="foot_krm_0068_22"><a href="#ref_krm_0068_22">↑</a> [[५। ‘इङश्च’ (३-३-२१) इति भावादौ घञ् असंज्ञायाम्। अध्ययन- मध्यायः।]]</li> <li id="foot_krm_0068_23"><a href="#ref_krm_0068_23">↑</a> [[B। ‘ततः कपिसमाहारं एकनिश्चायमा- गतम्। उपाध्याय इवायामं सुग्रीवोऽध्यापिपद् दिशाम्।।’ भ। का। ७-३४।]]</li> <li id="foot_krm_0068_24"><a href="#ref_krm_0068_24">↑</a> [[६। ‘अपादाने स्त्रियामुपसंख्यानं तदन्ताच्च वा ङीष्’ (वा। ३-३-२१) इति ङीष् वा।]]</li> <li id="foot_krm_0068_25"><a href="#ref_krm_0068_25">↑</a> [[C। ‘मातुलोपाध्याययोरानुग् वा’ (वा। ४-१-४९।) इति स्त्रियामानुग् वा।]]</li></ul></p>

इट
<ul><li><sup id="ref_krm_0069_01"><a href="#foot_krm_0069_01">1</a></sup> {@“इट गतौ”@} <sup id="ref_krm_0069_02"><a href="#foot_krm_0069_02">2</a></sup> एटकः-टिका, एटकः-टिका, एटिटिषकः-षिका, एटन् <sup id="ref_krm_0069_03"><a href="#foot_krm_0069_03">3</a></sup> -न्ती, इत्यादीनि रूपाणि ‘इख’ <sup id="ref_krm_0069_04"><a href="#foot_krm_0069_04">4</a></sup> धातुवत् बोध्यानि। </li> <li><sup id="ref_krm_0069_05"><a href="#foot_krm_0069_05">5</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0069_01"><a href="#ref_krm_0069_01">↑</a> (६७)</li> <li id="foot_krm_0069_02"><a href="#ref_krm_0069_02">↑</a> (१-भ्वादिः-३१८-सक। सेट्। पर।)</li> <li id="foot_krm_0069_03"><a href="#ref_krm_0069_03">↑</a> [[ड्। “चेटैर्बिटैश्चानुगतान् अवेटकैरेटत्प- शूत्केटिरजः कटन् मलान्।।” धा। का। १-४२।]]</li> <li id="foot_krm_0069_04"><a href="#ref_krm_0069_04">↑</a> (६३)</li> <li id="foot_krm_0069_05"><a href="#ref_krm_0069_05">↑</a> [पृष्ठम्००६८+ २३]</li></ul></p>

इण्|आयकः-यिका|गमकः-मिका|प्रत्यायकः-यिका|जिगमिषकः-षिका|प्रतीषिषकः-षिका|एता-त्री|आययिता-त्री|गमयिता-त्री|जिगमिषिता-त्री|प्रतीषिषिता-त्री|यन्निर्यन्|यती|प्रत्याययन्-न्ती|गमयन्-न्ती|जिगमिषन्-न्ती|प्रतीषिषन्-न्ती|एष्यन्-न्ती-ती|प्रत्याययिष्यन्-न्ती-ती|गमयिष्यन्-न्ती-ती|जिगमिषिष्यन्-|न्ती-ती|प्रतीषिषिष्यन्-ती-न्ती|-|प्रत्याययमानः|प्रत्याययिष्यमाणः|-परीत्-परीतौ-परीतः|इतं-इतः-इतवान्|उपेतः|प्रत्यायितः|अवगमितः|जिगमिषितः|प्रतीषितः-तवान्|अयः|आयः|गमः|इत्वरः|उपेयिवान्|ईयिवान्|समीयिवान्-उपेयुषी|अत्ययी|अत्यायः|जिगमिषुः|जिगमयिषुः|परीषिषुः|एतव्यम्|उपैतव्यम्|प्रत्याययितव्यम्|गमयितव्यम्|जिगमिषितव्यम्|प्रतीषिषितव्यम्|अयनीयम्|प्रत्यायनीयम्|गमनीयम्|जिगमिषणीयम्|प्रतीषिषणीयम्|इत्यम्|अनभ्याशमित्यः|प्रत्याय्यम्|अवगम्यम्|जिगमिष्यम्|प्रतीषिष्यम्|ईषदयः|-दुरयः-स्वयः|ईषदायः-ईषदवगमः-इत्यादि|-ईयमानः|प्रत्याय्यमानः|अवगम्यमानः|जिगांस्यमानः|प्रतीष्यमाणः|न्यायः|पर्यायः|अध्यायः|समयः|अन्वयः|उदयः|न्ययः|व्ययः|अभ्युदयः|न्यायःअवगमः|प्रत्यायः|एतुम्|प्रत्याययितुम्|गमयितुम्|जिगमिषितुम्|प्रतीषिषितुम्|इत्या|अपीतिः|समितिः|इतिः|समित्|प्रत्यायना|अवगमना|जिगमिषा|जिगमयिषा|प्रतीषिषा|प्रत्याययिषा|अयनम्|अन्तरयणम्|अन्तरयनो|प्रत्यायनम्|अवगमनम्|जिगमिषणम्|प्रतीषिषणम्|इत्वा|आययित्वा|गमयित्वा|जिगमिषित्वा|ईषिषित्वा|उपेत्य-परीत्य|प्रत्याय्य|अवगमय्य|अवजिगमिष्य|प्रतीषिष्य|आयम्|प्रत्यायम्|अवगमम्अवगामङ्गमयित्वा|जिगमिषम्|प्रतीषिषम्
<ul><li><sup id="ref_krm_0070_01"><a href="#foot_krm_0070_01">1</a></sup> {@“इण् गतौ”@} <sup id="ref_krm_0070_02"><a href="#foot_krm_0070_02">2</a></sup> ‘अयत्येतीयते गत्याम्, अधीतेऽध्येति चेङिकोः’ <sup id="ref_krm_0070_03"><a href="#foot_krm_0070_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_0070_04"><a href="#foot_krm_0070_04">4</a></sup> आयकः-यिका, <sup id="ref_krm_0070_05"><a href="#foot_krm_0070_05">5</a></sup> गमकः-मिका, <sup id="ref_krm_0070_06"><a href="#foot_krm_0070_06">6</a></sup> प्रत्यायकः-यिका, <sup id="ref_krm_0070_07"><a href="#foot_krm_0070_07">7</a></sup> जिगमिषकः-षिका, <sup id="ref_krm_0070_08"><a href="#foot_krm_0070_08">8</a></sup> प्रतीषिषकः-षिका;</li> <li>  एता-त्री, आययिता-त्री, गमयिता-त्री, जिगमिषिता-त्री, प्रतीषिषिता-त्री;</li> <li>  <sup id="ref_krm_0070_09"><a href="#foot_krm_0070_09">9</a></sup> यन् <sup id="ref_krm_0070_10"><a href="#foot_krm_0070_10">10</a></sup> निर्यन् यती, प्रत्याययन्-न्ती, गमयन्-न्ती, जिगमिषन्-न्ती, प्रतीषिषन्-न्ती;</li> <li>  एष्यन्- <sup id="ref_krm_0070_11"><a href="#foot_krm_0070_11">11</a></sup> न्ती-ती, प्रत्याययिष्यन्-न्ती-ती, गमयिष्यन्-न्ती-ती, जिगमिषिष्यन्- न्ती-ती, प्रतीषिषिष्यन्-ती-न्ती;</li> <li>  -- प्रत्याययमानः, प्रत्याययिष्यमाणः;</li> <li>  -- <sup id="ref_krm_0070_12"><a href="#foot_krm_0070_12">12</a></sup> परीत्-परीतौ-परीतः;</li> <li>  -- -- इतं- <sup id="ref_krm_0070_13"><a href="#foot_krm_0070_13">13</a></sup> इतः-इतवान्, <sup id="ref_krm_0070_14"><a href="#foot_krm_0070_14">14</a></sup> उपेतः, प्रत्यायितः, अवगमितः, जिगमिषितः, प्रतीषितः-तवान्;</li> <li>  <sup id="ref_krm_0070_15"><a href="#foot_krm_0070_15">15</a></sup> अयः, आयः, गमः, <sup id="ref_krm_0070_16"><a href="#foot_krm_0070_16">16</a></sup> इत्वरः, <sup id="ref_krm_0070_17"><a href="#foot_krm_0070_17">17</a></sup> उपेयिवान् <sup id="ref_krm_0070_18"><a href="#foot_krm_0070_18">18</a></sup>, ईयिवान् <sup id="ref_krm_0070_19"><a href="#foot_krm_0070_19">19</a></sup>, समीयिवान्- <sup id="ref_krm_0070_20"><a href="#foot_krm_0070_20">20</a></sup> उपेयुषी, <sup id="ref_krm_0070_21"><a href="#foot_krm_0070_21">21</a></sup> अत्ययी, <sup id="ref_krm_0070_22"><a href="#foot_krm_0070_22">22</a></sup> अत्यायः, जिगमिषुः, जिगमयिषुः, परीषिषुः;</li> <li>  एतव्यम्, <sup id="ref_krm_0070_23"><a href="#foot_krm_0070_23">23</a></sup> उपैतव्यम्, प्रत्याययितव्यम्, गमयितव्यम्, जिगमिषितव्यम्, प्रतीषिषितव्यम्;</li> <li>  अयनीयम्, प्रत्यायनीयम्, गमनीयम्, जिगमिषणीयम्, प्रतीषिषणीयम्;</li> <li>  <sup id="ref_krm_0070_24"><a href="#foot_krm_0070_24">24</a></sup> इत्यम् <sup id="ref_krm_0070_25"><a href="#foot_krm_0070_25">25</a></sup>, अनभ्याशमित्यः <sup id="ref_krm_0070_26"><a href="#foot_krm_0070_26">26</a></sup>, प्रत्याय्यम्, अवगम्यम्, जिगमिष्यम्, प्रतीषिष्यम्;</li> <li>  ईषदयः, -दुरयः-स्वयः, ईषदायः-ईषदवगमः-इत्यादि;</li> <li>  -- <sup id="ref_krm_0070_27"><a href="#foot_krm_0070_27">27</a></sup> ईयमानः, प्रत्याय्यमानः, अवगम्यमानः, <sup id="ref_krm_0070_28"><a href="#foot_krm_0070_28">28</a></sup> जिगांस्यमानः, प्रतीष्यमाणः;</li> <li>  <sup id="ref_krm_0070_29"><a href="#foot_krm_0070_29">29</a></sup> आयः, <sup id="ref_krm_0070_30"><a href="#foot_krm_0070_30">30</a></sup> न्यायः <sup id="ref_krm_0070_31"><a href="#foot_krm_0070_31">31</a></sup>, <sup id="ref_krm_0070_32"><a href="#foot_krm_0070_32">32</a></sup> पर्यायः, <sup id="ref_krm_0070_33"><a href="#foot_krm_0070_33">33</a></sup> <sup id="ref_krm_0070_34"><a href="#foot_krm_0070_34">34</a></sup> अध्यायः, समयः, <sup id="ref_krm_0070_35"><a href="#foot_krm_0070_35">35</a></sup> अन्वयः, उदयः, न्ययः, व्ययः, <sup id="ref_krm_0070_36"><a href="#foot_krm_0070_36">36</a></sup> अभ्युदयः, न्यायः <sup id="ref_krm_0070_37"><a href="#foot_krm_0070_37">37</a></sup> अवगमः, प्रत्यायः;</li> <li>  एतुम्, प्रत्याययितुम्, गमयितुम्, जिगमिषितुम्, प्रतीषिषितुम्;</li> <li>  <sup id="ref_krm_0070_38"><a href="#foot_krm_0070_38">38</a></sup> इत्या, अपीतिः, <sup id="ref_krm_0070_39"><a href="#foot_krm_0070_39">39</a></sup> समितिः, इतिः, समित् <sup id="ref_krm_0070_40"><a href="#foot_krm_0070_40">40</a></sup>, प्रत्यायना, अवगमना, जिगमिषा, जिगमयिषा, प्रतीषिषा, प्रत्याययिषा;</li> <li>  अयनम्, <sup id="ref_krm_0070_41"><a href="#foot_krm_0070_41">41</a></sup> अन्तरयणम् <sup id="ref_krm_0070_42"><a href="#foot_krm_0070_42">42</a></sup>, अन्तरयनो <sup id="ref_krm_0070_43"><a href="#foot_krm_0070_43">43</a></sup>, प्रत्यायनम्, अवगमनम्, जिगमिषणम्, प्रतीषिषणम्;</li> <li>  इत्वा, आययित्वा, गमयित्वा, जिगमिषित्वा, ईषिषित्वा;</li> <li>  उपेत्य-परीत्य, प्रत्याय्य, <sup id="ref_krm_0070_44"><a href="#foot_krm_0070_44">44</a></sup> अवगमय्य, अवजिगमिष्य, प्रतीषिष्य;</li> <li>  <sup id="ref_krm_0070_45"><a href="#foot_krm_0070_45">45</a></sup> आयम् २, इत्वा २, प्रत्यायम् २, आययित्वा २, <sup id="ref_krm_0070_46"><a href="#foot_krm_0070_46">46</a></sup> अवगमम् २ अवगामम् २ गमयित्वा २, -- -- -- -- जिगमिषम् २, जिगमिषित्वा २, प्रतीषिषम् २;</li> <li>  ईषिषित्वा २;</li> <li> </li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0070_01"><a href="#ref_krm_0070_01">↑</a> (६८)</li> <li id="foot_krm_0070_02"><a href="#ref_krm_0070_02">↑</a> (२-अदादिः-१०४५-अनिट्। सक-पर-)</li> <li id="foot_krm_0070_03"><a href="#ref_krm_0070_03">↑</a> (१४ श्लो।)</li> <li id="foot_krm_0070_04"><a href="#ref_krm_0070_04">↑</a> [[१। ‘अचो ञणति’ (७-२-११५) इति वृद्धौ आयादेशः।]]</li> <li id="foot_krm_0070_05"><a href="#ref_krm_0070_05">↑</a> [[२। ‘णौ गमिरबोधने’ (२-४-४६) इति गमादेशः। अमन्तत्वान्मित्त्वेन उपधाह्रस्वः।]]</li> <li id="foot_krm_0070_06"><a href="#ref_krm_0070_06">↑</a> [[३। इणो बोधनार्थकत्वात् ‘अबोधने’ (२-४-४६) इत्युक्त्या गमादेशाभावः।]]</li> <li id="foot_krm_0070_07"><a href="#ref_krm_0070_07">↑</a> [[४। ‘सनि च’ (२-४-४७) इति गमादेशः। ‘गमेरिट् परस्मैपदेषु’ (७-२-५८) इत्यत्र ‘परस्मैपदेषु’ इत्यस्य तङानयोरभावे--इत्यर्थकतया अत्र सन इड् भवति।]]</li> <li id="foot_krm_0070_08"><a href="#ref_krm_0070_08">↑</a> [[५। ‘सनि च’ (२-४-४७) इत्यत्रापि ‘अबोधने’ इत्यनुवृत्त्या गमादेशाभावे, अजादि- त्वाद् ‘अजादेर्द्वितीयस्य’ (६-१-२) इति द्वितीयस्यैकाचो द्वित्वे, ‘अज्झनगमां सनि’ (६-४-१६) इति दीर्घः।]]</li> <li id="foot_krm_0070_09"><a href="#ref_krm_0070_09">↑</a> [[६। ‘इणो यण्’ (६-४-८१) इति यणादेशः।]]</li> <li id="foot_krm_0070_10"><a href="#ref_krm_0070_10">↑</a> [[आ। ‘निर्यत्स्फुलिङ्गाकुलधूमराशिं किं ब्रूहि भूमौ पिनषाम भानुम्। आदन्तनिष्पी- डितपीतमिन्दुं ष्ठीवाम शुष्केक्षुलताऽस्थिकल्पम्’।। भ। का। १२-१८।]]</li> <li id="foot_krm_0070_11"><a href="#ref_krm_0070_11">↑</a> [[७। ‘आच्छीनद्योर्नुम्’ (७-१-८०) इति नुमागमस्य वैकल्पिकत्वात् रूपद्वयम्।]]</li> <li id="foot_krm_0070_12"><a href="#ref_krm_0070_12">↑</a> [[८। ‘षत्वतुकोरसिद्धः’ (६-१-८६) इत्यनेन एकादेशशास्त्रस्यासिद्धत्वात् तुक्।]]</li> <li id="foot_krm_0070_13"><a href="#ref_krm_0070_13">↑</a> [[B। ‘अहृत धनेश्वरस्य युधि यः समेतमायो धनं तमहमितो विलोक्य बिबुधैः कृतोत्त- मायोधनम्।’ भ। का। १०-३६।]]</li> <li id="foot_krm_0070_14"><a href="#ref_krm_0070_14">↑</a> [[९। आ + इतः एतः, उप × एत = इति स्थिते ‘एत्येधत्यूठ्सु’ (६-१-८९) इति वृद्धिं बाधित्वा, ‘ओमाङोश्च’ (६-१-९५) इति पररूपम्।]]</li> <li id="foot_krm_0070_15"><a href="#ref_krm_0070_15">↑</a> [पृष्ठम्००६९+ २४]</li> <li id="foot_krm_0070_16"><a href="#ref_krm_0070_16">↑</a> [[१। ‘इण्नशिजिसर्तिभ्यः--’ (३-२-१६३) इति तच्छीलादिषु क्वरप्। तुक्।]]</li> <li id="foot_krm_0070_17"><a href="#ref_krm_0070_17">↑</a> [[आ। ‘रावणः शुश्रुवान् शत्रून् राक्षसानभ्युपेयुषः। स्वयं युयुत्सयांचक्रे प्राकाराग्रे निषेदिवान्।।’ भ। का। १४-२२।]]</li> <li id="foot_krm_0070_18"><a href="#ref_krm_0070_18">↑</a> [[२। ‘उपेयिवाननाश्वान्--’ (३-२-१०९) इति क्वसुप्रत्ययान्तो निपातितः। ‘उप’ इत्यस्याविवक्षितत्वात्-समीयिवान्-ईयिवान्-इत्याद्यपि सिद्ध्यति। ‘दीर्घ इणः किति’ (७-४-६९) इति दीर्घः।]]</li> <li id="foot_krm_0070_19"><a href="#ref_krm_0070_19">↑</a> [[B। ‘निवृत्ते भरते धीमान् अत्रे रामस्तपोवनम्। प्रपेदे पूजितस्तस्मिन् दण्डकारण्य- मीयिवान्।।’ भ। का। ४-१।]]</li> <li id="foot_krm_0070_20"><a href="#ref_krm_0070_20">↑</a> [[३। ‘उगितश्च’ (४-१-६) इति ङीप्। ‘वसोः सम्प्रसारणम्’ (६-४-१३१) इति सम्प्रसारणम्।]]</li> <li id="foot_krm_0070_21"><a href="#ref_krm_0070_21">↑</a> [[४। ‘जिदृक्षिविश्रीण्--’ (३-२-१५७) इत्यनेन तच्छीलादिषु इनिः।]]</li> <li id="foot_krm_0070_22"><a href="#ref_krm_0070_22">↑</a> [[५। ‘श्याद्व्यधाश्रुसंस्रतीण्--’ (३-१-१४१) इति ‘अति’ इत्युपसृष्टादस्मात् कर्तरि णः प्रत्ययः।]]</li> <li id="foot_krm_0070_23"><a href="#ref_krm_0070_23">↑</a> [[६। ‘एत्येधत्यूठ्सु’ (६-१-८९) इति वृद्धिः।]]</li> <li id="foot_krm_0070_24"><a href="#ref_krm_0070_24">↑</a> [[C। ‘आदृत्यस्तेन वृत्येन स्तुत्यो जुष्येण सङ्गतः। इत्यः शिष्येण गुरुवत् गृध्यमर्थमवा- प्स्यसि’ भ। का। ६-५५।]]</li> <li id="foot_krm_0070_25"><a href="#ref_krm_0070_25">↑</a> [[७। ‘एतिस्तुशास्--’ (३-१-१०९) इति क्यपि तुक्।]]</li> <li id="foot_krm_0070_26"><a href="#ref_krm_0070_26">↑</a> [[८। ‘इत्येऽनभ्याशस्य’ (वा-६-३-७०) इति पूर्वपदस्य मुम्।]]</li> <li id="foot_krm_0070_27"><a href="#ref_krm_0070_27">↑</a> [[९। ‘अकृत्सार्वधातुकयो--’ (७-४-२५) रिति दीर्घः।]]</li> <li id="foot_krm_0070_28"><a href="#ref_krm_0070_28">↑</a> [[१०। ‘अज्झनगमां सनि’ (६-४-१६) इति दीर्घः। आत्मनेपदपरकत्वात् सनो नेट्।]]</li> <li id="foot_krm_0070_29"><a href="#ref_krm_0070_29">↑</a> [पृष्ठम्००७०+ ३०]</li> <li id="foot_krm_0070_30"><a href="#ref_krm_0070_30">↑</a> [[आ। ‘नरकस्यावतारोऽयं प्रत्यक्षोऽस्माकमागतः। अचेष्टा यदिहान्यायात् अनेनात्स्या- महे वयम्।।’ भ। का। ७-८२।]]</li> <li id="foot_krm_0070_31"><a href="#ref_krm_0070_31">↑</a> [[१। संज्ञायाम् ‘अध्यायन्याय--’ (३-३-१२२) इत्यादिना घापवादो घञ् निपातितः। न्याय इति शास्त्रस्य संज्ञा। न्येति--निश्चिनोति इति शास्त्रयुक्त्यादिरत्र न्यायः। न अभ्रेषः।]]</li> <li id="foot_krm_0070_32"><a href="#ref_krm_0070_32">↑</a> [[२। ‘परावनुपात्यय इणः’ (३-३-३८) इति अजपवादो घञ्। क्रमस्यानतिक्रमोऽनुपा- त्ययः।]]</li> <li id="foot_krm_0070_33"><a href="#ref_krm_0070_33">↑</a> [[B। ‘न्याय्यं यद्यत्र तत् कार्यं पर्यायेणाविरोधिभिः। निशोपशायः कर्तव्यः फलो- च्चायश्च संहतैः।।’ भ। का। ७-४१।]]</li> <li id="foot_krm_0070_34"><a href="#ref_krm_0070_34">↑</a> [[३। ‘अध्यायन्याय--’ (३-३-१२२) इत्यादिना घापवादो घञ् निपातितः। संज्ञायाम्]]</li> <li id="foot_krm_0070_35"><a href="#ref_krm_0070_35">↑</a> [[४। ‘एरच्’ (३-३-५६) इति भावेऽच्। एवं ‘अभ्युदय’ इति यावदच् प्रत्ययः।]]</li> <li id="foot_krm_0070_36"><a href="#ref_krm_0070_36">↑</a> [[C। ‘निराकरिष्णुर्द्विजकुञ्जराणां तृणीकृताशेषगुणोऽतिमोहात्। पापाशयान् अभ्युदया- र्थमार्च्छीत् प्राग्ब्रह्मरक्षःप्रवरान् दशास्यः।।’ भ। का। ११-४४।]]</li> <li id="foot_krm_0070_37"><a href="#ref_krm_0070_37">↑</a> [[५। ‘परिन्योर्नीणोर्द्यूताभ्रेषयोः’ (३-३-३७) इति घञ्। अभ्रेषोऽस्खलनम्। न्याये स्थितः।]]</li> <li id="foot_krm_0070_38"><a href="#ref_krm_0070_38">↑</a> [[६। ‘संज्ञायां समजनिषदनिपतमनविदषुञ्शीङ्भृञिणः’ (३-३-९९) इति स्त्रियां भावे क्यप्।]]</li> <li id="foot_krm_0070_39"><a href="#ref_krm_0070_39">↑</a> [[७। बाहुलकात् क्तिन्नपि--इत्यात्रेयः। समितिः = सभा।]]</li> <li id="foot_krm_0070_40"><a href="#ref_krm_0070_40">↑</a> [[८। ‘संपदादित्वात्--’ (३-३-९४) स्त्रियां भावादौ क्विप्। समित् = युद्धः।]]</li> <li id="foot_krm_0070_41"><a href="#ref_krm_0070_41">↑</a> [[९। ‘अयनं च’ (८-४-२५) इत्यदेशे णत्वम्। देशविशेषे तु न--अन्तरयनो देशः। ‘अन्तश्शब्दस्याङ्किविधिणत्वेषु उपसर्गत्वं वक्तव्यम्’ (वा। १-४-५८) इति वचनात् उपसर्गत्वम्। ‘कृत्यच’ (८-४-२९) इत्यनेनैव सिद्धे, देशे णत्वाभावाय ‘अयनं च’ (८-४-२५) इति सूत्रारम्भः।]]</li> <li id="foot_krm_0070_42"><a href="#ref_krm_0070_42">↑</a> (वर्तते)</li> <li id="foot_krm_0070_43"><a href="#ref_krm_0070_43">↑</a> (देशः)</li> <li id="foot_krm_0070_44"><a href="#ref_krm_0070_44">↑</a> [[१०। ‘ल्यपि लघुपूर्वात्’ (६-४-५६) इति णेरयादेशः।]]</li> <li id="foot_krm_0070_45"><a href="#ref_krm_0070_45">↑</a> [पृष्ठम्००७१+ २६]</li> <li id="foot_krm_0070_46"><a href="#ref_krm_0070_46">↑</a> [[१। ‘चिण्णमुलोर्दीर्घोऽन्यतरस्याम्’ (६-४-९३) इति णमुलि दीर्घविकल्पः।]]</li></ul></p>

