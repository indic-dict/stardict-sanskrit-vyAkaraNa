<ul><li><sup id="ref_krm_1147_01"><a href="#foot_krm_1147_01">1</a></sup> {@“भज सेवायाम्”@} <sup id="ref_krm_1147_02"><a href="#foot_krm_1147_02">2</a></sup> ‘--विभागसेवयोः’ इति द्रुमे <sup id="ref_krm_1147_03"><a href="#foot_krm_1147_03">3</a></sup>। </li> <li>‘सेवायां भजते भजेदिति भजेः, विश्राणने भाजयेद् आमर्दे तु भनक्ति, भाजयति णौ भाजेः पृथक्कर्मणि।। </li> <li><sup id="ref_krm_1147_04"><a href="#foot_krm_1147_04">4</a></sup> इति देवः। </li> <li><sup id="ref_krm_1147_05"><a href="#foot_krm_1147_05">5</a></sup> भाजकः-जिका, भाजकः-जिका, <sup id="ref_krm_1147_06"><a href="#foot_krm_1147_06">6</a></sup> बिभक्षकः-क्षिका, <sup id="ref_krm_1147_07"><a href="#foot_krm_1147_07">7</a></sup> बाभजकः-जिका;</li> <li>  <sup id="ref_krm_1147_08"><a href="#foot_krm_1147_08">8</a></sup> भक्ता-भक्त्री, भाजयिता-त्री, बिभक्षिता-त्री;</li> <li>  बाभजिता-त्री;</li> <li>  भजन्-न्ती, भाजयन्-न्ती, बिभक्षन्-न्ती;</li> <li>  -- भक्ष्यन्-न्ती, भाजयिष्यन्-न्ती-ती, बिभक्षिष्यन्-न्ती-ती;</li> <li>  -- भजमानः, भाजयमानः, बिभक्षमाणः, बाभज्यमानः;</li> <li>  भक्ष्यमाणः, भाजयिष्यमाणः, बिभक्षिष्यमाणः, बाभजिष्यमाणः;</li> <li>  <sup id="ref_krm_1147_09"><a href="#foot_krm_1147_09">9</a></sup> देहभाक् <sup id="ref_krm_1147_10"><a href="#foot_krm_1147_10">10</a></sup> -देहभाग्-देहभाजौ-देहभाजः;</li> <li>  -- -- विभक्तम्-भक्तवान्, भाजितः, बिभक्षितः, बाभजितः-तवान्;</li> <li>  भजः, <sup id="ref_krm_1147_11"><a href="#foot_krm_1147_11">11</a></sup> भागी, <sup id="ref_krm_1147_12"><a href="#foot_krm_1147_12">12</a></sup> भक्तम्-भक्तः, <sup id="ref_krm_1147_13"><a href="#foot_krm_1147_13">13</a></sup> राज्यभाक्-प्रभाक्, <sup id="ref_krm_1147_14"><a href="#foot_krm_1147_14">14</a></sup> भेजिवान् <sup id="ref_krm_1147_15"><a href="#foot_krm_1147_15">15</a></sup>, <sup id="ref_krm_1147_16"><a href="#foot_krm_1147_16">16</a></sup> भ्राता, <sup id="ref_krm_1147_17"><a href="#foot_krm_1147_17">17</a></sup> <sup id="ref_krm_1147_18"><a href="#foot_krm_1147_18">18</a></sup> धनभाजी, <sup id="ref_krm_1147_19"><a href="#foot_krm_1147_19">19</a></sup> विभक्तिः, <sup id="ref_krm_1147_20"><a href="#foot_krm_1147_20">20</a></sup> भजमानः, भाजः, बिभक्षुः, बाभजः;</li> <li>  भक्तव्यम्, भाजयितव्यम्, बिभक्षितव्यम्, बाभजितव्यम्;</li> <li>  भजनीयम्, भाजनीयम्, बिभक्षणीयम्, बाभजनीयम्;</li> <li>  <sup id="ref_krm_1147_21"><a href="#foot_krm_1147_21">21</a></sup> विभज्यम्, <sup id="ref_krm_1147_22"><a href="#foot_krm_1147_22">22</a></sup> विभाग्यम्, भाज्यम्, बिभक्ष्यम्, बाभज्यम्;</li> <li>  ईषद्भजः-दुर्भजः-सुभजः;</li> <li>  -- -- भज्यमानः, भाज्यमानः, बिभक्ष्यमाणः, बाभज्यमानः;</li> <li>  भागः, <sup id="ref_krm_1147_23"><a href="#foot_krm_1147_23">23</a></sup> भगः, भाजः, बिभक्षः, बाभजः;</li> <li>  भक्तुम्, भाजयितुम्, बिभक्षितुम्, बाभजितुम्;</li> <li>  <sup id="ref_krm_1147_24"><a href="#foot_krm_1147_24">24</a></sup> भक्तिः- <sup id="ref_krm_1147_25"><a href="#foot_krm_1147_25">25</a></sup> दृढभक्तिः, भाजना, बिभक्षा, बाभजा;</li> <li>  <sup id="ref_krm_1147_26"><a href="#foot_krm_1147_26">26</a></sup> भजनम्, भाजनम्, बिभक्षणम्, बाभजनम्;</li> <li>  <sup id="ref_krm_1147_27"><a href="#foot_krm_1147_27">27</a></sup> भक्त्वा;</li> <li>  भाजयित्वा, बिभक्षित्वा, बाभजित्वा;</li> <li>  विभज्य, विभाज्य, प्रबिभक्ष्य, प्रबाभज्य;</li> <li>  भाजम् २, भक्त्वा २, भाजम् २, भाजयित्वा २, बिभक्षम् २, बिभक्षित्वा २, बाभजम् २;</li> <li>  बाभजित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1147_01"><a href="#ref_krm_1147_01">↑</a> (११३७)</li> <li id="foot_krm_1147_02"><a href="#ref_krm_1147_02">↑</a> (१-भ्वादिः-९९८। सक। अनि। उभ)</li> <li id="foot_krm_1147_03"><a href="#ref_krm_1147_03">↑</a> (श्लो। १२३)</li> <li id="foot_krm_1147_04"><a href="#ref_krm_1147_04">↑</a> (श्लो। ६६)</li> <li id="foot_krm_1147_05"><a href="#ref_krm_1147_05">↑</a> [पृष्ठम्०९३७+ ३१]</li> <li id="foot_krm_1147_06"><a href="#ref_krm_1147_06">↑</a> [[१। सन्नन्ताण्ण्वुलि, धातोरनिट्त्वादिडागमाभावे, चर्त्वषत्वयोश्च रूपम्। एवं सन्नन्ते सर्वत्र प्रक्रिया ज्ञेया।]]</li> <li id="foot_krm_1147_07"><a href="#ref_krm_1147_07">↑</a> [[२। यङन्ते सर्वत्र, अभ्यासे दीर्घः, जश्त्वं चेति ज्ञेयम्।]]</li> <li id="foot_krm_1147_08"><a href="#ref_krm_1147_08">↑</a> [[३। धातोरनिट्त्वात्, चर्त्वे रूपमेवम्। एवं तव्यदादिष्वपि ज्ञेयम्।]]</li> <li id="foot_krm_1147_09"><a href="#ref_krm_1147_09">↑</a> [[४। ‘भजो ण्विः’ (३-२-६२) इति कर्तरि ण्विप्रत्ययः। प्रत्ययस्य णित्त्वादुपधावृद्धिः। क्विबादिवदयं प्रत्ययः सर्वलीपी। कर्तरि क्विपोऽपवादोऽयम्।]]</li> <li id="foot_krm_1147_10"><a href="#ref_krm_1147_10">↑</a> [[आ। ‘देहभाञ्जि ततः केशान् लुलुञ्च लुलुठे मुहुः।।’ भ। का। १४। ५९।]]</li> <li id="foot_krm_1147_11"><a href="#ref_krm_1147_11">↑</a> [[५। तच्छीलादिषु कर्तृषु, ‘सम्पृवानुरुधाङ्यमाङ्यसपरिसृसंसृजपरिदेविसंज्वरपरिक्षिप- परिरटपरिवदपरिदहपरिमुहदुषद्विषद्रुहदुहयुजाक्रीडविविचत्यजरजभज--’ (३-२-१४२) इत्यादिना घिनुण्प्रत्ययः। णित्त्वादुपधावृद्धिः। घित्त्वात्, ‘चजोः कु घिण्ण्यतोः’ (७-३-५२) इति कुत्वमिति च ज्ञेयम्।]]</li> <li id="foot_krm_1147_12"><a href="#ref_krm_1147_12">↑</a> [[६। आशीरर्थे, ‘क्तिच्क्तौ च संज्ञायाम्’ (३-३-१७४) इति संज्ञायां क्तप्रत्ययः। भक्तम् = अन्नम्। भजतादिति भक्तः = उपासकः।]]</li> <li id="foot_krm_1147_13"><a href="#ref_krm_1147_13">↑</a> [[७। ‘भजो ण्विः’ (३-२-६२) इत्यत्र उपसर्गे सुपि च उपपदे प्रत्ययविधानाश्रयणादत्र, प्रभाक् इत्यत्र च कर्तरि ण्विप्रत्यय इति ज्ञेयम्।]]</li> <li id="foot_krm_1147_14"><a href="#ref_krm_1147_14">↑</a> [[८। कर्तरि भूतसामान्ये लिटः क्वसौ, ‘तृफलभजत्रपश्च’ (६-४-१२२) इति एत्वाभ्यास- लोपयोः, ‘वस्वेकाजाद्धसाम्’ (७-२-६७) इतीडागमे च रूपमेवम्।]]</li> <li id="foot_krm_1147_15"><a href="#ref_krm_1147_15">↑</a> [[B। ‘आज्ञानुग्रहभीमकोमलपुरीपाला फलं भेजुषां याऽयोध्येत्यपराजितेति विदिता नाकं परेण स्थिता।’ श्रीगुणरत्नकोशे २३।]]</li> <li id="foot_krm_1147_16"><a href="#ref_krm_1147_16">↑</a> [[९। ‘तृन्’ (३-२-१३५) इति ताच्छीलिके तृन्प्रत्यये, ‘नप्तृनेष्टृ--’ (द। उ। २-३) इत्यत्र निपातनात् भ्रादेशे च भ्राता इति सिद्ध्यतीति मा। धा। वृत्तावुक्तम्। द। उ। वृत्त्यादिषु भ्राजतेर्जकारलोपे रूपनिष्पादनं कृतम्। ‘श्वशुरः श्वश्र्वा’ (१-२-७१) इत्यत्र भाष्ये तु ‘यदि तावद् बिभर्तीति भ्राता--’ इत्युक्तत्वात् भृञ्धातोरेव भ्रातृशब्दनिष्पत्तिन्याय्येति प्रतिभाति।]]</li> <li id="foot_krm_1147_17"><a href="#ref_krm_1147_17">↑</a> [पृष्ठम्०९३८+ २८]</li> <li id="foot_krm_1147_18"><a href="#ref_krm_1147_18">↑</a> [[१। ताच्छीलिके णिनिप्रत्यये रूपमेवम्।]]</li> <li id="foot_krm_1147_19"><a href="#ref_krm_1147_19">↑</a> [[२। ‘क्तिच्क्तौ च--’ (३-३-१७४) इत्यनेन संज्ञायां क्तिचि रूपम्। विभक्तिः = प्रथमाद्या विभक्तिः। अत्र सूत्रे (३-३-१७४) आशिषि गम्यमान एव प्रत्यय इत्युक्तम- विवक्षितमिति केचित्।]]</li> <li id="foot_krm_1147_20"><a href="#ref_krm_1147_20">↑</a> [[३। ‘ताच्छील्यवयोवचनशक्तिषु--’ (३-२-१२९) इत्यनेन ताच्छील्ये गम्ये चानश्प्रत्ययः। शित्त्वाच्छबादिकं भवति।]]</li> <li id="foot_krm_1147_21"><a href="#ref_krm_1147_21">↑</a> [[४। ‘द्विवचनविभज्योपपदे--’ (५-३-५७) इति सूत्रे विभज्य इति निर्देशात् हलन्तलक्षणण्यदपवादो यत्प्रत्ययोऽत्रेति ज्ञेयम्।]]</li> <li id="foot_krm_1147_22"><a href="#ref_krm_1147_22">↑</a> [[५। ‘अबाधकान्यपि निपातनानि’ (परिभाषा-१२०) इति दर्शने ण्यत्प्रत्यये कुत्वे च रूपमेवम्। विभाज्यम् इति कुत्वाभावरूपं तु सर्वथा अप्रामाणिकमेव। स्पष्टमिदं प्रकृतसूत्रे (५-३-५७) पदमञ्जर्याम्, उद्द्योते च।]]</li> <li id="foot_krm_1147_23"><a href="#ref_krm_1147_23">↑</a> [[६। ‘खनो घ च’ (३-३-१२५) इत्यत्र चकाराद् धात्वन्तरेभ्योऽपि घप्रत्ययो भवतीत्यतो- ऽत्र घप्रत्यये, घित्त्वेन कुत्वे च रूपमेवम्। ‘हृद्भग--’ (७-३-१९) इत्यत्र ‘भग--’ इति निर्देश एवात्र निदानम्।]]</li> <li id="foot_krm_1147_24"><a href="#ref_krm_1147_24">↑</a> [[७। भजनम् = भक्तिः। भावे क्तिन्। दृढभक्तिरित्यत्र दृढा भक्तिरस्येति विग्रहे ‘स्त्रियाः पुंवत्--’ (६-३-३४) इति पूर्वपदस्य पुंवद्भावे रूपमेवम्। प्रियादिषु (६-३-३४) कर्मसाधनस्यैव भक्तिशब्दस्य पाठः, न तु भावसाधनस्य। अतः पुंवद्भावः कथमत्रेति न शङ्क्यम्।]]</li> <li id="foot_krm_1147_25"><a href="#ref_krm_1147_25">↑</a> [[आ। ‘दृढभक्तिरिति ज्येष्ठे राज्यतृष्णापराङ्मुखः।’ रघुवंशे १२-१९।]]</li> <li id="foot_krm_1147_26"><a href="#ref_krm_1147_26">↑</a> [[८। ल्युटि, अनादेशे रूपमेवम्। स्त्रियां टित्त्वेन ङीपि भजनी इत्येव भवति। भजना इति टाबन्तप्रयोगो लोके दृश्यते। तस्य शास्त्रं मृग्यमेव। ण्यन्तात् स्त्र्यधिकारीये युच्प्रत्ययेऽपि भाजना इत्येव स्यात्, न तु भजना इति।]]</li> <li id="foot_krm_1147_27"><a href="#ref_krm_1147_27">↑</a> [पृष्ठम्०९३९+ २६]</li></ul></p>

भज|भाजकः-जिका|बिभाजयिषकः-षिका|भाजयिता-त्री|बिभाजयिषिता-त्री
<ul><li><sup id="ref_krm_1148_01"><a href="#foot_krm_1148_01">1</a></sup> {@“भज विश्राणने”@} <sup id="ref_krm_1148_02"><a href="#foot_krm_1148_02">2</a></sup> विश्राणनम् = दानम्। </li> <li>‘सेवायां भजते भजेदिति भजेः, विश्राणने भाजयेद्…’ <sup id="ref_krm_1148_03"><a href="#foot_krm_1148_03">3</a></sup> इति देवः। </li> <li>भाजकः-जिका, बिभाजयिषकः-षिका;</li> <li>  भाजयिता-त्री, बिभाजयिषिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकगर्जयतिवत् <sup id="ref_krm_1148_04"><a href="#foot_krm_1148_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1148_05"><a href="#foot_krm_1148_05">5</a></sup> विभाज्य।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1148_01"><a href="#ref_krm_1148_01">↑</a> (११३८)</li> <li id="foot_krm_1148_02"><a href="#ref_krm_1148_02">↑</a> (१०-चुरादिः-१७३४। सक। सेट्। उभ।)</li> <li id="foot_krm_1148_03"><a href="#ref_krm_1148_03">↑</a> (श्लो। ६५)</li> <li id="foot_krm_1148_04"><a href="#ref_krm_1148_04">↑</a> (३७८)</li> <li id="foot_krm_1148_05"><a href="#ref_krm_1148_05">↑</a> [[आ। ‘आज्ञापनामिह विभाज्य नृपेण दृष्टौ…।।’ धा। का। ३। ४०।]]</li></ul></p>

भजि|भञ्जकः-ञ्जिका|बिभञ्जयिषकः-षिका|बिभञ्जिषकः-षिका|बाभञ्जकः-ञ्जिका
<ul><li><sup id="ref_krm_1149_01"><a href="#foot_krm_1149_01">1</a></sup> {@“भजि भाषार्थः”@} <sup id="ref_krm_1149_02"><a href="#foot_krm_1149_02">2</a></sup> आस्वदीयः। </li> <li>‘भाषार्थे णिचि भञ्जयेद्…।’ <sup id="ref_krm_1149_03"><a href="#foot_krm_1149_03">3</a></sup> इति देवः। </li> <li>भञ्जकः-ञ्जिका, बिभञ्जयिषकः-षिका, भञ्जकः-ञ्जिका, बिभञ्जिषकः-षिका, बाभञ्जकः-ञ्जिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिककुंशयतिवत् <sup id="ref_krm_1149_04"><a href="#foot_krm_1149_04">4</a></sup> ज्ञेयानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1149_01"><a href="#ref_krm_1149_01">↑</a> (११३९)</li> <li id="foot_krm_1149_02"><a href="#ref_krm_1149_02">↑</a> (१०-चुरादिः-१७६०। अक। सेट्। उभ।)</li> <li id="foot_krm_1149_03"><a href="#ref_krm_1149_03">↑</a> (श्लो। ६६)</li> <li id="foot_krm_1149_04"><a href="#ref_krm_1149_04">↑</a> (२३२)</li></ul></p>

भट
<ul><li><sup id="ref_krm_1150_01"><a href="#foot_krm_1150_01">1</a></sup> {@“भट भृतौ”@} <sup id="ref_krm_1150_02"><a href="#foot_krm_1150_02">2</a></sup> घटादिः। </li> <li>भृतिः = वेतनम्। </li> <li>‘भृतिः = वेतनप्राप्तिः।’ इति धा। </li> <li>का। </li> <li>व्याख्यायाम् <sup id="ref_krm_1150_03"><a href="#foot_krm_1150_03">3</a></sup>। </li> <li>भाटकः-टिका, भाटकः-टिका, <sup id="ref_krm_1150_04"><a href="#foot_krm_1150_04">4</a></sup> भटकः-टिका, बिभटिषकः- षिका, बाभटकः-टिका, इत्यादीनि सर्वाणि रूपाणि भौवादिककठतिवत् <sup id="ref_krm_1150_05"><a href="#foot_krm_1150_05">5</a></sup> बोध्यानि। </li> <li><sup id="ref_krm_1150_06"><a href="#foot_krm_1150_06">6</a></sup> इत्रप्रत्यये रूपमेवम्। </li> <li>भटित्रम् = शूलपक्वमांसम्- ‘वेतनमित्युणादिवृत्तौ--’ इति मा। </li> <li>धा। </li> <li>वृत्तिः।]] भटित्रम्। </li> <li><sup id="ref_krm_1150_07"><a href="#foot_krm_1150_07">7</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1150_01"><a href="#ref_krm_1150_01">↑</a> (११४०)</li> <li id="foot_krm_1150_02"><a href="#ref_krm_1150_02">↑</a> (१-भ्वादिः-३०७-७८०। अक। सेट्। पर।)</li> <li id="foot_krm_1150_03"><a href="#ref_krm_1150_03">↑</a> (१-४१)</li> <li id="foot_krm_1150_04"><a href="#ref_krm_1150_04">↑</a> [[१। ‘भट परिभाषणे’ इति घटादिषु पठ्यते। अस्यैव भृत्यर्थकस्य धातोः परि- भाषणार्थे मित्त्वार्थोऽनुवादः। ततश्च परिभाषणार्थे घटादित्वेन मित्त्वात् णौ, ‘मितां ह्रस्वः’ (६-४-९२) इति उपधाह्रस्वे रूपमेवम्। एवं तृजादिष्वपि भटयिता-त्री इत्यादीनि रूपाणि यथायथमूह्यानि।]]</li> <li id="foot_krm_1150_05"><a href="#ref_krm_1150_05">↑</a> (१४८)</li> <li id="foot_krm_1150_06"><a href="#ref_krm_1150_06">↑</a> [[२। औणादिके [द। उ। ८। ९३]</li> <li id="foot_krm_1150_07"><a href="#ref_krm_1150_07">↑</a> [पृष्ठम्०९४०+ २६]</li></ul></p>

भडि|तथापि|’]]|भण्डकः-ण्डिका|बिभण्डिषकः-षिका|बाभण्डकः-ण्डिका
<ul><li><sup id="ref_krm_1151_01"><a href="#foot_krm_1151_01">1</a></sup> {@“भडि परिभाषणे”@} <sup id="ref_krm_1151_02"><a href="#foot_krm_1151_02">2</a></sup> ‘परितो भाषणम् = परिभाषणम्।’ इति स्वाम्यादयः। </li> <li>“-- ‘यः सनिन्द उपालम्भस्तत्र स्यात् परिभाषणम्।’ <sup id="ref_krm_1151_03"><a href="#foot_krm_1151_03">3</a></sup> इति निथण्टुः।” इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>‘कल्याणे भण्डयेद् भण्डेः, परिहासे तु भण्डते।’ <sup id="ref_krm_1151_04"><a href="#foot_krm_1151_04">4</a></sup> इति देवः। </li> <li><sup id="ref_krm_1151_05"><a href="#foot_krm_1151_05">5</a></sup> यद्यपि, ‘कल्याणे भण्डयेद् भण्डेः, परिहासे तु भण्डते।’ इति देवश्लोकः क्वचित् दैवकोशेषु नोपलभ्यते, पुरुषकारेऽपि न व्याख्यातः। </li> <li>तथापि, ‘--परि- हासे’ इति देवः।’ इति माधवधातुवृत्तिवाक्यात्, क्वचित् कोशे मुद्रितत्वाच्चा- स्माभिरपीहोपात्तः इति ज्ञेयम्।]] भण्डकः-ण्डिका, भण्डकः-ण्डिका, बिभण्डिषकः-षिका, बाभण्डकः-ण्डिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककण्ठतिवत् <sup id="ref_krm_1151_06"><a href="#foot_krm_1151_06">6</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1151_07"><a href="#foot_krm_1151_07">7</a></sup> भण्डनः, <sup id="ref_krm_1151_08"><a href="#foot_krm_1151_08">8</a></sup> भाण्डम्, <sup id="ref_krm_1151_09"><a href="#foot_krm_1151_09">9</a></sup> भण्डिलः <sup id="ref_krm_1151_10"><a href="#foot_krm_1151_10">10</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1151_01"><a href="#ref_krm_1151_01">↑</a> (११४१)</li> <li id="foot_krm_1151_02"><a href="#ref_krm_1151_02">↑</a> (१-भ्वादिः-२७३। सक। सेट्। आत्म।)</li> <li id="foot_krm_1151_03"><a href="#ref_krm_1151_03">↑</a> (अमरकोशे १-६-१४)</li> <li id="foot_krm_1151_04"><a href="#ref_krm_1151_04">↑</a> (श्लो। ८९)</li> <li id="foot_krm_1151_05"><a href="#ref_krm_1151_05">↑</a> [[[अ]</li> <li id="foot_krm_1151_06"><a href="#ref_krm_1151_06">↑</a> (१४९)</li> <li id="foot_krm_1151_07"><a href="#ref_krm_1151_07">↑</a> [[१। ‘अनुदात्तेतश्च हलादेः’ (३-२-१४९) इति ताच्छीलिके युचि रूपमेवम्।]]</li> <li id="foot_krm_1151_08"><a href="#ref_krm_1151_08">↑</a> [[२। भण्डते इति भण्डः। पचाद्यच्। भण्ड एव भाण्डम् = पात्रादिकम्। स्वार्थिकेऽणि रूपमेवम्।]]</li> <li id="foot_krm_1151_09"><a href="#ref_krm_1151_09">↑</a> [[३। बाहुलकात् औणादिके इलच्प्रत्यये रूपमेवम्। भण्डिलः = दूतः।]]</li> <li id="foot_krm_1151_10"><a href="#ref_krm_1151_10">↑</a> [[आ। ‘स भण्डिलो भोजनृपालपिण्डभुक् प्रमुण्डितांस्तत्र जनानतुण्डकान्।।’ धा। का। १। ३६।]]</li></ul></p>

भडि|भण्डकः-ण्डिका|बिभण्डयिषकः-षिका|बिभण्डिषकः-षिका|बाभण्डकः-ण्डिका
<ul><li><sup id="ref_krm_1152_01"><a href="#foot_krm_1152_01">1</a></sup> {@“भडि कल्याणे”@} <sup id="ref_krm_1152_02"><a href="#foot_krm_1152_02">2</a></sup> इदित्करणात् णिचो वैकल्पिकत्वम्। </li> <li>‘कल्याणे भण्डयेद् भण्डेः परिहासे तु भण्डते।’ <sup id="ref_krm_1152_03"><a href="#foot_krm_1152_03">3</a></sup> इति देवः। </li> <li>भण्डकः-ण्डिका, बिभण्डयिषकः-षिका, भण्डकः-ण्डिका, बिभण्डिषकः-षिका, बाभण्डकः-ण्डिका;</li> <li>  इत्यादीनि सर्वाणि रूपाणि चौरादिककुण्ठयतिवत् <sup id="ref_krm_1152_04"><a href="#foot_krm_1152_04">4</a></sup> ज्ञेयानि। </li> <li>कर्तरि क्तपत्यये <sup id="ref_krm_1152_05"><a href="#foot_krm_1152_05">5</a></sup> सुभण्डितः इति भवति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1152_01"><a href="#ref_krm_1152_01">↑</a> (११४२)</li> <li id="foot_krm_1152_02"><a href="#ref_krm_1152_02">↑</a> (१०-चुरादिः-१५८८। सक। सेट्। उभ।)</li> <li id="foot_krm_1152_03"><a href="#ref_krm_1152_03">↑</a> (श्लो। ८९)</li> <li id="foot_krm_1152_04"><a href="#ref_krm_1152_04">↑</a> (२१०)</li> <li id="foot_krm_1152_05"><a href="#ref_krm_1152_05">↑</a> [[B। ‘बर्हादिमण्डितसुभण्डितविग्रहोऽसौ प्रच्छर्दितः किल बकेन च पुस्तितार्तिः।’ धा। का। ३। २०।]]</li></ul></p>

भण|भाणकः-णिका|बिभणिषकः-षिका|बम्भणकः-बंभणकः-णिका
<ul><li><sup id="ref_krm_1153_01"><a href="#foot_krm_1153_01">1</a></sup> {@“भण शब्दे”@} <sup id="ref_krm_1153_02"><a href="#foot_krm_1153_02">2</a></sup> भाणकः-णिका, भाणकः-णिका, बिभणिषकः-षिका, बम्भणकः-बंभणकः- <sup id="ref_krm_1153_03"><a href="#foot_krm_1153_03">3</a></sup> णिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककणतिवत् <sup id="ref_krm_1153_04"><a href="#foot_krm_1153_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1153_05"><a href="#foot_krm_1153_05">5</a></sup> भाणः, <sup id="ref_krm_1153_06"><a href="#foot_krm_1153_06">6</a></sup> भणितिः, <sup id="ref_krm_1153_07"><a href="#foot_krm_1153_07">7</a></sup> भाण्डम्, <sup id="ref_krm_1153_08"><a href="#foot_krm_1153_08">8</a></sup> भणन्-न्ती इतीमानि रूपाण्यधिकान्यत्रेति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1153_01"><a href="#ref_krm_1153_01">↑</a> (११४३)</li> <li id="foot_krm_1153_02"><a href="#ref_krm_1153_02">↑</a> (१-भ्वादिः-४४७। अक। सेट्। पर।)</li> <li id="foot_krm_1153_03"><a href="#ref_krm_1153_03">↑</a> [पृष्ठम्०९४१+ ३०]</li> <li id="foot_krm_1153_04"><a href="#ref_krm_1153_04">↑</a> (१५७)</li> <li id="foot_krm_1153_05"><a href="#ref_krm_1153_05">↑</a> [[१। भण्यते इति कर्मणि संज्ञायां घञ्प्रत्यये रूपम्। भाणः दशसु रूपकेष्वेकः।]]</li> <li id="foot_krm_1153_06"><a href="#ref_krm_1153_06">↑</a> [[२। ‘तितुत्रेष्वग्रहादीनाम्--’ (वा। ७-२-९) इति वचनात् इड् भवति।]]</li> <li id="foot_krm_1153_07"><a href="#ref_krm_1153_07">↑</a> [[३। भणतीति भाण्डम्। ‘पुच्छभाण्ड--’ (३-१-२०) इति निर्देशाद्दीर्घः। अथवा ‘ञमन्ताड्डः’ (द। उ। ५-७) इति डप्रत्यये ततः प्रज्ञादित्वात् (५-४-३८) अणि रूपमेवम्। भण्यते इति वा भाण्डम् = पात्रम्।]]</li> <li id="foot_krm_1153_08"><a href="#ref_krm_1153_08">↑</a> [[आ। ‘अणद्दिशः केलिरणैर्मनोज्ञया वाण्या भणन्तो मणिभूषणोत्कणाः।’ धा। का। १। ५८।]]</li></ul></p>

भदि|भन्दकः-न्दिका|बिभन्दिषकः-षिका|बाभन्दकः-न्दिका
<ul><li><sup id="ref_krm_1154_01"><a href="#foot_krm_1154_01">1</a></sup> {@“भदि कल्याणे सुखे च”@} <sup id="ref_krm_1154_02"><a href="#foot_krm_1154_02">2</a></sup> <sup id="ref_krm_1154_03"><a href="#foot_krm_1154_03">3</a></sup> ‘भदि कल्याणे’ इति चुरादावपि दुर्गः पठतीति क्षीरतरङ्गिण्यामुक्तम्। </li> <li>दुर्गा- तिरिक्तेन केनापि तस्य धातोः चुरादिष्वपठितत्वादस्माभिर्न लिखित इति ज्ञेयम्।]] कल्याणम् = मङ्गलम्, सुखम् = आत्मगुणः, आत्मगुणोदयो वा। </li> <li>भन्दकः-न्दिका, भन्दकः-न्दिका, बिभन्दिषकः-षिका, बाभन्दकः-न्दिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिककन्दतिवत् <sup id="ref_krm_1154_04"><a href="#foot_krm_1154_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_1154_05"><a href="#foot_krm_1154_05">5</a></sup> भद्रम्, <sup id="ref_krm_1154_06"><a href="#foot_krm_1154_06">6</a></sup> नतभन्दिनी। </li> <li><sup id="ref_krm_1154_07"><a href="#foot_krm_1154_07">7</a></sup> भदाकः, <sup id="ref_krm_1154_08"><a href="#foot_krm_1154_08">8</a></sup> भदन्तः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1154_01"><a href="#ref_krm_1154_01">↑</a> (११४४)</li> <li id="foot_krm_1154_02"><a href="#ref_krm_1154_02">↑</a> (१-भ्वादिः-१२। अक। सेट्। आत्म।)</li> <li id="foot_krm_1154_03"><a href="#ref_krm_1154_03">↑</a> [[[अ]</li> <li id="foot_krm_1154_04"><a href="#ref_krm_1154_04">↑</a> (१६३)</li> <li id="foot_krm_1154_05"><a href="#ref_krm_1154_05">↑</a> [[४। औणादिके (द। उ। ८-४६) रन्प्रत्यये रूपमेवम्। बाहुलकाद्धातुनकारस्य लोपः।]]</li> <li id="foot_krm_1154_06"><a href="#ref_krm_1154_06">↑</a> [[B। ‘प्रश्विन्दिताशं यशसा पुराऽप्यसौ विवन्दिषुस्तं नतभन्दिनं विभुम्।’ धा। का। १। ३।]]</li> <li id="foot_krm_1154_07"><a href="#ref_krm_1154_07">↑</a> [[५। पिनाकादिषु (द। उ। ३-३४) दर्शनादाकप्रत्यये नकारलोपे च रूपमेवम्। भदाकः = अकुटिलः।]]</li> <li id="foot_krm_1154_08"><a href="#ref_krm_1154_08">↑</a> [[६। ‘भन्देर्नलोपश्च’ (पञ्चपाद्युणादिः ३-१३०) इति झच्प्रत्यये, ‘झोऽन्तः’ (७-१-३) इत्यन्तादेशे नकारलोपे च रूपमेवम्। भदन्तः = प्रव्रजितः।]]</li></ul></p>

