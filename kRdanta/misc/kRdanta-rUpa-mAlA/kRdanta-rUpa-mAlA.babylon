<ul><li><sup id="ref_krm_0072_01"><a href="#foot_krm_0072_01">1</a></sup> {@“ञि इन्धी दीप्तौ”@} <sup id="ref_krm_0072_02"><a href="#foot_krm_0072_02">2</a></sup> दीपनायामपि प्रयुज्यते। </li> <li>इन्धकः-न्धिका, इन्धकः-न्धिका, इन्दिधिषकः-षिका;</li> <li>  इन्धिता-त्री, इन्धयिता-त्री, इन्दिधिषिता-त्री;</li> <li>  -- इन्धयन्-न्ती, इन्धयिष्यन्-न्ती-ती;</li> <li>  <sup id="ref_krm_0072_03"><a href="#foot_krm_0072_03">3</a></sup> इन्धानः, <sup id="ref_krm_0072_04"><a href="#foot_krm_0072_04">4</a></sup> समिन्धानः, इन्धयमानः, इन्दिधिषमाणः;</li> <li>  इन्धिष्यमाणः, इन्धयिष्यमाणः, इन्दिधिषिष्यमाणः;</li> <li>  <sup id="ref_krm_0072_05"><a href="#foot_krm_0072_05">5</a></sup> समिध्-समिधौ-समिधः;</li> <li>  -- -- अग्नीध् <sup id="ref_krm_0072_06"><a href="#foot_krm_0072_06">6</a></sup>, भ्राष्ट्रमिन्धः <sup id="ref_krm_0072_07"><a href="#foot_krm_0072_07">7</a></sup>, अग्निमिन्धः, इन्धः, इन्धनम् <sup id="ref_krm_0072_08"><a href="#foot_krm_0072_08">8</a></sup> इन्दिधिषुः, इन्दिधयिषुः;</li> <li>  समिद्धम्, इद्ध <sup id="ref_krm_0072_09"><a href="#foot_krm_0072_09">9</a></sup> ः;</li> <li>  <sup id="ref_krm_0072_10"><a href="#foot_krm_0072_10">10</a></sup> इद्धवान्, इन्धितम्-तः-तवान्, इन्दिधिषितः-तवान्;</li> <li>  इन्धितव्यम्, इन्धयितव्यम्, इन्दिधिषितव्यम्;</li> <li>  इन्धनीयम्, इन्धनीयम्, इन्दिधिषणीयम्;</li> <li>  इन्ध्यम्, इन्ध्यम्, इन्दिधिष्यम्;</li> <li>  ईषदिन्धः, दुरिन्धः, स्विन्धः;</li> <li>  <sup id="ref_krm_0072_11"><a href="#foot_krm_0072_11">11</a></sup> इद्ध्यमानः, इन्ध्यमानः, इन्दिधिष्यमाणः;</li> <li>  एधः <sup id="ref_krm_0072_12"><a href="#foot_krm_0072_12">12</a></sup>, इन्धः, इन्दिधिषः;</li> <li>  इन्धितुम्, इन्धयितुम्, इन्दिधिषितुम्;</li> <li>  इन्धा, समित् <sup id="ref_krm_0072_13"><a href="#foot_krm_0072_13">13</a></sup>, इन्धना, इन्दिधिषा, इन्दिधयिषा;</li> <li>  इन्धनम्, इन्धनम्, इन्दिधिषणम्;</li> <li>  इन्धित्वा, इन्धयित्वा, इन्दिधिषित्वा;</li> <li>  समिध्य, समिन्ध्य, समिन्दिधिष्य;</li> <li>  इन्धम् २, इन्धित्वा २, इन्धम् २, इन्धयित्वा २, इन्दिधिषम् २;</li> <li>  इन्दिधिषित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0072_01"><a href="#ref_krm_0072_01">↑</a> (७०)</li> <li id="foot_krm_0072_02"><a href="#ref_krm_0072_02">↑</a> (७-रुधादिः-१५४८-अक। से। आ।)</li> <li id="foot_krm_0072_03"><a href="#ref_krm_0072_03">↑</a> [[१। ‘रुधादिभ्यः श्नम्’ (३-१-७८) इति श्नमि ‘श्नान्नलोपः’ (६-४-२३) इति नलोपे ‘श्नसोरल्लोपः’ (६-४-१११) इति अकारलोपः।]]</li> <li id="foot_krm_0072_04"><a href="#ref_krm_0072_04">↑</a> [[आ। ‘यमं युनज्मि कातेन समिन्धानो- ऽस्त्रकौशलम्।’ भ। का। ६-३७।]]</li> <li id="foot_krm_0072_05"><a href="#ref_krm_0072_05">↑</a> [[२। ‘अनिदितां-’ (६-४-२४) इति नलोपः।]]</li> <li id="foot_krm_0072_06"><a href="#ref_krm_0072_06">↑</a> [[३। ‘क्विप् च’ (३-२-७६) इति कर्मणि उवपदे क्विप्।]]</li> <li id="foot_krm_0072_07"><a href="#ref_krm_0072_07">↑</a> [[४। ‘कर्मण्यण्’ (३-२-१) इत्यण्, ‘भ्रा- ष्ट्राग्न्योः--’ (वा। ६-३-७०) इति मुम्।]]</li> <li id="foot_krm_0072_08"><a href="#ref_krm_0072_08">↑</a> [[B। ‘अपां पतिर्नित्यमबिन्धनेन ज्वा- लावता नूनमशोषितोऽभूत्।’ याद वाभ्युदये-१८-४५।]]</li> <li id="foot_krm_0072_09"><a href="#ref_krm_0072_09">↑</a> [[५। ‘ञीतः क्तः’ (३-२-१८७) इति वर्त- माने क्तः। ‘श्वीदितो निष्ठायां’]]</li> <li id="foot_krm_0072_10"><a href="#ref_krm_0072_10">↑</a> [[C। “समिद्धशरणा दीप्ता देहे लङ्का मते- श्वरा। समिद्धशरणाऽऽदीप्ता देहेऽलंकामतेश्वरा।।” भ। का। १०-७।]]</li> <li id="foot_krm_0072_11"><a href="#ref_krm_0072_11">↑</a> [पृष्ठम्००७३+ २६]</li> <li id="foot_krm_0072_12"><a href="#ref_krm_0072_12">↑</a> [[१। ‘अवोदैधौद्म--’ (६-४-२९) इति घञन्तो निपातितः। इध्म इत्यर्थः।]]</li> <li id="foot_krm_0072_13"><a href="#ref_krm_0072_13">↑</a> [[२। ‘संपदादिभ्यः--’ (वा। ३-३-९४) इति क्विप् स्त्रियां भावादौ। युद्ध इत्यर्थः।]]</li></ul></p>

इल|एलकः-लिका|एलिलिषकः-षिका|एलिता-त्री|एलयिता-त्री|एलिलिषिता-त्री|इलन्-न्ती-ती|एलयन्-न्ती|एलिलिषन्-न्ती|एलिष्यन्-न्ती-ती|एलयिष्यन्-न्ती-ती|एलिलिषिषिष्यन्-न्ती-ती|-|एलयमानः|एलयिष्यमाणः|इल्-इलौ-इलः|इलितम्-तः-तवान्|एलितम्-तः|एलिलिषितम्-तः-तवान्|इलः|इला|एलः|एलिलिषुः|एलिलयिषुः|एलितव्यम्|एलयितव्यम्|एलिलिषितव्यम्|एलनीयम्|एलिलिषणीयम्|एल्यम्|एलिलिष्यम्|ईषदेलः|दुरेलः|स्वेलः|इल्यमानः|एल्यमानः|एलिलिष्यमाणः|एलिलिषः|एलितुम्|एलयितुम्|एलिलिषितुम्|इल्तिः-इलितिः|एलना|एलिलिषा|एलिलयिषा|एलनम्|एलिलिषणम्|एलित्वा|एलयित्वा|एलिलिषित्वा|समिल्य|समेल्य|समेलिलिष्य|एलम्|एलिलिषम्
<ul><li><sup id="ref_krm_0073_01"><a href="#foot_krm_0073_01">1</a></sup> {@“इल स्वप्नक्षेपणयोः”@} <sup id="ref_krm_0073_02"><a href="#foot_krm_0073_02">2</a></sup> ‘--स्वप्नप्रेरणयोः’ इति धातुकाव्ये पाठः। </li> <li>एलकः-लिका, एलकः-लिका, <sup id="ref_krm_0073_03"><a href="#foot_krm_0073_03">3</a></sup> एलिलिषकः-षिका;</li> <li>  एलिता-त्री, एलयिता-त्री, एलिलिषिता-त्री;</li> <li>  <sup id="ref_krm_0073_04"><a href="#foot_krm_0073_04">4</a></sup> इलन् <sup id="ref_krm_0073_05"><a href="#foot_krm_0073_05">5</a></sup> <sup id="ref_krm_0073_06"><a href="#foot_krm_0073_06">6</a></sup> -न्ती-ती, एलयन्-न्ती, एलिलिषन्-न्ती;</li> <li>  एलिष्यन्-न्ती-ती, एलयिष्यन्-न्ती-ती, एलिलिषिषिष्यन्-न्ती-ती;</li> <li>  -- एलयमानः, एलयिष्यमाणः;</li> <li>  -- इल्-इलौ-इलः;</li> <li>  -- -- इलितम्-तः-तवान्, एलितम्-तः, एलिलिषितम्-तः-तवान्;</li> <li>  <sup id="ref_krm_0073_07"><a href="#foot_krm_0073_07">7</a></sup> इलः, इला, एलः, एलिलिषुः, एलिलयिषुः;</li> <li>  एलितव्यम्, एलयितव्यम्, एलिलिषितव्यम्;</li> <li>  <sup id="ref_krm_0073_08"><a href="#foot_krm_0073_08">8</a></sup> एलनीयम्, एलनीयम्, एलिलिषणीयम्;</li> <li>  एल्यम्, एल्यम्, एलिलिष्यम्;</li> <li>  ईषदेलः, दुरेलः, स्वेलः;</li> <li>  -- -- इल्यमानः, एल्यमानः, एलिलिष्यमाणः;</li> <li>  एलः, एलः, एलिलिषः;</li> <li>  एलितुम्, एलयितुम्, एलिलिषितुम्;</li> <li>  इल्तिः- <sup id="ref_krm_0073_09"><a href="#foot_krm_0073_09">9</a></sup> इलितिः, एलना, एलिलिषा, एलिलयिषा;</li> <li>  एलनम्, एलनम्, एलिलिषणम्;</li> <li>  <sup id="ref_krm_0073_10"><a href="#foot_krm_0073_10">10</a></sup> एलित्वा, एलयित्वा, एलिलिषित्वा;</li> <li>  समिल्य, समेल्य, समेलिलिष्य;</li> <li>  एलम् २, एलित्वा २, एलम् २, एलयित्वा २, एलिलिषम् २;</li> <li>  एलिलिषित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0073_01"><a href="#ref_krm_0073_01">↑</a> (७१)</li> <li id="foot_krm_0073_02"><a href="#ref_krm_0073_02">↑</a> (६-तुदादिः-१३५७-सक। सेट्। पर।)</li> <li id="foot_krm_0073_03"><a href="#ref_krm_0073_03">↑</a> [[३। उपधाकार्यस्य द्वित्वात् प्रबलत्वात् पूर्व गुणे द्वितीयस्यैकाचः द्वित्वम्।]]</li> <li id="foot_krm_0073_04"><a href="#ref_krm_0073_04">↑</a> [[४। ‘तुदादिभ्यः शः’ (३-१-७७) इति शः। ‘सार्वधातुकमपित्’ (१-२-४) इति शस्य ङिद्वद्भावाल्लघूपधगुणो न।]]</li> <li id="foot_krm_0073_05"><a href="#ref_krm_0073_05">↑</a> [[आ। ‘चिलितपीतपटेन चलन् इलन् अविलितोरुकृपां परितो दृशम्।।’ धा। का। २-७८।]]</li> <li id="foot_krm_0073_06"><a href="#ref_krm_0073_06">↑</a> [[५। ‘आच्छीनद्योर्नुम्’ (७-१-८०) इति नुम् विकल्पेन।]]</li> <li id="foot_krm_0073_07"><a href="#ref_krm_0073_07">↑</a> [[६। ‘इगुपधज्ञाप्रीकिरः कः’ (३-१-१३५) इति कर्तरि कः। टाप् स्त्रियाम्। इला = भूमिः।]]</li> <li id="foot_krm_0073_08"><a href="#ref_krm_0073_08">↑</a> [पृष्ठम्००७४+ २६]</li> <li id="foot_krm_0073_09"><a href="#ref_krm_0073_09">↑</a> [[१। इलितिरित्यत्र ‘तितुत्रेष्वग्रहादीनां--’ (वा। ७-२-९) इति पर्युदासादिड् भवति।]]</li> <li id="foot_krm_0073_10"><a href="#ref_krm_0073_10">↑</a> [[२। ‘न क्त्वा सेट्’ (१-२-१८) इति कित्त्वं न, तेन गुणः।]]</li></ul></p>

इल|एलिलयिषकः-षिका|एलिलयिष्यमाणः|एलिलयिषिता-त्री|एलिलयिषुः|एलिलयिषन्-न्ती|एलिलयिषः|एलिलयिषिष्यन्-न्ती-ती|एलिलयिषितुम्|एलिलयिषमाणः|एलिलयिषा|एलिलयिषिष्यमाणः|एलिलयिषणम्|एलिलयिषितः-तवान्|एलिलयिषित्वा|एलिलयिषितव्यम्|समेलिलयिष्य|एलिलयिषणीयम्|एलिलयिषम्|एलिलयिष्यम्
<ul><li><sup id="ref_krm_0074_01"><a href="#foot_krm_0074_01">1</a></sup> {@“इल प्रेरणे”@} <sup id="ref_krm_0074_02"><a href="#foot_krm_0074_02">2</a></sup> पूर्वोक्ततौदादिकेलतिवत् <sup id="ref_krm_0074_03"><a href="#foot_krm_0074_03">3</a></sup> णिजन्तात् रूपाणि सर्वाणि ज्ञेयानि। </li> <li>ण्यन्तात् पचाद्यचि टापि एला-बहुलगन्धा, जलसंस्कारकफलविशेषः। </li> <li>द्राविड्यां <sup id="ref_krm_0074_04"><a href="#foot_krm_0074_04">4</a></sup> ‘एलक्काय्’ इति प्रसिद्धः। </li> <li>एलिलयिषकः-षिका;</li> <li>  एलिलयिष्यमाणः;</li> <li>  एलिलयिषिता-त्री;</li> <li>  एलिलयिषुः;</li> <li>  एलिलयिषन्-न्ती;</li> <li>  एलिलयिषः;</li> <li>  एलिलयिषिष्यन्-न्ती-ती;</li> <li>  एलिलयिषितुम्;</li> <li>  एलिलयिषमाणः;</li> <li>  एलिलयिषा;</li> <li>  एलिलयिषिष्यमाणः;</li> <li>  एलिलयिषणम्;</li> <li>  एलिलयिषितः-तवान्;</li> <li>  एलिलयिषित्वा;</li> <li>  एलिलयिषितव्यम्;</li> <li>  समेलिलयिष्य;</li> <li>  एलिलयिषणीयम्;</li> <li>  एलिलयिषम्;</li> <li>  एलिलयिष्यम् २;</li> <li>  एलिलयिषित्वा २;</li> <li>  इत्यादिरूपाणि-इति विशेषः। </li> <li><sup id="ref_krm_0074_05"><a href="#foot_krm_0074_05">5</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0074_01"><a href="#ref_krm_0074_01">↑</a> (७२)</li> <li id="foot_krm_0074_02"><a href="#ref_krm_0074_02">↑</a> (१०-चुरादिः-१६६१-सक। सेट्। उभ।)</li> <li id="foot_krm_0074_03"><a href="#ref_krm_0074_03">↑</a> (७१)</li> <li id="foot_krm_0074_04"><a href="#ref_krm_0074_04">↑</a> [{%‘Eलक्काय्’%}]</li> <li id="foot_krm_0074_05"><a href="#ref_krm_0074_05">↑</a> [पृष्ठम्००७५+ २६]</li></ul></p>

