<ul><li><sup id="ref_krm_0919_01"><a href="#foot_krm_0919_01">1</a></sup> {@“धूप सन्तापे”@} <sup id="ref_krm_0919_02"><a href="#foot_krm_0919_02">2</a></sup> ‘धूपायतीति सन्तापे भाषार्थे धूपयेदिति।’ <sup id="ref_krm_0919_03"><a href="#foot_krm_0919_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_0919_04"><a href="#foot_krm_0919_04">4</a></sup> धूपायकः-यिका, धूपकः-पिका, <sup id="ref_krm_0919_05"><a href="#foot_krm_0919_05">5</a></sup> धूपायकः-यिका, धूपकः-पिका, <sup id="ref_krm_0919_06"><a href="#foot_krm_0919_06">6</a></sup> <sup id="ref_krm_0919_07"><a href="#foot_krm_0919_07">7</a></sup> दुधूपायिषकः-दुधूपिषकः-षिका, <sup id="ref_krm_0919_08"><a href="#foot_krm_0919_08">8</a></sup> दोधूपकः-पिका;</li> <li>  धूपायिता-त्री, धूपिता-त्री, धूपाययिता-धूपयिता-त्री, दुधूपायिषिता-दुधूपिषिता-त्री, दोधूपिता-त्री;</li> <li>  <sup id="ref_krm_0919_09"><a href="#foot_krm_0919_09">9</a></sup> धूपायन्-न्ती, धूयाययन्-धूपयन्-न्ती, दुधूपायिषन्-दुधूपिषन्-न्ती;</li> <li>  -- धूपायिष्यन्-धूपिष्यन्-न्ती-ती, धूपाययिष्यन्-धूपयिष्यन्-न्ती-ती, दुधूपायिषिष्यन्-दुधूपिषिष्यन्-न्ती-ती;</li> <li>  -- धूपाययमानः-धूपयमानः, दुधूपायिषमाणः-दुधूपिषमाणः, दोधूप्यमानः;</li> <li>  -- धूपाययिष्यमाणः-धूपयिष्यमाणः, दुधूपायिषिष्यमाणः-दुधूपिषिष्यमाणः, दोधूप्यमानः;</li> <li>  <sup id="ref_krm_0919_10"><a href="#foot_krm_0919_10">10</a></sup> प्रधूपाः-प्रधूपौ-प्रधूपाः, प्रधूप्-प्रधूब्-प्रधूपौ-प्रधूपः;</li> <li>  -- धूपायितम्- <sup id="ref_krm_0919_11"><a href="#foot_krm_0919_11">11</a></sup> धूपितम्, धूपायितः-धूपितः, दुधूपायिषितः-दुधूपिषितः, दोधूपितः-तवान्;</li> <li>  धूपायः-धूपः, प्रधूपी, धूपायः-धूपः, दुधूपायिषुः-दुधूपिषुः, दोधूपः;</li> <li>  धूपायितव्यम्-धूपितव्यम्, धूपाययितव्यम्-धूपयितव्यम्, दुधूपायिषितव्यम्-दुधूपिषितव्यम्, दोधूपितव्यम्;</li> <li>  धूपायनीयम्-धूपनीयम्, धूपायनीयम्-धूपनीयम्, दुधूपायिषणीयम्, दुधूपिषणीयम्, दोधूपनीयम्;</li> <li>  धूपाय्यम्-धूप्यम्, धूपाय्यम्-धूप्यम्, दुधूपायिष्यम्-दुधूपिष्यम्, दोधूप्यम्;</li> <li>  ईषद्धूपायः-दुर्धूपायः-सुधूपायः, ईषद्धूपः-दुर्धूपः-सुधूपः;</li> <li>  -- धूपाय्यमानः-धूप्यमानः, धूपाय्यमानः-धूप्यमानः, दुधूपायिष्यमाणः, दुधूपिष्यमाणः, दोधूप्यमानः;</li> <li>  धूपायः-धूपः, धूपायः-धूपः, दुधूपायिषः, दुधूपिषः, दोधूपः;</li> <li>  <sup id="ref_krm_0919_12"><a href="#foot_krm_0919_12">12</a></sup> धूपायितुम्-धूपितुम्, धूपाययितुम्-धूपयितुम्, दुधूपायिषितुम्-दुधूपिषितुम्, दोधूपितुम्;</li> <li>  धूपाया-धूपा, धूपायना-धूपना, दुधूपायिषा-दुधूपिषा, दोधूपा;</li> <li>  धूपायनम्-धूपनम्, धूपायनम्-धूपनम्, दुधूपायिषणम्-दुधूपिषणम्, दोधूपनम्;</li> <li>  धूपायित्वा-धूपित्वा, धूपाययित्वा-धूपयित्वा, दुधूपायिषित्वा-दुधूपिषित्वा, दोधूपित्वा;</li> <li>  प्रधूपाय्य-प्रधूप्य, प्रधूपाय्य-प्रधूप्य, प्रदुधूपायिष्य-प्रदुधूपिष्य, प्रदोधूप्य;</li> <li>  धूपायम् २ -धूपम् २, धूपायित्वा २ -धूपित्वा २, धूपायम् २ -धूपम् २, धूपाययित्वा २ -धूपयित्वा २, दुधूपायिषम् २ -दुधूपिषम् २, दोधूपम् २;</li> <li>  दुधूपायिषित्वा २ -दुधूपिषित्वा २, दोधूपित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0919_01"><a href="#ref_krm_0919_01">↑</a> (९०९)</li> <li id="foot_krm_0919_02"><a href="#ref_krm_0919_02">↑</a> (१-भ्वादिः-३९६। अक। सेट्। पर।)</li> <li id="foot_krm_0919_03"><a href="#ref_krm_0919_03">↑</a> (श्लो। १३०)</li> <li id="foot_krm_0919_04"><a href="#ref_krm_0919_04">↑</a> [[२। ‘गुपूधूपविच्छिपणिपनिभ्य आयः’ (३-१-२८) इति आयप्रत्ययः। स च, ‘आयादय आर्धधातुके वा’ (३-१-३१) इति विकल्पेन भवति। तेन आयप्रत्ययपक्षे रूपमेवम्। तदभावपक्षे धूपकः इति। एवं आर्धधातुके सर्वत्रायप्रत्ययो ज्ञेयः।]]</li> <li id="foot_krm_0919_05"><a href="#ref_krm_0919_05">↑</a> [[३। ण्यन्तेऽपि सर्वत्रायप्रत्ययविकल्पः। तेन सर्वत्र रूपद्वयम्।]]</li> <li id="foot_krm_0919_06"><a href="#ref_krm_0919_06">↑</a> [पृष्ठम्०८०४+ १९]</li> <li id="foot_krm_0919_07"><a href="#ref_krm_0919_07">↑</a> [[१। आयप्रत्ययान्तात् सनि रूपमेवम्। तदभावे दुधूपिषकः इत्यादीनि रूपाणीति ज्ञेयम्।]]</li> <li id="foot_krm_0919_08"><a href="#ref_krm_0919_08">↑</a> [[२। आर्धधातुकविवक्षायामायप्रत्ययस्य वैकल्पिकत्वात्, आयप्रत्ययान्तस्य अनेकाच्त्वात् आयप्रत्ययविवक्षायां यङ् न। आयाभावपक्षे तु यङि दोधूपकः इत्यादीनि रूपाणि ज्ञेयानि।]]</li> <li id="foot_krm_0919_09"><a href="#ref_krm_0919_09">↑</a> [[३। शतुः सार्वधातुकत्वेन नित्यमायप्रत्ययः।]]</li> <li id="foot_krm_0919_10"><a href="#ref_krm_0919_10">↑</a> [[४। आयप्रत्ययान्तात् क्विपि, अल्लोपयलोपयोः, सोः रुत्वविसर्गयोश्च रूपमेवम्।]]</li> <li id="foot_krm_0919_11"><a href="#ref_krm_0919_11">↑</a> [[आ। ‘गोपायतां धर्ममधूपितात्मनां जल्पान् विमुच्याभवदुद्यमो जपे।।’ धा। का। १। ५१।]]</li> <li id="foot_krm_0919_12"><a href="#ref_krm_0919_12">↑</a> [पृष्ठम्०८०५+ २३]</li></ul></p>

धूप|धूपकः-पिका|दुधूपयिषकः-षिका|धूपयन्-न्ती|दुधूपयिषन्-न्ती-ती|धूपयिष्यन्-न्ती-ती|दुधूपयिषिष्यन्-न्ती-ती
<ul><li><sup id="ref_krm_0920_01"><a href="#foot_krm_0920_01">1</a></sup> {@“धूप भाषार्थः”@} <sup id="ref_krm_0920_02"><a href="#foot_krm_0920_02">2</a></sup> आस्वदीयः। </li> <li>‘भासार्थ इत्येके’ इति मैत्रेयः। </li> <li>तथा च क्षीरस्वामी--‘भासा दीप्तिरर्थो येषां ते भासार्थाः।’ इति मा। </li> <li>धा। </li> <li>वृत्तिः। </li> <li>‘धूपायतीति सन्तापे भाषार्थे धूपयेदिति।’ <sup id="ref_krm_0920_03"><a href="#foot_krm_0920_03">3</a></sup> इति देवः। </li> <li>धूपकः-पिका, दुधूपयिषकः-षिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि कूटयतिवत् <sup id="ref_krm_0920_04"><a href="#foot_krm_0920_04">4</a></sup> ऊह्यानि। </li> <li>धूपयन्-न्ती, दुधूपयिषन्-न्ती-ती, धूपयिष्यन्-न्ती-ती, दुधूपयिषिष्यन्-न्ती-ती;</li> <li>  इति शतृप्रत्ययेऽत्र विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0920_01"><a href="#ref_krm_0920_01">↑</a> (९१०)</li> <li id="foot_krm_0920_02"><a href="#ref_krm_0920_02">↑</a> (१०-चुरादिः-१७७३। सक। सेट्। उभ।)</li> <li id="foot_krm_0920_03"><a href="#ref_krm_0920_03">↑</a> (श्लो। १३०)</li> <li id="foot_krm_0920_04"><a href="#ref_krm_0920_04">↑</a> (२४०)</li></ul></p>

धूरी|धूरकः-रिका|दुधूरिषकः-षिका|दोधूरकः-रिका
<ul><li><sup id="ref_krm_0921_01"><a href="#foot_krm_0921_01">1</a></sup> {@“धूरी हिंसागत्योः”@} <sup id="ref_krm_0921_02"><a href="#foot_krm_0921_02">2</a></sup> धूरकः-रिका, धूरकः-रिका, दुधूरिषकः-षिका, दोधूरकः-रिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि दैवादिकगूर्यतिवत् <sup id="ref_krm_0921_03"><a href="#foot_krm_0921_03">3</a></sup> ऊह्यानि। </li> <li>विधूर्णम् <sup id="ref_krm_0921_04"><a href="#foot_krm_0921_04">4</a></sup> - कर्मणि क्तः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0921_01"><a href="#ref_krm_0921_01">↑</a> (९११)</li> <li id="foot_krm_0921_02"><a href="#ref_krm_0921_02">↑</a> (४-दिवादिः-११५३। सक। सेट्। आत्म।)</li> <li id="foot_krm_0921_03"><a href="#ref_krm_0921_03">↑</a> (४१९)</li> <li id="foot_krm_0921_04"><a href="#ref_krm_0921_04">↑</a> [[आ। ‘धर्मावसायजनदः खलु योऽजनिष्ट दीप्तोष्मपूर्णभुजतूर्णविधूर्णवैरी।।’ धा। का। २। ५९।]]</li></ul></p>

धूस|धूसयन्-न्ती|दुधूसयिष्यन्-न्ती-ती|धूसयिष्यन्|दुधूसयिषिष्यन्-न्ती-ती
<ul><li><sup id="ref_krm_0922_01"><a href="#foot_krm_0922_01">1</a></sup> {@“धूस कान्तिकरणे”@} <sup id="ref_krm_0922_02"><a href="#foot_krm_0922_02">2</a></sup> ‘दन्त्योष्मान्तः’ इति श्रीभद्रमैत्रेयादयः। </li> <li>‘मूर्धन्योष्मान्तः’ इति स्वामी। </li> <li><sup id="ref_krm_0922_03"><a href="#foot_krm_0922_03">3</a></sup> तथा च मैत्रेयोऽपि ‘धूष इत्येके’ इति पपाठ। </li> <li>काश्यपस्तु तालव्योष्मान्त- माह’ इति मा। </li> <li>धा। </li> <li>वृत्तौ। </li> <li>धूसकः-सिका, दुधूसयिषकः-षिका, धूसयिता-त्री, दुधूसयिषिता-त्री, इत्यादीनि सर्वाणि रूपाणि कूटयतिवत् <sup id="ref_krm_0922_04"><a href="#foot_krm_0922_04">4</a></sup> ज्ञेयानि। </li> <li>धूसयन्-न्ती, दुधूसयिष्यन्-न्ती-ती;</li> <li>  धूसयिष्यन्, दुधूसयिषिष्यन्-न्ती-ती;</li> <li>  इति शतृप्रत्ययेऽत्र विशेषः। </li> <li>धूसितम् <sup id="ref_krm_0922_05"><a href="#foot_krm_0922_05">5</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0922_01"><a href="#ref_krm_0922_01">↑</a> (९१२)</li> <li id="foot_krm_0922_02"><a href="#ref_krm_0922_02">↑</a> (१०-चुरादिः-१६४०। अक। सेट्। उभ।)</li> <li id="foot_krm_0922_03"><a href="#ref_krm_0922_03">↑</a> [पृष्ठम्०८०६+ २६]</li> <li id="foot_krm_0922_04"><a href="#ref_krm_0922_04">↑</a> (२४०)</li> <li id="foot_krm_0922_05"><a href="#ref_krm_0922_05">↑</a> [[आ। ‘सौधे विटङ्कजुषि पश्यति धूसितोऽयं राजारिकीटबलच्र्णनयातिपूज्यः।’ धा। का। ३। २७।]]</li></ul></p>

धृङ्|धारकः-रिका|दिधीर्षकः-षिका-देध्रीयकः-यिका|धर्ता-त्री|धारयिता-त्री|दिधीर्षिता-त्री|देध्रीयिता-त्री|-|धारयन्-न्ती|धारयिष्यन्-न्ती-ती|धरमाणः|धारयमाणः|दिधीर्षमाणः|देध्रीयमाणः|धरिष्यमाणः|धारयिष्यमाणः|दिधीर्षिष्यमाणः|देध्रीयिष्यमाणः|सुधृत्-सुधृद्-सुधृतौ-सुधृतः|धृतम्-तः-तवान्|धारितः|दिधीर्षितः|देध्रीयितः-तवान्|धरः|धरणः|धारः|दिधीर्षुः|देध्रीयः|धर्तव्यम्|धारयितव्यम्|दिधीर्षितव्यम्|देध्रीयितव्यम्|धरणीयम्|धारणीयम्|दिधीर्षणीयम्|देध्रीयणीयम्|धार्यम्|दिधीर्ष्यम्|देध्रीय्यम्|ईषद्धरः-दुर्धरः-सुधरः|-ध्रियमाणः|धार्यमाणः|दिधीर्ष्यमाणः|देध्रीय्यमाणः|दिधीर्षः|धर्तुम्|धारयितुम्|दिधीर्षितुम्|देध्रीयितुम्|धारा-धृतिः|धारणा|दिधीर्षा|देध्रीया|धरणम्|धारणम्|दिधीर्षणम्|देध्रीयणम्|धृत्वा|धारयित्वा|दिधीर्षित्वा|देध्रीयित्वा|प्रधृत्य|प्रधार्य|प्रदिधीर्ष्य|प्रदेध्रीय्य|धारम्|दिधीर्षम्|देध्रीयम्
<ul><li><sup id="ref_krm_0923_01"><a href="#foot_krm_0923_01">1</a></sup> {@“धृङ् अवध्वंसने”@} <sup id="ref_krm_0923_02"><a href="#foot_krm_0923_02">2</a></sup> ‘अविध्वंसने’ इति क्षीरस्वामी। </li> <li>‘ध्रियते स्यादवस्थाने धृङोऽवध्वंसने पुनः। </li> <li>धरते धारणेऽर्थे तु धरते धरतीत्युभे।।’ <sup id="ref_krm_0923_03"><a href="#foot_krm_0923_03">3</a></sup> इति देवः। </li> <li>धारकः-रिका, धारकः-रिका, <sup id="ref_krm_0923_04"><a href="#foot_krm_0923_04">4</a></sup> दिधीर्षकः-षिका- <sup id="ref_krm_0923_05"><a href="#foot_krm_0923_05">5</a></sup> देध्रीयकः-यिका;</li> <li>  धर्ता-त्री, धारयिता-त्री, दिधीर्षिता-त्री, देध्रीयिता-त्री;</li> <li>  -- धारयन्-न्ती, धारयिष्यन्-न्ती-ती;</li> <li>  -- धरमाणः, धारयमाणः, दिधीर्षमाणः, देध्रीयमाणः;</li> <li>  <sup id="ref_krm_0923_06"><a href="#foot_krm_0923_06">6</a></sup> धरिष्यमाणः, धारयिष्यमाणः, दिधीर्षिष्यमाणः, देध्रीयिष्यमाणः;</li> <li>  सुधृत्-सुधृद्-सुधृतौ-सुधृतः;</li> <li>  -- -- धृतम्-तः-तवान्, धारितः, दिधीर्षितः, देध्रीयितः-तवान्;</li> <li>  <sup id="ref_krm_0923_07"><a href="#foot_krm_0923_07">7</a></sup> धरः, <sup id="ref_krm_0923_08"><a href="#foot_krm_0923_08">8</a></sup> धरणः, धारः, दिधीर्षुः, देध्रीयः;</li> <li>  धर्तव्यम्, धारयितव्यम्, दिधीर्षितव्यम्, देध्रीयितव्यम्;</li> <li>  धरणीयम्, धारणीयम्, दिधीर्षणीयम्, देध्रीयणीयम्;</li> <li>  <sup id="ref_krm_0923_09"><a href="#foot_krm_0923_09">9</a></sup> <sup id="ref_krm_0923_10"><a href="#foot_krm_0923_10">10</a></sup> धार्यम्, धार्यम्, दिधीर्ष्यम्, देध्रीय्यम्;</li> <li>  ईषद्धरः-दुर्धरः-सुधरः;</li> <li>  -- -- <sup id="ref_krm_0923_11"><a href="#foot_krm_0923_11">11</a></sup> ध्रियमाणः, धार्यमाणः, दिधीर्ष्यमाणः, देध्रीय्यमाणः;</li> <li>  धारः, धारः, दिधीर्षः, देध्रीयः;</li> <li>  धर्तुम्, धारयितुम्, दिधीर्षितुम्, देध्रीयितुम्;</li> <li>  <sup id="ref_krm_0923_12"><a href="#foot_krm_0923_12">12</a></sup> धारा-धृतिः, धारणा, दिधीर्षा, देध्रीया;</li> <li>  धरणम्, धारणम्, दिधीर्षणम्, देध्रीयणम्;</li> <li>  धृत्वा, धारयित्वा, दिधीर्षित्वा, देध्रीयित्वा;</li> <li>  प्रधृत्य, प्रधार्य, प्रदिधीर्ष्य, प्रदेध्रीय्य;</li> <li>  धारम् २, धृत्वा २, धारम् २, धारयित्वा २, दिधीर्षम् २, दिधीर्षित्वा २, देध्रीयम् २;</li> <li>  देध्रीयित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0923_01"><a href="#ref_krm_0923_01">↑</a> (९१३)</li> <li id="foot_krm_0923_02"><a href="#ref_krm_0923_02">↑</a> (१-भ्वादिः-९६०। अक। अनि। आत्म।)</li> <li id="foot_krm_0923_03"><a href="#ref_krm_0923_03">↑</a> (श्लो। २९)</li> <li id="foot_krm_0923_04"><a href="#ref_krm_0923_04">↑</a> [[१। सन्नन्ताण्ण्वुलि ‘इको झल्’ (१-२-९) इति सनः कित्त्वे, ‘अज्झनगमां सनि’ (६-४-१६) इति दीर्घे, ‘ॠत इद्धातोः’ (७-१-१००) इति इत्त्वे रपरत्वे, ‘हलि च’ (८-२-७७) इति दीर्घे च रूपमेवम्। एवं सन्नन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0923_05"><a href="#ref_krm_0923_05">↑</a> [[२। यङन्ते, ‘रीङ् ऋतः’ (७-४-२७) इति रीङ्। गुणोऽभ्यासे। एवं सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0923_06"><a href="#ref_krm_0923_06">↑</a> [[३। ‘ऋद्धनोः स्ये’ (७-२-७०) इतीडागमः।]]</li> <li id="foot_krm_0923_07"><a href="#ref_krm_0923_07">↑</a> [[४। पचादित्वादच्प्रत्ययः कर्तरि।]]</li> <li id="foot_krm_0923_08"><a href="#ref_krm_0923_08">↑</a> [[५। ‘चलनशब्दार्थादकर्मकाद् युच्’ (३-२-१४८) इति ताच्छीलिको युच्।]]</li> <li id="foot_krm_0923_09"><a href="#ref_krm_0923_09">↑</a> [पृष्ठम्०८०७+ २३]</li> <li id="foot_krm_0923_10"><a href="#ref_krm_0923_10">↑</a> [[१। ‘ऋहलोः--’ (३-१-१२४) इति ण्यत्प्रत्ययः।]]</li> <li id="foot_krm_0923_11"><a href="#ref_krm_0923_11">↑</a> [[२। ‘रिङ् शयग्लिङ्क्षु’ (७-४-२८) इति रिङादेशे रूपम्।]]</li> <li id="foot_krm_0923_12"><a href="#ref_krm_0923_12">↑</a> [[३। ‘धारा प्रपाते’ (ग। सू। ३-३-१०३) इति भिदादिपाठात् अङि, ‘ऋदृशोऽङि गुणः’ (७-४-१६) इति गुणः। निपातनाद् दीर्घः। अन्यत्र धृतिः। असिधारा इत्यादिषु प्रपातसाम्यात् लक्षणया प्रयोगः।]]</li></ul></p>

धृङ्|धारकः-रिका|दिधरिषकः-षिका|देध्रीयकः-यिका
<ul><li><sup id="ref_krm_0924_01"><a href="#foot_krm_0924_01">1</a></sup> {@“धृङ् अवस्थाने”@} <sup id="ref_krm_0924_02"><a href="#foot_krm_0924_02">2</a></sup> किरादिः। </li> <li>‘धारणे च’ इति द्रुमे। </li> <li>‘ध्रियते स्यादवस्थाने धृङोऽवध्वंसने पुनः। </li> <li>धरते धारणेऽर्थे तु धरते धरतीत्युभे।।’ <sup id="ref_krm_0924_03"><a href="#foot_krm_0924_03">3</a></sup> इति देवः। </li> <li>धारकः-रिका, धारकः-रिका, <sup id="ref_krm_0924_04"><a href="#foot_krm_0924_04">4</a></sup> दिधरिषकः-षिका, देध्रीयकः-यिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकधरतिवत् <sup id="ref_krm_0924_05"><a href="#foot_krm_0924_05">5</a></sup> ऊह्यानि। </li> <li><sup id="ref_krm_0924_06"><a href="#foot_krm_0924_06">6</a></sup> पुरन्ध्री <sup id="ref_krm_0924_07"><a href="#foot_krm_0924_07">7</a></sup>, <sup id="ref_krm_0924_08"><a href="#foot_krm_0924_08">8</a></sup> <sup id="ref_krm_0924_09"><a href="#foot_krm_0924_09">9</a></sup> महीध्रः-कुध्रः, <sup id="ref_krm_0924_10"><a href="#foot_krm_0924_10">10</a></sup> आधारः, <sup id="ref_krm_0924_11"><a href="#foot_krm_0924_11">11</a></sup> धर्मः, इमानि रूपाणि अस्य धातोरिति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0924_01"><a href="#ref_krm_0924_01">↑</a> (९१४)</li> <li id="foot_krm_0924_02"><a href="#ref_krm_0924_02">↑</a> (६-तुदादिः-१४१२। अक। अनि। आत्म।)</li> <li id="foot_krm_0924_03"><a href="#ref_krm_0924_03">↑</a> (श्लो। २९)</li> <li id="foot_krm_0924_04"><a href="#ref_krm_0924_04">↑</a> [[४। अस्य धातोः किरादित्वात् ‘किरश्च पञ्चभ्यः’ (७-२-७५) इति सनि इडागमो भवति। द्वित्वादिकम्। एवं सन्नन्ते सर्वत्र ज्ञेयम्।]]</li> <li id="foot_krm_0924_05"><a href="#ref_krm_0924_05">↑</a> (९१३)</li> <li id="foot_krm_0924_06"><a href="#ref_krm_0924_06">↑</a> [[५। पुरं धारयतीत्यर्थे ‘संज्ञायां भृ--’ (३-२-४६) इति खचि, पृषोदरादित्वात् उपधा- लोपे साधुः। स्त्रियाम्, गौरादित्वात् ङीष्।]]</li> <li id="foot_krm_0924_07"><a href="#ref_krm_0924_07">↑</a> [[आ। ‘ह्रीणां नवोढां जगतोऽभिनन्द्यां तां पर्यगृह्णन् मुदिताः पुरन्ध्र्यः।।’ वा। वि। १-६०।]]</li> <li id="foot_krm_0924_08"><a href="#ref_krm_0924_08">↑</a> [पृष्ठम्०८०८+ २८]</li> <li id="foot_krm_0924_09"><a href="#ref_krm_0924_09">↑</a> [[१। ‘कप्रकरणे मूलविभुजादिभ्य उपसंख्यानम्’ (वा। ३-२-५) इति कः। एवं कुं धरतीति कुध्रः इत्यत्रापि ज्ञेयम्।]]</li> <li id="foot_krm_0924_10"><a href="#ref_krm_0924_10">↑</a> [[२। ‘अवहाराधारावायानामुपसंख्यानम्’ (वा। ३-३-१२२) इति घञन्तः निपात्यते। आध्रियतेऽस्मिन्नित्यर्थे = आधारः।]]</li> <li id="foot_krm_0924_11"><a href="#ref_krm_0924_11">↑</a> [[३। ‘अर्त्तिस्तुसुहुसृधृ--’ (द। उ। ७-२६) इति मन्प्रत्यये रूपमेवम्। धरति ध्रियते वाऽस्मिन्नाचार इति धर्मः = न्यायः।]]</li></ul></p>

धृज्|धर्जकः-र्जिका|दिधर्जिषकः-षिका|दरीधृजकः-जिका
<ul><li><sup id="ref_krm_0925_01"><a href="#foot_krm_0925_01">1</a></sup> {@“धृज् गत्यर्थः”@} <sup id="ref_krm_0925_02"><a href="#foot_krm_0925_02">2</a></sup> ‘धर्जेद् धृञ्जेद् ध्रजेद् ध्रञ्जेद् ध्वजेद् ध्वञ्जेद् गतौ शपि।’ <sup id="ref_krm_0925_03"><a href="#foot_krm_0925_03">3</a></sup> इति देवः। </li> <li>धर्जकः-र्जिका, धर्जकः-र्जिका, दिधर्जिषकः-षिका, दरीधृजकः-जिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिकगर्जतिवत् <sup id="ref_krm_0925_04"><a href="#foot_krm_0925_04">4</a></sup> ऊह्यानि। </li> <li>ल्यपि-- प्रधृज्य <sup id="ref_krm_0925_05"><a href="#foot_krm_0925_05">5</a></sup> इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0925_01"><a href="#ref_krm_0925_01">↑</a> (९१५)</li> <li id="foot_krm_0925_02"><a href="#ref_krm_0925_02">↑</a> (१-भ्वादिः-२१७। सक। सेट्। पर।)</li> <li id="foot_krm_0925_03"><a href="#ref_krm_0925_03">↑</a> (श्लो। ६०)</li> <li id="foot_krm_0925_04"><a href="#ref_krm_0925_04">↑</a> (४२२)</li> <li id="foot_krm_0925_05"><a href="#ref_krm_0925_05">↑</a> [[आ। ‘प्रधृज्य मोदं स दधृञ्ज तद्वनं ध्वजोद्गतिध्वञ्जितकूजदण्डजम्।’ धा। का। १। ३०।]]</li></ul></p>

धृजि|धृञ्जकः-ञ्जिका|दिधृञ्जिषकः-षिका|दरीधृञ्जकः-ञ्जिका
<ul><li><sup id="ref_krm_0926_01"><a href="#foot_krm_0926_01">1</a></sup> {@“धृजि गत्यर्थः”@} <sup id="ref_krm_0926_02"><a href="#foot_krm_0926_02">2</a></sup> ‘धर्जेद् धृञ्जेद् ध्रजेद् ध्रञ्जेद् ध्वजेद् ध्वञ्जेद् गतौ शपि।’ <sup id="ref_krm_0926_03"><a href="#foot_krm_0926_03">3</a></sup> इति देवः। </li> <li>धृञ्जकः-ञ्जिका, धृञ्जकः-ञ्जिका, दिधृञ्जिषकः-षिका, <sup id="ref_krm_0926_04"><a href="#foot_krm_0926_04">4</a></sup> दरीधृञ्जकः-ञ्जिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि गृञ्जतिवत् <sup id="ref_krm_0926_05"><a href="#foot_krm_0926_05">5</a></sup> बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0926_01"><a href="#ref_krm_0926_01">↑</a> (९१६)</li> <li id="foot_krm_0926_02"><a href="#ref_krm_0926_02">↑</a> (१-भ्वादिः-२१८। सक। सेट्। पर।)</li> <li id="foot_krm_0926_03"><a href="#ref_krm_0926_03">↑</a> (श्लो। ६०)</li> <li id="foot_krm_0926_04"><a href="#ref_krm_0926_04">↑</a> [[४। ‘रीगृत्वत इति वक्तव्यम्’ (वा। ७-४-९०) इति यङन्ते अभ्यासस्य रीगागमः। एवं यङन्ते सर्वत्र बोध्यम्।]]</li> <li id="foot_krm_0926_05"><a href="#ref_krm_0926_05">↑</a> (४२३)</li></ul></p>

धृञ्|धारकः-रिका|दिधीर्षकः-षिका|देध्रीयकः-यिका|युगन्धाः-जलन्धरः-पुरन्धरः-श्रुतन्धरः-वसुन्धरा|धनुर्धरा|महीध्रः|कर्णधारः|आधारः|धारा|धारयः|धारयन्|धुरन्धरः|धर्मः
<ul><li><sup id="ref_krm_0927_01"><a href="#foot_krm_0927_01">1</a></sup> {@“धृञ् धारणे”@} <sup id="ref_krm_0927_02"><a href="#foot_krm_0927_02">2</a></sup> ‘धरते धारणेऽर्थे तु धरते धरतीत्युभे।।’ <sup id="ref_krm_0927_03"><a href="#foot_krm_0927_03">3</a></sup> इति देवः। </li> <li>धारकः-रिका, धारकः-रिका, दिधीर्षकः-षिका, देध्रीयकः-यिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि भौवादिधरतिकवत् <sup id="ref_krm_0927_04"><a href="#foot_krm_0927_04">4</a></sup> ज्ञेयानि। </li> <li><sup id="ref_krm_0927_05"><a href="#foot_krm_0927_05">5</a></sup> युगन्धाः- <sup id="ref_krm_0927_06"><a href="#foot_krm_0927_06">6</a></sup> जलन्धरः-पुरन्धरः-श्रुतन्धरः-वसुन्धरा, <sup id="ref_krm_0927_07"><a href="#foot_krm_0927_07">7</a></sup> धनुर्धरा, <sup id="ref_krm_0927_08"><a href="#foot_krm_0927_08">8</a></sup> महीध्रः <sup id="ref_krm_0927_09"><a href="#foot_krm_0927_09">9</a></sup>, <sup id="ref_krm_0927_10"><a href="#foot_krm_0927_10">10</a></sup> कर्णधारः, <sup id="ref_krm_0927_11"><a href="#foot_krm_0927_11">11</a></sup> आधारः, <sup id="ref_krm_0927_12"><a href="#foot_krm_0927_12">12</a></sup> धारा, <sup id="ref_krm_0927_13"><a href="#foot_krm_0927_13">13</a></sup> धारयः <sup id="ref_krm_0927_14"><a href="#foot_krm_0927_14">14</a></sup> , <sup id="ref_krm_0927_15"><a href="#foot_krm_0927_15">15</a></sup> धारयन्, <sup id="ref_krm_0927_16"><a href="#foot_krm_0927_16">16</a></sup> धुरन्धरः, धर्मः;</li> <li>  इमानि रूपाणि अधिकान्यत्रेति विशेषः। </li> <li>अस्य धातोः उभयपदित्वात् शतरि--धरन्-न्ती, धरिष्यन्-न्ती-ती, इति विशेषः।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0927_01"><a href="#ref_krm_0927_01">↑</a> (९१७)</li> <li id="foot_krm_0927_02"><a href="#ref_krm_0927_02">↑</a> (१-भ्वादिः-९००। सक। अनि। उभ।)</li> <li id="foot_krm_0927_03"><a href="#ref_krm_0927_03">↑</a> (श्लो। २९)</li> <li id="foot_krm_0927_04"><a href="#ref_krm_0927_04">↑</a> (९१३)</li> <li id="foot_krm_0927_05"><a href="#ref_krm_0927_05">↑</a> [[५। ‘संज्ञायां भृतॄवृजिधारिसहितपिदमः’ (३-२-४६) इति कर्मण्युपपदे ण्यन्तात् खच्- प्रत्ययः। युगं धारयतीति युगन्धरः = पर्वतविशेषः। ‘खचि ह्रस्वः’ (६-४-९४) इति ह्रस्वः, ‘अरुर्द्विषदजन्तस्य--’ (६-३-६७) इति मुम्। एवं जलन्धरः, पुरन्धरः, श्रुतन्धरः, वसुन्धरा इत्यादिषु ज्ञेयम्।]]</li> <li id="foot_krm_0927_06"><a href="#ref_krm_0927_06">↑</a> [पृष्ठम्०८०९+ ३०]</li> <li id="foot_krm_0927_07"><a href="#ref_krm_0927_07">↑</a> [[१। धनुर्धरा इत्यत्रापि खजेव। अजन्तत्वाभावात् मुमागमो न।]]</li> <li id="foot_krm_0927_08"><a href="#ref_krm_0927_08">↑</a> [[२। महीं धरतीति महीध्रः = पर्वतः। एवं कुध्रः इत्यपि। ‘कप्रकरणे मूलविभु- जादिभ्य उपसंख्यानम्’ (वा। ३-२-५) इति कप्रत्यये पृषोदरादित्वात् उपधालोपे साधुः।]]</li> <li id="foot_krm_0927_09"><a href="#ref_krm_0927_09">↑</a> [[आ। ‘यियासतस्तस्य महीध्ररन्ध्रभिदापटीयान् पटहप्रणादः।’ शि। व। ३। २४।]]</li> <li id="foot_krm_0927_10"><a href="#ref_krm_0927_10">↑</a> [[३। ‘कर्मण्यण्’ (३-२-१) इत्यणि रूपम्। एवं सूत्रधारः इत्यादिष्वप्यण्।]]</li> <li id="foot_krm_0927_11"><a href="#ref_krm_0927_11">↑</a> [[४। ‘ºअवहाराधारावायानामुपसंख्यानम्’ (वा। ३-३-१२२) इति संज्ञायां घापवादो घञ्।]]</li> <li id="foot_krm_0927_12"><a href="#ref_krm_0927_12">↑</a> [[५। ‘धारा प्रपाते’ (ग। सू। ३-३-१०३) इति भिदादिपाठादङ्। ‘ऋदृशोऽङि--’ (७-४-१६) इति गुणः। निपातनाद् दीर्घः। अन्यत्र धृतिः इत्येव।]]</li> <li id="foot_krm_0927_13"><a href="#ref_krm_0927_13">↑</a> [[६। ‘अनुपसर्गाल्लिम्पविन्दधारिपारि--’ (३-१-१३८) इत्यादिना ण्यन्तादस्मात् शप्रत्ययः। गुणायादेशौ। कर्तरि प्रत्ययोऽयम्।]]</li> <li id="foot_krm_0927_14"><a href="#ref_krm_0927_14">↑</a> [[B। ‘सुखजातः सुरापीतो नृजग्धो माल्यधारयः।’ भ। का। ५। ३८।]]</li> <li id="foot_krm_0927_15"><a href="#ref_krm_0927_15">↑</a> [[७। ण्यन्तादस्मात्, ‘इङ्धार्योः शत्रकृच्छ्रिणि’ (३-२-१३०) इति शता। ‘धारयन् पारायणम्’ इत्यत्र क्लेशं विना धारणस्य द्योतनात् शता। कृच्छ्रार्थे तु धारयमाणः इति शानजेव।]]</li> <li id="foot_krm_0927_16"><a href="#ref_krm_0927_16">↑</a> [[८। धुरं धरतीत्यर्थे संज्ञात्वाभावेऽपि बाहुलकात् खचि, ‘वाचंयमपुरन्दरौ च’ (६-३-६९) इत्यत्र चकारात् अमागमः इति प्र। सर्वस्वे।]]</li></ul></p>

धृष
<ul><li><sup id="ref_krm_0928_01"><a href="#foot_krm_0928_01">1</a></sup> {@“धृष प्रसहने”@} <sup id="ref_krm_0928_02"><a href="#foot_krm_0928_02">2</a></sup> आधृषीयः। </li> <li>‘अप्रसहने’ इति क्षीरस्वामी। </li> <li>आदित् इति शाकटायनः। </li> <li>‘एषु पश बन्धने इति केचित् पठन्ति। </li> <li>तदुक्तं मैत्रेयेण-- ‘पश बन्धने’ इत्यत्र ‘पश बन्धने’ इति युजादौ इति’ मा। </li> <li>धा। </li> <li>वृत्तौ। </li> <li>‘धृषेः प्रसहने यौ स्तां धर्षयेद् धर्षतीत्युभे।।’ <sup id="ref_krm_0928_03"><a href="#foot_krm_0928_03">3</a></sup> इति देवः। </li> <li>धर्षकः-र्षिका, दिधर्षयिषकः-षिका, धर्षकः-र्षिका, दिधर्षिषकः-षिका, दरीधृषकः-षिका, इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकचृपधातुवत् <sup id="ref_krm_0928_04"><a href="#foot_krm_0928_04">4</a></sup> ज्ञेयानि। </li> <li>‘धृषा’ इति शाकटायनपक्षे--धृष्टम्-धृष्टः-धृष्टवान्, इति निष्ठायां विशेषः। </li> <li>कर्मणि क्तप्रत्यये धर्षितः <sup id="ref_krm_0928_05"><a href="#foot_krm_0928_05">5</a></sup> इति भवति। </li> <li><sup id="ref_krm_0928_06"><a href="#foot_krm_0928_06">6</a></sup></li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0928_01"><a href="#ref_krm_0928_01">↑</a> (९१८)</li> <li id="foot_krm_0928_02"><a href="#ref_krm_0928_02">↑</a> (१०-चुरादिः-१८५१। सक। सेट्। उभ।)</li> <li id="foot_krm_0928_03"><a href="#ref_krm_0928_03">↑</a> (श्लो। १८१)</li> <li id="foot_krm_0928_04"><a href="#ref_krm_0928_04">↑</a> (५५४)</li> <li id="foot_krm_0928_05"><a href="#ref_krm_0928_05">↑</a> [[C। ‘स्त्रियश्चोत्कण्ठन्त्यो ददृशुरजितं मृष्टतनवः नृपस्त्वेतन्नामर्षत रिपुजनाधर्षितबलः।।’ धा। का। ३। ५२।]]</li> <li id="foot_krm_0928_06"><a href="#ref_krm_0928_06">↑</a> [पृष्ठम्०८१०+ २७]</li></ul></p>

ञि|धर्षकः-र्षिका|दिधर्षिषकः-षिका|दरीधृषकः-षिका|धर्षिता-त्री|धर्षयिता-त्री|दिधर्षिषिता-त्री|दरीधृषिता-त्री|धृष्णुवन्-ती|धर्षयन्-न्ती|दिधर्षिषन्-न्ती|-|धर्षिष्यन्-न्ती-ती|धर्षयिष्यन्-न्ती-ती|दिधर्षिषिष्यन्-न्ती-ती|धर्षयमाणः|धर्षयिष्यमाणः|दरीधृष्यमाणः|दरीधृषिष्यमाणः|दधृक्-दधृषौ-दधृषः|-प्रधृष्टम्-प्रधृष्टः-प्रधृष्टवान्|प्रधर्षितः-तवान्|धर्षितः|दिधर्षिषितः|दरीधृषितः-तवान्|धृषः|धृष्णक्-धृष्णजौ-धृष्णजः|धृष्णुः|धर्षणः|प्रधर्षी|धर्षः|दिधर्षिषुः|दरीधर्षः|धर्षितव्यम्|धर्षयितव्यम्|दिधर्षिषितव्यम्|दरीधृषितव्यम्|धर्षणीयम्|दिधर्षिषणीयम्|दरीधृषणीयम्|धृष्यम्|धर्ष्यम्|दिधर्षिष्यम्|दरीधृष्यम्|ईषद्धर्षणः-दुर्धर्षणः-सुधर्षणः
<ul><li><sup id="ref_krm_0929_01"><a href="#foot_krm_0929_01">1</a></sup> {@“ञि धृषा प्रागल्भ्ये”@} <sup id="ref_krm_0929_02"><a href="#foot_krm_0929_02">2</a></sup> ‘प्रागल्भ्यार्थे तु धृष्णोति परस्मैपदिनावुभौ।।’ <sup id="ref_krm_0929_03"><a href="#foot_krm_0929_03">3</a></sup> इति देवः। </li> <li>धर्षकः-र्षिका, धर्षकः-र्षिका, <sup id="ref_krm_0929_04"><a href="#foot_krm_0929_04">4</a></sup> दिधर्षिषकः-षिका, <sup id="ref_krm_0929_05"><a href="#foot_krm_0929_05">5</a></sup> दरीधृषकः-षिका;</li> <li>  धर्षिता-त्री, धर्षयिता-त्री, दिधर्षिषिता-त्री, दरीधृषिता-त्री;</li> <li>  <sup id="ref_krm_0929_06"><a href="#foot_krm_0929_06">6</a></sup> धृष्णुवन्-ती, धर्षयन्-न्ती, दिधर्षिषन्-न्ती;</li> <li>  -- धर्षिष्यन्-न्ती-ती, धर्षयिष्यन्-न्ती-ती, दिधर्षिषिष्यन्-न्ती-ती;</li> <li>  -- -- धर्षयमाणः, धर्षयिष्यमाणः, -- दरीधृष्यमाणः, दरीधृषिष्यमाणः;</li> <li>  <sup id="ref_krm_0929_07"><a href="#foot_krm_0929_07">7</a></sup> दधृक् <sup id="ref_krm_0929_08"><a href="#foot_krm_0929_08">8</a></sup> -दधृषौ-दधृषः;</li> <li>  -- -- -- <sup id="ref_krm_0929_09"><a href="#foot_krm_0929_09">9</a></sup> प्रधृष्टम्-प्रधृष्टः-प्रधृष्टवान्, प्रधर्षितः-तवान्, धर्षितः, दिधर्षिषितः, दरीधृषितः-तवान्;</li> <li>  <sup id="ref_krm_0929_10"><a href="#foot_krm_0929_10">10</a></sup> धृषः, <sup id="ref_krm_0929_11"><a href="#foot_krm_0929_11">11</a></sup> धृष्णक्-धृष्णजौ-धृष्णजः, <sup id="ref_krm_0929_12"><a href="#foot_krm_0929_12">12</a></sup> धृष्णुः, <sup id="ref_krm_0929_13"><a href="#foot_krm_0929_13">13</a></sup> <sup id="ref_krm_0929_14"><a href="#foot_krm_0929_14">14</a></sup> धर्षणः, प्रधर्षी, धर्षः, दिधर्षिषुः, दरीधर्षः;</li> <li>  <sup id="ref_krm_0929_15"><a href="#foot_krm_0929_15">15</a></sup> धर्षितव्यम्, धर्षयितव्यम्, दिधर्षिषितव्यम्, दरीधृषितव्यम्;</li> <li>  धर्षणीयम्, धर्षणीयम्, दिधर्षिषणीयम्, दरीधृषणीयम्;</li> <li>  <sup id="ref_krm_0929_16"><a href="#foot_krm_0929_16">16</a></sup> धृष्यम्, धर्ष्यम्, दिधर्षिष्यम्, दरीधृष्यम्;</li> <li>  <sup id="ref_krm_0929_17"><a href="#foot_krm_0929_17">17</a></sup> ईषद्धर्षणः-दुर्धर्षणः-सुधर्षणः;</li> <li>  -- -- इत्यादीनि सर्वाण्यपि रूपाणि तर्षतिवत् <sup id="ref_krm_0929_18"><a href="#foot_krm_0929_18">18</a></sup> ज्ञेयानि। </li> <li>क्त्वायाम्-- <sup id="ref_krm_0929_19"><a href="#foot_krm_0929_19">19</a></sup> धर्षित्वा इति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0929_01"><a href="#ref_krm_0929_01">↑</a> (९१९)</li> <li id="foot_krm_0929_02"><a href="#ref_krm_0929_02">↑</a> (५-स्वादिः-१२६९। अक। सेट्। पर।)</li> <li id="foot_krm_0929_03"><a href="#ref_krm_0929_03">↑</a> (श्लो। १८२)</li> <li id="foot_krm_0929_04"><a href="#ref_krm_0929_04">↑</a> [[१। सन्नन्ताण्ण्वुलि रूपम्। सेट्त्वात् गुणः। एवं सर्वत्र सन्नन्ते ज्ञेयम्।]]</li> <li id="foot_krm_0929_05"><a href="#ref_krm_0929_05">↑</a> [[२। ‘रीग् ऋत्वत इति वक्तव्यम्’ (वा। ७-४-४०) इति रीगागमो यङन्ते सर्वत्र।]]</li> <li id="foot_krm_0929_06"><a href="#ref_krm_0929_06">↑</a> [[३। शतरि, ‘स्वादिभ्यः--’ (३-१-७३) इति श्नुः विकरणप्रत्ययः। ‘अचि श्नु--’ (६-४-७७) इति उवङादेशः।]]</li> <li id="foot_krm_0929_07"><a href="#ref_krm_0929_07">↑</a> [[४। ‘ऋत्विग्दधृक्--’ (३-२-५९) इत्यादिना क्विन्प्रत्ययसन्नियोगेन धातोः द्विर्वचनं निपात्यते। धृष्णोतीति दधृक्। ‘क्विन्प्रत्ययस्य कुः’ (८-२-६२) इति कुत्वम्।]]</li> <li id="foot_krm_0929_08"><a href="#ref_krm_0929_08">↑</a> [[आ। ‘तामातिक्य पदे पदेन चिबुके चातिग्नुवन् पाणिना चक्रे सध्नुवतां वधे दधृगसौ ऋज्वीं मनोज्ञाकृतिम्।’ धा। का। २। ७०।]]</li> <li id="foot_krm_0929_09"><a href="#ref_krm_0929_09">↑</a> [[५। ‘आदितश्च’ (७-२-१६) इति, ‘विभाषा भावादिकर्मणोः’ (७-२-१७) इति च अस्य धातोः नित्यम्, अर्थविशेषे विभाषया च यथाक्रममिड्विकल्पयोः प्राप्तयोः सत्योः, ‘धृषिशसी वैयात्ये’ (७-२-१९) इति नित्यमिडभावो वैयात्ये गम्यमाने निपात्यते। वैयात्यम् = वियातस्य भावः-धृष्टता। प्रागल्भ्यार्थे तु इट् भवत्येव। तदानीं ‘निष्ठा शीङ्स्विदिमिदिक्ष्विदिधृषः’ (१-२-१९) इति निष्ठायाः कित्त्वनिषेधाद् गुणः। ‘ञीतः क्तः’ (३-२-१८७) इति वर्तमानेऽप्यस्य धातोः क्तप्रत्ययो भवति।]]</li> <li id="foot_krm_0929_10"><a href="#ref_krm_0929_10">↑</a> [[६। ‘इगुपधज्ञा--’ (३-१-१३५) इति कर्तरि कप्रत्ययः।]]</li> <li id="foot_krm_0929_11"><a href="#ref_krm_0929_11">↑</a> [[७। ‘धृषेश्चेति वक्तव्यम्’ (वा। ३-२-१७२) इति ताच्छीलिके नजिङ्प्रत्यये रूपम्। ‘नेड् वशि कृति’ (७-२-८) इतीण्निषेधः। धृष्णक् = निर्लज्जः।]]</li> <li id="foot_krm_0929_12"><a href="#ref_krm_0929_12">↑</a> [[८। ‘त्रसिगृधिधृषिक्षिपेः क्नुः’ (३-२-१४०) इति तच्छीलादिषु कर्तृषु क्नुप्रत्ययः। ‘नेड् वशि कृति’ (७-२-८) इतीण्निषेधः।]]</li> <li id="foot_krm_0929_13"><a href="#ref_krm_0929_13">↑</a> [[B। ‘वसन् माल्यवति ग्लास्नू रामो जिष्णुरधृष्णुवत्।।’ भ। का। ७। ४।]]</li> <li id="foot_krm_0929_14"><a href="#ref_krm_0929_14">↑</a> [[९। नन्द्यादित्वात् (३-१-१३४) ण्यन्तादस्मात् कर्तरि ल्युप्रत्ययः।]]</li> <li id="foot_krm_0929_15"><a href="#ref_krm_0929_15">↑</a> [पृष्ठम्०८११+ २१]</li> <li id="foot_krm_0929_16"><a href="#ref_krm_0929_16">↑</a> [[१। ‘ऋदुपधात्--’ (३-१-११०) इति क्यप्।]]</li> <li id="foot_krm_0929_17"><a href="#ref_krm_0929_17">↑</a> [[२। ‘भाषायां शासियुधिदृशिधृषिमृषिभ्यः--’ (वा। ३-३-१३०) इति खलपवादो युच्।]]</li> <li id="foot_krm_0929_18"><a href="#ref_krm_0929_18">↑</a> (७७५)</li> <li id="foot_krm_0929_19"><a href="#ref_krm_0929_19">↑</a> [[३। ‘न क्त्वा सेट्’ (१-२-१८) इति कित्त्वनिषेधाद् गुणः।]]</li></ul></p>

