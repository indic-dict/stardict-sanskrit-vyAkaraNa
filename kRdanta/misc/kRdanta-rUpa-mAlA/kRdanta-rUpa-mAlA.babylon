<ul><li><sup id="ref_krm_0265_01"><a href="#foot_krm_0265_01">1</a></sup> {@“कॄत संशब्दने”@} <sup id="ref_krm_0265_02"><a href="#foot_krm_0265_02">2</a></sup> संशब्दनम् = उद्धोषः। </li> <li>‘कृणत्ति कृन्ततीत्येते वेष्टने च्छेदने क्रमात्। </li> <li>कीर्तयेदिति संशब्दे--’ <sup id="ref_krm_0265_03"><a href="#foot_krm_0265_03">3</a></sup> इति देवः। </li> <li><sup id="ref_krm_0265_04"><a href="#foot_krm_0265_04">4</a></sup> कीर्तकः-र्तिका, <sup id="ref_krm_0265_05"><a href="#foot_krm_0265_05">5</a></sup> कीर्तकः-र्तिका, <sup id="ref_krm_0265_06"><a href="#foot_krm_0265_06">6</a></sup> चिकीर्तयिषकः-षिका, <sup id="ref_krm_0265_07"><a href="#foot_krm_0265_07">7</a></sup> चेकीर्तकः-र्तिका;</li> <li>  कीर्तयिता-त्री, कीर्तिता-त्री, चिकीर्तयिषिता-त्री, चेकीर्तिता-त्री;</li> <li>  कीर्तयन्-न्ती, <sup id="ref_krm_0265_08"><a href="#foot_krm_0265_08">8</a></sup> कीर्तन्-न्ती, चिकीर्तयिषन्-न्ती;</li> <li>  -- कीर्तयिष्यन्-न्ती-ती, कीर्तिष्यन्-न्ती-ती, चिकीर्तयिषिष्यन्-न्ती-ती;</li> <li>  कीर्तयमानः, -- चिकीर्तयिषमाणः, चेकीर्त्यमानः;</li> <li>  कीर्तयिष्यमाणः, -- चिकीर्तयिषिष्यमाणः, चेकीर्तिष्यमाणः;</li> <li>  कीर्त्-कीर्तौ-कीर्तः;</li> <li>  -- -- -- <sup id="ref_krm_0265_09"><a href="#foot_krm_0265_09">9</a></sup> कीर्तितम्-तः, कीर्तितः, चिकीर्तयिषितः, चेकीर्तितः-तवान्;</li> <li>  कीर्तः, <sup id="ref_krm_0265_10"><a href="#foot_krm_0265_10">10</a></sup> कॄतः, चिकीर्तयिषुः, चेकीर्तः;</li> <li>  कीर्तयितव्यम्, कीर्तितव्यम्, चिकीर्तयिषितव्यम्, चेकीर्तितव्यम्;</li> <li>  <sup id="ref_krm_0265_11"><a href="#foot_krm_0265_11">11</a></sup> <sup id="ref_krm_0265_12"><a href="#foot_krm_0265_12">12</a></sup> कीर्तनीयम्, कीर्तनीयम्, चिकीर्तयिषणीयम्, चेकीर्तनीयम्;</li> <li>  कीर्त्यम्, कीर्त्यम्, चिकीर्तयिष्यम्, चेकीर्त्यम्;</li> <li>  ईषत्कीर्तः-दुष्कीर्तः-सुकीर्तः;</li> <li>  -- -- -- कीर्त्यमानः, कीर्त्यमानः, चिकीर्तयिष्यमाणः, चेकीर्त्यमानः;</li> <li>  <sup id="ref_krm_0265_13"><a href="#foot_krm_0265_13">13</a></sup> कीर्तः, कीर्तः, चिकीर्तयिषः, चेकीर्तः;</li> <li>  कीर्तयितुम्, कीर्तितुम्, चिकीर्तयिषितुम्, चेकीर्तितुम्;</li> <li>  <sup id="ref_krm_0265_14"><a href="#foot_krm_0265_14">14</a></sup> कीर्तिः- <sup id="ref_krm_0265_15"><a href="#foot_krm_0265_15">15</a></sup> कीर्तना, <sup id="ref_krm_0265_16"><a href="#foot_krm_0265_16">16</a></sup> कीर्त्तिः, चिकीर्तयिषा, चेकीर्ता;</li> <li>  कीर्तनम्, कीर्तनम्, चिकीर्तयिषणम्, चेकीर्तनम्;</li> <li>  कीर्तयित्वा, कीर्तित्वा, चिकीर्तयिषित्वा, चेकीर्तित्वा;</li> <li>  सङ्कीर्त्य, सङ्कीर्त्य, सञ्चिकीर्तयिष्य, सञ्चेकीर्त्य;</li> <li>  कीर्तम् २, कीर्तयित्वा २, कीर्तम् २, कीर्तित्वा २, चिकीर्तयिषम् २, चिकीर्तयिषित्वा २, चेकीर्तम् २;</li> <li>  चेकीर्तित्वा २।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_0265_01"><a href="#ref_krm_0265_01">↑</a> (२५९)</li> <li id="foot_krm_0265_02"><a href="#ref_krm_0265_02">↑</a> (१०-चुरादिः-१६५४। सक। सेट्। उभ।)</li> <li id="foot_krm_0265_03"><a href="#ref_krm_0265_03">↑</a> (श्लो। ९४)</li> <li id="foot_krm_0265_04"><a href="#ref_krm_0265_04">↑</a> [[१। ‘उपधायाश्च’ (७-१-१०१) इति इत्त्वम्, रपरत्वम्, ‘उपधायाञ्च’ (८-२-८) इति दीर्घः।]]</li> <li id="foot_krm_0265_05"><a href="#ref_krm_0265_05">↑</a> [[२। ‘ऋदुपधाच्च--’ (३-१-११०) इत्यत्र एतद्व्यावर्तकेन तपरकरणेन--णिचोऽत्र वैकल्पि- कत्वं बोध्यते। अतश्शुद्धधातोरपि रूपाणि प्रदर्शितानि।]]</li> <li id="foot_krm_0265_06"><a href="#ref_krm_0265_06">↑</a> [[३। ण्यन्तात् सनि रूपम्। णिजभावपक्षे शुद्धात् सनि तु ‘चिकीर्तिषकः-षिका,’ इत्यादीनि रूपाणि ऊह्यानि।]]</li> <li id="foot_krm_0265_07"><a href="#ref_krm_0265_07">↑</a> [[४। णिजभावपक्षे शुद्धधातोरेकाच्त्वात् हलादित्वाच्च यङन्तरूपाण्यपि लिखितानि।]]</li> <li id="foot_krm_0265_08"><a href="#ref_krm_0265_08">↑</a> [[५। ‘शेषात् कर्तरि परस्मैपदम्’ (१-३-७८) इति परस्मैपदमेव। नात्मनेपदम्।]]</li> <li id="foot_krm_0265_09"><a href="#ref_krm_0265_09">↑</a> [[६। ‘निष्ठायां सेटि’ (६-४-५२) इति णेर्लोपः।]]</li> <li id="foot_krm_0265_10"><a href="#ref_krm_0265_10">↑</a> [[७। णिजभावपक्षे ‘इगुपधज्ञा--’ (३-१-१३५) इति कर्तरि कः। तेन लघूपधगुणो न।]]</li> <li id="foot_krm_0265_11"><a href="#ref_krm_0265_11">↑</a> [पृष्ठम्०२६३+ २४]</li> <li id="foot_krm_0265_12"><a href="#ref_krm_0265_12">↑</a> [[१। ‘णेरनिटि’ (६-४-५१) इति णिलोपः।]]</li> <li id="foot_krm_0265_13"><a href="#ref_krm_0265_13">↑</a> [[२। ण्यन्तात् ‘एरच्’ (३-३-५६) इत्यच्।]]</li> <li id="foot_krm_0265_14"><a href="#ref_krm_0265_14">↑</a> [[३। ‘ऊतियूतिजूतिसातिहेतिकीर्त्तयश्च’ (३-३-९७) इत्ति युजपवादः क्तिन् निपात्यते।]]</li> <li id="foot_krm_0265_15"><a href="#ref_krm_0265_15">↑</a> [[४। वाहुलकात् युजपि--इति कालापाः, इति माधवीयधातुवृत्तिः।]]</li> <li id="foot_krm_0265_16"><a href="#ref_krm_0265_16">↑</a> [[आ। ‘जूतिमिच्छथ चेत्तूर्णं कीर्तिं वा पातुमात्मनः। करोमि वो बहिर्यूतीन् पिधध्वं पाणिभिर्दृशः।।’ भ। का। ७-६९।]]</li></ul></p>

