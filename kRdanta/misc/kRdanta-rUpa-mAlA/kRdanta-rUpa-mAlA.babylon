<ul><li><sup id="ref_krm_1027_01"><a href="#foot_krm_1027_01">1</a></sup> {@“पुण कर्मणि शुभे”@} <sup id="ref_krm_1027_02"><a href="#foot_krm_1027_02">2</a></sup> ‘पुण कर्मणि शब्दे च’ इति क्षीरस्वामिसम्मतः पाठः। </li> <li>पोणकः-णिका, पोणकः-णिका, <sup id="ref_krm_1027_03"><a href="#foot_krm_1027_03">3</a></sup> पुपुणिषकः-पुपोणिषकः-षिका;</li> <li>  पोपुणकः-णिका;</li> <li>  पोणिता-त्री, पोणयिता-त्री, पुपुणिषिता-पुपोणिषिता-त्री, पोपुणिता-त्री;</li> <li>  <sup id="ref_krm_1027_04"><a href="#foot_krm_1027_04">4</a></sup> पुणन्-न्ती-ती, पोणयन्-न्ती, पुपुणिषन्-पुपोणिषन्-न्ती;</li> <li>  -- पोणिष्यन्-न्ती-ती, पोणयिष्यन्-न्ती-ती, पुपुणिषिष्यन्-पुपोणिषिष्यन्-न्ती;</li> <li>  -- -- पोणयमानः, पोणयिष्यमाणः, -- पोपुण्यमानः, पोपुणिष्यमाणः;</li> <li>  प्रपुण्-प्रपुणौ-प्रपुणः;</li> <li>  -- -- -- पुणितम्-तः, पोणितः, पुपुणिषितः-पुपोणिषितः, पोपुणितः-तवान्;</li> <li>  <sup id="ref_krm_1027_05"><a href="#foot_krm_1027_05">5</a></sup> निपुणः, आचारनिपुणः, पोणः, पुपुणिषुः-पुपोणिषुः, पोपुणः;</li> <li>  पोणितव्यम्, पोणयितव्यम्, पुपुणिषितव्यम्-पुपोणिषितव्यम्, पोपुणितव्यम्;</li> <li>  पोणनीयम्, पोणनीयम्, पुपुणिषणीयम्-पुपोणिषणीयम्, पोपुणनीयम्;</li> <li>  <sup id="ref_krm_1027_06"><a href="#foot_krm_1027_06">6</a></sup> <sup id="ref_krm_1027_07"><a href="#foot_krm_1027_07">7</a></sup> पुण्यम्- <sup id="ref_krm_1027_08"><a href="#foot_krm_1027_08">8</a></sup> पोण्यम्, पुपुणिष्यम्-पुपोणिष्यम्, पोपुण्यम्;</li> <li>  ईषत्पोणः-दुष्पोणः-सुपोणः;</li> <li>  -- -- पुण्यमानः, पोण्यमानः, पुपुणिष्यमाणः, पुपोणिष्यमाणः, पोपुण्यमानः;</li> <li>  पोणः, पोणः, पुपुणिषः-पुपोणिषः, पोपुणः;</li> <li>  पोणितुम्-पोणयितुम्, पुपुणिषितुम्-पुपोणिषितुम्, पोपुणितुम्;</li> <li>  <sup id="ref_krm_1027_09"><a href="#foot_krm_1027_09">9</a></sup> पुणितिः, पोणना, पुपुणिषा-पुपोणिषा, पोपुणा;</li> <li>  पोणनम्, पोणनम्, पुपुणिषणम्-पुपोणिषणम्, पोपुणनम्;</li> <li>  पुणित्वा-पोणित्वा, पोणयित्वा, पुपुणिषित्वा-पुपोणिषित्वा, पोपुणित्वा;</li> <li>  प्रपुण्य, प्रपोण्य, प्रपुपुणिष्य-प्रपुपोणिष्य, प्रपोपुण्य;</li> <li>  पोणम् २, पुणित्वा २ -पोणित्वा २, पोणम् २, पोणयित्वा २, पुपुणिषम् २ -पुपोणिषम् २, पुपुणिषित्वा २ -पुपोणिषित्वा २, पोपुणम् २;</li> <li>  पोपुणित्वा २;</li> <li>  <sup id="ref_krm_1027_10"><a href="#foot_krm_1027_10">10</a></sup> पुण्डरीकम्।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1027_01"><a href="#ref_krm_1027_01">↑</a> (१०१७)</li> <li id="foot_krm_1027_02"><a href="#ref_krm_1027_02">↑</a> (६-तुदादिः-१३३३। अक। सेट्। पर।)</li> <li id="foot_krm_1027_03"><a href="#ref_krm_1027_03">↑</a> [[३। ‘रलो व्युपधात्--’ (१-२-२६) इति कित्त्वविकल्पः। एवं सन्नन्ते सर्वत्र, क्त्वा- प्रत्ययेऽपि, रूपद्वयस्योपपत्तिर्ज्ञेया।]]</li> <li id="foot_krm_1027_04"><a href="#ref_krm_1027_04">↑</a> [[४। ‘तुदादिभ्यः शः’ (३-१-७७) इति कर्तरि शप्रत्ययः। ‘आच्छीनद्योर्नुम्’ (७-१-८०) इति नुम् वा भवति।]]</li> <li id="foot_krm_1027_05"><a href="#ref_krm_1027_05">↑</a> [[५। ‘इगुपधज्ञाप्रीकिरः कः’ (३-१-१३५) इति कर्तरि कप्रत्ययः।]]</li> <li id="foot_krm_1027_06"><a href="#ref_krm_1027_06">↑</a> [पृष्ठम्०८६९+ २४]</li> <li id="foot_krm_1027_07"><a href="#ref_krm_1027_07">↑</a> [[१। ‘जनिकृतिपुणिभ्यः क्यप्’ इति भोजोक्तेः क्यप् प्रत्ययः।]]</li> <li id="foot_krm_1027_08"><a href="#ref_krm_1027_08">↑</a> [[आ। ‘ईशस्य पुण्यसुगमस्य वधं मुणन्तो मल्लाश्च यत्र चुकुणुः शुनका इवोच्चैः।’ धा। का। २। ७६।]]</li> <li id="foot_krm_1027_09"><a href="#ref_krm_1027_09">↑</a> [[२। ‘तितुत्रेष्वग्रहादीनाम्--’ (वा। ७-२-९) इतीट् भवति।]]</li> <li id="foot_krm_1027_10"><a href="#ref_krm_1027_10">↑</a> [[३। ‘पुण’ इत्यस्य धातोर्णकारस्य डकारे, डप्रत्ययस्य रुडागमे च एवं रूपम्। ‘पुण्डरीकं सिताम्भोजे सितच्छत्रे च मेषजे। पुंसि व्याघ्रेऽग्निदिङ्नागे कोशकारान्तरेऽपि च।।’ इति मेदिनी।]]</li></ul></p>

पुथ|पोथकः-थिका|पुपुथिषकः-पुपोथिषकः-षिका|पोपुथकः-थिका
<ul><li><sup id="ref_krm_1028_01"><a href="#foot_krm_1028_01">1</a></sup> {@“पुथ हिंसायाम्”@} <sup id="ref_krm_1028_02"><a href="#foot_krm_1028_02">2</a></sup> ‘पुथ्येत् पुन्थति हिंसार्थे, भाषार्थे पोथयेदिति।।’ <sup id="ref_krm_1028_03"><a href="#foot_krm_1028_03">3</a></sup> इति देवः। </li> <li>पोथकः-थिका, पोथकः-थिका, पुपुथिषकः-पुपोथिषकः-षिका, पोपुथकः-थिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि दैवादिककुथ्यतिवत् <sup id="ref_krm_1028_04"><a href="#foot_krm_1028_04">4</a></sup> ज्ञेयानि। </li> <li>पोथ्यम् <sup id="ref_krm_1028_05"><a href="#foot_krm_1028_05">5</a></sup>।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1028_01"><a href="#ref_krm_1028_01">↑</a> (१०१८)</li> <li id="foot_krm_1028_02"><a href="#ref_krm_1028_02">↑</a> (४-दिवादिः-१११९। सक। सेट्। पर।)</li> <li id="foot_krm_1028_03"><a href="#ref_krm_1028_03">↑</a> (श्लो। १००)</li> <li id="foot_krm_1028_04"><a href="#ref_krm_1028_04">↑</a> (२१८)</li> <li id="foot_krm_1028_05"><a href="#ref_krm_1028_05">↑</a> [[B। ‘तं प्लुष्यद्दृष्टिनृत्यद्रुषमपि च गतत्रासमुत्कुथ्यदङ्गम् पोथ्यं प्रोचे स्वरेण स्वजनविगुधितं क्षिप्यता पुष्पमाध्वीम्।।’ धा। का। २। ५६।]]</li></ul></p>

पुथ|पोथकः-थिका|पुपोथयिषकः-षिका|पोथयिता-त्री|पुपोथयिषिता-त्री
<ul><li><sup id="ref_krm_1029_01"><a href="#foot_krm_1029_01">1</a></sup> {@“पुथ भाषार्थः”@} <sup id="ref_krm_1029_02"><a href="#foot_krm_1029_02">2</a></sup> आस्वदीयः। </li> <li><sup id="ref_krm_1029_03"><a href="#foot_krm_1029_03">3</a></sup> ‘पुथ्येत् पुन्थति हिंसार्थे, भाषार्थे पोथयेदिति।।’ <sup id="ref_krm_1029_04"><a href="#foot_krm_1029_04">4</a></sup> इति देवः। </li> <li>पोथकः-थिका, पुपोथयिषकः-षिका;</li> <li>  पोथयिता-त्री, पुपोथयिषिता-त्री;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि चौरादिकचोदयतिवत् <sup id="ref_krm_1029_05"><a href="#foot_krm_1029_05">5</a></sup> बोध्यानि।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1029_01"><a href="#ref_krm_1029_01">↑</a> (१०१९)</li> <li id="foot_krm_1029_02"><a href="#ref_krm_1029_02">↑</a> (१०-चुरादिः-१७७६। सक। सेट्। उभ।)</li> <li id="foot_krm_1029_03"><a href="#ref_krm_1029_03">↑</a> [पृष्ठम्०८७०+ २६]</li> <li id="foot_krm_1029_04"><a href="#ref_krm_1029_04">↑</a> (श्लो। १००)</li> <li id="foot_krm_1029_05"><a href="#ref_krm_1029_05">↑</a> (५४२)</li></ul></p>

पुथि|पुन्थकः-न्थिका|पुपुन्थिषकः-षिका|पोपुन्थकः-न्थिका
<ul><li><sup id="ref_krm_1030_01"><a href="#foot_krm_1030_01">1</a></sup> {@“पुथि हिंसासंक्लेशनयोः”@} <sup id="ref_krm_1030_02"><a href="#foot_krm_1030_02">2</a></sup> ‘पुथ्येत् पुन्थति हिंसार्थे, भाषार्थे पोथयेदिति।।’ <sup id="ref_krm_1030_03"><a href="#foot_krm_1030_03">3</a></sup> इति देवः। </li> <li>पुन्थकः-न्थिका, पुन्थकः-न्थिका, पुपुन्थिषकः-षिका, पोपुन्थकः-न्थिका;</li> <li>  इत्यादीनि सर्वाण्यपि रूपाणि कुन्थतिवत् <sup id="ref_krm_1030_04"><a href="#foot_krm_1030_04">4</a></sup> ज्ञेयानि। </li> <li>ल्यपि प्रपुन्थ्य <sup id="ref_krm_1030_05"><a href="#foot_krm_1030_05">5</a></sup> इति रूपम्। </li> <li><sup id="ref_krm_1030_06"><a href="#foot_krm_1030_06">6</a></sup> खड्गोपपुन्थं खड्गेनोपपुन्थम् वा शत्रुं मारयति।</li></ul><p>प्रासङ्गिक्यः <ul><li id="foot_krm_1030_01"><a href="#ref_krm_1030_01">↑</a> (१०२०)</li> <li id="foot_krm_1030_02"><a href="#ref_krm_1030_02">↑</a> (१-भ्वादिः-४४। सक। सेट्। पर।)</li> <li id="foot_krm_1030_03"><a href="#ref_krm_1030_03">↑</a> (श्लो। १००)</li> <li id="foot_krm_1030_04"><a href="#ref_krm_1030_04">↑</a> (२२०)</li> <li id="foot_krm_1030_05"><a href="#ref_krm_1030_05">↑</a> [[आ। ‘ममन्थ विश्वं सुजनानकुन्थकान् प्रपुन्थ्य बन्धूनपि लुन्थति स्म यः।’ धा। का। १। ७।]]</li> <li id="foot_krm_1030_06"><a href="#ref_krm_1030_06">↑</a> [[१। ‘हिंसार्थानां च समानकर्मकाणाम्’ (३-४-४८) इति णमुल्प्रत्ययः।]]</li></ul></p>

